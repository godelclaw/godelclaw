; One captured native component and one explicit boundary result.
!(import! &self ./python_tool_cetta.metta)
(= (component-worker:result $answers)
   (case $answers
     ((((Error $where $why))
       (JsonObject ((JsonPair "ok" False) (JsonPair "error" (diagnostic:text ($where $why) 1000)))))
      (($value) (JsonObject ((JsonPair "ok" True) (JsonPair "result" $value))))
      ($many (JsonObject ((JsonPair "ok" False) (JsonPair "error" "component must produce exactly one result")))))))
(= (component-worker:file $operation $module $input-path $output)
   (let* (($input (json:parse (fs:read-text $input-path)))
          ($loaded (if (str:ends-with $module ".metta") (collapse (catch (import! &self $module)))
                     ((Error component-worker (Forbidden native-module-required)))))
          ($answers (if (== $loaded (True))
                      (if (== $operation "transform") (collapse (catch (eval (component:transform-request $input))))
                        (collapse (catch (eval (component:run $input)))))
                      ((Error component-worker (Fault component-import-failed)))))
          ($result (component-worker:result $answers))
          ($written (sf:replace $output (turn:json $result) 384 True)))
     (if (== $written True) True (system:exit 1))))
(= (component-worker:serve $snapshot)
   (case (system:read-line)
     ((end_of_file True)
      ($line
        (let* (($request (catch (json:parse $line)))
               ($name (sf:get $request "tool" ""))
               ($arguments (sf:get $request "arguments" JsonNull))
               ($answers (collapse (catch (component:invoke $snapshot $name $arguments))))
               ($result (component-worker:result $answers))
               ($wire (turn:json $result))
               ($_ (system:write stdout (str:join "" ("CLAW_COMPONENT " $wire "\n")))))
          (component-worker:serve $snapshot))))))
!(let $operation (turn:text (system:arg 1))
   (if (== $operation "serve")
     (component-worker:serve (component:from-manifest (json:parse (fs:read-text (turn:text (system:arg 2))))))
     (component-worker:file $operation (turn:text (system:arg 2)) (turn:text (system:arg 3)) (turn:text (system:arg 4)))))
