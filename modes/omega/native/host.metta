; Explicit native infrastructure for the pinned Omega loop.
!(import! &self ../../runtime_host_cetta.metta)
!(import! &self ./providers.metta)
(= (omega-host:receive-text $value) (if (== (get-type $value) String) $value (turn:text $value)))
(= (py-str $parts) (str:join "" (map-atom $parts $part (erv:str (erv:cross $part)))))
(= (omega-host:atom $value)
   (if (== (get-type $value) String) (str:string->symbol $value) $value))
(= (omega-host:config $key $default)
   (case (turn:text $key)
     (("commchannel" (if (mode-host:standalone?) "terminal" "telegram"))
      ("provider" "Configured")
      ("memoryDirectory" (path:join (mode-host:root) "repos/Omega/memory"))
      ("embeddingprovider" "Disabled")
      ($other (system:getenv-or-default (str:concat "OMEGA_" $other) $default)))))
(= (configure $key $default)
   (let $value (omega-host:atom (omega-host:config $key $default))
     (add-atom &self (= ($key) $value))))
(= (initConfig) True)
(= (initLogger) ())
(= (applySecurityPolicy) ())
(= (initPlugins) ())
(= (log $level $module $message) ())
(= (get_time) (system:wall-time))
(= (get_time_as_string) (system:format-time "%Y-%m-%d %H:%M:%S" (math:floor (system:wall-time)) "local"))
(= (joinPath $parts) (str:join "/" (map-atom $parts $part (turn:text $part))))
(= (sleep $seconds)
   (let* (($_ (health:settle)) ($_ (mode-host:record "boundary" ()))) (mode-host:sleep $seconds)))
(= (string-replace $text $separators $replacement)
   (let $set (tuple:from (str:python-codepoints $separators))
     (str:join "" (map-atom (str:python-codepoints (turn:text $text)) $point
       (if (erv:contains $set $point) $replacement (str:from-python-codepoints ($point)))))))
(= (omega-host:true $value) (case $value ((True True) (true True) ("true" True) ($other False))))
(= (exists-file $path) (fs:is-file $path))
(= (exists-directory $path) (component:directory? $path))
(= (omega-host:normalize $value) (erv:str (erv:cross $value)))
(= (omega-host:project-root) (path:join (mode-host:root) "repos/Omega"))
