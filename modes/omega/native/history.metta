; Omega's append history keeps the existing file and a recoverable native intent.
!(import! &self ../../../src/unicode_casefold_cetta.metta)
(= (omega-host:history-path) (path:join (path:join (omega-host:project-root) "memory") "history.metta"))
(= (omega-host:append-history $text)
   (let $written (mode-host:append-checkpoint (omega-host:history-path) (str:concat $text "\n"))
     (if (!= $written True) (mode-host:stop-uncommitted $written)
       (let $_ (mode-host:record "checkpoint" ()) "APPEND-FILE-SUCCESS"))))
(= (omega-host:write $path $text $append)
   (let $owner (fs:open-write $path (if $append ("create" "append") ("create" "truncate")) 438)
     (case $owner
       (((NativeHandle $_ $_)
         (let* (($written (fs:write-all $owner $text))
                ($synced (if (sf:failed? $written) $written (fs:sync $owner)))
                ($_ (fs:close $owner)))
           (if (sf:failed? $synced) (Error write-file (Incomplete $synced))
             (case (mode-host:file-info $path)
               (((ModeFileV1 $size $_ $_) (str:join "" ("verified " $path ": " (repr $size) " bytes")))
                ($bad $bad))))))
        ($bad (Error write-file (Fault $bad)))))))
(= (omega-host:remember $text)
   (let* (($row (JsonObject ((JsonPair "time" (system:wall-time)) (JsonPair "text" $text))))
          ($encoded (str:concat (turn:json $row) "\n"))
          ($written (omega-host:write (path:join (mode-host:root) "remembered.jsonl") $encoded True)))
     (if (turn:failed? $written) $written "REMEMBER-SUCCESS")))
(= (omega-host:query $needle)
   (let $path (path:join (mode-host:root) "remembered.jsonl")
     (if (not (fs:exists $path)) ""
       (case (fs:read-text-result $path 0 "replace")
         ((("ok" $text)
           (let* (($key (unicode:casefold $needle))
                  ($lines (filter-atom (str:split "\n" $text) $line
                    (case (str:find (unicode:casefold $line) $key) (((TextNotFound $_) False) ($found True)))))
                  ($joined (str:join "\n" $lines)) ($length (str:char-length $joined)))
             (str:char-slice $joined (max 0 (- $length 5000)) $length)))
          ($bad (Error omega-memory (Fault $bad))))))))
(= (omega-host:leap? $year)
   (and (== (% $year 4) 0) (or (!= (% $year 100) 0) (== (% $year 400) 0))))
(= (omega-host:month-days $year)
   (let $february (if (omega-host:leap? $year) 29 28)
     (31 $february 31 30 31 30 31 31 30 31 30 31)))
(= (omega-host:civil-seconds $text)
   (case (re:captures (re:pattern "^([0-9]{4})-([0-9]{2})-([0-9]{2}) ([0-9]{2}):([0-9]{2}):([0-9]{2})$") $text)
     ((re:no-match none)
      ($match
        (let* (($year (str:string->number (re:group-text $match $text 1)))
               ($month (str:string->number (re:group-text $match $text 2)))
               ($day (str:string->number (re:group-text $match $text 3)))
               ($hour (str:string->number (re:group-text $match $text 4)))
               ($minute (str:string->number (re:group-text $match $text 5)))
               ($second (str:string->number (re:group-text $match $text 6))))
          (if (or (< $year 1) (or (< $month 1) (> $month 12))) none
            (let $days (omega-host:month-days $year)
              (if (or (< $day 1) (or (> $day (index-atom $days (- $month 1)))
                    (or (> $hour 23) (or (> $minute 59) (> $second 59))))) none
                (let* (($prior (- $year 1))
                       ($before-year (+ (- (+ (* 365 $prior) (math:floor (/ $prior 4))) (math:floor (/ $prior 100))) (math:floor (/ $prior 400))))
                       ($before-month (foldl-atom (list:take (- $month 1) $days) 0 $total $day-count (+ $total $day-count))))
                  (+ (* (+ $before-year (+ $before-month (- $day 1))) 86400) (+ (* $hour 3600) (+ (* $minute 60) $second))))))))))))
(= (omega-host:episodes $offered $count)
   (let* (($clean (str:trim (str:join "" (str:split "\"" (str:join "" (str:split "\\\"" (turn:text $offered)))))))
          ($target (omega-host:civil-seconds $clean)))
     (if (== $target none) (Error episodes (Unsolvable invalid-timestamp))
       (case (fs:read-text-result (omega-host:history-path) 0 "replace")
         ((("ok" $text)
           (let* (($all (str:split "\n" (erio:universal $text)))
                  ($lines (if (str:ends-with $text "\n") (list:take (- (size-atom $all) 1) $all) $all))
                  ($best (omega-host:nearest $lines $target 0 -1 0)))
             (if (< $best 0) ""
               (let* (($start (max 0 (- $best $count))) ($end (min (size-atom $lines) (+ $best (+ $count 1)))))
                 (omega-host:episode-window (list:take (- $end $start) (list:drop $start $lines)) (+ $start 1))))))
          ($bad (Error episodes (Fault $bad))))))))
(= (omega-host:nearest $lines $target $index $best $distance)
   (if (== $lines ()) $best
     (let $stamp (omega-host:line-time (car-atom $lines))
       (if (== $stamp none)
         (omega-host:nearest (cdr-atom $lines) $target (+ $index 1) $best $distance)
         (let $difference (math:abs (- $stamp $target))
           (if (or (< $best 0) (< $difference $distance))
             (omega-host:nearest (cdr-atom $lines) $target (+ $index 1) $index $difference)
             (omega-host:nearest (cdr-atom $lines) $target (+ $index 1) $best $distance)))))))
(= (omega-host:line-time $line)
   (case (re:captures (re:pattern "^\\(\"([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})\"") $line)
     ((re:no-match none)
      ($found (omega-host:civil-seconds (re:group-text $found $line 1))))))
(= (omega-host:episode-window $lines $start)
   (let (OmegaLinesV1 $_ $reverse)
       (foldl-atom $lines (OmegaLinesV1 $start ()) $state $line
         (let (OmegaLinesV1 $index $pieces) $state
           (let* (($piece (str:join "" ((repr $index) ":" $line "\n"))) ($next (+ $index 1)))
             (OmegaLinesV1 $next (cons-atom $piece $pieces)))))
     (str:join "" (list:reverse $reverse))))
