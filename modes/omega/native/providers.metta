; Omega's native request and tool-call codecs, over ordinary JSON records.
!(import! &self ../../tool_io_cetta.metta)
(= (omega-host:collect-tools $skills)
   (map-atom $skills $skill
     (let ($name $description $parameters) $skill
       (mode-tool:schema (turn:text $name) $description $parameters))))
(= (llmProviderStart $provider) True)
(= (llmRequestMessage role $role content $content)
   (JsonObject ((JsonPair "role" $role) (JsonPair "content" $content))))
(= (llmToolCallResponseMessage role $role callid $id content $content)
   (JsonObject ((JsonPair "role" $role) (JsonPair "tool_call_id" (turn:text $id)) (JsonPair "content" $content))))
(= (omega-host:wire-call (OmegaCallV1 (ToolCallV1 $record) $_ $_))
   (let* (($name (sf:get $record "name" "")) ($arguments (sf:get $record "arguments" (JsonObject ())))
          ($wire (turn:json $arguments)))
     (JsonObject ((JsonPair "id" (sf:get $record "id" "")) (JsonPair "type" "function")
       (JsonPair "function" (JsonObject ((JsonPair "name" $name) (JsonPair "arguments" $wire))))))))
(= (llmToolCallMessage role $role calls $calls content $content)
   (let $wire (map-atom $calls $call (omega-host:wire-call $call))
     (JsonObject ((JsonPair "role" $role) (JsonPair "content" $content) (JsonPair "tool_calls" (JsonArray $wire))))))
(= (llmRequest $system $episodes $tokens $effort $tools)
   (let* (($route (if (mode-host:standalone?) "" (mode-host:route-context)))
          ($first (if (== $route "") $system
            (sf:put $system "content" (str:join "" ($route "\n\n" (sf:get $system "content" ""))))))
          ($messages (cons-atom $first $episodes))
          ($selected (model:current "")))
     (JsonObject ((JsonPair "model" $selected) (JsonPair "messages" (JsonArray $messages))
       (JsonPair "max_tokens" $tokens) (JsonPair "reasoning" (JsonObject ((JsonPair "effort" (turn:text $effort)))))
       (JsonPair "tools" (JsonArray $tools)) (JsonPair "tool_choice" "auto")))))
(= (omega-host:chat $request)
   (case (collapse (catch (llm:run (llm:structured-plan $request "coding"))))
     ((((ProviderReplyV1 $reply)) (omega-host:response $request (json:parse (preq:render $reply))))
      ($failure (OmegaResponseV1 () "native provider call failed; inspect its retained call receipt")))))
(= (omega-host:response $request $reply)
   (let* (($message (sf:get $reply "message" (JsonObject ())))
          ($calls (mode-host:array $message "tool_calls")))
     (if (== $calls ()) (OmegaResponseV1 () "List of tool calls is empty")
       (let $converted (map-atom $calls $call (omega-host:call $request $call))
         (OmegaResponseV1 $converted "")))))
(= (omega-host:find-tool $tools $name)
   (if (== $tools ()) none
     (if (== (sf:get (sf:get (car-atom $tools) "function" JsonNull) "name" "") $name)
       (car-atom $tools) (omega-host:find-tool (cdr-atom $tools) $name))))
(= (omega-host:call $request $call)
   (let* (($id (sf:get $call "id" "")) ($function (sf:get $call "function" (JsonObject ())))
          ($name (sf:get $function "name" "")) ($arguments-text (sf:get $function "arguments" "{}"))
          ($arguments (if (== (get-type $arguments-text) String) (catch (json:parse $arguments-text)) $arguments-text))
          ($tool (omega-host:find-tool (mode-host:array $request "tools") $name))
          ($schema (sf:get (sf:get $tool "function" JsonNull) "parameters" (JsonObject ())))
          ($parameters (mode-host:array $schema "required"))
          ($valid-arguments (case $arguments (((JsonObject $_) True) ($bad False))))
          ($error (if (not $valid-arguments) "tool arguments must be a JSON object"
            (if (== $tool none) (str:concat "Unknown tool: " (repr $name))
              (omega-host:argument-error $name $parameters $arguments))))
          ($record (JsonObject ((JsonPair "id" (turn:text $id)) (JsonPair "name" (turn:text $name))
                                (JsonPair "arguments" (if $valid-arguments $arguments (JsonObject ())))))))
     (OmegaCallV1 (ToolCallV1 $record) $parameters
       (if (or (!= (get-type $id) String) (== $id "")) "provider tool call lacks an id" $error))))
(= (omega-host:argument-error $name $parameters $arguments)
   (if (== $parameters ()) ""
     (let* (($parameter (car-atom $parameters)) ($value (sf:get $arguments $parameter OmegaArgumentMissingV1)))
       (if (== $value OmegaArgumentMissingV1)
         (str:join "" ("Call tool parameter is not set: tool: " (repr $name) ", parameter: " (repr $parameter)))
         (if (!= (get-type $value) String)
           (str:join "" ("Call tool parameter is not a string: tool: " (repr $name) ", parameter: " (repr $parameter)))
           (omega-host:argument-error $name (cdr-atom $parameters) $arguments))))))
(= (llmResponseCalls (OmegaResponseV1 $calls $_)) $calls)
(= (llmResponseIsEmpty (OmegaResponseV1 $calls $_)) (== $calls ()))
(= (llmToolCallGetName (OmegaCallV1 (ToolCallV1 $record) $_ $_)) (sf:get $record "name" ""))
(= (llmToolCallGetId (OmegaCallV1 (ToolCallV1 $record) $_ $_)) (sf:get $record "id" ""))
(= (llmToolCallGetArguments (OmegaCallV1 (ToolCallV1 $record) $_ $_)) (sf:get $record "arguments" JsonNull))
(= (llmToolCallIsError (OmegaCallV1 $_ $_ $error)) (!= $error ""))
(= (llmToolCallGetError (OmegaCallV1 $_ $_ $error)) $error)
(= (omega-host:call-source (OmegaCallV1 (ToolCallV1 $record) $parameters $error))
   (let* (($name (sf:get $record "name" ""))
          ($arguments (sf:get $record "arguments" (JsonObject ())))
          ($values (map-atom $parameters $parameter (sf:get $arguments $parameter "")))
          ($quoted (map-atom $values $value (repr $value)))
          ($valid-name (re:is-match (re:pattern "^[A-Za-z_][A-Za-z0-9_-]*$") $name))
          ($command (if $valid-name (str:join "" ("(" $name (if (== $quoted ()) "" " ") (str:join " " $quoted) ")")) "()"))
          ($failure (if $valid-name $error "provider tool name is invalid"))
          ($body (if (== $failure "") $command (str:join "" ("(Error " $command " " (repr $failure) ")")))))
     (str:join "" ("(" (repr (sf:get $record "id" "")) " " $body ")"))))
(= (omega-host:response-source (OmegaResponseV1 $calls $error))
   (if (!= $error "") (str:join "" ("(Error () " (repr $error) ")"))
     (str:join "" ("(" (str:join "" (map-atom $calls $call (omega-host:call-source $call))) ")"))))
(= (llmResponseToSExpr $response) (omega-host:response-source $response))
