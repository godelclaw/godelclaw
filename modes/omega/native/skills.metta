(= (getSkills)
     (collapse (match &self (dynamic-skill $name $info) $info)))
(: add-skill (-> Atom String Atom Bool))
(= (add-skill $function $description $arguments)
   (let $text (strings-concat ($description ": " $function " " (join " " $arguments)))
     (progn
       (log INFO "skills" (strings-concat ("Add skill: " $text)))
       (if (== () (collapse (match &self (dynamic-skill $function $info) FOUND)))
         ()
         (progn
           (log INFO "skill" "Re-add skill, removing previous instance")
           (remove-skill $function)))
       (add-atom &self (dynamic-skill $function ($function $description $arguments))) )))
(= (remove-skill $function)
   (progn
     (log INFO "skills" (strings-concat ("Remove skill: " $function)))
     (collapse (match &self (dynamic-skill $function $info) (remove-atom &self (dynamic-skill $function $info))))
     True))
(= (add-prompt-extension $handle $text)
   (progn
     (log INFO "skills" (strings-concat ("Add prompt extension " $handle ": " $text)))
     (add-atom &self (= (prompt-extension $handle) $text))))
(= (remove-prompt-extension $handle)
   (progn
     (log INFO "skills" (strings-concat ("Remove prompt extension: " $handle)))
     (collapse (match &self (= (prompt-extension $handle) $text) (remove-atom &self (= (prompt-extension $handle) $text))))
     True))
(= (heartbeat $iteration)
   (let $_ (collapse (heartbeat-listener $_ $iteration)) ()))
(= (heartbeat-listener placeholder $_) (empty))
(= (add-heartbeat-listener $handle $callback)
   (progn
     (log INFO "skills" (strings-concat ("Add heartbeat listener " $handle)))
     (add-atom &self (= (heartbeat-listener $handle $iter) ($callback $iter)))))
(= (remove-heartbeat-listener $handle)
   (progn
     (log INFO "skills" (strings-concat ("Remove heartbeat listener: " $handle)))
     (collapse (match &self (= (heartbeat-listener $handle $arg) $body) (remove-atom &self (= (heartbeat-listener $handle $arg) $body))))
     True))
(= (append-file-raw $file $text)
   (omega-host:write $file (str:concat $text "\n") True))
(= (websearch $queries) (search:lines $queries))
(= (read-url $url) (web:read $url ""))
(= (find-in-url $url $phrase) (web:read $url $phrase))
!(import! &self ../../../src/websearch_cetta.metta)
!(import! &self ../../../src/webread_cetta.metta)
(= (shell $command) (mode-tool:shell $command))
(= (first_char $text) (str:char-slice $text 0 (min 1 (str:char-length $text))))
(= (metta $str)
   (let $code (parse $str)
        (repr (repr (eval $code)))))
(= (pin $x)
   PIN-SUCCESS)
(= (version)
   "Omega 94d7b9a2 (native infrastructure)")
(= (getSkillRules) ("NAL and PLN are available through metta." "Use only the tools advertised in this request."))
(= (omega-host:read-file $path) (fs:read-text $path))
(= (omega-host:write-file $path $text) (omega-host:write $path $text False))
(= (omega-host:append-file $path $text) (omega-host:write $path $text True))
; Keep wire and history names while selecting the Omega implementation once.
(: omega-host:execute (-> Atom %Undefined%))
(= (omega-host:execute $command)
   (let* (($tool (case (car-atom $command)
                   ((read-file omega-host:read-file)
                    (write-file omega-host:write-file)
                    (append-file omega-host:append-file)
                    ($other $other))))
          ($target (cons-atom $tool (cdr-atom $command))))
     (eval $target)))
(= (send-channel $destination $message) (mode-host:send $message $destination))
(= (nop) NOP)
!(add-skill "remember" "Remember text in long-term memory." (content))
!(add-skill "query" "Query long-term memory with a short phrase." (content))
!(add-skill "episodes" "Search history around a timestamp." (timestamp))
!(add-skill "pin" "Keep one short-lived working-memory item in the Omega episode." (message))
!(add-skill "websearch" "Search the web. Several queries, one per line (up to six), are searched together and merged; results are tagged Q1, Q2, ..." (queries))
!(add-skill "read-url" "Read a web page as text (its JavaScript runs)." (url))
!(add-skill "find-in-url" "Read a web page and return only the passages around a phrase." (url phrase))
!(add-skill "shell" "Execute a shell command." (cmd))
!(add-skill "read-file" "Read a file." (filename))
!(add-skill "write-file" "Replace a file with content." (filename content))
!(add-skill "append-file" "Append content to a file." (filename content))
!(add-skill "send" "Send a message on the current channel." (content))
!(add-skill "send-channel" "Send to an explicit known channel." (channel content))
!(add-skill "version" "Return the Omega version." ())
!(add-skill "nop" "Finish this action without another effect." ())
!(add-skill "metta" "Evaluate one MeTTa expression." (sexpression))
