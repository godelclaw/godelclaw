; Text, paths and configuration arguments use native PeTTa operations.
(= (swrite $value) (repr $value))
(= (sread $text) (parse $text))
(= (string_length $text) (str:char-length $text))
(= (string_concat $left $right) (str:concat $left $right))
(= (atomic_list_concat $parts) (str:join "" (map-atom $parts $part (turn:text $part))))
(= (make-directory $path) (fs:make-directories $path 448))
(= (empty-to-bool $predicate) (not (== (collapse (eval $predicate)) ())))
(= (string-safe $str)
   (string-replace (string-replace (string-replace $str "\"\"" "_quote_") "\n" "_newline_") "'" "_apostrophe_"))
(= (last_chars $text $count)
   (let $length (str:char-length $text) (str:char-slice $text (max 0 (- $length $count)) $length)))
(= (take $k $items) (list:take $k $items))
(= (newline) "\n")
(= (atom_to_number $text)
   (let $value (catch (str:string->number (turn:text $text)))
     (if (== (get-type $value) Number) $value $text)))
(= (argk $prefix)
   (let $found (filter-atom (map-atom (system:args) $arg (turn:text $arg)) $arg
                  (str:starts-with $arg (str:concat (turn:text $prefix) "=")))
     (if (== $found ()) (empty)
       (atom_to_number (str:char-slice (car-atom $found) (+ 1 (str:char-length (turn:text $prefix))) (str:char-length (car-atom $found)))))))
(= (argk $prefix $default)
   (case (collapse (argk $prefix)) ((() $default) (($value) $value))))
(= (command-line) (system:args))
(= (join $separator $strings) (str:join $separator (map-atom $strings $part (turn:text $part))))
(= (join $separator $strings $prefix)
   (str:concat $prefix (if (== $strings ()) "" (str:concat $separator (join $separator $strings)))))
(= (strings-concat $parts) (str:join "" (map-atom $parts $part (turn:text $part))))
(= (atom-concat $left $right) (str:concat (turn:text $left) (turn:text $right)))
(= (projectRootDirectory) (omega-host:project-root))
