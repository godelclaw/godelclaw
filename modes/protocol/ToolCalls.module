-- SPDX-License-Identifier: MIT
Module ToolCalls {
  Theory Schema() {
    Empty
    Types {
      CallId = String;
      ToolName = String;
      JsonText = String;
      Content = String;
      Status = String;
      Description = String;
      ToolSpec;
      ToolCall;
      ToolResult;
    }
    Terms {
      "tool:v1:spec". name:ToolName, description:Description, parameters:JsonText
        |- "ToolSpecV1" name description parameters : ToolSpec;
      "tool:v1:call". id:CallId, name:ToolName, arguments:JsonText
        |- "ToolCallV1" id name arguments : ToolCall;
      "tool:v1:result". id:CallId, status:Status, content:Content
        |- "ToolResultV1" id status content : ToolResult;
    }
  }
  theory Schema()
}
