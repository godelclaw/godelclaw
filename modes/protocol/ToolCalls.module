Module ToolCalls {
  Theory JsonCarrier() {
    Empty Exports { JsonValue; }
  }
  Theory Schema(json: JsonCarrier) {
    json
    Types {
      ToolSpec;
      ToolCall;
      ToolResult;
    }
    Terms {
      "tool:v1:spec". record:JsonValue
        |- "ToolSpecV1" record : ToolSpec;
      "tool:v1:call". record:JsonValue
        |- "ToolCallV1" record : ToolCall;
      "tool:v1:result". record:JsonValue
        |- "ToolResultV1" record : ToolResult;
    }
  }
  Theory Canonical() { Schema(JsonCarrier()) }
  theory Canonical()
}
