; Offline conformance fixture host for modes/iter/core.metta on native CeTTa.
; Implements the ih:* boundary against ITER_FIXTURE_ROOT/scenario.json and
; records ITER_FIXTURE_ROOT/trace.jsonl for differential comparison against
; modes/iter/upstream/iter.py, without importing production runtime services.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self (library list))
!(import! &self (library math))
!(import! &self (library proc))
!(import! &self ../../src/state_file_cetta.metta)
!(import! &self ../../src/turn_frame_cetta.metta)
!(import! &self ../../src/diagnostic_cetta.metta)

!(bind! &fix-boundary (new-state 0))
!(bind! &fix-receive (new-state 0))
!(bind! &fix-reply (new-state 0))
!(bind! &fix-script (new-state JsonNull))

; ---- Boxed mutable JSON values (identical contract to host_cetta.metta) ----

(= (ih:list)
   (let* (($space (new-space)) ($length (new-space))
          ($_ (add-atom $length (IterLengthV1 0))))
     (IterListV1 $space $length)))
(= (ih:object)
   (let $space (new-space) (IterObjectV1 $space)))
(= (ih:box $value)
   (case $value
     (((JsonArray $items)
       (let $list (ih:list)
         (let $_ (ih:append-values $list (map-atom $items $item (ih:box $item))) $list)))
      ((JsonObject $pairs)
        (let $object (ih:object)
          (let $_ (ih:object-values $object $pairs) $object)))
      ((JsonString $text) $text)
      ((JsonNumber $text) (str:string->number $text))
      ((JsonBool $flag) $flag)
      ($leaf $leaf))))
(= (ih:object-values $object $pairs)
   (if (== $pairs ()) True
     (let* (((JsonPair $key $value) (car-atom $pairs))
            ($_ (ih:put $object $key (ih:box $value))))
       (ih:object-values $object (cdr-atom $pairs)))))
(= (ih:one $answers $default)
   (case $answers ((() $default) (($one) $one) ($many (Error iter-json (Fault duplicate-field))))))
(= (ih:optional $object $key)
   (case $object
     (((IterObjectV1 $space) (ih:one (collapse (match $space (IterFieldV1 $key $value) $value)) JsonNull))
      ((IterListV1 $space $length) (ih:one (collapse (match $space (IterItemV1 $key $value) $value)) JsonNull))
      ((JsonObject $_) (sf:get $object $key JsonNull))
      ($other JsonNull))))
(= (ih:get $object $key)
   (let $value (ih:optional $object $key)
     (if (== $value JsonNull) JsonNull $value)))
(= (ih:size $value)
   (case $value
     (((IterListV1 $space $length) (ih:one (collapse (match $length (IterLengthV1 $count) $count)) 0))
      ((IterObjectV1 $space) (size-atom (collapse (match $space (IterFieldV1 $key $_) $key))))
      ((JsonArray $items) (size-atom $items))
      ($text (if (== (get-type $text) String) (str:char-length $text) 0)))))
(= (ih:put (IterObjectV1 $space) $key $value)
   (let* (($_ (collapse (match $space (IterFieldV1 $key $old) (remove-atom $space (IterFieldV1 $key $old)))))
          ($_ (add-atom $space (IterFieldV1 $key $value))))
     (IterObjectV1 $space)))
(= (ih:remove (IterObjectV1 $space) $key)
   (let $_ (collapse (match $space (IterFieldV1 $key $old) (remove-atom $space (IterFieldV1 $key $old)))) True))
(= (ih:append (IterListV1 $space $length) $item)
   (let* (($count (ih:size (IterListV1 $space $length))) ($next (+ $count 1))
          ($_ (add-atom $space (IterItemV1 $count $item)))
          ($_ (remove-atom $length (IterLengthV1 $count)))
          ($_ (add-atom $length (IterLengthV1 $next))))
     (IterListV1 $space $length)))
(= (ih:append-values $list $items)
   (if (== $items ()) $list
     (let $_ (ih:append $list (car-atom $items)) (ih:append-values $list (cdr-atom $items)))))
(= (ih:values $list) (ih:values-at $list 0 (ih:size $list) ()))
(= (ih:values-at $list $index $end $reverse)
   (if (>= $index $end) (list:reverse $reverse)
     (ih:values-at $list (+ $index 1) $end (cons-atom (ih:get $list $index) $reverse))))
(= (ih:extend $list $items) (ih:append-values $list (ih:values $items)))
(= (ih:range $list $offset $count)
   (let $copy (ih:list)
     (let $_ (ih:copy-range $copy $list $offset (min (ih:size $list) (+ $offset $count))) $copy)))
(= (ih:copy-range $copy $original $index $end)
   (if (>= $index $end) True
     (let $_ (ih:append $copy (ih:get $original $index)) (ih:copy-range $copy $original (+ $index 1) $end))))
(= (ih:take $list $count) (ih:range $list 0 (max 0 $count)))
(= (ih:tail $list $count) (ih:range $list (max 0 (- (ih:size $list) $count)) $count))
(= (ih:drop-head $list) (ih:range $list 1 (max 0 (- (ih:size $list) 1))))
(= (ih:json $value) (ih:json-seen $value ()))
(= (ih:json-seen $value $seen)
   (case $value
     (((IterListV1 $space $length)
       (if (erv:contains $seen $space) (Error iter-json (Unsolvable circular-value))
         (JsonArray (map-atom (ih:values $value) $item (ih:json-seen $item (cons-atom $space $seen))))))
      ((IterObjectV1 $space)
       (if (erv:contains $seen $space) (Error iter-json (Unsolvable circular-value))
         (JsonObject (map-atom (collapse (match $space (IterFieldV1 $key $item) ($key $item))) $pair
           (let ($key $item) $pair (JsonPair $key (ih:json-seen $item (cons-atom $space $seen))))))))
      ($leaf $leaf))))
(= (ih:truth $value)
   (case $value
     ((JsonNull False) (False False) ("" False) (0 False)
      ((IterListV1 $_ $_) (> (ih:size $value) 0))
      ((IterObjectV1 $_) (> (ih:size $value) 0))
      ($other True))))
(= (ih:flag $value $key) (ih:truth (ih:get $value $key)))
(= (ih:equal $left $right) (== (turn:json (ih:json $left)) (turn:json (ih:json $right))))
(= (ih:not-equal $left $right) (not (ih:equal $left $right)))
(= (ih:empty-list) (ih:list))
(= (ih:message $role $content)
   (let $message (ih:object)
     (let* (($_ (ih:put $message "role" $role)) ($_ (ih:put $message "content" $content))) $message)))
(= (ih:stringify $value)
   (let $json (ih:json $value)
     (if (== $json JsonNull) "None"
       (if (== (get-type $json) String) $json (erv:str $json)))))
(= (ih:step $text)
   (str:concat "Step 2026-01-01 00:00:00: " (ih:stringify $text)))
(= (ih:concat $left $right) (str:concat (ih:stringify $left) (ih:stringify $right)))
; ---- Environment-configurable upstream parameters (matching upstream 774f805) ----
(= (fix:env-num $name $default)
   (let $raw (str:trim (system:getenv-or-default $name ""))
     (if (== $raw "") $default
       (let $parsed (catch (str:string->number $raw))
         (if (== (get-type $parsed) Number) $parsed $default)))))
(= (fix:env-int $name $default) (math:floor (fix:env-num $name $default)))

(= (ih:cfg-max-memory-chars) (max 0 (fix:env-int "MAX_MEMORY_CHARS" 3000)))
(= (ih:cfg-keep-reasoning) (== (system:getenv-or-default "KEEP_REASONING_IN_EPISODE" "True") "True"))
(= (ih:cfg-max-tool-calls) (max 1 (fix:env-int "MAX_TOOL_CALLS" 10)))
(= (ih:cfg-max-tool-output-chars) (max 0 (fix:env-int "MAX_TOOL_OUTPUT_CHARS" 5000)))
(= (ih:cfg-max-experience-size) (max 2 (fix:env-int "MAX_EXPERIENCE_SIZE" 100)))
(= (ih:cfg-retain-experience-size)
   (let* (($max-exp (ih:cfg-max-experience-size))
          ($retain (max 0 (fix:env-int "RETAIN_EXPERIENCE_SIZE" 80))))
     (if (< $retain $max-exp) $retain (- $max-exp 1))))
(= (ih:cfg-max-fast-steps) (max 1 (fix:env-int "MAX_FAST_STEPS" 50)))
(= (ih:cfg-slow-step-delay) (max 0 (fix:env-int "SLOW_STEP_DELAY" 10)))
(= (ih:cfg-error-recovery-time) (max 0 (fix:env-num "ERROR_RECOVERY_TIME" 1)))
(= (ih:cfg-return-value-preserve) (max 0 (fix:env-int "RETURN_VALUE_PRESERVE" 0)))
(= (ih:cfg-return-value-preserve-messages) (max 0 (fix:env-int "RETURN_VALUE_PRESERVE_MESSAGES" 10)))
(= (ih:cfg-default-delay) (max 0 (fix:env-num "DEFAULT_DELAY" 0)))
(= (ih:cfg-init-wait) (max 0 (fix:env-num "INIT_WAIT" 10)))
(= (ih:cfg-max-tools) (max 0 (fix:env-int "MAX_TOOLS" 30)))
(= (ih:cfg-max-skills) (max 0 (fix:env-int "MAX_SKILLS" 30)))
(= (ih:cfg-max-context-transformations) (max 0 (fix:env-int "MAX_CONTEXT_TRANSFORMATIONS" 30)))
(= (ih:cfg-max-tokens) (max 1 (fix:env-int "MAX_TOKENS" 5000)))
(= (ih:cfg-tool-choice)
   (let $raw (str:trim (system:getenv-or-default "TOOL_CHOICE" "required"))
     (if (== $raw "") "required" $raw)))
(= (ih:cfg-backup-model) (str:trim (system:getenv-or-default "LLM_BACKUP_MODEL" "")))

(= (ih:clip $value)
   (let $limit (ih:cfg-max-tool-output-chars)
     (if (> (str:char-length $value) $limit) (str:concat (str:char-slice $value 0 $limit) " [TRUNCATED]") $value)))

; ---- Fixture trace & scenario helpers ----

(= (fix:root) (system:getenv-or-default "ITER_FIXTURE_ROOT" (system:getcwd)))
(= (fix:python) (system:getenv-or-default "ITER_PYTHON" "python3"))
(= (fix:upstream) (system:getenv-or-default "ITER_UPSTREAM_SCRIPT" ""))
(= (fix:trace-path) (path:join (fix:root) "trace.jsonl"))

(= (fix:record $kind $fields)
   (let $owner (fs:open-write (fix:trace-path) ("create" "append") 420)
     (let* (($obj (JsonObject (cons-atom (JsonPair "kind" $kind) $fields)))
            ($_ (fs:write-all $owner (str:concat (turn:json $obj) "\n")))
            ($_ (fs:close $owner))) True)))

(= (fix:json-array-items $value)
   (case $value (((JsonArray $items) $items) ($other ()))))

(= (fix:unbox-leaf $value)
   (case $value
     (((JsonString $s) $s)
      ((JsonNumber $n) (str:string->number $n))
      ((JsonBool $b) $b)
      ((JsonArray $items) (JsonArray (map-atom $items $x (fix:unbox-leaf $x))))
      ((JsonObject $pairs) (JsonObject (map-atom $pairs $p (case $p (((JsonPair $k $v) (JsonPair $k (fix:unbox-leaf $v))))))))
      ($other $other))))

(= (fix:dir? $p)
   (case (fs:metadata $p no-follow) (((fs:info directory $_ $_) True) ($other False))))

(= (fix:replace $s $old $new)
   (str:join $new (str:split $old $s)))

(= (fix:py-repr $value)
   (if (== $value JsonNull) "None"
     (let* (($s (ih:stringify $value))
            ($esc1 (fix:replace $s "\\" "\\\\"))
            ($esc2 (fix:replace $esc1 "\n" "\\n"))
            ($esc3 (fix:replace $esc2 "\r" "\\r"))
            ($esc4 (fix:replace $esc3 "\t" "\\t"))
            ($has-sq (case (str:find $esc4 "'") (((TextNotFound $_) False) ($at True))))
            ($has-dq (case (str:find $esc4 "\"") (((TextNotFound $_) False) ($at True)))))
       (if (and $has-sq (not $has-dq))
         (str:join "" ("\"" $esc4 "\""))
         (str:join "" ("'" (fix:replace $esc4 "'" "\\'") "'"))))))

(= (fix:schema $name $description $parameters)
   (JsonObject ((JsonPair "type" "function") (JsonPair "function" (JsonObject
     ((JsonPair "name" $name) (JsonPair "description" $description)
      (JsonPair "parameters" (JsonObject
        ((JsonPair "type" "object")
         (JsonPair "properties" (JsonObject (map-atom $parameters $p
           (JsonPair $p (JsonObject ((JsonPair "type" "string")))))))
         (JsonPair "required" (JsonArray $parameters))
         (JsonPair "additionalProperties" False))))))))))

(= (fix:invoke-dynamic $rel-path $function $args $kwargs)
   (let* (($id (system:uuid4-hex))
          ($result-file (path:join (fix:root) (str:join "" (".fix-res-" $id ".json"))))
          ($payload-file (path:join (fix:root) (str:join "" (".fix-pay-" $id ".json"))))
          ($payload (JsonObject ((JsonPair "args" (JsonArray $args)) (JsonPair "kwargs" $kwargs))))
          ($_ (fs:write $payload-file (turn:json $payload)))
          ($abs-path (path:join (system:getcwd) $rel-path))
          ($redirect "import os,sys,types,runpy; fd=os.open(os.devnull,os.O_RDWR); [os.dup2(fd,i) for i in (0,1,2)]; os.close(fd) if fd>2 else None; sys.argv=sys.argv[1:]; sys.path.insert(0,os.path.dirname(os.path.abspath(sys.argv[0]))); sys.modules.setdefault('openai',types.SimpleNamespace()); runpy.run_path(sys.argv[0],run_name='__main__')")
          ($argv ((fix:python) "-c" $redirect (fix:upstream) "--invoke" $abs-path $function $result-file $payload-file))
          ($ran (proc:run $argv (system:getcwd) inherit 5000 65536))
          ($out (case $ran
                  (((proc:timed-out $_ $_) (JsonObject ((JsonPair "ok" False) (JsonPair "error" "TIMEOUT after 5s"))))
                   ((proc:exited $code $_ $_)
                     (if (fs:is-file $result-file)
                       (case (catch (json:parse (fs:read-text $result-file)))
                         (((JsonObject $pairs) (fix:unbox-leaf (JsonObject $pairs)))
                          ($bad (JsonObject ((JsonPair "ok" False)
                                  (JsonPair "error" (format-args "Dynamic process exited with code {} without a valid result" ($code))))))))
                       (JsonObject ((JsonPair "ok" False)
                               (JsonPair "error" (format-args "Dynamic process exited with code {} without a valid result" ($code)))))))
                   ($other (JsonObject ((JsonPair "ok" False) (JsonPair "error" (repr $other))))))))
          ($_ (if (fs:exists $result-file) (fs:remove $result-file) True))
          ($_ (if (fs:exists $payload-file) (fs:remove $payload-file) True)))
     $out))

; ---- ih:* host boundary ----

(= (ih:initialize)
   (let* (($script (fix:unbox-leaf (json:parse (fs:read-text (path:join (fix:root) "scenario.json")))))
          ($_ (change-state! &fix-script $script))
          ($_ (change-state! &fix-boundary 0))
          ($_ (change-state! &fix-receive 0))
          ($_ (change-state! &fix-reply 0))
          ($exp-path (path:join (fix:root) "experience.json"))
          ($experience (if (fs:exists $exp-path) (ih:box (json:parse (fs:read-text $exp-path))) (ih:list)))
          ($_ (fix:record "client"
                ((JsonPair "api_key" (system:getenv-or-default "AI_API_KEY" "dummy"))
                 (JsonPair "base_url" (system:getenv-or-default "BASE_URL" "http://192.168.64.1:2277/v1"))
                 (JsonPair "timeout" (fix:env-num "LLM_TIMEOUT" 600)) (JsonPair "max_retries" 0)
                 (JsonPair "default_headers" (JsonObject ((JsonPair "X-APC-Tenant" "iter") (JsonPair "x-session-id" "fixture")))))))
          ($_ (ih:sleep (ih:cfg-init-wait)))
          ($_ (fs:make-directories "memory" 448))
          ($_ (fs:make-directories "skills" 448))
          ($_ (fs:make-directories "transformations" 448)))
     $experience))

(= (ih:observe $experience $post $steps $burst $pending $bucket)
   (let* (($count (get-state &fix-boundary))
          ($exp-path (path:join (fix:root) "experience.json"))
          ($persisted (if (fs:exists $exp-path) (fix:unbox-leaf (json:parse (fs:read-text $exp-path))) JsonNull))
          ($_ (fix:record "boundary"
                ((JsonPair "iteration" $count)
                 (JsonPair "experience" (ih:json $experience))
                 (JsonPair "post" $post)
                 (JsonPair "steps" $steps)
                 (JsonPair "burst" $burst)
                 (JsonPair "pending" $pending)
                 (JsonPair "bucket" $bucket)
                 (JsonPair "persisted" $persisted))))
          ($next (+ $count 1))
          ($_ (change-state! &fix-boundary $next))
          ($limit (sf:get (get-state &fix-script) "iterations" 0)))
     (if (> $next $limit) (system:exit 0) True)))

(= (ih:sleep $seconds)
   (fix:record "sleep" ((JsonPair "seconds" $seconds))))

(= (ih:receive)
   (let* (($idx (get-state &fix-receive))
          ($events (fix:json-array-items (sf:get (get-state &fix-script) "events" (JsonArray ()))))
          ($val (if (< $idx (size-atom $events)) (index-atom $events $idx) ""))
          ($_ (change-state! &fix-receive (+ $idx 1)))
          ($_ (fix:record "receive" ((JsonPair "event" $val)))))
     $val))

(= (ih:save $experience)
   (let* (($json-val (ih:json $experience))
          ($text (turn:json $json-val))
          ($_ (sf:replace "experience.json" $text 420 False))
          ($_ (fix:record "save" ((JsonPair "experience" $json-val)))))
     True))

(= (ih:strip-reasoning $message)
   (let* (($_ (ih:remove $message "reasoning"))
          ($_ (ih:remove $message "reasoning_details"))
          ($_ (ih:remove $message "reasoning_content"))) True))

(= (ih:cleanup-message $message)
   (let* (($preserve (ih:cfg-return-value-preserve))
          ($content (if (== (ih:get $message "role") "tool") (ih:stringify (ih:get $message "content")) ""))
          ($_ (if (and (== (ih:get $message "role") "tool") (> (str:char-length $content) $preserve))
                (ih:put $message "content" (str:concat (str:char-slice $content 0 $preserve) " [TRUNCATED]")) True))
          ($_ (ih:strip-reasoning $message))) True))

(= (fix:py-files $directory)
   (if (not (fs:exists $directory)) ()
     (filter-atom (sort-atom (fs:entries $directory)) $name
       (and (str:ends-with $name ".py") (not (str:starts-with $name "_"))))))

(= (fix:stem $name)
   (str:char-slice $name 0 (- (str:char-length $name) 3)))

(= (fix:load-tools-loop $files $snapshot $schemas $errors)
   (if (== $files ())
     (let $out (ih:object)
       (let* (($_ (ih:put $out "snapshot" $snapshot))
              ($_ (ih:put $out "schemas" (ih:box (JsonArray (list:reverse $schemas)))))
              ($_ (ih:put $out "errors" (str:join "\n" (list:reverse $errors)))))
         $out))
     (let* (($file (car-atom $files))
            ($rel (path:join "tools" $file))
            ($name (fix:stem $file))
            ($res (fix:invoke-dynamic $rel "__tool_metadata__" () (JsonObject ()))))
       (if (== (sf:get $res "ok" False) True)
         (let* (($meta (sf:get $res "result" (JsonObject ())))
                ($desc (sf:get $meta "description" ""))
                ($params (fix:json-array-items (sf:get $meta "parameters" (JsonArray ()))))
                ($schema (fix:schema $name $desc $params))
                ($_ (ih:put $snapshot $name $rel)))
           (fix:load-tools-loop (cdr-atom $files) $snapshot (cons-atom $schema $schemas) $errors))
         (let $err (str:join "" ("[TOOL ERROR in " $rel ": RuntimeError: " (sf:get $res "error" "error") ". Repair " $rel " if needed.]"))
           (fix:load-tools-loop (cdr-atom $files) $snapshot $schemas (cons-atom $err $errors)))))))

(= (ih:tools)
   (let* (($limit (ih:cfg-max-tools))
          ($all (fix:py-files "tools"))
          ($active (list:take $limit $all))
          ($loaded (fix:load-tools-loop $active (ih:object) () ()))
          ($_ (ih:put $loaded "omitted" (max 0 (- (size-atom $all) $limit)))))
     $loaded))

(= (ih:tool-limit $count)
   (format-args "[TOOL LIMIT REACHED: {} tools are currently omitted. Consolidate or remove tools if they are needed.]" ($count)))

(= (ih:transformations)
   (let* (($limit (ih:cfg-max-context-transformations))
          ($all (fix:py-files "transformations"))
          ($active (list:take $limit $all))
          ($out (ih:object))
          ($_ (ih:put $out "files" $active))
          ($_ (ih:put $out "omitted" (max 0 (- (size-atom $all) $limit)))))
     $out))
(= (ih:transform-limit $count)
   (format-args "[CONTEXT TRANSFORMATION LIMIT REACHED: {} transformations are omitted and will not execute. Consolidate or remove transformations if they are needed.]" ($count)))

(= (fix:line-break-byte $bytes)
   (let* (($nl (str:find $bytes "\n"))
          ($cr (str:find $bytes "\r")))
     (case ($nl $cr)
       ((((TextNotFound $_) (TextNotFound $_)) none)
        (((TextNotFound $_) $c) $c)
        (($n (TextNotFound $_)) $n)
        (($n $c) (min $n $c))))))
(= (fix:read-first-line-loop $reader $chunks)
   (case (fs:read-chunk $reader 4096)
     (((fs:chunk $bytes $_)
       (if (== (str:byte-length $bytes) 0)
         (OkBytesV1 (str:join "" (list:reverse $chunks)))
         (case (fix:line-break-byte $bytes)
           ((none (fix:read-first-line-loop $reader (cons-atom $bytes $chunks)))
            ($cut (OkBytesV1 (str:join "" (list:reverse (cons-atom (str:byte-slice $bytes 0 $cut) $chunks)))))))))
      ((fs:end $_) (OkBytesV1 (str:join "" (list:reverse $chunks))))
      ($bad $bad))))
(= (fix:read-first-line $p)
   (let $reader (fs:open-read $p)
     (if (sf:failed? $reader) $reader
       (let* (($raw (fix:read-first-line-loop $reader ()))
              ($_ (fs:close $reader)))
         (case $raw
           (((OkBytesV1 $bytes)
             (let $decoder (str:utf8-new replace)
               (case (str:utf8-feed $decoder $bytes True)
                 (((Utf8DecodedV1 $text $_) ("ok" $text))
                  ($bad $bad)))))
            ($err $err)))))))
(= (fix:skill-description $p)
   (case (fix:read-first-line $p)
     ((("ok" $line)
       (let $first (str:trim $line)
         (if (re:is-match (re:pattern "^DESCRIPTION=\"(?:[^\"\\\\]|\\\\.)*\"$") $first)
           $first "[DESCRIPTION FIRST LINE MISSING]")))
      ($bad (str:join "" ("[READ ERROR: " (diagnostic:text $bad 200) "]"))))))
(= (fix:skill-paths $directory $prefix)
   (if (not (fs:exists $directory)) ()
     (fix:skill-names $directory $prefix (sort-atom (fs:entries $directory)))))
(= (fix:skill-names $directory $prefix $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($p (path:join $directory $name))
            ($display (path:join (if (== $prefix "") $directory $prefix) $name))
            ($rest (fix:skill-names $directory $prefix (cdr-atom $names))))
       (if (str:starts-with $name "_") $rest
         (if (fix:dir? $p)
           (list:append (fix:skill-paths $p $display) $rest)
           (if (and (fs:is-file $p) (str:ends-with $name ".md"))
             (cons-atom $display $rest) $rest))))))
(= (ih:skills)
   (let* (($limit (ih:cfg-max-skills))
          ($paths (sort-atom (fix:skill-paths "skills" "")))
          ($active (list:take $limit $paths))
          ($entries (map-atom $active $p (str:join "" ("./" $p ": " (fix:skill-description $p)))))
          ($surface (str:concat "./skills/:\n" (str:join "\n" $entries)))
          ($out (ih:object))
          ($_ (ih:put $out "surface" $surface))
          ($_ (ih:put $out "omitted" (max 0 (- (size-atom $paths) $limit)))))
     $out))
(= (ih:skill-limit $count)
   (format-args "[SKILL LIMIT REACHED: {} Markdown skills are omitted. Consolidate or remove skills if they are needed.]" ($count)))

(= (fix:memory-walk $directory $prefix)
   (if (not (fs:exists $directory)) ()
     (fix:memory-names $directory $prefix (sort-atom (fs:entries $directory)))))
(= (fix:memory-names $directory $prefix $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($p (path:join $directory $name))
            ($display (path:join (if (== $prefix "") "memory" $prefix) $name))
            ($rest (fix:memory-names $directory $prefix (cdr-atom $names))))
       (if (str:starts-with $name "_") $rest
         (if (fix:dir? $p)
           (list:append (fix:memory-walk $p $display) $rest)
           (if (fs:is-file $p)
             (case (fs:read-text-result $p 0 "replace")
               ((("ok" $text) (cons-atom ($display (str:trim $text)) $rest))
                ($bad $rest)))
             $rest))))))

(= (ih:memory)
   (let* (($rows (sort-atom (fix:memory-walk "memory" "")))
          ($length (foldl-atom $rows 0 $total $row (+ $total (str:char-length (index-atom $row 1)))))
          ($result (ih:object)) ($_ (ih:put $result "contents" $rows)) ($_ (ih:put $result "length" $length)))
     $result))
(= (ih:memory-surface $memory $contents)
   (let* (($rows (ih:get $memory "contents")) ($length (ih:get $memory "length"))
          ($max-chars (ih:cfg-max-memory-chars)))
     (if $contents
       (str:join "" ("[" (repr (- $max-chars $length)) " CHARACTERS BELOW MAXIMUM]\n./memory/:\n"
         (str:join "\n\n" (map-atom $rows $row (str:join "" ((index-atom $row 0) ":\n" (index-atom $row 1)))))))
       (str:concat "./memory/:\n" (str:join "\n" (map-atom $rows $row (index-atom $row 0)))))))
(= (ih:memory-overflow $length)
   (format-args "[MEMORY FOLDER TOTAL CHARACTER CAPACITY BY FILES NOT BEGINNING WITH _ EXCEEDED BY {} CHARS. FIX THIS FIRST.]" ((- $length (ih:cfg-max-memory-chars)))))

(= (fix:transform-descriptions $files)
   (str:join "\n" (map-atom $files $file
     (let* (($rel (path:join "transformations" $file))
            ($res (fix:invoke-dynamic $rel "__description__" () (JsonObject ()))))
       (if (== (sf:get $res "ok" False) True)
         (str:join "" ((fix:stem $file) ": " (sf:get $res "result" "")))
         (str:join "" ((fix:stem $file) ": [DESCRIPTION MISSING]")))))))

(= (fix:apply-transforms $files $messages $tools $errors)
   (if (== $files ())
     (FixTransformV1 $messages $tools (str:join "\n" (list:reverse $errors)))
     (let* (($file (car-atom $files))
            ($rel (path:join "transformations" $file))
            ($res (fix:invoke-dynamic $rel "transform" ($messages $tools) (JsonObject ()))))
       (if (== (sf:get $res "ok" False) True)
         (case (sf:get $res "result" JsonNull)
           (((JsonArray ($next-m $next-t))
             (fix:apply-transforms (cdr-atom $files) $next-m $next-t $errors))
            ($bad (let $err (str:join "" ("[RUNTIME ERROR in " $rel ": ValueError: invalid transform return. Repair " $rel " if needed.]"))
                    (fix:apply-transforms (cdr-atom $files) $messages $tools (cons-atom $err $errors))))))
         (let $err (str:join "" ("[RUNTIME ERROR in " $rel ": RuntimeError: " (sf:get $res "error" "error") ". Repair " $rel " if needed.]"))
           (fix:apply-transforms (cdr-atom $files) $messages $tools (cons-atom $err $errors)))))))

(= (fix:reply-refusal? $boxed)
   (case $boxed
     (((IterObjectV1 $_)
       (let $message (ih:optional $boxed "message")
         (case $message
           (((IterObjectV1 $_)
             (let* (($finish (str:lower (ih:stringify (ih:optional $boxed "finish"))))
                    ($refusal (ih:optional $message "refusal"))
                    ($content (ih:optional $message "content"))
                    ($calls (ih:optional $message "tool_calls")))
               (or (or (== $finish "refusal") (== $finish "content_filter"))
                   (or (ih:truth $refusal)
                       (not (or (ih:truth $content) (ih:truth $calls)))))))
            ($missing True)))))
      ($not-object True))))

(= (fix:call-model $model $final-msgs $after-tools)
   (let* (($_ (fix:record "request"
                ((JsonPair "model" $model)
                 (JsonPair "messages" $final-msgs)
                 (JsonPair "tools" $after-tools)
                 (JsonPair "tool_choice" (ih:cfg-tool-choice))
                 (JsonPair "max_tokens" (ih:cfg-max-tokens))
                 (JsonPair "extra_body" (JsonObject ((JsonPair "enable_thinking" True)))))))
          ($idx (get-state &fix-reply))
          ($replies (fix:json-array-items (sf:get (get-state &fix-script) "replies" (JsonArray ()))))
          ($reply (index-atom $replies $idx))
          ($_ (change-state! &fix-reply (+ $idx 1)))
          ($raised (sf:get $reply "raise" JsonNull)))
     (if (!= $raised JsonNull)
       (let $_ (fix:record "provider_error" ((JsonPair "error" $raised)))
         (Error provider (Fault $raised)))
       (let* (($msg (sf:get $reply "message" JsonNull))
              ($fin (sf:get $reply "finish" "tool_calls"))
              ($resp (ih:object))
              ($_ (ih:put $resp "message" (if (== $msg JsonNull) JsonNull (ih:box $msg))))
              ($_ (ih:put $resp "finish" $fin)))
         $resp))))

(= (ih:provider $experience $temporary $loaded $surface)
   (let* (($transforms (ih:transformations))
          ($skills (ih:skills)))
     (ih:provider-full $experience $temporary $loaded $transforms (ih:get $skills "surface") $surface)))

(= (ih:provider-full $experience $temporary $loaded $transforms-box $skills-surface $surface)
   (let* (($tfiles (ih:get $transforms-box "files"))
          ($tdescs (fix:transform-descriptions $tfiles))
          ($prompt (str:trim (fs:read-text "prompt.txt")))
          ($system (str:join "" ("prompt.txt:\n" $prompt "\n\n./transformations/:\n" $tdescs "\n\n" $surface "\n\n" $skills-surface)))
          ((JsonArray $hist) (ih:json $experience))
          ((JsonArray $temp) (ih:json $temporary))
          ($base-msgs (JsonArray (cons-atom (JsonObject ((JsonPair "role" "system") (JsonPair "content" $system)))
                                            (list:append $hist $temp))))
          ($base-tools (ih:json (ih:get $loaded "schemas")))
          ((FixTransformV1 $after-msgs $after-tools $terr) (fix:apply-transforms $tfiles $base-msgs $base-tools ()))
          ($final-msgs (if (== $terr "") $after-msgs
                         (case $after-msgs
                           (((JsonArray $items)
                             (JsonArray (list:append $items ((JsonObject ((JsonPair "role" "user") (JsonPair "content" $terr)))))))))))
          ($model (system:getenv-or-default "LLM_MODEL" "mlx-community/gemma-4-26b-a4b-it-4bit"))
          ($backup-raw (ih:cfg-backup-model))
          ($use-backup (and (!= $backup-raw "") (!= $backup-raw $model)))
          ($primary (fix:call-model $model $final-msgs $after-tools)))
     (if (turn:failed? $primary)
       (if (not $use-backup) $primary
         (let $fallback (fix:call-model $backup-raw $final-msgs $after-tools)
           (if (turn:failed? $fallback) $primary $fallback)))
       (if (or (not $use-backup) (not (fix:reply-refusal? $primary)))
         $primary
         (fix:call-model $backup-raw $final-msgs $after-tools)))))

(= (ih:retry-no-tool $content)
   (str:join "" ("[YOUR PREVIOUS RESPONSE CONTAINED NO TOOL CALL AND WAS NOT DELIVERED. CALL AT LEAST ONE TOOL NOW. IF YOU INTENDED THIS CONTENT AS COMMUNICATION, USE send: " (fix:py-repr $content) "]")))

(= (fix:py-json-error $text)
   (let $ran (proc:run ((fix:python) "-c" "import json,sys\ntry: json.loads(sys.argv[1])\nexcept Exception as e: print(e, end='')\n" $text)
                       (system:getcwd) inherit 5000 4096)
     (case $ran (((proc:exited 0 $out $_) $out) ($other "invalid JSON")))))

(= (ih:decode $arguments)
   (case (catch (json:parse $arguments))
     (((Error $_ $_)
       (ih:box (JsonObject ((JsonPair "ok" False)
                            (JsonPair "error" (str:concat "Invalid tool arguments from model: " (fix:py-json-error $arguments)))))))
      ((JsonFailureV1 $_ $_ $_ $_)
       (ih:box (JsonObject ((JsonPair "ok" False)
                            (JsonPair "error" (str:concat "Invalid tool arguments from model: " (fix:py-json-error $arguments)))))))
      ($value
       (let $unboxed (fix:unbox-leaf $value)
         (ih:box (JsonObject ((JsonPair "ok" True) (JsonPair "value" $unboxed)
                              (JsonPair "object" (case $unboxed (((JsonObject $_) True) ($other False))))))))))))

(= (ih:has-tool $loaded $name)
   (!= (ih:optional (ih:get $loaded "snapshot") $name) JsonNull))
(= (ih:unknown $name)
   (str:concat "Unknown tool: " (fix:py-repr $name)))
(= (ih:invoke $loaded $name $arguments)
   (let* (($rel (ih:get (ih:get $loaded "snapshot") $name))
          ($res (fix:invoke-dynamic $rel "run" () (ih:json $arguments))))
     (if (== (sf:get $res "ok" False) True)
       (ih:stringify (sf:get $res "result" JsonNull))
       (str:concat "Tool execution failed: " (sf:get $res "error" "error")))))
(= (ih:tool-message $call $output)
   (ih:box (JsonObject ((JsonPair "role" "tool") (JsonPair "tool_call_id" (ih:get $call "id"))
                       (JsonPair "content" (ih:step $output))))))
