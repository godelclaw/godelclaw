; Captured native components: metadata, schemas and invocation share one record.
!(import! &self ./tool_io_cetta.metta)
!(import! &self ../src/tool_output_cetta.metta)
!(import! &self ../src/semantic_memory_cetta.metta)
!(import! &self ./history_cetta.metta)
!(import! &self (library math))
(= (component:failed? $value) (case $value (((Error $_ $_) True) ($other False))))
(= (component:env-num $name $default)
   (let $raw (str:trim (system:getenv-or-default $name ""))
     (if (== $raw "") $default
       (let $parsed (catch (str:string->number $raw))
         (if (== (get-type $parsed) Number) $parsed $default)))))
(= (component:env-int $name $default)
   (math:floor (component:env-num $name $default)))
(= (component:dynamic-timeout-ms)
   (max 100 (math:floor (* 1000 (component:env-num "DYNAMIC_TIMEOUT" 5)))))
(= (component:names $directory)
   (if (fs:exists $directory)
     (filter-atom (sort-atom (fs:entries $directory)) $name
       (and (str:ends-with $name ".metta") (not (str:starts-with $name "_")))) ()))
(= (component:source $directory $name)
   (case (fs:read-text-result (path:join $directory $name) 0 "replace")
     ((("ok" $source) (component:captured $name $source))
      ($bad (Error component-capture (Fault unreadable-source))))))
(= (component:captured $filename $source)
   (let* (($name (str:char-slice $filename 0 (- (str:char-length $filename) 6)))
          ($forms (catch (parse (str:join "" ("(\n" $source "\n)")))))
          ($declarations (filter-atom $forms $form
            (if (== (get-metatype $form) Expression) (== (car-atom $form) ComponentDeclarationV1) False)))
          ($digest (str:sha256 $source)))
     (if (!= (size-atom $declarations) 1) (Error component-capture (Unsolvable missing-or-ambiguous-declaration))
       (case (car-atom $declarations)
         (((ComponentDeclarationV1 $description $parameters)
           (NativeComponentV1 $name $description $parameters (ComponentModuleV1 $source) $digest))
          ((ComponentDeclarationV1 $description $parameters (ComponentBuiltinV1 $builtin))
           (NativeComponentV1 $name $description $parameters (ComponentBuiltinV1 $builtin) $digest))
          ($bad (Error component-capture (Unsolvable invalid-declaration))))))))
(= (component:tool-admit $ref)
   (case $ref
     (((NativeComponentV1 $name $description $parameters $_ $_)
       (if (and (re:is-match (re:pattern "^[A-Za-z_][A-Za-z0-9_-]*$") $name)
                (== (get-type $description) String))
         $ref (Error component-capture (Unsolvable invalid-tool-declaration))))
      ($bad $bad))))
(= (component:refs $directory $names)
   (map-atom $names $name (component:source $directory $name)))
(= (component:capture-tools)
   (component:capture-tools-max (max 0 (component:env-int "MAX_TOOLS" 30))))
(= (component:capture-tools-max $limit)
   (let* (($names (component:names "tools"))
          ($refs (map-atom (component:refs "tools" (list:take $limit $names)) $ref (component:tool-admit $ref)))
          ($errors (filter-atom $refs $ref (component:failed? $ref)))
          ($valid (filter-atom $refs $ref (not (component:failed? $ref)))))
     (ComponentSetV1 $valid (max 0 (- (size-atom $names) $limit))
       (str:join "\n" (map-atom $errors $error (diagnostic:text $error 500))))))
(= (component:omitted (ComponentSetV1 $_ $omitted $_)) $omitted)
(= (component:errors (ComponentSetV1 $_ $_ $errors)) $errors)
(= (component:find (ComponentSetV1 $refs $_ $_) $name)
   (component:find-in $refs $name))
(= (component:find-in $refs $name)
   (if (== $refs ()) none
     (case (car-atom $refs)
       (((NativeComponentV1 $id $_ $_ $_ $_)
         (if (== $id $name) (car-atom $refs) (component:find-in (cdr-atom $refs) $name)))))))
(= (component:has? $set $name) (!= (component:find $set $name) none))
(= (component:schemas (ComponentSetV1 $refs $_ $_))
   (let $max-desc (max 0 (component:env-int "MAX_TOOL_DESCRIPTION_CHARS" 500))
     (map-atom $refs $ref
       (case $ref (((NativeComponentV1 $name $description $parameters $_ $_)
         (mode-tool:schema $name
           (if (> (str:char-length $description) $max-desc)
             (str:concat (str:char-slice $description 0 $max-desc) " [DESCRIPTION TRUNCATED]") $description)
           $parameters)))))))
(= (component:argument-error $parameters $arguments)
   (case $arguments
     (((JsonObject $pairs)
       (let* (($names (map-atom $parameters $name (turn:text $name)))
              ($missing (filter-atom $names $name (!= (get-type (sf:get $arguments $name JsonNull)) String)))
              ($extra (filter-atom $pairs $pair (not (erv:contains $names (case $pair (((JsonPair $key $_) $key))))))))
         (if (or (!= $missing ()) (!= $extra ())) (Error component-call (Unsolvable invalid-tool-arguments)) True)))
      ($bad (Error component-call (Unsolvable arguments-must-be-object))))))
(= (component:invoke $set $name $arguments)
   (case (component:find $set $name)
     ((none (str:concat "Unknown tool: " (repr $name)))
      ((NativeComponentV1 $_ $_ $parameters (ComponentBuiltinV1 "python") $_)
        (let $valid (component:argument-error $parameters $arguments)
          (if (!= $valid True) $valid (component:python (sf:get $arguments "code" "") $set))))
      ($ref (component:invoke-ref $ref $arguments)))))
(= (component:invoke-ref (NativeComponentV1 $name $_ $parameters $implementation $_) $arguments)
   (let $valid (component:argument-error $parameters $arguments)
     (if (!= $valid True) $valid
       (case $implementation
         (((ComponentBuiltinV1 $builtin) (component:builtin $builtin $arguments))
          ((ComponentModuleV1 $source) (component:run-source $source "run" $arguments))
          ($bad (Error component-call (Fault unknown-implementation))))))))
(= (component:run-source $source $operation $input)
   (let* (($root (artifact:directory)) ($_ (fs:make-directories $root 448))
          ($id (system:uuid4-hex)) ($base (path:join $root (str:concat ".component-" $id)))
          ($module (str:concat $base ".metta")) ($payload (str:concat $base ".input"))
          ($result (str:concat $base ".output"))
          ($source-written (sf:replace $module $source 384 False))
          ($input-written (sf:replace $payload (turn:json $input) 384 False)))
     (if (or (!= $source-written True) (!= $input-written True))
       (Error component-call (Fault staging-failed))
       (let* (($worker (path:join (mode-tool:app-root) "modes/component_worker_cetta.metta"))
              ($ran (proc:run ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended"
                       "--import-mode" "ancestor-walk" $worker "--" $operation $module $payload $result)
                      (system:getcwd) inherit (component:dynamic-timeout-ms) 65536))
              ($answer (case $ran
                 (((proc:exited 0 $_ $_) (sf:native-object $result))
                  ($other (Error component-call
                    (Incomplete (worker-result-unknown (diagnostic:text $other 600) $base)))))))
              ($_ (if (component:failed? $answer) True (fs:remove $module)))
              ($_ (if (component:failed? $answer) True (fs:remove $payload)))
              ($_ (if (component:failed? $answer) True (collapse (catch (fs:remove $result))))))
         (case $answer
           (((JsonObject $_)
             (if (== (sf:get $answer "ok" False) True) (sf:get $answer "result" JsonNull)
               (Error component-call (Fault (sf:get $answer "error" "native component failed")))))
            ($bad $bad)))))))
(= (component:builtin $name $arguments)
   (case $name
     (("nop" "SUCCESS")
      ("send" (let $sent (mode-host:send (sf:get $arguments "content" "") (sf:get $arguments "channel" "telegram"))
                (if (turn:failed? $sent) $sent "SUCCESS")))
      ("shell" (mode-tool:shell (sf:get $arguments "cmd" "")))
      ("python" (component:python (sf:get $arguments "code" "")))
      ; The agent's long-term memory and history, shared with every loop.
      ("remember" (semantic:remember (sf:get $arguments "content" "")))
      ("query" (semantic:query (sf:get $arguments "content" "") 20))
      ("episodes" (if (mode-history:shared?)
                    (mode-history:episodes (mode-history:path) (sf:get $arguments "timestamp" "") 20)
                    (Error component-call (Unsolvable agent-history-unavailable))))
      ($unknown (Error component-call (Unsolvable unknown-native-builtin))))))
(= (component:memory $directory)
   (sort-atom (component:memory-at $directory "")))
(= (component:memory-at $directory $prefix)
   (if (not (fs:exists $directory)) ()
     (component:memory-names $directory $prefix (sort-atom (fs:entries $directory)))))
(= (component:memory-names $directory $prefix $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($path (path:join $directory $name))
            ($display (path:join (if (== $prefix "") "memory" $prefix) $name))
            ($rest (component:memory-names $directory $prefix (cdr-atom $names))))
       (if (str:starts-with $name "_") $rest
         (if (mode-tool:directory? $path)
           (list:append (component:memory-at $path $display) $rest)
           (if (fs:is-file $path)
             (case (fs:read-text-result $path 0 "replace")
               ((("ok" $text) (cons-atom ($display (str:trim $text)) $rest))
                ($bad (Error component-memory (Fault unreadable-memory-file)))))
             $rest))))))
(= (component:capture-transformations-with-cap $limit)
   (let* (($cap (max 0 $limit))
          ($names (component:names "transformations"))
          ($active (component:refs "transformations" (list:take $cap $names))))
     (TransformSetV1 $active (max 0 (- (size-atom $names) $cap)))))
(= (component:capture-transformations)
   (case (component:capture-transformations-with-cap (component:env-int "MAX_CONTEXT_TRANSFORMATIONS" 30))
     (((TransformSetV1 $active $_) $active))))
(= (component:transform-refs $value)
   (case $value (((TransformSetV1 $refs $_) $refs) ($list $list))))
(= (component:transform-omitted $value)
   (case $value (((TransformSetV1 $_ $omitted) $omitted) ($list 0))))
(= (component:descriptions $value)
   (str:join "\n" (map-atom (component:transform-refs $value) $ref
     (case $ref
       (((NativeComponentV1 $name $description $_ $_ $_) (str:concat $name (str:concat ": " $description)))
        ($bad "[DESCRIPTION MISSING]"))))))
(= (component:transform $value $messages $tools)
   (component:transform-next (component:transform-refs $value) $messages $tools ()))
; Index Markdown skills by path and exact first-line DESCRIPTION="..." only.
; Stream only through the first newline (\n, \r\n, or \r) so large Markdown
; skill bodies are never loaded into memory just to index line 1.
(= (component:line-break-byte $bytes)
   (let* (($nl (str:find $bytes "\n"))
          ($cr (str:find $bytes "\r")))
     (case ($nl $cr)
       ((((TextNotFound $_) (TextNotFound $_)) none)
        (((TextNotFound $_) $c) $c)
        (($n (TextNotFound $_)) $n)
        (($n $c) (min $n $c))))))
(= (component:read-first-line-loop $reader $chunks)
   (case (fs:read-chunk $reader 4096)
     (((fs:chunk $bytes $_)
       (if (== (str:byte-length $bytes) 0)
         (OkBytesV1 (str:join "" (list:reverse $chunks)))
         (case (component:line-break-byte $bytes)
           ((none (component:read-first-line-loop $reader (cons-atom $bytes $chunks)))
            ($cut (OkBytesV1 (str:join "" (list:reverse (cons-atom (str:byte-slice $bytes 0 $cut) $chunks)))))))))
      ((fs:end $_) (OkBytesV1 (str:join "" (list:reverse $chunks))))
      ($bad $bad))))
(= (component:read-first-line $path)
   (let $reader (fs:open-read $path)
     (if (sf:failed? $reader) $reader
       (let* (($raw (component:read-first-line-loop $reader ()))
              ($_ (fs:close $reader)))
         (case $raw
           (((OkBytesV1 $bytes)
             (let $decoder (str:utf8-new replace)
               (case (str:utf8-feed $decoder $bytes True)
                 (((Utf8DecodedV1 $text $_) ("ok" $text))
                  ($bad $bad)))))
            ($err $err)))))))
(= (component:skill-description $path)
   (case (component:read-first-line $path)
     ((("ok" $line)
       (let $first (str:trim $line)
         (if (re:is-match (re:pattern "^DESCRIPTION=\"(?:[^\"\\\\]|\\\\.)*\"$") $first)
           $first "[DESCRIPTION FIRST LINE MISSING]")))
      ($bad (str:join "" ("[READ ERROR: " (diagnostic:text $bad 200) "]"))))))
(= (component:skill-paths $directory $prefix)
   (if (not (fs:exists $directory)) ()
     (component:skill-names $directory $prefix (sort-atom (fs:entries $directory)))))
(= (component:skill-names $directory $prefix $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($path (path:join $directory $name))
            ($display (path:join (if (== $prefix "") $directory $prefix) $name))
            ($rest (component:skill-names $directory $prefix (cdr-atom $names))))
       (if (str:starts-with $name "_") $rest
         (if (mode-tool:directory? $path)
           (list:append (component:skill-paths $path $display) $rest)
           (if (and (fs:is-file $path) (str:ends-with $name ".md"))
             (cons-atom $display $rest) $rest))))))
(= (component:skills $directory $limit)
   (let* (($cap (max 0 $limit))
          ($paths (sort-atom (component:skill-paths $directory "")))
          ($active (list:take $cap $paths))
          ($entries (map-atom $active $p (str:join "" ("./" $p ": " (component:skill-description $p)))))
          ($surface (str:concat "./skills/:\n" (str:join "\n" $entries))))
     (SkillSetV1 $surface (max 0 (- (size-atom $paths) $cap)))))
(= (component:transform-next $refs $messages $tools $reverse-errors)
   (if (== $refs ())
     (let $errors (str:join "\n" (list:reverse $reverse-errors)) (ComponentRequestV1 $messages $tools $errors))
     (let $result (component:one-transform (car-atom $refs) $messages $tools)
       (case $result
         (((ComponentTransformedV1 $next-messages $next-tools)
           (component:transform-next (cdr-atom $refs) $next-messages $next-tools $reverse-errors))
          ($failure
            (component:transform-next (cdr-atom $refs) $messages $tools
              (cons-atom (str:join "" ("[RUNTIME ERROR in transformation: "
                 (diagnostic:text $failure 400) ". Repair the component if needed.]")) $reverse-errors))))))))
(= (component:one-transform $ref $messages $tools)
   (case $ref
     (((NativeComponentV1 $_ $_ $_ (ComponentModuleV1 $source) $_)
       (let $answer (component:run-source $source "transform" (JsonArray ($messages $tools)))
         (case $answer
           (((JsonArray ((JsonArray $next-messages) (JsonArray $next-tools)))
             (ComponentTransformedV1 (JsonArray $next-messages) (JsonArray $next-tools)))
            ($failure $failure)))))
      ($bad (Error component-transform (Unsolvable invalid-declaration))))))
