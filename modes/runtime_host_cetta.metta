; Managed loops share native channel routing, durable checkpoints and provider ownership.
!(import! &self ../src/native_llm.metta)
!(import! &self ../src/state_file_cetta.metta)
!(import! &self ../src/boot_state_cetta.metta)
!(import! &self ../src/activity_source_cetta.metta)
!(import! &self ../channels/telegram.metta)
!(import! &self ../channels/telegram_control_io.metta)
!(bind! &mode-capture (new-state ()))
!(bind! &mode-capture-text (new-state ""))
!(bind! &mode-native-ledger (new-state none))
(= (mode-host:root) (system:getenv-or-default "METTACLAW_MODE_RUNTIME" (system:getcwd)))
(= (mode-host:shared) (system:getenv-or-default "METTACLAW_MODE_STATE_ROOT" (path:dirname (mode-host:root))))
(= (mode-host:name) (system:getenv-or-default "METTACLAW_ACTIVE_LOOP_MODE" "iter"))
(= (mode-host:stop-ledger)
   (let $owner (get-state &mode-native-ledger)
     (if (== $owner none) True
       (let* (($_ (change-state! &mode-native-ledger none))
              ($_ (catch (proc:cancel $owner)))
              ($_ (catch (proc:wait $owner 2000)))
              ($_ (catch (proc:close $owner))))
         True))))
(= (mode-host:stop-uncommitted $reason)
   (let* (($_ (mode-host:stop-ledger))
          ($_ (system:write stderr (str:concat "managed transition incomplete: " (str:concat (diagnostic:text $reason 800) "\n")))))
     (system:exit 75)))
(= (mode-host:standalone?) (== (system:getenv-or-default "METTACLAW_MODE_PROFILE" "") "standalone"))
(= (mode-host:record $kind $fields)
   (let $path (path:join (mode-host:root) "runtime.jsonl")
     (let $owner (fs:open-write $path ("create" "append") 384)
       (if (sf:failed? $owner) $owner
         (let* (($value (sf:put-all
                          (JsonObject ((JsonPair "time" (system:wall-time)) (JsonPair "kind" $kind)
                                       (JsonPair "mode" (mode-host:name)))) $fields))
                ($written (fs:write-all $owner (str:concat (turn:json $value) "\n")))
                ($_ (fs:close $owner))) $written)))))
(= (mode-host:gate)
   (if (mode-host:standalone?) True
     (case (boot-state:recycle)
       ((True (progn (mode-host:stop-ledger) (system:exit 0)))
        (False
          (case (lifecycle-native:enabled)
            ((1 True)
             ($paused (let $_ (host-native:sleep-ms 250) (mode-host:gate))))))
        ($failed (Error managed-mode (Incomplete lifecycle-state-unavailable)))))))
(= (mode-host:sleep $seconds)
   (mode-host:sleep-until (+ (system:monotonic-ns) (* (max 0 $seconds) 1000000000))))
(= (mode-host:before-provider)
   (let $ready (mode-host:gate)
     (if (!= $ready True) $ready
       (if (mode-host:standalone?) True
         (let* (($left (max 0 (- (sf:get (health:read) "retry_at" 0) (system:wall-time))))
                ($blocked (rejection:blocked?)))
           (if (or (> $left 0) $blocked)
             (let* (($_ (if $blocked (rejection:notify) 0))
                    ($_ (host-native:gate-progress))
                    ($_ (mode-host:sleep (if $blocked 1 (min 1 $left)))))
               (mode-host:before-provider))
             True))))))
(= (mode-host:sleep-until $deadline)
   (let $ready (mode-host:gate)
     (if (!= $ready True) $ready
       (let $left (/ (- $deadline (system:monotonic-ns)) 1000000)
         (if (<= $left 0) True
           (let $slept (host-native:sleep-ms (min 250 $left))
             (if (turn:failed? $slept) $slept (mode-host:sleep-until $deadline))))))))
(= (mode-host:checkpoint-path) (path:join (mode-host:root) "native-checkpoint-v1.json"))
(= (mode-host:record-read)
   (case (fs:read-text-result (mode-host:checkpoint-path) 0 "raw")
     ((("missing" $_) none)
      (("ok" $text)
        (case (catch (json:parse $text))
          (((JsonObject $pairs)
            (let $record (JsonObject $pairs)
              (if (and (== (sf:get $record "schema" 0) 1)
                       (== (sf:get $record "mode" "") (mode-host:name))) $record
                (Error mode-checkpoint (Unsolvable incompatible-record)))))
           ($bad (Error mode-checkpoint (Fault malformed-record))))))
      ($bad (Error mode-checkpoint (Fault unreadable-record))))))
(= (mode-host:array $object $key)
   (case (sf:get $object $key (JsonArray ())) (((JsonArray $items) $items) ($bad ()))))
(= (mode-host:ack-one $task)
   (if (str:starts-with $task "handover:")
     (let $id (str:char-slice $task 9 (str:char-length $task))
       (if (not (activity-source:update-id? $id)) False
         (activity-source:mark-done (path:join (mode-host:shared) "channel-handover") ($id))))
     (case (cwp:call (tio:socket) 2 $task "[]" 5000)
       (((cwp:reply 66 $_ $_) True) ((cwp:reply 68 $_ $_) True)
        ((cwp:reply 69 $_ $_) True) ($bad False)))))
(= (mode-host:ack-tasks $tasks)
   (if (== $tasks ()) ()
     (let* (($task (car-atom $tasks)) ($acked (mode-host:ack-one $task))
            ($rest (mode-host:ack-tasks (cdr-atom $tasks))))
       (if $acked $rest (cons-atom $task $rest)))))
(= (mode-host:restore $record)
   (if (== (sf:get $record "status" "pending") "settled")
     (mode-host:settle-record $record)
     (let* (($path (sf:get $record "path" "")) ($payload (sf:get $record "payload" ""))
            ($digest (sf:get $record "sha256" "")))
       (if (or (== $path "") (!= (str:sha256 $payload) $digest))
         (Error mode-checkpoint (Fault invalid-payload))
         (let $written (if (== (sf:get $record "operation" "replace") "append")
                          (mode-host:resume-append $record)
                          (sf:replace $path $payload 384 True))
           (if (!= $written True) (Error mode-checkpoint (Incomplete (projection-not-durable $written)))
             (mode-host:settle-record $record)))))))
(= (mode-host:settle-record $record)
   (let* (($ids (mode-host:array $record "ids"))
          ($tasks (mode-host:array $record "tasks"))
          ($when (sf:get $record "recorded_at" 0))
          ($settled (if (or (== $ids ()) (or (mode-host:standalone?) (not (state:native-ledger)))) True
                        (state:ledger "mark-processed" ($when $ids)))))
     (if (!= $settled True) (Error mode-checkpoint (Incomplete settlement-unconfirmed))
       (let* (($remaining (if (mode-host:standalone?) () (mode-host:ack-tasks $tasks)))
              ($updated (sf:put-all $record
                ((JsonPair "ids" (JsonArray ())) (JsonPair "tasks" (JsonArray $remaining)) (JsonPair "status" "settled"))))
              ($saved (if (== (turn:json $record) (turn:json $updated)) True
                        (sf:replace (mode-host:checkpoint-path) (turn:json $updated) 384 True)))
              ($view (if (== $saved True)
                (mode-host:write-view (path:join (mode-host:root) "offered-input.json") (turn:json (JsonArray $remaining))) $saved)))
         (if (== $view True) True (Error mode-checkpoint (Incomplete acknowledgement-view-unconfirmed)))))))
(= (mode-host:write-view $path $text)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $same) (if (== $same $text) True (sf:replace $path $text 384 True)))
      ($other (sf:replace $path $text 384 True)))))
(= (mode-host:recover)
   (let $record (mode-host:record-read)
     (case $record
       ((none True) ((Error $_ $_) $record) ($valid (mode-host:restore $valid))))))
(= (mode-host:new-record $path $payload $previous $operation)
   (let* (($captured (get-state &mode-capture))
          ($new-tasks (map-atom $captured $row (case $row (((ModeInputV1 $task $_) $task)))))
          ($tasks (unique-atom (list:append (mode-host:array $previous "tasks") $new-tasks)))
          ($ids (unique-atom
            (filter-atom (map-atom $captured $row (case $row (((ModeInputV1 $_ $id) $id)))) $id (!= $id "")))))
     (JsonObject ((JsonPair "schema" 1) (JsonPair "mode" (mode-host:name))
       (JsonPair "operation" $operation) (JsonPair "status" "pending")
       (JsonPair "path" $path) (JsonPair "payload" $payload) (JsonPair "sha256" (str:sha256 $payload))
       (JsonPair "ids" (JsonArray $ids)) (JsonPair "captured_ids" (JsonArray $ids))
       (JsonPair "tasks" (JsonArray $tasks)) (JsonPair "recorded_at" (system:wall-time))))))
(= (mode-host:publish $record)
   (let $written (sf:replace (mode-host:checkpoint-path) (turn:json $record) 384 True)
     (if (!= $written True) (Error mode-checkpoint (Incomplete record-not-durable))
       (let $restored (mode-host:restore $record)
         (if (!= $restored True) $restored
           (let $_ (change-state! &mode-capture ()) True))))))
(= (mode-host:checkpoint $path $payload) (mode-host:checkpoint-with $path $payload ()))
; A replacement whose record also carries <fields>, durable with the payload.
(= (mode-host:checkpoint-with $path $payload $fields)
   (let $ready (mode-host:recover)
     (if (!= $ready True) $ready
       (mode-host:publish (sf:put-all (mode-host:new-record $path $payload (mode-host:record-read) "replace") $fields)))))
(= (mode-host:file-info $path)
   (case (fs:metadata $path follow-observed)
     (((fs:info-v2 regular $size (fs:identity $device $inode) $_ $_ $_ $_)
       (ModeFileV1 $size $device $inode))
      ($bad (Error mode-checkpoint (Fault (file-metadata $bad)))))))
(= (mode-host:ensure-file $path)
   (if (fs:exists $path) True
     (let $owner (fs:open-write $path ("create" "exclusive") 384)
       (case $owner
         (((NativeHandle $_ $_)
           (let* (($synced (fs:sync $owner)) ($_ (fs:close $owner))
                  ($directory (sf:sync-directory (path:dirname $path))))
             (if (or (sf:failed? $synced) (!= $directory True))
               (Error mode-checkpoint (Incomplete initial-file-not-durable)) True)))
          ($bad (Error mode-checkpoint (Fault create-file-failed))))))))
(= (mode-host:append-checkpoint $path $payload)
   (let* (($ready (mode-host:recover))
          ($created (if (== $ready True) (mode-host:ensure-file $path) $ready)))
     (if (!= $created True) $created
       (case (mode-host:file-info $path)
         (((ModeFileV1 $offset $device $inode)
           (mode-host:publish (sf:put-all
             (mode-host:new-record $path $payload (mode-host:record-read) "append")
             ((JsonPair "offset" $offset) (JsonPair "device" $device) (JsonPair "inode" $inode)))))
          ($bad $bad))))))
; A read that failed says nothing of the bytes it was to read: no match and
; no mismatch is established from it.
(= (mode-host:read-failed? $value)
   (case $value (((Error $_ $_) True) ((fs:failed $_ $_ $_ $_ $_ $_) True) ($text False))))
(= (mode-host:read-at $path $offset $bytes)
   (let $owner (fs:open-read $path)
     (case $owner
       (((NativeHandle $_ $_)
         (let* (($read (mode-host:read-owned $owner $offset $bytes ())) ($_ (fs:close $owner))) $read))
        ($bad (Error mode-checkpoint (Fault open-prefix-failed)))))))
(= (mode-host:read-owned $owner $offset $left $reverse)
   (if (== $left 0) (str:join "" (list:reverse $reverse))
     (case (fs:read-chunk $owner (min 65536 $left) $offset)
       (((fs:chunk $bytes $_)
         (let $count (str:byte-length $bytes)
           (if (or (== $count 0) (> $count $left)) (Error mode-checkpoint (Incomplete invalid-prefix-progress))
             (mode-host:read-owned $owner (+ $offset $count) (- $left $count) (cons-atom $bytes $reverse)))))
        ($bad (Error mode-checkpoint (Incomplete prefix-unavailable)))))))
(= (mode-host:resume-append $record)
   (let* (($path (sf:get $record "path" "")) ($data (sf:get $record "payload" ""))
          ($offset (sf:get $record "offset" -1))
          ($expected-device (sf:get $record "device" "")) ($expected-inode (sf:get $record "inode" "")))
     (case (mode-host:file-info $path)
       (((ModeFileV1 $size $device $inode)
         (let $progress (- $size $offset)
           (if (or (< $offset 0) (or (!= $device $expected-device) (or (!= $inode $expected-inode) (< $progress 0))))
             (Error mode-checkpoint (Forbidden append-generation-or-size-changed))
             ; A shared history may have grown past a complete append.
             (if (> $progress (str:byte-length $data)) (mode-host:verify-append $record)
             (let $observed (mode-host:read-at $path $offset $progress)
               (if (mode-host:read-failed? $observed) (Error mode-checkpoint (Incomplete prefix-unavailable))
               (if (!= $observed (str:byte-slice $data 0 $progress))
                 (Error mode-checkpoint (Forbidden foreign-append-prefix))
                 (let $appended (mode-host:append-rest $path
                                      (str:byte-slice $data $progress (str:byte-length $data)))
                   (if (!= $appended True) $appended
                     (mode-host:verify-append $record))))))))))
        ($bad $bad)))))
(= (mode-host:append-rest $path $bytes)
   (let $owner (fs:open-write $path ("append") 384)
     (case $owner
       (((NativeHandle $_ $_)
         (let* (($written (fs:write-all $owner $bytes))
                ($synced (if (sf:failed? $written) $written (fs:sync $owner)))
                ($_ (fs:close $owner)))
           (if (sf:failed? $synced) (Error mode-checkpoint (Incomplete append-write-unconfirmed)) True)))
        ($bad (Error mode-checkpoint (Fault append-open-failed)))))))
(= (mode-host:verify-append $record)
   (let* (($path (sf:get $record "path" "")) ($data (sf:get $record "payload" ""))
          ($offset (sf:get $record "offset" 0)) ($length (str:byte-length $data)))
     ; Another file, a shorter one, or other bytes at the offset: established.
     ; A read that failed: unknown, and the record stays as it is.
     (case (mode-host:file-info $path)
       (((ModeFileV1 $size $device $inode)
         (if (not (and (== $device (sf:get $record "device" "")) (== $inode (sf:get $record "inode" ""))))
           (Error mode-checkpoint (Forbidden append-generation-changed))
           (if (< $size (+ $offset $length)) (Error mode-checkpoint (Forbidden append-verification-short))
             (let $observed (mode-host:read-at $path $offset $length)
               (if (mode-host:read-failed? $observed) (Error mode-checkpoint (Incomplete verification-unavailable))
                 (if (== $observed $data) True (Error mode-checkpoint (Forbidden append-verification-mismatch))))))))
        ($bad $bad)))))
(= (mode-host:route-name $chat $thread)
   (str:join "" ("telegram_" (str:join "m" (str:split "-" $chat)) "_" (repr $thread))))
(= (mode-host:remember-route $message)
   (let* (($chat (tg:str (tg:at (tg:at $message "chat") "id")))
          ($thread (tg:at $message "message_thread_id"))
          ($number (if (== $thread JsonNull) 0 (str:string->number (tg:str $thread))))
          ($name (mode-host:route-name $chat $number))
          ($folder (path:join (mode-host:shared) "channel-routes"))
          ($_ (fs:make-directories $folder 448))
          ($stored (sf:replace (path:join $folder (str:concat $name ".json"))
              (turn:json (JsonObject ((JsonPair "chat" $chat) (JsonPair "thread" $number)
                (JsonPair "type" (tg:str (tg:at (tg:at $message "chat") "type")))
                (JsonPair "title" (tg:str (tg:at (tg:at $message "chat") "title")))))) 384 True)))
     (if (== $stored True) $name (Error managed-channel (Incomplete route-not-durable)))))
(= (mode-host:route $destination)
   (if (== $destination "telegram")
     (JsonObject ((JsonPair "chat" (tio:primary-chat)) (JsonPair "thread" 0)))
     (if (not (re:is-match (re:pattern "^telegram_m?[0-9]+_[0-9]+$") $destination))
       (Error managed-channel (Forbidden unknown-route))
       (let* (($value (sf:native-object (path:join (path:join (mode-host:shared) "channel-routes") (str:concat $destination ".json"))))
              ($name (mode-host:route-name (sf:get $value "chat" "") (sf:get $value "thread" 0))))
         (if (== $name $destination) $value (Error managed-channel (Forbidden invalid-route)))))))
(= (mode-host:send $text $destination)
   (if (mode-host:standalone?)
     (if (erv:contains ("telegram" "terminal") $destination)
       (let $_ (println! $text) "SUCCESS") (Error managed-channel (Forbidden unknown-terminal-channel)))
     (let $route (mode-host:route $destination)
       (if (turn:failed? $route) $route
         (let* (($chat (tio:chat-number (sf:get $route "chat" ""))) ($thread (sf:get $route "thread" 0))
                ($folder (tio:outbox)) ($_ (fs:make-directories $folder 448))
                ($sequence (tio:next-sequence $folder))
                ($key (str:join "" ((repr $chat) "." (repr $thread) "." (tio:pad20 $sequence))))
                ($commands (map-atom (tg:chunks $text) $piece (JsonArray ("send" $piece "plain"))))
                ($written (tio:store-intent $key (JsonObject ((JsonPair "key" $key) (JsonPair "commands" (JsonArray $commands)))))))
           (if (== $written True) (str:concat "durably queued: " $key)
             (Error managed-channel (Incomplete send-intent-not-durable))))))))
(= (mode-host:pending $after $left)
   (if (<= $left 0) ()
     (case (cwp:call (tio:socket) 1 $after "" 5000)
       (((cwp:reply 65 $task $body)
         (cons-atom ($task $body) (mode-host:pending $task (- $left 1))))
        ((cwp:reply 64 $_ $_) ())
        ($bad (Error managed-channel (Incomplete inbox-unavailable)))))))
(= (mode-host:handover)
   (let $folder (path:join (mode-host:shared) "channel-handover")
     (if (not (fs:exists $folder)) ()
       (map-atom (filter-atom (sort-atom (fs:entries $folder)) $name (str:ends-with $name ".json"))
         $name (let* (($id (str:char-slice $name 0 (- (str:char-length $name) 5)))
                      ($update (sf:native-object (path:join $folder $name))))
                 ((str:concat "handover:" $id) (turn:json (JsonArray ("input" "" "message" "" $update)))))))))
(= (mode-host:receive)
   (if (!= (get-state &mode-capture) ()) (get-state &mode-capture-text)
     (mode-host:receive-fresh)))
(= (mode-host:receive-fresh)
   (let $ready (mode-host:gate)
     (if (!= $ready True) $ready
       (if (mode-host:standalone?)
         (case (system:read-line 0) ((() "") (end_of_file "") ($line (str:trim (turn:text $line)))))
         (let* (($recovered (mode-host:recover))
                ($pending (if (!= $recovered True) $recovered (mode-host:pending "" 128))))
           (if (turn:failed? $pending) $pending
             (let* (($already (mode-host:array (mode-host:record-read) "tasks"))
                    ($new (filter-atom (list:append (mode-host:handover) $pending) $row
                            (not (erv:contains $already (car-atom $row))))))
               (mode-host:offer $new () ()))))))))
(= (mode-host:offer $rows $capture $texts)
   (if (== $rows ())
     (let $ordered (list:reverse $capture)
       (let* (($tasks (map-atom $ordered $row (case $row (((ModeInputV1 $task $_) $task)))))
              ($stored (if (== $tasks ()) True
                (sf:replace (path:join (mode-host:root) "offered-input.json") (turn:json (JsonArray $tasks)) 384 True))))
         (if (!= $stored True) (Error managed-channel (Incomplete capture-not-durable))
           (let* (($text (str:join "\n" (list:reverse $texts)))
                  ($_ (change-state! &mode-capture $ordered))
                  ($_ (change-state! &mode-capture-text $text))) $text))))
     (let* ((($task $body) (car-atom $rows)) ($value (catch (json-parse $body))))
       (case $value
         (((JsonArray ((JsonString "input") $_ $_ $_ $update))
           ; $body is already the row's JSON: a second let* binding would unify, not shadow.
           (let* ((($kind $message) (tg:message-of $update))
                  ($message-text (tg:message-text $message))
                  ($text (if (== $message-text "") "[attachment received; use the agent attachment tools to inspect it]" $message-text))
                  ($destination (mode-host:remember-route $message))
                  ($id (tg:str (tg:at $update "update_id"))))
             (if (turn:failed? $destination) $destination
               (mode-host:offer (cdr-atom $rows) (cons-atom (ModeInputV1 $task $id) $capture)
                 (cons-atom (str:join "" ("[reply_channel=" $destination "]\n" (tg:format-message $update $kind $message $text))) $texts)))))
          ((JsonArray ((JsonString "command") $_ (JsonString $command) $_))
            (let $_ (if (== $command "/delete")
               (cwp:call (tio:socket) 2 $task
                 (turn:json (JsonArray ("answer" (str:join "" ("Message deletion is unavailable in " (mode-host:name) " mode; switch to godelclaw."))))) 5000) True)
              (mode-host:offer (cdr-atom $rows) $capture $texts)))
          ((JsonArray ((JsonString "callback") $_ $_ $_))
            (mode-host:offer (cdr-atom $rows) $capture $texts))
          ; A delivered send is settled transport state, as in the framework
          ; loop: acknowledge it without presenting it to the loop.
          ((JsonArray ((JsonString "delivery") $_ $_ $_ (JsonArray ((JsonString "delivered") $_))))
            (let $_ (mode-host:ack-one $task) (mode-host:offer (cdr-atom $rows) $capture $texts)))
          ((JsonArray $_)
            (mode-host:offer (cdr-atom $rows) (cons-atom (ModeInputV1 $task "") $capture)
              (cons-atom (str:concat "[channel receipt; this is delivery status, not a user message]\n" $body) $texts)))
          ($bad (Error managed-channel (Fault malformed-delivery))))))))
(= (mode-host:route-context)
   (let* (($folder (path:join (mode-host:shared) "channel-routes"))
          ($names (if (fs:exists $folder) (sort-atom (fs:entries $folder)) ())))
     (str:join "\n" (cons-atom
       "CHANNEL ROUTES (host configuration):\n\"telegram\" addresses the private operator only; reading a group does not change it.\nChoose the destination explicitly for every group or thread reply.\nA send result means durably queued, not confirmed delivered."
       (map-atom (filter-atom $names $name (str:ends-with $name ".json")) $name
         (str:join "" ((str:char-slice $name 0 (- (str:char-length $name) 5)) ": "
           (turn:json (sf:native-object (path:join $folder $name))))))))))
(= (mode-host:boot)
   (let* (($ledger (mode-host:ledger))
          ($recovered (if (== $ledger True) (mode-host:recover) $ledger))
          ($outbox (if (== $recovered True) (mode-host:migrate-outbox) $recovered))
          ($recorded (if (mode-host:standalone?) 1
                       (boot-state:record (mode-host:name) (system:pid) (mode-host:root)))))
     (if (!= $outbox True) $outbox
       (if (!= $recorded 1) (Error managed-mode (Incomplete boot-record-unconfirmed))
         (let $_ (mode-host:record "boot" ((JsonPair "pid" (system:pid)))) True)))))
(= (mode-host:migrate-outbox)
   (let $directory (path:join (mode-host:root) "outbox")
     (if (not (fs:exists $directory)) True
       (let $results (map-atom (filter-atom (fs:entries $directory) $name (str:ends-with $name ".json")) $name
                        (mode-host:migrate-intent (path:join $directory $name)))
         (if (== (filter-atom $results $result (!= $result True)) ()) True
           (Error managed-channel (Incomplete outbox-migration-unconfirmed)))))))
(= (mode-host:migrate-intent $path)
   (let* (($item (sf:native-object $path)) ($key (sf:get $item "key" ""))
          ($folder (tio:outbox)) ($destination (path:join $folder (str:concat $key ".json"))))
     (if (not (re:is-match (re:pattern "^-?[0-9]+\\.[0-9]+\\.[0-9]{20}$") $key))
       (Error managed-channel (Fault invalid-old-intent))
       (let* (($_ (fs:make-directories $folder 448))
              ($old (sf:native-object $destination))
              ($written (if (fs:exists $destination)
                (if (== (turn:json $old) (turn:json $item)) True (Error managed-channel (Forbidden intent-key-conflict)))
                (sf:replace $destination (fs:read-text $path) 384 True))))
         (if (!= $written True) $written
           (let $removed (fs:remove $path)
             (if (sf:failed? $removed) $removed True)))))))
(= (mode-host:ledger)
   (if (not (mode-host:standalone?)) True
     (let* (($_ (mode-host:stop-ledger))
            ($socket (checkpoint:socket)) ($source (path:join (mode-host:root) "input-ledger"))
            ($binary (system:getenv-or-default "CETTA_VALUE_WORKER_BIN"
                         (path:join (path:dirname (system:executable)) "cetta-value-worker")))
            ($module (path:join (system:getenv-or-default "METTACLAW_RUNTIME_ROOT" (system:getcwd)) "src/input_ledger_server.metta"))
            ($environment (("CETTA_DB_SOURCE" $source) ("CETTA_DB_SOCKET" $socket)))
            ($owner (proc:spawn ($binary "--value-bytes" "268435456" "--serve" "--lang" "petta" $module "db-server:configuration")
                      ((env (inherit $environment)) (stdout null) (stderr null) (lifetime owner)))))
       (case $owner
         (((Error $_ $_) (Error mode-ledger (Fault launch-failed)))
          ((proc:failed $_) (Error mode-ledger (Fault launch-failed)))
          ($started
            (let $_ (change-state! &mode-native-ledger $started)
              (mode-host:ledger-ready $started $socket 100))))))))
(= (mode-host:ledger-ready $owner $socket $left)
   (if (<= $left 0)
     (progn (mode-host:stop-ledger) (Error mode-ledger (Incomplete ledger-not-ready)))
     (let $answer
         (if (fs:exists $socket) (checkpoint:call-with-timeout "working-set" () 500)
           (ErFailure LedgerUnavailable "" none))
       (if (erv:failed? $answer)
         (let $_ (proc:wait $owner 50) (mode-host:ledger-ready $owner $socket (- $left 1)))
         True))))
