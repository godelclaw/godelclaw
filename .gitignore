.env
.env.*
config/local.toml
config/secrets.env
config/channel.metta
config/.edit.lock
.mcp.json
*.log
*.pid
*.ps
__pycache__/
*/__pycache__/

# Live agent state: private, mutable, and not source. Public defaults and
# examples belong under identity/ and config/, never under the live tree.
memory/
promotions.db*
*.sqlite*
chroma_db/
episodes/
chat/
telegram_offset.txt
telegram_offset.txt.*
telegram_updates.jsonl
archive/
to-claws/

# Runtime-generated session distillations occasionally land at repository root.
/[0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9]_distillation.md

# Vendored deps git-cloned on first run (e.g. petta_lib_chromadb).
repos/

# Agent-private by default: markdown, notes, self-model, scratch.
# The repo carries code; documentation is README.md only.
*.md
!README.md
!/identity/default-soul.md
selfmodel/
to-*.md
*.sed
*.log
loo_distill_*.txt
scratch/
recovery/
.runtime-update-hold
chroma_db.rebuilt-*/

# Agent-authored knowledge base: private facts, quotes, provenance.
kb/

# Machine-specific verification receipts stay local.
/modes/completion-audit.json
/modes/qualification-checkpoint.json

# Only pinned upstream prompt templates may appear under a memory directory.
!/modes/omega/upstream/memory/
/modes/omega/upstream/memory/*
!/modes/omega/upstream/memory/prompt.txt
!/modes/omega/upstream/memory/prompt_ASICloud.txt
!/modes/omega/upstream/memory/prompt_OpenRouter.txt

# Local pinned-engine build and bundle.
/.build/
/.runtime/

# Portable collaboration skill; account configuration stays outside Git.
!/.claude/skills/claw-mail/SKILL.md
