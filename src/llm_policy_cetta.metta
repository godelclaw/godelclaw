; Provider policy and its usage history, owned by native SQLite transactions.
; The Python implementation remains the oracle and non-CeTTa fallback.
!(import! &self ./process_identity_cetta.metta)
!(case (import! &self (library sqlite))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self sqlite) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library json))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self json) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library fs))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self fs) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library path))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self path) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library str))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self str) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library system))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self system) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library math))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self math) (Error $where $why))))
      ($loaded $loaded)))
!(case (import! &self (library proc))
     (((Error $where $why)
       (let $reason (format-args "{}" ($why))
         (if (== $reason "import! expects a module name")
           (import! &self proc) (Error $where $why))))
      ($loaded $loaded)))
!(import! &self ./usage_evidence_cetta.metta)

(: lp:env (-> %Undefined% %Undefined% %Undefined%))
(= (lp:env $key $default) (system:getenv-or-default $key $default))
(: lp:text (-> %Undefined% %Undefined%))
(= (lp:text $value) (if (ue:equal (get-type $value) String) $value (format-args "{}" ($value))))
(: lp:nth (-> %Undefined% %Undefined% %Undefined%))
(= (lp:nth $items $index)
   (if (ue:equal $items ()) "" (if (ue:equal $index 0) (car-atom $items) (lp:nth (cdr-atom $items) (- $index 1)))))
(: lp:last (-> %Undefined% %Undefined%))
(= (lp:last $items) (if (ue:equal (cdr-atom $items) ()) (car-atom $items) (lp:last (cdr-atom $items))))
(: lp:append (-> %Undefined% %Undefined% %Undefined%))
(= (lp:append $first $second)
   (if (ue:equal $first ()) $second
     (let* (($head (car-atom $first)) ($rest (lp:append (cdr-atom $first) $second)))
       (cons-atom $head $rest))))
; SQL parameters are values in either dialect. HE leaves expressions inside
; a data tuple unevaluated; evaluate each parameter before giving it to SQLite.
(: lp:values (-> %Undefined% %Undefined%))
(= (lp:values $items)
   (if (ue:equal $items ()) ()
     (let* (($value (eval (car-atom $items))) ($rest (lp:values (cdr-atom $items))))
       (cons-atom $value $rest))))
(: lp:statements (-> %Undefined% %Undefined%))
(= (lp:statements $items)
   (if (ue:equal $items ()) ()
     (let* (((sqlite:statement $sql $parameters) (eval (car-atom $items)))
            ($text (eval $sql)) ($values (lp:values $parameters))
            ($rest (lp:statements (cdr-atom $items))))
       (cons-atom (sqlite:statement $text $values) $rest))))
(: lp:db-transaction (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:db-transaction $db $mode $statements $busy)
   (let $bound (lp:statements $statements) (sqlite:transaction $db $mode $bound $busy)))
(: lp:field (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:field $object $key $default)
   (ue:field $object $key $default))
(: lp:mode (-> %Undefined%))
(= (lp:mode) (lp:env "METTACLAW_ACTIVE_LOOP_MODE" "godelclaw"))
(: lp:path (-> %Undefined%))
(= (lp:path)
   (let $explicit (lp:env "METTACLAW_LLM_LEDGER_PATH" "")
     (if (not (ue:equal $explicit "")) $explicit
       (let $health (lp:env "METTACLAW_COGNITIVE_HEALTH_PATH" "")
         (if (not (ue:equal $health "")) (path:join (path:dirname $health) "llm-budget.sqlite3")
           (path:join (path:join (lp:env "XDG_STATE_HOME" (path:join (lp:env "HOME" ".") ".local/state"))
                                 (lp:env "METTACLAW_INSTANCE" "default")) "llm-budget.sqlite3"))))))

; Linux birth stamps prevent PID reuse from transferring call ownership.
; Portable owners use the existing signal-zero liveness observation.
(: lp:process-start (-> %Undefined% %Undefined%))
(= (lp:process-start $pid)
   (process:birth $pid))
(: lp:owner (-> %Undefined%))
(= (lp:owner)
   (process:owner))
(: lp:owner-live (-> %Undefined% %Undefined%))
(= (lp:owner-live $owner)
   (process:alive? $owner))

; Python stores each history detail as json.dumps(detail, sort_keys=True,
; separators=(",", ":")): sorted keys, no spaces, non-ASCII escaped.
(: lp:detail (-> %Undefined% %Undefined%))
(= (lp:detail $detail)
   (json:stringify-python-with $detail ((sort-keys True) (separators "," ":"))))
(: lp:event (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:event $ticket $event $detail $now)
   (sqlite:statement "INSERT OR IGNORE INTO llm_call_history(call_id,event,observed,detail) VALUES(?,?,?,?)"
                     ($ticket $event $now (lp:detail $detail))))
(: lp:columns (-> %Undefined% %Undefined% %Undefined%))
(= (lp:columns $db $table)
   (case (sqlite:observe $db (str:concat "PRAGMA table_info(" (str:concat $table ")")) () 5000)
     (((sqlite:result $columns $rows $changes $row-id) $rows) ($error (LedgerError $error)))))
(: lp:has-column (-> %Undefined% %Undefined% %Undefined%))
(= (lp:has-column $rows $name)
   (if (ue:equal $rows ()) False
     (if (ue:equal (lp:nth (car-atom $rows) 1) $name) True (lp:has-column (cdr-atom $rows) $name))))
(: lp:add-column (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:add-column $rows $table $name $declaration)
   (if (lp:has-column $rows $name) ()
     ((sqlite:statement (str:join "" ("ALTER TABLE " $table " ADD COLUMN " $name " " $declaration)) ()))))
(: lp:migration-statements (-> %Undefined% %Undefined% %Undefined%))
(= (lp:migration-statements $requests $calls)
   (lp:append (lp:add-column $requests "requests" "owner" "TEXT NOT NULL DEFAULT ''")
    (lp:append (lp:add-column $requests "requests" "fingerprint" "TEXT NOT NULL DEFAULT ''")
     (lp:append (lp:add-column $calls "native_calls" "activity" "TEXT NOT NULL DEFAULT ''")
      (lp:append (lp:add-column $calls "native_calls" "lane" "TEXT NOT NULL DEFAULT ''")
       (lp:append (lp:add-column $calls "native_calls" "purpose" "TEXT NOT NULL DEFAULT 'turn'")
        (if (lp:has-column $calls "notified") ()
          ((sqlite:statement "ALTER TABLE native_calls ADD COLUMN notified INTEGER NOT NULL DEFAULT 0" ())
           (sqlite:statement "UPDATE native_calls SET notified=1 WHERE state NOT IN ('claimed','submitted')" ())))))))))
(: lp:migrate (-> %Undefined% %Undefined%))
(= (lp:migrate $db)
   (let* (($requests (lp:columns $db "requests")) ($calls (lp:columns $db "native_calls")))
     (case ($requests $calls)
       ((((LedgerError $error) $ignored0) (LedgerError $error))
        (($ignored1 (LedgerError $error)) (LedgerError $error))
        ($valid (lp:db-transaction $db immediate (lp:migration-statements $requests $calls) 5000))))))
(: lp:initialized (-> %Undefined% %Undefined% %Undefined%))
(= (lp:initialized $db $answer)
   (case $answer
     (((sqlite:committed $ignored2)
       (case (lp:migrate $db)
         (((sqlite:error $category $code $message failed)
           (if (str:starts-with $message "duplicate column name:")
             (lp:migrate $db) (LedgerError (sqlite:error $category $code $message failed))))
          ($result $result))))
      ($error (LedgerError $error)))))
(: lp:init-schema (-> %Undefined% %Undefined%))
(= (lp:init-schema $db)
   (lp:initialized $db (lp:db-transaction $db immediate
     ((sqlite:statement "CREATE TABLE IF NOT EXISTS requests (id TEXT PRIMARY KEY,started REAL NOT NULL,reserved INTEGER NOT NULL,status TEXT NOT NULL,output INTEGER,provider TEXT NOT NULL,mode TEXT NOT NULL,finish TEXT,owner TEXT NOT NULL DEFAULT '',fingerprint TEXT NOT NULL DEFAULT '')" ())
      (sqlite:statement "CREATE TABLE IF NOT EXISTS cooldowns (provider TEXT PRIMARY KEY,until REAL NOT NULL)" ())
      (sqlite:statement "CREATE TABLE IF NOT EXISTS llm_call_history (sequence INTEGER PRIMARY KEY,call_id TEXT NOT NULL,event TEXT NOT NULL,observed REAL NOT NULL,detail TEXT NOT NULL,UNIQUE(call_id,event))" ())
      (sqlite:statement "CREATE INDEX IF NOT EXISTS llm_call_history_time ON llm_call_history(event,observed)" ())
      (sqlite:statement "CREATE TABLE IF NOT EXISTS native_calls (id TEXT PRIMARY KEY,epoch TEXT NOT NULL,pid INTEGER NOT NULL,process_start TEXT,created REAL NOT NULL,updated REAL NOT NULL,state TEXT NOT NULL,guard TEXT,transport INTEGER,soft_elapsed INTEGER NOT NULL DEFAULT 0,bytes INTEGER NOT NULL DEFAULT 0,quiet_ms INTEGER NOT NULL DEFAULT 0,result TEXT,reason TEXT,activity TEXT NOT NULL DEFAULT '',lane TEXT NOT NULL DEFAULT '',purpose TEXT NOT NULL DEFAULT 'turn',notified INTEGER NOT NULL DEFAULT 0)" ())
      (lp:event "" "recording-started" (JsonObject ((JsonPair "schema" 1))) (system:wall-time))) 5000)))
(: lp:init (-> %Undefined%))
(= (lp:init)
   (if (fs:exists (lp:path)) (lp:check-schema)
     (lp:initialize)))
; Verify the durable schema through one read-only connection. Reopening it
; for DDL and per-table PRAGMA transactions on every progress event is waste.
; Missing migration columns or the recording marker take the ordinary init.
(: lp:check-schema (-> %Undefined%))
(= (lp:check-schema)
   (case (sqlite:observe (lp:path)
     "SELECT (SELECT COUNT(*) FROM pragma_table_info('requests') WHERE name IN ('owner','fingerprint'))=2 AND (SELECT COUNT(*) FROM pragma_table_info('native_calls') WHERE name IN ('activity','lane','purpose','notified'))=4 AND EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='cooldowns') AND EXISTS(SELECT 1 FROM sqlite_master WHERE type='index' AND name='llm_call_history_time') AND EXISTS(SELECT 1 FROM llm_call_history WHERE call_id='' AND event='recording-started')" () 5000)
     (((sqlite:result $columns ((1)) $changes $row-id) (sqlite:committed ()))
      ((sqlite:result $columns ((0)) $changes $row-id) (lp:initialize))
      ((sqlite:error $category $code $message failed)
       (if (str:starts-with $message "no such table:") (lp:initialize)
         (LedgerError (sqlite:error $category $code $message failed))))
      ($error (LedgerError $error)))))
(: lp:initialize (-> %Undefined%))
(= (lp:initialize)
   (let* (($db (lp:path)) ($directory (path:dirname $db)))
     (if (fs:exists $directory) (lp:init-schema $db)
       (case (proc:run ("mkdir" "-p" "--" $directory) (system:cwd)
                       (("PATH" (lp:env "PATH" "/usr/bin:/bin"))) 0 0)
         (((proc:exited 0 $ignored3 $ignored4) (lp:init-schema $db))
          ($error (LedgerError $error)))))))
(: lp:transaction (-> %Undefined% %Undefined%))
(= (lp:transaction $statements)
   (case (lp:init)
     (((sqlite:committed $ignored5) (lp:db-transaction (lp:path) immediate $statements 5000))
      ($error $error))))
(: lp:rows (-> %Undefined% %Undefined%))
(= (lp:rows $answer)
   (case $answer (((sqlite:result $columns $rows $changes $row-id) $rows)
                 ((LedgerError $existing) (LedgerError $existing))
                 ($error (LedgerError $error)))))

; Policy configuration remains an explicit choice, with unchanged defaults.
; Where the Python source raises, the reference answers
; (PythonException CLASS MESSAGE), the message formatted as Python formats it.
(: lp:python-error (-> %Undefined% %Undefined% %Undefined%))
(= (lp:python-error $class $message) (LedgerError (PythonException $class $message)))
; Native float predicates read an arbitrarily large integer as infinite, so a
; number's kind comes from Python's own text for it.
(: lp:number-kind (-> %Undefined% %Undefined%))
(= (lp:number-kind $value)
   (case (json:stringify-python $value)
     (((JsonPythonErrorV1 $class $message $prefix) NumberInt)
      ("NaN" NumberNaN) ("Infinity" NumberInf) ("-Infinity" NumberInf)
      ($text (if (and (lp:absent $text ".") (lp:absent $text "e")) NumberInt NumberFloat)))))
(: lp:absent (-> %Undefined% %Undefined% %Undefined%))
(= (lp:absent $text $needle)
   (case (str:find $text $needle) (((TextNotFound $ignored) True) ($found False))))
; repr(str) as CPython 3.12 writes it: double quotes only for a text with a
; single quote and no double quote; a backslash before the quote and the
; backslash; \t, \n and \r; and \x, \u or \U for each character that
; str.isprintable() refuses (categories C and Z, but not the space). With a
; nonnegative $limit it is cut to that many characters, as %.200R cuts it.
(: lp:repr-text (-> %Undefined% %Undefined% %Undefined%))
(= (lp:repr-text $text $limit)
   (let* (($codes (str:python-codepoints $text))
          ($quote (if (and (lp:has-code $codes 39) (not (lp:has-code $codes 34))) 34 39))
          ($mark (str:from-python-codepoints ($quote)))
          ; Each character writes at least one, so $limit characters suffice.
          ($shown (if (< $limit 0) $codes (lp:take $codes $limit)))
          ($body (lp:repr-codes $shown $quote))
          ($whole (str:concat $mark (if (ue:equal $shown $codes) (str:concat $body $mark) $body))))
     (if (< $limit 0) $whole
       (str:from-python-codepoints (lp:take (str:python-codepoints $whole) $limit)))))
(: lp:has-code (-> %Undefined% %Undefined% %Undefined%))
(= (lp:has-code $codes $code)
   (if (ue:equal $codes ()) False
     (if (ue:equal (car-atom $codes) $code) True (lp:has-code (cdr-atom $codes) $code))))
(: lp:take (-> %Undefined% %Undefined% %Undefined%))
(= (lp:take $codes $count)
   (if (or (ue:equal $codes ()) (<= $count 0)) ()
     (cons-atom (car-atom $codes) (lp:take (cdr-atom $codes) (- $count 1)))))
(: lp:repr-codes (-> %Undefined% %Undefined% %Undefined%))
(= (lp:repr-codes $codes $quote)
   (if (ue:equal $codes ()) ""
     (let* (($head (lp:repr-code (car-atom $codes) $quote)) ($rest (lp:repr-codes (cdr-atom $codes) $quote)))
       (str:concat $head $rest))))
(: lp:repr-code (-> %Undefined% %Undefined% %Undefined%))
(= (lp:repr-code $code $quote)
   (if (or (ue:equal $code $quote) (ue:equal $code 92)) (str:concat "\\" (str:from-python-codepoints ($code)))
    (if (ue:equal $code 9) "\\t"
     (if (ue:equal $code 10) "\\n"
      (if (ue:equal $code 13) "\\r"
       (if (lp:printable $code) (str:from-python-codepoints ($code)) (lp:escaped $code)))))))
(: lp:printable (-> %Undefined% %Undefined%))
(= (lp:printable $code)
   (if (ue:equal $code 32) True
     (let $category (str:unicode-category $code)
       (not (or (str:starts-with $category "C") (str:starts-with $category "Z"))))))
(: lp:escaped (-> %Undefined% %Undefined%))
(= (lp:escaped $code)
   (if (< $code 256) (str:concat "\\x" (lp:hex $code 2))
     (if (< $code 65536) (str:concat "\\u" (lp:hex $code 4))
       (str:concat "\\U" (lp:hex $code 8)))))
(: lp:hex (-> %Undefined% %Undefined% %Undefined%))
(= (lp:hex $number $digits)
   (if (ue:equal $digits 0) ""
     (let* (($digit (% $number 16)) ($rest (lp:hex (math:floor (/ $number 16)) (- $digits 1))))
       (str:concat $rest (str:byte-slice "0123456789abcdef" $digit (+ $digit 1))))))
(: lp:python-type (-> %Undefined% %Undefined%))
(= (lp:python-type $value)
   (case $value
     ((JsonNull "NoneType")
      ((JsonObject $fields) "dict")
      ((JsonArray $items) "list")
      ($other
        (if (ue:equal (get-type $other) String) "str"
          (if (ue:equal (get-type $other) Bool) "bool"
            (if (ue:equal (get-type $other) Number)
              (if (ue:equal (lp:number-kind $other) NumberInt) "int" "float")
              "object")))))))
; lp:python-int is CPython 3.12's int(value): booleans are 1 and 0, numbers
; truncate toward zero, and a string is read as int(str) reads it.
; lp:integer is the same with each exception as InvalidInteger.
(: lp:python-int (-> %Undefined% %Undefined%))
(= (lp:python-int $value)
   (if (ue:equal (get-type $value) Bool) (if $value 1 0)
    (if (ue:equal (get-type $value) Number)
      (case (lp:number-kind $value)
        ((NumberNaN (PythonException ValueError "cannot convert float NaN to integer"))
         (NumberInf (PythonException OverflowError "cannot convert float infinity to integer"))
         (NumberInt $value)
         (NumberFloat (math:trunc $value))))
     (if (ue:equal (get-type $value) String)
       (case (lp:integer-lead (lp:integer-tokens (str:python-codepoints $value)))
         ((InvalidInteger
            (let $shown (lp:repr-text $value 200)
              (PythonException ValueError (str:concat "invalid literal for int() with base 10: " $shown))))
          ((IntDigitLimit $count)
            (let $digits (repr $count)
              (PythonException ValueError
                (str:join "" ("Exceeds the limit (4300 digits) for integer string conversion: value has "
                              $digits " digits; use sys.set_int_max_str_digits() to increase the limit")))))
          ($integer $integer)))
       (let $type (lp:python-type $value)
         (PythonException TypeError
           (str:join "" ("int() argument must be a string, a bytes-like object or a real number, not '" $type "'"))))))))
(: lp:integer (-> %Undefined% %Undefined%))
(= (lp:integer $value)
   (case (lp:python-int $value)
     (((PythonException $class $message) InvalidInteger)
      ($integer $integer))))
; int(str): Python whitespace around an optional sign and decimal digits,
; single underscores only between digits, at most 4300 digits. A digit may be
; any Unicode Nd character; Nd runs are 0 to 9 in order, so a digit's value is
; its offset in its run, modulo 10. Other non-ASCII characters are invalid.
(: lp:integer-tokens (-> %Undefined% %Undefined%))
(= (lp:integer-tokens $codes)
   (if (ue:equal $codes ()) ()
     (cons-atom (lp:integer-token (car-atom $codes)) (lp:integer-tokens (cdr-atom $codes)))))
(: lp:integer-token (-> %Undefined% %Undefined%))
(= (lp:integer-token $code)
   (if (and (>= $code 48) (<= $code 57)) (IntDigit (- $code 48))
    (if (ue:equal $code 43) IntPlus
     (if (ue:equal $code 45) IntMinus
      (if (ue:equal $code 95) IntUnderscore
       (if (lp:python-space $code) IntSpace
        (if (and (> $code 127) (ue:equal (str:unicode-category $code) "Nd"))
          (IntDigit (% (lp:nd-offset $code 0) 10))
          IntBad)))))))
; int(str) copies ASCII through and then skips only C whitespace there; beyond
; ASCII it reads str.isspace(): Zs, U+0085, U+2028 and U+2029.
(: lp:python-space (-> %Undefined% %Undefined%))
(= (lp:python-space $code)
   (if (or (and (>= $code 9) (<= $code 13)) (ue:equal $code 32)) True
    (if (or (ue:equal $code 133) (or (ue:equal $code 8232) (ue:equal $code 8233))) True
      (and (> $code 127) (ue:equal (str:unicode-category $code) "Zs")))))
(: lp:nd-offset (-> %Undefined% %Undefined% %Undefined%))
(= (lp:nd-offset $code $offset)
   (if (ue:equal (str:unicode-category (- $code 1)) "Nd") (lp:nd-offset (- $code 1) (+ $offset 1)) $offset))
(: lp:integer-lead (-> %Undefined% %Undefined%))
(= (lp:integer-lead $tokens)
   (if (ue:equal $tokens ()) InvalidInteger
     (case (car-atom $tokens)
       ((IntSpace (lp:integer-lead (cdr-atom $tokens)))
        (IntPlus (lp:integer-digits (cdr-atom $tokens) 1 () False))
        (IntMinus (lp:integer-digits (cdr-atom $tokens) -1 () False))
        ($other (lp:integer-digits $tokens 1 () False))))))
; $digits holds the digits read so far, latest first; $under follows an underscore.
(: lp:integer-digits (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:integer-digits $tokens $sign $digits $under)
   (if (ue:equal $tokens ()) (lp:integer-finish $sign $digits $under)
     (case (car-atom $tokens)
       (((IntDigit $digit) (lp:integer-digits (cdr-atom $tokens) $sign (cons-atom $digit $digits) False))
        (IntUnderscore (if (or $under (ue:equal $digits ())) InvalidInteger
                         (lp:integer-digits (cdr-atom $tokens) $sign $digits True)))
        (IntSpace (if $under InvalidInteger (lp:integer-trail (cdr-atom $tokens) $sign $digits)))
        ($other InvalidInteger)))))
(: lp:integer-trail (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:integer-trail $tokens $sign $digits)
   (if (ue:equal $tokens ()) (lp:integer-finish $sign $digits False)
     (if (ue:equal (car-atom $tokens) IntSpace) (lp:integer-trail (cdr-atom $tokens) $sign $digits)
       InvalidInteger)))
(: lp:integer-finish (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (lp:integer-finish $sign $digits $under)
   (if (or $under (ue:equal $digits ())) InvalidInteger
     (let $count (size-atom $digits)
       (if (> $count 4300) (IntDigitLimit $count) (* $sign (lp:digits-value $digits))))))
(: lp:digits-value (-> %Undefined% %Undefined%))
(= (lp:digits-value $digits)
   (if (ue:equal $digits ()) 0
     (+ (car-atom $digits) (* 10 (lp:digits-value (cdr-atom $digits))))))
; lp:python-float is CPython 3.12's float(value), or its exception.
(: lp:python-float (-> %Undefined% %Undefined%))
(= (lp:python-float $value)
   (if (ue:equal (get-type $value) Bool) (if $value 1.0 0.0)
    (if (ue:equal (get-type $value) Number)
      (if (ue:equal (lp:number-kind $value) NumberInt) (lp:int-float $value) $value)
     (if (ue:equal (get-type $value) String)
       (case (lp:float-text (lp:float-codes (str:python-codepoints $value)))
         ((FloatBad
            (let $quoted (lp:repr-text $value -1)
              (PythonException ValueError (str:concat "could not convert string to float: " $quoted))))
          ($float $float)))
       (let $type (lp:python-type $value)
         (PythonException TypeError
           (str:join "" ("float() argument must be a string or a real number, not '" $type "'"))))))))
; float(int) rounds to the nearest double, ties to even, which Python's own
; decimal reading also does. From 2**1024 - 2**970 on, it would round past
; the largest finite double, and Python raises.
(: lp:int-float (-> %Undefined% %Undefined%))
(= (lp:int-float $n)
   (if (or (>= $n ) (<= $n -))
     (PythonException OverflowError "int too large to convert to float")
     (let $digits (json:stringify-python $n) (json:parse-python (str:concat $digits ".0")))))
; float(str) maps non-ASCII decimal digits to ASCII and non-ASCII whitespace
; to a space, and refuses any other non-ASCII character. Single underscores
; may stand only between digits. C whitespace is stripped, then a decimal, or
; inf, infinity or nan in any case, is read with an optional sign.
(: lp:float-codes (-> %Undefined% %Undefined%))
(= (lp:float-codes $codes)
   (if (ue:equal $codes ()) ()
     (let* (($code (car-atom $codes)) ($rest (lp:float-codes (cdr-atom $codes))))
       (if (ue:equal $rest FloatBad) FloatBad
