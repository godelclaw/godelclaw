; Pure checkpoint reader, guidance restoration and inflight tool-call repair.
; Imported by both coding_session.metta and the check-only entry point
; coding_check.metta, which must never import provider or tool dispatchers.
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library str))
!(import! &self (library json))
!(import! &self ./src/coding_io_cetta.metta)
!(import! &self ./src/coding_values.metta)
!(import! &self ./src/coding_guidance.metta)

(= (coding:now) (py-call (time.time)))
(= (coding:file $dir $name) (path:join $dir $name))
(= (coding:reverse $items $out)
   (if (== $items ()) $out (coding:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out))))
(= (coding:append-list $first $second) (coding:reverse (coding:reverse $first ()) $second))
(= (coding:drop $items $count)
   (if (or (<= $count 0) (== $items ())) $items (coding:drop (cdr-atom $items) (- $count 1))))

(= (coding:json-file $path $default)
   (if (fs:is-file $path) (json-parse (fs:read-text $path)) $default))
(= (coding:parse-lines $lines $out)
   (if (== $lines ()) (coding:reverse $out ())
     (let $line (car-atom $lines)
       (if (== (str:trim $line) "") (coding:parse-lines (cdr-atom $lines) $out)
         (coding:parse-lines (cdr-atom $lines) (cons-atom (json-parse $line) $out))))))
(= (coding:json-lines $path)
   (if (fs:is-file $path) (coding:parse-lines (str:split "\n" (fs:read-text $path)) ()) ()))

(= (coding:message $role $text)
   (JsonObject ((JsonPair "role" (JsonString $role)) (JsonPair "content" (JsonString $text)))))
(= (coding:tool-message $id $text)
   (JsonObject ((JsonPair "role" (JsonString "tool")) (JsonPair "tool_call_id" (JsonString $id))
                (JsonPair "content" (JsonString $text)))))
(= (coding:record $dir $message)
   (let* (($path (coding:file $dir "messages.jsonl")) ($line (json-stringify $message))
          ($_ (cio:append-line $path $line)))
     $message))
(= (coding:record-all $dir $messages $out)
   (if (== $messages ()) (coding:reverse $out ())
     (coding:record-all $dir (cdr-atom $messages) (cons-atom (coding:record $dir (car-atom $messages)) $out))))

; A restart can find a recorded assistant call without its result. Retain
; uncertainty and satisfy the tool protocol; never replay an unknown effect.
(= (coding:remove-call $calls $id)
   (if (== $calls ()) ()
     (let $rest (coding:remove-call (cdr-atom $calls) $id)
       (if (== (coding:text (coding:field (car-atom $calls) "id")) $id) $rest
         (cons-atom (car-atom $calls) $rest)))))
(= (coding:pending-calls $messages $pending)
   (if (== $messages ()) $pending
     (let* (($message (car-atom $messages)) ($role (coding:text (coding:field $message "role")))
            ($next (if (== $role "assistant") (coding:append-list $pending (coding:items (coding:field $message "tool_calls")))
                     (if (== $role "tool") (coding:remove-call $pending (coding:text (coding:field $message "tool_call_id"))) $pending))))
       (coding:pending-calls (cdr-atom $messages) $next))))
(= (coding:uncertain-results $dir $calls $out)
   (if (== $calls ()) (coding:reverse $out ())
     (let* (($id (coding:text (coding:field (car-atom $calls) "id")))
            ($record (coding:record $dir (coding:tool-message $id
              "Interrupted; outcome unknown. This call was not automatically replayed. Inspect the existing evidence before deciding what to do next."))))
       (coding:uncertain-results $dir (coding:remove-call (cdr-atom $calls) $id) (cons-atom $record $out)))))
(= (coding:repair-inflight $dir $messages)
   (let $results (coding:uncertain-results $dir (coding:pending-calls $messages ()) ())
     (coding:append-list $messages $results)))

(= (coding:message-lines $messages)
   (if (== $messages ()) ()
     (cons-atom (str:concat (json-stringify (car-atom $messages)) "\n")
                (coding:message-lines (cdr-atom $messages)))))
(= (coding:rewrite $dir $messages)
   (case (catch
           (let* (($history (coding:file $dir "messages.jsonl"))
                  ($archive (str:join "" ($history "." (repr (coding:now)) "." (py-call (secrets.token_hex 4)) ".archived")))
                  ; Keep the live transcript available until the complete
                  ; replacement is published. Copy before the atomic write.
                  ($_ (py-call (shutil.copyfile $history $archive)))
                  ($receipt (fs:update-text $history "replace" (str:join "" (coding:message-lines $messages)) "" "")))
             (case $receipt
               ((("written" $_ $_ $_ $_) (Compacted $messages))
                ($error (CompactionFailed (str:concat "History replacement failed: " (repr $error))))))))
     (((Error $where $why) (CompactionFailed (str:join " " ((repr $where) (repr $why)))))
      ($result $result))))

(= (coding:any-guidance? $messages)
   (if (== $messages ()) False
     (let $message (car-atom $messages)
       (if (and (== (coding:field $message "role") (JsonString "user"))
                (!= (coding:field $message "_coding_guidance") JsonNull)) True
         (coding:any-guidance? (cdr-atom $messages))))))
(= (coding:guidance-status $messages $expected $seen)
   (if (== $messages ()) (if $seen GuidancePresent GuidanceAbsent)
     (let $message (car-atom $messages)
       (if (and (== (coding:field $message "role") (JsonString "user"))
                (!= (coding:field $message "_coding_guidance") JsonNull))
         (if $seen GuidanceConflict
           (if (and (== (coding:field $message "_coding_guidance") (coding:field $expected "_coding_guidance"))
                    (== (coding:field $message "content") (coding:field $expected "content")))
             (coding:guidance-status (cdr-atom $messages) $expected True) GuidanceConflict))
         (coding:guidance-status (cdr-atom $messages) $expected $seen)))))
(= (coding:publish-initial $dir $messages)
   (let* (($lines (coding:message-lines $messages))
          ($written (fs:update-text (coding:file $dir "messages.jsonl") "replace" (str:join "" $lines) "" "")))
     (case $written
       ((("written" $_ $_ $_ $_) (CodingPrepared $messages))
        ($failed (GuidanceFailed "Cannot publish the initial coding conversation."))))))
(= (coding:begin $dir $task $workdir $guidance)
   (let* (($instructions (fs:read-text "identity/coding-instructions.md"))
          ($system (coding:message "system" (str:join "" ($instructions "\nWorkspace: " $workdir))))
          ($tail (coding:append-list $guidance ((coding:message "user" $task)))))
     (coding:publish-initial $dir (cons-atom $system $tail))))
(= (coding:restore-guidance $dir $messages $guidance)
   (if (== $guidance ())
     (if (coding:any-guidance? $messages) (GuidanceFailed "The saved guidance and conversation disagree.")
       (CodingPrepared $messages))
     (case (coding:guidance-status $messages (car-atom $guidance) False)
       ((GuidancePresent (CodingPrepared $messages))
        (GuidanceConflict (GuidanceFailed "The saved guidance and conversation disagree."))
        (GuidanceAbsent
         (let* (($merged (coding:append-list $messages $guidance))
                ($written (coding:rewrite $dir $merged)))
           (case $written
             (((Compacted $saved) (CodingPrepared $saved))
              ($failure (GuidanceFailed "Cannot publish coding guidance into the existing conversation."))))))))))
(= (coding:prepare-guidance $dir $task $workdir $options $existing)
   (case (if (or (coding:any-guidance? $existing) (and (!= $existing ()) (!= $options JsonNull)))
             (guidance:restore $dir $workdir)
             (guidance:prepare $dir $workdir $options))
     (((GuidanceReady $guidance)
       (if (== $existing ()) (coding:begin $dir $task $workdir $guidance)
         (let $repaired (coding:repair-inflight $dir $existing)
           (coding:restore-guidance $dir $repaired $guidance))))
      ($failure $failure))))

(= (coding:check-checkpoint $dir)
   (case (catch
           (let* (($task-json (coding:json-file (coding:file $dir "task.json") JsonNull))
                  ($_ (coding:json-file (coding:file $dir "state.json") (JsonObject ())))
                  ($_ (coding:json-file (coding:file $dir "plan.json") (JsonObject ())))
                  ($existing (coding:json-lines (coding:file $dir "messages.jsonl"))))
             (case $task-json
               (((JsonObject $pairs)
                 (let* (($task (coding:text (coding:field $task-json "task")))
                        ($given (coding:text (coding:field $task-json "workdir")))
                        ($workdir (if (== $given "") $dir $given)))
                   (case (guidance:workspace $workdir)
                     (((GuidanceWorkspace $canonical)
                       (case (coding:prepare-guidance $dir $task $canonical (coding:field $task-json "guidance") $existing)
                         (((CodingPrepared $messages) (CheckpointReady (length $messages)))
                          ((GuidanceFailed $why) (CheckpointFailed $why)))))
                      ((GuidanceFailed $why) (CheckpointFailed $why))))))
                ($other (CheckpointFailed "task.json is missing or invalid."))))))
     (((Error $where $why) (CheckpointFailed "Checkpoint files are unreadable or invalid JSON."))
      ($verdict $verdict))))
