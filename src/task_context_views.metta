; Selection, recoverable compaction and paging are MeTTa policy. The original
; database rows remain unchanged and addressable after every excerpt.
!(import! &self ./src/task_context_cetta)
!(import! &self (library math))
!(import! &self ./src/task_idle_views)

(= (task:items $record $key)
   (let (JsonArray $items) (state:json-field $record $key) $items))
(= (task:number $value) (JsonNumber (repr $value)))
(= (task:drop $items $count)
   (if (or (<= $count 0) (== $items ())) $items (task:drop (cdr-atom $items) (- $count 1))))
(= (task:take $items $count)
   (if (or (<= $count 0) (== $items ())) ()
     (cons-atom (car-atom $items) (task:take (cdr-atom $items) (- $count 1)))))
(= (task:reverse $items $out)
   (if (== $items ()) $out (task:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out))))
(= (task:find $pairs $identity)
   (if (== $pairs ()) (Error task-read unknown-call-identity)
     (if (== (task:string (car-atom $pairs) "id") $identity) (car-atom $pairs)
       (task:find (cdr-atom $pairs) $identity))))
(= (task:call $identity)
   (if (str:starts-with $identity "task-input:")
     (task:input (str:char-slice $identity 11 (str:char-length $identity)))
     (task:command-call $identity)))
(= (task:input $request)
   (let $rows (state:rows (state:query "SELECT content FROM requests WHERE id=?" ($request)))
     (if (== $rows ()) (Error task-read unknown-input-identity)
       (JsonObject ((JsonPair "id" (JsonString (str:concat "task-input:" $request)))
         (JsonPair "request" (JsonString $request)) (JsonPair "command" JsonNull)
         (JsonPair "disposition" (JsonString "input"))
         (JsonPair "result" (JsonString (car-atom (car-atom $rows)))))))))
(= (task:command-call $identity)
   (let $parts (task:reverse (str:split ":" $identity) ())
     (if (< (length $parts) 3) (Error task-read invalid-call-identity)
       (task:call-parts $identity $parts))))
(= (task:call-parts $identity $parts)
   (let* (($position (car-atom $parts)) ($serial (parse (car-atom (cdr-atom $parts))))
          ($owner (str:join ":" (task:reverse (cdr-atom (cdr-atom $parts)) ())))
          ($rows (state:rows (state:query "SELECT request FROM task_proposals WHERE serial=? UNION ALL SELECT request FROM actions WHERE serial=? LIMIT 1" ($serial $serial)))))
     (if (not (== $owner (state:text (state:meta "owner")))) (Error task-read another-ledger)
       (if (== $rows ()) (Error task-read unknown-call-identity)
         (task:find (task:items (task:projection (car-atom (car-atom $rows)) "retrieval") "transcript") $identity)))))
(= (task:page-end $raw $offset $end $size)
   (if (<= (str:byte-length (str:char-slice $raw $offset $end)) $size) $end
     (task:page-end $raw $offset (+ $offset (math:floor (/ (- $end $offset) 2))) $size)))
(= (task:page $identity $value $offset $size)
   (if (or (< $offset 0) (<= $size 0)) (Error task-read invalid-page)
     (let* (($raw (state:encoded $value)) ($characters (str:char-length $raw))
            ($start (min $offset $characters))
            ($end (task:page-end $raw $start (min $characters (+ $start $size)) $size))
            ($next (if (< $end $characters) (task:number $end) JsonNull))
            ($digest (str:concat "sha256:" (str:sha256 $raw)))
            ($text (str:char-slice $raw $start $end)))
       (if (and (== $start $end) (< $start $characters)) (Error task-read page-cannot-hold-next-character)
         (JsonObject ((JsonPair "id" (JsonString $identity)) (JsonPair "digest" (JsonString $digest))
           (JsonPair "offset" (task:number $offset)) (JsonPair "text" (JsonString $text))
           (JsonPair "next" $next) (JsonPair "characters" (task:number $characters))))))))
(= (task:read $id $offset $size)
   (let $value (if (str:starts-with $id "task-frame:")
                  (let $full (task:projection (str:char-slice $id 11 (str:char-length $id)) "continuation-tick")
                    (let (JsonObject $fields) $full
                      (let $remaining (state:json-without $fields "transcript") (JsonObject $remaining))))
                  (task:call $id))
     (case $value (((Error $where $reason) $value) ($other (task:page $id $value $offset $size))))))
(= (task-read $id) (task-read $id 0 8192))
(= (task-read $id $offset) (task-read $id $offset 8192))
(= (task:argument-number $value) (str:string->number (format-args "{}" ($value))))
(= (task-read $id $offset $size)
   (case (catch (task:read $id (task:argument-number $offset) (task:argument-number $size)))
     (((Error $where $reason) (str:concat "TASK_READ_FAILED: " (repr $reason)))
      ($page (state:encoded $page)))))
(= (task:index-entry $pair)
   (let $id (task:string $pair "id")
     (JsonObject ((JsonPair "id" (JsonString $id)) (JsonPair "command" (json-object-get $pair "command"))
       (JsonPair "disposition" (json-object-get $pair "disposition"))
       (JsonPair "retrieve" (JsonArray ((JsonString "task-read") (JsonString $id) (JsonNumber "0"))))))))
(= (task:index-entries $pairs)
   (if (== $pairs ()) () (cons-atom (task:index-entry (car-atom $pairs)) (task:index-entries (cdr-atom $pairs)))))
(= (task:history $request $offset $count)
   (if (or (< $offset 0) (< $count 0)) (Error task-history invalid-page)
     (if (str:starts-with $request "conversation:")
       (if (== $request (task:conversation-root)) (task:conversation-history $request $offset $count)
         (Error task-history another-ledger))
       (task:family-history $request $offset $count))))
(= (task:family-history $request $offset $count)
     (let* (($view (task:projection $request "continuation-tick")) ($all (task:items $view "transcript"))
            ($tail (task:drop $all $offset)) ($page (if (== $count 0) $tail (task:take $tail $count)))
            ($entries (task:index-entries $page)) ($total (length $all)) ($end (+ $offset (length $page))))
       (JsonObject ((JsonPair "root" (json-object-get $view "root")) (JsonPair "entries" (JsonArray $entries))
         (JsonPair "total" (task:number $total)) (JsonPair "next" (if (< $end $total) (task:number $end) JsonNull))))))
; The cross-frame archive index does not read or encode result bodies.
(= (task:conversation-history $root $offset $count)
   (let* (($result "CASE WHEN t.result IS NULL THEN NULL WHEN json_valid(t.result) THEN json_object('disposition',COALESCE(json_extract(t.result,'$.disposition'),'recorded')) ELSE json_object('disposition','recorded') END")
          ($source (task:conversation-sql $result -1 " LIMIT ? OFFSET ?"))
          ($census (str:join "" ("SELECT count(*) FROM (" (task:conversation-sql "NULL" -1 "") ")")))
          ($limit (if (== $count 0) -1 $count))
          ((sqlite:committed ($counted $selected)) (state:transaction deferred
            ((sqlite:statement $census ()) (sqlite:statement $source ($limit $offset)))))
          ($total (car-atom (car-atom (state:rows $counted))))
          ($pairs (task:row-pairs (state:rows $selected) (state:text (state:meta "owner"))))
          ($entries (task:index-entries $pairs)) ($end (+ $offset (length $pairs))))
     (JsonObject ((JsonPair "root" (JsonString $root)) (JsonPair "entries" (JsonArray $entries))
       (JsonPair "total" (task:number $total)) (JsonPair "next" (if (< $end $total) (task:number $end) JsonNull))))))
(= (task-history $request) (task-history $request 0 20))
(= (task-history $request $offset) (task-history $request $offset 20))
(= (task-history $request $offset $count)
   (state:encoded (task:history $request (task:argument-number $offset) (task:argument-number $count))))
(= (task-note $text) (task-note $text "[]"))
(= (task-note $text $sources)
   (let* ((($references) (collapse (json-parse $sources)))
          ($encoded (state:encoded $references))
          ($request (state:text (state:meta "context_focus"))))
     (if (== (str:trim $text) "") "task-note: empty note"
       (case $references
         (((JsonArray $_)
           (case (state:query "INSERT INTO task_notes(request,text,sources) SELECT ?,?,? WHERE EXISTS(SELECT 1 FROM requests WHERE id=?)" ($request $text $encoded $request))
             (((sqlite:result $_ $_ 1 $_) "TASK_NOTE_SAVED: agent interpretation; original sources remain accessible")
              ($error (str:concat "task-note: " (repr $error))))))
          ($other "task-note: sources must be a JSON list"))))))

; Bytes-per-token comes from the selected provider's existing observation.
; Until calibrated, the fallback is labelled by its configurable value.
(= (context:ratio $model)
   (let* (($path (path:join (path:dirname (context:path)) "context-token-calibration.json"))
          ($file (state:json-file $path (JsonObject ())))
          ($entry (json-object-get $file $model))
          ($ratio (json-object-get $entry "bytes_per_token")))
     (case $ratio
       (((JsonNumber $value) (let $n (str:string->number $value) (if (> $n 0) $n 2.5)))
        ($other (str:string->number (system:getenv-or-default "METTACLAW_CONTEXT_BYTES_PER_TOKEN" "2.5")))))))
(= (context:measure $value $ratio) (math:ceil (/ (str:byte-length (state:encoded $value)) $ratio)))
(= (context:target)
   (case (json-object-get (context:policy) "task_tokens")
     (((JsonNumber $text) (max 0 (str:string->number $text)))
      ($other (parse (system:getenv-or-default "METTACLAW_TASK_CONTEXT_TOKENS" (repr (context:default-tokens))))))))
(= (task:archive $root $count)
   (if (== $count 0) JsonNull
     (JsonObject ((JsonPair "count" (task:number $count))
       (JsonPair "retrieve" (JsonArray ((JsonString "task-history") (JsonString $root) (JsonNumber "0"))))))))
(= (task:excerpt $text $allowance $ratio)
   (if (or (<= (math:ceil (/ (str:byte-length $text) $ratio)) $allowance) (<= (str:char-length $text) 128)) $text
     (let* (($length (str:char-length $text)) ($part (math:floor (/ $length 4)))
            ($next (str:join "" ((str:char-slice $text 0 $part) "\n[excerpt; full request via request-read]\n" (str:char-slice $text (- $length $part) $length)))))
       (task:excerpt $next $allowance $ratio))))
(= (task:excerpt-requests $requests $allowance $ratio)
   (if (== $requests ()) ()
     (let* (($item (car-atom $requests)) ($text (task:string $item "content"))
            ($short (task:excerpt $text $allowance $ratio))
            ($result (if (== $short $text) $item
              (let* (($marked (state:json-set $item "truncated" (JsonBool true)))
                     ($with-text (state:json-set $marked "content" (JsonString $short)))
                     ($id (task:string $item "id")))
                (state:json-set $with-text "retrieve" (JsonArray ((JsonString "request-read") (JsonString $id) (JsonNumber "0"))))))))
       (cons-atom $result (task:excerpt-requests (cdr-atom $requests) $allowance $ratio)))))
(= (task:frame $base $root $budget $ratio)
   (if (<= (context:measure $base $ratio) (/ $budget 2)) $base
     (let* (($requests (task:items $base "requests")) ($notes (task:items $base "notes"))
            ($allowance (max 32 (math:floor (/ $budget (max 4 (* 2 (length $requests)))))))
            ($next (state:json-set $base "requests" (JsonArray (task:excerpt-requests $requests $allowance $ratio))))
            ($frame (JsonObject ((JsonPair "compacted" (JsonBool true))
                      (JsonPair "retrieve" (JsonArray ((JsonString "task-read") (JsonString (str:concat "task-frame:" $root)) (JsonNumber "0"))))
                      (JsonPair "requests" (task:number (length $requests))) (JsonPair "notes" (task:number (length $notes)))))))
       (task:trim-notes (state:json-set $next "frame" $frame) $budget $ratio))))
(= (task:trim-notes $view $budget $ratio)
   (let $notes (task:items $view "notes")
     (if (or (== $notes ()) (<= (context:measure $view $ratio) (/ $budget 2))) $view
       (task:trim-notes (state:json-set $view "notes" (JsonArray (cdr-atom $notes))) $budget $ratio))))
(= (task:recent $reverse $space $ratio $chosen)
   (if (== $reverse ()) $chosen
     (let* (($pair (car-atom $reverse)) ($size (+ 1 (context:measure $pair $ratio))))
       (if (> $size $space) $chosen
         (task:recent (cdr-atom $reverse) (- $space $size) $ratio (cons-atom $pair $chosen))))))
(= (task:fit $view $root $total $chosen $budget $ratio)
   (let* (($archive (task:archive $root (- $total (length $chosen))))
          ($next (state:json-set (state:json-set $view "transcript" (JsonArray $chosen)) "archive" $archive)))
     (if (or (== $chosen ()) (<= (context:measure $next $ratio) $budget)) $next
       (task:fit $view $root $total (cdr-atom $chosen) $budget $ratio))))
(= (task:stub $pair $allowance $ratio)
   (let* (($entry (task:index-entry $pair))
          ($text (state:text (json-object-get $pair "result")))
          ($preview (task:excerpt $text $allowance $ratio))
          ($with-preview (state:json-set $entry "result_preview" (JsonString $preview))))
     (state:json-set $with-preview "compacted" (JsonBool true))))
; The encoding is never shorter than its strings' raw bytes, so a view whose
; strings alone exceed the budget skips the full encoding: a long task's whole
; history otherwise goes through json-stringify on every turn.
(= (task:text-bytes $value)
   (case $value
     (((JsonString $text) (str:byte-length $text))
      ((JsonObject $pairs) (task:pair-text-bytes $pairs 0))
      ((JsonArray $items) (task:item-text-bytes $items 0))
      ($other 0))))
(= (task:pair-text-bytes $pairs $total)
   (if (== $pairs ()) $total
     (let (JsonPair $key $child) (car-atom $pairs)
       (task:pair-text-bytes (cdr-atom $pairs) (+ $total (task:text-bytes $child))))))
(= (task:item-text-bytes $items $total)
   (if (== $items ()) $total
     (task:item-text-bytes (cdr-atom $items) (+ $total (task:text-bytes (car-atom $items))))))
(= (task:fits $view $budget $ratio)
   (if (> (math:ceil (/ (task:text-bytes $view) $ratio)) $budget) False
     (<= (context:measure $view $ratio) $budget)))
(= (task:compact $view $budget $ratio)
   (if (task:fits $view $budget $ratio) $view
     (let* (($root (task:string $view "root")) ($pairs (task:items $view "transcript"))
            ($base (state:json-set (state:json-set $view "transcript" (JsonArray ())) "archive" (task:archive $root (length $pairs))))
            ($frame (task:frame $base $root $budget $ratio))
            ($space (max 0 (- $budget (context:measure $frame $ratio))))
            ($reverse (task:reverse $pairs ()))
            ($recent (task:recent $reverse $space $ratio ()))
            ($chosen (if (or (not (== $recent ())) (== $reverse ())) $recent
                         ((task:stub (car-atom $reverse) (max 16 (math:floor (/ $space 2))) $ratio)))))
       (task:fit $frame $root (length $pairs) $chosen $budget $ratio))))
(= (task:append-context $prompt $focus $trigger $capacity $model)
   (task:render-context (str:join "\n" ($prompt (topics:context))) $focus $trigger $capacity $model))
(= (task:render-context $base $focus $trigger $capacity $model)
   (let $ratio (context:ratio $model)
     (if (== (context:mode) budget)
       (task:budget-context $base $focus $trigger $capacity $ratio)
       (task:full-context $base $focus $trigger $capacity $ratio))))
(= (task:budget-context $base $focus $trigger $capacity $ratio)
   (let* (($target (context:target))
          ($available (if (== $capacity "") $target
                        (min $target (max 0 (- (- (str:string->number $capacity) (math:ceil (/ (str:byte-length $base) $ratio))) 128)))))
          ($selected (task:compact (task:conversation-view $focus $trigger) $available $ratio))
          ($candidate (state:json-set $selected "transcript"
                        (JsonArray (task:idle-pairs
                          (task:items $selected "transcript")))))
          ($view (if (<= (str:byte-length (state:encoded $candidate))
                         (str:byte-length (state:encoded $selected)))
                    $candidate $selected)))
     (str:join "\n\n" ((task:place-transcript $base ()) (str:concat "TASK_CONTEXT " (state:encoded $view))))))

; The whole-window view spans task frames. The transcript is append-only from a
; saved start and is compacted when it passes 90% of the available window;
; a successful handoff retains the newest 20%. Each result is
; cut in the middle at about 10k tokens, as Codex cuts tool output. Complete
; chunks of steps never change, so they sit ahead of per-turn state where a
; provider can cache them; the newest steps stay in TASK_CONTEXT.
(= (task:chunk-size) 8)
(= (task:result-chars) 40000)
(= (task:fallback-window) 200000)
(= (task:window-key $root) (str:concat "task_window:" $root))
(= (task:checkpoint-record $value)
   (case $value (((JsonObject $_) $value) ($other (JsonObject ())))))
(= (task:checkpoint-summary $value)
   (case (state:json-field $value "summary")
     (((JsonString $text) $text) ($other ""))))
(= (task:checkpoint-number $value $key)
   (case (state:json-field $value $key)
     (((JsonNumber $text) (str:string->number $text)) ($other -1))))
(= (task:valid-archive-gap? $gap $start)
   (let* (($from (task:checkpoint-number $gap "from"))
          ($until (task:checkpoint-number $gap "until")))
     (and (== (state:json-field $gap "status") (JsonString "not-summarized"))
       (and (and (>= $from 0) (> $until $from))
         (and (<= $until $start) (and (== $from (math:floor $from)) (== $until (math:floor $until))))))))
(= (task:checkpoint-start $checkpoint)
   (let* (($start (task:checkpoint-number $checkpoint "start"))
          ($summary (task:checkpoint-summary $checkpoint))
          ($gap (state:json-field $checkpoint "archive_gap")))
     (if (and (and (>= $start 0) (== $start (math:floor $start)))
              (or (not (== (str:trim $summary) ""))
                (and (task:valid-archive-gap? $gap $start)
                  (and (== (task:checkpoint-number $gap "from") 0)
                       (== (task:checkpoint-number $gap "until") $start))))) $start 0)))
(= (task:saved-start $root)
   (task:checkpoint-start (state:meta (task:window-key $root))))
(= (task:conversation-view $focus $trigger)
   (task:conversation-projection $focus $trigger
     (task:saved-start (task:conversation-root)) (task:result-chars)))
(= (task:handoff-text $root)
   (task:checkpoint-handoff $root (state:meta (task:window-key $root))))
(= (task:checkpoint-handoff $root $checkpoint)
   (let* (($summary (task:checkpoint-summary $checkpoint))
          ($authored (if (== (str:trim $summary) "") "" (task:render-handoff $summary)))
          ($gap (state:json-field $checkpoint "archive_gap"))
          ($notice (if (task:valid-archive-gap? $gap (task:checkpoint-start $checkpoint))
                     (task:render-archive-gap $root $gap) "")))
     (if (== $notice "") $authored
       (if (== $authored "") $notice (str:join "\n\n" ($authored $notice))))))
(= (task:render-archive-gap $root $gap)
   (str:join "" (
     "UNSUMMARIZED_ARCHIVE (operator migration; not a model-authored summary): source records ["
     (state:text (state:json-field $gap "from")) "," (state:text (state:json-field $gap "until"))
     ") were not summarized. Their original inputs and results remain in the ledger. Retrieve this range with "
     (state:encoded (JsonArray ((JsonString "task-history") (JsonString $root) (state:json-field $gap "from"))))
     ", then task-read; do not treat the retained handoff as covering this gap.")))
(= (task:render-handoff $summary)
   (str:join "" ("CONTEXT_HANDOFF (model-authored; original inputs and results remain in task-history/task-read):\n"
                  (task:plain $summary))))
(= (task:short-text $text)
   (let $length (str:char-length $text)
     (if (<= $length (task:result-chars)) $text
       (let* (($half (math:floor (/ (task:result-chars) 2))) ($cut (- $length (* 2 $half))))
         (str:join "" ((str:char-slice $text 0 $half)
                       (str:join "" ("\n…" (repr (math:ceil (/ $cut 4))) " tokens truncated; task-read shows the whole result…\n"))
                       (str:char-slice $text (- $length $half) $length)))))))
(= (task:shown $pair)
   (if (task:truncated? $pair) $pair (task:show-result $pair)))
(= (task:truncated? $pair)
   (case (state:json-field $pair "result_truncated")
     (((JsonBool $value) $value) ($other False))))
(= (task:show-result $pair)
   (case (state:json-field $pair "result")
     (((JsonString $text)
        (let $short (task:short-text $text)
          (if (== $short $text) $pair
            (state:json-set (state:json-set $pair "result" (JsonString $short)) "result_truncated" (JsonBool True)))))
      ($other $pair))))
(= (task:shown-all $pairs)
   (if (== $pairs ()) () (cons-atom (task:shown (car-atom $pairs)) (task:shown-all (cdr-atom $pairs)))))
(= (task:pair-tokens $pair $ratio)
   (let (Stepped $text $_) (task:step-text $pair 0 ())
     (math:ceil (/ (+ 24 (str:byte-length $text)) $ratio))))
(= (task:sum-tokens $pairs $ratio $total)
   (if (== $pairs ()) $total
     (task:sum-tokens (cdr-atom $pairs) $ratio (+ $total (task:pair-tokens (car-atom $pairs) $ratio)))))
(= (task:keep-count $reverse $space $ratio $count)
   (if (== $reverse ()) $count
     (let $size (task:pair-tokens (car-atom $reverse) $ratio)
       (if (> $size $space) $count (task:keep-count (cdr-atom $reverse) (- $space $size) $ratio (+ $count 1))))))
; Returns (Window $start $shown): $shown are the window's steps, results cut.
(= (task:window $root $pairs $available $ratio)
   (task:window-from $root $pairs 0 $available $ratio))
(= (task:window-from $root $pairs $offset $available $ratio)
   (let* (($total (+ $offset (length $pairs))) ($saved (max $offset (min (task:saved-start $root) $total)))
          ($shown (task:shown-all (task:drop $pairs (- $saved $offset)))))
     (if (<= (task:sum-tokens $shown $ratio 0) (math:floor (* 0.9 $available))) (Window $saved $shown)
       (let* (($keep (max 1 (task:keep-count (task:reverse $shown ()) (math:floor (* 0.2 $available)) $ratio 0)))
              ($start (- $total (min $keep $total))))
         (Window $start (task:drop $shown (- $start $saved)))))))
(= (task:chunk-view $pairs) (task:idle-pairs $pairs))
(= (task:escape $text $needle $replacement)
   (case (str:find $text $needle)
     (((TextNotFound $_) $text)
      ($at (str:join "" ((str:byte-slice $text 0 $at) $replacement
             (task:escape (str:byte-slice $text (+ $at (str:byte-length $needle)) (str:byte-length $text)) $needle $replacement)))))))
; Layout markers inside step content would split the prompt; a JSON escape of
; the underscore keeps the decoded text identical.
; A step reads as a short header and its result as plain text. A long
; result identical to an earlier one in the window is a pointer to that step;
; the pointer only looks back, so complete chunks stay unchanged.
(= (task:plain $text)
   (task:escape (task:escape $text "_cache_boundary_" "_cache-boundary_") "_cache_chunk_" "_cache-chunk_"))
(= (task:result-text $pair)
   (case (state:json-field $pair "result")
     (((JsonString $text) $text)
      ($other (state:encoded $other)))))
(= (task:seen-step $digest $seen)
   (if (== $seen ()) None
     (let (Seen $known $step) (car-atom $seen)
       (if (== $known $digest) $step (task:seen-step $digest (cdr-atom $seen))))))
(= (task:step-text $pair $index $seen)
   (case (state:json-field $pair "command")
     ((JsonNull
        (if (== (state:json-field $pair "disposition") (JsonString "input"))
          (Stepped (str:join "" ("\n## step " (repr $index) " · input · id " (task:string $pair "id")
                     " · request " (task:string $pair "request") "\n" (task:plain (task:result-text $pair)))) $seen)
          (Stepped (str:join "" ("\n## step " (repr $index) "\n" (task:plain (state:encoded $pair)))) $seen)))
      ($command
        (let* (($result (task:result-text $pair))
               ($digest (if (and (not (task:truncated? $pair)) (> (str:byte-length $result) 512)) (str:sha256 $result) short))
               ($earlier (if (== $digest short) None (task:seen-step $digest $seen)))
               ($body (if (== $earlier None) (task:plain $result)
                        (str:join "" ("(same result as step " (repr $earlier) ")"))))
               ($next (if (or (== $digest short) (not (== $earlier None))) $seen (cons-atom (Seen $digest $index) $seen))))
          (Stepped (str:join "" ("\n## step " (task:step-label $pair $index) " · " (task:plain (state:encoded $command))
                                 " · " (state:text (state:json-field $pair "disposition"))
                                 " · id " (state:text (state:json-field $pair "id")) "\n" $body)) $next))))))
; A collapsed run of identical steps counts as all of them.
(= (task:step-span $pair)
   (case (state:json-field $pair "count")
     (((JsonNumber $text) (max 1 (str:string->number $text))) ($other 1))))
(= (task:step-label $pair $index)
   (let $span (task:step-span $pair)
     (if (== $span 1) (repr $index)
       (str:join "" ((repr $index) "-" (repr (+ $index (- $span 1))) " (" (repr $span) " identical steps)")))))
(= (task:steps-text $pairs $index $seen $out)
   (if (== $pairs ()) (Stepped (str:join "" (task:reverse $out ())) $seen)
     (let (Stepped $text $next) (task:step-text (car-atom $pairs) $index $seen)
       (task:steps-text (cdr-atom $pairs) (+ $index (task:step-span (car-atom $pairs))) $next (cons-atom $text $out)))))
(= (task:chunk-text $chunk $index $seen)
   (let (Stepped $body $next) (task:steps-text (task:chunk-view $chunk) $index $seen ())
     (Stepped (str:join "" ("TASK_TRANSCRIPT steps " (repr $index) "-" (repr (+ $index (- (length $chunk) 1)))
                            " (oldest first; newer steps follow in TASK_RECENT):" $body)) $next)))
(= (task:chunks $pairs $index $seen $out)
   (if (< (length $pairs) (task:chunk-size)) (Chunks (task:reverse $out ()) $seen)
     (let (Stepped $text $next) (task:chunk-text (task:take $pairs (task:chunk-size)) $index $seen)
       (task:chunks (task:drop $pairs (task:chunk-size)) (+ $index (task:chunk-size)) $next (cons-atom $text $out)))))
; The transcript slot follows the second boundary and is the last cached
; block: the conversation, which changes with every message, moves behind it
; into per-turn text, so a new message does not invalidate cached steps. The
; layout keeps three boundaries; chunk markers let a provider cache each
; complete chunk as its own block.
(= (task:place-transcript $base $chunks)
   (case (str:find $base "_cache_boundary_")
     (((TextNotFound $_) $base)
      ($first
        (let* (($head (str:byte-slice $base 0 (+ $first 16)))
               ($rest (str:byte-slice $base (+ $first 16) (str:byte-length $base))))
          (case (str:find $rest "_cache_boundary_")
            (((TextNotFound $_) $base)
             ($second
               (let* (($upto (str:byte-slice $rest 0 (+ $second 16)))
                      ($after (str:byte-slice $rest (+ $second 16) (str:byte-length $rest)))
                      ($slot (if (== $chunks ()) "" (str:join "\n_cache_chunk_\n" $chunks))))
                 (case (str:find $after "_cache_boundary_")
                   (((TextNotFound $_) $base)
                    ($third
                      (let* (($conversation (str:byte-slice $after 0 $third))
                             ($turn (str:byte-slice $after (+ $third 16) (str:byte-length $after))))
                        (str:join "" ($head $upto "\n\n" $slot "\n\n_cache_boundary_" $conversation $turn)))))))))))))))
(= (task:full-context $base $focus $trigger $capacity $ratio)
   (task:full-context-view $base (task:conversation-view $focus $trigger) $capacity $ratio))
(= (task:full-context-view $base $view $capacity $ratio)
   (let* (($trigger (task:string $view "trigger"))
          ($window (if (== $capacity "") (task:fallback-window) (str:string->number $capacity)))
          ($available (max 0 (- (- $window (math:ceil (/ (str:byte-length $base) $ratio))) 128)))
          ($root (task:string $view "root"))
          ($handoff (task:joined-handoff $root $view))
          ($pairs (task:items $view "transcript"))
          ($offset (str:string->number (state:text (state:json-field $view "offset"))))
          ($frame (task:working-frame $view $available $ratio))
          ($space (max 0 (- (- $available (context:measure $frame $ratio)) (math:ceil (/ (str:byte-length $handoff) $ratio)))))
          ((Window $start $shown) (task:window-from $root $pairs $offset $space $ratio))
          ($complete (* (task:chunk-size) (math:floor (/ (length $shown) (task:chunk-size)))))
          ((Chunks $chunks $seen) (task:chunks (task:take $shown $complete) $start () ()))
          ($placed (task:place-transcript $base (if (== $handoff "") $chunks (cons-atom $handoff $chunks))))
          ($recent (if (== $placed $base) $shown (task:drop $shown $complete)))
          ($first (if (== $placed $base) $start (+ $start $complete)))
          ((Stepped $recent-text $_) (task:steps-text (task:chunk-view $recent) $first (if (== $placed $base) () $seen) ()))
          ($requests (task:quiet-focus (task:items $frame "requests") (task:string $view "focus") $trigger))
          ($with-requests (state:json-set $frame "requests" (JsonArray $requests)))
          ($meta (state:json-set (state:json-set $with-requests "transcript" (JsonArray ())) "archive" (task:archive $root $start)))
          ($window-info (JsonObject ((JsonPair "mode" (JsonString "full"))
                          (JsonPair "transcript_steps" (task:number (length $shown)))
                          (JsonPair "first_step_here" (task:number $first))
                          (JsonPair "available_tokens" (task:number $available)))))
          ($context (state:json-set $meta "window" $window-info)))
     (if (> $start $offset) (ContextPreparationFailed "context-compaction-required")
       (str:join "\n\n" ($placed (if (== $placed $base) $handoff "")
                          (str:concat "TASK_RECENT newest steps, oldest first:" $recent-text)
                          (str:concat "TASK_CONTEXT " (state:encoded $context)))))))

; Inputs have their own chronological entries. Metadata keeps request state
; and exact retrieval addresses, without repeating every input each turn.
(= (task:request-references $requests)
   (if (== $requests ()) ()
     (let* (($request (car-atom $requests)) ($id (task:string $request "id"))
            ($next (if (== (state:json-field $request "content") JsonNull) $request
              (state:json-set $request "content" (JsonString "(input in the continuous transcript; request-read retains the complete source)")))))
       (cons-atom $next (task:request-references (cdr-atom $requests))))))
(= (task:working-frame $view $available $ratio)
   (let* (($without (state:json-set $view "transcript" (JsonArray ())))
          ($references (task:request-references (task:items $view "requests")))
          ($base (state:json-set $without "requests" (JsonArray $references))))
     (task:frame $base (task:string $view "root") $available $ratio)))
; The input that started this turn is already NEW_ACTIVITY; its request keeps
; its identity here but not a second copy of its text.
(= (task:quiet-focus $requests $focus $trigger)
   (if (== $requests ()) ()
     (let* (($item (car-atom $requests))
            ($rest (task:quiet-focus (cdr-atom $requests) $focus $trigger)))
       (if (and (not (== (state:json-field $item "content") JsonNull))
                (and (not (== $trigger "continuation-tick")) (== (task:string $item "id") $focus)))
         (cons-atom (state:json-set $item "content" (JsonString "(this turn's NEW_ACTIVITY)")) $rest)
         (cons-atom $item $rest)))))

(= (task:pending-handoff $view)
   (let $gap (state:json-field $view "pending_history")
     (if (== $gap JsonNull) ""
       (str:join "" ("UNFOLDED_HISTORY: records [" (task:string $gap "from") "," (task:string $gap "until")
         ") are not summarized (" (task:string $gap "reason") "). Originals remain in the ledger. Retrieve with "
         (state:encoded (JsonArray ((JsonString "task-history") (state:json-field $view "root") (state:json-field $gap "from"))))
         ", then task-read. Do not infer missing findings or complete a task that depends on them without retrieving its evidence. Unrelated current work may proceed.")))))

(= (task:joined-handoff $root $view)
   (let* (($saved (task:handoff-text $root)) ($pending (task:pending-handoff $view)))
     (if (== $pending "") $saved
       (if (== $saved "") $pending (str:join "\n\n" ($saved $pending))))))
