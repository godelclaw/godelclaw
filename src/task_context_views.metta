; Selection, recoverable compaction and paging are MeTTa policy. The original
; database rows remain unchanged and addressable after every excerpt.
!(import! &self ./src/task_context_cetta)
!(import! &self (library math))

(= (task:items $record $key)
   (let (JsonArray $items) (state:json-field $record $key) $items))
(= (task:number $value) (JsonNumber (repr $value)))
(= (task:drop $items $count)
   (if (or (<= $count 0) (== $items ())) $items (task:drop (cdr-atom $items) (- $count 1))))
(= (task:take $items $count)
   (if (or (<= $count 0) (== $items ())) ()
     (cons-atom (car-atom $items) (task:take (cdr-atom $items) (- $count 1)))))
(= (task:reverse $items $out)
   (if (== $items ()) $out (task:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out))))
(= (task:find $pairs $identity)
   (if (== $pairs ()) (Error task-read unknown-call-identity)
     (if (== (task:string (car-atom $pairs) "id") $identity) (car-atom $pairs)
       (task:find (cdr-atom $pairs) $identity))))
(= (task:call $identity)
   (let $parts (task:reverse (str:split ":" $identity) ())
     (if (< (length $parts) 3) (Error task-read invalid-call-identity)
       (task:call-parts $identity $parts))))
(= (task:call-parts $identity $parts)
   (let* (($position (car-atom $parts)) ($serial (parse (car-atom (cdr-atom $parts))))
          ($owner (str:join ":" (task:reverse (cdr-atom (cdr-atom $parts)) ())))
          ($rows (state:rows (state:query "SELECT request FROM task_proposals WHERE serial=? UNION ALL SELECT request FROM actions WHERE serial=? LIMIT 1" ($serial $serial)))))
     (if (not (== $owner (state:text (state:meta "owner")))) (Error task-read another-ledger)
       (if (== $rows ()) (Error task-read unknown-call-identity)
         (task:find (task:items (task:projection (car-atom (car-atom $rows)) "retrieval") "transcript") $identity)))))
(= (task:page-end $raw $offset $end $size)
   (if (<= (str:byte-length (str:char-slice $raw $offset $end)) $size) $end
     (task:page-end $raw $offset (+ $offset (math:floor (/ (- $end $offset) 2))) $size)))
(= (task:page $identity $value $offset $size)
   (if (or (< $offset 0) (<= $size 0)) (Error task-read invalid-page)
     (let* (($raw (state:encoded $value)) ($characters (str:char-length $raw))
            ($start (min $offset $characters))
            ($end (task:page-end $raw $start (min $characters (+ $start $size)) $size))
            ($next (if (< $end $characters) (task:number $end) JsonNull))
            ($digest (str:concat "sha256:" (str:sha256 $raw)))
            ($text (str:char-slice $raw $start $end)))
       (if (and (== $start $end) (< $start $characters)) (Error task-read page-cannot-hold-next-character)
         (JsonObject ((JsonPair "id" (JsonString $identity)) (JsonPair "digest" (JsonString $digest))
           (JsonPair "offset" (task:number $offset)) (JsonPair "text" (JsonString $text))
           (JsonPair "next" $next) (JsonPair "characters" (task:number $characters))))))))
(= (task:read $id $offset $size)
   (let $value (if (str:starts-with $id "task-frame:")
                  (let $full (task:projection (str:char-slice $id 11 (str:char-length $id)) "continuation-tick")
                    (let (JsonObject $fields) $full
                      (let $remaining (state:json-without $fields "transcript") (JsonObject $remaining))))
                  (task:call $id))
     (case $value (((Error $where $reason) $value) ($other (task:page $id $value $offset $size))))))
(= (task-read $id) (task-read $id 0 8192))
(= (task-read $id $offset) (task-read $id $offset 8192))
(= (task:argument-number $value) (str:string->number (format-args "{}" ($value))))
(= (task-read $id $offset $size)
   (case (catch (task:read $id (task:argument-number $offset) (task:argument-number $size)))
     (((Error $where $reason) (str:concat "TASK_READ_FAILED: " (repr $reason)))
      ($page (state:encoded $page)))))
(= (task:index-entry $pair)
   (let $id (task:string $pair "id")
     (JsonObject ((JsonPair "id" (JsonString $id)) (JsonPair "command" (json-object-get $pair "command"))
       (JsonPair "disposition" (json-object-get $pair "disposition"))
       (JsonPair "retrieve" (JsonArray ((JsonString "task-read") (JsonString $id) (JsonNumber "0"))))))))
(= (task:index-entries $pairs)
   (if (== $pairs ()) () (cons-atom (task:index-entry (car-atom $pairs)) (task:index-entries (cdr-atom $pairs)))))
(= (task:history $request $offset $count)
   (if (or (< $offset 0) (< $count 0)) (Error task-history invalid-page)
     (let* (($view (task:projection $request "continuation-tick")) ($all (task:items $view "transcript"))
            ($tail (task:drop $all $offset)) ($page (if (== $count 0) $tail (task:take $tail $count)))
            ($entries (task:index-entries $page)) ($total (length $all)) ($end (+ $offset (length $page))))
       (JsonObject ((JsonPair "root" (json-object-get $view "root")) (JsonPair "entries" (JsonArray $entries))
         (JsonPair "total" (task:number $total)) (JsonPair "next" (if (< $end $total) (task:number $end) JsonNull)))))))
(= (task-history $request) (task-history $request 0 20))
(= (task-history $request $offset) (task-history $request $offset 20))
(= (task-history $request $offset $count)
   (state:encoded (task:history $request (task:argument-number $offset) (task:argument-number $count))))
(= (task-note $text) (task-note $text "[]"))
(= (task-note $text $sources)
   (let* ((($references) (collapse (json-parse $sources)))
          ($encoded (state:encoded $references))
          ($request (state:text (state:meta "context_focus"))))
     (if (== (str:trim $text) "") "task-note: empty note"
       (case $references
         (((JsonArray $_)
           (case (state:query "INSERT INTO task_notes(request,text,sources) SELECT ?,?,? WHERE EXISTS(SELECT 1 FROM requests WHERE id=?)" ($request $text $encoded $request))
             (((sqlite:result $_ $_ 1 $_) "TASK_NOTE_SAVED: agent interpretation; original sources remain accessible")
              ($error (str:concat "task-note: " (repr $error))))))
          ($other "task-note: sources must be a JSON list"))))))

; Bytes-per-token comes from the selected provider's existing observation.
; Until calibrated, the fallback is labelled by its configurable value.
(= (context:ratio $model)
   (let* (($path (path:join (path:dirname (context:path)) "context-token-calibration.json"))
          ($file (state:json-file $path (JsonObject ())))
          ($entry (json-object-get $file $model))
          ($ratio (json-object-get $entry "bytes_per_token")))
     (case $ratio
       (((JsonNumber $value) (let $n (str:string->number $value) (if (> $n 0) $n 2.5)))
        ($other (str:string->number (system:getenv-or-default "METTACLAW_CONTEXT_BYTES_PER_TOKEN" "2.5")))))))
(= (context:measure $value $ratio) (math:ceil (/ (str:byte-length (state:encoded $value)) $ratio)))
(= (context:target)
   (case (json-object-get (context:policy) "task_tokens")
     (((JsonNumber $text) (max 0 (str:string->number $text)))
      ($other (parse (system:getenv-or-default "METTACLAW_TASK_CONTEXT_TOKENS" (repr (context:default-tokens))))))))
(= (task:archive $root $count)
   (if (== $count 0) JsonNull
     (JsonObject ((JsonPair "count" (task:number $count))
       (JsonPair "retrieve" (JsonArray ((JsonString "task-history") (JsonString $root) (JsonNumber "0"))))))))
(= (task:excerpt $text $allowance $ratio)
   (if (or (<= (math:ceil (/ (str:byte-length $text) $ratio)) $allowance) (<= (str:char-length $text) 128)) $text
     (let* (($length (str:char-length $text)) ($part (math:floor (/ $length 4)))
            ($next (str:join "" ((str:char-slice $text 0 $part) "\n[excerpt; full request via request-read]\n" (str:char-slice $text (- $length $part) $length)))))
       (task:excerpt $next $allowance $ratio))))
(= (task:excerpt-requests $requests $allowance $ratio)
   (if (== $requests ()) ()
     (let* (($item (car-atom $requests)) ($text (task:string $item "content"))
            ($short (task:excerpt $text $allowance $ratio))
            ($result (if (== $short $text) $item
              (let* (($marked (state:json-set $item "truncated" (JsonBool true)))
                     ($with-text (state:json-set $marked "content" (JsonString $short)))
                     ($id (task:string $item "id")))
                (state:json-set $with-text "retrieve" (JsonArray ((JsonString "request-read") (JsonString $id) (JsonNumber "0"))))))))
       (cons-atom $result (task:excerpt-requests (cdr-atom $requests) $allowance $ratio)))))
(= (task:frame $base $root $budget $ratio)
   (if (<= (context:measure $base $ratio) (/ $budget 2)) $base
     (let* (($requests (task:items $base "requests")) ($notes (task:items $base "notes"))
            ($allowance (max 32 (math:floor (/ $budget (max 4 (* 2 (length $requests)))))))
            ($next (state:json-set $base "requests" (JsonArray (task:excerpt-requests $requests $allowance $ratio))))
            ($frame (JsonObject ((JsonPair "compacted" (JsonBool true))
                      (JsonPair "retrieve" (JsonArray ((JsonString "task-read") (JsonString (str:concat "task-frame:" $root)) (JsonNumber "0"))))
                      (JsonPair "requests" (task:number (length $requests))) (JsonPair "notes" (task:number (length $notes)))))))
       (task:trim-notes (state:json-set $next "frame" $frame) $budget $ratio))))
(= (task:trim-notes $view $budget $ratio)
   (let $notes (task:items $view "notes")
     (if (or (== $notes ()) (<= (context:measure $view $ratio) (/ $budget 2))) $view
       (task:trim-notes (state:json-set $view "notes" (JsonArray (cdr-atom $notes))) $budget $ratio))))
(= (task:recent $reverse $space $ratio $chosen)
   (if (== $reverse ()) $chosen
     (let* (($pair (car-atom $reverse)) ($size (+ 1 (context:measure $pair $ratio))))
       (if (> $size $space) $chosen
         (task:recent (cdr-atom $reverse) (- $space $size) $ratio (cons-atom $pair $chosen))))))
(= (task:fit $view $root $total $chosen $budget $ratio)
   (let* (($archive (task:archive $root (- $total (length $chosen))))
          ($next (state:json-set (state:json-set $view "transcript" (JsonArray $chosen)) "archive" $archive)))
     (if (or (== $chosen ()) (<= (context:measure $next $ratio) $budget)) $next
       (task:fit $view $root $total (cdr-atom $chosen) $budget $ratio))))
(= (task:stub $pair $allowance $ratio)
   (let* (($entry (task:index-entry $pair))
          ($text (state:text (json-object-get $pair "result")))
          ($preview (task:excerpt $text $allowance $ratio))
          ($with-preview (state:json-set $entry "result_preview" (JsonString $preview))))
     (state:json-set $with-preview "compacted" (JsonBool true))))
; The encoding is never shorter than its strings' raw bytes, so a view whose
; strings alone exceed the budget skips the full encoding: a long task's whole
; history otherwise goes through json-stringify on every turn.
(= (task:text-bytes $value)
   (case $value
     (((JsonString $text) (str:byte-length $text))
      ((JsonObject $pairs) (task:pair-text-bytes $pairs 0))
      ((JsonArray $items) (task:item-text-bytes $items 0))
      ($other 0))))
(= (task:pair-text-bytes $pairs $total)
   (if (== $pairs ()) $total
     (let (JsonPair $key $child) (car-atom $pairs)
       (task:pair-text-bytes (cdr-atom $pairs) (+ $total (task:text-bytes $child))))))
(= (task:item-text-bytes $items $total)
   (if (== $items ()) $total
     (task:item-text-bytes (cdr-atom $items) (+ $total (task:text-bytes (car-atom $items))))))
(= (task:fits $view $budget $ratio)
   (if (> (math:ceil (/ (task:text-bytes $view) $ratio)) $budget) False
     (<= (context:measure $view $ratio) $budget)))
(= (task:compact $view $budget $ratio)
   (if (task:fits $view $budget $ratio) $view
     (let* (($root (task:string $view "root")) ($pairs (task:items $view "transcript"))
            ($base (state:json-set (state:json-set $view "transcript" (JsonArray ())) "archive" (task:archive $root (length $pairs))))
            ($frame (task:frame $base $root $budget $ratio))
            ($space (max 0 (- $budget (context:measure $frame $ratio))))
            ($reverse (task:reverse $pairs ()))
            ($recent (task:recent $reverse $space $ratio ()))
            ($chosen (if (or (not (== $recent ())) (== $reverse ())) $recent
                         ((task:stub (car-atom $reverse) (max 16 (math:floor (/ $space 2))) $ratio)))))
       (task:fit $frame $root (length $pairs) $chosen $budget $ratio))))
(= (task:append-context $prompt $focus $trigger $capacity $model)
   (let* (($base (str:join "\n" ($prompt (topics:context))))
          ($ratio (context:ratio $model)) ($target (context:target))
          ($available (if (== $capacity "") $target
                        (min $target (max 0 (- (- (str:string->number $capacity) (math:ceil (/ (str:byte-length $base) $ratio))) 128)))))
          ($view (task:compact (task:projection $focus $trigger) $available $ratio)))
     (str:join "\n\n" ($base (str:concat "TASK_CONTEXT " (state:encoded $view))))))
