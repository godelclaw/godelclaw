; Owned mode-state I/O. No shell, Python persistence, locks masquerading as
; multi-file atomicity, retry after partial writes, or cached file contents.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self ./src/mode_values_cetta.metta)
!(import! &self ./src/mode_text_cetta.metta)

(= (mio:env $key $default) (system:getenv-or-default $key $default))
(= (mio:errno-class $errno)
   (mio:errno-match $errno
     (("EAGAIN" BlockingIOError) ("EALREADY" BlockingIOError) ("EWOULDBLOCK" BlockingIOError)
      ("EINPROGRESS" BlockingIOError) ("ECHILD" ChildProcessError)
      ("EPIPE" BrokenPipeError) ("ESHUTDOWN" BrokenPipeError)
      ("ECONNABORTED" ConnectionAbortedError) ("ECONNREFUSED" ConnectionRefusedError)
      ("ECONNRESET" ConnectionResetError) ("EEXIST" FileExistsError)
      ("ENOENT" FileNotFoundError) ("EINTR" InterruptedError)
      ("EISDIR" IsADirectoryError) ("ENOTDIR" NotADirectoryError)
      ("EACCES" PermissionError) ("EPERM" PermissionError)
      ("ESRCH" ProcessLookupError) ("ETIMEDOUT" TimeoutError))))
(= (mio:errno-match $errno $pairs)
   (if (== $pairs ()) OSError
     (let ($name $class) (car-atom $pairs)
       (if (== $errno (system:errno-value $name)) $class
         (mio:errno-match $errno (cdr-atom $pairs))))))
(= (mio:os-error? $value)
   (case $value
     (((ErFailure $class $_ $_)
       (mv:contains (OSError BlockingIOError ChildProcessError BrokenPipeError
         ConnectionError ConnectionAbortedError ConnectionRefusedError ConnectionResetError
         FileExistsError FileNotFoundError InterruptedError IsADirectoryError
         NotADirectoryError PermissionError ProcessLookupError TimeoutError) $class))
      ($other False))))
(= (mio:result $value)
   (case $value
     (((fs:failed $kind $op $path $errno $progress $message)
       (ErFailure (mio:errno-class $errno)
         (str:join "" ("[Errno " (repr $errno) "] " $message
           (if (or (mv:contains (open-write open-read make-directories remove) $op)
                   (and (== $op set-mode) (!= $path "")))
             (str:concat ": " (mio:path-quote $path)) ""))) $value))
      ((Error $where $why) (ErFailure NativeEvaluationError "native filesystem operation failed" $value))
      ($other $other))))
(= (mio:path-quote $path) (erv:quote (mode-text:os-text $path)))
(= (mio:once $answers)
   (case $answers ((($value) (mio:result $value))
     ($other (ErFailure NativeEvaluationError "native operation did not return one outcome" $answers)))))
; POSIX lexical operations: never collapse symlink/.. through path:normalize.
(= (mio:rstrip-slash $text)
   (if (and (!= $text "") (str:ends-with $text "/"))
     (mio:rstrip-slash (str:byte-slice $text 0 (- (str:byte-length $text) 1))) $text))
(= (mio:split $text)
   (let* (($parts (str:split "/" $text))
          ($head (str:join "/" (erv:take $parts (- (size-atom $parts) 1))))
          ($tail (index-atom $parts (- (size-atom $parts) 1))))
     ((if (== $head "") (if (str:starts-with $text "/") "/" "")
        (if (== (mio:rstrip-slash $head) "") $head (mio:rstrip-slash $head))) $tail)))
(= (mio:dirname $path) (let ($head $_) (mio:split $path) $head))
(= (mio:join $root $leaf)
   (if (str:starts-with $leaf "/") $leaf
     (if (or (== $root "") (str:ends-with $root "/"))
       (str:concat $root $leaf) (str:join "/" ($root $leaf)))))
(= (mio:nul? $path) (not (== (str:find $path (str:from-python-codepoints (0)))
                            (TextNotFound (str:from-python-codepoints (0))))))
(= (mio:mkdir $path)
   (if (mio:nul? $path) (erv:fail ValueError "embedded null byte")
     (mio:once (collapse (catch (fs:make-directories $path 511))))))
(= (mio:parent $path)
   (let $parent (mio:dirname $path) (if (== $parent "") () (mio:mkdir $parent))))
(= (mio:close $owner $body)
   (let $closed (mio:once (collapse (catch (fs:close $owner))))
     (if (== $closed fs:closed) $body
       (case $closed
         (((ErFailure $class $message $detail)
           (ErFailure $class $message (ModeCloseFailure $detail $body)))
          ($other (ErFailure NativeEvaluationError "missing native close outcome" ($other $body))))))))
(= (mio:open $path $flags $mode)
   (if (mio:nul? $path) (erv:fail ValueError "embedded null byte")
     (let $value (mio:once (collapse (catch (fs:open-write $path $flags $mode))))
       (case $value (((NativeHandle "file-writer" $_) $value)
         ((ErFailure $_ $_ $_) $value)
         ($other (ErFailure NativeEvaluationError "missing writer owner" $other)))))))
(= (mio:write-body $owner $payload $sync $mode)
   (let $encoded (erv:encode $payload)
     (if (mv:failed? $encoded) $encoded
       (let $written (mio:once (collapse (catch (fs:write-all $owner $encoded))))
         (case $written
           (((fs:written $n)
             (if (== $n (str:byte-length $encoded))
               (let $synced (if $sync (mio:once (collapse (catch (fs:sync $owner)))) fs:synced)
                 (if (== $synced fs:synced)
                   (if (== $mode ()) 1
                     (let $set (mio:once (collapse (catch (fs:set-mode $owner $mode))))
                       (if (== $set fs:mode-set) 1 $set))) $synced))
               (ErFailure NativeEvaluationError "partial native write; progress retained" $written)))
            ($other $other)))))))
(= (mio:write $path $payload $flags $creation $sync $mode)
   (let $owner (mio:open $path $flags $creation)
     (if (mv:failed? $owner) $owner
       (mio:close $owner (mio:write-body $owner $payload $sync $mode)))))
(= (mio:rename $source $target)
   (case (catch (fs:rename $source $target))
     ((() 1)
      ((fs:failed $kind $op $path $errno $progress $message)
       (ErFailure (mio:errno-class $errno)
         (str:join "" ("[Errno " (repr $errno) "] " $message ": "
           (mio:path-quote $source) " -> " (mio:path-quote $target)))
         (fs:failed $kind $op $path $errno $progress $message)))
      ($other (ErFailure NativeEvaluationError "missing native rename outcome" $other)))))
(= (mio:publish $temporary $path $payload $creation $sync $mode $exclusive)
   (let $written (mio:write $temporary $payload
     (if $exclusive ("create" "exclusive") ("create" "truncate")) $creation $sync $mode)
     (if (== $written 1) (mio:rename $temporary $path) $written)))
(= (mio:save $path $temporary $payload $sync $mode)
   (let $parent (mio:parent $path)
     (if (== $parent ()) (mio:publish $temporary $path $payload 438 $sync $mode False) $parent)))
; Engine/recycle have a distinct protocol: close FIRST, chmod by path, rename.
; Never use this for lifecycle's initial fchmod or loop/fuel's unsynced saves.
(= (mio:path-mode $path $mode)
   (if (mio:nul? $path) (erv:fail ValueError "embedded null byte")
     (let $result (mio:once (collapse (catch (fs:set-mode $path $mode))))
       (if (== $result fs:mode-set) 1 $result))))
(= (mio:engine-finish $temporary $path $closed)
   (if (== $closed 1)
     (let $mode (mio:path-mode $temporary 384)
       (if (== $mode 1) (mio:rename $temporary $path) $mode)) $closed))
(= (mio:save-engine $path $temporary $payload)
   (let $parent (mio:parent $path)
     (if (== $parent ())
       (mio:engine-finish $temporary $path
         (mio:write $temporary $payload ("create" "truncate") 438 True ())) $parent)))
(= (mio:save-json $path $data $label)
   (let $result (mio:save $path (str:concat $path ".tmp")
     (str:concat (json:stringify-python-with $data ((ensure-ascii False) (indent 2))) "\n") False ())
     (if (== $result 1) True
       (if (mio:os-error? $result)
         (let (ErFailure $_ $message $_) $result
           (let $_ (system:write stdout (str:join "" ("[" $label "-mode] save failed: " $message "\n"))) False))
         (mv:raise $result)))))
(= (mio:decode-error $start $end $byte $reason)
   (ErFailure UnicodeDecodeError
     (str:join "" ("'utf-8' codec can't decode "
       (if (== $end (+ $start 1))
         (str:join "" ("byte 0x" (erv:hex $byte 2) " in position " (repr $start)))
         (str:join "" ("bytes in position " (repr $start) "-" (repr (- $end 1)))))
       ": " (str:join " " (str:split "-" (str:symbol->string $reason)))))
     (StrUtf8ErrorV1 $start $end $byte $reason)))
(= (mio:strict $text)
   (case (str:utf8-error $text)
     ((StrUtf8WellFormedV1 (mode-text:universal $text))
      ((StrUtf8ErrorV1 $start $end $byte $reason)
       (mio:decode-error $start $end $byte $reason))
      ($other (ErFailure NativeEvaluationError "missing UTF-8 validation outcome" $other)))))
(= (mio:read $path)
   (if (mio:nul? $path) (erv:fail ValueError "embedded null byte")
    (case (fs:read-text-result $path 0 "raw")
     ((("ok" $text) (mio:strict $text))
      (("missing" $cwd) (ErFailure FileNotFoundError "cannot read state file" (ReadFailure $path $cwd)))
      (("directory" $_) (ErFailure IsADirectoryError "cannot read state directory" $path))
      (("denied" $_) (ErFailure PermissionError "cannot read state file" $path))
      (("error" $class $detail) (ErFailure (mio:class $class) $detail $path))
      ($other (ErFailure NativeEvaluationError "missing state-file read outcome" $other))))))
(= (mio:parse $text)
   (case (json:parse-python $text)
     (((JsonPythonErrorV1 $class $message $msg $pos $line $col) (ErFailure (mio:class $class) $message (JsonPosition $pos $line $col)))
      ((JsonPythonErrorV1 $class $message) (erv:fail (mio:class $class) $message))
      ((Error $where $why) (ErFailure NativeEvaluationError "native JSON evaluation failed" (Error $where $why)))
      ($value $value))))
(= (mio:class $name) (if (== (get-type $name) String) (str:string->symbol $name) $name))
(= (mio:defaultable? $value)
   (or (mio:os-error? $value)
     (case $value
       (((ErFailure $class $_ $_)
         (mv:contains (TypeError ValueError JSONDecodeError UnicodeDecodeError UnicodeEncodeError UnicodeTranslateError) $class))
        ($other False)))))
(= (mio:load-object $path)
   (let $text (mio:read $path)
     (if (mv:failed? $text)
       (if (mio:defaultable? $text) (JsonObject ()) $text)
       (case (mio:parse $text)
         (((JsonObject $pairs) (JsonObject $pairs))
          ((ErFailure $class $message $detail)
           (let $failure (ErFailure $class $message $detail)
             (if (mio:defaultable? $failure) (JsonObject ()) $failure)))
          ($other (JsonObject ())))))))

; TextIOWrapper.readline uses an 8192-byte read/decode buffer. In particular,
; malformed bytes AFTER an early newline in that buffer still raise, whereas
; an incomplete UTF-8 tail is allowed to remain pending when a line is ready.
; A terminal CR is held until another decoded character or EOF resolves it.
(= (mio:line-ready? $text)
   (if (!= (str:find $text "\n") (TextNotFound "\n")) True
     (let $cr (str:find $text "\r")
       (if (== (get-type $cr) Number) (< $cr (- (str:byte-length $text) 1)) False))))
(= (mio:line-value $text $eof)
   (let* (($universal (mode-text:universal $text)) ($parts (str:split "\n" $universal)))
     (if (> (size-atom $parts) 1) (ModeLine (str:concat (car-atom $parts) "\n"))
       (if $eof (ModeLine $universal) ModeNeedChunk))))
(= (mio:decoded-part $bytes $eof)
   (case (str:utf8-error $bytes)
     ((StrUtf8WellFormedV1 (ModeDecoded $bytes ""))
      ((StrUtf8ErrorV1 $start $end $byte unexpected-end-of-data)
       (if $eof (mio:decode-error $start $end $byte unexpected-end-of-data)
         (ModeDecoded (str:byte-slice $bytes 0 $start) (str:byte-slice $bytes $start (str:byte-length $bytes)))))
      ((StrUtf8ErrorV1 $start $end $byte $reason)
       (mio:decode-error $start $end $byte $reason))
      ($other (ErFailure NativeEvaluationError "missing UTF-8 validation outcome" $other)))))
; Only undecoded tail bytes carry into the next decoder call. Already decoded
; text must NOT shift a later UnicodeDecodeError's buffer-relative positions.
(= (mio:finish-text $text $first-line)
   (if $first-line (let (ModeLine $line) (mio:line-value $text True) $line)
     (mode-text:universal $text)))
(= (mio:text-chunks $owner $text $pending $first-line)
   (case (mio:once (collapse (catch (fs:read-chunk $owner 8192))))
     (((fs:chunk $chunk $offset)
       (case (mio:decoded-part (str:concat $pending $chunk) False)
         (((ModeDecoded $prefix $tail)
           (let $joined (str:concat $text $prefix)
             (if (and $first-line (mio:line-ready? $joined)) (mio:finish-text $joined True)
               (mio:text-chunks $owner $joined $tail $first-line))))
          ($failure $failure))))
      ((fs:end $offset)
       (case (mio:decoded-part $pending True)
         (((ModeDecoded $prefix $_) (mio:finish-text (str:concat $text $prefix) $first-line)) ($failure $failure))))
      ($failure $failure))))
(= (mio:buffered-read $path $first-line)
   (if (mio:nul? $path) (erv:fail ValueError "embedded null byte")
     (let $owner (mio:once (collapse (catch (fs:open-read $path))))
       (case $owner
         (((NativeHandle "file-reader" $_) (mio:close $owner (mio:text-chunks $owner "" "" $first-line)))
          ((ErFailure $_ $_ $_) $owner)
          ($other (ErFailure NativeEvaluationError "missing reader owner" $other)))))))
(= (mio:readline $path) (mio:buffered-read $path True))
(= (mio:read-iterated $path) (mio:buffered-read $path False))
