; Agent-owned text/JSON settings in their existing files. No pin eviction or
; text truncation; context selection never destroys the stored evidence.
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self (library json))

(= (pins:path)
   (system:getenv-or-default "METTACLAW_PINS_PATH"
     (path:join (path:dirname (system:getenv-or-default "METTACLAW_HISTORY_PATH" "memory/history.metta")) "pins.txt")))
(= (pins:read)
   (case (fs:read-text-result (pins:path) 0 "replace")
     ((("ok" $text) (pins:nonempty (str:split "\n" $text)))
      (("missing" $_) ())
      ($other (PinsReadFailure $other)))))
(= (pins:nonempty $lines)
   (if (== $lines ()) ()
     (let $line (car-atom $lines)
       (if (== (str:trim $line) "") (pins:nonempty (cdr-atom $lines))
         (cons-atom $line (pins:nonempty (cdr-atom $lines)))))))
(= (pins:save $lines)
   (fs:update-text (pins:path) "replace"
     (str:concat (str:join "\n" $lines) (if (== $lines ()) "" "\n")) "" ""))
(= (pins:body $line)
   (let $parts (str:split "] " $line)
     (if (== (cdr-atom $parts) ()) $line (str:join "] " (cdr-atom $parts)))))
(= (pins:deduplicate $lines $text)
   (if (== $lines ()) ()
     (if (== (pins:body (car-atom $lines)) $text) (pins:deduplicate (cdr-atom $lines) $text)
       (cons-atom (car-atom $lines) (pins:deduplicate (cdr-atom $lines) $text)))))
(= (pins:append $lines $line)
   (if (== $lines ()) ($line)
     (cons-atom (car-atom $lines) (pins:append (cdr-atom $lines) $line))))
(= (pins:cetta-pin $text)
   (let $line (str:trim (str:join " " (str:split "\n" $text)))
     (if (== $line "") "pin failed: empty text"
       (case (pins:read)
         (((PinsReadFailure $why) (str:concat "pin failed: " (repr $why)))
          ($old
            (let* (($kept (pins:deduplicate $old $line))
                   ($timestamp (system:format-time "%m-%d %H:%M" (system:wall-time) "local"))
                   ($next (pins:append $kept (str:join "" ("[" $timestamp "] " $line)))))
              (case (pins:save $next)
                ((("written" $_ $_ $_ $_)
                  (str:join "" ("pinned " (repr (length $next)) " — survives restarts")))
                 ($error (str:concat "pin failed: " (repr $error))))))))))))
(= (pins:without $lines $fragment)
   (if (== $lines ()) ()
     (case (str:find (str:lower (car-atom $lines)) (str:lower $fragment))
       (((TextNotFound $_)
         (cons-atom (car-atom $lines) (pins:without (cdr-atom $lines) $fragment)))
        ($found (pins:without (cdr-atom $lines) $fragment))))))
(= (pins:cetta-unpin $fragment)
   (let $text (str:trim $fragment)
     (if (== $text "") "unpin failed: give a fragment of the pin to remove"
       (case (pins:read)
         (((PinsReadFailure $why) (str:concat "unpin failed: " (repr $why)))
          ($old
            (let* (($kept (pins:without $old $text))
                   ($removed (- (length $old) (length $kept))))
              (case (pins:save $kept)
                ((("written" $_ $_ $_ $_)
                  (str:join "" ("unpinned " (repr $removed) ", " (repr (length $kept)) " remain")))
                 ($error (str:concat "unpin failed: " (repr $error))))))))))))
(= (pins:cetta-view)
   (case (pins:read)
     (((PinsReadFailure $why) (str:concat "pins unavailable: " (repr $why)))
      ($lines (if (== $lines ()) "(no pins)" (str:join " | " $lines))))))

(= (state:json-file $path $default)
   (if (not (fs:exists $path)) $default
     (case (fs:read-text-result $path 0 "replace")
       ((("ok" $text)
         (let $value (catch (json-parse $text))
           (case $value
             (((JsonObject $_) $value)
              ($other (Error (state:json-file $path) invalid-json-object))))))
        ($other (Error (state:json-file $path) unreadable-state-file))))))
(= (state:json-without $pairs $key)
   (if (== $pairs ()) ()
     (let (JsonPair $name $_) (car-atom $pairs)
       (if (== $key $name) (state:json-without (cdr-atom $pairs) $key)
         (cons-atom (car-atom $pairs) (state:json-without (cdr-atom $pairs) $key))))))
(= (state:json-set $value $key $item)
   (let (JsonObject $pairs) $value
     (let $next (cons-atom (JsonPair $key $item) (state:json-without $pairs $key))
       (JsonObject $next))))
(= (context:path)
   (let $state (system:getenv-or-default "METTACLAW_ENGINE_STATE_PATH"
                  (system:getenv-or-default "METTACLAW_STRATEGY_PATH" "memory/observed-strategy.sqlite3"))
     (path:join (path:dirname $state) "context-policy.json")))
(= (context:default-tokens) 32768)
; The task view defaults to the model's whole window, as Codex keeps its whole
; history until 90% of the window. A token budget is an explicit opt-in mode;
; a policy file holding only task_tokens is such an opt-in.
(= (context:policy)
   (let $budget (system:getenv-or-default "METTACLAW_TASK_CONTEXT_TOKENS" "")
     (state:json-file (context:path)
       (if (== $budget "") (JsonObject ((JsonPair "mode" (JsonString "full"))))
         (JsonObject ((JsonPair "mode" (JsonString "budget")) (JsonPair "task_tokens" (JsonNumber $budget))))))))
(= (context:mode)
   (let $policy (context:policy)
     (case (state:json-field $policy "mode")
       (((JsonString "full") full)
        ((JsonString "budget") budget)
        ($other (case (state:json-field $policy "task_tokens") (((JsonNumber $_) budget) ($none full))))))))
; Changes edit the existing policy, keeping fields this module does not own;
; an unreadable policy file is left as it is.
(= (context:write $next)
   (let $text (json-stringify $next)
     (case (fs:update-text (context:path) "replace" $text "" "")
       ((("written" $_ $_ $_ $_) $text)
        ($error (str:concat "context-policy: " (repr $error)))))))
(= (context:full)
   (let (JsonObject $pairs) (context:policy)
     (context:write (state:json-set (JsonObject (state:json-without $pairs "task_tokens")) "mode" (JsonString "full")))))
(= (context:budget $tokens)
   (let $policy (state:json-set (context:policy) "mode" (JsonString "budget"))
     (context:write (state:json-set $policy "task_tokens" (JsonNumber (repr $tokens))))))
(= (context-policy) (json-stringify (context:policy)))
(= (context-policy $tokens)
   (if (== $tokens "full") (context:full)
     (if (< $tokens 0) "context-policy: token count must be nonnegative"
       (if (== $tokens 0) (context:full) (context:budget $tokens)))))

; This provider uses the same live registration protocol as ECAN.
!(import! &self ./src/settings_registry.metta)
(= (context:setting-read $key)
   (case (json-object-get (context:policy) $key)
     (((JsonNumber $text) (str:string->number $text)) ($other $other))))
(= (context:setting-write $key $value) (context-policy $value))
(= (context:settings-descriptors)
   (let $default (context:default-tokens)
     ((SettingSpec 1 "context" "task_tokens" $default "estimated tokens" Nonnegative "persistent" "Opt-in token budget for the task view. Unset or zero means the model's whole window; older evidence remains recoverable." context:setting-read context:setting-write))))
(SettingsProvider "context" context:settings-descriptors)
