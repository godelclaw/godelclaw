; One native readiness wait. These subscriptions never receive or acknowledge
; channel input; the existing routing and commit paths still do that.
!(import! &self (library io))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self (library str))
!(import! &self (library math))
!(import! &self (library space_service))
!(import! &self ./src/semantic_memory_cetta)

(= (idle:token)
   (let $values (collapse (match &self (idle:cwp-token $token) $token))
     (if (== $values ()) "" (car-atom $values))))
(= (idle:set-token $token)
   (let $old (collapse (match &self (idle:cwp-token $value) $value))
     (progn (idle:forget-tokens $old) (add-atom &self (idle:cwp-token $token)))))
(= (idle:forget-tokens $values)
   (if (== $values ()) ()
     (progn (remove-atom &self (idle:cwp-token (car-atom $values)))
            (idle:forget-tokens (cdr-atom $values)))))

(= (idle:submit $role $request)
   (case (catch (io:submit $request))
     (((io:pending $id) (($role $id)))
      ($error
       (case (io:submit (timer:after (math:ceil (* 1000 (str:string->number (system:getenv-or-default "METTACLAW_IDLE_RETRY_SECONDS" "0.25"))))))
         (((io:pending $id) ((retry $id))) ($other ())))))))
(= (idle:join $left $right)
   (if (== $left ()) $right
     (cons-atom (car-atom $left) (idle:join (cdr-atom $left) $right))))

(= (idle:control-watch $variable $default)
   (let $file (system:getenv-or-default $variable $default)
     (if (== $file "") ()
       (let $parts (path:reverse-atom-expr (path:parts $file))
         (if (== $parts ()) ()
           (idle:submit control (fs:changed (path:dirname $file) ((car-atom $parts)))))))))
(= (idle:controls)
   (idle:join (idle:control-watch "METTACLAW_LIFECYCLE_PATH" "")
     (idle:join (idle:control-watch "METTACLAW_WAKE_REQUEST_PATH" "")
       (idle:join (idle:control-watch "METTACLAW_RECYCLE_REQUEST_PATH" "")
         (idle:join (idle:control-watch "METTACLAW_LOOP_MODE_PATH" "")
                    (idle:control-watch "METTACLAW_ENGINE_STATE_PATH" ""))))))
(= (idle:cwp $milliseconds)
   (let $socket (system:getenv-or-default "METTACLAW_TELEGRAM_SERVICE_SOCKET" "")
   (if (== $socket "") ()
     (if (> (idle:retry-until) (system:wall-time))
       (idle:submit retry (timer:after (math:ceil (* 1000 (- (idle:retry-until) (system:wall-time))))))
     (let $body (format-args "{}" ($milliseconds))
       (idle:submit cwp (cwp:request $socket 5 (idle:token) $body (+ $milliseconds 1000))))))))
(= (idle:retry-until)
   (let $values (collapse (match &self (idle:cwp-retry $time) $time))
     (if (== $values ()) 0 (car-atom $values))))
(= (idle:backoff)
   (let* (($old (collapse (match &self (idle:cwp-retry $time) (idle:cwp-retry $time))))
          ($seconds (str:string->number (system:getenv-or-default "METTACLAW_IDLE_RETRY_SECONDS" "0.25"))))
     (progn (idle:remove $old)
            (add-atom &self (idle:cwp-retry (+ (system:wall-time) $seconds))))))
(= (idle:remove $values)
   (if (== $values ()) ()
     (progn (remove-atom &self (car-atom $values)) (idle:remove (cdr-atom $values)))))
(= (idle:interval $deadline)
   (let $heartbeat (str:string->number (system:getenv-or-default "METTACLAW_IDLE_HEARTBEAT_SECONDS" "5"))
     (math:ceil (* 1000 (max 0 (min $heartbeat (- $deadline (system:wall-time))))))))
(= (idle:mail $milliseconds $enabled)
   (if (and $enabled (mail:enabled?))
     (idle:mail-request $milliseconds) ()))
(= (idle:mail-request $milliseconds)
   (case (mailbox:open (mail:socket) (mail:space))
       (((space $uuid $id $_ $_ $_ $revision $_)
         (let $request-id (space:request-id)
           (idle:submit mail (space:request (mail:socket)
             (request $request-id watch $uuid $id $revision $milliseconds)
             (+ $milliseconds 1000)))))
        ($other ()))))
(= (idle:arm $milliseconds $enabled)
   (idle:join (if $enabled (semantic:retry-wait) ())
   (idle:join (idle:submit notice (host:notice))
     (idle:join (idle:controls)
       (idle:join (idle:cwp $milliseconds) (idle:mail $milliseconds $enabled))))))
(= (idle:ids $subscriptions)
   (if (== $subscriptions ()) ()
     (let ($_ $id) (car-atom $subscriptions)
       (cons-atom $id (idle:ids (cdr-atom $subscriptions))))))
(= (idle:job-ids)
   (collapse (match &self (job:live $_ $handle) $handle)))
(= (idle:wait $subscriptions $milliseconds $enabled)
   (let $ids (idle:join (idle:ids $subscriptions)
                (if $enabled (idle:join (idle:job-ids) (semantic:io-ids)) ()))
     (io:wait-ready (cons-atom io:ids $ids) $milliseconds)))
(= (idle:finish $subscriptions)
   (if (== $subscriptions ()) ()
     (let ($role $id) (car-atom $subscriptions)
       (progn
         (idle:finish-item $role $id)
         (idle:finish (cdr-atom $subscriptions))))))
(= (idle:finish-item $role $id)
   (case (io:poll $id)
           (((io:event $_ (cwp:reply $code $token $_))
             (if (or (== $code 64) (== $code 67)) (idle:set-token $token)
               (progn (idle:set-token "") (idle:backoff))))
            ((io:event $_ (cwp:unavailable $_)) (progn (idle:set-token "") (idle:backoff)))
            ((io:idle) (catch (io:cancel $id)))
            ($other ()))))
