; The hierarchy has no new Python or SWI implementation.
(= (hierarchy:begin $turn $source $projection) True)
(= (hierarchy:record $turn $source $message $response $results) True)
(= (hierarchy:context) "")
(= (memory-open $id) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-open $id $depth) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-node $id $kind $title $body) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-node $id $kind $title $body $children) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-node $id $kind $title $body $children $sources) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-link $parent $child) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-summary $id $text) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-find $phrase) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-find $phrase $root) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-original $id $revision) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-focus $id) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-focus $id $depth) "HIERARCHY_UNAVAILABLE: select CeTTa")
(= (memory-window $characters) "HIERARCHY_UNAVAILABLE: select CeTTa")
