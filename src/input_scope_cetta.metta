; The delivery identities actually presented by the current receive operation.
; Ordinary scope data does not acknowledge a transport or complete a task.
!(import! &self (library json))
!(import! &self (library str))
!(import! &self ./ledger_client.metta)
(: InputSettlementUnavailableV1 (-> Atom %Undefined%))
(: input-scope:forget (-> %Undefined% %Undefined%))
(: input-scope:prepare (-> %Undefined% %Undefined%))
(: input-scope:tag-ids (-> %Undefined% %Undefined%))
(: input-scope:prepare-json (-> %Undefined% %Undefined%))
(: input-scope:decode-ids (-> %Undefined% %Undefined%))
(: input-scope:all-settled (-> %Undefined% %Undefined%))
(: input-scope:remaining-settled (-> %Undefined% %Undefined%))
(: input-scope:acknowledgeable (-> %Undefined% %Undefined%))
(: input-scope:settled (-> %Undefined% %Undefined%))

(= (input-scope:forget $rows)
   (if (== $rows ()) True
     (let* (($row (car-atom $rows)) ($_ (collapse (remove-atom &self $row))))
       (input-scope:forget (cdr-atom $rows)))))
(= (input-scope:reset)
   (let* (($forgotten (input-scope:forget (collapse (match &self (input-scope:current $ids) (input-scope:current $ids)))))
          ($added (collapse (add-atom &self (input-scope:current ()))))) True))
(= (input-scope:known?) (not (== (collapse (match &self (input-scope:current $ids) $ids)) ())))
(= (input-scope:prepare $ids)
   (let* (($reset (input-scope:reset)) ($removed (collapse (remove-atom &self (input-scope:current ()))))
          ($added (collapse (add-atom &self (input-scope:current $ids))))) True))
(= (input-scope:ids)
   (case (collapse (match &self (input-scope:current $ids) $ids))
     ((() ()) (($ids) $ids) ($other (Error input-scope multiple-captures)))))
(= (input-scope:tag-ids $ids)
   (if (== $ids ()) ()
     (let* (($id (car-atom $ids)) ($head (JsonString $id))
            ($tail (input-scope:tag-ids (cdr-atom $ids)))) (cons-atom $head $tail))))
(= (input-scope:json)
   (let* (($items (input-scope:tag-ids (input-scope:ids))) ($value (JsonArray $items)))
     (json:stringify-python-with $value ((ensure-ascii False)))))
(= (input-scope:prepare-json $text)
   (case (json:parse $text)
     (((JsonArray $ids)
       (case (input-scope:decode-ids $ids)
         (((InputScopeIdsV1 $plain) (input-scope:prepare $plain))
          ($bad (Error input-scope invalid-delivery-identities)))))
      ($bad (Error input-scope invalid-delivery-identities)))))
(= (input-scope:decode-ids $items)
   (if (== $items ()) (InputScopeIdsV1 ())
     (let $id (car-atom $items)
       (if (not (== (get-type $id) String)) InputScopeRefusedV1
         (if (== $id "") InputScopeRefusedV1
           (case (input-scope:decode-ids (cdr-atom $items))
             (((InputScopeIdsV1 $rest)
               (let $plain (cons-atom $id $rest) (InputScopeIdsV1 $plain)))
              ($bad InputScopeRefusedV1))))))))
; Only an established ledger answer can authorize skipping a delivery.
(= (input-scope:all-settled $ids)
   (if (== $ids ()) False (input-scope:remaining-settled $ids)))
(= (input-scope:remaining-settled $ids)
   (if (== $ids ()) True
     (let $id (car-atom $ids)
       (case (input-scope:settled $id)
         ((True (input-scope:remaining-settled (cdr-atom $ids))) ($other False))))))
(= (input-scope:acknowledgeable $id)
   (if (not (== (system:getenv-or-default "METTACLAW_OBSERVED_STRATEGY" "0") "1")) True
     (case (input-scope:settled $id) ((True True) ($other False)))))
(= (input-scope:settled $id)
   (if (not (== (system:getenv-or-default "METTACLAW_OBSERVED_STRATEGY" "0") "1")) False
     (let $socket (system:getenv-or-default "METTACLAW_INPUT_LEDGER_SOCKET" "")
       (if (== $socket "") (InputSettlementUnavailableV1 missing-ledger)
         (case (catch (ledger-client:call $socket "committed" (($id))))
           ((True True) (true True) (False False) (false False)
            ($fault (InputSettlementUnavailableV1 $fault))))))))
