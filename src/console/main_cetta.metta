!(import! &self ./editor_cetta.metta)
(= (cc:initialize $settings)
   (let* (($_ (cc:projection-reset))
          ($_ (cc:editor-reset))
          ($_ (cc:render-reset))
          ($_ (cc:set "settings" $settings)) ($_ (cc:set "editor" (buffer:new 33554432 text)))
          ($_ (cc:set "events" (buffer:new 8388608 bytes))) ($_ (cc:set "output" (buffer:new 16777216 bytes)))
          ($_ (cc:set "input" (buffer:new 2097152 bytes)))
          ($_ (cc:set "color" (and (== (system:getenv-or-default "NO_COLOR" "") "")
                                    (!= (system:getenv-or-default "TERM" "") "dumb"))))
          ($_ (cc:set "clock-live" False))
          ($_ (cc:set "dirty" True)) ($_ (cc:set "activity" "waiting"))
          ($_ (cc:set "stop" False))) True))
(= (cc:update-pending) (cc:set "pending-count" (size-atom (cm:pending (cc:settings)))))
(= (cc:archive-all)
   (let $root (path:join (cc:client) "received")
     (cc:set "archive-work" (if (fs:exists $root)
       (sort-strings (filter-atom (fs:entries $root) $name (str:ends-with $name ".json"))) ()))))
(= (cc:archive-step)
   (let $work (cc:get "archive-work" ())
     (if (== $work ()) True
       (let* (($name (car-atom $work)) ($_ (cc:set "archive-work" (cdr-atom $work))))
         (cc:show-stored-reply (let ($received $nsec $path) (cc:reply-dated (path:join (cc:client) "received") $name)
                                 ($received $path)))))))
; What the earlier console showed on attach: who is attached, inputs still
; awaiting confirmed acceptance, the three newest stored replies (archived
; material is shown, never acknowledged or retried again), and the agent's
; current activity.
(= (cc:attach-preview)
   (let* (($_ (cc:note (str:join "" ("Attached to " (cc:label) ". /help lists commands; Ctrl-D detaches and cognition keeps running."))))
          ($pending (cc:get "pending-count" 0))
          ($_ (if (> $pending 0)
                (cc:note (str:join "" ((repr $pending) " inputs await confirmed acceptance; /retry reuses their IDs."))) True))
          ($recent (cc:recent-replies 3))
          ($_ (if (== $recent ()) True
                (let $_ (cc:note "Recent stored replies; /replies shows the complete local archive.")
                  (map-atom $recent $entry (cc:show-stored-reply $entry)))))
          ($_ (cc:command "/activity"))) True))
(= (cc:recent-replies $count)
   (let $root (path:join (cc:client) "received")
     (if (not (fs:exists $root)) ()
       (let* (($names (filter-atom (fs:entries $root) $name (str:ends-with $name ".json")))
              ($dated (sort-atom (map-atom $names $name (cc:reply-dated $root $name))))
              ($newest (list:drop (max 0 (- (size-atom $dated) $count)) $dated)))
         (map-atom $newest $row (let ($sec $nsec $path) $row ($sec $path)))))))
(= (cc:reply-dated $root $name)
   (let $path (path:join $root $name)
     (case (fs:metadata $path follow-observed)
       (((fs:info-v2 $_ $_ $_ (fs:modified $sec $nsec) $_ $_ $_) ($sec $nsec $path))
        ($other (0 0 $path))))))
(= (cc:show-stored-reply ($received $path))
   (let* (($record (sf:native-object $path)) ($txt (sf:get $record "text" ""))
          ($extra (if (> (str:byte-length $txt) 131072) (str:concat "[complete reply: " (str:concat $path "]")) "")))
     (cc:emit-reply-at (cc:reply-sender (sf:get $record "from" "")) $txt $extra $received)))
; The agent's own replies carry its display label, others their sender.
(= (cc:reply-sender $from)
   (if (or (== $from "") (== $from (sf:get (cc:settings) "agent" ""))) (cc:label) $from))
(= (cc:rpc-idle? $kind)
   (case (cc:get (cc:rpc-key $kind) ConsoleNoWorkerV1)
     (((ConsoleRpcV1 $_ $_ ConsoleNoRequestV1 () $_) True) ($busy False))))
(= (cc:background $now)
   (let* (($_ (cc:pump-worker "control")) ($_ (cc:pump-worker "mail"))
          ($_ (if (and (>= $now (cc:get "next-status" 0)) (cc:rpc-idle? "control"))
                (progn (cc:control "status" ((JsonPair "background" True)))
                       (cc:set "next-status" (+ $now 5000000000))) True))
          ($_ (if (and (>= $now (cc:get "next-mail" 0)) (cc:rpc-idle? "mail"))
                (progn (cc:mail-request "receive" ()) (cc:set "next-mail" (+ $now 500000000))) True))
          ((HostBufferInfo $queued $_) (buffer:info (cc:get "events" ConsoleNoBufferV1)))
          ($_ (if (< $queued 1048576) (progn (cc:streams-step) (cc:archive-step)) True))
          ($_ (if (and (cc:get "draft-dirty" False) (>= $now (cc:get "next-draft" 0)))
                (progn (cc:save-draft) (cc:set "next-draft" (+ $now 500000000))) True))) True))
(= (cc:interactive-tick $terminal $signals)
   ; Only the explicit editor/projection state crosses an event boundary.
   (once
    (let* (($now (system:monotonic-ns))
          ($_ (cc:background $now))
          ($_ (cc:check-resize $terminal $now))
          ($_ (case (host:read $terminal 65536)
             (((HostBytes $bytes) (progn (buffer:append (cc:get "input" ConsoleNoBufferV1) $bytes)
                                       (cc:set "last-input" $now)))
              (HostPending True)
              ($end (cc:set "stop" True)))))
          ($_ (cc:keys (cc:get "input" ConsoleNoBufferV1)
               (if (> (- $now (cc:get "last-input" 0)) 50000000) flush wait) 64))
          ($_ (cc:cpr-check-timeout $now))
          ($_ (cc:publish $terminal $now))
          ($stop (or (cc:get "stop" False) (!= (host:signal $signals) 0))))
     (if $stop True
       (let* (($watch (cc:get "stream-watch" ConsoleNoWatchV1))
              ((HostBufferInfo $output-size $_) (buffer:info (cc:get "output" ConsoleNoBufferV1)))
              ($base (if (cc:buffer-failed? $watch) (($terminal read) ($terminal resize))
                             (($terminal read) ($terminal resize) ($watch read))))
              ($interests (if (> $output-size (cc:get "output-offset" 0)) (cons-atom ($terminal write) $base) $base))
              ($ready (host:wait $interests 25))
              ($_ (case $ready (((HostReady $events)
                    (if (cli:member? ($terminal resize) $events)
                      (let (HostSize $cols $height) (terminal:size $terminal)
                        (cc:note-resize $cols $height (system:monotonic-ns)))
                      True)) ($failed True)))))
         False)))))
(= (cc:interactive-loop $terminal $signals)
   (if (cc:interactive-tick $terminal $signals) True (cc:interactive-loop $terminal $signals)))
(= (cc:write-final $terminal $text $offset $until)
   (if (or (>= $offset (str:byte-length $text)) (>= (system:monotonic-ns) $until)) True
     (case (host:write $terminal $text $offset)
       (((HostWritten $count) (cc:write-final $terminal $text (+ $offset $count) $until))
        (HostPending (progn (host:wait (($terminal write)) 10) (cc:write-final $terminal $text $offset $until)))
        ($failed False)))))
(= (cc:drain-paint $terminal $until)
   (let* (($owner (cc:get "output" ConsoleNoBufferV1)) ((HostBufferInfo $size $_) (buffer:info $owner))
          ($offset (cc:get "output-offset" 0)))
     (if (or (>= $offset $size) (>= (system:monotonic-ns) $until)) True
       (progn (cc:publish $terminal (system:monotonic-ns)) (host:wait (($terminal write)) 5) (cc:drain-paint $terminal $until)))))
(= (cc:interactive-held $terminal $signals $lock)
   (let* (($_ (cc:set "clock-live" True))
          ($_ (terminal:raw $terminal on))
          ($t0 (system:monotonic-ns))
          ($_ (cc:cpr-begin-attach $terminal $t0))
          ($_ (cc:write-final $terminal (str:concat "\u001b[?2004h" (terminal:cpr-request)) 0 (+ $t0 100000000)))
          ($_ (cc:history-load)) ($_ (cc:restore-draft)) ($_ (cc:update-pending))
          ($_ (cc:stream-prime)) ($_ (cc:spawn-worker "control")) ($_ (cc:spawn-worker "mail"))
          ($_ (cc:attach-preview))
          ($answers (collapse (catch (cc:interactive-loop $terminal $signals))))
          ($_ (cc:save-draft)) ($_ (cc:drain-paint $terminal (+ (system:monotonic-ns) 200000000)))
          ($end (cc:detach-sequence $terminal))
          ($_ (cc:write-final $terminal $end 0 (+ (system:monotonic-ns) 200000000)))
          ($_ (host:close $terminal)) ($_ (host:close $signals))
          ($_ (cc:close-worker "control")) ($_ (cc:close-worker "mail"))
          ($_ (fs:unlock $lock)) ($_ (fs:close $lock)))
     (if (== $answers (True)) 0 1)))
(= (cc:interactive)
   (let* (($path (path:join (cc:client) "native-editor.lock"))
          ($lock (fs:open-write $path ("create" "append") 384)) ($held (fs:lock $lock exclusive-nowait)))
     (if (or (sf:failed? $lock) (sf:failed? $held))
       (progn (fs:close $lock) (system:write stderr "This client state already has an attached native editor.\n") 1)
       (let* (($signals (host:signals)) ($terminal (terminal:open "/dev/tty")))
         (if (or (cc:buffer-failed? $terminal) (cc:buffer-failed? $signals))
           (progn (fs:unlock $lock) (fs:close $lock) (host:close $signals)
             (system:write stderr "A terminal is required; use --submit, --command or --status for noninteractive calls.\n") 1)
           (cc:interactive-held $terminal $signals $lock))))))
(= (cc:oneshot-wait $until)
   (if (cc:get "oneshot-done" False) 0
     (if (>= (system:monotonic-ns) $until)
       (progn (system:write stderr "Control reply unconfirmed; inspect current state before retrying effects.\n") 1)
       (progn (cc:pump-worker "control") (host:wait () 10) (cc:oneshot-wait $until)))))
(= (cc:oneshot-control $status $command)
   (let* (($_ (cc:set "oneshot" True)) ($_ (cc:spawn-worker "control"))
          ($_ (if $status (cc:control "status" ())
               (let ($name $arguments) (cc:split-command $command)
                 (cc:control "command" ((JsonPair "name" $name) (JsonPair "arguments" $arguments))))))
          ($result (cc:oneshot-wait (+ (system:monotonic-ns) 12000000000)))
          ($_ (cc:close-worker "control"))) $result))
(= (cc:read-all $owner $buffer)
   (case (host:read $owner 65536)
     (((HostBytes $bytes) (progn (buffer:append $buffer $bytes) (cc:read-all $owner $buffer)))
      (HostPending (progn (host:wait (($owner read)) 100) (cc:read-all $owner $buffer)))
      (HostEOF (buffer:value $buffer))
      ($failed (ConsoleFailureV1 "stdin is unavailable")))))
(= (cc:submit-once $options)
   (let* (($file (sf:get $options "--submit-file" "")) ($argument (sf:get $options "--submit" ""))
          ($text (if (!= $file "") (fs:read-text (cc:absolute $file))
                   (if (== $argument "-")
                     (let* (($stdin (host:stdio 0)) ($buffer (buffer:new 268435456 bytes))
                            ($read (cc:read-all $stdin $buffer)) ($_ (host:close $stdin)) ($_ (host:close $buffer))) $read)
                     $argument)))
          ($record (cm:prepare (cc:settings) $text))
          ($result (case $record (((ConsoleFailureV1 $_) $record) ($ok (cm:publish (cc:settings) $record))))))
     (case $result
       (((ConsoleFailureV1 $why) (progn (system:write stderr (str:concat $why "\n")) 1))
        ($ok (progn (system:write stdout (str:concat (json:stringify-python $ok) "\n")) 0))))))
(= (cc:main $args)
   (let $options (cc:option-args $args)
     (case $options
      (((CliFailureV1 $why) (progn (system:write stderr (str:concat $why "\n")) 78))
       ($valid (cc:main-options $valid))))))
(= (cc:main-options $options)
     (if (or (sf:get $options "--help" False) (sf:get $options "--check-console-imports" False))
       (progn (system:write stdout (if (sf:get $options "--check-console-imports" False) "console imports OK\n" (str:concat (cc:help) "\n"))) 0)
       (case (cc:configuration $options)
         (((ConsoleFailureV1 $why) (progn (system:write stderr (str:concat $why "\n")) 78))
          ($settings
           (let $_ (cc:initialize $settings)
             (if (or (!= (sf:get $options "--submit" ConsoleNoSubmitV1) ConsoleNoSubmitV1)
                     (!= (sf:get $options "--submit-file" "") ""))
               (cc:submit-once $options)
               (if (or (sf:get $options "--status" False) (!= (sf:get $options "--command" "") ""))
                 (cc:oneshot-control (sf:get $options "--status" False) (sf:get $options "--command" ""))
                 (if (sf:get $options "--json" False)
                   (progn (system:write stderr "--json requires a noninteractive operation\n") 78)
                   (cc:interactive))))))))))
