; One offset/framer per changed producer file. Directory notifications avoid
; scanning complete histories while the operator edits. Overflow rescans the
; retained coordinates; source logs remain the authority for display data.
!(import! &self ./presentation_cetta.metta)
!(bind! &cc-files (new-space))
(= (cc:file-state $name)
   (case (collapse (match &cc-files (ConsoleFileV1 $name $value) $value)) ((($one) $one) ($none ConsoleNoFileV1))))
(= (cc:file-set $name $value)
   (let $_ (collapse (match &cc-files (ConsoleFileV1 $name $old) (remove-atom &cc-files (ConsoleFileV1 $name $old))))
     (add-atom &cc-files (ConsoleFileV1 $name $value))))
(= (cc:stream-directory) (sf:get (cc:settings) "display" ""))
(= (cc:stream-names)
   (filter-atom (fs:entries (cc:stream-directory)) $name (str:ends-with $name ".jsonl")))
(= (cc:stream-control)
   (let* (($path (path:join (cc:stream-directory) "control.json")) ($control (sf:native-object $path))
          ($epoch (sf:get $control "epoch" "initial")) ($enabled (sf:get $control "enabled" True)))
     (progn (if (!= $epoch (cc:get "stream-epoch" "initial")) (cc:projection-reset) True)
       (cc:set "stream-epoch" $epoch) (cc:set "stream-enabled" $enabled))))
(= (cc:stream-prime)
   (let* (($_ (fs:make-directories (cc:stream-directory) 448))
          ($watch (host:watch (cc:stream-directory))) ($_ (cc:set "stream-watch" $watch))
          ($_ (cc:stream-control)) ($names (cc:stream-names))
          ($ranked (list:sort-by cc:newer-ranked (map-atom $names $name
                    (let $modified (cc:modified (fs:metadata-v2 (path:join (cc:stream-directory) $name) no-follow)) ($modified $name)))))
          ($recent (map-atom (list:take 8 $ranked) $entry (let ($_ $name) $entry $name))))
     (cc:prime-files $names $recent)))
(= (cc:newer-ranked ($at $a) ($bt $b)) (>= $at $bt))
(= (cc:modified $info)
   (case $info (((fs:info-v2 $_ $_ $_ (fs:modified $sec $ns) $_ $_ $_) (+ (* $sec 1000000000) $ns)) ($bad 0))))
(= (cc:prime-files $names $recent)
   (if (== $names ()) True
     (let* (($name (car-atom $names))
            ($_ (if (cli:member? $name $recent) (cc:read-stream $name True 4)
                  (case (fs:metadata-v2 (path:join (cc:stream-directory) $name) no-follow)
                    (((fs:info-v2 regular $size $identity $_ $_ $_ $_)
                      (cc:file-set $name (ConsoleFileCursorV1 $identity $size (buffer:new 33554432 bytes) 0)))
                     ($bad True))))))
       (cc:prime-files (cdr-atom $names) $recent))))
(= (cc:read-stream $name $prime $left)
   (if (or (not (str:ends-with $name ".jsonl")) (<= $left 0)) True
     (let $path (path:join (cc:stream-directory) $name)
       (case (fs:metadata-v2 $path no-follow)
         (((fs:info-v2 regular $size $identity $_ $_ $_ $_)
           (let* (($prior (cc:file-state $name))
                  ($state (case $prior
                    (((ConsoleFileCursorV1 $id $offset $buffer $primed)
                      (if (and (== $id $identity) (>= $size $offset)) $prior
                        (progn (host:close $buffer) (ConsoleFileCursorV1 $identity 0 (buffer:new 33554432 bytes) 0))))
                     ($new (ConsoleFileCursorV1 $identity (if $prime (max 0 (- $size 1048576)) 0)
                               (buffer:new 33554432 bytes) (if $prime $size 0))))))
                  ((ConsoleFileCursorV1 $_ $at $input $prime-end) $state)
                  ($_ (cc:stream-lines $input (or $prime (<= $at $prime-end)) 64)))
             (if (>= $at $size)
               (progn (cc:file-set $name $state)
                 (if (buffer:line-ready? $input) (cc:queue-stream $name) True))
               (let* (($file (fs:open-read $path)) ($chunk (fs:read-chunk $file (min 262144 (- $size $at)) $at))
                      ($_ (fs:close $file)))
                 (case $chunk
                   (((fs:chunk $bytes $start)
                     (let* (($next (+ $at (str:byte-length $bytes))) ($added (buffer:append $input $bytes))
                            ($_ (if (cc:buffer-failed? $added)
                                  (cc:note (str:concat "Display frame is too large; original log: " $path))
                                  (cc:stream-lines $input (or $prime (<= $next $prime-end)) 64)))
                            ($_ (cc:file-set $name (ConsoleFileCursorV1 $identity $next $input $prime-end))))
                       (if (or (< $next $size) (buffer:line-ready? $input)) (progn (cc:queue-stream $name) True) True)))
                    ($bad (cc:note "Display file is unavailable; its offset was retained."))))))))
          ($bad True))))))
(= (cc:stream-lines $input $prime $left)
   (let (HostBufferInfo $queued $_) (buffer:info (cc:get "events" ConsoleNoBufferV1))
    (if (or (<= $left 0) (>= $queued 1048576)) True
     (case (buffer:line $input)
       (((HostLine $line)
         (let $event (json:parse-python $line)
           (progn (case $event (((JsonObject $_)
                    (if (cc:get "viewer-json" False)
                      (system:write stdout (str:concat (json:stringify-python-with $event ((ensure-ascii False))) "\n"))
                      (cc:event $event $prime))) ($bad True)))
                  (cc:stream-lines $input $prime (- $left 1)))))
        ($pending True))))))
(= (cc:queue-stream $name)
   (let $queue (cc:get "stream-work" ())
     (if (cli:member? $name $queue) True (cc:set "stream-work" (list:append $queue ($name))))))
(= (cc:streams-step)
   (let* (($watch (cc:get "stream-watch" ConsoleNoWatchV1))
          ($changes (host:changes $watch))
          ($_ (case $changes
            (((HostChanges $names $overflow)
              (progn (if $overflow (map-atom (cc:stream-names) $name (cc:queue-stream $name)) True)
                (map-atom $names $name
                  (if (== $name "control.json") (cc:stream-control) (cc:queue-stream $name)))))
             ($pending True))))
          ($work (cc:get "stream-work" ())))
     (if (== $work ()) True
       (let* (($name (car-atom $work)) ($_ (cc:set "stream-work" (cdr-atom $work))))
         (if (cc:get "stream-enabled" True) (cc:read-stream $name False 1) True)))))
