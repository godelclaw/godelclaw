; The editor never blocks on service I/O. Owned native clients handle mailbox
; transactions and the existing terminal-control protocol. Closing a client
; affects that client only; cognition and accepted mail retain their owners.
!(import! &self ./mail_cetta.metta)
!(import! &self (library host_io))
!(import! &self (library proc))
!(bind! &cc-state (new-space))
(= (cc:get $key $fallback)
   (case (collapse (match &cc-state (ConsoleStateV1 $key $value) $value))
     ((($one) $one) ($other $fallback))))
(= (cc:set $key $value)
   (let $_ (collapse (match &cc-state (ConsoleStateV1 $key $old) (remove-atom &cc-state (ConsoleStateV1 $key $old))))
     (add-atom &cc-state (ConsoleStateV1 $key $value))))
(= (cc:settings) (cc:get "settings" (JsonObject ())))
(= (cc:client) (sf:get (cc:settings) "client" ""))
(= (cc:rpc-key $kind) (str:concat "rpc-" $kind))
(= (cc:notice-once $key $text)
   (if (== (cc:get $key "") $text) True (progn (cc:set $key $text) (cc:note $text))))
(= (cc:spawn-worker $kind)
   (let* (($settings (cc:settings)) ($root (sf:get $settings "root" ""))
          ($binary (system:executable))
          ($options-path (path:join (cc:client) "native-session.json"))
          ($_ (cm:store $options-path (JsonObject
             ((JsonPair "client" (sf:get $settings "client" "")) (JsonPair "agent" (sf:get $settings "agent" ""))
              (JsonPair "sender" (sf:get $settings "sender" ""))
              (JsonPair "--mail-script" (sf:get $settings "--mail-script" ""))))))
          ($fixture (system:getenv-or-default "METTACLAW_CONSOLE_CONTROL_ENTRY" ""))
          ($entry (path:join (path:dirname (system:entry-directory)) "scripts/console_mail_cetta.metta"))
          ($argv (if (== $kind "mail")
             ($binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" $entry $options-path)
             (if (!= $fixture "")
               ($binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" $fixture)
               ((path:join $root "run.sh") "terminal-control"))))
          ($overrides (cc:control-environment $settings))
          ($owner (proc:spawn $argv ((cwd $root) (env (inherit $overrides)) (mode stream)
                                   (max-bytes 1048576) (lifetime owner))))
          ($input (buffer:new 16777216 bytes)) ($queue ())
          ($state (ConsoleRpcV1 $owner $input ConsoleNoRequestV1 $queue 0)))
     (cc:set (cc:rpc-key $kind) $state)))
(= (cc:close-worker $kind)
   (case (cc:get (cc:rpc-key $kind) ConsoleNoWorkerV1)
     (((ConsoleRpcV1 $owner $input $_ $_ $_)
       (progn (proc:close-input $owner) (proc:cancel $owner) (proc:close $owner) (host:close $input)
              (cc:set (cc:rpc-key $kind) ConsoleNoWorkerV1)))
      ($none True))))
(= (cc:request $kind $request)
   (case (cc:get (cc:rpc-key $kind) ConsoleNoWorkerV1)
     (((ConsoleRpcV1 $owner $input $pending $queue $until)
       (if (>= (size-atom $queue) 64) (cc:note "Client queue is full; operation was not submitted.")
         (cc:set (cc:rpc-key $kind) (ConsoleRpcV1 $owner $input $pending (list:append $queue ($request)) $until))))
      ($none (cc:note "Client unavailable; inspect state before retrying an operation.")))))
(= (cc:control $kind $fields)
   (let* (($id (system:uuid4-hex)) ($epoch (cc:get "view-epoch" 0))
          ($request (JsonObject (list:append ((JsonPair "id" $id) (JsonPair "kind" $kind) (JsonPair "view_epoch" $epoch)) $fields))))
     (cc:request "control" $request)))
(= (cc:mail-request $operation $fields)
   (let* (($id (system:uuid4-hex)) ($request (JsonObject (list:append
       ((JsonPair "id" $id) (JsonPair "operation" $operation)) $fields)))) (cc:request "mail" $request)))
(= (cc:decode-reply $kind $line)
   (let $text (if (str:starts-with $line "\"") (json:parse $line) $line)
     (if (== $kind "mail") (json:parse-python $text)
       (if (str:starts-with $text "CLAW_CONTROL ")
         (json:parse-python (str:byte-slice $text 13 (str:byte-length $text))) ConsoleNoReplyV1))))
(= (cc:rpc-lines $kind $input $pending $left)
   (if (<= $left 0) $pending
     (case (buffer:line $input)
       (((HostLine $line)
         (let $reply (cc:decode-reply $kind $line)
           (if (and (!= $pending ConsoleNoRequestV1)
                 (== (sf:get $reply "id" JsonNull) (sf:get $pending "id" ConsoleMissingIdentityV1)))
           (progn (cc:set (str:concat "backoff-" $kind) 1)
             (cc:reply $kind $pending $reply) (cc:rpc-lines $kind $input ConsoleNoRequestV1 (- $left 1)))
             (cc:rpc-lines $kind $input $pending (- $left 1)))))
        (HostPending $pending)
        ($bad (progn (cc:note "Client reply frame is invalid; operation remains unconfirmed.") $pending))))))
(= (cc:pump-worker $kind)
   (case (cc:get (cc:rpc-key $kind) ConsoleNoWorkerV1)
     (((ConsoleRpcV1 $owner $input $pending $queue $until)
       (let* (($read (proc:read $owner stdout 0))
              ($_ (case $read (((proc:chunk $bytes) (buffer:append $input $bytes)) ($none True))))
              ($next (cc:rpc-lines $kind $input $pending 32))
              ($err (proc:read $owner stderr 0))
              ($_ (case $err (((proc:chunk $bytes) (fs:append-text (path:join (cc:client) (str:concat $kind ".log")) $bytes)) ($none True))))
              ($ended (case $read ((proc:eof True) ((proc:failed $_ $_) True) ($other False))))
              ($timed-out (and (!= $next ConsoleNoRequestV1) (>= (system:monotonic-ns) $until))))
         (if (or $ended $timed-out)
           (let* (($pause (cc:get (str:concat "backoff-" $kind) 1))
                  ($_ (cc:notice-once (str:concat "fault-" $kind)
                    (str:concat $kind " client unavailable; effects may be unknown. Inspect state before retrying.")))
                  ($_ (cc:set (str:concat "restart-" $kind) (+ (system:monotonic-ns) (* $pause 1000000000))))
                  ($_ (cc:set (str:concat "backoff-" $kind) (min 300 (* $pause 2))))
                  ($_ (cc:set (str:concat "backlog-" $kind) $queue))
                  ($_ (cc:close-worker $kind))) True)
           (if (and (== $next ConsoleNoRequestV1) (not (== $queue ())))
             (let* (($request (car-atom $queue)) ($line (str:concat (json:stringify-python $request) "\n"))
                    ($sent (proc:write $owner $line)))
               (case $sent
                 (((proc:queued $_)
                   (cc:set (cc:rpc-key $kind) (ConsoleRpcV1 $owner $input $request (cdr-atom $queue)
                      (+ (system:monotonic-ns) (if (== $kind "mail") 35000000000 10000000000)))))
                  ($blocked (cc:set (cc:rpc-key $kind) (ConsoleRpcV1 $owner $input $next $queue $until))))))
             (cc:set (cc:rpc-key $kind) (ConsoleRpcV1 $owner $input $next $queue $until))))))
      ($none
       (if (< (system:monotonic-ns) (cc:get (str:concat "restart-" $kind) 0)) True
         (let* (($_ (cc:spawn-worker $kind))
                ((ConsoleRpcV1 $owner $input $_ $_ $_) (cc:get (cc:rpc-key $kind) ConsoleNoWorkerV1))
                ($queue (cc:get (str:concat "backlog-" $kind) ())))
           (cc:set (cc:rpc-key $kind) (ConsoleRpcV1 $owner $input ConsoleNoRequestV1 $queue 0))))))))
(= (cc:mail-reply $request $body)
   (let $error (sf:get $body "error" "")
     (if (!= $error "") (cc:notice-once "mail-channel-error" $error)
       (case (sf:get $request "operation" "")
         (("publish" (progn (cc:update-pending) (cc:note (str:concat "accepted · " (sf:get $body "id" "")))))
          ("retry" (progn (cc:update-pending) (cc:note "Retained inputs retried with their original IDs; pending files remain authoritative.")))
          ("receive"
           (if (== (sf:get $body "status" "") "delivery")
             (let $record (sf:native-object (sf:get $body "path" ""))
               (cc:note (str:join "" ((sf:get $record "from" (sf:get (cc:settings) "agent" "agent"))
                 " → " (sf:get $record "text" ""))))) True))
          ($other True))))))
(= (cc:control-reply $request $body)
   (if (== (sf:get $request "kind" "") "status")
     (progn (cc:set "facts" $body) (cc:set "dirty" True)
       (if (sf:get $request "background" False) True (cc:note (json:stringify-python $body))))
     (if (and (== (sf:get $body "kind" "") "menu")
              (!= (sf:get $request "view_epoch" -1) (cc:get "view-epoch" 0)))
       (cc:note "This menu is no longer active.")
       (let* (((JsonArray $rows) (sf:get $body "rows" (JsonArray ())))
              ($buttons (foldl-atom $rows () $out $row
                (case $row (((JsonArray $items) (list:append $out $items)) ($bad $out)))))
              ($_ (cc:set "menu" $buttons)) ($_ (cc:note (sf:get $body "text" ""))))
         (cc:menu-lines $buttons 1)))))
(= (cc:menu-lines $buttons $number)
   (if (== $buttons ()) True
     (let* (((JsonArray ($label $choice)) (car-atom $buttons))
            ($_ (cc:note (str:join "" ((repr $number) ". " $label)))))
       (cc:menu-lines (cdr-atom $buttons) (+ $number 1)))))
(= (cc:reply $kind $request $reply)
   (if (cc:get "oneshot" False)
     (progn (system:write stdout (str:concat (json:stringify-python
       (sf:get $reply "body" $reply)) "\n")) (cc:set "oneshot-done" True))
    (if (!= (sf:get $reply "error" "") "") (cc:note "Control operation incomplete; inspect current state.")
     (if (== $kind "mail") (cc:mail-reply $request (sf:get $reply "body" (JsonObject ())))
       (cc:control-reply $request (sf:get $reply "body" (JsonObject ())))))))
