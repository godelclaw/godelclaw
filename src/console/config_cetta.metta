!(import! &self ../cli_values_cetta.metta)
!(import! &self (library toml))
!(import! &self (library list))
(= (cc:option-args $args)
   (let $parsed (cc:parse-options (cli:strings $args) (JsonObject ()))
     (case $parsed
       (((JsonObject $pairs)
         (if (not (cc:known-options? $pairs)) (CliFailureV1 "unknown console option")
           (if (> (foldl-atom ("--submit" "--submit-file" "--command" "--status") 0 $count $key
                     (+ $count (if (!= (sf:get $parsed $key ConsoleNoOperationV1) ConsoleNoOperationV1) 1 0))) 1)
             (CliFailureV1 "choose one of --submit, --submit-file, --command or --status") $parsed)))
        ($failure $failure)))))
(= (cc:parse-options $args $object)
   (if (== $args ()) $object
     (let* (($word (car-atom $args)) ($parts (str:split "=" $word)) ($flag (car-atom $parts))
            ($rest (cdr-atom $args))
            ($switch (cli:member? $flag ("--json" "--status" "--help" "--check-console-imports"))))
       (if $switch
         (if (> (size-atom $parts) 1) (CliFailureV1 "switch takes no value")
           (cc:parse-options $rest (sf:put $object $flag True)))
         (if (> (size-atom $parts) 1)
           (cc:parse-options $rest (sf:put $object $flag (str:join "=" (cdr-atom $parts))))
           (if (== $rest ()) (CliFailureV1 "option needs a value")
             (if (str:starts-with (car-atom $rest) "--") (CliFailureV1 "option needs a value")
               (cc:parse-options (cdr-atom $rest) (sf:put $object $flag (car-atom $rest))))))))))
(= (cc:known-options? $pairs)
   (if (== $pairs ()) True
     (let (JsonPair $key $_) (car-atom $pairs)
       (and (cli:member? $key ("--agent" "--instances" "--root" "--state" "--client-state" "--mail-script"
               "--dir" "--submit" "--submit-file" "--command" "--status" "--json" "--help" "--check-console-imports"))
            (cc:known-options? (cdr-atom $pairs))))))
(= (cc:instance $items $name)
   (if (== $items ()) (JsonObject ())
     (if (== (sf:get (car-atom $items) "name" "") $name) (car-atom $items) (cc:instance (cdr-atom $items) $name))))
(= (cc:absolute $path)
   (let $expanded (system:expanduser $path)
     (if (path:is-absolute $expanded) $expanded (path:join (system:getcwd) $expanded))))
(= (cc:configuration $options)
   (let* (($agent (sf:get $options "--agent" "godel"))
          ($instances (sf:get $options "--instances" (system:expanduser "~/.config/godelclaw/instances.json")))
          ($plan (sf:native-object $instances)) ((JsonArray $items) (sf:get $plan "instances" (JsonArray ())))
          ($instance (cc:instance $items $agent))
          ($root (sf:get $options "--root" (sf:get $instance "root" "")))
          ($state (sf:get $options "--state" (sf:get $instance "state_dir" "")))
          ($dir (sf:get $options "--dir" (system:expanduser "~/.local/state/godelclaw/display"))))
     (if (or (== $root "") (== $state "")) (ConsoleFailureV1 "choose an instance or --root and --state")
       (let* (($actual-root (fs:canonical-path (cc:absolute $root))) ($actual-state (cc:absolute $state))
              ($client (cc:absolute (sf:get $options "--client-state" (path:join $actual-state "terminal-client"))))
              ($_ (fs:make-directories $client 448))
              ($canonical (fs:canonical-path $client))
              ($sender (str:concat "console-" (str:byte-slice (str:sha256 $canonical) 0 24)))
              ($base (sf:put-all $options ((JsonPair "agent" $agent) (JsonPair "root" $actual-root)
                (JsonPair "state" $actual-state) (JsonPair "client" $canonical) (JsonPair "sender" $sender)
                (JsonPair "display" (cc:absolute $dir)) (JsonPair "instance" $instance)))))
         $base))))
(= (cc:mail-settings $settings)
   (let* (($descriptor (sf:get $settings "--mail-script" ""))
          ($beside (if (== $descriptor "") "" (path:join (path:dirname (path:dirname $descriptor)) "mail.toml")))
          ($default (if (and (!= $beside "") (fs:is-file $beside)) $beside
                      (system:expanduser "~/.config/godelclaw/mail.toml")))
          ($file (system:getenv-or-default "CLAW_MAIL_CONFIG" $default))
          ($config (if (fs:is-file $file) (toml:parse (fs:read-text $file)) (JsonObject ())))
          ($socket (system:getenv-or-default "CETTA_SHARED_MAIL_SOCKET" (sf:get $config "socket" ""))))
     (JsonObject ((JsonPair "socket" $socket) (JsonPair "space" (sf:get $config "space" "agent-mail"))))))
(= (cc:control-environment $settings)
   (let* (($root (sf:get $settings "root" "")) ($state (sf:get $settings "state" ""))
          ($instance (sf:get $settings "instance" (JsonObject ())))
          ($required (sf:get $instance "required_runtime" (JsonObject ())))
          ($fields (sf:put-all $required
       ((JsonPair "CETTA_BIN" (system:executable)) (JsonPair "CETTA_ROOT" (path:dirname (system:executable)))
       (JsonPair "METTACLAW_SKIP_INITIALIZE" "1")
       (JsonPair "METTACLAW_INSTANCE" (sf:basename $state)) (JsonPair "METTACLAW_ENGINE" "cetta") (JsonPair "METTACLAW_ACTIVE_ENGINE" "cetta")
       (JsonPair "METTACLAW_ENGINE_STATE_PATH" (path:join $state "engine"))
       (JsonPair "METTACLAW_MODEL_STATE_PATH" (path:join $root "memory/persistent.metta"))
       (JsonPair "METTACLAW_COGNITIVE_HEALTH_PATH" (path:join $state "cognitive-health.json"))
       (JsonPair "METTACLAW_STRATEGY_PATH" (path:join $state "observed-strategy.sqlite3"))
       (JsonPair "METTACLAW_RECYCLE_REQUEST_PATH" (path:join $state "recycle.requested"))
       (JsonPair "METTACLAW_WAKE_REQUEST_PATH" (path:join $state "wake.requested"))))))
     (case $fields (((JsonObject $pairs) (map-atom $pairs $pair (let (JsonPair $key $value) $pair ($key $value))))))))
