; An observation-only presentation projection. Event payloads and command
; descriptions are untrusted text data: every untrusted string passes through
; terminal:clean before formatting, and only the renderer supplies SGR color
; sequences when color is enabled. Shell commands and full artifact paths are
; printed as logical unfolded lines so terminal selection copies them verbatim.
!(import! &self ./session_cetta.metta)
!(import! &self ../effect_receipt_values_cetta.metta)
!(import! &self (library math))
!(bind! &cc-items (new-space))
!(bind! &cc-seen (new-space))
!(bind! &cc-sessions (new-space))

; -- primitive helpers --------------------------------------------------------
(= (cc:style $code $text)
   (if (and (cc:get "color" False) (and (!= $code "") (!= $text "")))
     (str:join "" ("\u001b[" $code "m" $text "\u001b[0m"))
     $text))
(= (cc:clean $text)
   (terminal:clean (if (== (get-type $text) String) $text (repr (quote $text)))))
(= (cc:rtrim $text)
   (let $n (str:byte-length $text)
     (if (== $n 0) ""
       (let $last (str:byte-slice $text (- $n 1) $n)
         (if (or (== $last " ") (or (== $last "\t") (== $last "\r")))
           (cc:rtrim (str:byte-slice $text 0 (- $n 1)))
           $text)))))
(= (cc:expand-tabs $text)
   (str:join "    " (str:split "\t" $text)))
(= (cc:one-line $text)
   (str:join " " (str:split-whitespace (cc:clean $text))))
(= (cc:str-field $obj $key $fallback)
   (let $v (sf:get $obj $key $fallback)
     (if (== (get-type $v) String) $v $fallback)))
(= (cc:num-field $obj $key $fallback)
   (let $v (sf:get $obj $key $fallback)
     (if (== (get-type $v) Number) $v $fallback)))
(= (cc:has-num? $obj $key)
   (== (get-type (sf:get $obj $key JsonNull)) Number))
(= (cc:part-key $obj)
   (let $v (sf:get $obj "part" JsonNull)
     (if (== $v JsonNull) "" (if (== (get-type $v) String) $v (repr $v)))))
(= (cc:buffer-failed? $value)
   (case $value (((HostFailure $_ $_ $_) True) ($other False))))
(= (cc:contains? $haystack $needle)
   (if (== $needle "") True
     (case (str:find $haystack $needle) (((TextNotFound $_) False) ($pos True)))))
(= (cc:contains-any? $haystack $needles)
   (if (== $needles ()) False
     (if (cc:contains? $haystack (car-atom $needles)) True
       (cc:contains-any? $haystack (cdr-atom $needles)))))
(= (cc:nonempty-list $items)
   (filter-atom $items $x (!= $x "")))
(= (cc:tail-bytes $text $limit)
   (let $n (str:byte-length $text)
     (if (<= $n $limit) $text (str:byte-slice $text (- $n $limit) $n))))
(= (cc:clip $text $width)
   (if (<= $width 0) ""
     (if (<= (terminal:cells $text) $width) $text (terminal:clip $text $width))))
(= (cc:display-width)
   (max 20 (cc:get "display-width" 109)))

; -- low-level output emission ------------------------------------------------
(= (cc:emit-raw $text)
   (if (== $text "") True
     (let* (($queued (cc:get "events" ConsoleNoBufferV1))
            ($bounded (if (and (not (cc:get "viewer-full" False)) (> (str:byte-length $text) 131072))
              (str:concat (str:char-slice $text 0 16000) "\n[display folded; original retained in its source record]\n")
              $text))
            ; A bounded one-shot view counts the blocks emitted here, not glyphs
            ; in rendered text: each emission starts with a record separator,
            ; which is removed from the text itself first.
            ($answer (buffer:append $queued
                       (if (cc:get "viewer-mark-emissions" False)
                         (str:concat "\u001e" (str:join "" (str:split "\u001e" $bounded)))
                         $bounded))))
       (case $answer
         (((HostBuffered $_)
           (progn (cc:set "dirty" True)
                  (cc:set "output-blank"
                    (or (str:ends-with $bounded "\n\n")
                        (and (cc:get "output-blank" True) (== $bounded "\n"))))
                  True))
          ($bad (progn (cc:set "display-fault" "Terminal backpressure; original events remain in their source files.") False)))))))
(= (cc:note $text)
   (let* (($clean (cc:clean $text))
          ($lines (map-atom (str:split "\n" (cc:expand-tabs $clean)) $l (cc:rtrim $l))))
     (cc:emit-raw (str:concat (str:join "\n" $lines) "\n"))))
(= (cc:user-input-lines $rows $first)
   (if (== $rows ()) ()
     (let* (($lead (if $first (cc:style "1;36" "› ") "  "))
            ($line (str:concat $lead (cc:style "1" (cc:rtrim (car-atom $rows))))))
       (cons-atom $line (cc:user-input-lines (cdr-atom $rows) False)))))
(= (cc:emit-user-input $text)
   (let* (($clean (cc:expand-tabs (cc:clean $text)))
          ($trimmed (if (str:ends-with $clean "\n") (str:byte-slice $clean 0 (- (str:byte-length $clean) 1)) $clean))
          ($lines (cc:user-input-lines (str:split "\n" $trimmed) True)))
     (cc:emit-raw (str:concat (str:join "\n" $lines) "\n"))))
(= (cc:emit-reply $sender $text $extra)
   (cc:emit-reply-at $sender $text $extra
     (if (cc:get "clock-live" False) (system:wall-time) (cc:get "last-event-time" 0))))
; A stored reply carries the time it was received, not the time it is shown.
(= (cc:emit-reply-at $sender $text $extra $stamp)
   (let* (($lead (str:concat (cc:style "1;32" (cc:one-line $sender)) (cc:style "32" " → you")))
          ($head (cc:header-line $lead () $stamp))
          ($clean (cc:expand-tabs (cc:clean $text)))
          ($trimmed (if (str:ends-with $clean "\n") (str:byte-slice $clean 0 (- (str:byte-length $clean) 1)) $clean))
          ($body (map-atom (str:split "\n" $trimmed) $row (cc:rtrim $row)))
          ($tail (if (!= $extra "") ((cc:style "2" (cc:one-line $extra))) ()))
          ($all (cons-atom $head (list:append $body $tail))))
     (cc:emit-raw (str:concat (str:join "\n" $all) "\n\n"))))

; -- time and duration formatting ---------------------------------------------
(= (cc:pad2 $n)
   (if (< $n 10) (str:concat "0" (repr $n)) (repr $n)))
(= (cc:clock $seconds)
   (if (<= $seconds 0) ""
     (let* (($ref (if (cc:get "clock-live" False) (system:wall-time) (cc:get "last-event-time" $seconds)))
            ($d1 (system:format-time "%Y-%m-%d" $seconds "local"))
            ($d2 (system:format-time "%Y-%m-%d" (if (> $ref 0) $ref $seconds) "local")))
       (if (== $d1 $d2)
         (system:format-time "%H:%M:%S" $seconds "local")
         (system:format-time "%m-%d %H:%M" $seconds "local")))))
(= (cc:span $seconds)
   (let $s (max 0.0 $seconds)
     (if (< $s 10.0) (str:concat (str:format-fixed $s 1) "s")
       (if (< $s 60.0) (str:concat (repr (math:floor $s)) "s")
         (let $total (math:floor $s)
           (if (< $total 3600)
             (str:join "" ((repr (math:floor (/ $total 60))) "m" (cc:pad2 (% $total 60)) "s"))
             (let $mins (math:floor (/ $total 60))
               (str:join "" ((repr (math:floor (/ $mins 60))) "h" (cc:pad2 (% $mins 60)) "m")))))))))

; -- outcome classification and glyphs ----------------------------------------
(= (cc:glyph $state)
   (case $state (("running" "◌") ("ok" "✓") ("failed" "✗") ("uncertain" "?") ("proposed" "·") ($other "?"))))
(= (cc:glyph-style $state)
   (case $state (("running" "36") ("ok" "32") ("failed" "1;31") ("uncertain" "33") ("proposed" "2") ($other "33"))))
(= (cc:shell-tool? $name)
   (cli:member? $name ("exec_command" "write_stdin" "exec_poll" "exec_cancel")))
(= (cc:shell-label $name)
   (case $name (("exec_command" "shell") ("write_stdin" "shell input") ("exec_poll" "poll") ("exec_cancel" "cancel")
     ("" "shell") ($other $other))))
(= (cc:plain-status? $word)
   (cli:member? $word ("exited" "returned" "applied" "completed" "done" "finished" "running")))
(= (cc:classify $status $terminal $has-code $code $text-item $result)
   (if (not $terminal) "running"
     (let $word (str:lower $status)
       (if (== $word "proposed") "proposed"
         (if (and (!= $word "forming")
                  (cc:contains-any? $word ("interrupted" "unknown" "uncertain" "not run" "pending"
                    "abandon" "cancel" "stopped" "awaiting" "deferred" "withheld")))
           "uncertain"
           (if (and $has-code (!= $code 0)) "failed"
             (if (cc:contains-any? $word ("fail" "error" "timeout" "timed out" "timed-out" "killed"
                   "denied" "reject" "crash" "refused" "signal" "exception" "no_result"
                   "not_started" "not started" "http-status"))
               "failed"
               (if (and (== $word "returned") (str:starts-with (str:trim $result) "(Error"))
                 "failed"
                 (if (or (and $has-code (== $code 0))
                         (cc:contains-any? $word ("complete" "done" "ok" "success" "succeed"
                           "finished" "passed" "recorded" "applied" "returned" "exited")))
                   "ok"
                   (if (or $text-item (or (== $word "") (== $word "forming"))) "ok" "uncertain"))))))))))

; -- line wrapping, folding and prose layout ----------------------------------
(= (cc:wrap-words-loop $words $limit $cur $acc)
   (if (== $words ())
     (list:reverse (if (== $cur "") $acc (cons-atom $cur $acc)))
     (let* (($w (car-atom $words)) ($rest (cdr-atom $words)))
       (if (== $cur "")
         (cc:wrap-words-loop $rest $limit $w $acc)
         (let $cand (str:join " " ($cur $w))
           (if (<= (terminal:cells $cand) $limit)
             (cc:wrap-words-loop $rest $limit $cand $acc)
             (cc:wrap-words-loop $rest $limit $w (cons-atom $cur $acc))))))))
(= (cc:wrap-text $text $limit)
   (let $words (str:split-whitespace $text)
     (if (== $words ()) ("") (cc:wrap-words-loop $words (max 10 $limit) "" ()))))
(= (cc:drop-leading-blank $lines)
   (if (== $lines ()) ()
     (if (== (str:trim (car-atom $lines)) "") (cc:drop-leading-blank (cdr-atom $lines)) $lines)))
(= (cc:trim-blank-edges $lines)
   (list:reverse (cc:drop-leading-blank (list:reverse (cc:drop-leading-blank $lines)))))
(= (cc:limit-lines $lines $rows $indent $plural-word)
   (let $n (size-atom $lines)
     (if (or (<= $rows 0) (<= $n $rows)) $lines
       (let* (($head-n (max 1 (math:floor (/ (- $rows 1) 3))))
              ($tail-n (- (- $rows 1) $head-n))
              ($hidden (- (- $n $head-n) $tail-n))
              ($head (list:take $head-n $lines))
              ($tail (if (> $tail-n 0) (list:drop (- $n $tail-n) $lines) ()))
              ($word (if (== $hidden 1) $plural-word (str:concat $plural-word "s")))
              ($mark (cc:style "2" (str:join "" ($indent "… " (repr $hidden) " more " $word)))))
         (list:append $head (cons-atom $mark $tail))))))
(= (cc:prose-lines-loop $raw $width $style $fence $para $acc)
   (if (== $raw ())
     (let $flushed (if (== $para "") $acc (list:append $acc (cc:format-para $para $width $style))) $flushed)
     (let* (($line (cc:rtrim (car-atom $raw))) ($rest (cdr-atom $raw)) ($trimmed (str:trim $line)))
       (if (or (str:starts-with $trimmed "```") (str:starts-with $trimmed "~~~"))
         (let* (($acc1 (if (== $para "") $acc (list:append $acc (cc:format-para $para $width $style))))
                ($mark (str:byte-slice $trimmed 0 3))
                ($next-fence (if (== $fence $mark) "" (if (== $fence "") $mark $fence))))
           (cc:prose-lines-loop $rest $width $style $next-fence "" $acc1))
         (if (!= $fence "")
           (cc:prose-lines-loop $rest $width $style $fence ""
             (list:append $acc ((str:concat "  " (cc:style "2" $line)))))
           (if (== $trimmed "")
             (let $acc1 (if (== $para "") $acc (list:append $acc (cc:format-para $para $width $style)))
               (cc:prose-lines-loop $rest $width $style "" ""
                 (if (or (== $acc1 ()) (== (car-atom (list:reverse $acc1)) "")) $acc1 (list:append $acc1 ("")))))
             (if (or (str:starts-with $trimmed "- ") (str:starts-with $trimmed "* "))
               (let* (($acc1 (if (== $para "") $acc (list:append $acc (cc:format-para $para $width $style))))
                      ($item-txt (str:trim (str:byte-slice $trimmed 2 (str:byte-length $trimmed))))
                      ($wrapped (cc:wrap-text $item-txt (- $width 5)))
                      ($bul (cc:format-bullet-item $wrapped True $style)))
                 (cc:prose-lines-loop $rest $width $style "" "" (list:append $acc1 $bul)))
               (if (str:starts-with $trimmed "#")
                 (let* (($acc1 (if (== $para "") $acc (list:append $acc (cc:format-para $para $width $style))))
                        ($hd (str:concat "  " (cc:style "1" $trimmed))))
                   (cc:prose-lines-loop $rest $width $style "" "" (list:append $acc1 ($hd))))
                 (let $joined (if (== $para "") $trimmed (str:join " " ($para $trimmed)))
                   (cc:prose-lines-loop $rest $width $style "" $joined $acc))))))))))
(= (cc:format-para $para $width $style)
   (map-atom (cc:wrap-text $para (- $width 2)) $l (str:concat "  " (cc:style $style $l))))
(= (cc:format-bullet-item $lines $first $style)
   (if (== $lines ()) ()
     (let* (($prefix (if $first (str:concat "   " (cc:style "1" "• ")) "     "))
            ($line (str:concat $prefix (cc:style $style (car-atom $lines)))))
       (cons-atom $line (cc:format-bullet-item (cdr-atom $lines) False $style)))))
(= (cc:apply-commentary-bullet $lines)
   (if (== $lines ()) ()
     (let $first (car-atom $lines)
       (if (str:starts-with $first "  ")
         (cons-atom (str:concat (cc:style "1" "• ") (str:byte-slice $first 2 (str:byte-length $first))) (cdr-atom $lines))
         $lines))))

; -- session state and session anchor headers ---------------------------------
(= (cc:session-get $sid)
   (case (collapse (match &cc-sessions (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $rs $rsec)
           (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $rs $rsec)))
     ((($one) $one) ($none ConsoleNoSessionV1))))
(= (cc:session-put $rec)
   (let (ConsoleSessionV1 $sid $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_) $rec
     (let $_ (collapse (match &cc-sessions (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $rs $rsec)
                 (remove-atom &cc-sessions (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $rs $rsec))))
       (add-atom &cc-sessions $rec))))
(= (cc:session-ensure $sid $event)
   (let* (($time (cc:num-field $event "time" 0))
          ($parent (cc:str-field $event "parent_session" ""))
          ($inst (cc:str-field $event "instance" "Agent"))
          ($cur (cc:session-get $sid)))
     (case $cur
       (((ConsoleSessionV1 $sid $op $oinst $om $ot $ost $os $ou $ocs $oct $opl $og $orsn $ors $orsec)
         (let* (($np (if (!= $parent "") $parent $op))
                ($ninst (if (!= $inst "") $inst $oinst))
                ($nu (if (> $time 0) $time $ou))
                ($ns (if (> $os 0) $os $time))
                ($rec (ConsoleSessionV1 $sid $np $ninst $om $ot $ost $ns $nu $ocs $oct $opl $og $orsn $ors $orsec)))
           (progn (cc:session-put $rec) $rec)))
        ($none
         (let $rec (ConsoleSessionV1 $sid $parent $inst "" $sid "running" $time $time 0 -1 "" "" "" 0 0)
           (progn (cc:session-put $rec) $rec)))))))
(= (cc:header-seen? $sid)
   (not (== (collapse (match &cc-sessions (ConsoleHeaderSeenV1 $sid) True)) ())))
(= (cc:mark-header-seen $sid)
   (if (cc:header-seen? $sid) True (add-atom &cc-sessions (ConsoleHeaderSeenV1 $sid))))
(= (cc:display-name $sid)
   (let* (($settings (cc:settings)) ($agent (cc:str-field $settings "agent" "")))
     (if (and (!= $agent "") (== $sid $agent))
       (let $label (cc:str-field (sf:get (sf:get $settings "instance" (JsonObject ())) "environment" (JsonObject ())) "METTACLAW_AGENT_NAME" $sid)
         (if (and (!= $label "") (and (<= (str:char-length $label) 32) (== (terminal:clean $label) $label))) $label $sid))
       $sid)))
(= (cc:join-meta $bits)
   (str:join " · " (cc:nonempty-list $bits)))
(= (cc:header-line $lead $bits $seconds)
   (let* (($stamp (cc:clock $seconds))
          ($all (cc:nonempty-list (list:append $bits ($stamp))))
          ($meta (str:join " · " $all)))
     (if (== $meta "") $lead
       (str:join "" ($lead (if (== $lead "") "" (cc:style "2" " · ")) (cc:style "2" $meta))))))
(= (cc:session-line $sid $first $seconds)
   (case (cc:session-get $sid)
     (((ConsoleSessionV1 $sid $parent $_ $model $title $_ $_ $updated $_ $_ $_ $_ $_ $_ $_)
       (let* (($lead (str:concat (cc:style "1;35" "◆ ") (cc:style "1" (cc:one-line (cc:display-name $sid)))))
              ($bits (if $first
                ((if (!= $model "") (cc:one-line $model) "")
                 (if (!= $parent "") (str:concat "started by " (cc:one-line (cc:display-name $parent))) ""))
                ()))
              ($t (if (> $seconds 0) $seconds $updated))
              ($line1 (cc:header-line $lead $bits $t))
              ($clean-title (cc:one-line $title))
              ($w (cc:display-width)))
         (if (and $first (and (!= $clean-title "") (!= $clean-title $sid)))
           (str:join "" ($line1 "\n" "  " (cc:style "2" (cc:clip $clean-title (max 10 (- $w 2)))) "\n"))
           (str:concat $line1 "\n"))))
      ($none (str:join "" ((cc:style "1;35" "◆ ") (cc:style "1" (cc:one-line $sid)) "\n"))))))
(= (cc:emit-block $sid $text $prime)
   (if (or $prime (== $text "")) True
     (let* (($sess (cc:session-get $sid))
            ($now (case $sess (((ConsoleSessionV1 $_ $_ $_ $_ $_ $_ $_ $u $_ $_ $_ $_ $_ $_ $_) $u) ($n 0))))
            ($first (not (cc:header-seen? $sid)))
            ($last-sid (cc:get "last-sid" ""))
            ($last-time (cc:get "last-time" 0))
            ($need-header (or $first (or (!= $sid $last-sid) (and (> $now 0) (and (> $last-time 0) (> (- $now $last-time) 300))))))
            ($_ (if $need-header
                  (progn (cc:mark-header-seen $sid)
                         (if (cc:get "output-blank" True) True (cc:emit-raw "\n"))
                         (cc:emit-raw (cc:session-line $sid $first $now)))
                  True))
            ($_ (cc:set "last-sid" $sid))
            ($_ (if (> $now 0) (cc:set "last-time" $now) True)))
       (cc:emit-raw $text))))

; -- text item state, paragraph streaming, alias adoption, reconciliation -----
(= (cc:text-get $epoch $sid $attempt $item $part $channel)
   (case (collapse (match &cc-items (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $buf $comm $opened $closed)
           (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $buf $comm $opened $closed)))
     ((($one) $one) ($none ConsoleNoTextV1))))
(= (cc:text-put $rec)
   (let (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $_ $_ $_ $_ $_ $_) $rec
     (let $_ (collapse (match &cc-items (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $t $s $b $c $o $cl)
                 (remove-atom &cc-items (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $t $s $b $c $o $cl))))
       (add-atom &cc-items $rec))))
(= (cc:text-title $channel $event)
   (if (== $channel "reasoning-summary") "Reasoning summary"
     (if (== $channel "commentary") (cc:str-field $event "instance" "Agent")
       (let $name (cc:str-field $event "name" "")
         (if (!= $name "") $name (if (!= $channel "") $channel "text"))))))
(= (cc:text-ensure $epoch $sid $attempt $item $part $channel $event)
   (case (cc:text-get $epoch $sid $attempt $item $part $channel)
     (((ConsoleTextItemV1 $e $s $a $i $p $ch $t $st $b $c $o $cl)
       (ConsoleTextItemV1 $e $s $a $i $p $ch $t $st $b $c $o $cl))
      ($none
       (let $rec (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel
                   (cc:text-title $channel $event) (cc:num-field $event "time" 0) "" "" False False)
         (progn (cc:text-put $rec) $rec))))))
(= (cc:text-key-str $sid $attempt $item $part $channel)
   (str:join "|" ($sid $attempt $item $part $channel)))
(= (cc:split-ready-lines $lines $pos $ready $fence)
   (if (== $lines ()) $ready
     (let* (($line (car-atom $lines)) ($rest (cdr-atom $lines)) ($tr (str:trim $line))
            ($next-fence (if (or (str:starts-with $tr "```") (str:starts-with $tr "~~~"))
              (let $m (str:byte-slice $tr 0 3) (if (== $fence $m) "" (if (== $fence "") $m $fence))) $fence))
            ($end (+ $pos (+ (str:byte-length $line) 1)))
            ($next-ready (if (and (== $next-fence "") (and (== $tr "") (and (not (== $rest ())) (> $pos 0))))
                           $end $ready)))
       (cc:split-ready-lines $rest $end $next-ready $next-fence))))
(= (cc:split-ready $buf)
   (let* (($n (str:byte-length $buf))
          ($cut (cc:split-ready-lines (str:split "\n" $buf) 0 0 "")))
     (min $cut $n)))
(= (cc:last-newline-cut $s)
   (let $parts (str:split "\n" $s)
     (if (<= (size-atom $parts) 1) 0
       (- (str:byte-length $s) (str:byte-length (car-atom (list:reverse $parts)))))))
(= (cc:strip-edge-newlines $s)
   (let* (($s1 (if (str:starts-with $s "\n") (cc:strip-edge-newlines (str:byte-slice $s 1 (str:byte-length $s))) $s)))
     (if (str:ends-with $s1 "\n") (cc:strip-edge-newlines (str:byte-slice $s1 0 (- (str:byte-length $s1) 1))) $s1)))
(= (cc:render-text-chunk $title $channel $raw $state $header $close $cont $note)
   (let* (($w (cc:display-width))
          ($reasoning (== $channel "reasoning-summary"))
          ($head-lines (if (and $header (or $reasoning (!= $channel "commentary")))
            (let* (($g (if (and $close (cli:member? $state ("running" "uncertain" "failed")))
                         (str:concat (cc:style (cc:glyph-style $state) (cc:glyph $state)) " ") ""))
                   ($lbl (if $reasoning (cc:style "2" "◇ thinking") (cc:style "1" (cc:one-line $title))))
                   ($suf (if $cont (cc:style "2" " (continued)") "")))
              ((str:join "" ($g $lbl $suf))))
            ()))
          ($note-lines (if (!= $note "") ((str:concat "  " (cc:style "2" $note))) ()))
          ($clean (cc:expand-tabs (cc:clean $raw)))
          ($body-style (if $reasoning "2;3" ""))
          ($body0 (if (== (str:trim $clean) "") ()
            (let* (($built (cc:prose-lines-loop (str:split "\n" $clean) $w $body-style "" "" ()))
                   ($trimmed (cc:trim-blank-edges $built))
                   ($capped (if (cc:get "viewer-full" False) $trimmed (cc:limit-lines $trimmed 60 "  " "line"))))
              (if (and (== $channel "commentary") $header) (cc:apply-commentary-bullet $capped) $capped))))
          ($tail-lines (if (and $close (== $state "uncertain"))
            ((str:join "" ("  " (cc:style "33" (str:concat (cc:glyph "uncertain") " interrupted"))))) ()))
          ($all (list:append $head-lines (list:append $note-lines (list:append $body0 $tail-lines)))))
     (if (== $all ()) "" (str:concat (str:join "\n" $all) "\n\n"))))
(= (cc:commit-text $rec $raw $close $state $note $prime)
   (let (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $buf $comm $opened $closed) $rec
     (let* (($chunk (cc:strip-edge-newlines $raw))
            ($empty (== (str:trim $chunk) ""))
            ($new-comm (if $close $comm (str:concat $comm $raw))))
       (if (and (not $close) $empty)
         (let $upd (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $buf $new-comm $opened $closed)
           (progn (cc:text-put $upd) $upd))
         (if (and $close (and $empty (and (== $note "") (!= $state "uncertain"))))
           $rec
           (let* (($kstr (cc:text-key-str $sid $attempt $item $part $channel))
                  ($same-last (== (cc:get "last-text-key" "") $kstr))
                  ($header (or (not $opened) (not $same-last)))
                  ($show-header (and $header (not (and $empty $opened))))
                  ($out (cc:render-text-chunk $title $channel $chunk $state $show-header $close (and $opened $header) $note))
                  ($_ (if $prime True (cc:emit-block $sid $out False)))
                  ($_ (if $prime True (cc:set "last-text-key" (if $close "" $kstr))))
                  ($upd (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $buf $new-comm
                          (if $prime $opened True) $closed)))
             (progn (cc:text-put $upd) $upd)))))))
(= (cc:text-finish $rec $has-final $final $status $prime)
   (let (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $buf $comm $opened $closed) $rec
     (if $closed $rec
       (let* (($state (if (!= $status "") (cc:classify $status True False 0 True "") "ok"))
              ($extends (and $has-final (str:starts-with $final $comm)))
              ($rest (if (not $has-final) $buf
                       (if $extends (str:byte-slice $final (str:byte-length $comm) (str:byte-length $final)) $final)))
              ($note (if (and $has-final (not $extends))
                       "(final text differs from what was streamed; shown in full)" ""))
              ($pre (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started "" $comm $opened True))
              ($_ (cc:text-put $pre))
              ($after (cc:commit-text $pre $rest True $state $note $prime))
              ($done (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel "" 0 "" ""
                       (case $after (((ConsoleTextItemV1 $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $o $_) $o) ($x $opened))) True)))
         (progn (cc:text-put $done) $done)))))
(= (cc:text-adopt-list $target $others $final $prime)
   (if (== $others ()) $target
     (let* (($other (car-atom $others)) ($rest (cdr-atom $others))
            ((ConsoleTextItemV1 $te $ts $ta $ti $tp $tch $tt $tst $tb $tc $to $tcl) $target)
            ((ConsoleTextItemV1 $oe $os $oa $oi $op $och $ot $ost $ob $oc $oo $ocl) $other))
       (if (and (== $tc "") (and (or (!= $oc "") (!= $ob "")) (str:starts-with $final $oc)))
         (let* (($closed-other (ConsoleTextItemV1 $oe $os $oa $oi $op $och $ot $ost "" $oc $oo True))
                ($_ (cc:text-put $closed-other))
                ($okstr (cc:text-key-str $os $oa $oi $op $och))
                ($tkstr (cc:text-key-str $ts $ta $ti $tp $tch))
                ($_ (if (== (cc:get "last-text-key" "") $okstr) (cc:set "last-text-key" $tkstr) True))
                ($next-target (ConsoleTextItemV1 $te $ts $ta $ti $tp $tch $tt $ost $tb $oc $oo $tcl)))
           (progn (cc:text-put $next-target) (cc:text-adopt-list $next-target $rest $final $prime)))
         (progn (cc:text-finish $other False "" "" $prime)
                (cc:text-adopt-list $target $rest $final $prime))))))
(= (cc:text-adopt $rec $final $prime)
   (let (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $_ $_ $_ $_ $_ $_) $rec
     (let $others (collapse (match &cc-items
                    (ConsoleTextItemV1 $epoch $sid $attempt $oi $op $channel $ot $ost $ob $oc $oo False)
                    (if (and (== $oi $item) (== $op $part)) (empty)
                      (ConsoleTextItemV1 $epoch $sid $attempt $oi $op $channel $ot $ost $ob $oc $oo False))))
       (cc:text-adopt-list $rec $others $final $prime))))
(= (cc:text-event $event $snapshot $final $prime)
   (let* (($epoch (cc:str-field $event "epoch" "initial"))
          ($sid (cc:str-field $event "session" "agent"))
          ($attempt (cc:str-field $event "attempt" ""))
          ($item (cc:str-field $event "item" ""))
          ($part (cc:part-key $event))
          ($channel (cc:str-field $event "channel" ""))
          ($text (cc:str-field $event "text" ""))
          ($rec (cc:text-ensure $epoch $sid $attempt $item $part $channel $event))
          ((ConsoleTextItemV1 $_ $_ $_ $_ $_ $_ $title $started $buf $comm $opened $closed) $rec))
     (if $closed True
       (if (not $snapshot)
         (let* (($nbuf (str:concat $buf $text))
                ($cut0 (cc:split-ready $nbuf))
                ($cut1 (if (> $cut0 0) $cut0
                         (if (and (not (cli:member? $channel ("commentary" "reasoning-summary")))
                                  (cc:contains? $nbuf "\n"))
                           (cc:last-newline-cut $nbuf)
                           (if (and (> (str:byte-length $nbuf) 2000) (cc:contains? $nbuf "\n"))
                             (cc:last-newline-cut $nbuf) 0)))))
           (if (> $cut1 0)
             (let* (($chunk (str:byte-slice $nbuf 0 $cut1))
                    ($rem (str:byte-slice $nbuf $cut1 (str:byte-length $nbuf)))
                    ($upd (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $rem $comm $opened False)))
               (progn (cc:text-put $upd) (cc:commit-text $upd $chunk False "ok" "" $prime) True))
             (progn (cc:text-put (ConsoleTextItemV1 $epoch $sid $attempt $item $part $channel $title $started $nbuf $comm $opened False)) True)))
         (let* (($adopted (cc:text-adopt $rec $text $prime))
                ($status (cc:str-field $event "status" "")))
           (progn (cc:text-finish $adopted True $text $status $prime) True))))))
; A one-shot reader must show even a short, still-open item without closing it
; or manufacturing a completion/receipt event.
(= (cc:flush-visible-items)
   (let $open (collapse (match &cc-items (ConsoleTextItemV1 $e $s $a $i $p $ch $t $st $b $c $o False)
                (ConsoleTextItemV1 $e $s $a $i $p $ch $t $st $b $c $o False)))
     (map-atom $open $rec
       (let (ConsoleTextItemV1 $e $s $a $i $p $ch $t $st $b $c $o False) $rec
         (if (== $b "") True
           (let $upd (ConsoleTextItemV1 $e $s $a $i $p $ch $t $st "" $c $o False)
             (progn (cc:text-put $upd) (cc:commit-text $upd $b False "ok" "" False) True)))))))

; A one-shot view ends with what is still in flight: every tool that has
; started and not finished is shown as running, under its own session.
(= (cc:flush-running-tools)
   (let $open (collapse (match &cc-items (ConsoleToolItemV1 $e $s $a $i $k $nm $cmd $st $disp $upd $stat $hc $ec $txt $art False)
                (if (== $k "tool.forming") (empty)
                  (ConsoleToolItemV1 $e $s $a $i $k $nm $cmd $st $disp $upd $stat $hc $ec $txt $art False))))
     (map-atom $open $rec (cc:emit-tool $rec False))))

; -- tool item state and formatting -------------------------------------------
(= (cc:tool-get $epoch $sid $attempt $item)
   (case (collapse (match &cc-items (ConsoleToolItemV1 $epoch $sid $attempt $item $k $nm $cmd $st $disp $upd $stat $hc $ec $txt $art $term)
           (ConsoleToolItemV1 $epoch $sid $attempt $item $k $nm $cmd $st $disp $upd $stat $hc $ec $txt $art $term)))
     ((($one) $one) ($none ConsoleNoToolV1))))
(= (cc:tool-put $rec)
   (let (ConsoleToolItemV1 $epoch $sid $attempt $item $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_) $rec
     (let $_ (collapse (match &cc-items (ConsoleToolItemV1 $epoch $sid $attempt $item $k $nm $cmd $st $disp $upd $stat $hc $ec $txt $art $term)
                 (remove-atom &cc-items (ConsoleToolItemV1 $epoch $sid $attempt $item $k $nm $cmd $st $disp $upd $stat $hc $ec $txt $art $term))))
       (add-atom &cc-items $rec))))
(= (cc:command-lines $command)
   (let* (($full (cc:get "viewer-full" False))
          ($clean (cc:expand-tabs (cc:clean $command)))
          ($trimmed (if (str:ends-with $clean "\n") (str:byte-slice $clean 0 (- (str:byte-length $clean) 1)) $clean))
          ($rows (str:split "\n" $trimmed))
          ($total (size-atom $rows))
          ($shown (if $full $rows (list:take 12 $rows)))
          ($rendered (map-atom $shown $row
            (let* (($r (cc:rtrim $row))
                   ($r2 (if (and (not $full) (> (str:char-length $r) 2000))
                          (str:join "" ((str:char-slice $r 0 2000) "… (" (repr (- (str:char-length $r) 2000)) " more characters)"))
                          $r)))
              (cc:style "1" $r2))))
          ($more (- $total (size-atom $shown))))
     (if (> $more 0)
       (list:append $rendered ((str:concat "  " (cc:style "2" (str:join "" ("… " (repr $more) " more command lines"))))))
       $rendered)))
(= (cc:output-lines $text $truncated)
   (let* (($full (cc:get "viewer-full" False))
          ($w (cc:display-width))
          ($clean (cc:expand-tabs (cc:clean $text)))
          ($raw0 (str:split "\n" $clean))
          ($raw1 (if (and $truncated (> (size-atom $raw0) 1)) (cdr-atom $raw0) $raw0))
          ($lines (cc:trim-blank-edges $raw1))
          ($prefix (if (and $truncated (not (== $lines ()))) ((cc:style "2" "    … earlier output is in the log")) ())))
     (if (== $lines ()) $prefix
       (if $full
         (list:append $prefix (map-atom $lines $l (str:concat "    " (cc:rtrim $l))))
         (let* (($cap (max 4 (- $w 5)))
                ($clipped (map-atom $lines $l (cc:style "2" (str:concat "    " (cc:clip (cc:rtrim $l) $cap))))))
           (list:append $prefix (cc:limit-lines $clipped 8 "    " "line")))))))
(= (cc:metta-wrapped-lines $title)
   (let* (($w (cc:display-width))
          ($wrapped (cc:wrap-text $title (max 10 (- $w 2))))
          ($n (size-atom $wrapped)))
     (if (<= $n 4)
       (map-atom $wrapped $l (str:concat "  " (cc:style "1" $l)))
       (let* (($shown (map-atom (list:take 3 $wrapped) $l (str:concat "  " (cc:style "1" $l))))
              ($rem (max 0 (- (terminal:cells $title) (* 3 (max 10 (- $w 2))))))
              ($note (str:concat "  " (cc:style "2" (str:join "" ("… " (repr $rem) " more characters"))))))
         (list:append $shown ($note))))))
(= (cc:emit-tool $rec $prime)
   (let (ConsoleToolItemV1 $epoch $sid $attempt $item $kind $name $command $started $dispatched $updated $raw-status $has-code $code $raw-text $artifact $terminal) $rec
     (let* (($state (cc:classify $raw-status $terminal $has-code $code False $raw-text)))
       (if (== $state "proposed") True
         (let* (($maint-ok (and (== $kind "maintenance")
                            (and $terminal (cli:member? (str:lower $raw-status) ("stop" "tool_calls" "finished" "completed" "done")))))
                ($state2 (if (and (== $kind "maintenance") $terminal) (if $maint-ok "ok" "failed") $state))
                ($status0 (if (not $terminal) "running"
                            (if (and (== $kind "maintenance") $maint-ok) ""
                              (if (and (== $kind "tool.forming") (== $state2 "uncertain")) "call not run" $raw-status))))
                ($text0 (if (and (== $kind "maintenance") (and $maint-ok (str:starts-with $raw-text "Task history compaction")))
                          "Compacted task history" $raw-text))
                ($status (cc:one-line $status0))
                ($word (str:lower $status))
                ($began (if (> $dispatched 0) $dispatched (if (== $kind "maintenance") $started 0)))
                ($took (if (and $terminal (and (> $began 0) (>= $updated $began))) (cc:span (- $updated $began)) ""))
                ($detail0 (if (or (== $status "") (and (cc:plain-status? $word) (not (cli:member? $kind ("patch" "steering")))))
                            () ($status)))
                ($detail1 (if (and $has-code (or (cc:shell-tool? $name) (!= $code 0)))
                            (list:append $detail0 ((str:concat "exit " (repr $code)))) $detail0))
                ($detail2 (if (!= $took "") (list:append $detail1 ($took)) $detail1))
                ($shell (and (!= $command "") (or (cc:shell-tool? $name) (not (str:starts-with $command "[")))))
                ($lead-glyph (str:concat (cc:style (cc:glyph-style $state2) (cc:glyph $state2)) " "))
                ($w (cc:display-width))
                ($tsec (if (> $updated 0) $updated $started)))
           (let* ((($head-title $cmd-lines $out-text)
                   (if $shell
                     ((cc:shell-label $name) (cc:command-lines $command) $text0)
                     (if (!= $command "")
                       (let* (($title (cc:one-line (erv:command-text $command)))
                              ($meta-len (terminal:cells (cc:join-meta (list:append $detail2 ("00:00:00")))))
                              ($room (- (- (- $w 2) $meta-len) 4)))
                         (if (or (cc:get "viewer-full" False) (<= (terminal:cells $title) $room))
                           ($title () $text0)
                           ("metta" (cc:metta-wrapped-lines $title) $text0)))
                       (if (== $kind "maintenance")
                         (let $t (cc:one-line $text0)
                           ((if (== $t "") "maintenance"
                              (str:concat (str:lower (str:char-slice $t 0 1)) (str:char-slice $t 1 (str:char-length $t))))
                            () ""))
                         (let* (($raw-lbl (if (!= $name "") $name (str:join " " (str:split "." $kind))))
                                ($lbl (if (== $raw-lbl "apply_patch") "patch" (cc:one-line $raw-lbl))))
                           ($lbl () $text0))))))
                  ($head (cc:header-line (str:concat $lead-glyph (cc:style "1" $head-title)) $detail2 $tsec))
                  ($tail-cap (if (cc:get "viewer-full" False) 16777216 12000))
                  ($truncated (and (!= $artifact "") (>= (str:byte-length $out-text) (- $tail-cap 16))))
                  ($out-lines (cc:output-lines $out-text $truncated))
                  ($art-lines (if (!= $artifact "")
                    ((str:concat (cc:style "2" "    output: ") (cc:one-line $artifact))) ()))
                  ($all (cons-atom $head (list:append $cmd-lines (list:append $out-lines $art-lines)))))
             (progn (cc:set "last-text-key" "")
                    (cc:emit-block $sid (str:concat (str:join "\n" $all) "\n\n") $prime))))))))
(= (cc:tool-event $event $prime)
   (let* (($kind (cc:str-field $event "kind" ""))
          ($source (cc:str-field $event "source" "provider")))
     (if (and (cli:member? $kind ("tool.started" "tool.finished")) (!= $source "executor")) True
       (let* (($epoch (cc:str-field $event "epoch" "initial"))
              ($sid (cc:str-field $event "session" "agent"))
              ($attempt (cc:str-field $event "attempt" ""))
              ($item (cc:str-field $event "item" ""))
              ($time (cc:num-field $event "time" 0))
              ($prior (cc:tool-get $epoch $sid $attempt $item)))
         (case $prior
           (((ConsoleToolItemV1 $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ True) True)
            ($active
             (let* ((($pk $pnm $pcmd $pst $pdisp $pupd $pstat $phc $pec $ptxt $part)
                     (case $active
                       (((ConsoleToolItemV1 $_ $_ $_ $_ $ak $anm $acmd $ast $adisp $aupd $astat $ahc $aec $atxt $aart False)
                         ($ak $anm $acmd $ast $adisp $aupd $astat $ahc $aec $atxt $aart))
                        ($none ($kind "" "" $time 0 $time "forming" False 0 "" "")))))
                    ($enm (cc:str-field $event "name" ""))
                    ($ecmd (cc:str-field $event "command" ""))
                    ($estat (cc:str-field $event "status" ""))
                    ($eart (cc:str-field $event "artifact" ""))
                    ($ehc (cc:has-num? $event "exit_code"))
                    ($eec (if $ehc (cc:num-field $event "exit_code" 0) $pec))
                    ($has-txt (not (== (sf:get $event "text" ConsoleNoValV1) ConsoleNoValV1)))
                    ($etxt (cc:str-field $event "text" ""))
                    ($tail-cap (if (cc:get "viewer-full" False) 16777216 12000))
                    ($ntxt (if (== $kind "tool.output") (cc:tail-bytes (str:concat $ptxt $etxt) $tail-cap)
                             (if (and $has-txt (!= $etxt "")) (cc:tail-bytes $etxt $tail-cap) $ptxt)))
                    ($nm (if (!= $enm "") $enm $pnm))
                    ($cmd (if (!= $ecmd "") $ecmd $pcmd))
                    ($art (if (!= $eart "") $eart $part))
                    ($stat (if (!= $estat "") $estat $pstat))
                    ($hc (or $ehc $phc))
                    ($disp (if (and (== $pdisp 0) (cli:member? $kind ("tool.dispatching" "tool.started"))) $time $pdisp))
                    ($term (or (== $kind "tool.finished")
                             (or (cli:member? $kind ("patch" "steering"))
                                 (and (== $kind "maintenance") (!= $stat "running")))))
                    ($rec (ConsoleToolItemV1 $epoch $sid $attempt $item $kind $nm $cmd $pst $disp
                            (if (> $time 0) $time $pupd) $stat $hc $eec $ntxt $art $term))
                    ($_ (cc:tool-put $rec))
                    ($_ (if (and (== $kind "tool.dispatching") (not (str:starts-with (erv:command-text $cmd) "(rest")))
                          (cc:session-clear-rest $sid) True))
                    ($_ (if (== $kind "tool.finished") (cc:maybe-track-rest $sid $cmd $etxt $time) True)))
               (if $term
                 (progn (cc:emit-tool $rec $prime)
                        (cc:tool-put (ConsoleToolItemV1 $epoch $sid $attempt $item $kind "" "" 0 0 (if (> $time 0) $time $pupd) "" False 0 "" "" True))
                        True)
                 True)))))))))

; -- session lifecycle helpers (rest, attempt.finished, plan, gap, report) ----
(= (cc:session-clear-rest $sid)
   (case (cc:session-get $sid)
     (((ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $_ $_)
       (cc:session-put (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn 0 0)))
      ($none True))))
(= (cc:maybe-track-rest $sid $cmd $result $time)
   (let $decoded (erv:command-text $cmd)
     (if (and (str:starts-with $decoded "(rest") (str:starts-with (str:trim $result) "(RESTING"))
       (let* (($caps (re:captures (re:compile "sleep-interval-seconds ([0-9]+)") $result))
              ($secs (case $caps
                (((re:matches $_) (cli:number (re:group-text $caps 1) 0))
                 ($no 0))))
              ($since (if (> $time 0) $time (system:wall-time))))
         (case (cc:session-get $sid)
           (((ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $_ $_)
             (cc:session-put (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $g $rsn $since $secs)))
            ($none True))))
       True)))
(= (cc:attempt-open $event)
   (let* (($sid (cc:str-field $event "session" "agent"))
          ($time (cc:num-field $event "time" 0))
          ($model (cc:str-field $event "model" "")))
     (case (cc:session-get $sid)
       (((ConsoleSessionV1 $sid $p $inst $om $t $_ $s $u $_ $ct $pl $g $rsn $_ $_)
         (cc:session-put (ConsoleSessionV1 $sid $p $inst (if (!= $model "") $model $om) $t "thinking" $s $u $time $ct $pl $g $rsn 0 0)))
        ($none True)))))
(= (cc:texts-contains? $texts $item $part $channel)
   (if (== $texts ()) False
     (let $t (car-atom $texts)
       (if (and (== (cc:str-field $t "item" "") $item)
                (and (== (cc:part-key $t) $part) (== (cc:str-field $t "channel" "") $channel)))
         True (cc:texts-contains? (cdr-atom $texts) $item $part $channel)))))
(= (cc:attempt-apply-texts $epoch $sid $attempt $texts $status $event $prime)
   (if (== $texts ()) True
     (let* (($t (car-atom $texts)) ($item (cc:str-field $t "item" "")) ($ch (cc:str-field $t "channel" "")))
       (progn
         (if (and (!= $item "") (!= $ch ""))
           (let* (($part (cc:part-key $t)) ($txt (cc:str-field $t "text" ""))
                  ($rec (cc:text-ensure $epoch $sid $attempt $item $part $ch $event))
                  ((ConsoleTextItemV1 $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $closed) $rec))
             (if $closed True
               (let $adopted (cc:text-adopt $rec $txt $prime)
                 (cc:text-finish $adopted True $txt (if (!= $status "") $status "completed") $prime))))
           True)
         (cc:attempt-apply-texts $epoch $sid $attempt (cdr-atom $texts) $status $event $prime)))))
(= (cc:attempt-close-one-text $rec $texts $status $prime)
   (let (ConsoleTextItemV1 $_ $_ $_ $i $p $ch $_ $_ $_ $_ $_ False) $rec
     (if (cc:texts-contains? $texts $i $p $ch) True
       (cc:text-finish $rec False "" (if (!= $status "") $status "interrupted") $prime))))
(= (cc:attempt-close-texts $epoch $sid $attempt $texts $status $prime)
   (let $open (collapse (match &cc-items (ConsoleTextItemV1 $epoch $sid $attempt $i $p $ch $t $st $b $c $o False)
                  (ConsoleTextItemV1 $epoch $sid $attempt $i $p $ch $t $st $b $c $o False)))
     (map-atom $open $rec (cc:attempt-close-one-text $rec $texts $status $prime))))
(= (cc:attempt-close-one-forming $trec $time $completed $prime)
   (let (ConsoleToolItemV1 $e $s $a $ti $k $nm $cmd $st $disp $upd $_ $hc $ec $txt $art False) $trec
     (let $done (ConsoleToolItemV1 $e $s $a $ti $k $nm $cmd $st $disp (if (> $time 0) $time $upd)
                  (if $completed "proposed" "not run") $hc $ec $txt $art True)
       (progn (cc:tool-put $done) (cc:emit-tool $done $prime)))))
(= (cc:attempt-close-forming $epoch $sid $attempt $time $completed $prime)
   (let $forming (collapse (match &cc-items (ConsoleToolItemV1 $epoch $sid $attempt $ti "tool.forming" $nm $cmd $st $disp $upd $stat $hc $ec $txt $art False)
                     (ConsoleToolItemV1 $epoch $sid $attempt $ti "tool.forming" $nm $cmd $st $disp $upd $stat $hc $ec $txt $art False)))
     (map-atom $forming $trec (cc:attempt-close-one-forming $trec $time $completed $prime))))
(= (cc:attempt-finished $event $prime)
   (let* (($epoch (cc:str-field $event "epoch" "initial"))
          ($sid (cc:str-field $event "session" "agent"))
          ($attempt (cc:str-field $event "attempt" ""))
          ($status (cc:str-field $event "status" ""))
          ($reason0 (cc:str-field $event "reason" ""))
          ($reason (if (!= $reason0 "") $reason0 $status))
          ($time (cc:num-field $event "time" 0))
          ($completed (== $status "completed"))
          ($texts (case (sf:get $event "texts" (JsonArray ())) (((JsonArray $xs) $xs) ($other ()))))
          ($sess (cc:session-get $sid))
          ($old-status (case $sess (((ConsoleSessionV1 $_ $_ $_ $_ $_ $ost $_ $_ $_ $_ $_ $_ $_ $_ $_) $ost) ($n ""))))
          ($new-status (if $completed "ready" "interrupted"))
          ($took (case $sess
                   (((ConsoleSessionV1 $sid $sp $sinst $sm $stitle $_ $ss $su $scs $soct $spl $sg $_ $srs $srsec)
                     (let* (($ntook (if (and (> $scs 0) (>= $time $scs)) (- $time $scs) $soct))
                            ($nrsn (if $completed "" $reason)))
                       (progn (cc:session-put (ConsoleSessionV1 $sid $sp $sinst $sm $stitle $new-status $ss $su $scs $ntook $spl $sg $nrsn $srs $srsec))
                              $ntook)))
                    ($n -1))))
          ($_ (cc:attempt-close-texts $epoch $sid $attempt $texts $status $prime))
          ($_ (cc:attempt-apply-texts $epoch $sid $attempt $texts $status $event $prime))
          ($_ (cc:attempt-close-forming $epoch $sid $attempt $time $completed $prime))
          ($_ (if (and (not $prime) (and (not $completed) (and (!= $old-status "interrupted") (cc:header-seen? $sid))))
                (let* (($lead (cc:style "33" (str:concat "! " (str:concat (cc:one-line $sid) " model call interrupted"))))
                       ($bits ((if (!= $reason "") (str:concat "reason " (cc:one-line $reason)) "")
                               (if (>= $took 0) (cc:span $took) "")))
                       ($line (cc:header-line $lead $bits $time)))
                  (cc:emit-block $sid (str:concat $line "\n") False))
                True))) True))

(= (cc:plan-steps $steps)
   (if (== $steps ()) ()
     (let* (($p (car-atom $steps))
            ($st (cc:str-field $p "status" ""))
            ($step (cc:one-line (cc:str-field $p "step" "")))
            ($g (if (== $st "completed") (str:concat (cc:style "32" "✓") " ")
                  (if (== $st "in_progress") (str:concat (cc:style "36" "◌") " ")
                    (cc:style "2" "○ ")))))
       (cons-atom (str:join "" ("  " $g $step)) (cc:plan-steps (cdr-atom $steps))))))
(= (cc:handle-plan $event $prime)
   (let* (($sid (cc:str-field $event "session" "agent"))
          ($text (cc:str-field $event "text" ""))
          ($sess (cc:session-get $sid))
          ($old (case $sess (((ConsoleSessionV1 $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $pl $_ $_ $_ $_) $pl) ($n "")))))
     (if (or (== $text "") (== $text $old)) True
       (let* (($_ (case $sess
                    (((ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $_ $g $rsn $rs $rsec)
                      (cc:session-put (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $text $g $rsn $rs $rsec)))
                     ($n True))))
              ($parsed (json:parse-python $text))
              ($rows (case $parsed
                (((JsonObject $_)
                  (let* (($exp (cc:one-line (cc:str-field $parsed "explanation" "")))
                         ($exp-row (if (!= $exp "") ((str:concat "  " (cc:style "2" $exp))) ()))
                         ($steps (case (sf:get $parsed "plan" (JsonArray ())) (((JsonArray $xs) (cc:plan-steps $xs)) ($o ())))))
                    (cons-atom (cc:style "1" "Plan") (list:append $exp-row $steps))))
                 ($raw ((cc:style "1" "Plan") (str:concat "  " (cc:one-line $text))))))))
         (cc:emit-block $sid (str:concat (str:join "\n" $rows) "\n\n") $prime)))))
(= (cc:handle-gap $sid $gap-val $prime)
   (let* (($gstr (if (== (get-type $gap-val) Number) (str:join "" ("display missed " (repr $gap-val) " updates; "))
                   (str:concat (cc:one-line $gap-val) "; ")))
          ($sess (cc:session-get $sid))
          ($old (case $sess (((ConsoleSessionV1 $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $og $_ $_ $_) $og) ($n "")))))
     (if (or (== $gstr "") (== $gstr $old)) True
       (progn
         (case $sess
           (((ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $_ $rsn $rs $rsec)
             (cc:session-put (ConsoleSessionV1 $sid $p $inst $m $t $st $s $u $cs $ct $pl $gstr $rsn $rs $rsec)))
            ($n True)))
         (cc:emit-block $sid (str:concat (cc:style "33" (str:join "" ("! " $gstr "final records remain authoritative"))) "\n\n") $prime)))))
(= (cc:handle-session-finished $event $prime)
   (let* (($sid (cc:str-field $event "session" "agent"))
          ($status (cc:str-field $event "status" "finished"))
          ($body (cc:str-field $event "text" ""))
          ($time (cc:num-field $event "time" 0))
          ($sess (cc:session-get $sid))
          ($started (case $sess (((ConsoleSessionV1 $_ $_ $_ $_ $_ $_ $s $_ $_ $_ $_ $_ $_ $_ $_) $s) ($n 0))))
          ($_ (case $sess
                (((ConsoleSessionV1 $sid $p $inst $m $t $_ $s $u $cs $ct $pl $g $rsn $rs $rsec)
                  (cc:session-put (ConsoleSessionV1 $sid $p $inst $m $t $status $s $u $cs $ct $pl $g $rsn $rs $rsec)))
                 ($n True))))
          ($state (cc:classify $status True False 0 False ""))
          ($took (if (and (> $started 0) (> $time $started)) (cc:span (- $time $started)) ""))
          ($lead (str:join "" ((cc:style (cc:glyph-style $state) (cc:glyph $state)) " "
                   (cc:style "1" (str:join " " ((cc:one-line $sid) (cc:one-line $status)))))))
          ($head (cc:header-line $lead ($took) $time))
          ($w (cc:display-width))
          ($body-lines (if (== (str:trim (cc:clean $body)) "") ()
                         (cc:trim-blank-edges (cc:prose-lines-loop (str:split "\n" (cc:expand-tabs (cc:clean $body))) $w "" "" "" ())))))
     (cc:emit-block $sid (str:concat (str:join "\n" (cons-atom $head $body-lines)) "\n\n") $prime)))

; -- live status and activity rows --------------------------------------------
(= (cc:short-sid $sid)
   (let $parts (str:split "-" $sid)
     (if (> (size-atom $parts) 3)
       (str:join "" ((car-atom $parts) "-…-" (car-atom (list:reverse $parts))))
       $sid)))
(= (cc:session-running-tools $sid)
   (collapse (match &cc-items (ConsoleToolItemV1 $_ $sid $_ $_ $k $_ $cmd $st $disp $_ $_ $_ $_ $_ $_ False)
               (if (== $k "tool.forming") (empty) (ConsoleRunningV1 $k $cmd (if (> $disp 0) $disp $st))))))
(= (cc:newer-running (ConsoleRunningV1 $_ $_ $a) (ConsoleRunningV1 $_ $_ $b)) (>= $a $b))
(= (cc:session-doing $sid $now)
   (let* (($sess (cc:session-get $sid))
          ($running (cc:session-running-tools $sid))
          ($compacting (filter-atom $running $r (case $r (((ConsoleRunningV1 "maintenance" $_ $_) True) ($o False)))))
          ($cmds (list:sort-by cc:newer-running (filter-atom $running $r (case $r (((ConsoleRunningV1 $_ $c $_) (!= $c "")) ($o False)))))))
     (if (not (== $compacting ()))
       (let (ConsoleRunningV1 $_ $_ $since) (car-atom $compacting) (ConsoleDoingV1 $sid "compacting history" $since True "" 0 0))
       (if (not (== $cmds ()))
         (let (ConsoleRunningV1 $_ $cmd $since) (car-atom $cmds)
           (ConsoleDoingV1 $sid "running" $since True (erv:command-text $cmd) (- (size-atom $cmds) 1) 0))
         (case $sess
           (((ConsoleSessionV1 $sid $_ $_ $_ $_ $st $_ $_ $cs $_ $_ $_ $_ $rs $rsec)
             (if (== $st "thinking") (ConsoleDoingV1 $sid "thinking" $cs True "" 0 0)
               (if (> $rs 0) (ConsoleDoingV1 $sid "resting" $rs False "" 0 $rsec)
                 (ConsoleDoingV1 $sid $st 0 False "" 0 0))))
            ($none ConsoleNoDoingV1)))))))
(= (cc:doing-state-text (ConsoleDoingV1 $_ $word $since $_ $_ $_ $rsec) $now)
   (let $elapsed (if (and (> $since 0) (>= $now $since)) (cc:span (- $now $since)) "")
     (if (and (== $word "resting") (> $rsec 0))
       (if (!= $elapsed "") (str:join "" ("resting " $elapsed " of " (cc:span $rsec))) "resting")
       (if (!= $elapsed "") (str:join " " ($word $elapsed)) $word))))
(= (cc:live-work-sids $agent)
   (let $rows (collapse (match &cc-sessions (ConsoleSessionV1 $sid $parent $_ $_ $_ $st $_ $u $_ $_ $_ $_ $_ $_ $_)
                (if (and (!= $sid $agent) (and (!= $parent "") (not (cli:member? $st ("done" "failed" "stopped" "interrupted" "finished")))))
                  ($u $sid) (empty))))
     (map-atom (list:sort-by cc:newer-ranked-num $rows) $pair (let ($_ $sid) $pair $sid))))
(= (cc:newer-ranked-num ($a $_) ($b $_)) (>= $a $b))
(= (cc:live-now)
   (if (cc:get "clock-live" False) (system:wall-time) (cc:get "last-event-time" (system:wall-time))))
(= (cc:spinner-frame $now)
   (let* (($frames ("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"))
          ($idx (% (math:floor (* $now 8)) 10)))
     (car-atom (list:drop $idx $frames))))
(= (cc:find-busy $sids $now)
   (if (== $sids ()) ConsoleNoDoingV1
     (let $d (cc:session-doing (car-atom $sids) $now)
       (case $d (((ConsoleDoingV1 $_ $_ $_ True $_ $_ $_) $d) ($idle (cc:find-busy (cdr-atom $sids) $now)))))))
(= (cc:set-changed $key $value) (if (== (cc:get $key ConsoleUnsetV1) $value) True (cc:set $key $value)))
(= (cc:activity-text $width)
   (let* (($now (cc:live-now))
          ($agent (cc:str-field (cc:settings) "agent" ""))
          ($work (cc:live-work-sids $agent))
          ($candidates (if (!= $agent "") (list:append $work ($agent)) $work))
          ($busy (cc:find-busy $candidates $now))
          ($menu (cc:get "menu" ())))
     (if (not (== $menu ()))
       (cc:clip (str:join "" ("menu open · type 1-" (repr (size-atom $menu)) " to choose, or /close-menu")) $width)
       (case $busy
         (((ConsoleDoingV1 $sid $word $since True $cmd $more $rsec)
           (let* (($_ (cc:set-changed "status-animated" True))
                  ($lead (str:join "" ((cc:spinner-frame $now) " " (cc:one-line $sid) " "))))
             (if (== $word "running")
               (let* (($elapsed (if (and (> $since 0) (>= $now $since)) (cc:span (- $now $since)) ""))
                      ($extra (if (> $more 0) (str:join "" (" (+" (repr $more) " more)")) ""))
                      ($tail (str:join "" ((if (!= $elapsed "") (str:concat " · " $elapsed) "") $extra)))
                      ($room (max 8 (- (- (- $width (terminal:cells $lead)) (terminal:cells $tail)) 8))))
                 (cc:clip (str:join "" ($lead "running " (cc:clip (cc:one-line $cmd) $room) $tail)) $width))
               (cc:clip (str:concat $lead (cc:doing-state-text $busy $now)) $width))))
          ($idle
           (let* (($_ (cc:set-changed "status-animated" False)) ($fault (cc:get "display-fault" "")))
             (if (!= $fault "") (cc:clip (cc:one-line $fault) $width)
               (cc:clip "Enter sends · Alt-Enter new line · /help commands · Ctrl-D detaches" $width)))))))))
(= (cc:status-fit $items $width)
   (let $text (str:join " · " (map-atom $items $it (let ($_ $s) $it $s)))
     (if (<= (terminal:cells $text) $width) $text
       (let $max-pri (foldl-atom $items 0 $m $it (let ($p $_) $it (max $m $p)))
         (if (<= $max-pri 0) (cc:clip $text $width)
           (cc:status-fit (cc:drop-last-pri $items $max-pri) $width))))))
(= (cc:drop-last-pri $items $pri)
   (list:reverse (cc:drop-first-pri (list:reverse $items) $pri)))
(= (cc:drop-first-pri $items $pri)
   (if (== $items ()) ()
     (let ($p $_) (car-atom $items)
       (if (== $p $pri) (cdr-atom $items) (cons-atom (car-atom $items) (cc:drop-first-pri (cdr-atom $items) $pri))))))
(= (cc:build-status-items $width $short-work)
   (let* (($now (cc:live-now))
          ($agent (cc:str-field (cc:settings) "agent" "agent"))
          ($facts (cc:get "facts" (JsonObject ())))
          ($mobj (sf:get $facts "model" (JsonObject ())))
          ($sess (cc:session-get $agent))
          ($sess-model (case $sess (((ConsoleSessionV1 $_ $_ $_ $m $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_) $m) ($n ""))))
          ($mname0 (cc:str-field $mobj "name" ""))
          ($mname (if (!= $mname0 "") $mname0 $sess-model))
          ($effort (cc:str-field $mobj "reasoningEffort" ""))
          ($model-str (if (== $mname "") "" (if (and (!= $effort "") (!= $effort "default")) (str:join " " ($mname $effort)) $mname)))
          ($call (sf:get $facts "call" (JsonObject ())))
          ($phase (cc:str-field $call "phase" ""))
          ($call-item (if (== $phase "backoff")
                        ((0 (str:join "" ("provider backoff"
                              (if (cc:has-num? $call "retrySeconds") (str:join "" (" · retry in " (repr (cc:num-field $call "retrySeconds" 0)) "s")) "")
                              (if (!= (cc:str-field $call "reason" "") "") (str:join "" (" (" (cc:one-line (cc:str-field $call "reason" "")) ")")) "")))))
                        (if (== $phase "blocked")
                          ((0 (str:join "" ("provider refused" (if (!= (cc:str-field $call "status" "") "") (str:concat " " (cc:one-line (cc:str-field $call "status" ""))) "")))))
                          (if (== $phase "failed")
                            ((1 (str:join "" ("last call failed" (if (!= (cc:str-field $call "reason" "") "") (str:join "" (" (" (cc:one-line (cc:str-field $call "reason" "")) ")")) "")))))
                            ()))))
          ($agent-item (case $sess
                         (((ConsoleSessionV1 $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_)
                           ((0 (cc:doing-state-text (cc:session-doing $agent $now) $now))))
                          ($none ((0 (if (!= $phase "") $phase "no activity seen yet")))))))
          ($works (cc:live-work-sids $agent))
          ($work-items (if (== $works ()) ()
                         (let* (($w0 (car-atom $works))
                                ($wlabel (if $short-work (cc:short-sid $w0) $w0))
                                ($wdoing (cc:doing-state-text (cc:session-doing $w0 $now) $now))
                                ($base ((1 (str:join " " ((cc:one-line $wlabel) $wdoing))))))
                           (if (> (size-atom $works) 1)
                             (list:append $base ((4 (str:join "" ("+" (repr (- (size-atom $works) 1)) " more sessions")))))
                             $base))))
          ($inbox (sf:get $facts "humanInbox" (JsonObject ())))
          ($queue-item (if (cc:has-num? $inbox "pending")
                         ((2 (str:concat "queue " (repr (cc:num-field $inbox "pending" 0))))) ()))
          ($last-call (case $sess
                        (((ConsoleSessionV1 $_ $_ $_ $_ $_ $st $_ $_ $_ $ct $_ $_ $_ $_ $_)
                          (if (and (>= $ct 0) (!= $st "thinking")) ((3 (str:concat "last call " (cc:span $ct)))) ()))
                         ($n ()))))
          ($pending (cc:get "pending-count" 0))
          ($pend-item (if (> $pending 0) ((0 (str:join "" ((repr $pending) " unconfirmed /retry")))) ()))
          ($fault-item (if (!= (cc:get "display-fault" "") "") ((0 "display backpressure")) ())))
     (list:append ((0 (cc:one-line (cc:display-name $agent))))
       (list:append (if (!= $model-str "") ((2 (cc:one-line $model-str))) ())
         (list:append $call-item (list:append $agent-item
           (list:append $work-items (list:append $queue-item (list:append $last-call (list:append $pend-item $fault-item))))))))))
(= (cc:status-text $width)
   (let* (($full-items (cc:build-status-items $width False))
          ($full-str (str:join " · " (map-atom $full-items $it (let ($_ $s) $it $s)))))
     (if (<= (terminal:cells $full-str) $width) $full-str
       (cc:status-fit (cc:build-status-items $width True) $width))))

; -- projection reset, scope check and main event entry point -----------------
(= (cc:projection-reset)
   (let* (($_ (collapse (match &cc-items $atom (remove-atom &cc-items $atom))))
          ($_ (collapse (match &cc-seen $atom (remove-atom &cc-seen $atom))))
          ($_ (collapse (match &cc-sessions $atom (remove-atom &cc-sessions $atom))))
          ($_ (cc:set "last-sid" "")) ($_ (cc:set "last-time" 0))
          ($_ (cc:set "last-text-key" "")) ($_ (cc:set "output-blank" True))
          ($_ (cc:set "last-event-time" 0))) True))
(= (cc:seen? $producer $sequence)
   (case (collapse (match &cc-seen (ConsoleSeenV1 $producer $n) $n))
     ((($last) (<= $sequence $last)) ($none False))))
(= (cc:event-in-scope? $event)
   (let* (($settings (cc:settings)) ($agent (cc:str-field $settings "agent" ""))
          ($sid (cc:str-field $event "session" ""))
          ($parent (cc:str-field $event "parent_session" ""))
          ($sess-parent (case (cc:session-get $sid) (((ConsoleSessionV1 $_ $p $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_ $_) $p) ($n ""))))
          ($mine (or (sf:get $settings "view_all" False)
                   (or (== $sid $agent) (or (== $parent $agent) (== $sess-parent $agent))))))
     (and (cc:get "stream-enabled" True)
          (and $mine (== (cc:str-field $event "epoch" "initial") (cc:get "stream-epoch" "initial"))))))
(= (cc:event $event $prime)
   (let* (($producer (cc:str-field $event "producer" ""))
          ($sequence (sf:get $event "sequence" JsonNull)))
     (if (or (not (cc:event-in-scope? $event))
             (or (!= (get-type $sequence) Number) (cc:seen? $producer $sequence))) True
       (let* (($_ (collapse (match &cc-seen (ConsoleSeenV1 $producer $old) (remove-atom &cc-seen (ConsoleSeenV1 $producer $old)))))
              ($_ (add-atom &cc-seen (ConsoleSeenV1 $producer $sequence)))
              ($sid (cc:str-field $event "session" "agent"))
              ($time (cc:num-field $event "time" 0))
              ($_ (if (> $time (cc:get "last-event-time" 0)) (cc:set "last-event-time" $time) True))
              ($_ (cc:session-ensure $sid $event))
              ($kind (cc:str-field $event "kind" ""))
              ($_ (cc:set "dirty" True))
              ($_ (case $kind
                    (("attempt.open" (cc:attempt-open $event))
                     ("attempt.finished" (cc:attempt-finished $event $prime))
                     ("session.open"
                      (let $title (cc:str-field $event "text" $sid)
                        (case (cc:session-get $sid)
                          (((ConsoleSessionV1 $sid $p $inst $m $_ $st $s $u $cs $ct $pl $g $rsn $rs $rsec)
                            (cc:session-put (ConsoleSessionV1 $sid $p $inst $m $title $st $s $u $cs $ct $pl $g $rsn $rs $rsec)))
                           ($n True)))))
                     ("session.finished" (cc:handle-session-finished $event $prime))
                     ("text.delta" (cc:text-event $event False False $prime))
                     ("text.snapshot" (cc:text-event $event True True $prime))
                     ("text.reconcile" (cc:text-event $event True True $prime))
                     ("tool.forming" (cc:tool-event $event $prime))
                     ("tool.dispatching" (cc:tool-event $event $prime))
                     ("tool.started" (cc:tool-event $event $prime))
                     ("tool.output" (cc:tool-event $event $prime))
                     ("tool.finished" (cc:tool-event $event $prime))
                     ("patch" (cc:tool-event $event $prime))
                     ("steering" (cc:tool-event $event $prime))
                     ("maintenance" (progn (cc:session-clear-rest $sid) (cc:tool-event $event $prime)))
                     ("plan" (cc:handle-plan $event $prime))
                     ("gap" (cc:handle-gap $sid (cc:str-field $event "text" "observation gap") $prime))
                     ($other True))))
              ($dgap (sf:get $event "display_gap" JsonNull))
              ($_ (if (and (!= $dgap JsonNull) (and (!= $dgap 0) (!= $dgap "")))
                    (cc:handle-gap $sid $dgap $prime) True)))
         True))))
