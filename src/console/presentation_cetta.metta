; An observation-only projection. Event payloads and command descriptions are
; text data. Only the renderer supplies terminal controls; it owns no agent
; command, acknowledgement or effect replay path.
!(import! &self ./session_cetta.metta)
!(bind! &cc-items (new-space))
!(bind! &cc-seen (new-space))
(= (cc:clean $text)
   (terminal:clean (if (== (get-type $text) String) $text (repr (quote $text)))))
(= (cc:one-line $text)
   (str:join " " (str:split "\n" (str:join " " (str:split "\t" (cc:clean $text))))))
(= (cc:note $text)
   (let* (($clean (cc:clean $text)) ($queued (cc:get "events" ConsoleNoBufferV1))
          ($bounded (if (and (not (cc:get "viewer-full" False)) (> (str:byte-length $clean) 131072))
            (str:concat (str:char-slice $clean 0 16000) "\n[display folded; original retained in its source record]") $clean))
          ($answer (buffer:append $queued (str:concat $bounded "\n"))))
     (case $answer
       (((HostBuffered $_) (progn (cc:set "dirty" True) True))
        ($bad (progn (cc:set "display-fault" "Terminal backpressure; original events remain in their source files.") False))))))
(= (cc:item $key)
   (case (collapse (match &cc-items (ConsoleItemV1 $key $value) $value)) ((($one) $one) ($none ConsoleNoItemV1))))
(= (cc:item-set $key $value)
   (let $_ (collapse (match &cc-items (ConsoleItemV1 $key $old) (remove-atom &cc-items (ConsoleItemV1 $key $old))))
     (add-atom &cc-items (ConsoleItemV1 $key $value))))
(= (cc:event-key $event)
   (str:sha256 (json:stringify-python (JsonArray ((sf:get $event "epoch" "initial") (sf:get $event "session" "")
     (sf:get $event "attempt" "") (sf:get $event "item" "")
     (if (str:starts-with (sf:get $event "kind" "") "tool.") "tool" (sf:get $event "channel" ""))
     (if (str:starts-with (sf:get $event "kind" "") "tool.") "tool" "text"))))))
(= (cc:item-open $key $event $prime)
   (let* (($full (buffer:new 33554432 bytes)) ($pending (buffer:new 33554432 bytes))
          ($who (sf:get $event "session" "?"))
          ($kind (if (str:starts-with (sf:get $event "kind" "") "tool.") "tool output" (sf:get $event "channel" "text")))
          ($epoch (sf:get $event "epoch" "initial")) ($session (sf:get $event "session" "")) ($attempt (sf:get $event "attempt" ""))
          ($_ (cc:item-set $key (ConsoleTextV1 $full $pending 0)))
          ($_ (add-atom &cc-items (ConsoleItemOwnerV1 $key $epoch $session $attempt)))
          ($_ (if $prime True (cc:note (str:join "" ($who " · " $kind)))))) (ConsoleTextV1 $full $pending 0)))
(= (cc:flush-item $key $full $pending $emitted $final)
   (let (HostBufferInfo $size $_) (buffer:info $pending)
     (if (and (> $size 0) (or $final (or (>= $size 120) (buffer:line-ready? $pending))))
       (let* (($text (buffer:value $pending)) ($queued (cc:note (str:concat "  " $text))))
         (if $queued (progn (buffer:drop $pending $size)
                       (cc:item-set $key (ConsoleTextV1 $full $pending (+ $emitted $size))))
           (cc:item-set $key (ConsoleTextV1 $full $pending $emitted))))
       (cc:item-set $key (ConsoleTextV1 $full $pending $emitted)))))
; A one-shot reader must show even a short, still-open item. Flushing a view
; neither closes the item nor manufactures a completion/receipt event.
(= (cc:flush-visible-items)
   (map-atom (collapse (match &cc-items (ConsoleItemV1 $key (ConsoleTextV1 $full $pending $emitted))
                (ConsolePendingV1 $key $full $pending $emitted))) $item
     (let (ConsolePendingV1 $key $full $pending $emitted) $item
       (cc:flush-item $key $full $pending $emitted True))))
(= (cc:text-event $event $snapshot $final $prime)
   (let* (($key (cc:event-key $event)) ($text (sf:get $event "text" ""))
          ($previous (cc:item $key))
          ($state (if (== $previous ConsoleNoItemV1) (cc:item-open $key $event $prime) $previous)))
     (case $state
       (((ConsoleClosedTextV1 $digest)
         (if (and $snapshot (!= (str:sha256 $text) $digest))
           (progn (if $prime True (cc:note (str:concat "Reconciled text: " $text)))
                  (cc:item-set $key (ConsoleClosedTextV1 (str:sha256 $text)))) True))
        ((ConsoleTextV1 $full $pending $emitted)
         (let* (($old (if $snapshot (buffer:value $full) ""))
                ($matches (and $snapshot (str:starts-with $text $old)))
                ($append (if $snapshot
                   (if $matches (str:byte-slice $text (str:byte-length $old) (str:byte-length $text)) $text) $text))
                ($_ (if (and $snapshot (not $matches))
                      (progn (buffer:drop $full (str:byte-length $old))
                             (let (HostBufferInfo $n $_) (buffer:info $pending) (buffer:drop $pending $n))
                             (if $prime True (cc:note "Reconciled text replaces the earlier display:"))) True))
                ($a (buffer:append $full $append))
                ($b (if $prime (HostBuffered 0) (buffer:append $pending $append))))
           (if (or (cc:buffer-failed? $a) (cc:buffer-failed? $b))
             (cc:note "Display item exceeds its working buffer; inspect the retained source event.")
             (let* (($_ (if $prime True (cc:flush-item $key $full $pending $emitted $final)))
                    ($_ (if $final
                         (let $digest (str:sha256 (buffer:value $full))
                           (progn (host:close $full) (host:close $pending) (cc:item-set $key (ConsoleClosedTextV1 $digest)))) True))) True))))
        ($bad (cc:note "Unknown display item; source event retained."))))))
(= (cc:buffer-failed? $value) (case $value (((HostFailure $_ $_ $_) True) ($other False))))
(= (cc:seal-key $key $prime)
   (case (cc:item $key)
     (((ConsoleTextV1 $full $pending $emitted)
       (let* (($_ (if $prime True (cc:flush-item $key $full $pending $emitted True)))
              ($digest (str:sha256 (buffer:value $full)))
              ($_ (host:close $full)) ($_ (host:close $pending)))
         (cc:item-set $key (ConsoleClosedTextV1 $digest))))
      ($closed True))))
(= (cc:finish-attempt $event $prime)
   (let* (($epoch (sf:get $event "epoch" "initial")) ($session (sf:get $event "session" ""))
          ($attempt (sf:get $event "attempt" ""))
          ($keys (collapse (match &cc-items (ConsoleItemOwnerV1 $key $epoch $session $attempt) $key))))
     (map-atom $keys $key (cc:seal-key $key $prime))))
(= (cc:finish-tool $event $prime)
   (if (!= (sf:get $event "text" "") "") (cc:text-event $event True True $prime)
     (cc:seal-key (cc:event-key $event) $prime)))
(= (cc:projection-reset)
   (let* (($_ (collapse (match &cc-items (ConsoleItemV1 $key $state)
                (progn (case $state (((ConsoleTextV1 $full $pending $_) (progn (host:close $full) (host:close $pending))) ($closed True)))
                       (remove-atom &cc-items (ConsoleItemV1 $key $state))))))
          ($_ (collapse (match &cc-items (ConsoleItemOwnerV1 $key $epoch $session $attempt)
                (remove-atom &cc-items (ConsoleItemOwnerV1 $key $epoch $session $attempt)))))
          ($_ (collapse (match &cc-seen (ConsoleSeenV1 $producer $sequence)
                (remove-atom &cc-seen (ConsoleSeenV1 $producer $sequence)))))) True))
(= (cc:seen? $producer $sequence)
   (case (collapse (match &cc-seen (ConsoleSeenV1 $producer $n) $n))
     ((($last) (<= $sequence $last)) ($none False))))
(= (cc:event-in-scope? $event)
   (let* (($settings (cc:settings)) ($agent (sf:get $settings "agent" ""))
          ($mine (or (sf:get $settings "view_all" False)
                  (or (== (sf:get $event "session" "") $agent) (== (sf:get $event "parent_session" "") $agent)))))
     (and (cc:get "stream-enabled" True)
          (and $mine (== (sf:get $event "epoch" "initial") (cc:get "stream-epoch" "initial"))))))
(= (cc:event $event $prime)
   (let* (($producer (sf:get $event "producer" "")) ($sequence (sf:get $event "sequence" 0)))
     (if (or (not (cc:event-in-scope? $event))
             (or (!= (get-type $sequence) Number) (cc:seen? $producer $sequence))) True
       (let* (($_ (collapse (match &cc-seen (ConsoleSeenV1 $producer $old) (remove-atom &cc-seen (ConsoleSeenV1 $producer $old)))))
              ($_ (add-atom &cc-seen (ConsoleSeenV1 $producer $sequence)))
              ($kind (sf:get $event "kind" ""))
              ($_ (cc:set "activity" (str:join " · " ((sf:get $event "session" "?") $kind)))))
         (case $kind
           (("text.delta" (cc:text-event $event False False $prime))
            ("tool.output" (cc:text-event $event False False $prime))
            ("text.snapshot" (cc:text-event $event True False $prime))
            ("text.reconcile" (cc:text-event $event True True $prime))
            ("tool.finished" (progn (cc:finish-tool $event $prime) (if $prime True
                (cc:note (str:join "" ((sf:get $event "session" "?") " · tool finished · status="
                  (sf:get $event "status" "not reported") " · source=" (sf:get $event "source" "not reported")))))))
            ("attempt.finished" (progn (cc:finish-attempt $event $prime) (if $prime True
                (cc:note (str:join "" ((sf:get $event "session" "?") " · attempt finished · " (sf:get $event "status" "not reported")))))))
            ($other (if $prime True
              (cc:note (str:join "" ((sf:get $event "session" "?") " · " $kind
                (if (== (sf:get $event "source" "") "executor") "" " [reported]")
                (if (!= (sf:get $event "status" "") "") (str:concat " · " (sf:get $event "status" "")) "")
                (if (!= (sf:get $event "command" "") "") (str:concat " · " (cc:one-line (sf:get $event "command" ""))) "")
                (if (!= (sf:get $event "text" "") "") (str:concat "\n" (sf:get $event "text" "")) ""))))))))))))
