!(import! &self ./render_cetta.metta)
!(bind! &cc-history (new-space))
(= (cc:help)
   "Enter sends; Alt-Enter or Ctrl-J inserts a newline. Paste keeps its lines.\n/ models, model, modes, engines, fuel, energy, activity, health, quota, wake, start, stop: shared agent controls\n/status: current structured status; /retry: original pending input IDs; /replies: local reply archive\n/close-menu: close the current menu; a displayed number chooses a menu item\n/detach or Ctrl-D on an empty draft: detach while cognition continues; //text sends a leading slash\nCtrl-C interrupts the draft. Undo: Ctrl-Z, Ctrl-_, or Ctrl-X u; Redo: Ctrl-X r or Alt-U.\nArrows edit or browse history; Ctrl-R starts incremental reverse search (Ctrl-R older, Ctrl-S newer, Enter accept, Ctrl-G cancel).")
(= (cc:editor-reset)
   (let* (($u1 (cc:set "undo-stack" ()))
          ($u2 (cc:set "redo-stack" ()))
          ($u3 (cc:set "undo-group" ""))
          ($u4 (cc:set "key-prefix" ""))
          ($s1 (cc:set "search-active" False))
          ($s2 (cc:set "search-dir" "reverse"))
          ($s3 (cc:set "search-query" ""))
          ($s4 (cc:set "search-match" -1))
          ($s5 (cc:set "search-match-pos" 0))
          ($s6 (cc:set "search-match-total" 0)))
     True))
(= (cc:history-put $text)
   (let* (($number (cc:get "history-count" 0))
          ($added (add-atom &cc-history (ConsoleHistoryV1 $number $text)))
          ($inc (+ $number 1))
          ($saved (cc:set "history-count" $inc)))
     True))
(= (cc:history-at $index)
   (case (collapse (match &cc-history (ConsoleHistoryV1 $index $text) $text))
     ((($text) (Some $text)) ($missing None))))
(= (cc:history-save $text)
   (let* (($when (system:format-time "%Y-%m-%d %H:%M:%S" (system:wall-time) "local"))
          ($lines (map-atom (str:split "\n" $text) $line (str:concat "+" $line)))
          ($record (str:join "" ("\n# " $when "\n" (str:join "\n" $lines) "\n")))
          ($saved (fs:append-text (path:join (cc:client) "history") $record)))
     (progn (if (sf:failed? $saved) (cc:note "History write unavailable; draft and input receipt are separate.") True)
       (cc:history-put $text) (cc:set "history-index" (cc:get "history-count" 0)))))
(= (cc:history-lines $input $record $left)
   (if (<= $left 0) True
     (case (buffer:line $input)
       (((HostLine $line)
         (progn (cc:history-line $line $record) (cc:history-lines $input $record (- $left 1))))
        ($pending True)))))
; As prompt_toolkit's FileHistory reads it: an entry is a run of "+" lines
; joined by newlines, and any other line ends it. Lines are counted, not
; inferred from the buffer, so an entry whose first line is empty keeps it.
(= (cc:history-line $line $record)
   (if (str:starts-with $line "+")
     (let* (($lines (cc:get "history-record-lines" 0))
            ($text (str:byte-slice $line 1 (str:byte-length $line)))
            ($app (buffer:append $record (str:concat (if (> $lines 0) "\n" "") $text)))
            ($inc (+ $lines 1))
            ($set (cc:set "history-record-lines" $inc)))
       True)
     (cc:history-flush $record)))
(= (cc:history-flush $record)
   (if (> (cc:get "history-record-lines" 0) 0)
     (let (HostBufferInfo $size $cur) (buffer:info $record)
       (progn (cc:history-put (buffer:value $record))
              (if (> $size 0) (buffer:drop $record $size) True)
              (cc:set "history-record-lines" 0)))
     True))
(= (cc:history-read $file $input $record)
   (case (fs:read-chunk $file 65536)
     (((fs:chunk $bytes $start)
       (progn (buffer:append $input $bytes) (cc:history-lines $input $record 65536) (cc:history-read $file $input $record)))
      ((fs:end $pos) (cc:history-flush $record))
      ($bad (cc:note "History is unavailable; its file was preserved.")))))
(= (cc:history-load)
   (let $path (path:join (cc:client) "history")
     (if (not (fs:is-file $path)) True
       (let* (($file (fs:open-read $path)) ($input (buffer:new 33554432 bytes)) ($record (buffer:new 33554432 bytes))
              ($r0 (cc:set "history-record-lines" 0))
              ($r1 (cc:history-read $file $input $record)) ($r2 (fs:close $file))
              ($r3 (host:close $input)) ($r4 (host:close $record))
              ($r5 (cc:set "history-index" (cc:get "history-count" 0))))
         True))))
(= (cc:replace-draft $text)
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1)) ($cleared (buffer:edit $editor "clear"))
          ($inserted (buffer:insert $editor $text)))
     (if (cc:buffer-failed? $inserted) (cc:note "Draft insertion refused; inspect its retained source.")
       (progn (cc:set "dirty" True) (cc:set "draft-dirty" True)))))
(= (cc:seek-left $editor $target $prev)
   (let (HostBufferInfo $size $cursor) (buffer:info $editor)
     (if (or (<= $cursor $target) (== $cursor $prev)) True
       (progn (buffer:edit $editor "left") (cc:seek-left $editor $target $cursor)))))
(= (cc:seek-right $editor $target $prev)
   (let (HostBufferInfo $size $cursor) (buffer:info $editor)
     (if (or (>= $cursor $target) (== $cursor $prev)) True
       (progn (buffer:edit $editor "right") (cc:seek-right $editor $target $cursor)))))
(= (cc:restore-cursor $editor $target)
   (let (HostBufferInfo $size $cursor) (buffer:info $editor)
     (if (<= $target 0) (buffer:edit $editor "start")
       (if (>= $target $size) (buffer:edit $editor "end")
         (if (< $target (- $size $target))
           (progn (buffer:edit $editor "start") (cc:seek-right $editor $target -1))
           (progn (buffer:edit $editor "end") (cc:seek-left $editor $target -1)))))))
(= (cc:snapshot)
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1))
          ((HostBufferInfo $size $cursor) (buffer:info $editor)))
     (EditorSnapV1 (buffer:value $editor) $cursor)))
(= (cc:apply-snapshot (EditorSnapV1 $text $cursor))
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1))
          ($rep (cc:replace-draft $text))
          ($cur (cc:restore-cursor $editor $cursor)))
     True))
(= (cc:stack-push $key $snap)
   (let* (($stack (cc:get $key ()))
          ($dup (if (== $stack ()) False (== (car-atom $stack) $snap))))
     (if $dup True
       (cc:set $key (list:take 128 (cons-atom $snap $stack))))))
(= (cc:undo-record $before $group)
   (let $after (cc:snapshot)
     (if (== $before $after) True
       (let* (($clear-redo (cc:set "redo-stack" ()))
              ($same-group (and (!= $group "") (== $group (cc:get "undo-group" "")))))
         (if $same-group True
           (progn (cc:stack-push "undo-stack" $before)
                  (cc:set "undo-group" $group)))))))
(= (cc:undo)
   (let* (($reset-group (cc:set "undo-group" ""))
          ($stack (cc:get "undo-stack" ())))
     (if (== $stack ()) True
       (let* (($target (car-atom $stack))
              ($rest (cdr-atom $stack))
              ($now (cc:snapshot))
              ($s1 (cc:stack-push "redo-stack" $now))
              ($s2 (cc:set "undo-stack" $rest)))
         (cc:apply-snapshot $target)))))
(= (cc:redo)
   (let* (($reset-group (cc:set "undo-group" ""))
          ($stack (cc:get "redo-stack" ())))
     (if (== $stack ()) True
       (let* (($target (car-atom $stack))
              ($rest (cdr-atom $stack))
              ($now (cc:snapshot))
              ($s1 (cc:stack-push "undo-stack" $now))
              ($s2 (cc:set "redo-stack" $rest)))
         (cc:apply-snapshot $target)))))
(= (cc:text-group $text)
   (if (!= (str:char-length $text) 1) ""
     (if (or (== $text " ") (or (== $text "\t") (== $text "\n"))) "insert-space" "insert-word")))
(= (cc:history-move $direction)
   (let* (($before (cc:snapshot))
          ($count (cc:get "history-count" 0)) ($at (cc:get "history-index" $count))
          ($next (max 0 (min $count (+ $at $direction))))
          ($save-cur (if (== $at $count) (cc:set "history-draft" (buffer:value (cc:get "editor" ConsoleNoEditorV1))) True)))
     (progn (if (== $next $count) (cc:replace-draft (cc:get "history-draft" ""))
       (case (cc:history-at $next)
         (((Some $text) (cc:replace-draft $text)) ($missing True))))
       (cc:set "history-index" $next)
       (cc:undo-record $before ""))))
; Smart-case substring match: lowercase queries match case-insensitively,
; queries containing uppercase match case-sensitively.
(= (cc:search-match? $haystack $needle)
   (if (== $needle "") True
     (let* (($lower-needle (str:lower $needle))
            ($fold (== $needle $lower-needle))
            ($hay (if $fold (str:lower $haystack) $haystack))
            ($at (str:find $hay $needle)))
       (== (get-type $at) Number))))
(= (cc:search-find-back $at $needle)
   (if (< $at 0) -1
     (case (cc:history-at $at)
       (((Some $text) (if (cc:search-match? $text $needle) $at (cc:search-find-back (- $at 1) $needle)))
        ($missing (cc:search-find-back (- $at 1) $needle))))))
(= (cc:search-find-fwd $at $count $needle)
   (if (>= $at $count) -1
     (case (cc:history-at $at)
       (((Some $text) (if (cc:search-match? $text $needle) $at (cc:search-find-fwd (+ $at 1) $count $needle)))
        ($missing (cc:search-find-fwd (+ $at 1) $count $needle))))))
(= (cc:search-stats $at $needle $target $total $pos)
   (if (< $at 0) ($pos $total)
     (case (cc:history-at $at)
       (((Some $text)
         (if (cc:search-match? $text $needle)
           (let $next (+ $total 1)
             (cc:search-stats (- $at 1) $needle $target $next (if (== $at $target) $next $pos)))
           (cc:search-stats (- $at 1) $needle $target $total $pos)))
        ($missing (cc:search-stats (- $at 1) $needle $target $total $pos))))))
(= (cc:search-apply $found $needle)
   (if (< $found 0)
     (let* (($s1 (cc:set "search-match" -1))
            ($s2 (cc:set "search-match-pos" 0))
            ($s3 (cc:set "search-match-total" 0))
            ($s4 (cc:set "dirty" True)))
       True)
     (let* (($count (cc:get "history-count" 0))
            (($pos $total) (cc:search-stats (- $count 1) $needle $found 0 0))
            ($s1 (cc:set "search-match" $found))
            ($s2 (cc:set "search-match-pos" $pos))
            ($s3 (cc:set "search-match-total" $total))
            ($s4 (cc:set "history-index" $found))
            ($preview (case (cc:history-at $found)
                        (((Some $text) (cc:replace-draft $text)) ($missing True)))))
       True)))
(= (cc:search-start $dir)
   (let* (($count (cc:get "history-count" 0))
          ($snap (cc:snapshot))
          ($s1 (cc:set "search-saved-snap" $snap))
          ($s2 (cc:set "search-saved-hist" (cc:get "history-index" $count)))
          ($s3 (cc:set "search-active" True))
          ($s4 (cc:set "search-dir" $dir))
          ($s5 (cc:set "search-query" ""))
          ($s6 (cc:set "key-prefix" ""))
          ($s7 (cc:set "undo-group" ""))
          ($found (if (<= $count 0) -1
                    (if (== $dir "forward") (cc:search-find-fwd 0 $count "")
                      (cc:search-find-back (- $count 1) "")))))
     (cc:search-apply $found "")))
(= (cc:search-cancel)
   (let* (($saved (cc:get "search-saved-snap" (EditorSnapV1 "" 0)))
          ($hist (cc:get "search-saved-hist" (cc:get "history-count" 0)))
          ($s1 (cc:set "search-active" False))
          ($s2 (cc:set "search-query" ""))
          ($s3 (cc:set "search-match" -1))
          ($s4 (cc:set "search-match-pos" 0))
          ($s5 (cc:set "search-match-total" 0))
          ($s6 (cc:set "history-index" $hist))
          ($s7 (cc:apply-snapshot $saved)))
     True))
(= (cc:search-accept)
   (let* (($saved (cc:get "search-saved-snap" (EditorSnapV1 "" 0)))
          ($match (cc:get "search-match" -1))
          ($s1 (cc:set "search-active" False))
          ($s2 (cc:set "search-query" ""))
          ($s3 (cc:set "search-match" -1))
          ($s4 (cc:set "search-match-pos" 0))
          ($s5 (cc:set "search-match-total" 0)))
     (if (< $match 0)
       (let* (($hist (cc:get "search-saved-hist" (cc:get "history-count" 0)))
              ($s6 (cc:set "history-index" $hist)))
         (cc:apply-snapshot $saved))
       (cc:undo-record $saved ""))))
(= (cc:search-update $query)
   (let* (($count (cc:get "history-count" 0))
          ($dir (cc:get "search-dir" "reverse"))
          ($cur (cc:get "search-match" -1))
          ($set-q (cc:set "search-query" $query))
          ($start (if (>= $cur 0) $cur (if (== $dir "forward") 0 (- $count 1))))
          ($found (if (<= $count 0) -1
                    (if (== $dir "forward")
                      (cc:search-find-fwd $start $count $query)
                      (cc:search-find-back $start $query)))))
     (cc:search-apply $found $query)))
(= (cc:search-step-back)
   (let* (($q (cc:get "search-query" ""))
          ($count (cc:get "history-count" 0))
          ($cur (cc:get "search-match" -1))
          ($set-d (cc:set "search-dir" "reverse"))
          ($found (if (<= $count 0) -1
                    (if (>= $cur 0) (cc:search-find-back (- $cur 1) $q)
                      (cc:search-find-back (- $count 1) $q)))))
     (cc:search-apply $found $q)))
(= (cc:search-step-fwd)
   (let* (($q (cc:get "search-query" ""))
          ($count (cc:get "history-count" 0))
          ($cur (cc:get "search-match" -1))
          ($set-d (cc:set "search-dir" "forward"))
          ($found (if (<= $count 0) -1
                    (if (>= $cur 0) (cc:search-find-fwd (+ $cur 1) $count $q)
                      (cc:search-find-fwd 0 $count $q)))))
     (cc:search-apply $found $q)))
(= (cc:search-backspace)
   (let* (($q (cc:get "search-query" ""))
          ($n (str:char-length $q))
          ($next (if (<= $n 0) "" (str:char-slice $q 0 (- $n 1))))
          ($count (cc:get "history-count" 0))
          ($dir (cc:get "search-dir" "reverse"))
          ($set-q (cc:set "search-query" $next))
          ($found (if (<= $count 0) -1
                    (if (== $dir "forward")
                      (cc:search-find-fwd 0 $count $next)
                      (cc:search-find-back (- $count 1) $next)))))
     (cc:search-apply $found $next)))
(= (cc:search-key $name $text)
   (case $name
     (("text" (cc:search-update (str:concat (cc:get "search-query" "") $text)))
      ("paste"
       (let $norm (str:join "\n" (str:split "\r" (str:join "\n" (str:split "\r\n" $text))))
         (cc:search-update (str:concat (cc:get "search-query" "") $norm))))
      ("backspace" (cc:search-backspace))
      ("ctrl-h" (cc:search-backspace))
      ("ctrl-r" (cc:search-step-back))
      ("ctrl-s" (cc:search-step-fwd))
      ("ctrl-g" (cc:search-cancel))
      ("ctrl-c" (cc:search-cancel))
      ("enter" (cc:search-accept))
      ("escape" (cc:search-accept))
      ("paste-start" True)
      ("paste-end" True)
      ($other (progn (cc:search-accept) (cc:normal-key $name $text))))))
(= (cc:split-command $text)
   (case (str:find $text " ")
     (((TextNotFound $missing) ($text ""))
      ($at ((str:byte-slice $text 0 $at) (str:byte-slice $text (+ $at 1) (str:byte-length $text)))))))
(= (cc:submit-draft)
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1)) ($text (buffer:value $editor))
          ($trimmed (str:trim $text)))
     (if (== $trimmed "") True
       (let* (($h1 (cc:history-save $text)) ($e1 (cc:set "view-epoch" (+ (cc:get "view-epoch" 0) 1)))
              ($em (cc:emit-user-input $text))
              ($u0 (cc:editor-reset)))
         (if (str:starts-with $text "//") (cc:publish-text (str:byte-slice $text 1 (str:byte-length $text)))
          (if (or (str:starts-with $text "/") (and (not (== (cc:get "menu" ()) ())) (str:is-all-in digit $text)))
           (progn (cc:command $text) (cc:replace-draft ""))
           (cc:publish-text $text)))))))
(= (cc:publish-text $text)
   (let $record (cm:prepare (cc:settings) $text)
     (case $record
       (((ConsoleFailureV1 $why) (cc:note $why))
        ($ok
         (let* (($id (sf:get $record "id" ""))
                ($path (cm:path (cc:settings) "pending" $id))
                ($pub (cc:mail-request "publish" ((JsonPair "path" $path))))
                ($clr (cc:replace-draft "")) ($upd (cc:update-pending)))
           True))))))
(= (cc:command $text)
   (case $text
     (("/detach" (cc:set "stop" True)) ("/quit" (cc:set "stop" True))
      ("/help" (cc:note (cc:help)))
      ("/retry" (cc:mail-request "retry" ()))
      ("/close-menu" (progn (cc:set "menu" ()) (cc:note "Menu closed.")))
      ("/status" (cc:control "status" ()))
      ("/replies" (cc:archive-all))
      ($other
       (if (str:starts-with $text "//")
         (cc:publish-text (str:byte-slice $text 1 (str:byte-length $text)))
         (let $menu (cc:get "menu" ())
           (if (and (not (== $menu ())) (str:is-all-in digit $text))
             (let $number (cli:number $text 0)
               (if (and (> $number 0) (<= $number (size-atom $menu)))
                 (let* (((JsonArray ($label $value)) (car-atom (list:drop (- $number 1) $menu)))
                        ($clr (cc:set "menu" ())))
                   (cc:control "choice" ((JsonPair "value" $value))))
                 (cc:note "Choose a displayed number, or /close-menu.")))
             (let* ((($name $arguments) (cc:split-command $text)) ($clr (cc:set "menu" ())))
               (cc:control "command" ((JsonPair "name" $name) (JsonPair "arguments" $arguments)))))))))))
(= (cc:prefix-key $prefix $name $text)
   (let $clr (cc:set "key-prefix" "")
     (if (== $prefix "ctrl-x")
       (case $name
         (("text" (if (or (== $text "u") (== $text "U")) (cc:undo)
                    (if (or (== $text "r") (== $text "R")) (cc:redo) True)))
          ("ctrl-u" (cc:undo))
          ("ctrl-r" (cc:redo))
          ("ctrl-z" (cc:redo))
          ($other True)))
       (if (== $prefix "escape")
         (case $name
           (("text" (if (or (== $text "u") (== $text "U")) (cc:redo)
                      (if (or (== $text "r") (== $text "R")) (cc:redo)
                        (cc:normal-key $name $text))))
            ($other (cc:normal-key $name $text))))
         (cc:normal-key $name $text)))))
(= (cc:key $name $text)
   (if (cc:get "search-active" False)
     (cc:search-key $name $text)
     (let $prefix (cc:get "key-prefix" "")
       (if (!= $prefix "")
         (cc:prefix-key $prefix $name $text)
         (cc:normal-key $name $text)))))
(= (cc:undo-key? $name)
   (or (== $name "ctrl-z")
     (or (== $name "ctrl-_")
         (== $name (str:concat "ctrl-" (str:from-python-codepoints (127)))))))
(= (cc:normal-key $name $text)
   (if (cc:undo-key? $name) (cc:undo)
    (let $editor (cc:get "editor" ConsoleNoEditorV1)
      (case $name
        (("text"
          (let* (($before (cc:snapshot))
                 ($res (buffer:insert $editor $text)))
            (progn (cc:undo-record $before (cc:text-group $text)) $res)))
         ("paste"
          (let* (($before (cc:snapshot))
                 ($norm (str:join "\n" (str:split "\r" (str:join "\n" (str:split "\r\n" $text)))))
                 ($res (buffer:insert $editor $norm)))
            (progn (cc:undo-record $before "") $res)))
         ("enter" (cc:submit-draft))
         ("alt-enter"
          (let* (($before (cc:snapshot)) ($res (buffer:insert $editor "\n")))
            (progn (cc:undo-record $before "") $res)))
         ("lf"
          (let* (($before (cc:snapshot)) ($res (buffer:insert $editor "\n")))
            (progn (cc:undo-record $before "") $res)))
         ("tab"
          (let* (($before (cc:snapshot)) ($res (buffer:insert $editor "\t")))
            (progn (cc:undo-record $before "") $res)))
         ("ctrl-c"
          (let $before (cc:snapshot)
            (progn (cc:replace-draft "") (cc:undo-record $before "")
                   (cc:note "Draft interrupted; cognition continues."))))
         ("ctrl-d"
          (let (HostBufferInfo $size $cur) (buffer:info $editor)
            (if (== $size 0) (cc:set "stop" True)
              (let* (($before (cc:snapshot)) ($res (buffer:edit $editor "delete")))
                (progn (cc:undo-record $before "delete") $res)))))
         ("ctrl-a" (progn (cc:set "undo-group" "") (buffer:edit $editor "home")))
         ("ctrl-e" (progn (cc:set "undo-group" "") (buffer:edit $editor "line-end")))
         ("ctrl-b" (progn (cc:set "undo-group" "") (buffer:edit $editor "left")))
         ("ctrl-f" (progn (cc:set "undo-group" "") (buffer:edit $editor "right")))
         ("ctrl-k" (cc:kill $editor "kill-line"))
         ("ctrl-u" (cc:kill $editor "kill-start"))
         ("ctrl-w" (cc:kill $editor "kill-word"))
         ("ctrl-y"
          (let* (($before (cc:snapshot)) ($res (buffer:insert $editor (cc:get "kill-ring" ""))))
            (progn (cc:undo-record $before "") $res)))
         ("ctrl-x" (cc:set "key-prefix" "ctrl-x"))
         ("escape" (cc:set "key-prefix" "escape"))
         ("ctrl-r" (cc:search-start "reverse"))
         ("ctrl-s" (cc:search-start "forward"))
         ("backspace"
          (let* (($before (cc:snapshot)) ($res (buffer:edit $editor "backspace")))
            (progn (cc:undo-record $before "delete") $res)))
         ("ctrl-h"
          (let* (($before (cc:snapshot)) ($res (buffer:edit $editor "backspace")))
            (progn (cc:undo-record $before "delete") $res)))
         ("delete"
          (let* (($before (cc:snapshot)) ($res (buffer:edit $editor "delete")))
            (progn (cc:undo-record $before "delete") $res)))
         ("up"
          (progn (cc:set "undo-group" "")
            (case (buffer:edit $editor "up") ((HostAtBoundary (cc:history-move -1)) ($moved True)))))
         ("down"
          (progn (cc:set "undo-group" "")
            (case (buffer:edit $editor "down") ((HostAtBoundary (cc:history-move 1)) ($moved True)))))
         ($other
          (if (cli:member? $name ("left" "right" "home" "line-end" "word-left" "word-right"))
            (progn (cc:set "undo-group" "") (buffer:edit $editor $name))
            True)))))))
(= (cc:kill $editor $operation)
   (let* (($before-text (buffer:value $editor)) ((HostBufferInfo $old-size $old-cursor) (buffer:info $editor))
          ($before (EditorSnapV1 $before-text $old-cursor))
          ($result (buffer:edit $editor $operation)) ((HostBufferInfo $new-size $new-cursor) (buffer:info $editor))
          ($removed (- $old-size $new-size))
          ($kr (if (> $removed 0) (cc:set "kill-ring" (str:byte-slice $before-text $new-cursor (+ $new-cursor $removed))) True))
          ($ur (cc:undo-record $before "")))
     $result))
(= (cc:keys $input $flush $left)
   (if (<= $left 0) True
     (case (buffer:input-event $input $flush)
       (((HostInput $name $text)
         (progn (cc:key $name $text) (cc:set "dirty" True) (cc:set "draft-dirty" True)
                (cc:keys $input wait (- $left 1))))
        (HostPending True)
        ($failure (cc:note "Terminal input decoder refused a frame; draft retained."))))))
(= (cc:save-draft)
   (let* (($snap (if (cc:get "search-active" False)
                   (cc:get "search-saved-snap" (EditorSnapV1 "" 0))
                   (cc:snapshot)))
          ((EditorSnapV1 $text $cursor) $snap)
          ($record (JsonObject ((JsonPair "text" $text) (JsonPair "cursor_bytes" $cursor))))
          ($saved (cm:store (path:join (cc:client) "draft.json") $record)))
     (if (== $saved True) (cc:set "draft-dirty" False)
       (cc:note "Draft save unavailable; keep this editor attached."))))
(= (cc:restore-draft)
   (let* (($record (sf:native-object (path:join (cc:client) "draft.json")))
          ($editor (cc:get "editor" ConsoleNoEditorV1))
          ($ins (buffer:insert $editor (sf:get $record "text" ""))))
     (cc:restore-cursor $editor (sf:get $record "cursor_bytes" 2147483647))))
