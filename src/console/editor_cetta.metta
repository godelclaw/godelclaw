!(import! &self ./render_cetta.metta)
!(bind! &cc-history (new-space))
(= (cc:help)
   "Enter sends; Alt-Enter or Ctrl-J inserts a newline. Paste keeps its lines.\n/ models, model, modes, engines, fuel, energy, activity, health, quota, wake, start, stop: shared agent controls\n/status: current structured status; /retry: original pending input IDs; /replies: local reply archive\n/close-menu: close the current menu; a displayed number chooses a menu item\n/detach or Ctrl-D on an empty draft: detach while cognition continues; //text sends a leading slash\nCtrl-C interrupts the draft. Arrows edit or browse history; Ctrl-R searches backward using the draft text.")
(= (cc:history-put $text)
   (let* (($number (cc:get "history-count" 0))
          ($_ (add-atom &cc-history (ConsoleHistoryV1 $number $text)))
          ($_ (cc:set "history-count" (+ $number 1)))) True))
(= (cc:history-save $text)
   (let* (($when (system:format-time "%Y-%m-%d %H:%M:%S" (system:wall-time) "local"))
          ($lines (map-atom (str:split "\n" $text) $line (str:concat "+" $line)))
          ($record (str:join "" ("\n# " $when "\n" (str:join "\n" $lines) "\n")))
          ($saved (fs:append-text (path:join (cc:client) "history") $record)))
     (progn (if (sf:failed? $saved) (cc:note "History write unavailable; draft and input receipt are separate.") True)
       (cc:history-put $text) (cc:set "history-index" (cc:get "history-count" 0)))))
(= (cc:history-lines $input $record $left)
   (if (<= $left 0) True
     (case (buffer:line $input)
       (((HostLine $line)
         (progn (cc:history-line $line $record) (cc:history-lines $input $record (- $left 1))))
        ($pending True)))))
(= (cc:history-line $line $record)
   (if (str:starts-with $line "# ")
     (let (HostBufferInfo $size $_) (buffer:info $record)
       (if (> $size 0) (progn (cc:history-put (buffer:value $record)) (buffer:drop $record $size)) True))
     (if (str:starts-with $line "+")
       (let (HostBufferInfo $size $_) (buffer:info $record)
         (buffer:append $record (str:concat (if (> $size 0) "\n" "") (str:byte-slice $line 1 (str:byte-length $line))))) True)))
(= (cc:history-read $file $input $record)
   (case (fs:read-chunk $file 65536)
     (((fs:chunk $bytes $_)
       (progn (buffer:append $input $bytes) (cc:history-lines $input $record 65536) (cc:history-read $file $input $record)))
      ((fs:end $_)
       (let (HostBufferInfo $size $_) (buffer:info $record)
         (if (> $size 0) (cc:history-put (buffer:value $record)) True)))
      ($bad (cc:note "History is unavailable; its file was preserved.")))))
(= (cc:history-load)
   (let $path (path:join (cc:client) "history")
     (if (not (fs:is-file $path)) True
       (let* (($file (fs:open-read $path)) ($input (buffer:new 33554432 bytes)) ($record (buffer:new 33554432 bytes))
              ($_ (cc:history-read $file $input $record)) ($_ (fs:close $file))
              ($_ (host:close $input)) ($_ (host:close $record))
              ($_ (cc:set "history-index" (cc:get "history-count" 0)))) True))))
(= (cc:replace-draft $text)
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1)) ($_ (buffer:edit $editor "clear"))
          ($inserted (buffer:insert $editor $text)))
     (if (cc:buffer-failed? $inserted) (cc:note "Draft insertion refused; inspect its retained source.")
       (progn (cc:set "dirty" True) (cc:set "draft-dirty" True)))))
(= (cc:history-move $direction)
   (let* (($count (cc:get "history-count" 0)) ($at (cc:get "history-index" $count))
          ($next (max 0 (min $count (+ $at $direction))))
          ($_ (if (== $at $count) (cc:set "history-draft" (buffer:value (cc:get "editor" ConsoleNoEditorV1))) True)))
     (progn (if (== $next $count) (cc:replace-draft (cc:get "history-draft" ""))
       (case (collapse (match &cc-history (ConsoleHistoryV1 $next $text) $text))
         ((($text) (cc:replace-draft $text)) ($missing True))))
     (cc:set "history-index" $next))))
(= (cc:history-search $at $needle)
   (if (< $at 0) (cc:note "No earlier matching history entry.")
     (case (collapse (match &cc-history (ConsoleHistoryV1 $at $text) $text))
       ((($text)
         (case (str:find $text $needle)
           (((TextNotFound $_) (cc:history-search (- $at 1) $needle))
            ($found (progn (cc:set "history-index" $at) (cc:replace-draft $text))))))
        ($missing (cc:note "History entry unavailable."))))))
(= (cc:split-command $text)
   (case (str:find $text " ")
     (((TextNotFound $_) ($text ""))
      ($at ((str:byte-slice $text 0 $at) (str:byte-slice $text (+ $at 1) (str:byte-length $text)))))))
(= (cc:submit-draft)
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1)) ($text (buffer:value $editor))
          ($trimmed (str:trim $text)))
     (if (== $trimmed "") True
       (let* (($_ (cc:history-save $text)) ($_ (cc:set "view-epoch" (+ (cc:get "view-epoch" 0) 1)))
              ($_ (cc:emit-user-input $text)))
         (if (str:starts-with $text "//") (cc:publish-text (str:byte-slice $text 1 (str:byte-length $text)))
          (if (or (str:starts-with $text "/") (and (not (== (cc:get "menu" ()) ())) (str:is-all-in digit $text)))
           (progn (cc:command $text) (cc:replace-draft ""))
           (cc:publish-text $text)))))))
(= (cc:publish-text $text)
   (let $record (cm:prepare (cc:settings) $text)
     (case $record
       (((ConsoleFailureV1 $why) (cc:note $why))
        ($ok
         (let* (($id (sf:get $record "id" ""))
                ($path (cm:path (cc:settings) "pending" $id))
                ($_ (cc:mail-request "publish" ((JsonPair "path" $path))))
                ($_ (cc:replace-draft "")) ($_ (cc:update-pending))) True))))))
(= (cc:command $text)
   (case $text
     (("/detach" (cc:set "stop" True)) ("/quit" (cc:set "stop" True))
      ("/help" (cc:note (cc:help)))
      ("/retry" (cc:mail-request "retry" ()))
      ("/close-menu" (progn (cc:set "menu" ()) (cc:note "Menu closed.")))
      ("/status" (cc:control "status" ()))
      ("/replies" (cc:archive-all))
      ($other
       (if (str:starts-with $text "//")
         (cc:publish-text (str:byte-slice $text 1 (str:byte-length $text)))
         (let $menu (cc:get "menu" ())
           (if (and (not (== $menu ())) (str:is-all-in digit $text))
             (let $number (cli:number $text 0)
               (if (and (> $number 0) (<= $number (size-atom $menu)))
                 (let* (((JsonArray ($_ $value)) (car-atom (list:drop (- $number 1) $menu)))
                        ($_ (cc:set "menu" ()))) (cc:control "choice" ((JsonPair "value" $value))))
                 (cc:note "Choose a displayed number, or /close-menu.")))
             (let* ((($name $arguments) (cc:split-command $text)) ($_ (cc:set "menu" ())))
               (cc:control "command" ((JsonPair "name" $name) (JsonPair "arguments" $arguments)))))))))))
(= (cc:key $name $text)
   (let $editor (cc:get "editor" ConsoleNoEditorV1)
     (case $name
       (("text" (buffer:insert $editor $text))
        ("paste" (buffer:insert $editor (str:join "\n" (str:split "\r" (str:join "\n" (str:split "\r\n" $text))))))
        ("enter" (cc:submit-draft))
        ("alt-enter" (buffer:insert $editor "\n")) ("lf" (buffer:insert $editor "\n"))
        ("tab" (buffer:insert $editor "\t"))
        ("ctrl-c" (progn (cc:replace-draft "") (cc:note "Draft interrupted; cognition continues.")))
        ("ctrl-d" (let (HostBufferInfo $size $_) (buffer:info $editor)
          (if (== $size 0) (cc:set "stop" True) (buffer:edit $editor "delete"))))
        ("ctrl-a" (buffer:edit $editor "home")) ("ctrl-e" (buffer:edit $editor "line-end"))
        ("ctrl-b" (buffer:edit $editor "left")) ("ctrl-f" (buffer:edit $editor "right"))
        ("ctrl-k" (cc:kill $editor "kill-line")) ("ctrl-u" (cc:kill $editor "kill-start"))
        ("ctrl-w" (cc:kill $editor "kill-word"))
        ("ctrl-y" (buffer:insert $editor (cc:get "kill-ring" "")))
        ("ctrl-r" (cc:history-search (- (cc:get "history-index" (cc:get "history-count" 0)) 1) (buffer:value $editor)))
        ("up" (case (buffer:edit $editor "up") ((HostAtBoundary (cc:history-move -1)) ($moved True))))
        ("down" (case (buffer:edit $editor "down") ((HostAtBoundary (cc:history-move 1)) ($moved True))))
        ($other (if (cli:member? $name ("left" "right" "home" "line-end" "delete" "backspace" "word-left" "word-right"))
                  (buffer:edit $editor $name) True))))))
(= (cc:kill $editor $operation)
   (let* (($before (buffer:value $editor)) ((HostBufferInfo $old-size $old-cursor) (buffer:info $editor))
          ($result (buffer:edit $editor $operation)) ((HostBufferInfo $new-size $new-cursor) (buffer:info $editor))
          ($removed (- $old-size $new-size))
          ($_ (if (> $removed 0) (cc:set "kill-ring" (str:byte-slice $before $new-cursor (+ $new-cursor $removed))) True)))
     $result))
(= (cc:keys $input $flush $left)
   (if (<= $left 0) True
     (case (buffer:input-event $input $flush)
       (((HostInput $name $text)
         (progn (cc:key $name $text) (cc:set "dirty" True) (cc:set "draft-dirty" True)
                (cc:keys $input wait (- $left 1))))
        (HostPending True)
        ($failure (cc:note "Terminal input decoder refused a frame; draft retained."))))))
(= (cc:save-draft)
   (let* (($editor (cc:get "editor" ConsoleNoEditorV1)) ((HostBufferInfo $_ $cursor) (buffer:info $editor))
          ($record (JsonObject ((JsonPair "text" (buffer:value $editor)) (JsonPair "cursor_bytes" $cursor))))
          ($saved (cm:store (path:join (cc:client) "draft.json") $record)))
     (if (== $saved True) (cc:set "draft-dirty" False)
       (cc:note "Draft save unavailable; keep this editor attached."))))
(= (cc:restore-cursor $editor $target)
   (let (HostBufferInfo $_ $cursor) (buffer:info $editor)
     (if (<= $cursor $target) True (progn (buffer:edit $editor "left") (cc:restore-cursor $editor $target)))))
(= (cc:restore-draft)
   (let* (($record (sf:native-object (path:join (cc:client) "draft.json")))
          ($editor (cc:get "editor" ConsoleNoEditorV1))
          ($_ (buffer:insert $editor (sf:get $record "text" ""))))
     (cc:restore-cursor $editor (sf:get $record "cursor_bytes" 2147483647))))
