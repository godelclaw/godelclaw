; Durable client records supplement the mailbox's authoritative receipts.
; A failed or uncertain send keeps its original identity for explicit retry.
!(import! &self ./config_cetta.metta)
!(import! &self ../../scripts/shared_mail.metta)
(= (cm:record-valid? $settings $record)
   (let* (($id (sf:get $record "id" "")) ($recipient (sf:get $record "recipient" ""))
          ($sender (sf:get $record "sender" "")) ($text (sf:get $record "text" JsonNull)))
     (and (re:is-match (re:compile "\\A[A-Za-z0-9_.-]{1,128}\\z") $id)
       (and (== $recipient (sf:get $settings "agent" ""))
         (and (== $sender (sf:get $settings "sender" "")) (== (get-type $text) String))))))
(= (cm:path $settings $kind $id)
   (path:join (path:join (sf:get $settings "client" "") $kind) (str:concat $id ".json")))
(= (cm:store $path $record)
   (let $_ (fs:make-directories (path:dirname $path) 448)
     (sf:replace $path (sf:python-json $record) 384 True)))
(= (cm:prepare $settings $text)
   (let* (($id (system:uuid4-hex))
          ($record (JsonObject ((JsonPair "id" $id) (JsonPair "recipient" (sf:get $settings "agent" ""))
            (JsonPair "sender" (sf:get $settings "sender" "")) (JsonPair "text" $text))))
          ($saved (cm:store (cm:path $settings "pending" $id) $record)))
     (if (== $saved True) $record (ConsoleFailureV1 "input was not durably retained; draft stays open"))))
(= (cm:receipt $result) (json:parse (json-stringify (shared-mail:json $result))))
(= (cm:publish $settings $record)
   (if (not (cm:record-valid? $settings $record)) (ConsoleFailureV1 "pending record does not match this client; no send attempted")
    (let* (($id (sf:get $record "id" "")) ($mail (cc:mail-settings $settings))
          ($socket (sf:get $mail "socket" ""))
          ($result (if (== $socket "") (ConsoleFailureV1 "native mail socket is not configured")
            (shared-mail:post $socket (sf:get $mail "space" "agent-mail") $id
              (sf:get $record "recipient" "") (sf:get $record "sender" "") (sf:get $record "text" "")))))
     (case $result
       (((mailbox:sent $sent $status)
         (if (and (== $sent $id) (or (== $status accepted) (== $status duplicate)))
           (let* (($receipt (cm:receipt $result))
                  ($saved (cm:store (cm:path $settings "accepted" $id)
                    (JsonObject ((JsonPair "record" $record) (JsonPair "receipt" $receipt))))))
             (if (== $saved True) (progn (fs:remove (cm:path $settings "pending" $id)) $receipt)
               (ConsoleFailureV1 "acceptance is known; local receipt is not durable; retain ID")))
           (ConsoleFailureV1 "mail returned no matching acceptance")))
        ($bad (ConsoleFailureV1 "input acceptance is unconfirmed; /retry preserves its ID")))))))
(= (cm:pending $settings)
   (let $root (path:join (sf:get $settings "client" "") "pending")
     (if (fs:exists $root)
       (sort-strings (filter-atom (fs:entries $root) $name (str:ends-with $name ".json"))) ())))
(= (cm:retry $settings $files)
   (if (== $files ()) ()
     (let* (($path (path:join (path:join (sf:get $settings "client" "") "pending") (car-atom $files)))
            ($record (sf:native-object $path))
            ($result (cm:publish $settings $record))
            ($receipt (case $result
              (((ConsoleFailureV1 $why) (JsonObject ((JsonPair "status" "unconfirmed")
                 (JsonPair "id" (sf:get $record "id" "")) (JsonPair "error" $why)))) ($ok $ok))))
            ($rest (cm:retry $settings (cdr-atom $files))))
       (cons-atom $receipt $rest))))
(= (cm:receive $settings)
   (let* (($mail (cc:mail-settings $settings)) ($socket (sf:get $mail "socket" "")) ($sender (sf:get $settings "sender" "")))
     (case (shared-mail:next $socket $sender 0)
       (((mailbox:idle) (JsonObject ((JsonPair "status" "idle"))))
        ((mailbox:delivery $id $from $text)
         (let* (($record (cm:receipt (mailbox:delivery $id $from $text)))
                ($path (cm:path $settings "received" (str:sha256 $id))) ($saved (cm:store $path $record)))
           (if (!= $saved True) (ConsoleFailureV1 "reply is not archived; it remains unacknowledged")
             (case (shared-mail:ack $socket $sender $id)
               (((mailbox:acked $same $status)
                 (if (and (== $same $id) (or (== $status settled) (== $status duplicate)))
                   (JsonObject ((JsonPair "status" "delivery") (JsonPair "path" $path) (JsonPair "id" $id)))
                   (ConsoleFailureV1 "reply archived; acknowledgement unconfirmed")))
                ($bad (ConsoleFailureV1 "reply archived; acknowledgement unconfirmed")))))))
        ($bad (ConsoleFailureV1 "reply channel unavailable"))))))
(= (cm:work $settings $request)
   (let $operation (sf:get $request "operation" "")
     (case $operation
       (("receive" (cm:receive $settings))
        ("publish" (cm:publish $settings (sf:native-object (sf:get $request "path" ""))))
        ("retry" (JsonArray (cm:retry $settings (cm:pending $settings))))
        ($bad (ConsoleFailureV1 "unknown client operation"))))))
(= (cm:serve $settings)
   (let $line (system:read-line)
     (if (== $line end_of_file) True
       (let* (($request (json:parse-python $line)) ($id (sf:get $request "id" JsonNull))
              ($answers (collapse (catch (cm:work $settings $request))))
              ($body (if (== $answers ()) (ConsoleFailureV1 "native mail operation produced no receipt") (car-atom $answers)))
              ($value (case $body (((ConsoleFailureV1 $why) (JsonObject ((JsonPair "error" $why)))) ($ok $ok))))
              ($_ (system:write stdout (str:concat (json:stringify-python
                   (JsonObject ((JsonPair "id" $id) (JsonPair "body" $value)))) "\n"))))
         (cm:serve $settings)))))
