; Unchanged Python implementations are the explicit SWI route and oracle.
!(import! &self ./src/effect_receipts.py)
!(import! &self ./src/public_worklog.py)
(= (effect-receipts:record-command $turn $disposition $command $result)
   (py-call (effect_receipts.record_command $turn $disposition $command $result)))
(= (effect-receipts:record-command $turn $disposition $command $result $occurrence)
   (py-call (effect_receipts.record_command $turn $disposition $command $result $occurrence)))
(= (effect-receipts:capture-public-epoch $turn) (py-call (effect_receipts.capture_public_epoch $turn)))
(= (effect-receipts:record-suffix $turn $disposition $commands $reason)
   (py-call (effect_receipts.record_suffix $turn $disposition $commands $reason)))
(= (effect-receipts:view) (py-call (effect_receipts.view)))
(= (effect-receipts:view $limit) (py-call (effect_receipts.view $limit)))
(= (public-worklog:transact $root $action)
   (py-call (public_worklog.transact $root $action)))
(= (public-worklog:transact $root $action $text)
   (py-call (public_worklog.transact $root $action $text)))
(= (public-worklog:transact $root $action $text $epoch)
   (py-call (public_worklog.transact $root $action $text $epoch)))
(= (public-worklog:clean $text) (py-call (public_worklog.clean $text)))
