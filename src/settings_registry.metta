; SPDX-License-Identifier: MIT
; Modules declare indexed metadata in the same MeTTa space as their code.
; No mutable catalogue initialization or separate list of allowed setting keys.
!(import! &self (library str))
!(import! &self (library lib_prolog))

; Protocol 1: namespace, key, default, unit, domain, lifetime, description,
; and the provider's existing one-key reader / key-value writer symbols.
; Static modules add a SettingSpec fact. Computed schemas declare a
; (SettingsProvider namespace producer) whose zero-argument producer returns
; SettingSpec rows. Explicit runtime registration replaces a keyed descriptor.
(= (settings:register $raw)
   (case $raw
     (((SettingSpec 1 $ns $key $default $unit $domain $life $description $reader $writer)
       (if (and (== (get-type $ns) String) (== (get-type $key) String))
         (if (settings:domain? $domain $default)
           (settings:register-valid $raw)
           (SettingRegistrationError $ns $key invalid-default))
         (SettingRegistrationError invalid-name)))
      ($other (SettingRegistrationError unsupported-descriptor)))))
(= (settings:register-valid (SettingSpec 1 $ns $key $default $unit $domain $life $description $reader $writer))
   (let $spec (SettingSpec 1 $ns $key $default $unit $domain $life $description $reader $writer)
     (if (== (settings:spec $ns $key) $spec) (SettingsRegistered $ns $key)
       (let* (($_ (collapse (match &self (SettingSpec 1 $ns $key $d $u $dom $l $desc $r $w)
                    (remove-atom &self (SettingSpec 1 $ns $key $d $u $dom $l $desc $r $w)))))
              ($_ (add-atom &self $spec))) (SettingsRegistered $ns $key)))))
(= (settings:provider-rows $providers)
   (if (== $providers ()) ()
     (let* (($reader (car-atom $providers)) ($rows (settings:provider-result $reader))
            ($rest (settings:provider-rows (cdr-atom $providers))))
       (case $rows
         (((SettingProviderUnavailable $producer $why) $rest)
          ($rows (union-atom $rows $rest)))))))
(= (settings:all-specs)
   (let* (($facts (unique-atom (collapse (match &self
                   (SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)
                   (SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)))))
          ($providers (unique-atom (collapse (match &self (SettingsProvider $scope $reader) $reader))))
          ($rows (union-atom $facts (settings:provider-rows $providers))))
     (settings:deduplicate $rows ())))
(= (settings:deduplicate $rows $seen)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)
         (let $identity ($ns $key)
           (if (settings:member? $identity $seen) (settings:deduplicate (cdr-atom $rows) $seen)
             (let $tail (settings:deduplicate (cdr-atom $rows) (cons-atom $identity $seen))
               (cons-atom (SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w) $tail)))))
        ($other (settings:deduplicate (cdr-atom $rows) $seen))))))
(= (settings:find $rows $ns $key)
   (if (== $rows ()) (SettingUnknown $ns $key)
     (let (SettingSpec 1 $scope $name $d $u $domain $life $desc $r $w) (car-atom $rows)
       (if (and (== $scope $ns) (== $name $key)) (car-atom $rows)
         (settings:find (cdr-atom $rows) $ns $key)))))
(= (settings:spec $ns $key) (settings:find (settings:all-specs) $ns $key))
(= (settings:filter $rows $ns)
   (if (== $rows ()) ()
     (let (SettingSpec 1 $scope $key $d $u $domain $life $desc $r $w) (car-atom $rows)
       (let $tail (settings:filter (cdr-atom $rows) $ns)
         (if (or (== $ns "") (== $scope $ns)) (cons-atom (car-atom $rows) $tail) $tail)))))
(= (settings:specs $ns) (settings:filter (settings:all-specs) $ns))
(= (settings:revision) (str:sha256 (repr (settings:all-specs))))
(= (settings:finite? $value)
   (if (== (get-type $value) Number)
     (and (not (isnan-math $value)) (not (isinf-math $value))) False))
(= (settings:member? $value $values)
   (if (== $values ()) False
     (if (== $value (car-atom $values)) True (settings:member? $value (cdr-atom $values)))))
(= (settings:domain? $domain $value)
   (case $domain
     ((Nonnegative (if (settings:finite? $value) (>= $value 0) False))
      ((Interval $low $high) (if (settings:finite? $value) (and (>= $value $low) (<= $value $high)) False))
      ((IntegerFrom $low) (if (settings:finite? $value) (and (>= $value $low) (== $value (floor-math $value))) False))
      ((Choice $values) (settings:member? $value $values))
      (Text (== (get-type $value) String))
      ($other False))))
(= (settings:coerce $domain $raw)
   (case $domain
     (((Choice $values) $raw) (Text $raw)
      ($other (if (== (get-type $raw) String) (parse $raw) $raw)))))
(= (settings:validate $ns $key $value)
   (case (settings:spec $ns $key)
     (((SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)
       (if (settings:domain? $domain $value) True
         (SettingError $ns $key (Expected $domain) (Received $value))))
      ($unknown $unknown))))
(= (settings:default $ns $key)
   (case (settings:spec $ns $key)
     (((SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w) $d) ($unknown $unknown))))
(= (settings:value $reader $key)
   (case (catch (eval ($reader $key)))
     (((Error $where $why) (SettingUnavailable $why)) ($value $value))))
(= (settings:describe (SettingSpec 1 $ns $key $d $u $domain $life $desc $reader $writer))
   (let $current (settings:value $reader $key)
     (Setting $ns $key (Current $current) (Default $d) (Unit $u)
       (Domain $domain) (Persistence $life) (Description $desc))))
(= (settings:descriptions $specs)
   (if (== $specs ()) ()
     (let $description (settings:describe (car-atom $specs))
       (cons-atom $description (settings:descriptions (cdr-atom $specs))))))
(= (settings) (settings ""))
(= (settings $ns)
   (let* (($specs (settings:specs $ns)) ($rows (settings:descriptions $specs))
          ($revision (settings:revision)) ($errors (settings:provider-errors)))
     (SettingsCatalog 1 $revision $rows (ProviderErrors $errors))))
(= (setting $ns $key)
   (case (settings:spec $ns $key)
     (((SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)
       (settings:describe (SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)))
      ($unknown $unknown))))
(= (setting $ns $key $raw)
   (case (settings:spec $ns $key)
     (((SettingSpec 1 $ns $key $d $u $domain $life $desc $reader $writer)
       (let* (($value (settings:coerce $domain $raw)) ($check (settings:validate $ns $key $value)))
         (if (== $check True) (catch (eval ($writer $key $value))) $check)))
      ($unknown $unknown))))
(= (settings:namespaces)
   (unique-atom (settings:row-namespaces (settings:all-specs))))
(= (settings:row-namespaces $rows)
   (if (== $rows ()) ()
     (let (SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w) (car-atom $rows)
       (cons-atom $ns (settings:row-namespaces (cdr-atom $rows))))))
(= (settings:keys $ns) (settings:row-keys (settings:specs $ns)))
(= (settings:row-keys $rows)
   (if (== $rows ()) ()
     (let (SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w) (car-atom $rows)
       (cons-atom $key (settings:row-keys (cdr-atom $rows))))))
(= (settings:groups $names)
   (if (== $names ()) ()
     (let* (($ns (car-atom $names)) ($keys (settings:keys $ns)))
       (cons-atom (SettingsGroup $ns $keys) (settings:groups (cdr-atom $names))))))
(= (settings:context)
   (let* (($groups (settings:groups (settings:namespaces))) ($revision (settings:revision)) ($prolog (prolog:available?)) ($errors (settings:provider-errors)))
     (SettingsIndex 1 $revision $groups (Inspect settings) (Change setting)
       (PrologAvailable $prolog) (PrologAPI prolog:query) (ProviderErrors $errors))))

; A broken provider reports its own failure without hiding the healthy ones.
(= (settings:provider-result $reader)
   (case (catch (eval ($reader)))
     (((Error $at $why) (SettingProviderUnavailable $reader $why))
      ($rows (if (settings:valid-rows? $rows) $rows
                 (SettingProviderUnavailable $reader invalid-descriptor-list))))))
(= (settings:valid-rows? $rows)
   (if (== $rows ()) True
     (if (== (get-metatype $rows) Expression)
       (case (car-atom $rows)
         (((SettingSpec 1 $ns $key $d $u $domain $life $desc $r $w)
           (settings:valid-rows? (cdr-atom $rows))) ($other False))) False)))
(= (settings:provider-errors)
   (settings:provider-errors (unique-atom (collapse (match &self (SettingsProvider $ns $reader) $reader)))))
(= (settings:provider-errors $readers)
   (if (== $readers ()) ()
     (let* (($reader (car-atom $readers)) ($result (settings:provider-result $reader))
            ($rest (settings:provider-errors (cdr-atom $readers))))
       (case $result
         (((SettingProviderUnavailable $r $why) (cons-atom $result $rest)) ($rows $rest))))))

(= (settings:protocol)
   (SettingsProtocol 1
     (DescriptorFields (namespace key default unit domain persistence description reader writer))
     (Declare "Put a (SettingSpec 1 ...) data fact in the module that owns the setting.")
     (Computed "A (SettingsProvider namespace producer) fact names a zero-argument function returning SettingSpec rows.")
     (Register "(settings:register descriptor) replaces a namespace/key descriptor at runtime.")
     (Reader "The reader accepts a key and returns the current value.")
     (Writer "The writer accepts a key and value, applies it and reports persistence; the provider owns storage.")
     (Domains (Nonnegative (Interval low high) (IntegerFrom low) (Choice values) Text))
     (Persistence "Declare persistent or session; a module must load its descriptors after restart.")))
