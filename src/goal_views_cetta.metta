; Read-only goal views and shared project-04b kernel-state ingestion. No Python-loader
; fallback. The ONLY work-state change-marker owner remains helper.py.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self (library math))
!(import! &self ./src/small_views_cetta.metta)
!(import! &self ./src/pins_context_cetta.metta)
!(import! &self ./src/helper.py)
!(import! &self ./src/strategy_host.py)
!(import! &self ./src/goal_views_boundary.py)

(= (gv:empty) "(no goals yet — add one with (goal-write ...))")
(= (gv:path) (system:getenv-or-default "METTACLAW_GOALS_PATH"
   (gv:neighbor (system:getenv-or-default "METTACLAW_HISTORY_PATH" "memory/history.metta") "goals.metta")))
; os.path.dirname keeps spelling (including ..), unlike path:dirname.
(= (gv:dirname $path) (pinsctx:dirname $path))
(= (gv:drop-last $items)
   (if (== (cdr-atom $items) ()) ()
     (cons-atom (car-atom $items) (gv:drop-last (cdr-atom $items)))))
(= (gv:neighbor $path $name)
   (let $dir (gv:dirname $path)
     (if (== $dir "") $name
       (str:concat (if (str:ends-with $dir "/") $dir (str:concat $dir "/")) $name))))
; OSError means missing, but decoding failures escape to the source boundary.
(= (gv:read $path)
   (if (sv:contains $path (get-state &sv-nul)) (Error gv:read embedded-nul)
    (case (fs:read-text-result $path 0 "raw")
     ((("ok" $text)
       (if (== (get-type (str:codepoint-count $text)) Number) (sv:universal $text)
         (Error gv:read invalid-utf8)))
      (("missing" $_) GvMissing) (("directory" $_) GvMissing) (("denied" $_) GvMissing)
      (("error" $class $_)
       (if (pinsctx:os-error? $class) GvMissing (Error gv:read $class)))
      ($other (Error gv:read $other))))))
(= (gv:lines $text)
   (if (== $text "") ()
     (let $lines (sv:splitlines $text)
       (if (== (index-atom $lines (- (size-atom $lines) 1)) "") (gv:drop-last $lines) $lines))))

; Python %.4f: normalize the exact binary mantissa by powers of two, then
; round INTEGER numerator/denominator ties to even. Multiplying x by 10000
; as a float would double-round (e.g. 0.00015). Keep the sign of -0.0.
(= (gv:r $x)
   (if (if (== (get-type $x) String) (not (re:is-match (get-state &sv-int-separators) $x)) False)
     (let $special (str:lower (sv:strip $x))
       (case $special
         (("nan" "nan") ("+nan" "nan") ("-nan" "nan")
          ("inf" "inf") ("+inf" "inf") ("infinity" "inf") ("+infinity" "inf")
          ("-inf" "-inf") ("-infinity" "-inf") ($other (gv:r-number $x)))))
     (gv:r-number $x)))
(= (gv:r-number $x)
   (let* (($value (gv:float $x)) ($negative (str:starts-with (repr $value) "-"))
          ($absolute (math:abs $value)))
     (if (or (math:isnan $value) (math:isinf $value)) (Error gv:r nonfinite)
       (let* (($whole (math:floor $absolute)) ($fraction (- $absolute $whole))
              ($scaled (if (< $fraction 0.00005) 0 (gv:mantissa $fraction 1))))
         (str:concat (if $negative "-" "") (gv:decimal $whole $scaled))))))
(= (gv:float $x)
   (case $x
     ((True 1.0) (False 0.0)
      ($other (if (== (get-type $other) Number) (* $other 1.0)
        (if (== (get-type $other) String)
          (if (re:is-match (get-state &sv-int-separators) $other) (Error gv:float invalid-number)
            (let $text (sv:strip $other)
              (if (re:is-match (get-state &gv-float) $text) (gv:float-digits $text)
                (let $digits (sv:ascii-digits $text (aw:decimal-patterns))
                  (if (re:is-match (get-state &gv-float) $digits) (gv:float-digits $digits)
                    (Error gv:float invalid-number)))))) (Error gv:float invalid-number)))))))
(= (gv:float-digits $digits)
   (let $clean (str:join "" (str:split "_" $digits))
     (* 1.0 (str:string->number (if (re:is-match (get-state &gv-negative-zero) $clean)
              (str:concat $clean ".0") $clean)))))
; Captured fields passed _NUMBER. Saturate before float conversion: every
; negative decimal clamps to zero and every positive integer part >= 1 to
; one, even when Python float(text) would first overflow to infinity.
(= (gv:goal-number $text)
   (if (str:starts-with $text "-") 0.0
     (let* (($digits (if (str:is-all-in ascii $text) $text
                       (sv:ascii-digits $text (aw:decimal-patterns))))
            ($head (car-atom (str:split "." $digits)))
            ($whole (if (== $head "") 0 (str:string->number $head))))
       (if (>= $whole 1) 1.0 (gv:float-digits $digits)))))
!(bind! &gv-float (new-state (re:compile "\\A[+-]?(?:[0-9](?:_?[0-9])*(?:\\.(?:[0-9](?:_?[0-9])*)?)?|\\.[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\z")))
; float("-0") is negative zero, unlike integer parsing followed by promotion.
!(bind! &gv-negative-zero (new-state (re:compile "\\A-0+\\z")))
(= (gv:mantissa $value $denominator)
   (if (< $value 1048576.0) (gv:mantissa (* $value 4294967296.0) (* $denominator 4294967296))
     (if (< $value 68719476736.0) (gv:mantissa (* $value 65536.0) (* $denominator 65536))
      (if (< $value 17592186044416.0) (gv:mantissa (* $value 256.0) (* $denominator 256))
       (if (< $value 281474976710656.0) (gv:mantissa (* $value 16.0) (* $denominator 16))
        (if (< $value 4503599627370496.0) (gv:mantissa (* $value 2.0) (* $denominator 2))
       (let* (($numerator (* (math:floor $value) 10000))
              ($remainder (% $numerator $denominator))
              ; After removing the remainder this is q * 2^k, q <= 10000:
              ; both operands and the integral result are EXACT doubles.
              ($quotient (math:floor (/ (- $numerator $remainder) $denominator)))
              ($twice (* 2 $remainder)))
         (+ $quotient (if (or (> $twice $denominator)
                          (and (== $twice $denominator) (== (% $quotient 2) 1))) 1 0)))))))))
(= (gv:decimal $whole $scaled)
   (let* (($integral (repr (+ $whole (if (== $scaled 10000) 1 0)))) ($fraction (% $scaled 10000)))
     (if (== $fraction 0) $integral
       (let* (($digits (repr (+ 10000 $fraction)))
              ($tail (re:replace-literal (get-state &gv-zeroes) (str:char-slice $digits 1 5) "")))
         (str:join "." ($integral $tail))))))
!(bind! &gv-zeroes (new-state (re:compile "0+\\z")))

; Adapt Python's \s/\S explicitly; native regex whitespace omits U+001C..1F.
(= (gv:regex $text)
   (let* (($space (prose:pattern space))
          ($negative (str:concat "[^" (str:char-slice $space 1 (- (str:char-length $space) 1))))
          ($classes (str:join $negative (str:split "[^\\s" $text))))
     (re:compile (str:join $space (str:split "\\s" $classes)))))
!(bind! &gv-goal (new-state (gv:regex "\\A\\(goal\\s+([^\\s()\"]+)\\s+([^\\s()\"]+)\\s+sti:\\s*(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+))\\s+lti:\\s*(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+))\\s+vibes:\\s*\\(([^()]*)\\)\\s+blocked-by:\\s*(none|\"[^\"]*\"|[^\\s()\"]+)\\s+last-verified:\\s*([^\\s()\"]+)\\s+note:\\s*(?:\"([^\"]*)\"|([^()\"]*))\\)\\s*\\z")))
!(bind! &gv-legacy (new-state (gv:regex "\\A\\(goal\\s+([^\\s()\"]+)\\s+([^\\s()\"]+)\\s+sti:\\s*(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+))\\s+lti:\\s*(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+))\\s+vibes:\\s*\\(([^()]*)\\)\\s+blocked-by:\\s*(none|\"[^\"]*\"|[^\\s()\"]+)\\)\\s*\\z")))
!(bind! &gv-flag (new-state (gv:regex "\\A\\(goal-flag\\s+([^\\s]+)\\s+(stuck|saturated|cull-review)\\)\\s*\\z")))
!(bind! &gv-budget (new-state (gv:regex "\\A\\(goal-budget\\s+(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+))\\)\\s*\\z")))
!(bind! &gv-mood (new-state (gv:regex "\\A\\(mood\\s.*\\)\\s*\\z")))
!(bind! &gv-words (new-state (re:compile (str:concat (prose:pattern space) "+"))))
!(bind! &gv-compost-name (new-state (gv:regex "\\A\\(goal\\s+([^\\s]+)")))
(= (gv:group $match $text $n) (re:group-text $match $text $n))
(= (gv:record $match $line $canonical)
   (let* (($name (gv:group $match $line 1)) ($area (gv:group $match $line 2))
          ($sti (math:clamp 0.0 1.0 (gv:goal-number (gv:group $match $line 3))))
          ($lti (math:clamp 0.0 1.0 (gv:goal-number (gv:group $match $line 4))))
          ($blocked (gv:group $match $line 6))
          ($verified (if $canonical (gv:group $match $line 7) "never"))
          ($note (if $canonical
                   (case (gv:group $match $line 8)
                     (((re:unmatched $_) (sv:strip (gv:group $match $line 9))) ($quoted $quoted))) "")))
     (GvGoal $name $area $sti $lti $blocked $verified $note $canonical)))
; Same-format last wins; canonical beats legacy, retaining first position.
(= (gv:put $goal $goals)
   (if (== $goals ()) ($goal)
     (let* (((GvGoal $name $_ $_ $_ $_ $_ $_ $canonical) $goal)
            ($head (car-atom $goals))
            ((GvGoal $old $_ $_ $_ $_ $_ $_ $was-canonical) $head))
       (if (== $name $old)
         (cons-atom (if (or $canonical (not $was-canonical)) $goal $head) (cdr-atom $goals))
         (cons-atom $head (gv:put $goal (cdr-atom $goals)))))))
(= (gv:parse $lines) (gv:parse-lines $lines 1 () ()))
(= (gv:parse-lines $lines $number $goals $flags)
   (if (== $lines ()) (GvParsed $goals $flags)
     (let* (($line (car-atom $lines)) ($match (re:captures (get-state &gv-goal) $line)))
       (case $match
         ((re:no-match
           (case (re:captures (get-state &gv-legacy) $line)
             ((re:no-match (gv:parse-other $lines $number $goals $flags))
              ($legacy (gv:parse-lines (cdr-atom $lines) (+ $number 1)
                         (gv:put (gv:record $legacy $line False) $goals) $flags)))))
          ($canonical (gv:parse-lines (cdr-atom $lines) (+ $number 1)
                         (gv:put (gv:record $canonical $line True) $goals) $flags)))))))
(= (gv:parse-other $lines $number $goals $flags)
   (let* (($line (car-atom $lines)) ($flag (re:captures (get-state &gv-flag) $line)))
     (case $flag
       ((re:no-match
         (if (or (re:is-match (get-state &gv-budget) $line) (re:is-match (get-state &gv-mood) $line))
           (gv:parse-lines (cdr-atom $lines) (+ $number 1) $goals $flags)
           (let $stripped (sv:strip $line)
             (if (or (str:starts-with $stripped "(goal ") (str:starts-with $stripped "(goal-budget"))
               (GvMalformed $number) (gv:parse-lines (cdr-atom $lines) (+ $number 1) $goals $flags)))))
        ($match (gv:parse-lines (cdr-atom $lines) (+ $number 1) $goals
          (unique-atom (cons-atom ((gv:group $match $line 1) (gv:group $match $line 2)) $flags))))))))
(= (gv:rank $goals $index)
   (if (== $goals ()) ()
     (let* (($goal (car-atom $goals)) ((GvGoal $_ $_ $_ $_ $_ $verified $_ $_) $goal))
       (cons-atom ((if (== $verified "never") 0 1) $verified (- 0 $index) $goal)
         (gv:rank (cdr-atom $goals) (+ $index 1))))))
(= (gv:marks $name $flags)
   (if (== $flags ()) ()
     (let* ((($key $flag) (car-atom $flags)) ($rest (gv:marks $name (cdr-atom $flags))))
       (if (== $key $name) (cons-atom $flag $rest) $rest))))
(= (gv:line $goal $flags $note-chars $blocked)
   (let* (((GvGoal $name $area $sti $_ $blocker $verified $note $_) $goal)
          ($collapsed (re:replace-literal (get-state &gv-words) (sv:strip $note) " "))
          ($short (str:char-slice $collapsed 0 (gv:slice-end (str:char-length $collapsed) $note-chars))))
     (str:join "" ("  - " $name " [" $area " sti:" (gv:r $sti)
       (if $blocked (str:concat " blocked-by:" $blocker) "")
       (if (== $verified "never") "" (str:concat " verified:" $verified)) "]"
       (str:join "" (map-atom (sort-atom (gv:marks $name $flags)) $mark (str:concat " !" $mark))) " " $short))))
(= (gv:section $ranked $flags $note-chars $blocked)
   (if (== $ranked ()) ()
     (let* ((($_ $_ $_ $goal) (car-atom $ranked))
            ((GvGoal $_ $_ $_ $_ $blocker $_ $_ $_) $goal)
            ($rest (gv:section (cdr-atom $ranked) $flags $note-chars $blocked)))
       (if (== (not (== $blocker "none")) $blocked)
         (cons-atom (gv:line $goal $flags $note-chars $blocked) $rest) $rest))))
(= (gv:partition $text)
   (case (str:find $text " ")
     (((TextNotFound $_) ($text ""))
      ($at ((str:byte-slice $text 0 $at) (str:byte-slice $text (+ $at 1) (str:byte-length $text)))))))
(= (gv:compost-line $line)
   (let* ((($stamp $rest) (gv:partition $line)) (($reason $record) (gv:partition $rest))
          ($name (case (re:captures (get-state &gv-compost-name) $record)
                   ((re:no-match "?") ($match (gv:group $match $record 1))))))
     (str:join "" ("  - " (str:char-slice $stamp 0 10) " " $name " (" $reason ")"))))
(= (gv:compost-recent $lines $recent)
   (if (== $lines ()) $recent
     (let $text (sv:strip (car-atom $lines))
       (gv:compost-recent (cdr-atom $lines)
         (if (== $text "") $recent (cons-atom $text (gv:take $recent 3)))))))
(= (gv:take $items $n)
   (if (or (== $items ()) (<= $n 0)) () (cons-atom (car-atom $items) (gv:take (cdr-atom $items) (- $n 1)))))
(= (gv:compost $path)
   (case (gv:read (gv:neighbor $path "goals_compost.log"))
     ((GvMissing ())
      ; File iteration splits only universal newlines, NOT splitlines().
      ($text (map-atom (gv:compost-recent (str:split "\n" $text) ()) $line
               (gv:compost-line $line))))))
(= (gv:or-none $lines) (if (== $lines ()) ("  (none)") $lines))
(= (gv:work-body $path $goals $flags $max-chars $note-chars)
   (let* (($ranked (path:reverse-atom-expr (sort-atom (gv:rank $goals 0))))
          ($active (gv:or-none (gv:section $ranked $flags $note-chars False)))
          ($blocked (gv:or-none (gv:section $ranked $flags $note-chars True)))
          ($done (gv:or-none (gv:compost $path)))
          ($text (str:join "\n" (sv:append ("Active (by last self-reported check, newest first):")
                   (sv:append $active (sv:append ("Blocked:") (sv:append $blocked (cons-atom "Completed:" $done))))))))
     (if (> (str:char-length $text) $max-chars)
       (str:concat (str:char-slice $text 0 (gv:slice-end (str:char-length $text) (- $max-chars 1))) "…") $text)))
(= (gv:slice-end $length $end) (if (< $end 0) (math:max 0 (+ $length $end)) $end))
(= (gv:work $path) (gv:work $path 6000 180))
(= (gv:work $path $max-chars $note-chars)
   (case (gv:read $path)
     ((GvMissing (gv:empty))
      ($text (let $lines (gv:lines $text)
        (if (== $lines ()) (gv:empty)
          (case (gv:parse $lines)
            (((GvMalformed $number) (str:concat "work state unavailable: malformed goal record at line " (repr $number)))
             ((GvParsed $goals $flags)
               (let $body (gv:work-body $path $goals $flags $max-chars $note-chars)
                 (str:join "\n" ((str:symbol->string (py-call (helper.change_mark "work-state" $body))) $body))))))))))))
(= (gv:kernel $path)
   (case (gv:read (gv:neighbor $path "goals_kernel.json"))
     ((GvMissing (JsonObject ()))
      ((Error gv:read invalid-utf8) (JsonObject ()))
      ((Error gv:read embedded-nul) (JsonObject ()))
      ($text (if (== (get-type $text) String) (gv:kernel-json $text) (Error gv:kernel $text))))))
(= (gv:kernel-json $text)
   (case (collapse (catch (json:parse $text)))
     ((($state) (case $state
       (((JsonFailureV1 JsonParseV1 JsonSyntaxRejectedV1 $_ $_) (JsonObject ()))
        ($value (gv:filter-kernel-state $value)))))
      ($other (Error gv:kernel-json $other)))))
; Views and writers use ONE loader. Drop only numerically invalid mood values;
; retain raw valid representations and malformed values' existing error paths.
(= (gv:valid-mood-value? $value)
   (if (== (get-type $value) Number) (and (>= $value -1.0) (<= $value 1.0))
     (if (== (get-type $value) String)
       (if (re:is-match (get-state &sv-int-separators) $value) True
        (let* (($text (sv:strip $value)) ($lower (str:lower $text))
              ($digits (if (str:is-all-in ascii $text) $text (sv:ascii-digits $text (aw:decimal-patterns)))))
         (if (sv:member $lower ("nan" "+nan" "-nan" "inf" "+inf" "-inf" "infinity" "+infinity" "-infinity")) False
           (if (re:is-match (get-state &gv-float) $digits)
             (gv:mood-string-valid? (str:join "" (str:split "_" $digits))) True))))
       (gv:mood-number-valid? (catch (gv:float $value))))))
(= (gv:mood-string-valid? $digits)
   ; The native JSON scalar parser accepts overflow-sized JSON numerals before
   ; double arithmetic; the native number parser also accepts forms like .5.
   (let $number (catch (json:parse (if (str:starts-with $digits "+")
                      (str:byte-slice $digits 1 (str:byte-length $digits)) $digits)))
     (gv:mood-number-valid? (if (== (get-type $number) Number) $number
       (catch (str:string->number $digits))))))
(= (gv:mood-number-valid? $number)
   (if (== (get-type $number) Number) (and (>= $number -1.0) (<= $number 1.0)) True))
(= (gv:filter-mood $mood)
   (case $mood
     (((JsonObject $pairs) (JsonObject (filter-atom (sv:unique-pairs $pairs) $pair
         (let (JsonPair $_ $stored) $pair (gv:valid-mood-value? $stored)))))
      ($other $other))))
(= (gv:filter-kernel-state $state)
   (case $state
     (((JsonObject $pairs) (JsonObject (map-atom (sv:unique-pairs $pairs) $pair
         (let (JsonPair $key $value) $pair
           (JsonPair $key (if (== $key "mood") (gv:filter-mood $value) $value))))))
      ($other $other))))
(= (gv:affect $path)
   (let* (($state (gv:kernel $path)) ($mood (sv:field $state "mood" (JsonObject ()))))
     (if (sv:truth $mood)
       (str:concat "gamma:0.69 " (str:join " " (map-atom ("Cn" "C" "Ct" "I" "J" "A" "S" "Co" "Sp") $dim
         (str:join ":" ($dim (gv:r (sv:field $mood $dim 0.0)))))))
       "gamma:0.69 (no affect observations yet)")))
(= (gv:goals $path $fair)
   (case (gv:read $path)
     ((GvMissing (gv:empty))
      ($text (let $lines (gv:lines $text)
        (if (== $lines ()) (gv:empty)
          (let $body (str:join "\n" $lines)
            (if $fair (str:concat $body (json:parse (str:symbol->string (py-call (goal_views_boundary.fair_suffix))))) $body))))))))
(= (gv:load $id)
   (sv:outcome (collapse (catch
     (case $id
       (("work-state" (gv:work (gv:path)))
        ("affect-gestalt" (gv:affect (gv:path)))
        ($other (Error gv:load unknown-source))))))))

(= (goal-view:skill) (gv:goals (gv:path) True))
