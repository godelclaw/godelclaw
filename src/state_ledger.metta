; State access through the native ledger, and the JSON helpers its callers share.
!(import! &self ./src/state_cetta)
!(import! &self ./src/ledger_client)
!(import! &self (library system))

; The turn's records are the native ledger's: its server, at METTACLAW_INPUT_LEDGER_SOCKET,
; answers each verb (src/input_ledger.metta).
(= (state:ledger-socket) (system:getenv-or-default "METTACLAW_INPUT_LEDGER_SOCKET" ""))
(= (state:native-ledger) (not (== (state:ledger-socket) "")))
(= (state:ledger $verb $arguments) (ledger-client:call (state:ledger-socket) $verb $arguments))
(= (state:request-id) (str:concat "rq1." (system:uuid4-hex)))

(= (state:value $value)
   (case $value
     ((none JsonNull)
      ($other
        (case (get-type $value)
          ((String (JsonString $value))
           (Number (JsonNumber (repr $value)))
           ($type (JsonString (repr $value)))))))))
(= (state:row-pairs $names $values)
   (if (== $names ()) ()
     (cons-atom (JsonPair (car-atom $names) (state:value (car-atom $values)))
       (state:row-pairs (cdr-atom $names) (cdr-atom $values)))))
(= (state:objects $names $rows)
   (if (== $rows ()) ()
     (let $pairs (state:row-pairs $names (car-atom $rows))
       (cons-atom (JsonObject $pairs) (state:objects $names (cdr-atom $rows))))))
(= (state:json-keys $pairs)
   (if (== $pairs ()) ()
     (let (JsonPair $key $_) (car-atom $pairs)
       (cons-atom $key (state:json-keys (cdr-atom $pairs))))))
; Members are read from the pairs themselves: json-object-get converts the
; whole object on each call, which made encoding quadratic in its size.
(= (state:json-member $pairs $key)
   (if (== $pairs ()) JsonNull
     (let (JsonPair $name $child) (car-atom $pairs)
       (if (== $name $key) $child (state:json-member (cdr-atom $pairs) $key)))))
(= (state:json-field $value $key)
   (case $value (((JsonObject $pairs) (state:json-member $pairs $key)) ($other JsonNull))))
(= (state:canonical-members $pairs $keys)
   (if (== $keys ()) ()
     (let* (($key (car-atom $keys)) ($child (state:json-member $pairs $key))
            ($next (state:canonical $child)))
       (cons-atom (JsonPair $key $next) (state:canonical-members $pairs (cdr-atom $keys))))))
(= (state:canonical-array $items)
   (if (== $items ()) ()
     (cons-atom (state:canonical (car-atom $items)) (state:canonical-array (cdr-atom $items)))))
(= (state:canonical $value)
   (case $value
     (((JsonObject $pairs)
       (let* (($keys (sort-strings (state:json-keys $pairs)))
              ($members (state:canonical-members $pairs $keys))) (JsonObject $members)))
      ((JsonArray $items) (let $next (state:canonical-array $items) (JsonArray $next)))
      ($other $other))))
(= (state:encoded $value) (json-stringify (state:canonical $value)))
(= (state:meta $key)
   (case (state:ledger "meta-get" ($key))
       (((Error $where $why) (Error $where $why))
        (none JsonNull)
        ($text (if (== (get-type $text) String) (json-parse $text) (Error state:meta $text))))))
; The raw JSON text of a meta key, or none when it is absent.
(= (state:meta-text $key)
   (case (state:ledger "meta-get" ($key))
       (((Error $where $why) (Error $where $why))
        (none none)
        ($text (if (== (get-type $text) String) $text (Error state:meta-text $text))))))
(= (state:text $value)
   (case $value (((JsonString $text) $text)
                ((JsonNumber $text) $text)
                ($other (repr $other)))))

; With the native ledger the topics are its records (topic-select, topic-note, topics,
; topic-context in src/input_ledger.metta), with the same answers.
(= (topic-select $name)
   (case (state:ledger "topic-select" ($name (system:uuid4-hex)))
       (((Error $where $why) (str:concat "topic-select: " (repr (Error $where $why))))
        ($ok (str:concat "active topic: " $name)))))
(= (topic-note $text)
   (case (state:ledger "topic-note" ($text (system:uuid4-hex)))
       (((Error $where $why) (str:concat "topic-note: " (repr (Error $where $why))))
        (none "topic-note: no active topic")
        ($name "saved topic notes"))))
(= (topics)
   (case (state:ledger "topics" ())
       (((ledger:topics $active $rows)
         (state:encoded (JsonObject ((JsonPair "active" (JsonString $active))
                                    (JsonPair "topics" (JsonArray (state:objects ("name" "revision") $rows)))))))
        ($other (str:concat "topics: " (repr $other))))))
(= (topics:context)
   (case (state:ledger "topic-context" ())
       ((($name $notes)
         (if (== $notes "") ""
           (str:concat "TOPIC_NOTES " (state:encoded (JsonObject ((JsonPair "name" (JsonString $name))
                                                                  (JsonPair "notes" (JsonString $notes))))))))
        ($other ""))))
