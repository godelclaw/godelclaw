; Read-only small context sources. Python remains the oracle and SWI route.
; No loader fallback: sv:outcome contains errors at the individual source.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self (library proc))
!(import! &self (library path))
!(import! &self (library math))
!(import! &self (library langdef))
!(import! &self ./src/undelivered_prose_unicode)
!(import! &self ./src/action_window_unicode)
!(import! &self ./src/small_views_unicode)
!(import! &self ./src/engine_modes.py)

; Use Python's whitespace, not the host's narrower Unicode whitespace.
!(bind! &sv-space (new-state (re:compile (str:join "" ("\\A" (prose:pattern space) "+|" (prose:pattern space) "+\\z")))))
!(bind! &sv-lines (new-state (re:compile "\\r\\n|[\\n\\r\\x{B}\\x{C}\\x{1C}-\\x{1E}\\x{85}\\x{2028}\\x{2029}]")))
(= (sv:strip $text) (re:replace-literal (get-state &sv-space) $text ""))
(= (sv:env $name) (sv:strip (system:getenv-or-default $name "")))
(= (sv:splitlines $text)
   (str:split "\n" (re:replace-literal (get-state &sv-lines) $text "\n")))
(= (sv:universal $text)
   (case (str:find $text "\r")
     (((TextNotFound $_) $text)
      ($at (str:join "\n" (str:split "\r" (str:join "\n" (str:split "\r\n" $text))))))))
(= (sv:append $left $right)
   (if (== $left ()) $right (cons-atom (car-atom $left) (sv:append (cdr-atom $left) $right))))
(= (sv:field $value $key $default)
   (case $value
     (((JsonObject $pairs) (sv:lookup $pairs $key $default))
      ($other (Error sv:field not-an-object)))))
(= (sv:lookup $pairs $key $default)
   (if (== $pairs ()) $default
     (let (JsonPair $name $value) (car-atom $pairs)
       (sv:lookup (cdr-atom $pairs) $key (if (== $name $key) $value $default)))))
(= (sv:object? $value) (case $value (((JsonObject $_) True) ($other False))))
(= (sv:truth $value)
   (case $value
     ((JsonNull False) (False False) ("" False) ((JsonArray ()) False) ((JsonObject ()) False)
      ($other (if (== (get-type $other) Number) (not (== $other 0)) True)))))
; Text-mode reads are strict UTF-8 and use universal newline translation.
(= (sv:read $path)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $text)
       (case (str:codepoint-count $text)
         (((Error $_ $_) (Error sv:read invalid-utf8))
          ($count (sv:universal $text)))))
      ($other (Error sv:read $other)))))
(= (sv:json $path) (json:parse (sv:read $path)))
(= (sv:run $argv $timeout)
   ; The legacy five-argument proc:run repairs UTF-8. Use the raw, complete
   ; native capture so malformed stderr, too, has Python's raised outcome.
   (case (proc:run $argv ((cwd (system:cwd)) (env inherit) (stdin "")
                          (timeout-ms $timeout) (max-bytes 0)))
     (((proc:result (proc:exited 0) proc:normal $out $err
         (proc:capture $out-size $out-size $err-size $err-size proc:eof proc:eof (proc:input 0 0)))
       (if (and (== (get-type (str:codepoint-count $out)) Number)
                (== (get-type (str:codepoint-count $err)) Number))
         (sv:strip (sv:universal $out)) (Error sv:run invalid-utf8)))
      ($other (Error sv:run probe-failed)))))
(= (sv:outcome $answers)
   (case $answers
     (((SvMissing) ("missing"))
      (($text) (if (== (get-type $text) String) ("value" $text) ("unavailable")))
      ($other ("unavailable")))))

(= (sv:queries)
   (let $path (sv:env "METTACLAW_ACTIVE_QUERIES_PATH")
     (json:stringify (JsonArray (sv:query-add
       (if (== $path "") (JsonArray ()) (sv:json $path))
       ("operator-stimulus" "active-goals" "task-phase" "effect-outcomes" "source-currentness"))))))
(= (sv:query-add $value $seen)
   (case $value
     (((JsonArray $items) (sv:query-items $items $seen))
      ($other (Error sv:queries not-a-string-list)))))
(= (sv:query-items $items $seen)
   (if (== $items ()) $seen
     (let $item (car-atom $items)
       (if (== (get-type $item) String)
         (let $text (sv:strip $item)
           (if (== $text "") (Error sv:queries blank-query)
             (sv:query-items (cdr-atom $items)
               (if (sv:member $text $seen) $seen (sv:append $seen ($text))))))
         (Error sv:queries not-a-string-list)))))
(= (sv:member $item $items)
   (if (== $items ()) False
     (if (== $item (car-atom $items)) True (sv:member $item (cdr-atom $items)))))

!(bind! &sv-int (new-state (re:compile "\\A[+-]?[0-9](?:_?[0-9])*\\z")))
!(bind! &sv-nul (new-state (str:from-codepoints (0))))
!(bind! &sv-int-separators (new-state (re:compile "[\\x{1C}-\\x{1F}]")))
(= (sv:ascii-digits $text $patterns)
   (if (== $patterns ()) $text
     (let ($pattern $digit) (car-atom $patterns)
       (sv:ascii-digits (re:replace-literal (re:compile $pattern) $text $digit) (cdr-atom $patterns)))))
(= (sv:int $value)
   (case $value
     ((True 1) (False 0)
      ($other
       (if (== (get-type $other) Number) (math:trunc $other)
         (if (== (get-type $other) String)
           (let* (($text (sv:strip $other))
                  ($digits (if (re:is-match (get-state &sv-int) $text) $text
                             (sv:ascii-digits $text (aw:decimal-patterns)))))
             (if (and (not (re:is-match (get-state &sv-int-separators) $other))
                      (re:is-match (get-state &sv-int) $digits))
               (str:string->number (str:join "" (str:split "_" $digits)))
               (Error sv:int invalid-integer)))
           (Error sv:int invalid-integer)))))))
(= (sv:commitment)
   (let $path (system:getenv-or-default "METTACLAW_COMMITMENT_STATE_PATH" "")
     (if (or (== $path "") (not (fs:exists $path))) ""
       (let* (($state (sv:json $path)) ($phase (sv:field $state "phase" JsonNull)))
         (if (sv:member $phase ("need-create" "need-launch" "need-trust" "need-server" "goal-satisfied" "stopped"))
           (let $revision (sv:int (sv:field $state "revision" (sv:field $state "effects" 0)))
             (if (== (get-type $revision) Number)
               (str:join "" ("phase=" $phase " revision=" (repr $revision)
                 " finished=" (if (sv:truth (sv:field $state "finished" False)) "true" "false")))
               (Error sv:commitment invalid-revision)))
           (Error sv:commitment unknown-phase))))))

; Python str()/repr() for JSON fields, including containers. These are format
; strings, NOT JSON dumps: bool/null and quotes must keep Python's spelling.
(= (sv:text $value)
   (case $value
     ((JsonNull "None") (True "True") (False "False")
      ((JsonArray $items) (str:join "" ("[" (str:join ", " (map-atom $items $item (sv:repr $item))) "]")))
      ((JsonObject $pairs) (str:join "" ("{" (str:join ", " (map-atom (sv:unique-pairs $pairs) $pair
        (let (JsonPair $key $child) $pair (str:join ": " ((sv:repr-string $key) (sv:repr $child)))))) "}")))
      ($other (if (== (get-type $other) String) $other
                (if (== (get-type $other) Number) (sv:number-text $other) (Error sv:text invalid-value)))))))
(= (sv:zeroes $count)
   (if (<= $count 0) "" (str:concat "0" (sv:zeroes (- $count 1)))))
(= (sv:number-text $value)
   (let $raw (repr $value)
     (if (sv:contains $raw "e")
       (let* ((($mantissa $power) (str:split "e" $raw))
              ($exponent (str:string->number $power))
              ($short (if (str:ends-with $mantissa ".0")
                        (str:char-slice $mantissa 0 (- (str:char-length $mantissa) 2)) $mantissa)))
         (if (and (>= $exponent -4) (< $exponent 16)) (sv:expand-float $short $exponent)
           (str:join "e" ($short $power)))) $raw)))
(= (sv:expand-float $mantissa $exponent)
   (let* (($negative (str:starts-with $mantissa "-"))
          ($absolute (if $negative (str:char-slice $mantissa 1 (str:char-length $mantissa)) $mantissa))
          ($digits (str:join "" (str:split "." $absolute)))
          ($place (+ $exponent 1)) ($length (str:char-length $digits))
          ($body (if (<= $place 0) (str:join "" ("0." (sv:zeroes (- 0 $place)) $digits))
                   (if (>= $place $length) (str:join "" ($digits (sv:zeroes (- $place $length)) ".0"))
                     (str:join "." ((str:char-slice $digits 0 $place) (str:char-slice $digits $place $length)))))))
     (if $negative (str:concat "-" $body) $body)))
(= (sv:repr $value)
   (if (== (get-type $value) String) (sv:repr-string $value) (sv:text $value)))
(= (sv:contains $text $part)
   (case (str:find $text $part) (((TextNotFound $_) False) ($at True))))
!(bind! &sv-nonprintable (new-state (re:compile (sv:nonprintable-pattern))))
(= (sv:hex $number $width)
   (if (== $width 0) ""
     (let* (($quotient (math:floor (/ $number 16))) ($digit (- $number (* $quotient 16))))
       (str:concat (sv:hex $quotient (- $width 1))
         (str:char-slice "0123456789abcdef" $digit (+ $digit 1))))))
(= (sv:ordinal $char)
   (if (== $char (get-state &sv-nul)) 0
     (case (langdef:symbol->codepoints (str:string->symbol $char))
       (((cons (cp $code) nil) $code) ($other (Error sv:ordinal invalid-character))))))
(= (sv:repr-char $char $quote)
     (case $char
       (("\t" "\\t") ("\n" "\\n") ("\r" "\\r") ("\\" "\\\\")
        ($other (if (== $char $quote) (str:concat "\\" $char)
          (if (re:is-match (get-state &sv-nonprintable) $char)
            (let $code (sv:ordinal $char)
              (if (< $code 256) (str:concat "\\x" (sv:hex $code 2))
                (if (< $code 65536) (str:concat "\\u" (sv:hex $code 4))
                  (str:concat "\\U" (sv:hex $code 8))))) $char))))))
(= (sv:repr-string $text)
   (let $quote (if (and (sv:contains $text "'") (not (sv:contains $text "\""))) "\"" "'")
     (str:join "" ($quote (str:join "" (map-atom (str:codepoints $text) $code (sv:repr-char $code $quote))) $quote))))
(= (sv:without-pair $pairs $key)
   (if (== $pairs ()) ()
     (let* (((JsonPair $name $value) (car-atom $pairs)) ($rest (sv:without-pair (cdr-atom $pairs) $key)))
       (if (== $name $key) $rest (cons-atom (JsonPair $name $value) $rest)))))
(= (sv:unique-pairs $pairs)
   (if (== $pairs ()) ()
     (let (JsonPair $name $_) (car-atom $pairs)
       (cons-atom (JsonPair $name (sv:lookup $pairs $name JsonNull))
         (sv:unique-pairs (sv:without-pair (cdr-atom $pairs) $name))))))
(= (sv:schema-one? $value) (or (== $value 1) (== $value True)))
(= (sv:task)
   (let $path (sv:env "METTACLAW_TASK_PHASE_PATH")
     (if (or (== $path "") (not (fs:is-file $path))) ""
       (let $state (sv:json $path)
         (if (sv:schema-one? (sv:field $state "schema" JsonNull)) (sv:task-render $state)
           (Error sv:task unsupported-schema))))))
(= (sv:phase-names $pairs $status)
   (if (== $pairs ()) ()
     (let* (((JsonPair $name $value) (car-atom $pairs))
            ($rest (sv:phase-names (cdr-atom $pairs) $status)))
       (if (and (not (sv:has-key (cdr-atom $pairs) $name))
             (and (sv:object? $value) (== (sv:lookup-object $value "status" JsonNull) $status)))
         (cons-atom $name $rest) $rest))))
(= (sv:lookup-object $value $key $default)
   (case $value (((JsonObject $pairs) (sv:lookup $pairs $key $default)) ($other $default))))
(= (sv:has-key $pairs $key)
   (if (== $pairs ()) False
     (let (JsonPair $name $_) (car-atom $pairs)
       (if (== $name $key) True (sv:has-key (cdr-atom $pairs) $key)))))
(= (sv:spaced-array $items)
   (str:join "" ("[" (str:join ", " (map-atom $items $item (json:stringify $item))) "]")))
(= (sv:task-render $state)
   (case (sv:field $state "phases" (JsonObject ()))
     (((JsonObject $pairs)
       (let* (($active (sort-atom (sv:phase-names $pairs "active")))
              ($completed (sort-atom (sv:phase-names $pairs "completed")))
              ($pending (sort-atom (sv:phase-names $pairs "pending")))
              ($phase (if (== (size-atom $active) 1) (car-atom $active)
                        (if (and (not (== $completed ())) (and (== $active ()) (== $pending ()))) "completed" "plural"))))
         (str:join "" ("task=" (sv:text (sv:field $state "task_id" "?")) " phase=" $phase
           " revision=" (sv:text (sv:field $state "revision" 0))
           " evidence-revision=" (sv:text (sv:field $state "evidence_revision" "?"))
           " active=" (sv:spaced-array $active) " completed=" (sv:spaced-array $completed)
           " pending=" (sv:spaced-array $pending)))))
      ($other (Error sv:task not-a-phase-map)))))

; Raw bytes are kept as a native String for hashing, including invalid UTF-8.
(= (sv:bytes $path)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $bytes) $bytes) ($other (Error sv:bytes $other)))))
(= (sv:directory? $path)
   (case (fs:metadata $path follow) (((fs:info directory $_ $_) True) ($other False))))
(= (sv:entry $directory $name)
   (let $path (path:join $directory $name)
     (case (fs:metadata $path no-follow)
       (((fs:info regular $_ $_) (sv:entry-read $path $name))
        ((fs:failed fs:missing $_ $_ $_ $_ $_) SvMissing)
        ((fs:failed $_ $_ $_ $code $_ $message) (sv:iter-os-error $path $code $message))
        ((fs:info $_ $_ $_) (SvIterError "AuthoringError: transformation entry is not a regular file"))
        ($other (Error sv:entry $other))))))
(= (sv:entry-read $path $name)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $raw) (JsonObject ((JsonPair "name" $name) (JsonPair "sha256" (str:sha256 $raw)))))
      (("denied" $_) (sv:iter-os-error $path 13 "Permission denied"))
      (("missing" $_) (sv:iter-os-error $path 2 "No such file or directory"))
      (("directory" $_) (sv:iter-os-error $path 21 "Is a directory"))
      (("error" "NotADirectoryError" $_) (sv:iter-os-error $path 20 "Not a directory"))
      ($other (Error sv:entry-read $other)))))
(= (sv:iter-os-error $path $code $message)
   (let $class (case $code
     ((2 "FileNotFoundError") (13 "PermissionError") (20 "NotADirectoryError")
      (21 "IsADirectoryError") ($other "OSError")))
     (SvIterError (str:join "" ($class ": [Errno " (repr $code) "] " $message ": " (sv:repr-string $path))))))
(= (sv:entries $directory $names $disabled)
   (if (== $names ()) ()
     (let* (($name (car-atom $names))
            ($include (and (str:ends-with $name ".metta") (== (str:starts-with $name "_") $disabled))))
       (if $include
         (case (sv:entry $directory $name)
           ((SvMissing (sv:entries $directory (cdr-atom $names) $disabled))
            ((SvIterError $message) (SvIterError $message))
            ($entry (let $rest (sv:entries $directory (cdr-atom $names) $disabled)
                      (case $rest (((SvIterError $message) (SvIterError $message))
                        ($other (cons-atom $entry $rest))))))))
         (sv:entries $directory (cdr-atom $names) $disabled)))))
(= (sv:revision-input $entries)
   (str:join "" (map-atom $entries $entry
     (let (JsonObject ((JsonPair "name" $name) (JsonPair "sha256" $digest))) $entry
       (str:join "" ($name (get-state &sv-nul) $digest (get-state &sv-nul)))))))
(= (sv:iter-failure $message)
   (JsonObject ((JsonPair "error" $message) (JsonPair "name" "") (JsonPair "operation" "list")
     (JsonPair "schema" 1) (JsonPair "state" "error"))))
(= (sv:iter)
   (let* (($directory (system:getenv-or-default "METTACLAW_ITER_PROCESS_DIR" "memory/transformations"))
          ($names (if (sv:directory? $directory) (sort-atom (fs:entries $directory)) ()))
          ($disabled (sv:entries $directory $names True)))
     (case $disabled
       (((SvIterError $message) (sv:iter-failure $message))
        ($disabled-entries (let $active (sv:entries $directory $names False)
          (case $active
            (((SvIterError $message) (sv:iter-failure $message))
             ($active-entries (JsonObject ((JsonPair "active" (JsonArray $active))
               (JsonPair "disabled" (JsonArray $disabled))
               (JsonPair "revision" (str:sha256 (sv:revision-input $active)))
               (JsonPair "schema" 1) (JsonPair "state" "observed"))))))))))))
(= (sv:development)
   (json:stringify (JsonObject ((JsonPair "iter_transformations"
     (sv:iter-result (collapse (catch (sv:iter))))) (JsonPair "schema" 2)))))
(= (sv:iter-result $answers)
   (case $answers
     ((((JsonObject $pairs)) (JsonObject $pairs))
      (((Error $_ $kind)) (sv:iter-unavailable (if (== (get-type $kind) String) $kind (repr $kind))))
      ($other (sv:iter-unavailable "ValueError")))))
(= (sv:iter-unavailable $kind)
   (JsonObject ((JsonPair "error_kind" $kind) (JsonPair "state" "unavailable"))))

!(bind! &sv-cap-cache (new-state ()))
; fs:metadata has no mtime in the production engine. An explicit native
; GNU-compatible stat dependency supplies seconds, nanoseconds and size.
; Missing/incompatible STAT_BIN is unavailable, NEVER a Python workaround.
!(bind! &sv-stat (new-state (re:compile "\\A(-?[0-9]+)\\|[^.]+\\.([0-9]{9}) [^|]+\\|([0-9]+)\\z")))
(= (sv:artifact-key $command)
   (let* (($binary (car-atom $command))
          ($raw (sv:run ((system:getenv-or-default "STAT_BIN" "stat") "-Lc" "%Y|%y|%s" "--" $binary) 3000))
          ($match (re:captures (get-state &sv-stat) $raw)))
     (case $match
       (((re:match $_ $_ $_)
         ($command (re:group-text $match $raw 1) (re:group-text $match $raw 2) (re:group-text $match $raw 3)))
        ($other (Error sv:artifact-key missing-native-mtime))))))
(= (sv:capabilities)
   ; This is the explicitly retained engine_modes boundary (one per call).
   (let $command (sv:command (py-call (engine_modes.engine_command "cetta")))
     (if (or (== $command ()) (not (fs:is-file (car-atom $command)))) SvMissing
       (sv:capabilities-command $command))))
(= (sv:command $parts)
   (map-atom $parts $part
     (if (== (get-type $part) String) $part (str:symbol->string $part))))
(= (sv:capabilities-command $command)
   (let $key (sv:artifact-key $command)
     (case $key
       (((Error $_ $_) (Error sv:capabilities missing-native-mtime))
        ($identity (case (get-state &sv-cap-cache)
          ((($old $text) (if (== $key $old) $text (sv:cap-refresh $key $command)))
           ($other (sv:cap-refresh $key $command)))))))))
!(bind! &sv-inventory (new-state (re:compile (str:join ""
   ("\\A" (prose:pattern space) "+(" (prose:pattern word) ")"
    (prose:pattern space) "+(implemented|planned)" (prose:pattern space)
    "+(.+?)" (prose:pattern space) "*\\z")))))
(= (sv:inventory $lines)
   (if (== $lines ()) ()
     (let* (($line (car-atom $lines)) ($match (re:captures (get-state &sv-inventory) $line))
            ($rest (sv:inventory (cdr-atom $lines))))
       (case $match
         (((re:match $_ $_ $_) (cons-atom
           ((re:group-text $match $line 1) (re:group-text $match $line 2) (re:group-text $match $line 3)) $rest))
          ($other $rest))))))
(= (sv:cap-refresh $key $command)
   (let $version (sv:run (sv:append $command ("--version")) 3000)
     (if (== (get-type $version) String) (sv:cap-inventory $key $command $version)
       (Error sv:capabilities version-probe-failed))))
(= (sv:cap-inventory $key $command $version)
   (let* (($raw (sv:run (sv:append $command ("--list-languages")) 3000))
          ($rows (sv:inventory (sv:splitlines $raw))))
     (if (or (== $version "") (== $rows ())) (Error sv:capabilities no-inventory)
       (let* (($text (str:join "\n" (cons-atom
                (str:join "" ("artifact=cetta revision=" $version " inventory-sha256="
                  (str:char-slice (str:sha256 (str:join "\n" ($version $raw))) 0 16)))
                (map-atom $rows $row (let ($name $status $description) $row
                  (str:join "" ($status " " $name " — " $description)))))))
              ($result (sv:cache-text &sv-cap-cache $key $text))) $result))))

!(bind! &sv-evidence-cache (new-state ()))
; Bind the default checkout to this module's location, not the caller's cwd.
!(bind! &sv-root (new-state (path:dirname (path:dirname (fs:canonical-path "src/small_views_cetta.metta")))) )
(= (sv:default-project)
   (JsonObject ((JsonPair "id" "pettaclaw") (JsonPair "report_namespace" "pettaclaw")
     (JsonPair "checkouts" (JsonArray
       ((JsonObject ((JsonPair "path" (get-state &sv-root)) (JsonPair "role" "active")))))))))
(= (sv:registry)
   (let $path (sv:env "METTACLAW_PROJECT_REGISTRY_PATH")
     (let $value (if (== $path "")
       (JsonObject ((JsonPair "schema" 1) (JsonPair "projects" (JsonArray ((sv:default-project))))))
       (sv:json $path))
       (if (sv:schema-one? (sv:field $value "schema" JsonNull))
         (case (sv:field $value "projects" JsonNull)
           (((JsonArray $projects) $projects) ($other (Error sv:registry invalid-projects))))
         (Error sv:registry invalid-schema)))))
(= (sv:git $path $args)
   (sv:run (sv:append ((system:getenv-or-default "GIT_BIN" "git") "-C" $path) $args) 2000))
(= (sv:checkout $checkout)
   (let* (($given (sv:text (sv:field $checkout "path" "")))
          ($path (if (== $given "") (system:cwd) $given))
          ($role (sv:text (sv:field $checkout "role" "checkout")))
          ($head (sv:git $path ("rev-parse" "HEAD")))
          ($branch (sv:git $path ("branch" "--show-current")))
          ($dirty (sv:git $path ("status" "--porcelain=v1" "--untracked-files=no"))))
     (str:join "" ("checkout role=" $role " branch=" (if (== $branch "") "detached" $branch)
       " head=" $head " tracked-dirty=" (if (== $dirty "") "false" "true")))))
(= (sv:checkouts $value)
   (case $value
     (((JsonArray $items) (map-atom $items $item (sv:checkout $item)))
      ($other (Error sv:checkouts not-a-list)))))
(= (sv:report-title $lines $default)
   (if (== $lines ()) $default
     (let $line (car-atom $lines)
       (if (str:starts-with $line "# ")
         (sv:strip (re:replace-literal (re:compile "\\A[# ]+") $line ""))
         (sv:report-title (cdr-atom $lines) $default)))))
!(bind! &sv-words (new-state (re:compile (str:join "" ((prose:pattern space) "+")))))
(= (sv:report-text $path $raw)
   (if (== (get-type (str:codepoint-count $raw)) Number) $raw
     ; Production str:utf8-new supports strict/ignore, NOT replace. Only
     ; malformed reports need fs's replacement decoder (a second read).
     (case (fs:read-text-result $path 0 "replace")
       ((("ok" $text) $text) ($other (Error sv:report read-failed))))))
(= (sv:report $directory $name)
   (let* (($path (path:join $directory $name)) ($raw (sv:bytes $path))
          ($text (sv:report-text $path $raw))
          ($title (sv:report-title (sv:splitlines $text)
                    (if (== $name ".md") ".md" (str:char-slice $name 0 (- (str:char-length $name) 3)))))
          ($dense (re:replace-literal (get-state &sv-words) (sv:strip $title) " ")))
     (str:join "" ("report=" $name " sha256=" (str:char-slice (str:sha256 $raw) 0 16)
       " title=" (str:char-slice $dense 0 (min 180 (str:char-length $dense)))))))
(= (sv:last-four $names)
   (if (> (size-atom $names) 4) (sv:last-four (cdr-atom $names)) $names))
(= (sv:reports $namespace)
   (let $root (sv:env "METTACLAW_REPORTS_ROOT")
     (if (== $root "") ("reports-adapter=unconfigured")
       (let* (($directory (path:join $root $namespace))
              ($names (if (sv:directory? $directory)
                (filter-atom (fs:entries $directory) $name (str:ends-with $name ".md")) ())))
         (if (== $names ()) ("reports=absent")
           (map-atom (sv:last-four (sort-atom $names)) $name (sv:report $directory $name)))))))
(= (sv:project $project)
   (let $id (sv:text (sv:field $project "id" ""))
     (if (== $id "") (Error sv:project missing-id)
       (sv:append ((str:concat "PROJECT " $id))
         (sv:append (sv:checkouts (sv:field $project "checkouts" (JsonArray ())))
           (sv:reports (sv:text (sv:field $project "report_namespace" $id))))))))
(= (sv:evidence-render)
   (str:join "\n" (cons-atom
     "PROJECT EVIDENCE: Git state and immutable report identities are regenerated from their sources; report claims remain self-reports."
     (sv:projects (sv:registry)))))
(= (sv:projects $projects)
   (if (== $projects ()) ()
     (sv:append (sv:project (car-atom $projects)) (sv:projects (cdr-atom $projects)))))
(= (sv:evidence)
   (let $now (system:monotonic-ns)
     (case (get-state &sv-evidence-cache)
       ((($time $text) (if (<= (- $now $time) 2000000000) $text (sv:evidence-refresh $now)))
        ($other (sv:evidence-refresh $now))))))
(= (sv:evidence-refresh $now)
   (sv:cache-text &sv-evidence-cache $now (sv:evidence-render)))
; An Error can be a reduced value in PeTTa. Never install it as a cache hit.
(= (sv:cache-text $cache $key $text)
   (if (== (get-type $text) String)
     (let $_ (change-state! $cache ($key $text)) $text)
     (Error sv:cache-text rendering-failed)))

(= (sv:load $id)
   (sv:outcome (collapse (catch
     (case $id
       (("active-query-declaration" (sv:queries))
        ("commitment-state" (sv:commitment)) ("task-phase" (sv:task))
        ("development-state" (sv:development)) ("project-capabilities" (sv:capabilities))
        ("project-evidence" (sv:evidence))))))))
