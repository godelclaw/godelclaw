; Scoped observations are data. Only native producers and bound revalidation
; establish their claims; a status term never grants execution authority.
!(import! &self (library store))
!(import! &self (library str))
!(import! &self (library system))

(: Empty (-> Atom ScopedObservation))
(: obs:encode (-> Atom %Undefined%))
(: ObservationValuesV1 (-> Atom Atom Atom ObservationValueProjection))
(: StoreDecoded (-> Atom Atom))

(= (obs:append $left $right)
   (function (if (== $left ()) (return $right)
     (let* (($head (car-atom $left)) ($tail (obs:append (cdr-atom $left) $right))
            ($out (cons-atom $head $tail))) (return $out)))))
(= (obs:reverse $items $out)
   (function (if (== $items ()) (return $out)
     (let $next (obs:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out)) (return $next)))))
(= (obs:encode $value)
   (case (__cetta_lib_store_encode $value)
     (((StoreEncoded $bytes) $bytes) ($error (ObservationRefusedV1 encode $error)))))
(= (obs:same $left $right)
   (case ((store:encode $left) (store:encode $right))
     ((((StoreEncoded $a) (StoreEncoded $b)) (== $a $b)) ($other False))))
(= (obs:scope (ObservationReportV1 $scope $events $coverage $dependencies)) (function (return $scope)))
(= (obs:events (ObservationReportV1 $scope $events $coverage $dependencies)) (function (return $events)))
(= (obs:coverage (ObservationReportV1 $scope $events $coverage $dependencies)) (function (return $coverage)))
(= (obs:dependencies (ObservationReportV1 $scope $events $coverage $dependencies)) (function (return $dependencies)))

; Exact query/policy descriptors are encoded, not evaluated program fields.
; Run identity keeps independent observations separate from retransmission.
(= (obs:index $view $query $region $policy $run)
   (case (collapse (store:view-domain $view))
     ((((StoreDomainV1 $domain))
       (case (collapse (store:view-info $view))
         ((((StoreViewInfo $epoch $revision))
           (let* (($q (obs:encode $query)) ($r (obs:encode $region)) ($p (obs:encode $policy)))
             (if (and (== (get-type $q) String)
                      (and (== (get-type $r) String) (== (get-type $p) String)))
               (ObservationIndexV1 $domain $epoch $revision $q $r $p $run)
               (ObservationRefusedV1 descriptor-codec ()))))
          ($error (ObservationRefusedV1 snapshot $error)))))
      ($error (ObservationRefusedV1 source $error)))))
(= (obs:point-policy)
   (PortableNativePointV1 "captured-byte-store" "raw-bytes"))
(= (obs:diagnostic $operation $code $detail)
   (ObservationDiagnosticV1 $operation $code (obs:encode $detail)))
(= (obs:fault $scope $operation $code $detail)
   (ObservationReportV1 $scope
     ((ObservationFaultV1 (FaultOccurrenceV1 0) (obs:diagnostic $operation $code $detail)))
     (ObservationOpenV1 fault NoObservationContinuationV1) ()))
(= (obs:incomplete $scope $reason $detail)
   (ObservationReportV1 $scope ()
     (ObservationOpenV1 $reason (ObservationNeedV1 (obs:encode $detail))) ()))
(= (obs:not-observed $scope)
   (ObservationReportV1 $scope () ObservationNotStartedV1 ()))
(= (obs:lookup $view $key $maximum-bytes)
   (obs:lookup-at $view $key $maximum-bytes (system:uuid4-hex)))
(= (obs:lookup-at $view $key $maximum-bytes $run)
   (obs:lookup-as $view $key $maximum-bytes (obs:point-policy) $run))
(= (obs:lookup-as $view $key $maximum-bytes $policy $run)
   (let $scope (obs:index $view (PointQueryV1 $key ()) (reads (point $key)) $policy $run)
     (case $scope
       (((ObservationRefusedV1 $stage $detail)
         (obs:fault (ObservationUnboundV1 (obs:encode (PointQueryV1 $key ())) $run)
                    $stage unavailable $detail))
        ($index (obs:point-answers $index $key (collapse (store:get $view $key $maximum-bytes))))))))
(= (obs:point-answers $scope $key $answers)
   (case $answers
     ((($one) (obs:point-result $scope $key $one))
      (() (obs:fault $scope lookup no-native-outcome ()))
      ($many (obs:fault $scope lookup ambiguous-native-outcome $many)))))
(= (obs:point-result $scope $key $outcome)
   (case $outcome
     ((StoreAbsent (ObservationReportV1 $scope () ObservationClosedV1 ($scope)))
      ((StoreValue $bytes)
       (ObservationReportV1 $scope
         ((ObservationWitnessV1 (PointOccurrenceV1 $key) (ObservationBytesV1 $bytes)))
         ObservationClosedV1 ()))
      ((StoreTooLarge $bytes) (obs:incomplete $scope materialization-limit (RequiredBytesV1 $bytes)))
      ((StoreRefused capacity) (obs:incomplete $scope resource-limit $outcome))
      ((StoreRefused closed-view) (obs:incomplete $scope invalidated $outcome))
      ((StoreRefused $reason) (obs:fault $scope lookup $reason $outcome))
      ($other (obs:fault $scope lookup unexpected-outcome $other)))))

(= (obs:status (ObservationReportV1 $scope $events $coverage $dependencies))
   (case $coverage
     ((ObservationClosedV1
       (if (== $events ()) (Empty $scope)
         (if (== (obs:diagnostics-events $events) ()) (Observed $scope)
           (if (== (obs:encoded-values $events) (ObservationEncodedValuesV1 ()))
             (Faulted $scope closed-faults) (ObservedWithFaults $scope)))))
      (ObservationNotStartedV1
       (if (== $events ()) (NotObserved $scope)
         (ObservationRefusedV1 not-started-with-occurrences ())))
      ((ObservationOpenV1 $why $continuation)
       (if (== (obs:diagnostics-events $events) ()) (Incomplete $scope $why) (Faulted $scope $why)))
      ($other (ObservationRefusedV1 coverage $other)))))
(= (obs:run-id (ObservationIndexV1 $domain $epoch $revision $query $region $policy $run)) $run)
(= (obs:describe-index $scope)
   (case $scope
     (((ObservationIndexV1 $domain $epoch $revision $query $region $policy $run)
       (let* (($q (obs:descriptor-text $query))
              ($r (obs:descriptor-text $region))
              ($p (obs:descriptor-text $policy)))
         (format-args "source={} epoch={} revision={} query={} region={} policy={} observation={}"
           ($domain $epoch $revision $q $r $p $run))))
      ($other (repr $other)))))
(= (obs:descriptor-text $bytes)
   (case (collapse (store:decode $bytes))
     ((((StoreDecoded $value)) (repr $value))
      ($other "unavailable descriptor"))))
(= (obs:value-count (ObservationValuesV1 $scope $coverage $items)) (size-atom $items))
(= (obs:status-text $report)
   (case (obs:status $report)
     (((Empty $scope) "Empty")
      ((Observed $scope) "Observed")
      ((ObservedWithFaults $scope) "ObservedWithFaults")
      ((Faulted $scope $reason) (format-args "Faulted: {}" ($reason)))
      ((Incomplete $scope $reason) (format-args "Incomplete: {}" ($reason)))
      ((NotObserved $scope) "NotObserved")
      ($other "invalid report"))))
(= (obs:explain $report)
   (case (obs:event-counts (obs:events $report))
     (((ObservationCountsV1 $witnesses $faults)
       (format-args "{} | status={} | witnesses={} | faults={}"
         ((obs:describe-index (obs:scope $report)) (obs:status-text $report)
          $witnesses $faults))))))
; Counting occurrences does not decode or copy their potentially large payloads.
(= (obs:event-counts $events)
   (if (== $events ()) (ObservationCountsV1 0 0)
     (case (obs:event-counts (cdr-atom $events))
       (((ObservationCountsV1 $witnesses $faults)
         (case (car-atom $events)
           (((ObservationWitnessV1 $id $payload)
             (let $next (+ $witnesses 1) (ObservationCountsV1 $next $faults)))
            ($other (let $next (+ $faults 1) (ObservationCountsV1 $witnesses $next))))))))))
; Project sealed encoded data as ONE container, without activating each
; decoded term at an intermediate evaluation boundary. Native CAV1 validates
; the complete constructed container. Errors remain ordinary data here.
(= (obs:encoded-values $events)
   (if (== $events ()) (ObservationEncodedValuesV1 ())
     (case (obs:encoded-values (cdr-atom $events))
       (((ObservationEncodedValuesV1 $tail)
         (case (car-atom $events)
           (((ObservationWitnessV1 $id (ObservationBytesV1 $bytes))
             (let $encoded (obs:encode $bytes)
               (if (== (get-type $encoded) String)
                 (ObservationEncodedValuesV1 (cons-atom $encoded $tail)) $encoded)))
            ((ObservationWitnessV1 $id (ObservationCav1V1 $bytes))
             (if (and (== (get-type $bytes) String)
                      (and (>= (str:byte-length $bytes) 4) (str:starts-with $bytes "CAV1")))
               (ObservationEncodedValuesV1 (cons-atom $bytes $tail))
               (ObservationRefusedV1 value-codec $bytes)))
            ((ObservationFaultV1 $id $detail) (ObservationEncodedValuesV1 $tail))
            ($bad (ObservationRefusedV1 occurrence $bad)))))
        ($refused $refused)))))
(= (obs:field-bodies $fields)
   (function (if (== $fields ()) (return ())
     (let* (($field (car-atom $fields))
            ($body (str:byte-slice $field 4 (str:byte-length $field)))
            ($tail (obs:field-bodies (cdr-atom $fields)))
            ($out (cons-atom $body $tail))) (return $out)))))
(= (obs:values $report)
   (case (obs:encoded-values (obs:events $report))
     (((ObservationEncodedValuesV1 $fields)
       (let* (($encoded-fields (obs:encode $fields))
              ($header (str:byte-slice $encoded-fields 0 9))
              ($bodies (obs:field-bodies $fields))
              ($wire (str:concat $header (str:join "" $bodies))))
         (case (store:decode $wire)
           (((StoreDecoded $values)
             (let* (($scope (obs:scope $report)) ($coverage (obs:coverage $report)))
               (ObservationValuesV1 $scope $coverage $values)))
            ($error (ObservationRefusedV1 value-codec $error))))))
      ($refused $refused))))
(= (obs:diagnostics $report)
   (function (let $out (obs:diagnostics-events (obs:events $report)) (return $out))))
(= (obs:diagnostic-text (ObservationDiagnosticV1 $operation $code $detail))
   (format-args "operation={} reason={} detail={}"
     ($operation $code (obs:descriptor-text $detail))))
(= (obs:diagnostics-events $events)
   (function (if (== $events ()) (return ())
     (let $rest (obs:diagnostics-events (cdr-atom $events))
       (case (car-atom $events)
         (((ObservationWitnessV1 $witness-id $witness-data) (return $rest))
          ((ObservationFaultV1 $_ $diagnostic) (let $out (cons-atom $diagnostic $rest) (return $out)))
          ($other (let* (($diagnostic (obs:diagnostic report malformed-occurrence $other))
                         ($out (cons-atom $diagnostic $rest))) (return $out)))))))))

; Ordered choice qualifies occurrence identities rather than deduplicating
; equal answers. Both demanded searches must finish for the sum to finish.
(= (obs:qualify $side $events)
   (obs:qualify-at $side $events 0))
(= (obs:qualify-at $side $events $position)
   (function (if (== $events ()) (return ())
     (let* (($tail (obs:qualify-at $side (cdr-atom $events) (+ $position 1)))
            ($event (case (car-atom $events)
              (((ObservationWitnessV1 $id $value)
                (ObservationWitnessV1 (ChoiceOccurrenceV1 $side $id) $value))
               ((ObservationFaultV1 $id $fault)
                (ObservationFaultV1 (ChoiceOccurrenceV1 $side $id) $fault))
               ($bad (ObservationFaultV1 (ChoiceMalformedV1 $side $position)
                         (obs:diagnostic choice malformed-occurrence $bad)))))))
       (let $out (cons-atom $event $tail) (return $out))))))
(= (obs:choice-coverage $left $right)
   (if (and (== $left ObservationClosedV1) (== $right ObservationClosedV1))
     ObservationClosedV1 (ObservationOpenV1 demanded-branches (ObservationBranchesV1 $left $right))))
(= (obs:choice $left $right)
   (ObservationReportV1 (ObservationChoiceV1 (obs:scope $left) (obs:scope $right))
     (obs:append (obs:qualify left (obs:events $left)) (obs:qualify right (obs:events $right)))
     (obs:choice-coverage (obs:coverage $left) (obs:coverage $right))
     (obs:append (obs:dependencies $left) (obs:dependencies $right))))

; Same-run reconciliation accepts a verified prefix extension. It is not
; ordered choice, set union of equal payloads, or a claim about joined worlds.
(= (obs:prefix? $prefix $whole)
   (if (== $prefix ()) True
     (if (== $whole ()) False
       (and (obs:same (car-atom $prefix) (car-atom $whole))
            (obs:prefix? (cdr-atom $prefix) (cdr-atom $whole))))))
(= (obs:reconcile $earlier $later)
   (if (not (obs:same (obs:scope $earlier) (obs:scope $later)))
     (ObservationRefusedV1 scope-mismatch ())
     (if (not (obs:prefix? (obs:events $earlier) (obs:events $later)))
       (ObservationRefusedV1 occurrence-conflict ())
       (if (not (obs:prefix? (obs:dependencies $earlier) (obs:dependencies $later)))
         (ObservationRefusedV1 negative-dependency-conflict ())
         (if (and (not (== (obs:coverage $earlier) ObservationNotStartedV1))
                  (== (obs:coverage $later) ObservationNotStartedV1))
           (ObservationRefusedV1 progress-regressed ())
           (if (and (== (obs:coverage $earlier) ObservationClosedV1) (not (obs:same $earlier $later)))
             (ObservationRefusedV1 closed-observation-changed ()) $later))))))
