; Configuration is rendered completely before any output is published.
; Only the declared non-secret fields become environment exports.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library json))
!(import! &self (library toml))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self (library re))
!(import! &self ../config/environment_fields.metta)
(= (cfg:environment-pattern) (re:pattern "\\$(\\w+|\\{[^}]*\\})"))

(= (cfg:table-field $fields $key $fallback)
  (if (== $fields ()) $fallback
    (let (TomlFieldV1 $name $value) (car-atom $fields)
      (if (== $name $key) $value (cfg:table-field (cdr-atom $fields) $key $fallback)))))
(= (cfg:get $object $key $fallback)
  (case $object
    (((TomlTableV1 $fields) (cfg:table-field $fields $key $fallback))
     ($other (let $value (json:get $other $key)
       (if (== $value JsonNull) $fallback $value))))))
(= (cfg:table? $value)
  (case $value (((TomlTableV1 $fields) True) ((JsonObject $pairs) True) ($other False))))
(= (cfg:json-value $value)
  (case $value
    (((TomlArrayV1 $items) (JsonArray $items)) ($other $other))))
(= (cfg:value $defaults $local $section $key $fallback)
  (let* (($base (cfg:get $defaults $section (JsonObject ())))
         ($overrides (cfg:get $local $section (JsonObject ())))
         ($default (cfg:get $base $key $fallback)))
    (cfg:get $overrides $key $default)))
(= (cfg:absolute $path)
  (let* (($raw (if (path:is-absolute $path) $path (let $cwd (system:cwd) (str:join "" ($cwd "/" $path)))))
         ($normal (path:normalize $raw)))
    (if (and (str:starts-with $raw "//") (not (str:starts-with $raw "///")))
      (str:concat "/" $normal) $normal)))
(= (cfg:last $items)
  (if (== (cdr-atom $items) ()) (car-atom $items) (cfg:last (cdr-atom $items))))
(= (cfg:environment $name $root $original)
  (case $name
    (("ROOT" $root)
     ("STATE_HOME" (system:getenv-or-default "XDG_STATE_HOME"
       (path:join (system:getenv-or-default "HOME" (system:expanduser "~")) ".local/state")))
     ("INSTANCE" (system:getenv-or-default "METTACLAW_INSTANCE" (cfg:last (str:split "/" $root))))
     ("USER" (system:getenv-or-default "USER" ""))
     ("HOME" (system:getenv-or-default "HOME" (system:expanduser "~")))
     ($other (system:getenv-or-default $other $original)))))
(= (cfg:expand-vars $text $root)
  (case (re:find (cfg:environment-pattern) $text)
    ((re:no-match $text)
     ((re:match $start $end $captures)
      (let* (($prefix (str:byte-slice $text 0 $start))
             ($original (str:byte-slice $text $start $end))
             ($length (str:byte-length $original))
             ($name (if (str:starts-with $original "${")
                      (str:byte-slice $original 2 (- $length 1))
                      (str:byte-slice $original 1 $length)))
             ($value (cfg:environment $name $root $original))
             ($suffix (str:byte-slice $text $end (str:byte-length $text)))
             ($tail (cfg:expand-vars $suffix $root)))
        (str:join "" ($prefix $value $tail))))
     ($error (ConfigFailedV1 "environment expansion failed")))))
(= (cfg:expand $value $root)
  (if (== (get-type $value) String)
    (system:expanduser (cfg:expand-vars $value $root)) $value))
(= (cfg:replace $text $old $new) (str:join $new (str:split $old $text)))
(= (cfg:quote $text) (let $escaped (cfg:replace $text "'" "'\"'\"'") (str:join "" ("'" $escaped "'"))))
(= (cfg:scalar $value)
  (case $value
    (((TomlTemporalV1 $kind $text)
      (if (or (== $kind datetime) (== $kind datetime-offset)) (cfg:replace $text "T" " ") $text))
     ($other (cfg:scalar-ordinary $other)))))
(= (cfg:scalar-ordinary $value)
  (case (get-type $value)
    ((String $value) (Bool (if $value "True" "False"))
     (Number (json:stringify-python $value))
     ($other (ConfigFailedV1 "configuration value is not a supported scalar")))))
(= (cfg:list-texts $items)
  (function (if (== $items ()) (return ())
    (let* (($head (cfg:scalar (car-atom $items)))
           ($tail (cfg:list-texts (cdr-atom $items)))
           ($out (cons-atom $head $tail))) (return $out)))))
(= (cfg:env-text $value)
  (case $value
    (((TomlArrayV1 $items) (str:join "," (cfg:list-texts $items)))
     ((JsonArray $items) (str:join "," (cfg:list-texts $items)))
     ($other (if (== (get-type $other) Bool) (if $other "1" "0") (cfg:scalar $other))))))
(= (cfg:convert $value $root $mode)
  (case $mode
    ((expand (cfg:expand $value $root))
     (json (json:stringify-python (cfg:json-value $value)))
     (bool-int (if $value 1 0))
     ($other $value))))
(= (cfg:render-fields $defaults $local $root $fields)
  (if (== $fields ()) (ConfigTextV1 "")
    (let (ConfigFieldV1 $env $section $key $fallback $mode) (car-atom $fields)
      (let* (($raw (cfg:value $defaults $local $section $key $fallback))
             ($value (cfg:convert $raw $root $mode))
             ($line (if (or (== $value JsonNull) (== $value "")) ""
               (let $text (cfg:env-text $value)
                 (if (== (get-type $text) String)
                   (let $quoted (cfg:quote $text) (str:join "" ("export " $env "=" $quoted "\n")))
                   $text)))))
        (if (not (== (get-type $line) String)) (ConfigFailedV1 (format-args "cannot encode configuration field: {}" ($env)))
          (case (cfg:render-fields $defaults $local $root (cdr-atom $fields))
            (((ConfigTextV1 $tail) (ConfigTextV1 (str:concat $line $tail)))
             ($error $error))))))))

(= (cfg:contains? $text $part)
  (case (str:find $text $part) (((TextNotFound $missing) False) ($found True))))
(= (cfg:file-names? $value)
  (case $value (((TomlArrayV1 $items) (cfg:file-name-items? $items))
                ((JsonArray $items) (cfg:file-name-items? $items)) ($other False))))
(= (cfg:file-name-items? $items)
  (if (== $items ()) True
    (let $name (car-atom $items)
      (if (== (get-type $name) String)
        (and (not (or (== $name "") (or (== $name ".") (== $name ".."))))
          (and (not (or (cfg:contains? $name "/") (cfg:contains? $name "\0")))
               (cfg:file-name-items? (cdr-atom $items)))) False))))
(= (cfg:number? $value)
  (if (== (get-type $value) Number)
    (let $text (json:stringify-python $value)
      (not (or (== $text "NaN") (or (== $text "Infinity") (== $text "-Infinity"))))) False))
(= (cfg:integer? $value)
  (if (cfg:number? $value)
    (case (re:full-match (re:pattern "-?[0-9]+") (json:stringify-python $value))
      (((re:match $start $end $captures) True) ($other False))) False))
(= (cfg:valid? $rule $value)
  (case $rule
    ((filenames (cfg:file-names? $value))
     (text (== (get-type $value) String))
     (boolean (== (get-type $value) Bool))
     (optional-timeout (if (== $value JsonNull) True
       (if (cfg:number? $value) (>= $value 1) False)))
     (wait (if (cfg:number? $value) (and (> $value 0) (<= $value 2147483)) False))
     (optional-natural (if (== $value JsonNull) True
       (if (cfg:integer? $value) (>= $value 0) False)))
     (nonnegative (if (cfg:number? $value) (>= $value 0) False))
     (ttl (or (== $value "5m") (== $value "1h")))
     ($other False))))
(= (cfg:checks)
  ((ConfigCheckV1 "coding" "project_root_markers" (JsonArray (".git")) filenames)
   (ConfigCheckV1 "coding" "project_doc_fallback_filenames" (JsonArray ()) filenames)
   (ConfigCheckV1 "paths" "coding_guidance_dir" "" text)
   (ConfigCheckV1 "agent" "llm_timeout_seconds" JsonNull optional-timeout)
   (ConfigCheckV1 "agent" "llm_hard_seconds" 1800 wait)
   (ConfigCheckV1 "agent" "llm_connect_seconds" 30 wait)
   (ConfigCheckV1 "agent" "llm_first_byte_seconds" 900 wait)
   (ConfigCheckV1 "agent" "llm_idle_seconds" 180 wait)
   (ConfigCheckV1 "agent" "llm_stream" True boolean)
   (ConfigCheckV1 "agent" "recycle_bytes" JsonNull optional-natural)
   (ConfigCheckV1 "agent" "input_ack_seconds" 15 nonnegative)
   (ConfigCheckV1 "agent" "model_commentary" False boolean)
   (ConfigCheckV1 "agent" "public_tool_receipts" False boolean)
   (ConfigCheckV1 "context" "anthropic_cache_ttl" "5m" ttl)))
(= (cfg:validate-checks $defaults $local $checks)
  (if (== $checks ()) ConfigValidV1
    (let (ConfigCheckV1 $section $key $fallback $rule) (car-atom $checks)
      (let $value (cfg:value $defaults $local $section $key $fallback)
        (if (cfg:valid? $rule $value)
          (cfg:validate-checks $defaults $local (cdr-atom $checks))
          (ConfigFailedV1 (format-args "invalid configuration field: {}.{}" ($section $key))))))))
(= (cfg:validate $defaults $local)
  (case (cfg:validate-checks $defaults $local (cfg:checks))
    ((ConfigValidV1
      (let* (($soft (cfg:value $defaults $local "agent" "llm_timeout_seconds" JsonNull))
             ($hard (cfg:value $defaults $local "agent" "llm_hard_seconds" 1800)))
        (if (== $soft JsonNull) ConfigValidV1
          (if (< $hard $soft) (ConfigFailedV1 "native model hard deadline precedes its soft wait") ConfigValidV1))))
     ($error $error))))
(= (cfg:read $file)
  (let $text (catch (fs:read-text $file))
    (if (== (get-type $text) String)
      (case (cfg:parse $text)
        (((TomlTableV1 $fields) (TomlTableV1 $fields))
         ((JsonObject $pairs) (JsonObject $pairs))
         ($other (ConfigFailedV1 "invalid TOML configuration"))))
      (ConfigFailedV1 "configuration cannot be read"))))
(= (cfg:load $file $directory)
  (let* (($root (cfg:absolute $directory))
         ($local (cfg:read $file))
         ($default-path (path:join $root "config/default.toml"))
         ($defaults (if (fs:is-file $default-path) (cfg:read $default-path) (JsonObject ()))))
    (if (and (cfg:table? $defaults) (cfg:table? $local))
      (case (cfg:validate $defaults $local)
        ((ConfigValidV1 (ConfigLoadedV1 $root $defaults $local))
         ($error $error)))
      (ConfigFailedV1 "configuration cannot be loaded"))))
(= (cfg:render $file $directory)
  (case (cfg:load $file $directory)
    (((ConfigLoadedV1 $root $defaults $local) (cfg:render-fields $defaults $local $root (cfg:fields)))
     ($bad $bad))))


; Compatibility with an older native kernel is explicit; no Python is used.
; Full qualification requires the typed native path, including nonfinite data.
(= (cfg:parse $text)
  (case (__cetta_lib_toml parse-value ($text))
    (((toml:failed toml:invalid-argument $detail) (toml:parse $text))
     ($value $value))))

(= (cfg:channel $kind)
  (if (or (== $kind "telegram") (or (== $kind "irc") (== $kind "mattermost")))
    (ConfigChannelTextV1 (str:join ""
      (";; Generated from config/local.toml [channel] kind. Do not edit.\n"
       "(= (configureChannel) (configure commchannel " $kind "))\n")))
    (ConfigFailedV1 "unsupported channel kind")))

; Publication shares the existing configuration editor's serialization point.
; The complete derived file is synced before rename, then its parent is synced.
(= (cfg:close-with $owner $result)
  (case (fs:close $owner)
    ((fs:closed $result) ($bad (ConfigFailedV1 "configuration close failed")))))
(= (cfg:publish-write $root $text)
  (let* (($temporary (str:join "" ($root "/.env.native." (repr (system:pid)) "." (repr (system:monotonic-ns)))))
         ($owner (fs:open-write $temporary ("create" "exclusive") 384)))
    (case $owner
      (((NativeHandle "file-writer" $id)
        (let $written (cfg:close-with $owner
            (case (fs:write-all $owner $text)
              (((fs:written $count)
                (if (== $count (str:byte-length $text))
                  (case (fs:sync $owner)
                    ((fs:synced ConfigWrittenV1) ($bad (ConfigFailedV1 "configuration sync failed"))))
                  (ConfigFailedV1 "configuration write incomplete")))
               ($bad (ConfigFailedV1 "configuration write failed")))))
          (let $published
              (if (== $written ConfigWrittenV1)
                (case (fs:rename $temporary (path:join $root ".env"))
                  ((() (cfg:sync-directory $root))
                   ($bad (ConfigFailedV1 "configuration rename failed"))))
                $written)
            (let $cleaned (fs:remove $temporary) $published))))
       ($bad (ConfigFailedV1 "configuration temporary file cannot be created"))))))
(= (cfg:sync-directory $root)
  (let $owner (fs:open-directory $root)
    (case $owner
      (((NativeHandle "directory-reader" $id)
        (cfg:close-with $owner
          (case (fs:sync $owner)
            ((fs:synced ConfigPublishedV1)
             ($bad (ConfigFailedV1 "configuration publication durability is uncertain"))))))
       ($bad (ConfigFailedV1 "configuration publication durability is uncertain"))))))
(= (cfg:publish-held $root)
  (case (cfg:load (path:join $root "config/local.toml") $root)
    (((ConfigLoadedV1 $base $defaults $local)
      (case (cfg:render-fields $defaults $local $base (cfg:fields))
        (((ConfigTextV1 $text)
          (let $warned (cfg:warn-fields $defaults $local $base (cfg:fields))
            (cfg:publish-write $base (str:concat "# Generated by native CeTTa configuration.\n" $text))))
         ($bad $bad))))
     ($bad $bad))))
(= (cfg:warn-fields $defaults $local $root $fields)
  (if (== $fields ()) True
    (let (ConfigFieldV1 $env $section $key $fallback $mode) (car-atom $fields)
      (let* (($value (cfg:convert (cfg:value $defaults $local $section $key $fallback) $root $mode))
             ($inherited (system:getenv-or-default $env ConfigEnvUnsetV1))
             ($warned
               (if (or (== $value JsonNull) (or (== $value "") (== $inherited ConfigEnvUnsetV1))) True
                 (if (== $inherited (cfg:env-text $value)) True
                   (let $written (system:write stderr (str:join ""
                     ("config: " $env " from the caller's environment is replaced by config/local.toml or config/default.toml; set it there instead\n"))) True)))))
        (cfg:warn-fields $defaults $local $root (cdr-atom $fields))))))
(= (cfg:publish $directory)
  (let* (($root (cfg:absolute $directory))
         ($owner (fs:open-write (path:join $root "config/.edit.lock") ("create" "append") 384)))
    (case $owner
      (((NativeHandle "file-writer" $id)
        (cfg:close-with $owner
          (case (fs:set-mode $owner 384)
            ((fs:mode-set
              (case (fs:lock $owner exclusive)
                ((fs:locked (cfg:publish-held $root))
                 ($bad (ConfigFailedV1 "configuration editor is unavailable")))))
             ($bad (ConfigFailedV1 "configuration editor permissions cannot be set"))))))
       ($bad (ConfigFailedV1 "configuration editor cannot be opened"))))))
