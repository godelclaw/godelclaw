; SPDX-License-Identifier: MIT
; ECAN mark 1: native attention, independent of belief evidence and memory text.
; Query exposure is a weak signal, never a claim that a result was useful.
!(import! &self ./src/ecan_bank.metta)
!(import! &self ./src/ecan_decay.metta)
!(import! &self ./src/attention_parameters.metta)
!(import! &self ./src/workspaces_cetta.metta)
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library str))
!(import! &self (library system))
!(bind! &am-state (new-state Unopened))
!(bind! &am-used (new-state ()))
!(bind! &am-last (new-state (AttentionQuery none ())))

(= (am:path)
   (system:getenv-or-default "METTACLAW_ATTENTION_PATH"
     (path:join (path:dirname
                  (system:getenv-or-default "METTACLAW_ENGINE_STATE_PATH"
                    (path:join (path:dirname (sm:config-path)) "engine"))) "attention.metta")))
(= (am:defaults $bank) (am:install-defaults $bank (settings:specs "attention")))
(= (am:install-defaults $bank $specs)
   (if (== $specs ()) True
     (let (SettingSpec 1 $ns $key $default $unit $domain $life $description $reader $writer) (car-atom $specs)
       (let $_ (if (ecan:known-key? (parse $key)) True
                  (add-atom $bank (AttentionSetting $key $default)))
         (am:install-defaults $bank (cdr-atom $specs))))))
(= (am:install $bank $rows)
   (if (== $rows ()) True
     (let $row (car-atom $rows)
       (let $_ (add-atom $bank $row) (am:install $bank (cdr-atom $rows))))))
(= (am:open)
   (case (get-state &am-state)
     ((Unopened
        (let $loaded (case (catch (am:load))
                          (((Error $where $why) (AttentionUnavailable snapshot $why)) ($value $value)))
          (let $_ (change-state! &am-state $loaded) $loaded)))
      ($state $state))))
(= (am:load)
   (if (fs:exists (am:path))
     (case (fs:read-text-result (am:path) 0 "raw")
       ((("ok" $text)
         (case (parse $text)
           (((AttentionSnapshot 1 $time $snapshot $settings $links)
             (case (ecan:restore $snapshot)
               (((ECANError $a $b $c $d) (AttentionUnavailable snapshot $c))
                ($bank (let* (($_ (am:defaults $bank))
                              ($valid (am:restore-settings $bank $settings))
                              ($_ (am:install $bank $links)))
                          (if (== $valid True) (AttentionReady $bank $time) $valid))))))
            ($other (AttentionUnavailable snapshot "unrecognized snapshot; file preserved")))))
        ($error (AttentionUnavailable read $error))))
     (let* (($bank (ecan:new)) ($_ (am:defaults $bank)))
       (AttentionReady $bank (system:wall-time)))))
(= (am:bank)
   (case (am:open)
     (((AttentionReady $bank $time) $bank) ($error $error))))
(= (am:tick)
   (case (am:open)
     (((AttentionReady $bank $time)
       (let* (($now (system:wall-time))
              ($_ (ecan:advance $bank (max 0 (- $now $time))))
              ($_ (change-state! &am-state (AttentionReady $bank $now)))) $bank))
      ($error $error))))
(= (am:settings $bank)
   (collapse (match $bank (AttentionSetting $key $value) (AttentionSetting $key $value))))
(= (am:links $bank)
   (collapse (match $bank (AttentionLink $from $to $weight) (AttentionLink $from $to $weight))))
(= (am:graph-state $bank)
   (union-atom (am:links $bank)
     (collapse (match $bank (AttentionBootstrapped $id $revision $count $minimum $weight)
       (AttentionBootstrapped $id $revision $count $minimum $weight)))))
(= (am:save)
   (case (am:open)
     (((AttentionReady $bank $time)
       (case (fs:update-text (am:path) "replace"
               (repr (AttentionSnapshot 1 $time (ecan:snapshot $bank) (am:settings $bank) (am:graph-state $bank))) "" "")
         ((("written" $path $n $digest $backup) True) ($error (AttentionUnavailable save $error)))))
      ($error $error))))
(= (am:own-key? $key) (not (ecan:known-key? (parse $key))))
(= (am:get $bank $key)
   (if (am:own-key? $key)
     (case (collapse (match $bank (AttentionSetting $key $value) $value))
       ((($value) $value) (() (settings:default "attention" $key))))
     (ecan:setting $bank (parse $key))))
(= (am:mode? $mode) (or (== $mode "similarity") (or (== $mode "attention") (== $mode "hybrid"))))
(= (am:number $value) (if (== (get-type $value) String) (parse $value) $value))
(= (am:valid $key $value)
   (case (settings:validate "attention" $key $value)
     ((True True)
      ((SettingUnknown $ns $key) (ECANError configure (parse $key) "unknown setting" $value))
      ($error $error))))
(= (am:integer $key $value $min)
   (if (== (ecan:nonnegative configure $key $value) True)
     (if (and (>= $value $min) (== $value (floor-math $value))) True
       (AttentionError setting $key "expected an integer in the setting's domain"))
     (AttentionError setting $key "expected a finite number")))

(= (attention-policy)
   (case (am:open)
     (((AttentionReady $bank $time)
       (AttentionPolicy (am:settings $bank) (ecan:policy $bank)
          (Items (size-atom (ecan:values $bank))) (Links (size-atom (am:links $bank)))))
      ($error $error))))
(= (attention-policy $key $raw)
   (let* (($value (if (== $key "mode") $raw (am:number $raw)))
          ($check (am:valid $key $value)))
     (if (== $check True)
       (case (am:open)
         (((AttentionReady $bank $time)
           (let* (($_ (if (am:own-key? $key)
                         (let $_ (collapse (match $bank (AttentionSetting $key $old)
                                   (remove-atom $bank (AttentionSetting $key $old))))
                           (add-atom $bank (AttentionSetting $key $value)))
                         (ecan:configure $bank (parse $key) $value)))
                  ($saved (am:save)))
             (AttentionConfigured $key $value $saved)))
          ($error $error))) $check)))
(= (attention-last) (get-state &am-last))
(= (am:context)
   (if (semantic:native?) (am:context-native) (AttentionMemory requires-native-memory)))
(= (am:context-native)
   (case (am:open)
     (((AttentionReady $bank $time)
       (AttentionMemory (Mode (am:get $bank "mode"))
         (SimilarityWeight (am:get $bank "similarity-weight"))
         (SpreadRounds (am:get $bank "spread-rounds"))
         (Controls attention-policy attention-use attention-link attention-focus attention-last)))
      ($error $error))))

; These controls address only existing current memory IDs. Missing/retired
; records are never recreated by attention. Metadata contains IDs, not text.
(= (am:current? $id)
   (case (sm:open)
     (((MStore $space $p $d)
       (case (sm:one $space $id) (((Memory $i $r $pr $v $doc $m) True) ($other False))))
      ($other False))))
(= (attention-use $id) (attention-use $id 1))
(= (attention-use $id $raw)
   (let $amount (am:number $raw)
     (let $check (ecan:nonnegative use amount $amount)
       (if (== $check True)
         (if (am:current? $id)
           (case (am:open)
             (((AttentionReady $bank $time)
               (let* (($_ (am:tick))
                      ($_ (if (> $amount 0) (am:learn-use $bank $id) True))
                      ($value (if (== $amount 0) (ecan:current $bank $id)
                         (let $_ (am:pulse $bank $id $amount)
                           (ecan:consolidate $bank $id (ecan:setting $bank sti-mti-rate)
                                                     (ecan:setting $bank mti-lti-rate)))))
                      ($saved (am:save))) (AttentionUsed $value $saved)))
              ($error $error)))
           (AttentionError use $id "memory is absent or unavailable")) $check))))
(= (attention-link $from $to $raw)
   (let $weight (am:number $raw)
     (let $check (ecan:nonnegative link weight $weight)
       (if (== $check True)
         (if (and (am:current? $from) (am:current? $to))
           (case (am:open)
             (((AttentionReady $bank $time)
               (let* (($_ (collapse (match $bank (AttentionLink $from $to $old)
                                     (remove-atom $bank (AttentionLink $from $to $old)))))
                      ($_ (if (> $weight 0) (add-atom $bank (AttentionLink $from $to $weight)) True))
                      ($saved (am:save))) (AttentionLinked $from $to $weight $saved)))
              ($error $error)))
           (AttentionError link "both IDs must be current memories")) $check))))
(= (am:drop $id)
   (case (am:open)
     (((AttentionReady $bank $time)
       (let* (($_ (change-state! &am-used (am:without $id (get-state &am-used))))
              ($_ (ecan:set $bank $id 0 0 0))
              ($_ (remove-atom $bank (ECANValue $id 0 0 0)))
              ($_ (collapse (match $bank (AttentionLink $id $to $w)
                              (remove-atom $bank (AttentionLink $id $to $w)))))
              ($_ (collapse (match $bank (AttentionLink $from $id $w)
                              (remove-atom $bank (AttentionLink $from $id $w)))))
              ($_ (collapse (match $bank (AttentionBootstrapped $id $r $n $m $w)
                              (remove-atom $bank (AttentionBootstrapped $id $r $n $m $w)))))) (am:save)))
      ($error $error))))
(= (am:read $id)
   (case (am:open)
     (((AttentionReady $bank $time)
       (let $_ (if (> (am:get $bank "read-stimulus") 0) (am:bootstrap-read $bank $id) True)
         (attention-use $id (am:get $bank "read-stimulus"))))
      ($error $error))))
(= (am:focus $bank $count)
   (ecan:focus $bank $count (am:get $bank "sti-weight")
     (am:get $bank "mti-weight") (am:get $bank "lti-weight")))
(= (am:view-focus $bank $count)
   (if (== (get-state &ws-filter) All) (am:focus $bank $count)
     (let* (($all (am:focus $bank 0))
            ($rows (collapse (let $row (superpose $all)
              (let ($score (ECANValue $id $s $m $l)) $row (if (ws:allows $id) $row (empty)))))))
       (if (== $count 0) $rows (list:retain-top-k-keyed $rows $count)))))
(= (attention-focus) (attention-focus 20))
(= (attention-focus $raw)
   (let* (($count (am:number $raw)) ($check (am:integer count $count 0)))
     (if (== $check True)
       (case (am:open)
         (((AttentionReady $bank $time) (let $_ (am:tick) (am:focus $bank $count)))
          ($error $error))) $check)))

; Temporary per-query maps. Every edge is keyed (from,to); replacing it is
; idempotent. Rows normalize outgoing weights; dangling nodes retain mass.
(= (am:mass $map $id)
   (case (collapse (match $map (AttentionMass $id $value) $value)) ((() 0) (($value) $value))))
(= (am:add $map $id $amount)
   (let* (($old (am:mass $map $id))
          ($_ (remove-atom $map (AttentionMass $id $old)))
          ($next (+ $old $amount)))
     (add-atom $map (AttentionMass $id $next))))
(= (am:mass-rows $map)
   (collapse (match $map (AttentionMass $id $value) (AttentionMass $id $value))))
(= (am:sum-mass $rows)
   (if (== $rows ()) 0
     (let (AttentionMass $id $v) (car-atom $rows) (+ $v (am:sum-mass (cdr-atom $rows))))))
(= (am:max-mass $rows)
   (if (== $rows ()) 0
     (let (AttentionMass $id $v) (car-atom $rows) (max $v (am:max-mass (cdr-atom $rows))))))
(= (am:copy $rows $dest $factor)
   (if (== $rows ()) True
     (let (AttentionMass $id $v) (car-atom $rows)
       (let $_ (am:add $dest $id (* $factor $v)) (am:copy (cdr-atom $rows) $dest $factor)))))
(= (am:edges $bank $id)
   (if (not (ws:traverse? $id)) ()
   (collapse (match $bank (AttentionLink $id $target $w)
     (case (collapse (memory:record $target))
       ((() (empty)) ($rows (if (ws:traverse? $target) ($target $w) (empty)))))))))
(= (am:sum-edges $edges)
   (if (== $edges ()) 0
     (let ($id $w) (car-atom $edges) (+ $w (am:sum-edges (cdr-atom $edges))))))
(= (am:pay $edges $dest $amount $total)
   (if (== $edges ()) True
     (let ($id $w) (car-atom $edges)
       (let $_ (am:add $dest $id (* $amount (/ $w $total)))
         (am:pay (cdr-atom $edges) $dest $amount $total)))))
(= (am:transport $bank $rows $dest $factor)
   (if (== $rows ()) True
     (let* (((AttentionMass $id $v) (car-atom $rows)) ($edges (am:edges $bank $id))
            ($total (am:sum-edges $edges))
            ($_ (if (> $total 0) (am:pay $edges $dest (* $factor $v) $total)
                                 (am:add $dest $id (* $factor $v)))))
       (am:transport $bank (cdr-atom $rows) $dest $factor))))
(= (am:rounds $bank $seeds $current $rounds $restart)
   (if (== $rounds 0) $current
     (let* (($next (new-space)) ($_ (am:copy $seeds $next $restart))
            ($_ (am:transport $bank $current $next (- 1 $restart))))
       (am:rounds $bank $seeds (am:mass-rows $next) (- $rounds 1) $restart))))

(= (am:mix $bank $mode)
   (if (== $mode "similarity") 1 (if (== $mode "attention") 0 (am:get $bank "similarity-weight"))))

; Each round may stop early with an exact certificate (MeTTapedia
; BlendedTopK.certified_blend_topk). With e = (1-restart)/restart times the
; round's l1 change and M the largest mass, every converged blended score is
; within (1-mix)*2e/M of the observed one. Unscored memories hold no mass and,
; the similarity pool being an exact top-N, score at most mix times its floor.
; The selection is certified when its lowest score beats every other scored
; candidate and that floor by more than twice the bound.
(= (am:spread-certified $bank $profile $vector $seeds $current $left $done $restart $mix $count $sims $floor)
   (if (== $left 0) (AttentionSpread $current $done Uncertified)
     (let* (($next (new-space)) ($_ (am:copy $seeds $next $restart))
            ($_ (am:transport $bank $current $next (- 1 $restart)))
            ($rows (am:mass-rows $next))
            ($_ (am:remember-sims $sims (am:score-ids $profile $vector (am:unscored-ids $sims $rows))))
            ($verdict (am:certify $rows (am:l1-change $rows $current) $restart $mix $count $sims $floor)))
       (if (== $verdict Certified) (AttentionSpread $rows (+ $done 1) Certified)
         (am:spread-certified $bank $profile $vector $seeds $rows (- $left 1) (+ $done 1)
           $restart $mix $count $sims $floor)))))
(= (am:certify $rows $change $restart $mix $count $sims $floor)
   (let $M (am:max-mass $rows)
     (if (or (<= $restart 0) (or (== $count 0) (<= $M 0))) Uncertified
       (let* (($e (* (/ (- 1 $restart) $restart) $change))
              ($slack (* 2 (* (- 1 $mix) (/ (* 2 $e) $M))))
              ($mass (new-space)) ($_ (am:install $mass $rows))
              ($scored (am:blend-scores (collapse (match $sims (AttentionSim $id $sim) (AttentionSim $id $sim)))
                         $mass $mix $M))
              ($top (list:retain-top-k-keyed $scored $count))
              ($low (am:min-key $top 2))
              ($high (am:max-key (am:outside $scored $top) (am:virtual $mix $floor))))
         (if (> (- $low $high) $slack) Certified Uncertified)))))
(= (am:blend-scores $rows $mass $mix $M)
   (if (== $rows ()) ()
     (let* (((AttentionSim $id $sim) (car-atom $rows))
            ($score (+ (* $mix $sim) (* (- 1 $mix) (/ (am:mass $mass $id) $M)))))
       (cons-atom ($score $id) (am:blend-scores (cdr-atom $rows) $mass $mix $M)))))
(= (am:virtual $mix Exhaustive) -1)
(= (am:virtual $mix (Floor $sim)) (* $mix $sim))
(= (am:pool-floor $bank $similar $count)
   (if (or (== $count 0) (< (size-atom $similar) (* $count (am:get $bank "candidate-multiplier"))))
     Exhaustive (Floor (am:min-sim $similar 1))))
(= (am:min-sim $rows $best)
   (if (== $rows ()) $best
     (let ($cos (MemoryInfo $id $r $d $m)) (car-atom $rows)
       (am:min-sim (cdr-atom $rows) (min $best (max 0 (/ (+ 1 $cos) 2)))))))
(= (am:remember-sims $sims $rows)
   (if (== $rows ()) True
     (let* ((($cos (MemoryInfo $id $r $d $m)) (car-atom $rows)) ($sim (max 0 (/ (+ 1 $cos) 2)))
            ($_ (add-atom $sims (AttentionSim $id $sim))))
       (am:remember-sims $sims (cdr-atom $rows)))))
(= (am:unscored-ids $sims $rows)
   (if (== $rows ()) ()
     (let* (((AttentionMass $id $v) (car-atom $rows)) ($tail (am:unscored-ids $sims (cdr-atom $rows))))
       (if (== (collapse (match $sims (AttentionSim $id $s) $s)) ()) (cons-atom $id $tail) $tail))))
(= (am:l1-change $new $old)
   (let* (($before (new-space)) ($_ (am:install $before $old)) ($d (am:l1-matched $new $before)))
     (+ $d (am:sum-mass (am:mass-rows $before)))))
(= (am:l1-matched $rows $before)
   (if (== $rows ()) 0
     (let* (((AttentionMass $id $v) (car-atom $rows)) ($o (am:mass $before $id))
            ($_ (remove-atom $before (AttentionMass $id $o))))
       (+ (abs-math (- $v $o)) (am:l1-matched (cdr-atom $rows) $before)))))
(= (am:min-key $rows $best)
   (if (== $rows ()) $best
     (let ($s $id) (car-atom $rows) (am:min-key (cdr-atom $rows) (min $s $best)))))
(= (am:max-key $rows $best)
   (if (== $rows ()) $best
     (let ($s $id) (car-atom $rows) (am:max-key (cdr-atom $rows) (max $s $best)))))
(= (am:outside $rows $top)
   (if (== $rows ()) ()
     (let* ((($s $id) (car-atom $rows)) ($tail (am:outside (cdr-atom $rows) $top)))
       (if (am:keyed-member-of $id $top) $tail (cons-atom ($s $id) $tail)))))
(= (am:keyed-member-of $id $rows)
   (if (== $rows ()) False
     (let ($s $other) (car-atom $rows)
       (if (== $id $other) True (am:keyed-member-of $id (cdr-atom $rows))))))

(= (am:importance $bank $id)
   (let (ECANValue $i $s $m $l) (ecan:current $bank $id)
     (+ (+ (* $s (am:get $bank "sti-weight")) (* $m (am:get $bank "mti-weight")))
        (* $l (am:get $bank "lti-weight")))))
(= (am:focus-ids $rows)
   (if (== $rows ()) ()
     (let ($score (ECANValue $id $s $m $l)) (car-atom $rows)
       (cons-atom $id (am:focus-ids (cdr-atom $rows))))))
(= (am:hit-ids $rows)
   (if (== $rows ()) ()
     (let ($s (MemoryInfo $id $r $d $m)) (car-atom $rows)
       (cons-atom $id (am:hit-ids (cdr-atom $rows))))))
(= (am:score-ids $profile $vector $ids)
   (if (== $ids ()) ()
     (let* (($id (car-atom $ids)) ($row (collapse (memory:record $id)))
            ($rest (am:score-ids $profile $vector (cdr-atom $ids))))
       (if (not (ws:allows $id)) $rest (case $row
         ((($record) (case (memory:score $profile $vector $record)
                       ((($score (MemoryInfo $i $r $d $m)) (cons-atom ($score (MemoryInfo $i $r $d $m)) $rest))
                        ($error $rest))))
          ($other $rest)))))))
(= (am:seed $bank $rows $dest $max-importance)
   (if (== $rows ()) True
     (let* ((($cos (MemoryInfo $id $r $d $m)) (car-atom $rows))
            ($mix (am:get $bank "seed-similarity-weight"))
            ($value (+ (* $mix (max 0 (/ (+ 1 $cos) 2)))
                       (* (- 1 $mix) (if (> $max-importance 0) (/ (am:importance $bank $id) $max-importance) 0))))
            ($_ (am:add $dest $id $value)))
       (am:seed $bank (cdr-atom $rows) $dest $max-importance))))
(= (am:rerank $bank $rows $spread $max-attn $mode $dest)
   (if (== $rows ()) True
     (let* ((($cos (MemoryInfo $id $r $d $m)) (car-atom $rows))
            ($sim (max 0 (/ (+ 1 $cos) 2)))
            ($attn (if (> $max-attn 0) (/ (am:mass $spread $id) $max-attn) 0))
            ($mix (am:mix $bank $mode))
            ($score (+ (* $mix $sim) (* (- 1 $mix) $attn)))
            ($importance (am:importance $bank $id))
            ($_ (add-atom $dest (AttentionRank $id $sim $importance $attn $score)))
            ($_ (add-atom $dest (AttentionResult $score ($cos (MemoryInfo $id $r $d $m))))))
       (am:rerank $bank (cdr-atom $rows) $spread $max-attn $mode $dest))))
(= (am:expose $bank $rows)
   (if (== $rows ()) True
     (let ($cos (MemoryInfo $id $r $d $m)) (car-atom $rows)
       (let* (($mix (am:get $bank "exposure-similarity-weight"))
              ($amount (* (am:get $bank "exposure") (+ (- 1 $mix) (* $mix (max 0 (min 1 $cos)))))))
        (let $_ (if (> $amount 0) (am:pulse $bank $id $amount) True)
         (am:expose $bank (cdr-atom $rows)))))))

; Spread only the new pulse, synchronously. Receiving it does not generate a
; second recall event, learn a link, or consolidate a neighbour into MTI/LTI.
(= (am:pulse $bank $id $amount)
   (let* (($fraction (am:get $bank "recall-spread")) ($pulse ((AttentionMass $id $amount)))
          ($next (new-space)) ($_ (am:copy $pulse $next (- 1 $fraction)))
          ($_ (am:transport $bank $pulse $next $fraction)))
     (am:apply-pulse $bank (am:mass-rows $next))))
(= (am:apply-pulse $bank $rows)
   (if (== $rows ()) True
     (let (AttentionMass $id $amount) (car-atom $rows)
       (let $_ (if (> $amount 0) (ecan:stimulate $bank $id $amount) True)
         (am:apply-pulse $bank (cdr-atom $rows))))))

; An initial semantic prior uses memory-to-memory cosine, not co-occurrence.
; Reuse the query's current candidate pool; there is no all-pairs graph build.
; Endpoint replacement is idempotent and never overwrites an existing link.
(= (am:bootstrap $bank $profile $rows $candidates)
   (if (or (== $rows ()) (or (== (am:get $bank "bootstrap-neighbours") 0)
                             (== (am:get $bank "bootstrap-weight") 0))) True
     (let* ((($cos (MemoryInfo $id $revision $doc $meta)) (car-atom $rows))
            ($_ (am:bootstrap-one $bank $profile $id $revision $candidates)))
       (am:bootstrap $bank $profile (cdr-atom $rows) $candidates))))
(= (am:bootstrap-one $bank $profile $id $revision $candidates)
   (let* (($count (am:get $bank "bootstrap-neighbours"))
          ($minimum (am:get $bank "bootstrap-min-similarity"))
          ($weight (am:get $bank "bootstrap-weight"))
          ($stamp (AttentionBootstrapped $id $revision $count $minimum $weight)))
     (if (not (== (collapse (match $bank $stamp True)) ())) True
       (case (collapse (memory:record $id))
         ((( (Memory $i $rev $p $vector $doc $meta))
           (let* (($scored (am:score-ids $profile $vector (am:without $id $candidates)))
                  ($options (am:bootstrap-options $scored $minimum))
                  ($chosen (list:retain-top-k-keyed $options $count))
                  ($_ (am:initial-links $bank $id $chosen $weight)))
             (if (== $chosen ()) True
               (let $_ (collapse (match $bank (AttentionBootstrapped $id $r $n $m $w)
                                 (remove-atom $bank (AttentionBootstrapped $id $r $n $m $w))))
                 (add-atom $bank $stamp)))))
          ($other True))))))
(= (am:bootstrap-options $rows $minimum)
   (if (== $rows ()) ()
     (let* ((($cos (MemoryInfo $id $r $d $m)) (car-atom $rows))
            ($tail (am:bootstrap-options (cdr-atom $rows) $minimum)))
       (if (and (> $cos 0) (>= $cos $minimum)) (cons-atom ($cos $id) $tail) $tail))))
(= (am:initial-links $bank $id $rows $weight)
   (if (== $rows ()) True
     (let* ((($cos $target) (car-atom $rows))
            ($initial (* $weight $cos))
            ($_ (if (== (collapse (match $bank (AttentionLink $id $target $old) $old)) ())
                  (add-atom $bank (AttentionLink $id $target $initial)) True)))
       (am:initial-links $bank $id (cdr-atom $rows) $weight))))
(= (am:bootstrap-read $bank $id)
   (if (or (== (am:get $bank "bootstrap-neighbours") 0) (== (am:get $bank "bootstrap-weight") 0)) True
     (case (collapse (memory:record $id))
       ((((Memory $i $revision $profile $vector $doc $meta))
         (let $peers (ws:query $profile $vector
                          (+ 1 (am:get $bank "bootstrap-neighbours")))
           (am:bootstrap $bank $profile ((1 (MemoryInfo $id $revision $doc $meta))) (am:hit-ids $peers))))
        ($other True)))))

; Similarity is the unmodified native result path; hybrid/attention add a
; focus pool and reachable linked IDs. The cosine distance stays a distance.
; Rounds are an agent-owned work budget; spreading stops earlier once the
; selection is certified exact (see am:certify).
(= (am:fallback $profile $vector $count $error)
   (let $_ (change-state! &am-last (AttentionQuery fallback-similarity $error))
     (ws:query $profile $vector (if (== $count 0) (ws:count) $count))))
(= (am:select $profile $vector $count $mode)
   (case (catch (am:select-ready $profile $vector $count $mode))
     (((Error $where $why) (am:fallback $profile $vector $count (AttentionUnavailable evaluation $why)))
      ($rows $rows))))
(= (am:select-ready $profile $vector $count $mode)
   (case (am:open)
     (((AttentionReady $bank $time)
       (if (== $mode "similarity") (am:similar-query $bank $profile $vector $count)
        (let* (($_ (am:tick))
              ($pool (if (== $count 0) (ws:count)
                       (* $count (am:get $bank "candidate-multiplier"))))
              ($similar (ws:query $profile $vector $pool)))
         (case $similar
           (((MemoryFailure $at $why) $similar)
            ($rows (am:rank-query $bank $profile $vector $rows $count $mode)))))))
      ($error (am:fallback $profile $vector $count $error)))))

(= (am:rank-query $bank $profile $vector $similar $count $mode)
   (let* (($ids (unique-atom (union-atom (am:hit-ids $similar)
                    (if (== $mode "similarity") () (am:focus-ids (am:view-focus $bank
                      (if (== $count 0) 0 (* $count (am:get $bank "candidate-multiplier")))))))))
          ($rows (am:score-ids $profile $vector $ids))
          ($seed-map (new-space))
          ($focus-max (case (am:view-focus $bank 1) ((() 0) ((($v $item)) $v))))
          ($_ (am:seed $bank $rows $seed-map $focus-max))
          ($raw-seeds (am:mass-rows $seed-map)) ($total (am:sum-mass $raw-seeds))
          ($normal (new-space))
          ($_ (if (> $total 0) (am:copy $raw-seeds $normal (/ 1 $total))
                  (am:uniform-seeds $raw-seeds $normal (size-atom $raw-seeds))))
          ($seeds (am:mass-rows $normal))
          ($sims (new-space)) ($_ (am:remember-sims $sims $rows))
          ((AttentionSpread $spread-rows $rounds $status)
            (am:spread-certified $bank $profile $vector $seeds $seeds
              (if (== $mode "similarity") 0 (am:get $bank "spread-rounds")) 0
              (am:get $bank "restart") (am:mix $bank $mode) $count $sims
              (am:pool-floor $bank $similar $count)))
          ($spread (new-space)) ($_ (am:install $spread $spread-rows))
          ($all-ids (unique-atom (union-atom $ids (collapse (match $sims (AttentionSim $id $s) $id)))))
          ($all-rows (am:score-ids $profile $vector $all-ids))
          ($ranking (new-space))
          ($_ (am:rerank $bank $all-rows $spread (am:max-mass $spread-rows) $mode $ranking))
          ($scored (collapse (match $ranking (AttentionResult $score $row) ($score $row))))
          ($chosen (list:retain-top-k-keyed $scored (if (== $count 0) (size-atom $scored) $count)))
          ($answer (am:unscore $chosen))
          ($_ (am:bootstrap $bank $profile $answer $all-ids))
          ($_ (am:expose $bank $answer))
          ($saved (am:save))
          ($_ (change-state! &am-last (AttentionQuery $mode
                (Scores (collapse (match $ranking (AttentionRank $id $s $i $a $c) (AttentionRank $id $s $i $a $c))))
                (Persistence $saved) (Spread (Rounds $rounds) $status))))) $answer))
(= (am:unscore $rows)
   (if (== $rows ()) ()
     (let ($score $row) (car-atom $rows) (cons-atom $row (am:unscore (cdr-atom $rows))))))

(= (am:mass-ids $rows)
   (if (== $rows ()) ()
     (let (AttentionMass $key $value) (car-atom $rows)
       (cons-atom $key (am:mass-ids (cdr-atom $rows))))))

; Preserve the native similarity ordering exactly, including ties.
(= (am:similar-query $bank $profile $vector $count)
   (let* (($_ (am:tick))
          ($rows (ws:query $profile $vector (if (== $count 0) (ws:count) $count))))
     (case $rows
       (((MemoryFailure $at $why) $rows)
        ($hits
          (let* (($scores (am:similar-scores $bank $hits))
                 ($_ (am:bootstrap $bank $profile $hits (am:hit-ids $hits)))
                 ($_ (am:expose $bank $hits)) ($saved (am:save))
                 ($_ (change-state! &am-last (AttentionQuery "similarity" (Scores $scores) (Persistence $saved))))) $hits))))))
(= (am:similar-scores $bank $rows)
   (if (== $rows ()) ()
     (let* ((($cos (MemoryInfo $id $rev $doc $meta)) (car-atom $rows))
            ($sim (max 0 (/ (+ 1 $cos) 2))) ($importance (am:importance $bank $id)))
       (cons-atom (AttentionRank $id $sim $importance 0 $sim)
         (am:similar-scores $bank (cdr-atom $rows))))))

; Co-use means two explicitly read/stimulated memories in one model turn,
; not two search results. Each pair is observed once per turn; no agent chore.
(= (am:begin-turn) (let $_ (change-state! &am-used ()) True))
(= (am:learn-use $bank $id)
   (let $used (get-state &am-used)
     (if (== (size-atom (unique-atom (cons-atom $id $used))) (size-atom $used)) True
       (let* (($_ (am:co-use $bank $id $used (am:get $bank "co-use-weight")))
              ($_ (change-state! &am-used (cons-atom $id $used)))) True))))
(= (am:co-use $bank $id $others $amount)
   (if (or (== $others ()) (== $amount 0)) True
     (let* (($other (car-atom $others))
            ($_ (am:strengthen $bank $id $other $amount))
            ($_ (am:strengthen $bank $other $id $amount)))
       (am:co-use $bank $id (cdr-atom $others) $amount))))
(= (am:strengthen $bank $from $to $amount)
   (let* (($old (case (collapse (match $bank (AttentionLink $from $to $w) $w))
                 ((() 0) (($value) $value))))
          ($next (+ $old $amount))
          ($_ (remove-atom $bank (AttentionLink $from $to $old))))
     (add-atom $bank (AttentionLink $from $to $next))))

(= (am:without $id $rows)
   (if (== $rows ()) ()
     (if (== $id (car-atom $rows)) (am:without $id (cdr-atom $rows))
       (cons-atom (car-atom $rows) (am:without $id (cdr-atom $rows))))))

(= (attention-policy $key)
   (case (am:open)
     (((AttentionReady $bank $time) (am:get $bank $key)) ($error $error))))
(= (am:restore-settings $bank $rows)
   (if (== $rows ()) True
     (let (AttentionSetting $key $value) (car-atom $rows)
       (if (or (== (am:valid $key $value) True)
               (case (settings:spec "attention" $key) (((SettingUnknown $ns $key) True) ($other False))))
         (let* (($_ (collapse (match $bank (AttentionSetting $key $old)
                                (remove-atom $bank (AttentionSetting $key $old)))))
                ($_ (add-atom $bank (AttentionSetting $key $value))))
           (am:restore-settings $bank (cdr-atom $rows)))
         (AttentionUnavailable snapshot invalid-setting)))))

; Re-read agent-edited/repaired state without restarting. Never delete a file.
(= (attention-reload)
   (let* (($_ (change-state! &am-state Unopened)) ($_ (am:begin-turn)))
     (attention-policy)))

(= (am:uniform-seeds $rows $dest $count)
   (if (== $rows ()) True
     (let (AttentionMass $key $value) (car-atom $rows)
       (let $_ (am:add $dest $key (/ 1 $count))
         (am:uniform-seeds (cdr-atom $rows) $dest $count)))))
