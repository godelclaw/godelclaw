; Native client for the atomic working-state/input/request checkpoint.
; One occurrence ID is allocated before transport; reconnects replay that ID.
; Equal payloads at different checkpoints still receive different IDs.
!(import! &self ./src/ledger_client.metta)
!(import! &self ./src/effect_receipt_values_cetta.metta)

(= (checkpoint:socket) (system:getenv-or-default "METTACLAW_INPUT_LEDGER_SOCKET" ""))
(= (checkpoint:failure $verb $detail)
   (ErFailure LedgerUnavailable (str:concat "native checkpoint ledger: " $verb) $detail))
(= (checkpoint:call $verb $arguments)
   (let $socket (checkpoint:socket)
     (if (== $socket "") (checkpoint:failure $verb missing-socket)
       (if (> (str:byte-length $socket) 107) (checkpoint:failure $verb socket-path-too-long)
         (case (collapse (catch (ledger-client:call $socket $verb $arguments)))
           ((($answer)
             (case $answer
               (((Error $where $why) (checkpoint:failure $verb $answer))
                ($value $value))))
            ($other (checkpoint:failure $verb (invalid-answer $other)))))))))
(= (checkpoint:read)
   (case (checkpoint:call "working-set" ())
     ((none (0))
      ((ErFailure $class $message $detail) (ErFailure $class $message $detail))
      ($text (if (== (get-type $text) String) (1 $text)
               (checkpoint:failure "working-set" (invalid-text $text)))))))
(= (checkpoint:ids $ids)
   (if (== $ids ()) ()
     (let* (($id (erv:str (car-atom $ids))) ($rest (checkpoint:ids (cdr-atom $ids))))
       (if (== $id "") $rest (cons-atom $id $rest)))))
(= (checkpoint:write-with-id $text $ids $request $now $occurrence)
   (case (checkpoint:call "checkpoint" ($text (checkpoint:ids $ids) $request $now $occurrence))
     ((True True) (true True)
      ((ErFailure $class $message $detail) (ErFailure $class $message $detail))
      ($other (checkpoint:failure "checkpoint" (invalid-commit $other))))))
(= (checkpoint:write $text $ids $request $now)
   (let $occurrence (str:concat "ck1." (system:uuid4-hex))
     (checkpoint:write-with-id $text $ids $request $now $occurrence)))
