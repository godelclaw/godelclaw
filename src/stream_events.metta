; Native provider-to-display projection. Only typed readable text is emitted.
; Provider argument/signature bytes never cross this projection.
!(import! &self json)
!(import! &self str)
!(import! &self ./src/stream_lifecycle.metta)

(= (stream:get $value $key) (json-object-get $value $key))
(= (stream:text $value)
   (case $value (((JsonString $text) $text) ($other ""))))
(= (stream:field $value $key) (stream:text (stream:get $value $key)))
(= (stream:event $kind $item $part $channel $text)
   (JsonObject ((JsonPair "kind" (JsonString $kind))
     (JsonPair "item" (JsonString $item)) (JsonPair "part" $part)
     (JsonPair "channel" (JsonString $channel)) (JsonPair "text" (JsonString $text))
     (JsonPair "lifecycle" (JsonString (repr (display:step Forming ProviderText)))))))
(= (stream:tool $item $name)
   (JsonObject ((JsonPair "kind" (JsonString "tool.forming"))
     (JsonPair "item" (JsonString $item)) (JsonPair "name" (JsonString $name)))))
(= (stream:response $value)
   (let* (($type (stream:field $value "type")) ($id (stream:field $value "item_id"))
          ($index (stream:get $value "content_index")) ($summary (stream:get $value "summary_index")))
     (if (== $type "response.output_text.delta")
       ((stream:event "text.delta" $id $index "commentary" (stream:field $value "delta")))
       (if (== $type "response.reasoning_summary_text.delta")
         ((stream:event "text.delta" $id $summary "reasoning-summary" (stream:field $value "delta")))
         (if (== $type "response.output_text.done")
           ((stream:event "text.snapshot" $id $index "commentary" (stream:field $value "text")))
           (if (== $type "response.reasoning_summary_text.done")
             ((stream:event "text.snapshot" $id $summary "reasoning-summary" (stream:field $value "text")))
             (if (== $type "response.output_item.added")
               (let $item (stream:get $value "item")
                 (if (== (stream:field $item "type") "function_call")
                   ((stream:tool (stream:field $item "id") (stream:field $item "name"))) ()))
               ())))))))
(= (stream:anthropic $value)
   (let* (($type (stream:field $value "type")) ($index (stream:get $value "index"))
          ($id (json-stringify $index)) ($delta (stream:get $value "delta"))
          ($kind (stream:field $delta "type")))
     (if (== $type "content_block_delta")
       (if (== $kind "text_delta")
         ((stream:event "text.delta" $id $index "commentary" (stream:field $delta "text")))
         (if (== $kind "thinking_delta")
           ((stream:event "text.delta" $id $index "reasoning-summary" (stream:field $delta "thinking"))) ()))
       (if (== $type "content_block_start")
         (let* (($block (stream:get $value "content_block")) ($block-kind (stream:field $block "type")))
           (if (== $block-kind "tool_use") ((stream:tool $id (stream:field $block "name")))
             (if (== $block-kind "text")
               ((stream:event "text.delta" $id $index "commentary" (stream:field $block "text")))
               (if (== $block-kind "thinking")
                 ((stream:event "text.delta" $id $index "reasoning-summary" (stream:field $block "thinking"))) ()))))
         ()))))
(= (stream:chat-tools $calls $out)
   (if (== $calls ()) (sse:reverse $out ())
     (let* (($call (car-atom $calls)) ($function (stream:get $call "function"))
            ($id (json-stringify (stream:get $call "index"))))
       (stream:chat-tools (cdr-atom $calls)
         (cons-atom (stream:tool $id (stream:field $function "name")) $out)))))
(= (stream:chat-choice $choice)
   (let* (($delta (stream:get $choice "delta")) ($text (stream:field $delta "content"))
          ($index (stream:get $choice "index")) ($id (json-stringify $index))
          ($calls (stream:get $delta "tool_calls")))
     (let $tools (case $calls (((JsonArray $items) (stream:chat-tools $items ())) ($other ())))
       (if (== $text "") $tools
         (cons-atom (stream:event "text.delta" $id $index "commentary" $text) $tools)))))
(= (stream:chat $value)
   (case (stream:get $value "choices")
     (((JsonArray ($choice)) (stream:chat-choice $choice)) ($other ()))))
(= (stream:project $protocol $value)
   (if (== $protocol "responses") (stream:response $value)
     (if (== $protocol "anthropic") (stream:anthropic $value)
       (if (== $protocol "chat-completions") (stream:chat $value) ()))))
