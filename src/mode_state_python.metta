; Retained SWI route; never selected as a native failure recovery path.
!(import! &self ./src/loop_modes.py)
!(import! &self ./src/lifecycle.py)
!(import! &self ./src/attention.py)
(= (mode-python:process) (py-call (loop_modes.process_mode)))
(= (mode-python:view) (py-call (loop_modes.mode_view)))
(= (mode-python:list-view) (py-call (loop_modes.modes_view)))
(= (mode-python:set $name) (py-call (loop_modes.set_mode $name)))
(= (mode-python:wait $value) (py-call (loop_modes.wait_timed_out $value)))
(= (lifecycle-python:enabled) (py-call (lifecycle.cognition_enabled)))
(= (lifecycle-python:view) (py-call (lifecycle.view)))
(= (lifecycle-python:start) (py-call (lifecycle.start)))
(= (lifecycle-python:stop) (py-call (lifecycle.stop)))
(= (attention-python:description) (py-call (attention.description)))
