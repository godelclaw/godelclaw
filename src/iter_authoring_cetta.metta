; Transformation authoring changes the next capture, never an in-flight view.
!(import! &self ./state_file_cetta.metta)
!(import! &self ./diagnostic_cetta.metta)
!(import! &self (library list))
(= (author:directory)
   (system:getenv-or-default "METTACLAW_ITER_PROCESS_DIR" "memory/transformations"))
(= (author:valid? $name)
   (and (!= $name "") (and (str:ends-with $name ".metta")
     (and (not (str:starts-with $name "_")) (and (== (sf:basename $name) $name)
       (not (erv:contains (tuple:from (str:python-codepoints $name)) 0)))))))
(= (author:error $operation $name $detail)
   (JsonObject ((JsonPair "schema" 1) (JsonPair "operation" $operation) (JsonPair "name" $name)
                (JsonPair "state" "error") (JsonPair "error" (diagnostic:text $detail 600)))))
(= (author:failure? $value)
   (case $value (((fs:failed $_ $_ $_ $_ $_ $_) True) ((Error $_ $_) True)
                ((AuthorFailedV1 $_) True) ((SfLockFailed $_) True) ((SfNoAnswer) True) ($other False))))
(= (author:regular $path)
   (case (fs:metadata $path no-follow-observed)
     (((fs:info-v2 regular $_ $_ $_ $_ (fs:permissions $permissions) $_) $permissions)
      ((fs:failed fs:missing $_ $_ $_ $_ $_) none)
      ($bad (AuthorFailedV1 (metadata $bad))))))
(= (author:hash $path)
   (case (fs:sha256-file $path)
     (((fs:hashed-v1 $digest $_) $digest) ($bad (AuthorFailedV1 $bad)))))
(= (author:rows $directory $names $disabled)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($rest (author:rows $directory (cdr-atom $names) $disabled))
            ($selected (and (str:ends-with $name ".metta") (== (str:starts-with $name "_") $disabled))))
       (if (not $selected) $rest
         (let* (($path (path:join $directory $name)) ($kind (author:regular $path)) ($hash (author:hash $path)))
           (if (or (author:failure? $kind) (or (== $kind none) (author:failure? $hash)))
             (AuthorFailedV1 "transformation could not be captured")
             (if (author:failure? $rest) $rest
               (cons-atom (JsonObject ((JsonPair "name" $name) (JsonPair "sha256" $hash))) $rest))))))))
(= (author:snapshot $directory)
   (let $names (if (fs:exists $directory) (sort-atom (fs:entries $directory)) ())
     (let $rows (author:rows $directory $names False)
       (if (author:failure? $rows) $rows (AuthorSnapshotV1 $rows (author:revision $rows))))))
(= (author:revision $rows)
   (str:sha256 (str:join "" (map-atom $rows $row
     (str:join "" ((sf:get $row "name" "") "\u0000" (sf:get $row "sha256" "") "\u0000"))))))
(= (author:syntax $source)
   (case (catch (parse (str:join "" ("(\n" $source "\n)"))))
     (((Error $_ $why) ("fail" (diagnostic:text $why 500))) ($ok ("pass" "")))))
(= (author:list)
   (let* (($directory (author:directory)) ($snapshot (author:snapshot $directory)))
     (case $snapshot
       (((AuthorSnapshotV1 $active $revision)
         (let $disabled (author:rows $directory (if (fs:exists $directory) (sort-atom (fs:entries $directory)) ()) True)
           (if (author:failure? $disabled) (turn:json (author:error "list" "" $disabled))
             (turn:json (JsonObject ((JsonPair "schema" 1) (JsonPair "state" "observed")
               (JsonPair "revision" $revision) (JsonPair "active" (JsonArray $active)) (JsonPair "disabled" (JsonArray $disabled))))))))
        ($bad (turn:json (author:error "list" "" $bad)))))))
(= (author:run $operation $name $source)
   (let* (($text (erv:str $name)) ($directory (author:directory)) ($_ (fs:make-directories $directory 504)))
     (if (not (author:valid? $text)) (turn:json (author:error $operation $text "name must be one active .metta entry"))
       (let $result (sf:locked (path:join $directory ".author.lock") 432
                        (quote (author:locked $directory $operation $text $source)))
         (turn:json (if (author:failure? $result) (author:error $operation $text $result) $result))))))
(= (author:locked $directory $operation $name $source)
   (case (author:snapshot $directory)
     (((AuthorSnapshotV1 $_ $before)
       (if (== $operation "write") (author:write $directory $name (erv:str $source) $before)
         (author:move $directory $name (== $operation "enable") $before)))
      ($bad $bad))))
(= (author:receipt $operation $name $active $digest $before $after $sync)
   (JsonObject ((JsonPair "schema" 1) (JsonPair "operation" $operation) (JsonPair "name" $name)
     (JsonPair "state" (if (== $operation "write") "installed" (if $active "enabled" "disabled")))
     (JsonPair "active" $active) (JsonPair "activation" "next-request-capture")
     (JsonPair "sha256" $digest) (JsonPair "before_revision" $before) (JsonPair "activation_revision" $after)
     (JsonPair "directory_sync" (if (== $sync True) "pass" "unconfirmed"))
     (JsonPair "directory_sync_error" (if (== $sync True) "" (diagnostic:text $sync 300))))))
(= (author:write $directory $name $source $before)
   (let* (($path (path:join $directory $name)) ($prior-mode (author:regular $path)))
     (if (author:failure? $prior-mode) $prior-mode
       (let* (($prior (if (== $prior-mode none) JsonNull (author:hash $path)))
              (($syntax $syntax-error) (author:syntax $source))
              ($written (sf:replace $path $source (if (== $prior-mode none) 432 $prior-mode) True)))
         (if (or (author:failure? $prior) (author:failure? $written)) (AuthorFailedV1 "write did not complete")
           (let* (($actual (author:hash $path)) ($after (author:snapshot $directory)))
             (if (!= $actual (str:sha256 $source)) (AuthorFailedV1 "installed bytes changed before receipt")
               (case $after
                 (((AuthorSnapshotV1 $_ $revision)
                   (sf:put-all (author:receipt "write" $name True $actual $before $revision $written)
                     ((JsonPair "prior_sha256" $prior) (JsonPair "syntax" $syntax) (JsonPair "syntax_error" $syntax-error))))
                  ($bad $bad))))))))))
(= (author:move $directory $name $enable $before)
   (let* (($source (path:join $directory (if $enable (str:concat "_" $name) $name)))
          ($target (path:join $directory (if $enable $name (str:concat "_" $name))))
          ($mode (author:regular $source)) ($destination (fs:metadata $target no-follow-observed)))
     (if (or (== $mode none) (author:failure? $mode)) (AuthorFailedV1 "source transformation is unavailable")
       (case $destination
         (((fs:failed fs:missing $_ $_ $_ $_ $_)
           (let* (($digest (author:hash $source)) ($renamed (fs:rename $source $target)))
             (if (or (author:failure? $digest) (author:failure? $renamed)) (AuthorFailedV1 "rename did not complete")
               (let $synced (sf:sync-directory $directory)
                 (case (author:snapshot $directory)
                   (((AuthorSnapshotV1 $_ $after)
                     (author:receipt (if $enable "enable" "disable") $name $enable $digest $before $after $synced))
                    ($bad $bad)))))))
          ($exists (AuthorFailedV1 "destination exists or is unavailable")))))))
