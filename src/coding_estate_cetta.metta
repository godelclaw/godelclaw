; Native read-only coding-session policy over one explicit observation snapshot.
; The snapshot host owns no verdict, listing, count, rendering or clipping rule.
!(import! &self (library json))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self (library math))
!(import! &self ./src/coding_estate_io_cetta.metta)

(= (estate:verbs)
   "verbs: (work-status \"id\") (work-resume \"id\" [\"current\"]) (work-hold \"id\" \"why\" [\"YYYY-MM-DD\"]) (work-archive \"id\" \"why\")")
(= (estate:lookup $pairs $key $default)
   (if (== $pairs ()) $default
     (let (JsonPair $name $value) (car-atom $pairs)
       (estate:lookup (cdr-atom $pairs) $key (if (== $name $key) $value $default)))))
(= (estate:field $object $key $default)
   (case $object
     (((JsonObject $pairs) (estate:lookup $pairs $key $default))
      ($other $default))))
(= (estate:array $value)
   (case $value (((JsonArray $items) $items) ($other ()))))
(= (estate:truth $value)
   (case $value
     ((JsonNull False) (False False) ("" False) (0 False) (0.0 False)
      ((JsonArray ()) False) ((JsonObject ()) False) ($other True))))
(= (estate:text $value)
   (case $value
     ((JsonNull "None") (True "True") (False "False")
      ($other (if (== (get-type $other) String) $other (repr $other))))))
(= (estate:text-or $value $default)
   (if (estate:truth $value) (estate:text $value) $default))
(= (estate:member $item $items)
   (if (== $items ()) False
     (or (== $item (car-atom $items)) (estate:member $item (cdr-atom $items)))))
(= (estate:runtime $session) (estate:field $session "runtime" (JsonObject ())))
(= (estate:state $session) (estate:field $session "state" (JsonObject ())))
(= (estate:lifecycle $session) (estate:field $session "lifecycle" (JsonObject ())))
(= (estate:phase $session) (estate:field (estate:runtime $session) "phase" JsonNull))
(= (estate:launching? $session) (== (estate:phase $session) "reserved"))
(= (estate:archived? $session)
   (case (estate:field (estate:lifecycle $session) "archive" JsonNull)
     (((JsonObject $pairs) True) ($other False))))
(= (estate:held? $session)
   (case (estate:field (estate:lifecycle $session) "hold" JsonNull)
     (((JsonObject $pairs) True) ($other False))))
(= (estate:raw-status $session)
   (estate:text-or (estate:field (estate:state $session) "status" JsonNull) "unknown"))
(= (estate:status $session)
   (if (estate:launching? $session) "launching" (estate:raw-status $session)))
(= (estate:display-status $session)
   (if (and (estate:archived? $session) (not (estate:launching? $session))) "archived"
     (if (and (estate:held? $session) (not (estate:launching? $session))) "held"
       (estate:status $session))))
(= (estate:open? $session)
   (or (estate:launching? $session)
       (and (not (== (estate:raw-status $session) "done")) (not (estate:archived? $session)))))

; The ordered classifier is the native owner of CodingSessionLifecycle.classify.
(= (estate:string-value $value)
   (if (== (get-type $value) String) $value ""))
(= (estate:recorded-hash $session)
   (estate:string-value (estate:field (estate:runtime $session) "binary_sha256" JsonNull)))
(= (estate:current-hash $session)
   (estate:string-value (estate:field $session "engine_hash" JsonNull)))
(= (estate:matched? $session)
   (estate:member "llm-ledger-sqlite" (estate:array (estate:field $session "matched" (JsonArray ())))))
(= (estate:selection $snapshot $session)
   (estate:field (estate:field $snapshot "selection" (JsonObject ()))
                 "llm-ledger-sqlite" JsonNull))
(= (estate:retired? $snapshot $session)
   (and (estate:matched? $session) (== (estate:selection $snapshot $session) "native")))
(= (estate:unknown-outcome $snapshot $session)
   (if (estate:matched? $session)
     (case (estate:selection $snapshot $session)
       (((JsonArray ("unknown" $outcome)) $outcome) ($other ""))) ""))
(= (estate:unavailable-reason $outcome)
   (str:concat "the LLM ledger's backend selection is unavailable (" (str:concat $outcome ")")))
(= (estate:classify $snapshot $session)
   (if (== (estate:field $session "runtime_exists" False) False)
     (EstateVerdict "unpinned" "a resume pins the current runtime")
     (if (== (estate:field $session "root_exists" False) False)
       (EstateVerdict "needs-current" "its frozen runtime is gone")
       (if (estate:retired? $snapshot $session)
         (EstateVerdict "needs-current" "it uses the retired SQLite LLM ledger")
         (let* (($current (estate:current-hash $session))
                ($recorded (estate:recorded-hash $session))
                ($unknown (estate:unknown-outcome $snapshot $session)))
           (if (== $current "")
             (EstateVerdict "needs-current" "its engine binary is gone")
             (if (and (not (== $recorded "")) (not (== $current $recorded)))
               (EstateVerdict "needs-current" "its engine binary has changed")
               (if (not (estate:member (estate:phase $session) ("reserved" "started" "ended")))
                 (EstateVerdict "needs-current" "its runtime predates run tokens")
                 (if (== $recorded "")
                   (if (== $unknown "")
                     (EstateVerdict "unverified" "engine not recorded")
                     (EstateVerdict "unverified" (estate:unavailable-reason $unknown)))
                   (if (== $unknown "") (EstateVerdict "resumable" "")
                     (EstateVerdict "unverified" (estate:unavailable-reason $unknown))))))))))))

(= (estate:listed $snapshot $session)
   (if (estate:launching? $session) True
     (let $status (estate:raw-status $session)
       (if (== $status "running") True
         (if (== $status "done") False
           (if (estate:archived? $session) False
             (let $hold (estate:field (estate:lifecycle $session) "hold" JsonNull)
               (case $hold
                 (((JsonObject $pairs)
                   (let $review (estate:field $hold "review" JsonNull)
                     (if (estate:truth $review)
                       (<= (str:compare (estate:text $review) (estate:field $snapshot "today" "")) 0) False)))
                  ($other True))))))))))

(= (estate:pin-date $session) (estate:field $session "pin_date" ""))
(= (estate:repin-part $session)
   (let $runs (estate:field $session "runs_count" 0)
     (if (== $runs 0) ""
       (str:join "" (" · run " (repr (+ $runs 1)) " · re-pinned "
                     (estate:field $session "repin_date" (estate:pin-date $session)))))))
(= (estate:digest $session)
   (let* (($runtime (estate:runtime $session))
          ($given (estate:field $runtime "digest" JsonNull))
          ($chosen (if (estate:truth $given) $given (estate:field $session "root_name" "")))
          ($text (estate:text $chosen)))
     (str:char-slice $text 0 (min 8 (str:char-length $text)))))
(= (estate:verdict-text $verdict $reason)
   (if (== $reason "") $verdict (str:join "" ($verdict ": " $reason))))
(= (estate:pin-part $snapshot $session $verdict $reason)
   (if (== (estate:field $session "runtime_exists" False) False)
     (str:concat "unpinned: " $reason)
     (str:join "" ("pin " (estate:digest $session) " " (estate:pin-date $session)
                   (estate:repin-part $session) " · " (estate:verdict-text $verdict $reason)))))
(= (estate:label-part $session)
   (let $lifecycle (estate:lifecycle $session)
     (case (estate:field $lifecycle "hold" JsonNull)
       (((JsonObject $pairs)
         (let* (($hold (estate:field $lifecycle "hold" (JsonObject ())))
                ($reason (estate:text-or (estate:field $hold "why" "") ""))
                ($review (estate:field $hold "review" JsonNull)))
           (if (estate:truth $review)
             (str:join "" (" · held until " (estate:text $review) ": " $reason))
             (str:concat " · held: " $reason))))
        ($other
         (case (estate:field $lifecycle "archive" JsonNull)
           (((JsonObject $pairs)
             (str:concat " · archived: "
               (estate:text-or (estate:field (estate:field $lifecycle "archive" (JsonObject ())) "why" "") "")))
            ($other ""))))))))
(= (estate:session-line $snapshot $session $verdict $reason)
   (let* (($pin (estate:pin-part $snapshot $session $verdict $reason))
          ($label (estate:label-part $session)))
     (if (estate:launching? $session)
       (str:join "" ((estate:field $session "id" "") " launching since "
                     (estate:field $session "launching_date" "") " · " $pin $label))
       (str:join "" ((estate:field $session "id" "") " " (estate:raw-status $session) " "
                     (estate:field $session "status_date" "") " · " $pin $label)))))

(= (estate:item $snapshot $session)
   (let (EstateVerdict $verdict $reason) (estate:classify $snapshot $session)
     (EstateItem $session $verdict $reason (estate:display-status $session))))
(= (estate:items $snapshot $sessions)
   (if (== $sessions ()) ()
     (cons-atom (estate:item $snapshot (car-atom $sessions))
                (estate:items $snapshot (cdr-atom $sessions)))))
(= (estate:status-count $items $wanted)
   (if (== $items ()) 0
     (let* (((EstateItem $session $verdict $reason $status) (car-atom $items))
            ($rest (estate:status-count (cdr-atom $items) $wanted)))
       (+ $rest (if (== $status $wanted) 1 0)))))
(= (estate:verdict-count $items $wanted)
   (if (== $items ()) 0
     (let* (((EstateItem $session $verdict $reason $status) (car-atom $items))
            ($rest (estate:verdict-count (cdr-atom $items) $wanted)))
       (+ $rest (if (== $verdict $wanted) 1 0)))))
(= (estate:status-parts $items $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($count (estate:status-count $items $name))
            ($rest (estate:status-parts $items (cdr-atom $names))))
       (if (> $count 0) (cons-atom (str:join "" ((repr $count) " " $name)) $rest) $rest))))
(= (estate:verdict-parts $items $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($count (estate:verdict-count $items $name))
            ($rest (estate:verdict-parts $items (cdr-atom $names))))
       (if (> $count 0) (cons-atom (str:join "" ($name " " (repr $count))) $rest) $rest))))

(= (estate:add-unique $item $items)
   (if (estate:member $item $items) $items (cons-atom $item $items)))
(= (estate:session-open-ids $session $ids)
   (if (and (estate:open? $session) (estate:field $session "runtime_exists" False))
     (let* (($digest (estate:field (estate:runtime $session) "digest" JsonNull))
            ($with-digest (if (and (== (get-type $digest) String) (not (== $digest "")))
                            (estate:add-unique $digest $ids) $ids))
            ($root (estate:field (estate:runtime $session) "root" JsonNull)))
       (if (and (== (get-type $root) String) (not (== $root "")))
         (estate:add-unique (estate:field $session "root_name" "") $with-digest) $with-digest)) $ids))
(= (estate:open-ids $items)
   (if (== $items ()) ()
     (let (EstateItem $session $verdict $reason $status) (car-atom $items)
       (estate:session-open-ids $session (estate:open-ids (cdr-atom $items))))))
(= (estate:blocks $runtimes)
   (if (== $runtimes ()) 0
     (+ (estate:field (car-atom $runtimes) "blocks" 0) (estate:blocks (cdr-atom $runtimes)))))
(= (estate:unused-count $runtimes $open)
   (if (== $runtimes ()) 0
     (+ (if (estate:member (estate:field (car-atom $runtimes) "id" "") $open) 0 1)
        (estate:unused-count (cdr-atom $runtimes) $open))))
(= (estate:even? $number) (== (% $number 2) 0))
(= (estate:rounded-mb $blocks)
   (let* (($quotient (math:floor (/ $blocks 2048))) ($remainder (- $blocks (* $quotient 2048))))
     (if (< $remainder 1024) $quotient
       (if (> $remainder 1024) (+ $quotient 1)
         (if (estate:even? $quotient) $quotient (+ $quotient 1))))))
(= (estate:runtime-part $snapshot $items)
   (let* (($runtimes (estate:array (estate:field $snapshot "runtimes" (JsonArray ()))))
          ($open (estate:open-ids $items)) ($count (size-atom $runtimes))
          ($mb (estate:rounded-mb (estate:blocks $runtimes)))
          ($unused (estate:unused-count $runtimes $open)))
     (str:join "" ("runtimes " (repr $count) " (" (repr $mb) " MB; "
                    (repr $unused) " used by no open session)"))))
(= (estate:summary $snapshot $items)
   (let* (($sessions (estate:array (estate:field $snapshot "sessions" (JsonArray ()))))
          ($status (estate:status-parts $items
             ("done" "failed" "stopped" "interrupted" "running" "launching" "unknown" "held" "archived")))
          ($verdicts (estate:verdict-parts $items
             ("needs-current" "unverified" "resumable" "unpinned")))
          ($parts (str:join " · " (estate:append (estate:append $status $verdicts)
             ((estate:runtime-part $snapshot $items))))))
     (str:join "" ("CODING_SESSIONS " (repr (size-atom $sessions)) ": " $parts))))
(= (estate:append $left $right)
   (if (== $left ()) $right (cons-atom (car-atom $left) (estate:append (cdr-atom $left) $right))))
(= (estate:session-lines $snapshot $items)
   (if (== $items ()) ()
     (let* (((EstateItem $session $verdict $reason $status) (car-atom $items))
            ($rest (estate:session-lines $snapshot (cdr-atom $items))))
       (if (estate:listed $snapshot $session)
         (cons-atom (estate:session-line $snapshot $session $verdict $reason) $rest) $rest))))
(= (estate:take $items $count)
   (if (or (== $count 0) (== $items ()) ) ()
     (cons-atom (car-atom $items) (estate:take (cdr-atom $items) (- $count 1)))))
(= (estate:bounded $summary $lines $kept)
   (if (< $kept 0) (str:join "" ($summary "\n" (estate:verbs)))
     (let* (($omitted (- (size-atom $lines) $kept))
            ($more (str:join "" ("… " (repr $omitted) " more: (work-status)")))
            ($candidate (str:join "\n" (estate:append ($summary)
              (estate:append (estate:take $lines $kept) ($more (estate:verbs)))))))
       (if (<= (str:char-length $candidate) 2000) $candidate
         (estate:bounded $summary $lines (- $kept 1))))))
(= (estate:render-open $summary $lines)
   (let $full (str:join "\n" (estate:append ($summary) (estate:append $lines ((estate:verbs)))))
     (if (<= (str:char-length $full) 2000) $full
       (estate:bounded $summary $lines (- (size-atom $lines) 1)))))
(= (estate:render $snapshot)
   (let* (($items (estate:items $snapshot (estate:array (estate:field $snapshot "sessions" (JsonArray ())))))
          ($summary (estate:summary $snapshot $items))
          ($short (str:concat $summary (str:concat "\n" (estate:verbs))))
          ($mode-value (estate:field $snapshot "mode" "open"))
          ($mode (if (estate:member $mode-value ("open" "summary" "off")) $mode-value "open")))
     (if (== $mode "summary") $short
       (let $lines (estate:session-lines $snapshot $items)
         (if (== $lines ()) $short (estate:render-open $summary $lines))))))
(= (estate:context-view $snapshot)
   (let* (($mode-value (estate:field $snapshot "mode" "open"))
          ($mode (if (estate:member $mode-value ("open" "summary" "off")) $mode-value "open")))
     (if (or (== $mode "off") (== (estate:field $snapshot "available" False) False))
       EstateMissing (estate:render $snapshot))))
(= (estate:snapshot $root $today)
   (eio:snapshot $root $today))
(= (estate:context-view-root $root $today)
   (estate:context-view (estate:snapshot $root $today)))
(= (estate:load-answers $answers)
   (case $answers
     (((EstateMissing) ("missing"))
      (($text) (if (== (get-type $text) String) ("value" $text) ("unavailable")))
      ($other ("unavailable")))))
(= (estate:load)
   (estate:load-answers (collapse (catch (estate:context-view-root (system:cwd) "")))))

;; ------------------------------------------ work-status and resume on a pin
; The agent's verbs observe sessions as the context view does: a snapshot of
; the sessions and the one ledger-selection fact their verdicts need, taken
; once per verb, with no runtime disk accounting.

(= (estate:today) (system:format-time "%Y-%m-%d" (system:wall-time) "local"))
(= (estate:selection-of $sessions)
   (if (eio:any-matched? $sessions)
     (JsonObject ((JsonPair "llm-ledger-sqlite" (eio:llm-ledger-selection)))) (JsonObject ())))
(= (estate:facts $sessions)
   (JsonObject ((JsonPair "today" (estate:today)) (JsonPair "selection" (estate:selection-of $sessions)))))
; Every session under base/memory/coding: (EstateSessions facts sessions).
(= (estate:sessions-view $base)
   (let* (($_ (change-state! &eio-world-cache ()))
          ($coding-dir (eio:child $base "memory/coding"))
          (($available $ids) (eio:coding-subdirs $coding-dir))
          ($sessions (map-atom $ids $sid (eio:session $coding-dir $sid))))
     (EstateSessions (estate:facts $sessions) $sessions)))
; One session observed alone: (EstateView facts session).
(= (estate:session-view $base $id)
   (let* (($_ (change-state! &eio-world-cache ()))
          ($session (eio:session (eio:child $base "memory/coding") $id)))
     (EstateView (estate:facts ($session)) $session)))

; The status a session line shows: launching (a reservation whose scope is not
; active), else the recorded status.
(= (estate:effective-status $session $scope-active)
   (if (and (estate:launching? $session) (not $scope-active))
     (str:concat "launching since " (estate:field $session "launching_date" ""))
     (estate:text-or (estate:field (estate:state $session) "status" JsonNull) "")))
; The rest of a (work-status) line: the pin (just "unpinned" without one) and
; any hold or archive label.
(= (estate:status-suffix $facts $session)
   (let (EstateVerdict $verdict $reason) (estate:classify $facts $session)
     (str:join "" (" · " (if (== (estate:field $session "runtime_exists" False) False) "unpinned"
                            (estate:pin-part $facts $session $verdict $reason))
                   (estate:label-part $session)))))
; (work-status "id") details: the pin's bundle and engine, and the lifecycle record.
(= (estate:status-detail $facts $session)
   (let (EstateVerdict $verdict $reason) (estate:classify $facts $session)
     (str:join "" ("\n" (estate:pin-line $session $verdict $reason) "\n" (estate:lifecycle-line $session)))))
(= (estate:pin-line $session $verdict $reason)
   (if (== (estate:field $session "runtime_exists" False) False) (str:join "" ("pin: unpinned (" $reason ")"))
     (let* (($runtime (estate:runtime $session))
            ($digest (estate:text-or (estate:field $runtime "digest" JsonNull)
                                     (estate:text-or (estate:field $session "root_name" "") "unknown")))
            ($binary (estate:string-value (estate:field $runtime "binary" JsonNull)))
            ($engine (if (== $binary "") "unknown" (eio:basename $binary)))
            ($recorded (estate:text-or (estate:field $runtime "binary_sha256" JsonNull) "unrecorded"))
            ($hash (estate:current-hash $session))
            ($current (if (== $hash "") "missing" $hash)))
       (str:join "" ("pin: bundle " $digest " · engine " $engine " (recorded " $recorded ", current " $current ")"
                     (estate:repin-part $session) " · " (estate:verdict-text $verdict $reason))))))
; The record as json.dumps(record, sort_keys=True) writes it.
(= (estate:lifecycle-json $lifecycle) (json:stringify-python-with $lifecycle ((sort-keys True))))
(= (estate:lifecycle-line $session)
   (let $lifecycle (estate:lifecycle $session)
     (case (estate:field $lifecycle "hold" JsonNull)
       (((JsonObject $pairs)
         (let* (($hold (estate:field $lifecycle "hold" (JsonObject ())))
                ($review (estate:field $hold "review" JsonNull))
                ($why (estate:text-or (estate:field $hold "why" "") "")))
           (str:join "" ("lifecycle: " (if (estate:truth $review) (str:join "" ("hold until " (estate:text $review) ": " $why))
                                           (str:concat "hold: " $why))
                         " (" (estate:lifecycle-json $lifecycle) ")"))))
        ($other
         (case (estate:field $lifecycle "archive" JsonNull)
           (((JsonObject $pairs)
             (str:join "" ("lifecycle: archive: "
                           (estate:text-or (estate:field (estate:field $lifecycle "archive" (JsonObject ())) "why" "") "")
                           " (" (estate:lifecycle-json $lifecycle) ")")))
            ($none "lifecycle: none"))))))))
; Why a session cannot resume on its pin, or "". An unknown backend selection
; refuses retryably.
(= (estate:resume-problem $facts $session)
   (let (EstateVerdict $verdict $reason) (estate:classify $facts $session)
     (if (== $verdict "needs-current") $reason
       (if (and (== $verdict "unverified") (str:starts-with $reason "the LLM ledger's backend selection is unavailable ("))
         (str:concat $reason "; its pin cannot be checked now. Try again later.") ""))))
