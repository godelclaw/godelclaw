; Immutable provider configuration and boundary observers. No foreign plan.
!(import! &self ./state_ledger.metta)
!(import! &self ./turn_frame_cetta.metta)
!(import! &self ./turn_health_cetta.metta)
!(import! &self ./progress_receipt_cetta.metta)
!(import! &self ./boot_state_cetta.metta)
!(import! &self ./context_budget_cetta.metta)
!(import! &self ./commentary_contract_cetta.metta)
!(import! &self ./provider_rejection_cetta.metta)
!(import! &self (library io))
!(import! &self (library math))
!(import! &self ./line_rpc_cetta.metta)
!(bind! &provider-session-epoch (new-state ""))
!(let $epoch (system:uuid4-hex) (change-state! &provider-session-epoch $epoch))
!(bind! &provider-gate-progress (new-state 0))

(: host-native:field (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(: host-native:milliseconds (-> %Undefined% %Undefined% Bool %Undefined%))
(: host-native:bounded-number? (-> %Undefined% %Undefined% %Undefined% Bool))
(: host-native:route (-> %Undefined% %Undefined%))
(: host-native:rstrip-slash (-> %Undefined% %Undefined%))
(: host-native:visible (-> %Undefined% Bool))
(: host-native:credential-alias (-> %Undefined% %Undefined%))
(: host-native:purpose? (-> %Undefined% %Undefined% Bool))
(: host-native:refused-seed (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: host-native:base-facts (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: host-native:native-call-seed (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: host-native:subscription-seed (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))

(= (host-native:field (HostCallV1 $facts) $key $default)
   (case (sf:get $facts $key $default)
     (((JsonString $text) $text) ((JsonNumber $text) (str:string->number $text))
      ((JsonBool $flag) $flag) ($value $value))))
(= (host-native:scope)
   (let $configured (system:getenv-or-default "METTACLAW_ACTIVITY_CALL_SCOPE" "")
     (if (or (not (== $configured "")) (not (strategy:enabled?))) $configured
       (let $identity (system:getenv-or-default "METTACLAW_STRATEGY_PATH"
                         (system:getenv-or-default "METTACLAW_ENGINE_STATE_PATH" ""))
         (str:concat "agent-" (str:char-slice (str:sha256 $identity) 0 24))))))
(= (host-native:lane)
   (system:getenv-or-default "METTACLAW_ACTIVITY_CALL_LANE" (if (== (host-native:scope) "") "" "interactive")))
(= (host-native:milliseconds $name $default $zero)
   (let* (($number (lp:python-float (system:getenv-or-default $name
                    (if (== (get-type $default) String) $default (repr $default)))))
          ($minimum (if $zero 0 0.001)))
     (if (host-native:bounded-number? $number $minimum 2147483)
       (math:floor (* 1000 $number)) (Error host-native:settings invalid-model-wait))))
(= (host-native:bounded-number? $number $minimum $maximum)
   (if (not (== (get-type $number) Number)) False
     (if (erv:contains (NumberNaN NumberInf) (lp:number-kind $number)) False
       (and (>= $number $minimum) (<= $number $maximum)))))
(= (host-native:wait-settings)
   (let* (($soft (host-native:milliseconds "METTACLAW_LLM_SOFT_SECONDS"
                      (system:getenv-or-default "SYNTHETIC_TIMEOUT" "300") False))
          ($hard (host-native:milliseconds "METTACLAW_LLM_HARD_SECONDS" 1800 False))
          ($connect (host-native:milliseconds "METTACLAW_LLM_CONNECT_SECONDS" 30 False))
          ($first (host-native:milliseconds "METTACLAW_LLM_FIRST_BYTE_SECONDS" 900 False))
          ($idle (host-native:milliseconds "METTACLAW_LLM_IDLE_SECONDS" 180 False)))
     (if (or (turn:failed? $soft) (or (turn:failed? $hard)
           (or (turn:failed? $connect) (or (turn:failed? $first) (turn:failed? $idle)))))
       (Error host-native:settings invalid-model-wait)
       (if (< $hard $soft) (Error host-native:settings hard-before-soft)
         (ModelWaitV1 $soft $hard $connect $first $idle)))))
(= (host-native:route $selected)
   (if (str:starts-with $selected "kimi:")
     (ProviderRouteV1 "kimi" "responses" (str:char-slice $selected 5 (str:char-length $selected))
       "KIMI_BASE_URL" "https://api.kimi.ai/coding/v1" "KIMI_API_KEY")
     (if (str:starts-with $selected "openai:")
       (ProviderRouteV1 "openai" "responses" (str:char-slice $selected 7 (str:char-length $selected))
         "OPENAI_BASE_URL" "https://api.openai.com/v1" "OPENAI_API_KEY")
       (if (str:starts-with $selected "claude-")
         (ProviderRouteV1 "anthropic" "anthropic" $selected "ANTHROPIC_BASE_URL" "https://api.anthropic.com" "ANTHROPIC_API_KEY")
         (ProviderRouteV1 "synthetic" "chat-completions" $selected
           "SYNTHETIC_BASE_URL" "https://api.synthetic.new/openai/v1" "SYNTHETIC_API_KEY")))))
(= (host-native:rstrip-slash $text)
   (if (str:ends-with $text "/") (host-native:rstrip-slash (str:char-slice $text 0 (- (str:char-length $text) 1))) $text))
(= (host-native:visible $purpose)
   (and (not (== $purpose "compaction")) (not (== (system:getenv-or-default "METTACLAW_STREAM_DIR" "") ""))))
(= (host-native:credential-alias $provider)
   (case $provider
     (("synthetic" "LLM_SYNTHETIC") ("kimi" "LLM_KIMI")
      ("openai" "LLM_OPENAI") ("anthropic" "LLM_ANTHROPIC")
      ($bad (Error provider-config (Unsolvable unknown-credential-alias))))))
(= (host-native:origin)
   (let* (($source (turn:trigger))
          ($known (and (not (== (turn:get "turn" "") ""))
                   (erv:contains ("operator-event" "channel-event" "heartbeat-event" "autonomous-trigger" "continuation-tick" "scheduled-command") $source)))
          ($trigger (if $known $source "unspecified"))
          ($turn (if $known (turn:get "turn" "") "")))
     (JsonObject ((JsonPair "trigger" $trigger) (JsonPair "turn_id" $turn)))))
(= (host-native:purpose? $kind $purpose)
   (and (or (not (== (system:getenv-or-default "METTACLAW_CODING_CHECK" "0") "1")) (== $purpose "turn"))
     (or (and (== $kind "command") (or (== $purpose "turn") (== $purpose "compaction")))
         (and (== $kind "structured") (erv:contains ("turn" "coding" "compaction") $purpose)))))
(= (host-native:refused-seed $kind $purpose $provider $error)
   (let $facts (JsonObject
       ((JsonPair "ready" False) (JsonPair "kind" (JsonString $kind)) (JsonPair "purpose" (JsonString $purpose))
        (JsonPair "provider" (JsonString $provider)) (JsonPair "error" (JsonString $error))))
     ((HostCallV1 $facts) (turn:json $facts))))
(= (host-native:base-facts $selected $tokens $kind $purpose $provider $protocol $wire $stream $cap $epoch $correlation $waits)
   (let* (((ModelWaitV1 $soft $hard $connect $first $idle) $waits)
          ($activity (host-native:scope)) ($lane (host-native:lane))
          ($guard (if (strategy:enabled?) "sequential-tools-v1" JsonNull))
          ($origin (host-native:origin)) ($visible (host-native:visible $purpose))
          ($command-turn (and (== $kind "command") (== $purpose "turn")))
          ($commentary (and $command-turn (commentary:enabled?)))
          ($correction (if $command-turn (turn:json (rejection:context)) "")))
     (JsonObject
       ((JsonPair "ready" True) (JsonPair "kind" $kind) (JsonPair "purpose" $purpose)
        (JsonPair "provider" $provider) (JsonPair "protocol" $protocol)
        (JsonPair "selected_model" $selected) (JsonPair "wire_model" $wire)
        (JsonPair "epoch" $epoch) (JsonPair "correlation" $correlation)
        (JsonPair "stream" $stream) (JsonPair "cap" $cap) (JsonPair "maximum" $tokens)
        (JsonPair "timeout" $hard) (JsonPair "connect" $connect) (JsonPair "first" $first)
        (JsonPair "idle" $idle) (JsonPair "soft" $soft) (JsonPair "activity" $activity)
        (JsonPair "lane" $lane) (JsonPair "guard" $guard) (JsonPair "origin" $origin)
        (JsonPair "visible" $visible) (JsonPair "commentary" $commentary)
        (JsonPair "correction" $correction)))))
(= (host-native:native-call-seed $selected $tokens $kind $purpose)
   (let* (((ProviderRouteV1 $provider $protocol $wire $base-env $default $credential-env) (host-native:route $selected))
          ($waits (host-native:wait-settings)) ($valid (host-native:purpose? $kind $purpose)))
     (if (or (not $valid) (turn:failed? $waits))
       (host-native:refused-seed $kind $purpose $provider "ValueError")
       (if (not (system:env-nonempty? $credential-env))
         (host-native:refused-seed $kind $purpose $provider "RuntimeError")
         (let* (($stream (and (== $protocol "chat-completions") (== (system:getenv-or-default "METTACLAW_LLM_STREAM" "0") "1")))
                ($visible (host-native:visible $purpose))
                ($cap (lp:python-int (system:getenv-or-default "METTACLAW_LLM_RESPONSE_BYTES"
                         (if (or $stream $visible) "8388608" "1048576"))))
                ($base (host-native:rstrip-slash (system:getenv-or-default $base-env $default))))
           (if (not (host-native:bounded-number? $cap 1024 16777216))
             (host-native:refused-seed $kind $purpose $provider "ValueError")
             (let* (($facts (host-native:base-facts $selected $tokens $kind $purpose $provider $protocol $wire $stream $cap
                             (get-state &provider-session-epoch) (system:uuid4-hex) $waits))
                    ($alias (host-native:credential-alias $provider))
                    ($extra (if (== $provider "anthropic")
                       ((JsonArray ("http:header" "anthropic-version" "2023-06-01"))) ()))
                    ($base-headers ((JsonArray ("http:header" "Content-Type" "application/json"))
                                    (JsonArray ("http:credential" $alias))))
                    ($header-list (list:append $base-headers $extra))
                    ($headers (JsonArray $header-list)) ($header-text (turn:json $headers))
                    ($with-base (sf:put $facts "base" $base))
                    ($with-headers (sf:put $with-base "headers" $header-text))
                    ($tool (if (and (and (== $kind "command") (== $purpose "turn")) (commentary:enabled?))
                             (json:parse (commentary:tool-schema-text)) JsonNull))
                    ($with-tool (sf:put $with-headers "tool" $tool))
                    ($ttl (system:getenv-or-default "METTACLAW_ANTHROPIC_CACHE_TTL" "5m"))
                    ($ready (sf:put $with-tool "ttl" $ttl))
                    ($text (turn:json $ready)))
               ((HostCallV1 $ready) $text))))))))
(= (host-native:subscription-seed $selected $tokens $kind $purpose $cap)
   (let $waits (host-native:wait-settings)
     (if (or (not (host-native:purpose? $kind $purpose)) (or (turn:failed? $waits) (<= $cap 0)))
       (host-native:refused-seed $kind $purpose "openai" "ValueError")
       (let* (($id (system:uuid4-hex))
              ($facts (host-native:base-facts $selected $tokens $kind $purpose "chatgpt" "responses"
                         (str:char-slice $selected 8 (str:char-length $selected)) False $cap $id $id $waits)))
         ((HostCallV1 $facts) (turn:json $facts))))))
(= (host-native:accounting-observation-error $plan $stage)
   (let $_ (system:write stderr (str:join "" ("[native_accounting] ledger observation failed; stage=" $stage "\n"))) 0))
(= (host-native:completion-wait $plan $attempt)
   (let* (($_ (progress:phase "local-commit-wait" 60))
          ($_ (host-native:sleep-ms (min 5000 (* 100 (pow-math 2 (min 6 (max 0 $attempt)))))))) 1))
(= (host-native:decoding-wait $plan $attempt)
   (let* (($_ (progress:phase "local-decode-wait" 60))
          ($_ (host-native:sleep-ms (min 5000 (* 100 (pow-math 2 (min 6 (max 0 $attempt)))))))) 1))
(= (host-native:failure $code $preparation)
   ("failed" $code 0 False -1.0 (rejection:blocked?) $preparation))
(= (host-native:completion-duplicate $plan)
   (if (== (host-native:field $plan "kind" "") "command") "()"
     (Error provider (Fault completion-already-delivered))))
(= (host-native:duplicate-plan $plan)
   (if (== (host-native:field $plan "kind" "") "command") (host-native:failure "RuntimeError" False)
     (Error provider (Fault duplicate-native-plan))))
(= (host-native:first-choice $result)
   (case (state:json-field $result "choices")
     (((JsonArray $items) (if (== $items ()) (JsonObject ()) (car-atom $items))) ($other (JsonObject ())))))
(= (host-native:finish $plan $encoded) (host-native:finish $plan $encoded "none" "" ""))
(= (host-native:finish $plan $encoded $decision $program $code)
   (if (== (host-native:field $plan "kind" "") "structured") ("completed" (str:byte-length $encoded))
     (if (== $decision "rejected") (host-native:failure "OutputError" False)
       (let* (($result (json:parse $encoded)) ($choice (host-native:first-choice $result))
              ($message (state:json-field $choice "message"))
              ($content (if (== $decision "accepted") $program (sf:get $message "content" "")))
              ($reason (sf:get $choice "finish_reason" "unknown"))
              ($ready (if (== $reason "length") (host-native:complete-prefix $content) $content)))
         (if (or (not (== (get-type $ready) String)) (== (str:trim $ready) "")) (host-native:failure "EmptyResponse" False)
           ("completed" $ready (str:byte-length $ready)))))))
(= (host-native:structured-failed $status $type)
   (Error provider (Fault (if (and (>= $status 400) (and (< $status 500) (not (erv:contains (408 409 425 429) $status))))
                            (str:concat "native provider rejected the request: HTTP " (repr $status))
                            (str:concat "native provider failed: " (turn:text $type))))))
(= (host-native:request-allowed) (if (rejection:blocked?) "false" "true"))
(= (host-native:rejection-hold) (if (rejection:blocked?) (if (rejection:repair-pending?) "repair" "blocked") "clear"))
(= (host-native:stated-error $body) (rejection:error-fields $body))
(= (host-native:rejected $status $code $message $correction)
   (let $_ (rejection:record $status $code $message (if (== $correction "") (rejection:context) (json:parse $correction))) 1))
; Length-cut command replies keep complete forms, never execute them.
(= (host-native:scan-forms $text $points $index $depth $start $string $forms)
   (if (>= $index (size-atom $points))
     (ScannedFormsV1 (list:reverse $forms) (and (== $depth 0) (not $string)))
     (let $cp (index-atom $points $index)
       (if $string
         (if (== $cp 92)
           (host-native:scan-forms $text $points (+ $index 2) $depth $start True $forms)
           (host-native:scan-forms $text $points (+ $index 1) $depth $start (not (== $cp 34)) $forms))
         (if (== $cp 34)
           (host-native:scan-forms $text $points (+ $index 1) $depth $start True $forms)
           (if (== $cp 40)
             (host-native:scan-forms $text $points (+ $index 1) (+ $depth 1) (if (== $depth 0) $index $start) False $forms)
             (if (and (== $cp 41) (> $depth 0))
               (host-native:scan-forms $text $points (+ $index 1) (- $depth 1) $start False
                 (if (== $depth 1) (cons-atom (str:char-slice $text $start (+ $index 1)) $forms) $forms))
               (host-native:scan-forms $text $points (+ $index 1) $depth $start False $forms))))))))
(= (host-native:forms $text)
   (let $points (tuple:from (str:python-codepoints $text))
     (host-native:scan-forms $text $points 0 0 0 False ())))
(= (host-native:complete-prefix $offered)
   (let* (($text (str:trim $offered)) ((ScannedFormsV1 $forms $complete) (host-native:forms $text)))
     (if $complete $text
       (let* (($children (if (str:starts-with $text "((") (str:char-slice $text 1 (str:char-length $text)) $text))
              ((ScannedFormsV1 $calls $_) (host-native:forms $children)))
         (str:join "" ("(" (str:join " " $calls) ")"))))))
(= (host-native:coding-session?) (== (system:getenv-or-default "METTACLAW_CODING_SESSION" "0") "1"))

; A ChatGPT window is observed by the native subscription client, on its TTL.
(= (model:window-due)
   (let* (($model (model:current "")) ($observations (model:observations))
          ($record (model:record $observations "model-window")) ($now (system:wall-time))
          ($value (json:get $record "value"))
          ($fresh (and (== (json:get $value "id") $model) (< (- $now (model:stamp $record "observed_at")) 300)))
          ($attempted (and (== (json:get $record "attempted_model") $model) (< (- $now (model:stamp $record "attempted_at")) 300))))
     (if (or (not (str:starts-with $model "chatgpt:")) (or $fresh $attempted)) "" $model)))
(= (model:observe-window $model $context $source)
   (if (not (str:starts-with $model "chatgpt:")) 0
     (let* (($now (system:wall-time))
            ($success (> $context 0))
            ($fields (if $success
              (("observed_at" $now) ("attempted_at" $now)
               ("value" (JsonObject ((JsonPair "id" $model) (JsonPair "context" $context) (JsonPair "source" $source)))))
              (("attempted_at" $now) ("attempted_model" $model)
               ("last_error" (model:clip (str:concat "no window: " $source) 160)))))
            ($_ (model:update "model-window" $fields $success)))
       (if $success 1 0))))
(= (host-native:unavailable-action $reason)
   (let* (($text (re:replace-literal (re:compile "[^\\p{L}\\p{N}_.:/-]") (system:redact-secrets (turn:text $reason)) "-"))
          ($code (str:concat "provider-unavailable:" (str:char-slice $text 0 (min 64 (str:char-length $text))))))
     (host-native:failure $code False)))

(= (host-native:sleep-ms $milliseconds)
   (let $wait (max 0 (math:ceil $milliseconds))
     (case (rpc:perform (timer:after $wait) (+ (system:monotonic-ns) (* (+ $wait 1000) 1000000)))
       (((timer:fired $_) 1) ($bad (Error provider-wait (Fault $bad)))))))
(= (host-native:observe-wire $plan $body)
   (let $observed (collapse (catch (host-native:capture-request $plan $body))) $body))
(= (host-native:capture-request $plan $body)
   (let* (($health (system:getenv-or-default "METTACLAW_COGNITIVE_HEALTH_PATH" ""))
          ($folder (path:join (path:dirname $health) "request-capture"))
          ($control (path:join $folder "control.json")))
     (if (or (== $health "") (not (fs:exists $control))) 0
       (sf:locked (str:concat $control ".lock") 432 (host-native:capture-locked $folder $control $plan $body)))))
(= (host-native:capture-locked $folder $control $plan $body)
   (let* (($setting (sf:native-object $control)) ($remaining (sf:get $setting "remaining" 0))
          ($purpose (host-native:field $plan "purpose" "turn")))
     (if (or (<= $remaining 0) (not (== (sf:get $setting "purpose" "") $purpose))) 0
       (let* (($record (JsonObject
                 ((JsonPair "call_id" (host-native:field $plan "correlation" ""))
                  (JsonPair "protocol" (host-native:field $plan "protocol" ""))
                  (JsonPair "purpose" $purpose) (JsonPair "captured_at" (system:wall-time))
                  (JsonPair "wire_body" $body))))
              ($file (path:join $folder (str:concat (system:uuid4-hex) ".json")))
              ($written (sf:replace $file (json:stringify-python-with $record ((ensure-ascii False))) 432 False)))
         (if (not (== $written True)) 0
           (let $updated (sf:put $setting "remaining" (- $remaining 1))
             (sf:replace $control (sf:python-json $updated) 384 False)))))))
; A limit that cannot be read or locked, or whose count or purpose is not one,
; refuses: it was set to bound what is sent. Removed meanwhile, it is gone.
(= (host-native:submission-allowed $plan $limit)
   (case (collapse (catch (sf:locked (str:concat $limit ".lock") 432 (host-native:submission-take $plan $limit))))
     (((True) True) ($refused False))))
; Absent: no such file, or a path through a file that is not a directory,
; which can name none. A lookup that was denied or failed cannot tell.
(= (host-native:limit-absent? $read)
   (case $read ((("missing" $_) True) (("error" "NotADirectoryError" $_) True) ($other False))))
(= (host-native:submission-take $plan $limit)
   (case (fs:read-text-result $limit 0 "raw")
     ((("ok" $text)
       (let* (($setting (json:parse $text))
              ($remaining (sf:get $setting "remaining" JsonNull))
              ($purpose (sf:get $setting "purpose" "")))
         (if (or (not (host-native:count? $remaining)) (!= (get-type $purpose) String)) False
           (if (and (!= $purpose "") (!= $purpose (host-native:field $plan "purpose" "turn"))) True
             (if (<= $remaining 0) False
               (== (sf:replace $limit (sf:python-json (sf:put $setting "remaining" (- $remaining 1))) 384 False) True))))))
      ($other (host-native:limit-absent? $other)))))
; A count is a whole number, neither negative nor unbounded.
(= (host-native:count? $value)
   (if (!= (get-type $value) Number) False
     (if (or (math:isnan $value) (math:isinf $value)) False
       (and (>= $value 0) (== $value (math:floor $value))))))
(= (host-native:gate)
   (if (not (== (system:getenv-or-default "METTACLAW_MODE_RUNTIME" "") ""))
     (if (== (system:getenv-or-default "METTACLAW_CODING_CHECK" "0") "1")
       (Error provider (Forbidden coding-check)) (mode-host:before-provider))
     (host-native:agent-gate)))
(= (host-native:agent-gate)
   (if (== (system:getenv-or-default "METTACLAW_CODING_CHECK" "0") "1")
     (Error provider (Forbidden coding-check))
     (if (and (not (host-native:coding-session?)) (== (boot-state:recycle) True))
       (system:exit 0)
       (case (lifecycle-native:enabled)
         ((1 True)
          ($paused
            (let* (($_ (host-native:gate-progress)) ($_ (host-native:sleep-ms 250)))
              (host-native:agent-gate))))))))
(= (host-native:gate-progress)
   (let $now (system:monotonic-ns)
     (if (< $now (get-state &provider-gate-progress)) 0
       (let* (($_ (change-state! &provider-gate-progress (+ $now 60000000000)))
              ($_ (progress:phase "operator-wait" 60))) 1))))
