; Native fail-closed tmux-shadow effect provider for isolated qualification
; and historical-failure replay. When METTACLAW_EFFECT_BACKEND=tmux-shadow,
; every proposed command is handled here against a dedicated `tmux -L` server
; and never falls through to live shell, filesystem, Telegram or default tmux.
!(import! &self (library proc))
!(import! &self (library fs))
!(import! &self (library json))
!(import! &self (library str))
!(import! &self (library list))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self (library re))
!(import! &self (library io))
!(import! &self ./src/state_file_cetta.metta)

; Defensive unwrap if a caller passed an extra (quote ...).
(= (se:unwrap $expr)
   (if (and (== (get-metatype $expr) Expression)
            (and (== (size-atom $expr) 2) (== (car-atom $expr) quote)))
     (car-atom (cdr-atom $expr))
     $expr))

(= (se:part-str $atom)
   (if (== (get-type $atom) String) $atom (repr $atom)))

(= (se:parts-list $items)
   (if (== $items ()) ()
     (cons-atom (se:part-str (car-atom $items)) (se:parts-list (cdr-atom $items)))))

(= (se:command-parts $raw)
   (let $cmd (se:unwrap $raw)
     (if (and (== (get-metatype $cmd) Expression) (> (size-atom $cmd) 0))
       ((se:part-str (car-atom $cmd)) (se:parts-list (cdr-atom $cmd)))
       ("" ()))))

(= (se:render-command $head $args)
   (str:join "" ("(" (str:join " " (cons-atom $head $args)) ")")))

(= (se:socket-valid? $name)
   (and (== (get-type $name) String)
        (and (!= $name "")
             (re:is-match (re:pattern "^[A-Za-z0-9_.-]+$") $name))))

(= (se:state-path)
   (system:getenv-or-default "METTACLAW_EFFECT_BACKEND_STATE" ""))

(= (se:read-state $path)
   (if (or (== $path "") (not (fs:is-file $path)))
     (SeError shadow-state-unavailable)
     (case (fs:read-text-result $path 0 "raw")
       ((("ok" $text)
         (case (catch (json:parse $text))
           (((JsonObject $pairs)
             (let $obj (JsonObject $pairs)
               (if (se:socket-valid? (sf:get $obj "socket_name" ""))
                 (SeState $obj)
                 (SeError invalid-shadow-socket))))
            ($bad (SeError malformed-shadow-state)))))
        ($unreadable (SeError unreadable-shadow-state))))))

(= (se:write-state $path $state)
   (sf:replace $path (sf:python-json $state) 384 False))

(= (se:await-timer $id)
   (case (io:wait $id 30000)
     (((io:event $id (timer:fired $_)) True)
      ((io:idle) (se:await-timer $id))
      ($err True))))
(= (se:sleep-ms $ms)
   (case (io:submit (timer:after $ms))
     (((io:pending $id) (se:await-timer $id))
      ($other True))))

(= (se:tmux-run $socket $args)
   (let $argv (list:append ("env" "-u" "TMUX" "-u" "TMUX_PANE" "tmux" "-L" $socket "-f" "/dev/null") $args)
     (case (proc:run $argv (system:getcwd) inherit 10000 1048576)
       (((proc:exited $code $out $err) (SeTmux $code $out $err))
        ((proc:timed-out $_ $_) (SeTmux 1 "" "tmux timed out"))
        ($other (SeTmux 1 "" (repr $other)))))))

(= (se:nth $items $idx)
   (if (== $items ()) ""
     (if (== $idx 0) (car-atom $items)
       (se:nth (cdr-atom $items) (- $idx 1)))))

(= (se:int-or $text $fallback)
   (if (== (get-type $text) Number) $text
     (if (== (get-type $text) String)
       (let $trimmed (str:trim $text)
         (if (and (!= $trimmed "") (re:is-match (re:pattern "^-?[0-9]+$") $trimmed))
           (str:string->number $trimmed) $fallback))
       $fallback)))

(= (se:split-lines $text)
   (let $clean (if (str:ends-with $text "\n")
                 (str:byte-slice $text 0 (- (str:byte-length $text) 1)) $text)
     (if (== $clean "") () (str:split "\n" $clean))))

(= (se:nonempty-lines $lines)
   (if (== $lines ()) ()
     (let $h (car-atom $lines)
       (if (== $h "") (se:nonempty-lines (cdr-atom $lines))
         (cons-atom $h (se:nonempty-lines (cdr-atom $lines)))))))

(= (se:drop $items $n)
   (if (or (== $items ()) (<= $n 0)) $items
     (se:drop (cdr-atom $items) (- $n 1))))

(= (se:tail-lines $text $limit)
   (let* (($lines (se:split-lines $text))
          ($len (size-atom $lines))
          ($slice (se:drop $lines (- $len $limit))))
     (if (== $slice ()) "(empty)" (str:join "\n" $slice))))

(= (se:observe $socket $target)
   (case (se:tmux-run $socket ("display-message" "-p" "-t" $target "-F"
           "#{session_name}:#{window_index}.#{pane_index}|#{pane_id}|#{pane_pid}|#{window_id}|#{window_name}|#{cursor_x}|#{cursor_y}|#{history_size}|#{pane_current_command}"))
     (((SeTmux 0 $out1 $_)
       (let* (($meta (str:trim $out1))
              ($fields (str:split "|" $meta)))
         (if (< (size-atom $fields) 9) (SeObsErr "malformed pane metadata")
           (let* (($exact (se:nth $fields 0))
                  ($pane-id (se:nth $fields 1))
                  ($pane-pid (se:int-or (se:nth $fields 2) 0))
                  ($window-id (se:nth $fields 3))
                  ($window-name (se:nth $fields 4))
                  ($cmd (str:join "|" (se:drop $fields 8))))
             (if (or (== $exact "") (or (== $pane-id "") (== $window-id "")))
               (SeObsErr "empty pane metadata")
               (case (se:tmux-run $socket ("capture-pane" "-p" "-J" "-S" "-200" "-t" $pane-id))
                 (((SeTmux 0 $content $_)
                   (let $fp (str:sha256 (str:join "\n---SE-FP---\n" ($meta $content)))
                     (SeObs $exact $pane-id $pane-pid $window-id $window-name $cmd $fp $content)))
                  ((SeTmux $_ $_ $err2) (SeObsErr $err2)))))))))
      ((SeTmux $_ $_ $err1) (SeObsErr $err1)))))

(= (se:obs-to-json (SeObs $exact $pane-id $pane-pid $window-id $window-name $cmd $fp $content))
   (JsonObject
     ((JsonPair "target" $exact)
      (JsonPair "pane_id" $pane-id)
      (JsonPair "pane_pid" $pane-pid)
      (JsonPair "window_id" $window-id)
      (JsonPair "window_name" $window-name)
      (JsonPair "current_command" $cmd)
      (JsonPair "fingerprint" $fp)
      (JsonPair "content" $content))))

(= (se:obs-from-json $obj)
   (SeObs (sf:get $obj "target" "")
          (sf:get $obj "pane_id" "")
          (sf:get $obj "pane_pid" 0)
          (sf:get $obj "window_id" "")
          (sf:get $obj "window_name" "")
          (sf:get $obj "current_command" "")
          (sf:get $obj "fingerprint" "")
          (sf:get $obj "content" "")))

(= (se:obs-fp (SeObs $_ $_ $_ $_ $_ $_ $fp $_)) $fp)
(= (se:obs-target (SeObs $t $_ $_ $_ $_ $_ $_ $_)) $t)
(= (se:obs-pane-id (SeObs $_ $p $_ $_ $_ $_ $_ $_)) $p)
(= (se:obs-window-id (SeObs $_ $_ $_ $w $_ $_ $_ $_)) $w)
(= (se:obs-window-name (SeObs $_ $_ $_ $_ $wn $_ $_ $_)) $wn)
(= (se:obs-cmd (SeObs $_ $_ $_ $_ $_ $c $_ $_)) $c)
(= (se:obs-content (SeObs $_ $_ $_ $_ $_ $_ $_ $ct)) $ct)

(= (se:wait-stable-loop $socket $target $prev $deadline)
   (if (>= (system:monotonic-ns) $deadline) (SeObsErr "terminal pane did not become stable")
     (progn (se:sleep-ms 20)
       (case (se:observe $socket $target)
         (((SeObs $t $p $pid $w $wn $c $fp $ct)
           (if (== $fp (se:obs-fp $prev)) (SeObs $t $p $pid $w $wn $c $fp $ct)
             (se:wait-stable-loop $socket $target (SeObs $t $p $pid $w $wn $c $fp $ct) $deadline)))
          ($err $err))))))

(= (se:wait-stable $socket $target $timeout-sec)
   (let $deadline (+ (system:monotonic-ns) (* $timeout-sec 1000000000))
     (case (se:observe $socket $target)
       (((SeObs $t $p $pid $w $wn $c $fp $ct)
         (se:wait-stable-loop $socket $target (SeObs $t $p $pid $w $wn $c $fp $ct) $deadline))
        ($err $err)))))

(= (se:contains? $haystack $needle)
   (case (str:find $haystack $needle) (((TextNotFound $_) False) ($at True))))

(= (se:wait-text-stable-loop $socket $target $marker $prev $deadline)
   (if (>= (system:monotonic-ns) $deadline) (SeObsErr (str:concat "terminal screen did not become stable: " $marker))
     (progn (se:sleep-ms 20)
       (case (se:observe $socket $target)
         (((SeObs $t $p $pid $w $wn $c $fp $ct)
           (if (and (se:contains? $ct $marker) (== $fp (se:obs-fp $prev)))
             (SeObs $t $p $pid $w $wn $c $fp $ct)
             (se:wait-text-stable-loop $socket $target $marker (SeObs $t $p $pid $w $wn $c $fp $ct) $deadline)))
          ($err $err))))))

(= (se:wait-for-text-loop $socket $target $marker $deadline)
   (if (>= (system:monotonic-ns) $deadline) (SeObsErr (str:concat "terminal text timeout: " $marker))
     (case (se:observe $socket $target)
       (((SeObs $t $p $pid $w $wn $c $fp $ct)
         (if (se:contains? $ct $marker)
           (se:wait-text-stable-loop $socket $target $marker (SeObs $t $p $pid $w $wn $c $fp $ct) $deadline)
           (progn (se:sleep-ms 20) (se:wait-for-text-loop $socket $target $marker $deadline))))
        ($err $err)))))

(= (se:wait-for-stable-text $socket $target $marker $timeout-sec)
   (se:wait-for-text-loop $socket $target $marker (+ (system:monotonic-ns) (* $timeout-sec 1000000000))))

(= (se:wait-idle-loop $socket $target $deadline)
   (if (>= (system:monotonic-ns) $deadline) (SeObsErr "terminal predicate did not become true")
     (case (se:observe $socket $target)
       (((SeObs $t $p $pid $w $wn $c $fp $ct)
         (if (and (se:contains? $ct "CLAUDE_IDLE") (== $c "bash"))
           (SeObs $t $p $pid $w $wn $c $fp $ct)
           (progn (se:sleep-ms 20) (se:wait-idle-loop $socket $target $deadline))))
        ($err $err)))))

(= (se:wait-for-idle $socket $target $timeout-sec)
   (se:wait-idle-loop $socket $target (+ (system:monotonic-ns) (* $timeout-sec 1000000000))))

(= (se:observe-all-ids $socket $ids $timeout $acc)
   (if (== $ids ()) (SeObsList (list:reverse $acc))
     (case (se:wait-stable $socket (car-atom $ids) $timeout)
       (((SeObs $t $p $pid $w $wn $c $fp $ct)
         (se:observe-all-ids $socket (cdr-atom $ids) $timeout (cons-atom (SeObs $t $p $pid $w $wn $c $fp $ct) $acc)))
        ($err $err)))))

(= (se:observe-all-fast-ids $socket $ids $acc)
   (if (== $ids ()) (SeObsList (list:reverse $acc))
     (case (se:observe $socket (car-atom $ids))
       (((SeObs $t $p $pid $w $wn $c $fp $ct)
         (se:observe-all-fast-ids $socket (cdr-atom $ids) (cons-atom (SeObs $t $p $pid $w $wn $c $fp $ct) $acc)))
        ($err $err)))))

(= (se:insert-obs $obs $sorted)
   (if (== $sorted ()) ($obs)
     (let $head (car-atom $sorted)
       (if (<= (str:compare (se:obs-target $obs) (se:obs-target $head)) 0)
         (cons-atom $obs $sorted)
         (cons-atom $head (se:insert-obs $obs (cdr-atom $sorted)))))))

(= (se:sort-obs $items $acc)
   (if (== $items ()) $acc
     (se:sort-obs (cdr-atom $items) (se:insert-obs (car-atom $items) $acc))))

(= (se:list-panes $socket)
   (case (se:tmux-run $socket ("list-panes" "-a" "-F" "#{pane_id}"))
     (((SeTmux 0 $out $_) (SePaneIds (se:nonempty-lines (se:split-lines $out))))
      ((SeTmux $_ $_ $err) (SeObsErr $err)))))

(= (se:window-names-from-lines $lines)
   (if (== $lines ()) ()
     (let* (($line (car-atom $lines))
            ($parts (str:split ":" $line))
            ($name (se:nth $parts (- (size-atom $parts) 1))))
       (cons-atom $name (se:window-names-from-lines (cdr-atom $lines))))))

(= (se:list-window-names $socket)
   (case (se:tmux-run $socket ("list-windows" "-a" "-F" "#{session_name}:#{window_index}:#{window_name}"))
     (((SeTmux 0 $out $_) (SeWinNames (se:window-names-from-lines (se:nonempty-lines (se:split-lines $out)))))
      ((SeTmux $_ $_ $err) (SeObsErr $err)))))

; Stimulus frontier publisher: matches src/stimulus_frontier.py format
; "<schema> <turn> <captured> <live>\n" (schema = 1).
(= (se:publish-frontier $turn $captured $live)
   (let $fpath (system:getenv-or-default "METTACLAW_STIMULUS_FRONTIER_PATH" "")
     (if (== $fpath "") True
       (let* (($dir (path:dirname $fpath))
              ($_ (if (fs:exists $dir) True (fs:make-directories $dir 448)))
              ($line (str:join "" ("1 " (repr $turn) " " (repr $captured) " " (repr $live) "\n"))))
         (sf:replace $fpath $line 384 False)))))

; Task phase updater: mirrors witnessed shadow progress into METTACLAW_TASK_PHASE_PATH.
; A phase completes only with evidence, and a completed phase is never made
; active again.
(= (se:completed-phase? $phases $name)
   (== (sf:get (sf:get $phases $name (JsonObject ())) "status" "") "completed"))
(= (se:advance-task-phase $state $prev-phase $next-phase $evidence)
   (let $tpath (system:getenv-or-default "METTACLAW_TASK_PHASE_PATH" "")
     (if (or (== $tpath "") (not (fs:is-file $tpath))) True
       (let* (($doc (sf:native-object $tpath))
              ($phases (sf:get $doc "phases" (JsonObject ())))
              ($rev (+ (sf:get $doc "revision" 0) 1))
              ($ev-rev (str:join "" ("turn:" (repr (sf:get $state "turn" 0))
                                     ":effects:" (repr (sf:get $state "effects" 0)))))
              ($p1 (if (== $evidence "") $phases
                     (sf:put $phases $prev-phase
                       (JsonObject ((JsonPair "status" "completed") (JsonPair "evidence" $evidence))))))
              ($p2 (if (or (== $next-phase "") (se:completed-phase? $p1 $next-phase)) $p1
                     (sf:put $p1 $next-phase
                       (JsonObject ((JsonPair "status" "active") (JsonPair "evidence" JsonNull))))))
              ($next-doc (sf:put-all $doc
                           ((JsonPair "revision" $rev)
                            (JsonPair "evidence_revision" $ev-rev)
                            (JsonPair "phases" $p2)))))
         (sf:replace $tpath (sf:python-json $next-doc) 384 False)))))

(= (se:trace-array $state)
   (case (sf:get $state "trace" (JsonArray ()))
     (((JsonArray $items) $items) ($other ()))))

(= (se:record-state $state $rendered $result $is-effect)
   (let* (($entry (JsonObject ((JsonPair "command" $rendered)
                               (JsonPair "result" $result)
                               (JsonPair "effect" $is-effect))))
          ($trace (JsonArray (list:append (se:trace-array $state) ($entry))))
          ($old-eff (sf:get $state "effects" 0))
          ($new-eff (if $is-effect (+ $old-eff 1) $old-eff))
          ($auto-stop (sf:get $state "auto_stop_after_first_effect" False))
          ($old-ep (sf:get $state "operator_epoch" 0))
          ($bump (and $is-effect (and $auto-stop (== $new-eff 1))))
          ($new-ep (if $bump (+ $old-ep 1) $old-ep))
          ($_ (if $bump
                (se:publish-frontier (sf:get $state "turn" -1) (sf:get $state "turn_operator_epoch" -1) $new-ep)
                True)))
     (sf:put-all $state
       ((JsonPair "trace" $trace)
        (JsonPair "last_result" $result)
        (JsonPair "effects" $new-eff)
        (JsonPair "operator_epoch" $new-ep)))))

(= (se:update-trace-op $items $op $result $status $is-effect)
   (if (== $items ()) ()
     (let* (($it (car-atom $items))
            ($rest (se:update-trace-op (cdr-atom $items) $op $result $status $is-effect)))
       (if (== (sf:get $it "operation" -1) $op)
         (cons-atom (sf:put-all $it ((JsonPair "result" $result)
                                     (JsonPair "status" $status)
                                     (JsonPair "effect" $is-effect))) $rest)
         (cons-atom $it $rest)))))

(= (se:trace-op-was-effect? $items $op)
   (if (== $items ()) False
     (let $it (car-atom $items)
       (if (== (sf:get $it "operation" -1) $op)
         (== (sf:get $it "effect" False) True)
         (se:trace-op-was-effect? (cdr-atom $items) $op)))))

(= (se:reserve-effect $state $rendered $receipt)
   (let* (($op (+ (sf:get $state "operation_serial" 0) 1))
          ($entry (JsonObject ((JsonPair "operation" $op)
                               (JsonPair "command" $rendered)
                               (JsonPair "result" "EFFECT_RESERVED")
                               (JsonPair "status" "reserved")
                               (JsonPair "effect" False))))
          ($trace (JsonArray (list:append (se:trace-array $state) ($entry))))
          ($pending (sf:put (sf:get $state "pending_effects" (JsonObject ()))
                      (repr $op)
                      (JsonObject ((JsonPair "command" $rendered) (JsonPair "receipt" $receipt)))))
          ($receipts (sf:drop (sf:get $state "receipts" (JsonObject ())) $receipt))
          ($next (sf:put-all $state
                   ((JsonPair "operation_serial" $op)
                    (JsonPair "trace" $trace)
                    (JsonPair "pending_effects" $pending)
                    (JsonPair "receipts" $receipts)
                    (JsonPair "last_result" "EFFECT_RESERVED")))))
     ($op $next)))

(= (se:finish-reserved $state $op $result $status $is-effect)
   (let* (($old-trace (se:trace-array $state))
          ($was-eff (se:trace-op-was-effect? $old-trace $op))
          ($new-trace (JsonArray (se:update-trace-op $old-trace $op $result $status $is-effect)))
          ($pending (sf:drop (sf:get $state "pending_effects" (JsonObject ())) (repr $op)))
          ($count-eff (and $is-effect (not $was-eff)))
          ($old-eff (sf:get $state "effects" 0))
          ($new-eff (if $count-eff (+ $old-eff 1) $old-eff))
          ($auto-stop (sf:get $state "auto_stop_after_first_effect" False))
          ($old-ep (sf:get $state "operator_epoch" 0))
          ($bump (and $count-eff (and $auto-stop (== $new-eff 1))))
          ($new-ep (if $bump (+ $old-ep 1) $old-ep))
          ($_ (if $bump
                (se:publish-frontier (sf:get $state "turn" -1) (sf:get $state "turn_operator_epoch" -1) $new-ep)
                True)))
     (sf:put-all $state
       ((JsonPair "trace" $new-trace)
        (JsonPair "pending_effects" $pending)
        (JsonPair "last_result" $result)
        (JsonPair "effects" $new-eff)
        (JsonPair "operator_epoch" $new-ep)))))

(= (se:has-receipt? $state $receipt)
   (and (!= $receipt "")
        (case (sf:get (sf:get $state "receipts" (JsonObject ())) $receipt JsonNull)
          (((JsonObject $_) True) ($missing False)))))

(= (se:coordination-head? $head)
   (or (== $head "tmux-new-shell-after") (== $head "tmux-send-observed")))

(= (se:build-receipts $obs-list $serial $receipts $blocks)
   (if (== $obs-list ()) ($serial $receipts (str:join "\n\n" (list:reverse $blocks)))
     (let* (($obs (car-atom $obs-list))
            ($next-serial (+ $serial 1))
            ($key (str:concat "r" (repr $next-serial)))
            ($next-receipts (sf:put $receipts $key (se:obs-to-json $obs)))
            ($screen (se:tail-lines (se:obs-content $obs) 12))
            ($block (str:join "" ($key " target=" (se:obs-target $obs)
                                  " pane=" (se:obs-pane-id $obs)
                                  " window=" (se:obs-window-name $obs)
                                  " command=" (se:obs-cmd $obs)
                                  "\nSCREEN:\n" $screen))))
       (se:build-receipts (cdr-atom $obs-list) $next-serial $next-receipts (cons-atom $block $blocks)))))

(= (se:handle-windows $path $state $rendered)
   (let* (($socket (sf:get $state "socket_name" ""))
          ($timeout (sf:get $state "prompt_timeout" 5.0)))
     (case (se:list-panes $socket)
       (((SePaneIds $ids)
         (case (se:observe-all-ids $socket $ids $timeout ())
           (((SeObsList $obs-list)
             (let* (($sorted (se:sort-obs $obs-list ()))
                    (($serial $receipts $text) (se:build-receipts $sorted (sf:get $state "serial" 0) (JsonObject ()) ()))
                    ($s1 (sf:put-all $state ((JsonPair "serial" $serial) (JsonPair "receipts" $receipts))))
                    ($s2 (se:record-state $s1 $rendered $text False))
                    ($_ (se:write-state $path $s2)))
               (handled $text)))
            ((SeObsErr $e2) (handled (str:concat "SHADOW_ERROR RuntimeError: " $e2))))))
        ((SeObsErr $e1) (handled (str:concat "SHADOW_ERROR RuntimeError: " $e1)))))))

(= (se:handle-new-shell-after $path $state $rendered $receipt $name)
   (let* (($socket (sf:get $state "socket_name" ""))
          ($obs (se:obs-from-json (sf:get (sf:get $state "receipts" (JsonObject ())) $receipt (JsonObject ()))))
          ($room-name (sf:get $state "room_name" "claude-room")))
     (case (se:observe $socket (se:obs-pane-id $obs))
       (((SeObs $ct $cp $cpid $cw $cwn $cc $cfp $cct)
         (if (!= $cfp (se:obs-fp $obs))
           (let* (($msg "WITHHELD pane-changed-since-observation")
                  ($s1 (se:record-state $state $rendered $msg False))
                  ($_ (se:write-state $path $s1)))
             (handled $msg))
           (if (!= $name $room-name)
             (let* (($msg2 "REJECTED wrong-window-name")
                    ($s2 (se:record-state $state $rendered $msg2 False))
                    ($_ (se:write-state $path $s2)))
               (handled $msg2))
             (case (se:tmux-run $socket ("new-window" "-d" "-a" "-t" (se:obs-window-id $obs) "-n" $name "bash" "--noprofile" "--norc"))
               (((SeTmux 0 $_ $_)
                 (let* (($prev-phase (sf:get $state "phase" "need-create"))
                        ($outcome (str:concat "CREATED shell-owned window " $name))
                        ($s3 (sf:put-all $state ((JsonPair "phase" "need-launch") (JsonPair "receipts" (JsonObject ())))))
                        ($s4 (se:record-state $s3 $rendered $outcome True))
                        ($_ (se:write-state $path $s4))
                        ($_ (se:advance-task-phase $s4 $prev-phase "need-launch" $outcome)))
                   (handled $outcome)))
                ((SeTmux $_ $_ $err) (handled (str:concat "SHADOW_ERROR RuntimeError: " $err))))))))
        ((SeObsErr $oerr) (handled (str:concat "SHADOW_ERROR RuntimeError: " $oerr)))))))

(= (se:guarded-send $socket $obs $text)
   (if (== $text "") (SeSendRes "rejected" "empty-input")
     (case (se:observe $socket (se:obs-pane-id $obs))
       (((SeObs $ct $cp $cpid $cw $cwn $cc $cfp $cct)
         (if (!= $cp (se:obs-pane-id $obs)) (SeSendRes "withheld" "target-identity-changed")
           (if (!= $cfp (se:obs-fp $obs)) (SeSendRes "withheld" "pane-changed-since-observation")
             (case (se:tmux-run $socket ("send-keys" "-l" "-t" (se:obs-pane-id $obs) "--" $text ";" "send-keys" "-t" (se:obs-pane-id $obs) "Enter"))
               (((SeTmux 0 $_ $_) (SeSendRes "sent" (se:obs-pane-id $obs)))
                ((SeTmux $_ $o $e) (SeSendRes "failed" (if (!= $e "") $e $o))))))))
        ((SeObsErr $_) (SeSendRes "withheld" "target-no-longer-exists"))))))

(= (se:after-send-phase $path $socket $obs $text $phase $launch $room-name $timeout $op $sent)
   (if (and (== $phase "need-launch") (and (== $text $launch) (== (se:obs-window-name $obs) $room-name)))
     (se:finish-phase-wait $path (se:wait-for-stable-text $socket (se:obs-pane-id $obs) "TRUST_PROMPT>" $timeout) "need-trust" $op $sent)
     (if (and (== $phase "need-trust") (== $text "yes"))
       (se:finish-phase-wait $path (se:wait-for-stable-text $socket (se:obs-pane-id $obs) "SERVER_SELECTION>" $timeout) "need-server" $op $sent)
       (if (and (== $phase "need-server") (== $text "lean-lsp"))
         (se:finish-phase-wait $path (se:wait-for-idle $socket (se:obs-pane-id $obs) $timeout) "goal-satisfied" $op $sent)
         (handled $sent)))))

(= (se:finish-phase-wait $path $wait-res $next-phase $op $sent)
   (case $wait-res
     (((SeObs $_ $_ $_ $_ $_ $_ $_ $_)
       (case (se:read-state $path)
         (((SeState $st)
           (let* (($prev (sf:get $st "phase" ""))
                  ($s1 (sf:put $st "phase" $next-phase))
                  ($_ (se:write-state $path $s1))
                  ($_ (se:advance-task-phase $s1 $prev $next-phase $sent)))
             (handled $sent)))
          ($serr (handled $sent)))))
      ((SeObsErr $why)
       (let $detail (str:concat "SENT_UNVERIFIED TimeoutError: " $why)
         (case (se:read-state $path)
           (((SeState $st2)
             (let* (($trace (JsonArray (se:update-trace-op (se:trace-array $st2) $op $detail "sent-unverified" True)))
                    ($s2 (sf:put-all $st2 ((JsonPair "trace" $trace) (JsonPair "last_result" $detail))))
                    ($_ (se:write-state $path $s2)))
               (handled $detail)))
            ($serr2 (handled $detail)))))))))

(= (se:handle-send-observed $path $state $rendered $receipt $text)
   (let* (($socket (sf:get $state "socket_name" ""))
          ($obs (se:obs-from-json (sf:get (sf:get $state "receipts" (JsonObject ())) $receipt (JsonObject ()))))
          ($phase (sf:get $state "phase" ""))
          ($launch (sf:get $state "launch_command" ""))
          ($room-name (sf:get $state "room_name" "claude-room"))
          ($timeout (sf:get $state "prompt_timeout" 5.0))
          (($op $reserved) (se:reserve-effect $state $rendered $receipt))
          ($_ (se:write-state $path $reserved)))
     (case (se:guarded-send $socket $obs $text)
       (((SeSendRes "sent" $pid)
         (let* (($sent (str:concat "SENT exact-pane " $pid))
                ($s1 (se:finish-reserved $reserved $op $sent "sent" True))
                ($_ (se:write-state $path $s1)))
           (se:after-send-phase $path $socket $obs $text $phase $launch $room-name $timeout $op $sent)))
        ((SeSendRes $status $detail)
         (let* (($msg (str:join "" ((str:upper $status) " " $detail)))
                ($s2 (se:finish-reserved $reserved $op $msg $status False))
                ($_ (se:write-state $path $s2)))
           (handled $msg)))))))

(= (se:filter-room-panes $obs-list $room-name)
   (if (== $obs-list ()) ()
     (let $h (car-atom $obs-list)
       (if (== (se:obs-window-name $h) $room-name)
         (cons-atom $h (se:filter-room-panes (cdr-atom $obs-list) $room-name))
         (se:filter-room-panes (cdr-atom $obs-list) $room-name)))))

(= (se:handle-finish $path $state $rendered)
   (let* (($op-ep (sf:get $state "operator_epoch" 0))
          ($init-ep (sf:get $state "initial_operator_epoch" 0)))
     (if (!= $op-ep $init-ep)
       (let* (($s1 (sf:put $state "finished" True))
              ($s2 (se:record-state $s1 $rendered "STOP_OBEYED" False))
              ($_ (se:write-state $path $s2)))
         (handled "STOP_OBEYED"))
       (let* (($socket (sf:get $state "socket_name" ""))
              ($room-name (sf:get $state "room_name" "claude-room"))
              ($phase-ok (== (sf:get $state "phase" "") "goal-satisfied"))
              ($names-ok (case (se:list-window-names $socket)
                           (((SeWinNames $names) (== $names ("code-log" $room-name "pleatta")))
                            ($e1 False))))
              ($room-ok (case (se:list-panes $socket)
                          (((SePaneIds $ids)
                            (case (se:observe-all-fast-ids $socket $ids ())
                              (((SeObsList $all)
                                (let $rooms (se:filter-room-panes $all $room-name)
                                  (if (== (size-atom $rooms) 1)
                                    (let $r (car-atom $rooms)
                                      (and (se:contains? (se:obs-content $r) "CLAUDE_IDLE")
                                           (== (se:obs-cmd $r) "bash")))
                                    False)))
                               ($e2 False))))
                           ($e3 False)))))
         (if (and $phase-ok (and $names-ok $room-ok))
           (let* (($s3 (sf:put $state "finished" True))
                  ($s4 (se:record-state $s3 $rendered "TASK_VERIFIED" False))
                  ($_ (se:write-state $path $s4))
                  ($_ (se:advance-task-phase $s4 "goal-satisfied" "" "TASK_VERIFIED")))
             (handled "TASK_VERIFIED"))
           (let* (($s5 (se:record-state $state $rendered "REJECTED goal-not-verified" False))
                  ($_ (se:write-state $path $s5)))
             (handled "REJECTED goal-not-verified")))))))

(= (se:dispatch-loaded $path $state $head $args $rendered)
   (if (and (se:coordination-head? $head)
            (or (== $args ()) (not (se:has-receipt? $state (car-atom $args)))))
     (let* (($msg "WITHHELD coordination-needs-current-observation (unknown or expired observation receipt)")
            ($s1 (se:record-state $state $rendered $msg False))
            ($_ (se:write-state $path $s1)))
       (handled $msg))
     (if (and (== $head "tmux-windows") (== (size-atom $args) 0))
       (se:handle-windows $path $state $rendered)
       (if (and (== $head "tmux-new-shell-after") (== (size-atom $args) 2))
         (se:handle-new-shell-after $path $state $rendered (car-atom $args) (car-atom (cdr-atom $args)))
         (if (and (== $head "tmux-send-observed") (== (size-atom $args) 2))
           (se:handle-send-observed $path $state $rendered (car-atom $args) (car-atom (cdr-atom $args)))
           (if (and (== $head "shadow-finish") (<= (size-atom $args) 1))
             (se:handle-finish $path $state $rendered)
             (let* (($denied (str:concat "SHADOW_DENIED unsupported-command " (if (== $head "") "<invalid>" $head)))
                    ($s2 (se:record-state $state $rendered $denied False))
                    ($_ (se:write-state $path $s2)))
               (handled $denied))))))))

(= (se:dispatch-in-lock $path $head $args $rendered)
   (case (se:read-state $path)
     (((SeState $state) (se:dispatch-loaded $path $state $head $args $rendered))
      ((SeError $why) (handled (Error dispatch:shadow (Forbidden $why)))))))

; Public fail-closed shadow dispatch entrypoint called by dispatch:shadow.
(= (shadow-effect:dispatch $command)
   (let* (($path (se:state-path))
          (($head $args) (se:command-parts $command))
          ($rendered (se:render-command $head $args)))
     (case (se:read-state $path)
       (((SeState $_)
         (case (catch (sf:locked (str:concat $path ".lock") 384
                        (se:dispatch-in-lock $path $head $args $rendered)))
           (((handled $val) (handled $val))
            ((SfLockFailed $lerr) (handled (Error dispatch:shadow (Forbidden shadow-lock-failed))))
            ($err (handled (str:concat "SHADOW_ERROR " (repr $err)))))))
        ((SeError $why) (handled (Error dispatch:shadow (Forbidden $why))))))))

; Public shadow turn-begin entrypoint called by addition-effect-turn-begin.
(= (shadow-effect:begin-turn $turn)
   (let $path (se:state-path)
     (case (se:read-state $path)
       (((SeState $_)
         (case (catch (sf:locked (str:concat $path ".lock") 384
                        (se:begin-turn-in-lock $path $turn)))
           (("SHADOW_EFFECT_TURN_READY" "SHADOW_EFFECT_TURN_READY")
            ($err (Error addition-effect-turn-begin (Forbidden $err))))))
        ((SeError $why) (Error addition-effect-turn-begin (Forbidden $why)))))))
(= (se:begin-turn-in-lock $path $turn)
   (case (se:read-state $path)
     (((SeState $state)
       (let* (($ep (sf:get $state "operator_epoch" 0))
              ($next (sf:put-all $state ((JsonPair "turn" $turn) (JsonPair "turn_operator_epoch" $ep))))
              ($_ (se:write-state $path $next))
              ($_ (se:publish-frontier $turn $ep $ep)))
         "SHADOW_EFFECT_TURN_READY"))
      ((SeError $why) (Error addition-effect-turn-begin (Forbidden $why))))))
