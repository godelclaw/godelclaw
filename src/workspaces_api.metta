!(import! &self ./src/api_registry.metta)
(CommandSpec 1 "workspace" "workspaces" 0 0 "(workspaces)" "List persistent memory workspaces, their included/excluded contexts and where new memories go. CeTTa native memory." "workspace")
(CommandSpec 1 "workspace" "workspace" 0 4 "(workspace [\"name\" [includes excludes \"home\"]])" "Inspect current workspace; select a name; or define a named view using selector lists. Selectors: all, task:ID, task:*, group:ID, person:ID, channel:ID, @other-workspace. Home is a concrete selector or empty to follow the turn. Definitions do not switch focus." "workspace")
(CommandSpec 1 "workspace" "workspace-include" 2 3 "(workspace-include \"name\" \"selector\" [True|False])" "Add a selector to a workspace, or remove that inclusion with False. Repeated updates are harmless; originals stay in place." "")
(CommandSpec 1 "workspace" "workspace-exclude" 2 3 "(workspace-exclude \"name\" \"selector\" [True|False])" "Exclude a selector, or remove that exclusion with False. Exclusions take precedence within this workspace." "")
(CommandSpec 1 "workspace" "workspace-undo" 0 0 "(workspace-undo)" "Undo the last workspace definition, selection or preference change; retained memories are untouched. Undo history survives restart." "")
(CommandSpec 1 "workspace" "workspace-reload" 0 0 "(workspace-reload)" "Reload workspace descriptions after editing or repairing their data file, without restarting." "")
(CommandSpec 1 "workspace" "workspace-preview" 0 1 "(workspace-preview [\"name\"])" "Show a workspace's resolved filter, matching count and available context IDs without reading memory bodies or stimulating attention." "")
(CommandSpec 1 "workspace" "workspace-tag" 2 3 "(workspace-tag \"memory-id\" (\"task:ID\" \"group:ID\") [\"add|remove\"])" "Add/remove context memberships on a current or queued native memory. Membership survives embedding retries; source text and evidence are preserved." "")
(CommandSpec 1 "workspace" "workspace-query" 2 4 "(workspace-query \"name\" \"phrase\" [count [\"similarity|attention|hybrid\"]])" "Query a named workspace temporarily, without changing the persistent selection. Ordinary query follows the selected workspace." "")
(SettingSpec 1 "workspace" "active" "all" "workspace name" Text "persistent" "Workspace used by ordinary memory queries. Select an existing name." ws:setting ws:setting)
(SettingSpec 1 "workspace" "home" "" "context selector" Text "persistent" "Additional destination membership for new memories. Empty follows the captured task/channel; a concrete task:ID, group:ID, person:ID or channel:ID selects a home." ws:setting ws:setting)
(SettingSpec 1 "workspace" "selector" "default" "ranking mode" (Choice ("default" "similarity" "attention" "hybrid")) "persistent per workspace" "Default uses attention-policy's mode. An explicit query mode takes precedence." ws:setting ws:setting)
(SettingSpec 1 "workspace" "cross-links" "inside" "spreading scope" (Choice ("inside" "linked")) "persistent per workspace" "Inside keeps query spreading inside the selected view. Linked may traverse other contexts, but returned results still match the workspace. The underlying attention bank remains shared." ws:setting ws:setting)
