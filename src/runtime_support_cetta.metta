; Native lifecycle waits and bounded host observations.
!(import! &self ./provider_host_cetta.metta)
!(import! &self ./boot_state_cetta.metta)
!(import! &self ./jobs_cetta.metta)
!(bind! &native-wake-view (new-state (WakeViewV1 "" 0 "")))
!(bind! &native-clock-ticks (new-state 0))
(= (runtime-support:read $path)
   (case (fs:read-text-result $path 65536 "replace") ((("ok" $text) $text) ($other ""))))
(= (runtime-support:command $argv)
   (case (proc:run $argv (system:getcwd) inherit 5000 65536)
     (((proc:exited 0 $text $_) (str:trim $text)) ($other ""))))
(= (runtime-support:clock-ticks)
   (let $known (get-state &native-clock-ticks)
     (if (> $known 0) $known
       (let $parsed (str:string->number (runtime-support:command ("getconf" "CLK_TCK")))
         (if (== (get-type $parsed) Number)
           (if (> $parsed 0) (let $_ (change-state! &native-clock-ticks $parsed) $parsed)
             (Error runtime:clock-ticks unavailable))
           (Error runtime:clock-ticks unavailable))))))
(= (runtime-support:memory-field $lines $key)
   (if (== $lines ()) 0
     (let $parts (str:split-whitespace (car-atom $lines))
       (if (< (size-atom $parts) 2) (runtime-support:memory-field (cdr-atom $lines) $key)
         (if (== (car-atom $parts) $key) (str:string->number (index-atom $parts 1))
           (runtime-support:memory-field (cdr-atom $lines) $key))))))
(= (runtime-support:memory)
   (str:split "\n" (runtime-support:read "/proc/meminfo")))
(= (runtime-support:memory-used $info)
   (let* (($total (runtime-support:memory-field $info "MemTotal:"))
          ($available (runtime-support:memory-field $info "MemAvailable:")))
     (if (> $total 0) (- 100 (math:floor (/ (* 100 $available) $total))) -1)))
(= (runtime-support:duration $seconds)
   (let $n (max 0 (math:trunc $seconds))
     (if (< $n 60) (str:concat (repr $n) "s")
       (if (< $n 3600)
         (str:join "" ((repr (math:floor (/ $n 60))) "m" (runtime-support:pad2 (% $n 60)) "s"))
         (str:join "" ((repr (math:floor (/ $n 3600))) "h" (runtime-support:pad2 (math:floor (/ (% $n 3600) 60))) "m"))))))
(= (runtime-support:pad2 $n) (str:concat (if (< $n 10) "0" "") (repr $n)))
(= (runtime-support:cpus)
   (size-atom (filter-atom (str:split "\n" (runtime-support:read "/proc/stat")) $line
     (re:is-match (re:compile "^cpu[0-9]+ ") $line))))
(= (runtime-support:machine)
   (let* (($loads (str:split-whitespace (runtime-support:read "/proc/loadavg")))
          ($memory (runtime-support:memory-used (runtime-support:memory)))
          ($cpu (max 1 (runtime-support:cpus)))
          ($load (if (== $loads ()) "" (str:concat "load " (str:concat (car-atom $loads) (str:concat "/" (repr $cpu))))))
          ($mem (if (< $memory 0) "" (str:concat "mem " (str:concat (repr $memory) "%")))))
     (str:join " | " (filter-atom ($load $mem) $part (!= $part "")))))
; The newest turn's time, for the first wake after a start: the last
; timestamp in the final 64 KiB of the history, a local time read as mktime
; reads it; none without history.
!(bind! &runtime-history-stamp
   (new-state (re:compile "(20[0-9]{2})-([0-9]{2})-([0-9]{2}) ([0-9]{2}):([0-9]{2}):([0-9]{2})")))
(= (runtime-support:history-path)
   (system:getenv-or-default "METTACLAW_HISTORY_PATH" "./memory/history.metta"))
(= (runtime-support:days-from-civil $y $m $d)
   (let* (($year (if (<= $m 2) (- $y 1) $y))
          ($era (math:floor (/ $year 400)))
          ($yoe (- $year (* $era 400)))
          ($doy (+ (math:floor (/ (+ (* 153 (+ $m (if (> $m 2) -3 9))) 2) 5)) (- $d 1)))
          ($doe (+ (- (+ (* $yoe 365) (math:floor (/ $yoe 4))) (math:floor (/ $yoe 100))) $doy)))
     (- (+ (* $era 146097) $doe) 719468)))
; The local zone's offset from UTC at a time, in seconds ("+0200" is 7200).
(= (runtime-support:zone-offset $timestamp)
   (let $zone (system:format-time "%z" $timestamp "local")
     (if (!= (str:byte-length $zone) 5) 0
       (let* (($sign (if (== (str:byte-slice $zone 0 1) "-") -1 1))
              ($hours (str:string->number (str:byte-slice $zone 1 3)))
              ($minutes (str:string->number (str:byte-slice $zone 3 5))))
         (* $sign (+ (* $hours 3600) (* $minutes 60)))))))
(= (runtime-support:local-time $y $m $d $hour $minute $second)
   (let* (($wall (+ (* 86400 (runtime-support:days-from-civil $y $m $d)) (+ (* 3600 $hour) (+ (* 60 $minute) $second))))
          ($guess (- $wall (runtime-support:zone-offset $wall))))
     (- $wall (runtime-support:zone-offset $guess))))
(= (runtime-support:last-match $matches)
   (case $matches
     (((LCons $match LNil) $match)
      ((LCons $match $rest) (runtime-support:last-match $rest))
      ($none none))))
(= (runtime-support:last-turn)
   (case (fs:tail-text (runtime-support:history-path) 65536)
     (((fs:tail $size $complete $text)
       (case (re:find-all (get-state &runtime-history-stamp) $text)
         (((re:matches $matches)
           (let $match (runtime-support:last-match $matches)
             (if (== $match none) none
               (runtime-support:local-time
                 (str:string->number (re:group-text $match $text 1)) (str:string->number (re:group-text $match $text 2))
                 (str:string->number (re:group-text $match $text 3)) (str:string->number (re:group-text $match $text 4))
                 (str:string->number (re:group-text $match $text 5)) (str:string->number (re:group-text $match $text 6))))))
          ($none none))))
      ($unavailable none))))
; Compact vitals for one turn: the time since the previous turn (the
; history's newest turn for the first wake after a start), the machine's
; load against its CPUs, and memory in use. One view per turn.
(= (runtime-support:wake-view $iteration)
   (runtime-support:wake-view-at $iteration (system:wall-time) (runtime-support:machine)))
(= (runtime-support:wake-view-at $iteration $now $machine)
   (let (WakeViewV1 $last $previous $cached) (get-state &native-wake-view)
     (if (and (== $last (turn:text $iteration)) (!= $cached "")) $cached
       (let* (($since (if (> $previous 0) $previous (runtime-support:last-turn)))
              ($gap (if (== $since none) "" (str:join "" ("+" (runtime-support:duration (- $now $since)) " since last turn"))))
              ($view (str:join " | " (filter-atom ($gap $machine) $part (!= $part ""))))
              ($_ (change-state! &native-wake-view (WakeViewV1 (turn:text $iteration) $now $view))))
         (if (== $view "") "unavailable" $view)))))
(= (runtime-support:cgroup)
   (let $lines (str:split "\n" (runtime-support:read "/proc/self/cgroup"))
     (runtime-support:cgroup-of $lines)))
(= (runtime-support:cgroup-of $lines)
   (if (== $lines ()) ""
     (let $line (car-atom $lines)
       (if (str:starts-with $line "0::")
         (str:concat "/sys/fs/cgroup" (str:char-slice $line 3 (str:char-length $line)))
         (runtime-support:cgroup-of (cdr-atom $lines))))))
(= (runtime-support:cgroup-limit $folder $field)
   (let $raw (str:trim (runtime-support:read (path:join $folder $field)))
     (if (or (== $raw "") (== $raw "max")) 0 (str:string->number $raw))))
(= (runtime-support:recycle-due?)
   (let $group (runtime-support:cgroup)
     (if (== $group "") False
       (let* (($current (runtime-support:cgroup-limit $group "memory.current"))
              ($high (runtime-support:cgroup-limit $group "memory.high"))
              ($maximum (runtime-support:cgroup-limit $group "memory.max"))
              ($bound (if (> $high 0) $high $maximum))
              ($configured (system:getenv-or-default "METTACLAW_RECYCLE_BYTES" ""))
              ($threshold (if (== $configured "") (math:floor (/ (* $bound 2) 3)) (str:string->number $configured))))
         (if (== (get-type $threshold) Number) (and (> $threshold 0) (>= $current $threshold)) False)))))
(= (runtime-support:recycle-requested)
   (let $_ (if (runtime-support:recycle-due?) (engine-native:recycle) False)
     (if (== (boot-state:recycle) True) 1 0)))
(= (runtime-support:recycle-exit) (system:exit 0))
(= (runtime-support:wait-for-retry $seconds)
   (let* (($delay (max 0 $seconds)) ($deadline (+ (system:monotonic-ns) (* $delay 1000000000))))
     (runtime-support:retry-until $delay $deadline 0)))
(= (runtime-support:retry-until $delay $deadline $next-progress)
   (if (!= (lifecycle-native:enabled) 1) "operator stopped during provider retry"
     (if (== (runtime-support:recycle-requested) 1) "recycle requested"
       (let* (($now (system:monotonic-ns)) ($remaining (max 0 (/ (- $deadline $now) 1000000000)))
              ($blocked (rejection:blocked?)))
         (if (and $blocked (rejection:repair-pending?)) "provider context repair requested"
           (if (and (<= $remaining 0) (not $blocked))
             (str:join "" ("rested " (repr (math:ceil $delay)) "s provider retry"))
             (let* (($_ (if $blocked (rejection:notify) 0))
                    ($window (if $blocked 10 (min 10 $remaining)))
                    ($_ (if (>= $now $next-progress)
                          (progress:phase (if $blocked "provider-rejected" "provider-backoff") $window) 0))
                    ($next (if (>= $now $next-progress) (+ $now (* (max 1 $window) 1000000000)) $next-progress))
                    ($_ (sleep (if $blocked 1 (min 1 $remaining)))))
               (runtime-support:retry-until $delay $deadline $next))))))))
(= (runtime-support:gigabytes $kb) (str:concat (str:format-fixed (/ $kb 1048576.0) 1) "G"))
(= (runtime-support:vitals)
   (let* (($uptime (str:split-whitespace (runtime-support:read "/proc/uptime")))
          ($info (runtime-support:memory))
          ($available (runtime-support:memory-field $info "MemAvailable:"))
          ($total (runtime-support:memory-field $info "MemTotal:"))
          ($swap (- (runtime-support:memory-field $info "SwapTotal:") (runtime-support:memory-field $info "SwapFree:")))
          ($machine (runtime-support:machine))
          ($pressure (runtime-support:read "/proc/pressure/memory"))
          ($processes (runtime-support:command ("ps" "-eo" "user:16,rss,pcpu,etimes,comm" "--sort=-rss"))))
     (str:join "\n" (filter-atom
       ((if (== $uptime ()) "" (str:concat "up " (runtime-support:duration (str:string->number (car-atom $uptime)))))
        $machine
        (if (<= $total 0) "" (str:join "" ("memory " (repr (runtime-support:memory-used $info)) "% used, "
              (runtime-support:gigabytes $available) " available of " (runtime-support:gigabytes $total)
              "; swap " (runtime-support:gigabytes $swap) " used")))
        (if (== $pressure "") "" (str:concat "memory pressure:\n" (str:trim $pressure)))
        (if (== $processes "") "" (str:concat "heaviest (RSS KiB):\n" (str:join "\n" (list:take 6 (str:split "\n" $processes)))))
        (str:concat "background jobs running: " (repr (jobs:running-count))))
       $line (!= $line "")))))
