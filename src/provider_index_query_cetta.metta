; Bounded candidate pages over an original native view. Hashes are never
; equality certificates. Every fetched primary row joins the read footprint,
; even when its field fails the exact, type-preserving value comparison.
!(import! &self ./provider_index_store_cetta.metta)

(= (provider-index:query-row $view $reference $kind $name $expected)
  (case (store:decode $reference)
    (((StoreDecoded (ProviderIndexV1 $primary))
      (case (store:get $view $primary 1048576)
        (((StoreValue $bytes)
          (case (store:decode $bytes)
            (((StoreDecoded $row)
              (if (== (provider-store:key $row) $primary)
                (if (== (car-atom $row) $kind)
                  (provider-index:query-field $row $primary $name $expected)
                  (ProviderIndexRefusedV1 index-record-kind))
                (ProviderIndexRefusedV1 index-record-key)))
             ($error $error))))
         (StoreAbsent (ProviderIndexRefusedV1 dangling-index-reference))
         ($error $error))))
     ($other (ProviderIndexRefusedV1 index-reference-shape)))))

(= (provider-index:query-field $row $primary $name $expected)
  (case (provider-index:field $row $name)
    (((ProviderIndexFieldValueV1 $value)
      (case (store:encode $value)
        (((StoreEncoded $actual)
          (ProviderIndexInspectedV1 $primary (== $actual $expected) $row))
         ($error $error))))
     ($other (ProviderIndexRefusedV1 index-field)))))

(= (provider-index:page-result $rows $resume $done $reads)
  (let* (($ordered (provider-store:reverse $rows ()))
         ($scopes (provider-store:reverse $reads ())))
    (ProviderIndexScannedPageV1 $ordered $resume $done (cons-atom reads $scopes))))

(= (provider-index:bind-page $page $epoch $revision $kind $name $expected)
  (case $page
    (((ProviderIndexScannedPageV1 $rows $resume $state $reads)
      (if (== $state ProviderIndexDoneV1) (ProviderIndexPageV1 $rows ProviderIndexDoneV1 $reads)
        (ProviderIndexPageV1 $rows
          (ProviderIndexCursorV1 $epoch $revision $kind $name $expected $resume) $reads)))
     ($error $error))))

(= (provider-index:scan-page $view $scan $position $kind $name $expected $remaining $resume $rows $reads)
  (if (== $remaining 0) (provider-index:page-result $rows $resume ProviderIndexMoreV1 $reads)
    (case (store:scan-next $scan $position)
      ((StoreEnd (provider-index:page-result $rows $resume ProviderIndexDoneV1 $reads))
       ((StoreKey $key $size $next)
         (case (store:get $view $key 1048576)
           (((StoreValue $reference)
             (case (provider-index:query-row $view $reference $kind $name $expected)
               (((ProviderIndexInspectedV1 $primary $matches $row)
                 (let* (($new-reads (cons-atom (point $primary) $reads))
                        ($new-rows (if $matches (cons-atom $row $rows) $rows)))
                   (provider-index:scan-page $view $scan $next $kind $name $expected
                     (- $remaining 1) $key $new-rows $new-reads)))
                ($error $error))))
            ($other (ProviderIndexRefusedV1 changed-captured-index)))))
       ($error $error)))))

(= (provider-index:key-after $prefix $after)
  (if (== $after NoBound) (ProviderIndexStartV1 $prefix)
    (if (== (get-type $after) String)
      (if (== (str:byte-length $after) (+ (str:byte-length $prefix) 8))
        (if (str:starts-with $after $prefix)
          (case (store:key-i64 -9223372036854775808)
            (((StoreKeyBytes $zeroes)
              (let $zero (str:byte-slice $zeroes 0 1)
                (ProviderIndexStartV1 (str:concat $after $zero))))
             ($error $error)))
          (ProviderIndexRefusedV1 foreign-resume-key))
        (ProviderIndexRefusedV1 resume-key-shape))
      (ProviderIndexRefusedV1 resume-key-type))))

(= (provider-index:after-bound $prefix $cursor $epoch $revision $kind $name $expected)
  (if (== $cursor NoBound) (ProviderIndexStartV1 $prefix)
    (case $cursor
      (((ProviderIndexCursorV1 $old-epoch $old-revision $old-kind $old-name $old-value $after)
        (if (== $epoch $old-epoch)
          (if (== $revision $old-revision)
            (if (== $kind $old-kind)
              (if (== $name $old-name)
                (if (== $expected $old-value) (provider-index:key-after $prefix $after)
                  (ProviderIndexRefusedV1 foreign-query-cursor))
                (ProviderIndexRefusedV1 foreign-query-cursor))
              (ProviderIndexRefusedV1 foreign-query-cursor))
            (ProviderIndexRefusedV1 stale-query-cursor))
          (ProviderIndexRefusedV1 stale-query-cursor)))
       ($other (ProviderIndexRefusedV1 cursor-shape))))))

(= (provider-index:query-page $view $epoch $revision $kind $name $value $cursor $limit)
  (case (store:key-i64 $limit)
    (((StoreKeyBytes $ignored)
      (if (> $limit 0)
        (case (provider-index:layout $view)
          ((ProviderIndexLayoutReadyV1
            (provider-index:query-ready $view $epoch $revision $kind $name $value $cursor $limit))
           ($error $error)))
        (ProviderIndexRefusedV1 page-size)))
     ($other (ProviderIndexRefusedV1 page-size)))))

(= (provider-index:query-ready $view $epoch $revision $kind $name $value $cursor $limit)
  (case (provider-index:prefix $kind $name $value)
    (((ProviderIndexRangeV1 $prefix $upper)
      (case (store:encode $value)
        (((StoreEncoded $expected)
          (case (provider-index:after-bound $prefix $cursor $epoch $revision $kind $name $expected)
            (((ProviderIndexStartV1 $lower)
              (case (store:scan-open $view $lower $upper)
                (((StoreScan $scan)
                  (let* (($layout-key (provider-index:layout-key))
                         ($answer (provider-index:scan-page $view $scan 0 $kind $name $expected $limit NoBound ()
                                    ((point $layout-key) (range $prefix $upper))))
                         ($closed (store:close $scan)))
                    (provider-index:bind-page $answer $epoch $revision $kind $name $expected)))
                 ($error $error))))
             ($error $error))))
         ($error $error))))
     ($error $error))))

(= (provider-index:query $path $expected-epoch $expected-revision $kind $name $value $after $limit)
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (if (== $epoch $expected-epoch)
                               (if (== $revision $expected-revision)
                                 (provider-index:query-page $view $epoch $revision $kind $name $value $after $limit)
                                 (ProviderStoreChanged $epoch $revision))
                               (ProviderStoreChanged $epoch $revision)))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (provider-index-query:call (Query $path $epoch $revision $kind $name $value $after $limit))
   (provider-index:query $path $epoch $revision $kind $name $value $after $limit))
