; Derived from our metta-attention cetta/ implementation, b631eb53.
; SPDX-License-Identifier: MIT
; Attention policy over native spaces. Values and reserves are observations,
; never permission to execute a computation. Embeddings and belief evidence
; belong to their own stores. IDs connect this space to those stores.
!(import! &self (library list))
!(import! &self ./src/ecan_arguments.metta)

(= (ecan:new) (ecan:new 0 0 0))
(= (ecan:new $sti-reserve $lti-reserve)
   (ecan:new $sti-reserve 0 $lti-reserve))
(= (ecan:new $sti-reserve $mti-reserve $lti-reserve)
   (let* (($bank (new-space)) ($s $sti-reserve) ($m $mti-reserve) ($l $lti-reserve)
          ($_ (add-atom $bank (ECANBank $s $m $l)))
          ($_ (ecan:default-settings $bank (ecan:parameters)))) $bank))
(= (ecan:funds $bank)
   (match $bank (ECANBank $sti $mti $lti) (ECANFunds $sti $mti $lti)))
(= (ecan:values $bank)
   (collapse (match $bank (ECANValue $id $sti $mti $lti) (ECANValue $id $sti $mti $lti))))
(= (ecan:get $bank $id)
   (case (collapse (match $bank (ECANValue $id $sti $mti $lti) (ECANValue $id $sti $mti $lti)))
     ((() (ECANMissing $id)) (($value) $value))))
(= (ecan:current $bank $id)
   (case (ecan:get $bank $id)
     (((ECANMissing $id) (ECANValue $id 0 0 0)) ($value $value))))

; Settings share the bank's ownership and snapshot, rather than global state.
(= (ecan:policy $bank)
   (collapse (match $bank (ECANSetting $key $value) (ECANSetting $key $value))))
(= (ecan:setting $bank $key)
   (case (collapse (match $bank (ECANSetting $key $value) $value))
     ((() (ECANError setting $key "unknown setting" $key)) (($value) $value))))
(= (ecan:configure $bank $key $value)
   (let* (($setting $value) ($check (ecan:validate-setting $key $setting)))
     (if (== $check True)
       (let* (($_ (collapse (match $bank (ECANSetting $key $old)
                              (remove-atom $bank (ECANSetting $key $old)))))
              ($_ (add-atom $bank (ECANSetting $key $setting)))) $setting) $check)))
(= (ecan:restore-policy $bank $settings)
   (if (== $settings ()) True
     (let (ECANSetting $key $value) (car-atom $settings)
       (let $_ (ecan:configure $bank $key $value)
         (ecan:restore-policy $bank (cdr-atom $settings))))))

; Identity-targeted replacement: other attention values stay in place.
; Paying a stimulus may overdraw a reserve; the requested update still runs.
(= (ecan:set $bank $id $sti $lti)
   (let (ECANValue $id $old-sti $mti $old-lti) (ecan:current $bank $id)
     (ecan:set $bank $id $sti $mti $lti)))
(= (ecan:set $bank $id $sti $mti $lti)
   (let* (($new-sti $sti) ($new-mti $mti) ($new-lti $lti)
          ((ECANValue $id $old-sti $old-mti $old-lti) (ecan:current $bank $id))
          ((ECANFunds $fund-sti $fund-mti $fund-lti) (ecan:funds $bank))
          ($new-fund-sti (+ $fund-sti (- $old-sti $new-sti)))
          ($new-fund-mti (+ $fund-mti (- $old-mti $new-mti)))
          ($new-fund-lti (+ $fund-lti (- $old-lti $new-lti)))
          ($_ (collapse (match $bank (ECANValue $id $s $m $l)
                          (remove-atom $bank (ECANValue $id $s $m $l)))))
          ($_ (remove-atom $bank (ECANBank $fund-sti $fund-mti $fund-lti)))
          ($_ (add-atom $bank (ECANBank $new-fund-sti $new-fund-mti $new-fund-lti)))
          ($value (ECANValue $id $new-sti $new-mti $new-lti))
          ($_ (add-atom $bank $value))) $value))
(= (ecan:stimulate $bank $id $sti) (ecan:stimulate $bank $id $sti 0))
(= (ecan:stimulate $bank $id $sti $lti)
   (ecan:stimulate $bank $id $sti 0 $lti))
(= (ecan:stimulate $bank $id $sti $mti $lti)
   (let (ECANValue $id $old-sti $old-mti $old-lti) (ecan:current $bank $id)
     (ecan:set $bank $id (+ $old-sti $sti) (+ $old-mti $mti) (+ $old-lti $lti))))
(= (ecan:decay $bank $sti-retain $lti-retain)
   (ecan:decay $bank $sti-retain 1 $lti-retain))
(= (ecan:decay $bank $sti-retain $mti-retain $lti-retain)
   (let* (($sr $sti-retain) ($mr $mti-retain) ($lr $lti-retain)
          ($check (ecan:validate-retention $sr $mr $lr)))
     (if (== $check True) (ecan:apply-decay $bank $sr $mr $lr) $check)))
(= (ecan:apply-decay $bank $sr $mr $lr)
   (let* (
          ((ECANFunds $sti $mti $lti) (ecan:funds $bank))
          ((ECANFunds $new-sti $new-mti $new-lti)
           (ecan:decay-values $bank (ecan:values $bank)
                             $sr $mr $lr $sti $mti $lti))
          ($_ (remove-atom $bank (ECANBank $sti $mti $lti)))
          ($_ (add-atom $bank (ECANBank $new-sti $new-mti $new-lti)))) True))
; The sweep already has the old values: avoid looking them up again and
; touching the reserve record for every row. Publish the reserve once.
(= (ecan:decay-values $bank $values $sti-retain $mti-retain $lti-retain $fund-sti $fund-mti $fund-lti)
   (if (== $values ()) (ECANFunds $fund-sti $fund-mti $fund-lti)
     (let* (((ECANValue $id $sti $mti $lti) (car-atom $values))
            ($s (* $sti $sti-retain)) ($m (* $mti $mti-retain)) ($l (* $lti $lti-retain))
            ($fs (+ $fund-sti (- $sti $s)))
            ($fm (+ $fund-mti (- $mti $m)))
            ($fl (+ $fund-lti (- $lti $l)))
            ($_ (remove-atom $bank (ECANValue $id $sti $mti $lti)))
            ($_ (add-atom $bank (ECANValue $id $s $m $l))))
       (ecan:decay-values $bank (cdr-atom $values)
                         $sti-retain $mti-retain $lti-retain $fs $fm $fl))))
(= (ecan:consolidate $bank $id $rate)
   (let $check (ecan:fraction consolidate sti-lti-rate $rate)
     (if (== $check True)
       (let (ECANValue $id $sti $mti $lti) (ecan:current $bank $id)
         (ecan:set $bank $id $sti $mti (+ $lti (* $rate (- $sti $lti))))) $check)))
; Adjacent slow traces: MTI moves toward STI, then LTI toward the new MTI.
(= (ecan:consolidate $bank $id $sti-mti-rate $mti-lti-rate)
   (let $check (ecan:validate-consolidation $sti-mti-rate $mti-lti-rate)
     (if (== $check True)
       (ecan:apply-consolidation $bank $id $sti-mti-rate $mti-lti-rate) $check)))
(= (ecan:apply-consolidation $bank $id $sti-mti-rate $mti-lti-rate)
   (let* (((ECANValue $id $sti $mti $lti) (ecan:current $bank $id))
          ($m (+ $mti (* $sti-mti-rate (- $sti $mti))))
          ($l (+ $lti (* $mti-lti-rate (- $m $lti)))))
     (ecan:set $bank $id $sti $m $l)))

; A caller-selected view; selecting a small focus never deletes other items.
; The native heap selects scores without sorting the complete candidate list.
(= (ecan:focus $bank $count)
   (let $rows (ecan:sti-scored $bank) (ecan:select $rows $count)))
(= (ecan:sti-scored $bank)
   (collapse (match $bank (ECANValue $id $sti $mti $lti)
                       ($sti (ECANValue $id $sti $mti $lti)))))
; The same selector can use MTI/LTI for task recall and STI/MTI for context.
(= (ecan:focus $bank $count $sti-weight $mti-weight $lti-weight)
   (let $rows (ecan:scored $bank $sti-weight $mti-weight $lti-weight)
     (ecan:select $rows $count)))
(= (ecan:scored $bank $sti-weight $mti-weight $lti-weight)
   (collapse (match $bank (ECANValue $id $sti $mti $lti)
     (let $score (+ (+ (* $sti-weight $sti) (* $mti-weight $mti)) (* $lti-weight $lti))
       ($score (ECANValue $id $sti $mti $lti))))))
; A caller-selected threshold for this view. Raw access remains independent.
(= (ecan:focus-above $bank $count $threshold)
   (let* (($rows (ecan:sti-scored $bank))
          ($eligible (ecan:above $rows $threshold)))
     (ecan:select $eligible $count)))
(= (ecan:above $rows $threshold)
   (if (== $rows ()) ()
     (let ($score $value) (car-atom $rows)
       (let $rest (ecan:above (cdr-atom $rows) $threshold)
         (if (>= $score $threshold)
           (cons-atom ($score $value) $rest) $rest)))))
(= (ecan:select $rows $count)
   (let $k (if (== $count 0) (size-atom $rows) $count)
     (list:retain-top-k-keyed $rows $k)))
(= (ecan:total $bank)
   (let (ECANFunds $sti $mti $lti) (ecan:funds $bank)
     (ecan:sum (ecan:values $bank) $sti $mti $lti)))
(= (ecan:sum $values $sti $mti $lti)
   (if (== $values ()) (ECANTotal $sti $mti $lti)
     (let (ECANValue $id $s $m $l) (car-atom $values)
       (ecan:sum (cdr-atom $values) (+ $sti $s) (+ $mti $m) (+ $lti $l)))))

; Explicit one-hop transfer to existing neighbours supplied by the caller.
; No global graph scan, learned link insertion, or automatic forgetting.
(= (ecan:spread $bank $source $targets $fraction)
   (let $check (ecan:fraction spread fraction $fraction)
     (if (== $check True)
       (ecan:spread-unique $bank $source (unique-atom $targets) $fraction) $check)))
(= (ecan:spread-unique $bank $source $targets $fraction)
   (if (== $targets ()) True
     (let* (((ECANValue $source $sti $mti $lti) (ecan:current $bank $source))
            ($amount (* $fraction $sti))
            ($_ (ecan:set $bank $source (- $sti $amount) $mti $lti)))
       (ecan:pay-neighbours $bank $targets (/ $amount (size-atom $targets))))))
(= (ecan:pay-neighbours $bank $targets $amount)
   (if (== $targets ()) True
     (let $_ (ecan:stimulate $bank (car-atom $targets) $amount)
       (ecan:pay-neighbours $bank (cdr-atom $targets) $amount))))

; A portable state value. Storage ownership and commit scheduling belong to
; the calling native memory service, rather than an implicit file or daemon.
(= (ecan:snapshot $bank)
   (let* (($funds (ecan:funds $bank)) ($policy (ecan:policy $bank))
          ($values (ecan:values $bank))) (ECANSnapshot 2 $funds $policy $values)))
(= (ecan:restore (ECANSnapshot 2 (ECANFunds $sti $mti $lti) $policy $values))
   (let $check (ecan:validate-policy $policy)
     (if (== $check True)
       (let* (($bank (ecan:new $sti $mti $lti))
              ($_ (ecan:restore-values $bank $values))
              ($_ (ecan:restore-policy $bank $policy))) $bank) $check)))
; Version-one snapshots keep their old balances and values; MTI starts at zero.
(= (ecan:restore ((ECANFunds $sti $lti) $values))
   (let $bank (ecan:new $sti $lti)
     (let $_ (ecan:restore-legacy $bank $values) $bank)))
(= (ecan:restore-values $bank $values)
   (if (== $values ()) True
     (let $value (car-atom $values)
       (let $_ (add-atom $bank $value)
         (ecan:restore-values $bank (cdr-atom $values))))))
(= (ecan:restore-legacy $bank $values)
   (if (== $values ()) True
     (let (ECANValue $id $sti $lti) (car-atom $values)
       (let $_ (add-atom $bank (ECANValue $id $sti 0 $lti))
         (ecan:restore-legacy $bank (cdr-atom $values))))))
