; Native provider record storage. This module is not selected by live callers
; until migration and complete transition/reader qualification have passed.
; Checkpoint assignments preserve input order and return an epoch/revision.
; They are not a transition adapter: a transition must retain its original
; captured view and dependencies through planning and conditional publication.
!(import! &self (library store))
!(import! &self (library str))

(= (provider-store:width $kind)
  (case $kind ((ProviderRequestV1 12) (ProviderCooldownV1 4) (ProviderCallV1 20)
               (ProviderEventV1 6) (ProviderAdmissionRecoveryV1 6) (ProviderSequenceV1 3)
               ($other 0))))

(= (provider-store:prefix ProviderRequestV1) "requests/")
(= (provider-store:prefix ProviderCooldownV1) "cooldowns/")
(= (provider-store:prefix ProviderCallV1) "native_calls/")
(= (provider-store:prefix ProviderEventV1) "llm_call_history/")
(= (provider-store:prefix ProviderAdmissionRecoveryV1) "admission_recovery/")

(= (provider-store:key $record)
  (if (== (get-metatype $record) Expression)
    (if (== (size-atom $record) 0) (ProviderStoreRefused record-shape)
      (let $kind (car-atom $record)
        (if (== (size-atom $record) (provider-store:width $kind))
          (provider-store:key-shaped $record $kind)
          (ProviderStoreRefused record-shape))))
    (ProviderStoreRefused record-shape)))

(= (provider-store:key-shaped $record $kind)
    (if (== $kind ProviderSequenceV1)
      (let $table (index-atom $record 1) (str:concat "frontier/" $table))
      (let* (($prefix (provider-store:prefix $kind))
             ($ordinal (if (== $kind ProviderEventV1) (index-atom $record 3) (index-atom $record 2))))
        (case (store:key-i64 $ordinal)
          (((StoreKeyBytes $suffix) (str:concat $prefix $suffix))
           ($error (ProviderStoreRefused invalid-ordinal)))))))

(= (provider-store:reverse $items $reversed)
  (if (== $items ()) $reversed
    (let* (($head (car-atom $items)) ($tail (cdr-atom $items))
           ($next (cons-atom $head $reversed)))
      (provider-store:reverse $tail $next))))

(= (provider-store:encode-rows $rows $reverse-ops $reverse-scopes)
  (if (== $rows ())
    (let* (($operations (provider-store:reverse $reverse-ops ()))
           ($scopes (provider-store:reverse $reverse-scopes ())))
      (ProviderStoreBatch $operations $scopes))
    (let* (($row (car-atom $rows)) ($tail (cdr-atom $rows)) ($key (provider-store:key $row)))
      (case $key
        (((ProviderStoreRefused $why) $key)
         ($key (case (store:encode $row)
                 (((StoreEncoded $bytes)
                   (let* (($ops (cons-atom (put $key $bytes) $reverse-ops))
                          ($scopes (cons-atom (point $key) $reverse-scopes)))
                     (provider-store:encode-rows $tail $ops $scopes)))
                  ($error $error)))))))))

(= (provider-store:init $path)
  (case (store:open $path "create")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $closed (store:close $view) (ProviderStoreReady $epoch $revision)))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (provider-store:put-records $path $rows)
  (case (provider-store:encode-rows $rows () ())
    (((ProviderStoreBatch $operations $scopes)
      (case (store:open $path "existing")
        (((StoreOpened $owner)
          (let $answer
            (case (store:snapshot $owner)
              (((StoreSnapshot $view $epoch $revision)
                (let* (($ops (cons-atom ops $operations)) ($writes (cons-atom writes $scopes))
                       ($answer (case (store:commit-scoped $owner $view (reads) $writes $ops)
                         (((StoreSnapshot $updated $same-epoch $after)
                           (let $closed (store:close $updated) (ProviderStoreWritten $same-epoch $after)))
                          ($error $error))))
                       ($closed (store:close $view))) $answer))
               ($error $error)))
            (let $closed (store:close $owner) $answer)))
         ($error $error))))
     ($error $error))))

(= (provider-store:read-keys $view $keys $reverse)
  (if (== $keys ())
    (let $rows (provider-store:reverse $reverse ()) (ProviderStoreRows $rows))
    (let* (($key (car-atom $keys)) ($tail (cdr-atom $keys)))
      (case (store:get $view $key 1048576)
        (((StoreValue $bytes)
          (case (store:decode $bytes)
            (((StoreDecoded $record)
              (let $rows (cons-atom $record $reverse)
                (provider-store:read-keys $view $tail $rows)))
             ($error $error))))
         ($error $error))))))

(= (provider-store:get-records $path $expected-epoch $expected-revision $keys)
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (if (== $epoch $expected-epoch)
                             (if (== $revision $expected-revision)
                               (provider-store:read-keys $view $keys ())
                               (ProviderStoreChanged $epoch $revision))
                             (ProviderStoreChanged $epoch $revision)))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (provider-store:checkpoint-call (Create $path)) (provider-store:init $path))
(= (provider-store:checkpoint-call (Import $path $records)) (provider-store:put-records $path $records))
(= (provider-store:checkpoint-call (Read $path $epoch $revision $keys)) (provider-store:get-records $path $epoch $revision $keys))
