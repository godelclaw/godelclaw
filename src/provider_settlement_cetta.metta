; Local settlement and process-death recovery of resource claims.
; Result, usage, terminal lease, released capacity and receipt publish once.
; Observations come from the trusted transport/process boundary. These pure
; transitions never send, retry, signal a process or interpret PID liveness.
!(import! &self ./provider_claims_cetta.metta)

(= (ps:observation? $value)
  (case $value ((ProviderProcessLiveV3 True) (ProviderProcessExitedV3 True)
               (ProviderProcessUnavailableV3 True) ($other False))))
(= (ps:recovery-decision $stage $observation)
  (case ($stage $observation)
    (((ProviderClaimReservedV3 ProviderProcessExitedV3) ProviderReleaseUnsentV3)
     (((ProviderClaimDispatchV3 $transport) ProviderProcessExitedV3) ProviderPreserveUnknownV3)
     ($other ProviderKeepClaimV3))))
(= (ps:keys $command)
  (case $command
    (((ProviderSettleV3 $call $owner $process $transport $reference $usage $source)
      (if (provider-domain:id? $process)
        (if (kb:ground-identity? $transport)
          (ProviderSettlementKeysV3
            (ProviderFinishV2 $call $owner $reference $usage $source))
          (ProviderSettlementRefusedV3 transport-identity))
        (ProviderSettlementRefusedV3 process-identity)))
     ((ProviderRecoverClaimV3 $call $owner $process $observation $source)
      (if (pc:entry? (ProviderActiveClaimV3 $call $owner $process ProviderExclusiveActivityV3))
        (if (ps:observation? $observation)
          (ProviderRecoveryKeysV3
            ((ProviderCallKeyV2 $call) (ProviderLeaseKeyV2 $call) (ProviderAnswerKeyV2 $call)
             (ProviderClaimKeyV3 $call) (ProviderDispatchKeyV3 $call) (ProviderAttemptKeyV2 $call $owner)))
          (ProviderSettlementRefusedV3 process-observation))
        (ProviderSettlementRefusedV3 claim-identity)))
     ($other (ProviderSettlementRefusedV3 command-format)))))
(= (ps:extend $view $observation $identities $budget)
  (case $observation
    (((KnowledgeObservedV1 $points $reads)
      (case (kb:observe $view $identities $budget)
        (((KnowledgeObservedV1 $more $extra)
          (KnowledgeObservedV1 (kb:append $points $more)
            (cons-atom reads (kb:append (cdr-atom $reads) (cdr-atom $extra)))))
         ($error $error))))
     ($error $error))))
(= (ps:observe $view $command $budget)
  (case (ps:keys $command)
    (((ProviderSettlementKeysV3 $finish)
      (let (ProviderFinishV2 $call $owner $reference $usage $source) $finish
        (ps:observe-frontier $view $call
          (ps:extend $view (provider-domain:observe $view $finish $budget)
            ((ProviderClaimKeyV3 $call) (ProviderDispatchKeyV3 $call)) $budget) $budget)))
     ((ProviderRecoveryKeysV3 $identities)
      (let (ProviderRecoverClaimV3 $call $owner $process $observation $source) $command
        (ps:observe-frontier $view $call (kb:observe $view $identities $budget) $budget)))
     ($error $error))))
(= (ps:observe-frontier $view $call $observation $budget)
  (case $observation
    (((KnowledgeObservedV1 $points $reads)
      (case (kb:lookup $points (ProviderClaimKeyV3 $call))
        (((KnowledgePresentV1 (ProviderClaimV3 $scope $owner $process $activity $stage))
          (ps:extend $view $observation
            ((ProviderActiveClaimsKeyV3 $scope) (ProviderActiveClaimKeyV3 $scope $call)) $budget))
         ($other $observation))))
     ($error $error))))
(= (ps:refuse $why) (ProviderSettlementPlanV3 (ProviderSettlementRefusedV3 $why) ()))
(= (ps:without-call $entries $call)
  (if (== $entries ()) ()
    (let (ProviderActiveClaimV3 $identity $owner $process $activity) (car-atom $entries)
      (if (== $identity $call) (ps:without-call (cdr-atom $entries) $call)
        (cons-atom (car-atom $entries) (ps:without-call (cdr-atom $entries) $call))))))
(= (ps:release $points $scope $call $owner $process $activity $outcome)
  (case (pc:frontier $points $scope)
    (((ProviderFrontierV3 $entries)
      (let $expected (KnowledgePresentV1 (ProviderActiveClaimV3 $call $owner $process $activity))
        (case (kb:same ((pc:find-call $entries $call)
                       (kb:lookup $points (ProviderActiveClaimKeyV3 $scope $call)))
                      ($expected $expected))
          (((KnowledgeEqualV1 True)
            (ProviderReleaseChangesV3
              ((KnowledgePutV1 (ProviderActiveClaimsKeyV3 $scope)
                 (ProviderActiveClaimsV3 (ps:without-call $entries $call)))
               (KnowledgeRemoveV1 (ProviderActiveClaimKeyV3 $scope $call))
               (KnowledgePutV1 (ProviderClaimKeyV3 $call)
                 (ProviderClaimV3 $scope $owner $process $activity (ProviderClaimEndedV3 $outcome))))))
           ($other (ProviderSettlementRefusedV3 active-claim-index))))))
     ($other (ProviderSettlementRefusedV3 frontier-format)))))

(= (ps:plan (ProviderSettleV3 $call $owner $process $transport $reference $usage $source) $points)
  (case (kb:same ((kb:lookup $points (ProviderDispatchKeyV3 $call))
                 (kb:lookup $points (ProviderAttemptKeyV2 $call $owner)))
                ((KnowledgePresentV1 (ProviderDispatchIntentV3 $call $owner $process $transport))
                 (KnowledgePresentV1 (ProviderSubmittedAttemptV2 $transport))))
    (((KnowledgeEqualV1 True)
      (case (provider-domain:plan (ProviderFinishV2 $call $owner $reference $usage $source) $points)
        (((ProviderDomainPlanV2 $answer $changes)
          (case $answer
            (((ProviderCompletedV2 $status)
              (ps:finish-release $points $call $owner $process $transport $answer $changes))
             ((ProviderAlreadyCompletedV2 $status)
              (ps:finish-release $points $call $owner $process $transport $answer $changes))
             ($other (ProviderSettlementPlanV3 (ProviderSettlementV3 $answer) $changes)))))
         ((ProviderDomainRefusedV2 $why) (ps:refuse $why))
         ($error $error))))
     ($other (ps:refuse registered-dispatch-required)))))
(= (ps:finish-release $points $call $owner $process $transport $answer $changes)
  (case (kb:lookup $points (ProviderClaimKeyV3 $call))
    (((KnowledgePresentV1 (ProviderClaimV3 $scope $who $birth $activity $stage))
      (case (kb:same ($who $birth) ($owner $process))
        (((KnowledgeEqualV1 True)
          (case $stage
            (((ProviderClaimDispatchV3 $physical)
              (case (kb:same $physical $transport)
                (((KnowledgeEqualV1 True)
                  (case (ps:release $points $scope $call $owner $process $activity ProviderClaimCompletedV3)
                    (((ProviderReleaseChangesV3 $released)
                      (ProviderSettlementPlanV3 (ProviderSettlementV3 $answer) (kb:append $changes $released)))
                     ((ProviderSettlementRefusedV3 $why) (ps:refuse $why))
                     ($error $error))))
                 ($other (ps:refuse dispatch-identity-conflict)))))
             ((ProviderClaimEndedV3 ProviderClaimCompletedV3)
              (case $answer
                (((ProviderAlreadyCompletedV2 $status) (ProviderSettlementPlanV3 (ProviderSettlementV3 $answer) $changes))
                 ($other (ps:refuse inconsistent-completion)))))
             ($other (ps:refuse dispatched-claim-required)))))
         ($other (ps:refuse not-owned)))))
     ($other (ps:refuse dispatched-claim-required)))))

(= (ps:plan (ProviderRecoverClaimV3 $call $owner $process $observation $source) $points)
  (case (kb:lookup $points (ProviderClaimKeyV3 $call))
    (((KnowledgePresentV1 (ProviderClaimV3 $scope $who $birth $activity $stage))
      (case (kb:same ($who $birth) ($owner $process))
        (((KnowledgeEqualV1 True)
          (case (ps:recovery-decision $stage $observation)
            ((ProviderKeepClaimV3 (ProviderSettlementPlanV3 (ProviderClaimRetainedV3 $call $stage) ()))
             ($decision (ps:recover-release $points $scope $call $owner $process $activity $stage $decision)))))
         ($other (ps:refuse not-owned)))))
     ($other (ps:refuse claim-required)))))
(= (ps:recover-release $points $scope $call $owner $process $activity $stage $decision)
  (case ((kb:lookup $points (ProviderLeaseKeyV2 $call))
         (kb:lookup $points (ProviderAnswerKeyV2 $call)))
    ((((KnowledgePresentV1 (ProviderLeaseV2 $who ProviderLeaseActiveV2)) KnowledgeAbsentV1)
      (if (== $who $owner)
        (case ($stage $decision)
          (((ProviderClaimReservedV3 ProviderReleaseUnsentV3)
            (case ((kb:lookup $points (ProviderDispatchKeyV3 $call))
                   (kb:lookup $points (ProviderAttemptKeyV2 $call $owner)))
              (((KnowledgeAbsentV1 KnowledgeAbsentV1)
                (ps:recovered-plan $points $scope $call $owner $process $activity
                  ProviderClaimUnsentV3 ProviderLeaseFailedV2 (ProviderClaimReleasedUnsentV3 $call)))
               ($other (ps:refuse inconsistent-dispatch)))))
           (((ProviderClaimDispatchV3 $transport) ProviderPreserveUnknownV3)
            (case (kb:same ((kb:lookup $points (ProviderDispatchKeyV3 $call))
                           (kb:lookup $points (ProviderAttemptKeyV2 $call $owner)))
                          ((KnowledgePresentV1 (ProviderDispatchIntentV3 $call $owner $process $transport))
                           (KnowledgePresentV1 (ProviderSubmittedAttemptV2 $transport))))
              (((KnowledgeEqualV1 True)
                (ps:recovered-plan $points $scope $call $owner $process $activity
                  ProviderClaimUnknownV3 ProviderLeaseUnknownV2 (ProviderClaimRecoveredUnknownV3 $call $transport)))
               ($other (ps:refuse inconsistent-dispatch)))))
           ($other (ps:refuse recovery-decision))))
        (ps:refuse not-owned)))
     ($other (ps:refuse active-unanswered-lease-required)))))
(= (ps:recovered-plan $points $scope $call $owner $process $activity $outcome $phase $answer)
  (case (ps:release $points $scope $call $owner $process $activity $outcome)
    (((ProviderReleaseChangesV3 $changes)
      (ProviderSettlementPlanV3 $answer
        (cons-atom (KnowledgePutV1 (ProviderLeaseKeyV2 $call) (ProviderLeaseV2 $owner $phase)) $changes)))
     ((ProviderSettlementRefusedV3 $why) (ps:refuse $why))
     ($error $error))))
(= (ps:execute $owner $view $receipt $command $budget)
  (case (kb:receipt $view $receipt $command $budget)
    ((KnowledgeReceiptAbsentV1
      (case (ps:observe $view $command $budget)
        (((KnowledgeObservedV1 $points $reads)
          (case (ps:plan $command $points)
            (((ProviderSettlementPlanV3 $answer $changes)
              (kb:publish $owner $view $reads $receipt $command $answer $changes $budget))
             ($error $error))))
         ($error $error))))
     ($replay-or-error $replay-or-error))))
