; Incremental SSE framing. Chunks and partial lines stay as native strings;
; a complete line/event is joined once, never once per received character.
!(import! &self str)

(= (sse:reverse $items $out)
   (if (== $items ()) $out
     (sse:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out))))
(= (sse:new) (SSEState () 0 "" () 0 False True))
(= (sse:field $line $prefix)
   (let $value (str:byte-slice $line (str:byte-length $prefix) (str:byte-length $line))
     (if (str:starts-with $value " ") (str:byte-slice $value 1 (str:byte-length $value)) $value)))
(= (sse:line $line $event $data $size $out $limit)
   (if (== $line "")
     (SSELine "" () 0
       (if (== $data ()) $out
         (cons-atom (SSEEvent $event (str:join "\n" (sse:reverse $data ()))) $out)))
     (if (str:starts-with $line "data:")
       (let* (($value (sse:field $line "data:"))
              ($next (+ $size (+ 1 (str:byte-length $value)))))
         (if (> $next $limit) (SSEError "event exceeds observation limit")
           (SSELine $event (cons-atom $value $data) $next $out)))
       (if (== $line "data") (SSELine $event (cons-atom "" $data) (+ $size 1) $out)
         (if (str:starts-with $line "event:")
           (SSELine (sse:field $line "event:") $data $size $out)
           (SSELine $event $data $size $out))))))
(= (sse:lines $lines $fragments $bytes $event $data $size $out $limit $cr)
   (let* (($part (car-atom $lines)) ($tail (cdr-atom $lines))
          ($total (+ $bytes (str:byte-length $part)))
          ($pieces (cons-atom $part $fragments)))
     (if (> $total $limit) (SSEError "line exceeds observation limit")
       (if (== $tail ())
         (SSEBatch (SSEState $pieces $total $event $data $size $cr False)
                   (sse:reverse $out ()))
         (let* (($line (str:join "" (sse:reverse $pieces ())))
                ($result (sse:line $line $event $data $size $out $limit)))
           (case $result
             (((SSELine $next-event $next-data $next-size $next-out)
               (sse:lines $tail () 0 $next-event $next-data $next-size $next-out $limit $cr))
              ((SSEError $why) (SSEError $why)))))))))
(= (sse:feed $state $chunk $limit)
   (let (SSEState $fragments $bytes $event $data $size $after-cr $first) $state
     (if (== $chunk "") (SSEBatch $state ())
       (let* (($bomless (if (and $first (str:starts-with $chunk "﻿"))
                          (str:byte-slice $chunk 3 (str:byte-length $chunk)) $chunk))
              ($text (if (and $after-cr (str:starts-with $bomless "\n"))
                       (str:byte-slice $bomless 1 (str:byte-length $bomless)) $bomless))
              ($cr (str:ends-with $bomless "\r"))
              ($lf (str:join "\n" (str:split "\r" (str:join "\n" (str:split "\r\n" $text))))))
         (sse:lines (str:split "\n" $lf) $fragments $bytes $event $data $size () $limit $cr)))))
