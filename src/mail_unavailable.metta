(= (mail:send $to $body) "MAIL_UNAVAILABLE: select the CeTTa engine")
(= (mail:send-id $to $body $id) "MAIL_UNAVAILABLE: select the CeTTa engine")
(= (mail:receive) "")
(= (mail:pending?) False)
(= (mail:active?) False)
(= (mail:ack) 1)
(= (mail:reset) ())
(= (mail:idle-wait $milliseconds) ())
(= (mail:enabled?) False)
(= (mail:empty? $text) (== $text ""))
