; Incremental server-resident conversation index for src/input_ledger.metta.
;
; Maintains a fail-closed, (epoch, store-revision)-certified materialization of
; the conversation's ordered entry tape, intrinsically-open request excerpts,
; and notes. Cold boot builds once from db:snapshot; subsequent turn writes
; apply O(1) deltas and record touched ordinals in a bounded revision ring so
; stateless clients can fetch only tail deltas while retaining byte-exact
; equivalence with input-ledger:conversation-rows-of / conversation-history-of.
;
; Structural entry slots (&cidx-entries, &cidx-by-ref) are kept strictly
; separate from active-window shaped payloads (&cidx-rows) so lazy row caching
; and eviction never mutate or scan the full historical entry tape.
;
; Any version mismatch, unpositioned legacy edge, bulk import, or deep
; out-of-order insertion fails closed by resetting to ConvIdxNone and
; rebuilding cleanly from the durable snapshot.

!(bind! &cidx-meta (new-state ConvIdxNone))
!(bind! &cidx-gen (new-state none))
!(bind! &cidx-entries (new-space))
!(bind! &cidx-rows (new-space))
!(bind! &cidx-by-ref (new-space))
!(bind! &cidx-props (new-space))
!(bind! &cidx-legacy (new-space))
!(bind! &cidx-excerpts (new-space))
!(bind! &cidx-open (new-space))
!(bind! &cidx-open-cache (new-state ConvOpenNone))
!(bind! &cidx-notes (new-state ()))
!(bind! &cidx-rev-log (new-state ()))
!(bind! &cidx-arrivals (new-space))
!(bind! &cidx-covered (new-space))
!(bind! &cidx-builds (new-state 0))
!(bind! &cidx-deltas (new-state 0))

(= (cidx:clear-space $space)
   (let $done (collapse (match $space $atom (remove-atom $space $atom))) True))

(= (cidx:reset)
   (let* (($r1 (change-state! &cidx-meta ConvIdxNone))
          ($rg (change-state! &cidx-gen none))
          ($r2 (cidx:clear-space &cidx-entries))
          ($r3 (cidx:clear-space &cidx-rows))
          ($r4 (cidx:clear-space &cidx-by-ref))
          ($r5 (cidx:clear-space &cidx-props))
          ($rl (cidx:clear-space &cidx-legacy))
          ($r6 (cidx:clear-space &cidx-excerpts))
          ($r7 (cidx:clear-space &cidx-open))
          ($r8 (change-state! &cidx-open-cache ConvOpenNone))
          ($r9 (change-state! &cidx-notes ()))
          ($r10 (change-state! &cidx-rev-log ())))
     True))

(= (cidx:stats)
   (let* (($meta (get-state &cidx-meta))
          ($builds (get-state &cidx-builds))
          ($deltas (get-state &cidx-deltas)))
     (conv-index-stats $builds $deltas $meta)))

; ---- Reference keys and exact sort-atom ordering ----

(= (cidx:ref-key (input $id)) (str:concat "i:" $id))
(= (cidx:ref-key (call $serial $index)) (str:join ":" ("c" (repr $serial) (repr $index))))
(= (cidx:ref-key (legacy $serial $index)) (str:join ":" ("l" (repr $serial) (repr $index))))

(= (cidx:key< ($o1 $c1 $s1 $r1) ($o2 $c2 $s2 $r2))
   (if (!= $o1 $o2) (< $o1 $o2)
     (if (!= $c1 $c2) (< $c1 $c2)
       (if (!= $s1 $s2) (< $s1 $s2)
         (let* (($k1 ($o1 $c1 $s1 $r1)) ($k2 ($o2 $c2 $s2 $r2)))
           (if (== $k1 $k2) False (== (car-atom (sort-atom ($k1 $k2))) $k1)))))))

; ---- Fast single-pass cold build ----

(= (cidx:load-arrivals $view)
   (let* (($clr (cidx:clear-space &cidx-arrivals))
          ($rows (collapse (match $view (ledger:arrival $id $p) ($id $p))))
          ($ins (cidx:store-arrivals $rows)))
     True))

(= (cidx:store-arrivals $rows)
   (if (== $rows ()) True
     (let* ((($head $tail) (decons-atom $rows))
            (($id $p) $head)
            ($a (add-atom &cidx-arrivals (CidxArr $id $p))))
       (cidx:store-arrivals $tail))))

(= (cidx:arrival-fast $id)
   (case (collapse (match &cidx-arrivals (CidxArr $id $p) $p))
     ((($p) $p) ($other 0))))

(= (cidx:load-covered $view)
   (let* (($clr (cidx:clear-space &cidx-covered))
          ($rows (collapse (match $view (ledger:covered $id $cov) ($id $cov))))
          ($ins (cidx:store-covered $rows)))
     True))

(= (cidx:store-covered $rows)
   (if (== $rows ()) True
     (let* ((($head $tail) (decons-atom $rows))
            (($id $cov) $head)
            ($a (add-atom &cidx-covered (CidxCov $id $cov))))
       (cidx:store-covered $tail))))

(= (cidx:excerpt-fast $view $id)
   (let $content
     (case (collapse (match &cidx-covered (CidxCov $id $cov) $cov))
       ((($covering) (str:join "" ("[input batch covered by " $covering "; original source via request-read " $id "]")))
        ($other (input-ledger:text-one $view $id))))
     (str:char-slice $content 0 160)))

(= (cidx:input-key-fast (request $id $seq $k $c $st $p $n $sm $dg))
   ((cidx:arrival-fast $id) 0 $seq (input $id)))

(= (cidx:excerpt-of $view $id)
   (let* (($content (input-ledger:view-content $view $id (input-ledger:text-one $view $id)))
          ($ex (str:char-slice $content 0 160)))
     $ex))

(= (cidx:put-excerpt $id $ex)
   (let* (($rm (collapse (match &cidx-excerpts (CidxEx $id $old) (remove-atom &cidx-excerpts (CidxEx $id $old)))))
          ($add (add-atom &cidx-excerpts (CidxEx $id $ex))))
     $ex))

(= (cidx:get-or-load-excerpt $view $id)
   (case (collapse (match &cidx-excerpts (CidxEx $id $ex) $ex))
     ((($ex) $ex)
      ($miss (cidx:put-excerpt $id (cidx:excerpt-of $view $id))))))

(= (cidx:intrinsically-open? (request $id $q $k $c $st $p $n $sm $dg))
   (or (input-ledger:member $st ("active" "waiting-user" "deferred"))
       (and (== $st "processed") (or (== $k "message") (== $k "notification")))))

(= (cidx:store-open-heads $view $heads)
   (if (== $heads ()) True
     (let* ((($head $tail) (decons-atom $heads))
            ((request $id $seq $k $c $st $p $n $sm $dg) $head)
            ($keep (if (cidx:intrinsically-open? $head)
                     (let* (($ex (cidx:excerpt-fast $view $id))
                            ($a1 (add-atom &cidx-excerpts (CidxEx $id $ex)))
                            ($a2 (add-atom &cidx-open (CidxOpen $id $seq $st $k $n $ex))))
                       True)
                     True)))
       (cidx:store-open-heads $view $tail))))

(= (cidx:store-props $proposals $has-unpos)
   (if (== $proposals ()) $has-unpos
     (let* ((($head $tail) (decons-atom $proposals))
            (($serial $pos $count) $head)
            ($skey (repr $serial))
            ($a (add-atom &cidx-props (CidxProp $skey)))
            ($next-unpos (or $has-unpos (== $pos none))))
       (cidx:store-props $tail $next-unpos))))

(= (cidx:legacy-keys-checked $view $actions $clock $out $has-unpos)
   (if (== $actions ()) ($out $has-unpos)
     (let* ((($action $rest) (decons-atom $actions))
            (($serial $ticket $command) $action)
            ($al (add-atom &cidx-legacy (CidxLeg (repr $serial))))
            ($count (size-atom (input-ledger:legacy-commands $command)))
            ($positions (input-ledger:attempts-of-ticket $view $ticket))
            ($pos (input-ledger:turn-position $view $serial))
            ($ordering (input-ledger:ordering $pos $serial $clock))
            ($more (foldl-atom $positions $out $acc $attempt
                     (input-ledger:legacy-key $ordering $serial $count $attempt $acc)))
            ($next-unpos (or $has-unpos (== $pos none))))
       (cidx:legacy-keys-checked $view $rest $clock $more $next-unpos))))

(= (cidx:store-entries $keys $ord)
   (if (== $keys ()) $ord
     (let* ((($key $tail) (decons-atom $keys))
            (($o $c $s $ref) $key)
            ($ostr (repr $ord))
            ($rkey (cidx:ref-key $ref))
            ($a1 (add-atom &cidx-entries (CidxEntry $ostr $ord $key $ref)))
            ($a2 (add-atom &cidx-by-ref (CidxByRef $rkey $ord)))
            ($next (+ $ord 1)))
       (cidx:store-entries $tail $next))))

(= (cidx:build $view $epoch $store-rev)
   (let* (($clr (cidx:reset))
          ($owner (input-ledger:state-of $view "owner"))
          ($clock (input-ledger:state-of $view "clock"))
          ($arr (cidx:load-arrivals $view))
          ($cov (cidx:load-covered $view))
          ($all-heads (input-ledger:all-heads $view))
          ($open-loaded (cidx:store-open-heads $view $all-heads))
          ($clr-cov (cidx:clear-space &cidx-covered))
          ($raw-notes (collapse (match $view (ledger:note $r $s $t $src) ($r $s $t $src))))
          ($sorted-notes (input-ledger:note-rows $raw-notes))
          ($sn (change-state! &cidx-notes $sorted-notes))
          ($inputs (map-atom $all-heads $h (cidx:input-key-fast $h)))
          ($clr-arr (cidx:clear-space &cidx-arrivals))
          ($proposals (collapse (match $view (ledger:proposal $k $s $r $c $d $p $n) ($s $p $n))))
          ($unpos-prop (cidx:store-props $proposals False))
          ($serials (sort-atom (map-atom $proposals $prop (input-ledger:first-of-three $prop))))
          ($actions (sort-atom (collapse (match $view (ledger:action $t $r $s $tool $c $st $o $rc) ($s $t $c)))))
          ($calls (input-ledger:proposal-keys $proposals (after $clock) $inputs))
          ($unprop (input-ledger:unproposed $actions $serials ()))
          (($all-keys $unpos-leg) (cidx:legacy-keys-checked $view $unprop $clock $calls False))
          ($sorted-keys (sort-atom $all-keys))
          ($total (cidx:store-entries $sorted-keys 0))
          ($has-unpos (or $unpos-prop $unpos-leg))
          ($bcount (+ (get-state &cidx-builds) 1))
          ($sb (change-state! &cidx-builds $bcount))
          ($gen (str:join ":" ($epoch (system:uuid4-hex))))
          ($sg (change-state! &cidx-gen $gen))
          ($sl (change-state! &cidx-rev-log ((CidxTouch 1 0))))
          ($sm (change-state! &cidx-meta (ConvIdxV1 $epoch $store-rev $owner $total $has-unpos 1 1 1 $total))))
     True))

(= (cidx:ensure $db)
   (case (input-ledger:store-version $db)
     ((($epoch $rev)
       (case (get-state &cidx-meta)
         (((ConvIdxV1 $ce $cr $co $ct $cu $crr $cnr $cer $cmc)
           (if (and (== $ce $epoch) (== $cr $rev)) True
             (cidx:rebuild $db $epoch $rev)))
          ($none (cidx:rebuild $db $epoch $rev)))))
      ($err (Error cidx:ensure unavailable)))))

(= (cidx:rebuild $db $epoch $rev)
   (case (db:snapshot $db inputs)
     (((Error $where $why) (Error $where $why))
      ($view (let* (($ok (cidx:build $view $epoch $rev))
                    ($cls (db:close $view)))
               $ok)))))

; ---- Revision touch log (bounded 64-entry ring) ----

(= (cidx:log-touch $entry-rev $ord)
   (let* (($cur (get-state &cidx-rev-log))
          ($next (list:take 64 (cons-atom (CidxTouch $entry-rev $ord) $cur)))
          ($set (change-state! &cidx-rev-log $next)))
     True))

(= (cidx:min-touched-since $log $known-rev $best)
   (if (== $log ()) none
     (let* ((($head $tail) (decons-atom $log))
            ((CidxTouch $rev $ord) $head))
       (if (<= $rev $known-rev) (found $best)
         (let $next-best (if (< $ord $best) $ord $best)
           (cidx:min-touched-since $tail $known-rev $next-best))))))

; ---- Entry access, window row cache & bounded tail-insertion ----

(= (cidx:entry-at $ord)
   (let $ostr (repr $ord)
     (case (collapse (match &cidx-entries (CidxEntry $ostr $o $k $r) (CidxEntry $ostr $o $k $r)))
       ((($e) $e) ($other none)))))

(= (cidx:row-at $ostr)
   (case (collapse (match &cidx-rows (CidxRow $ostr $lim $row) (CidxRow $ostr $lim $row)))
     ((($r) $r) ($other none))))

(= (cidx:drop-row $ostr)
   (let $rm (collapse (match &cidx-rows (CidxRow $ostr $lim $row)
                        (remove-atom &cidx-rows (CidxRow $ostr $lim $row))))
     True))

(= (cidx:put-entry-fresh $ord $key $ref)
   (let* (($ostr (repr $ord))
          ($rkey (cidx:ref-key $ref))
          ($a1 (add-atom &cidx-entries (CidxEntry $ostr $ord $key $ref)))
          ($a2 (add-atom &cidx-by-ref (CidxByRef $rkey $ord))))
     True))

(= (cidx:put-entry $ord $key $ref)
   (let* (($ostr (repr $ord))
          ($rm1 (collapse (match &cidx-entries (CidxEntry $ostr $o $k $r)
                            (remove-atom &cidx-entries (CidxEntry $ostr $o $k $r)))))
          ($rkey (cidx:ref-key $ref))
          ($rm2 (collapse (match &cidx-by-ref (CidxByRef $rkey $old-ord)
                            (remove-atom &cidx-by-ref (CidxByRef $rkey $old-ord)))))
          ($a1 (add-atom &cidx-entries (CidxEntry $ostr $ord $key $ref)))
          ($a2 (add-atom &cidx-by-ref (CidxByRef $rkey $ord))))
     True))

(= (cidx:invalidate-entry-at $ord)
   (cidx:drop-row (repr $ord)))

(= (cidx:evict-below $from $until)
   (if (>= $from $until) True
     (let* (($inv (cidx:drop-row (repr $from)))
            ($next (+ $from 1)))
       (cidx:evict-below $next $until))))

; Shift entries [pos..end-1] up by 1 slot into [pos+1..end], moving from end-1 down to pos.
(= (cidx:shift-up $cur $pos)
   (if (< $cur $pos) True
     (case (cidx:entry-at $cur)
       (((CidxEntry $ostr $o $key $ref)
         (let* (($dst (+ $cur 1))
                ($dstr (repr $dst))
                ($cached (cidx:row-at $ostr))
                ($rm-src (cidx:drop-row $ostr))
                ($rm-dst (cidx:drop-row $dstr))
                ($put (cidx:put-entry $dst $key $ref))
                ($mv-row (case $cached
                           (((CidxRow $_ $lim $row) (add-atom &cidx-rows (CidxRow $dstr $lim $row)))
                            ($none True))))
                ($prev (- $cur 1)))
           (cidx:shift-up $prev $pos)))
        ($none False)))))

; Find sorted insertion position within the last 64 entries; returns position or -1 if deeper than 64.
(= (cidx:find-insert-pos $new-key $idx $floor)
   (if (<= $idx 0) 0
     (let $prev (- $idx 1)
       (if (< $prev $floor) -1
         (case (cidx:entry-at $prev)
           (((CidxEntry $ostr $o $k $r)
             (if (cidx:key< $new-key $k)
               (cidx:find-insert-pos $new-key $prev $floor)
               $idx))
            ($none -1)))))))

; Insert one new key into the sorted tail (at most 64 slots back).
; Returns (ok $inserted-ord) or deep-miss.
(= (cidx:insert-key $new-key $total)
   (let* (($floor (max 0 (- $total 64)))
          ($pos (cidx:find-insert-pos $new-key $total $floor)))
     (if (< $pos 0) deep-miss
       (let* ((($o $c $s $ref) $new-key)
              ($done (if (== $pos $total)
                       (cidx:put-entry-fresh $pos $new-key $ref)
                       (let* (($shifted (cidx:shift-up (- $total 1) $pos))
                              ($clr (cidx:drop-row (repr $pos)))
                              ($put (cidx:put-entry $pos $new-key $ref)))
                         True))))
         (ok $pos)))))

(= (cidx:insert-keys $keys $total $min-ord)
   (if (== $keys ()) (ok $total $min-ord)
     (let* ((($head $tail) (decons-atom $keys)))
       (case (cidx:insert-key $head $total)
         (((ok $pos)
           (let* (($next-total (+ $total 1))
                  ($next-min (if (< $pos $min-ord) $pos $min-ord)))
             (cidx:insert-keys $tail $next-total $next-min)))
          ($fail deep-miss))))))

; ---- Incremental open-request & note helpers ----

(= (cidx:open-remove $id)
   (let $rm (collapse (match &cidx-open (CidxOpen $id $seq $st $k $n $ex)
                        (remove-atom &cidx-open (CidxOpen $id $seq $st $k $n $ex))))
     True))

(= (cidx:refresh-request $view $id $reload-excerpt)
   (let* (($rm (cidx:open-remove $id))
          ($inv (change-state! &cidx-open-cache ConvOpenNone))
          ($heads (input-ledger:heads $view $id)))
     (case $heads
       ((((request $rid $seq $k $c $st $p $n $sm $dg))
         (let* (($ex (if $reload-excerpt
                       (cidx:put-excerpt $rid (cidx:excerpt-of $view $rid))
                       (cidx:get-or-load-excerpt $view $rid)))
                ($add (if (cidx:intrinsically-open? (request $rid $seq $k $c $st $p $n $sm $dg))
                        (add-atom &cidx-open (CidxOpen $rid $seq $st $k $n $ex))
                        True)))
           True))
        ($none True)))))

(= (cidx:open-key (CidxOpen $id $seq $st $k $n $ex)) $seq)
(= (cidx:open-to-row (CidxOpen $id $seq $st $k $n $ex)) ($id $st $k $n $ex))
(= (cidx:open-to-id (CidxOpen $id $seq $st $k $n $ex)) $id)

(= (cidx:open-snapshot)
   (case (get-state &cidx-open-cache)
     (((ConvOpenCacheV1 $sorted $rows $ids) (ConvOpenCacheV1 $sorted $rows $ids))
      ($none
       (let* (($all (collapse (match &cidx-open (CidxOpen $id $seq $st $k $n $ex)
                                (CidxOpen $id $seq $st $k $n $ex))))
              ($sorted (input-ledger:sorted-by cidx:open-key $all))
              ($rows (map-atom $sorted $x (cidx:open-to-row $x)))
              ($ids (map-atom $sorted $x (cidx:open-to-id $x)))
              ($val (ConvOpenCacheV1 $sorted $rows $ids))
              ($set (change-state! &cidx-open-cache $val)))
         $val)))))

(= (cidx:insert-open-sorted $entries $item)
   (if (== $entries ()) ($item)
     (let* ((($head $tail) (decons-atom $entries))
            ((CidxOpen $h-id $h-seq $h-st $h-k $h-n $h-ex) $head)
            ((CidxOpen $i-id $i-seq $i-st $i-k $i-n $i-ex) $item))
       (if (< $i-seq $h-seq)
         (cons-atom $item $entries)
         (cons-atom $head (cidx:insert-open-sorted $tail $item))))))

(= (cidx:open-for-focus $view $focus)
   (let (ConvOpenCacheV1 $sorted $rows $ids) (cidx:open-snapshot)
     (let $has-focus (not (== (collapse (match &cidx-open (CidxOpen $focus $s $st $k $n $ex) True)) ()))
       (if $has-focus ($rows $ids)
         (case (input-ledger:heads $view $focus)
           ((((request $rid $seq $k $c $st $p $n $sm $dg))
             (let* (($ex (cidx:get-or-load-excerpt $view $rid))
                    ($extra (CidxOpen $rid $seq $st $k $n $ex))
                    ($merged (cidx:insert-open-sorted $sorted $extra))
                    ($mrows (map-atom $merged $x (cidx:open-to-row $x)))
                    ($mids (map-atom $merged $x (cidx:open-to-id $x))))
               ($mrows $mids)))
            ($none ($rows $ids))))))))

(= (cidx:filter-notes-for $notes $focus)
   (if (== $notes ()) ()
     (let* ((($head $tail) (decons-atom $notes))
            (($seq $req $text $src) $head)
            ($keep (or (== $req $focus)
                       (not (== (collapse (match &cidx-open (CidxOpen $req $s $st $k $n $ex) True)) ()))))
            ($rest (cidx:filter-notes-for $tail $focus)))
       (if $keep (cons-atom $head $rest) $rest))))

; ---- Row materialization (lazy per-ordinal caching in small &cidx-rows space) ----

(= (cidx:row-for-ref $view $ref $limit $owner $cache)
   (case $ref
     (((input $id)
       ((input-ledger:shaped-row (input-ledger:input-row $view $id $limit) $limit) $cache))
      (($tag $serial $index)
       (let* (($parts (case $cache
                        (((parts $ctag $cserial $r $i $t $a $d)
                          (if (and (== $ctag $tag) (== $cserial $serial)) $cache
                            (input-ledger:call-parts $view $tag $serial $owner)))
                         ($other (input-ledger:call-parts $view $tag $serial $owner)))))
              ($raw (input-ledger:call-row $parts $index))
              ($shaped (input-ledger:shaped-row $raw $limit)))
         ($shaped $parts))))))

(= (cidx:collect-window $view $ord $end $limit $owner $cache $out)
   (if (>= $ord $end) (list:reverse $out)
     (let $ostr (repr $ord)
       (case (cidx:row-at $ostr)
         (((CidxRow $_r $clim $crow)
           (if (== $clim $limit)
             (let $next (+ $ord 1)
               (cidx:collect-window $view $next $end $limit $owner $cache (cons-atom $crow $out)))
             (case (cidx:entry-at $ord)
               (((CidxEntry $_e $o $key $ref)
                 (let* ((($shaped $next-cache) (cidx:row-for-ref $view $ref $limit $owner $cache))
                        ($rm (cidx:drop-row $ostr))
                        ($save (add-atom &cidx-rows (CidxRow $ostr $limit $shaped)))
                        ($next (+ $ord 1)))
                   (cidx:collect-window $view $next $end $limit $owner $next-cache (cons-atom $shaped $out))))
                ($none (list:reverse $out))))))
          ($miss
           (case (cidx:entry-at $ord)
             (((CidxEntry $_m $o $key $ref)
               (let* ((($shaped $next-cache) (cidx:row-for-ref $view $ref $limit $owner $cache))
                      ($save (add-atom &cidx-rows (CidxRow $ostr $limit $shaped)))
                      ($next (+ $ord 1)))
                 (cidx:collect-window $view $next $end $limit $owner $next-cache (cons-atom $shaped $out))))
              ($none (list:reverse $out))))))))))

(= (cidx:collect-history $view $ord $end $owner $cache $out)
   (if (>= $ord $end) (list:reverse $out)
     (case (cidx:entry-at $ord)
       (((CidxEntry $ostr $o $key $ref)
         (let* ((($shaped $next-cache) (cidx:row-for-ref $view $ref -1 $owner $cache))
                ($disp (input-ledger:shaped-row $shaped dispositions))
                ($next (+ $ord 1)))
           (cidx:collect-history $view $next $end $owner $next-cache (cons-atom $disp $out))))
        ($none (list:reverse $out))))))

; ---- Public read entry points ----

(= (cidx:conversation-rows $db $focus $offset $limit)
   (if (<= $limit 0)
     (input-ledger:task-read $db input-ledger:conversation-rows
       (|-> ($view) (input-ledger:conversation-rows-of $view $focus $offset $limit)))
     (case (cidx:ensure $db)
       (((Error $w $r) (Error $w $r))
        (True
         (case (get-state &cidx-meta)
           (((ConvIdxV1 $epoch $rev $owner $total $unpos $rrev $nrev $erev $min-c)
             (case (db:snapshot $db inputs)
               (((Error $w $r) (Error $w $r))
                ($view
                 (let* (($start (max 0 $offset))
                        ($evict (if (and (< $min-c $start) (< $min-c $total))
                                  (cidx:evict-below $min-c (min $start $total))
                                  True))
                        ($new-min (if (< $start $min-c) $start (min $start $total)))
                        ($um (if (!= $new-min $min-c)
                               (change-state! &cidx-meta (ConvIdxV1 $epoch $rev $owner $total $unpos $rrev $nrev $erev $new-min))
                               True))
                        (($requests $ids) (cidx:open-for-focus $view $focus))
                        ($notes (cidx:filter-notes-for (get-state &cidx-notes) $focus))
                        ($pairs (if (>= $start $total) () (cidx:collect-window $view $start $total $limit $owner none ())))
                        ($cls (db:close $view)))
                   (conversation-rows $requests $notes $pairs))))))
            ($none (Error cidx:conversation-rows missing-index)))))))))

(= (cidx:conversation-history $db $offset $count)
   (case (cidx:ensure $db)
     (((Error $w $r) (Error $w $r))
      (True
       (case (get-state &cidx-meta)
         (((ConvIdxV1 $epoch $rev $owner $total $unpos $rrev $nrev $erev $min-c)
           (case (db:snapshot $db inputs)
             (((Error $w $r) (Error $w $r))
              ($view
               (let* (($start (max 0 $offset))
                      ($end (if (<= $count 0) $total (min $total (+ $start $count))))
                      ($rows (if (>= $start $end) () (cidx:collect-history $view $start $end $owner none ())))
                      ($cls (db:close $view)))
                 (history $total $rows))))))
          ($none (Error cidx:conversation-history missing-index))))))))

; Stateless fail-closed delta verb for warm clients.
; Flat pageable record so input-ledger:page-of / ledger-client:merge slice the
; three top-level list fields ($reqs, $notes, $rows) automatically on cold seeds
; while warm deltas carry only new tail rows in a single unpaged round-trip.
; Args: ($focus $offset $limit $k-epoch $k-rrev $k-nrev $k-erev $k-total $k-focus)
; Reply: (conversation-delta $epoch $rrev $nrev $erev $total $req-mode $note-mode $entry-mode $from-rel $reqs $notes $rows)
(= (cidx:conversation-delta $db $focus $offset $limit $k-epoch $k-rrev $k-nrev $k-erev $k-total $k-focus)
   (if (<= $limit 0)
     (case (cidx:conversation-rows $db $focus $offset $limit)
       (((conversation-rows $reqs $notes $pairs)
         (conversation-delta none 0 0 0 (size-atom $pairs) full full full 0 $reqs $notes $pairs))
        ($err $err)))
     (case (cidx:ensure $db)
       (((Error $w $r) (Error $w $r))
        (True
         (case (get-state &cidx-meta)
           (((ConvIdxV1 $epoch $rev $owner $total $unpos $rrev $nrev $erev $min-c)
             (case (db:snapshot $db inputs)
               (((Error $w $r) (Error $w $r))
                ($view
                 (let* (($start (max 0 $offset))
                        ($evict (if (and (< $min-c $start) (< $min-c $total))
                                  (cidx:evict-below $min-c (min $start $total))
                                  True))
                        ($new-min (if (< $start $min-c) $start (min $start $total)))
                        ($um (if (!= $new-min $min-c)
                               (change-state! &cidx-meta (ConvIdxV1 $epoch $rev $owner $total $unpos $rrev $nrev $erev $new-min))
                               True))
                        ($gen (get-state &cidx-gen))
                        ($same-epoch (and (!= $gen none) (== $k-epoch $gen)))
                        ($same-focus (== $k-focus $focus))
                        ($req-same (and $same-epoch (and $same-focus (== $k-rrev $rrev))))
                        ($note-same (and $req-same (== $k-nrev $nrev)))
                        ($req-mode (if $req-same unchanged full))
                        ($reqs (if $req-same ()
                                 (let ($requests $ids) (cidx:open-for-focus $view $focus) $requests)))
                        ($note-mode (if $note-same unchanged full))
                        ($notes (if $note-same ()
                                  (cidx:filter-notes-for (get-state &cidx-notes) $focus)))
                        (($entry-mode $from-rel $rows)
                         (if (and $same-epoch (and (<= $start $k-total) (<= $k-total $total)))
                           (if (and (== $k-erev $erev) (== $k-total $total))
                             (tail (- $k-total $start) ())
                             (case (cidx:min-touched-since (get-state &cidx-rev-log) $k-erev $total)
                               (((found $min-ord)
                                 (let* (($from-ord (max $start (min $min-ord $k-total)))
                                        ($rel (- $from-ord $start))
                                        ($tail-rows (if (>= $from-ord $total) ()
                                                      (cidx:collect-window $view $from-ord $total $limit $owner none ()))))
                                   (tail $rel $tail-rows)))
                                ($miss
                                 (full 0 (if (>= $start $total) ()
                                           (cidx:collect-window $view $start $total $limit $owner none ())))))))
                           (full 0 (if (>= $start $total) ()
                                     (cidx:collect-window $view $start $total $limit $owner none ())))))
                        ($cls (db:close $view)))
                   (conversation-delta $gen $rrev $nrev $erev $total $req-mode $note-mode $entry-mode $from-rel $reqs $notes $rows))))))
            ($none (Error cidx:conversation-delta missing-index)))))))))

; ---- Incremental O(1) write maintenance ----

(= (cidx:bump-delta)
   (let $n (+ (get-state &cidx-deltas) 1) (change-state! &cidx-deltas $n)))

(= (cidx:disjoint-verb? $verb)
   (input-ledger:member $verb
     ("mark-processed" "register" "submitted" "receipt"
      "notice-withdraw" "notice-delivery" "notice-cleanup-key" "check"
      "topic-select" "topic-note" "provider-notice-reserve" "provider-notice-queued"
      "control" "restore" "report" "observe" "attest" "meta-cas" "meta-put")))

(= (cidx:llm-verb? $verb) (str:starts-with $verb "llm-"))

(= (cidx:parse-ticket-serial $ticket)
   (let* (($parts (str:split ":" $ticket)) ($n (size-atom $parts)))
     (if (< $n 2) none
       (let $num (str:string->number (index-atom $parts (- $n 1)))
         (if (== (get-type $num) Number) $num none)))))

(= (cidx:refresh-covered $view $olds $min-ord)
   (if (== $olds ()) $min-ord
     (let* ((($old $rest) (decons-atom $olds))
            ($r1 (cidx:refresh-request $view $old True))
            ($rkey (cidx:ref-key (input $old)))
            ($next-min (case (collapse (match &cidx-by-ref (CidxByRef $rkey $ord) $ord))
                         ((($ord) (let $inv (cidx:invalidate-entry-at $ord) (if (< $ord $min-ord) $ord $min-ord)))
                          ($miss $min-ord)))))
       (cidx:refresh-covered $view $rest $next-min))))

(= (cidx:invalidate-proposal-entries $serial $pos $count $min-ord)
   (if (>= $pos $count) $min-ord
     (let* (($rkey (cidx:ref-key (call $serial $pos)))
            ($next-min (case (collapse (match &cidx-by-ref (CidxByRef $rkey $ord) $ord))
                         ((($ord) (let $inv (cidx:invalidate-entry-at $ord) (if (< $ord $min-ord) $ord $min-ord)))
                          ($miss $min-ord))))
            ($next (+ $pos 1)))
       (cidx:invalidate-proposal-entries $serial $next $count $next-min))))

(= (cidx:note-present? $notes $seq)
   (if (== $notes ()) False
     (let* ((($head $tail) (decons-atom $notes)) (($s $r $t $src) $head))
       (if (== $s $seq) True (cidx:note-present? $tail $seq)))))

(= (cidx:insert-note-sorted $notes $item)
   (if (== $notes ()) ($item)
     (let* ((($head $tail) (decons-atom $notes))
            (($hs $hr $ht $hsrc) $head)
            (($is $ir $it $isrc) $item))
       (if (< $is $hs) (cons-atom $item $notes)
         (cons-atom $head (cidx:insert-note-sorted $tail $item))))))

(= (cidx:merge-notes $cur $incoming)
   (if (== $incoming ()) $cur
     (let* ((($head $tail) (decons-atom $incoming))
            (($seq $req $text $src) $head)
            ($next (if (cidx:note-present? $cur $seq) $cur (cidx:insert-note-sorted $cur $head))))
       (cidx:merge-notes $next $tail))))

(= (cidx:apply-delta $db $verb $arguments $answer $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)
   (if (or (cidx:disjoint-verb? $verb) (cidx:llm-verb? $verb))
     (let* (($s (change-state! &cidx-meta (ConvIdxV1 $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
            ($d (cidx:bump-delta)))
       True)
     (case ($verb $arguments)
       ((("owner" $_)
         (if (== $owner $answer)
           (let* (($s (change-state! &cidx-meta (ConvIdxV1 $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
                  ($d (cidx:bump-delta)))
             True)
           (cidx:reset)))
        (("capture" $_)
         (if (or $unpos (== $owner absent)) (cidx:reset)
           (let* (($s (change-state! &cidx-meta (ConvIdxV1 $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
                  ($d (cidx:bump-delta)))
             True)))
        (("checkpoint" ($working $ids $request $now $req-id))
         (if (== $request "")
           (let* (($s (change-state! &cidx-meta (ConvIdxV1 $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
                  ($d (cidx:bump-delta)))
             True)
           (cidx:delta-request-status $db $request $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
        (("request-settle" ($id $now $req-id))
         (cidx:delta-request-status $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("request-disposition" ($id $disp $note $req-id))
         (cidx:delta-request-status $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("request-cancel" ($id $req-id))
         (cidx:delta-request-status $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("request-finish" ($id $req-id))
         (cidx:delta-request-status $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("request-answered" ($id $req-id))
         (cidx:delta-request-status $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("finish" ($id $ticket $req-id))
         (cidx:delta-request-status $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("request-accept" ($id $content $checker $kind $summary $digest $req-id))
         (if $unpos (cidx:reset)
           (cidx:delta-request-accept $db $id $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
        (("link-inputs" ($request $inputs $req-id))
         (if $unpos (cidx:reset)
           (cidx:delta-cover $db $request $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
        (("task-begin" ($request $trigger $prev $chat $parent $req-id))
         (cidx:delta-cover $db $request $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("task-focus" ($request $req-id))
         (let* (($s (change-state! &cidx-meta (ConvIdxV1 $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
                ($d (cidx:bump-delta)))
           True))
        (("task-note" ($request $text $sources $req-id))
         (cidx:delta-task-note $db $request $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("task-proposal" ($serial $request $commands $disposition $req-id))
         (cidx:delta-task-proposal $db $serial $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("decide" ($serial $kind $tool $command $req-id))
         (let $skey (repr $serial)
           (if (or (!= $kind "command")
                   (not (== (collapse (match &cidx-props (CidxProp $skey) True)) ())))
             (let* (($s (change-state! &cidx-meta (ConvIdxV1 $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c)))
                    ($d (cidx:bump-delta)))
               True)
             (cidx:reset))))
        (("attempt-begin" ($ticket $pos $cmd $req-id))
         (cidx:delta-attempt $ticket $pos $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        (("attempt-result" ($ticket $pos $cmd $result $req-id))
         (cidx:delta-attempt $ticket $pos $after-epoch $after-rev $owner $total $unpos $rrev $nrev $erev $min-c))
        ($other (cidx:reset))))))

(= (cidx:delta-request-status $db $id $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
   (case (db:snapshot $db inputs)
     (((Error $w $r) (cidx:reset))
      ($view
       (let* (($ref (cidx:refresh-request $view $id False))
              ($cls (db:close $view))
              ($nr (+ $rrev 1))
              ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $nr $nrev $erev $min-c)))
              ($d (cidx:bump-delta)))
         True)))))

(= (cidx:delta-request-accept $db $id $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
   (case (db:snapshot $db inputs)
     (((Error $w $r) (cidx:reset))
      ($view
       (case (input-ledger:heads $view $id)
         ((((request $rid $seq $k $c $st $p $n $sm $dg))
           (let* (($arr (input-ledger:arrival-of-id $view $rid))
                  ($rkey (cidx:ref-key (input $rid)))
                  ($exists (not (== (collapse (match &cidx-by-ref (CidxByRef $rkey $o) $o)) ())))
                  ($ref (cidx:refresh-request $view $rid True))
                  ($cls (db:close $view)))
             (if $exists
               (let* (($nr (+ $rrev 1))
                      ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $nr $nrev $erev $min-c)))
                      ($d (cidx:bump-delta)))
                 True)
               (let $new-key ($arr 0 $seq (input $rid))
                 (case (cidx:insert-key $new-key $total)
                   (((ok $pos)
                     (let* (($nt (+ $total 1))
                            ($nr (+ $rrev 1))
                            ($ne (+ $erev 1))
                            ($lt (cidx:log-touch $ne $pos))
                            ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $nt $unpos $nr $nrev $ne $min-c)))
                            ($d (cidx:bump-delta)))
                       True))
                    ($miss (cidx:reset))))))))
          ($none (let $cls (db:close $view) (cidx:reset)))))))))

(= (cidx:delta-cover $db $request $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
   (case (db:snapshot $db inputs)
     (((Error $w $r) (cidx:reset))
      ($view
       (let* (($olds (collapse (match $view (ledger:covers $request $old) $old))))
         (if (== $olds ())
           (let* (($cls (db:close $view))
                  ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)))
                  ($d (cidx:bump-delta)))
             True)
           (let* (($min-ord (cidx:refresh-covered $view $olds $total))
                  ($cls (db:close $view))
                  ($nr (+ $rrev 1))
                  ($ne (if (< $min-ord $total) (+ $erev 1) $erev))
                  ($lt (if (< $min-ord $total) (cidx:log-touch $ne $min-ord) True))
                  ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $nr $nrev $ne $min-c)))
                  ($d (cidx:bump-delta)))
             True)))))))

(= (cidx:delta-task-note $db $request $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
   (case (db:snapshot $db inputs)
     (((Error $w $r) (cidx:reset))
      ($view
       (let* (($req-notes (input-ledger:note-rows (collapse (input-ledger:notes-of $view $request))))
              ($cls (db:close $view))
              ($merged (cidx:merge-notes (get-state &cidx-notes) $req-notes))
              ($sn (change-state! &cidx-notes $merged))
              ($nn (+ $nrev 1))
              ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $rrev $nn $erev $min-c)))
              ($d (cidx:bump-delta)))
         True)))))

(= (cidx:delta-task-proposal $db $serial $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
   (case (db:snapshot $db inputs)
     (((Error $w $r) (cidx:reset))
      ($view
       (let* (($pkey (input-ledger:key $serial))
              ($found (collapse (match $view (ledger:proposal $pkey $serial $r $c $d $p $n) ($p $n))))
              ($cls (db:close $view)))
         (case $found
           (((($pos $count))
             (if (== $pos none) (cidx:reset)
               (let* (($skey (repr $serial))
                      ($already (not (== (collapse (match &cidx-props (CidxProp $skey) True)) ()))))
                 (if $already
                   (let* (($min-ord (cidx:invalidate-proposal-entries $serial 0 $count $total))
                          ($ne (+ $erev 1))
                          ($lt (cidx:log-touch $ne $min-ord))
                          ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $rrev $nrev $ne $min-c)))
                          ($d (cidx:bump-delta)))
                     True)
                   (let $had-legacy (not (== (collapse (match &cidx-legacy (CidxLeg $skey) True)) ()))
                     (if $had-legacy (cidx:reset)
                       (let* (($keys (list:reverse (input-ledger:call-keys $pos $serial 0 $count call ())))
                              ($ins (cidx:insert-keys $keys $total $total)))
                         (case $ins
                           (((ok $nt $min-ord)
                             (let* (($ap (add-atom &cidx-props (CidxProp $skey)))
                                    ($ne (+ $erev 1))
                                    ($lt (cidx:log-touch $ne $min-ord))
                                    ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $nt $unpos $rrev $nrev $ne $min-c)))
                                    ($d (cidx:bump-delta)))
                               True))
                            ($miss (cidx:reset)))))))))))
            ($other (cidx:reset)))))))))

(= (cidx:delta-attempt $ticket $pos $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
   (case (cidx:parse-ticket-serial $ticket)
     ((none (cidx:reset))
      ($serial
       (let $rkey (cidx:ref-key (call $serial $pos))
         (case (collapse (match &cidx-by-ref (CidxByRef $rkey $ord) $ord))
           ((($ord)
             (let* (($inv (cidx:invalidate-entry-at $ord))
                    ($ne (+ $erev 1))
                    ($lt (cidx:log-touch $ne $ord))
                    ($s (change-state! &cidx-meta (ConvIdxV1 $ae $ar $owner $total $unpos $rrev $nrev $ne $min-c)))
                    ($d (cidx:bump-delta)))
               True))
            ($miss (cidx:reset)))))))))

(= (cidx:after-perform $db $verb $arguments $before-ver $answer)
   (case (get-state &cidx-meta)
     ((ConvIdxNone $answer)
      ((ConvIdxV1 $ce $cr $owner $total $unpos $rrev $nrev $erev $min-c)
       (case (input-ledger:store-version $db)
         ((($ae $ar)
           (if (and (== $ae $ce) (== $ar $cr)) $answer
             (if (and (== $before-ver ($ce $cr)) (== $ae $ce))
               (let $done (cidx:apply-delta $db $verb $arguments $answer $ae $ar $owner $total $unpos $rrev $nrev $erev $min-c)
                 $answer)
               (let $rst (cidx:reset) $answer))))
          ($err (let $rst (cidx:reset) $answer))))))))
