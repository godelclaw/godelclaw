; INACTIVE project-04b candidate. Neither loop.metta nor skills.metta imports
; this module/its selector. Activation requires JSON qualification AND approval.
; A single serial evaluator owns writes and the in-process wake token. No
; cross-process lock, two-file transaction, rollback or retry is claimed.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library math))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self ./src/goal_views_cetta.metta)
!(import! &self ./src/goal_bookkeeping_math_cetta.metta)
!(import! &self ./src/text_cetta.metta)
!(import! &self ./src/strategy_host.py)

!(bind! &gk-last-wake (new-state GkNoWake))
(= (gk:dims) ("Cn" "C" "Ct" "I" "J" "A" "S" "Co" "Sp"))
(= (gk:kernel-path $path) (gv:neighbor $path "goals_kernel.json"))
(= (gk:compost-path $path) (gv:neighbor $path "goals_compost.log"))
(= (gk:default-log) (system:getenv-or-default "METTACLAW_TELEGRAM_LOG_PATH" ""))
(= (gk:detail $value) (if (== (get-type $value) String) $value (repr $value)))
(= (gk:pytype $value)
   (case $value
     ((JsonNull "NoneType") (True "bool") (False "bool")
      ((JsonObject $_) "dict") ((JsonArray $_) "list")
      ($other (if (== (get-type $other) String) "str"
        (if (== (get-type $other) Number)
          (if (or (sv:contains (repr $other) ".") (sv:contains (repr $other) "e")) "float" "int") "object"))))))
(= (gk:no-get $value) (GkErr (str:join "" ("'" (gk:pytype $value) "' object has no attribute 'get'"))))
(= (gk:text $value)
   (case $value
     ((True "True") (False "False") (JsonNull "None")
      ($other (if (== (get-type $other) String) $other
        (if (== (get-type $other) Number)
          (if (math:isnan $other) "nan"
            (if (math:isinf $other) (if (< $other 0) "-inf" "inf") (json:stringify-python $other)))
          (if (== (get-metatype $other) Symbol) (str:symbol->string $other)
            (format-args "{}" ($other)))))))))
(= (gk:r $x)
   (if (== (get-type $x) String) (gv:r $x)
     (gk:r-double (if (== (get-type $x) Number) $x (gv:float $x)))))
(= (gk:r-double $value)
   (if (math:isnan $value) "nan"
     (if (math:isinf $value) (if (< $value 0) "-inf" "inf") (gv:r-number $value))))
(= (gk:budget $value) (if (== $value GkNoBudget) 3.0 $value))
(= (gk:set $object $key $value)
   (let (JsonObject $pairs) $object (JsonObject (gk:set-pair $pairs $key $value))))
(= (gk:set-pair $pairs $key $value)
   (if (== $pairs ()) ((JsonPair $key $value))
     (let* (($head (car-atom $pairs)) ((JsonPair $name $_) $head))
       (if (== $name $key) (cons-atom (JsonPair $key $value) (cdr-atom $pairs))
         (cons-atom $head (gk:set-pair (cdr-atom $pairs) $key $value))))))
(= (gk:object $value)
   (case $value (((JsonObject $pairs) (JsonObject (sv:unique-pairs $pairs)))
     ($other (gk:no-get $other)))))
(= (gk:state $path) (gk:object (gv:kernel $path)))
(= (gk:inventory $path $missing)
   (case (catch (gv:read $path))
     ((GvMissing (gk:parse $missing))
      ((Error $_ $why) (GkErr (gk:detail $why)))
      ($text (if (== (get-type $text) String) (gk:parse (gv:lines $text))
               (GkErr (gk:detail $text)))))))

; Keep raw vibes and notes; canonical beats legacy and same-format last wins
; without changing the first stack position. Budget is last-wins too.
(= (gk:record $match $line $canonical)
   (let (GvGoal $name $area $sti $lti $blocked $verified $note $_)
        (gv:record $match $line $canonical)
     (GkGoal $name $area $sti $lti (gv:group $match $line 5)
             $blocked $verified $note $canonical)))
(= (gk:name (GkGoal $name $_ $_ $_ $_ $_ $_ $_ $_)) $name)
(= (gk:put $goal $goals)
   (if (== $goals ()) ($goal)
     (let* (($head (car-atom $goals))
            ((GkGoal $_ $_ $_ $_ $_ $_ $_ $_ $canonical) $goal)
            ((GkGoal $_ $_ $_ $_ $_ $_ $_ $_ $was-canonical) $head))
       (if (== (gk:name $goal) (gk:name $head))
         (cons-atom (if (or $canonical (not $was-canonical)) $goal $head) (cdr-atom $goals))
         (cons-atom $head (gk:put $goal (cdr-atom $goals)))))))
(= (gk:parse $lines) (gk:parse-lines $lines 1 () () GkNoBudget ()))
(= (gk:parse-lines $lines $number $goals $flags $budget $other)
   (if (== $lines ()) (GkParsed $goals $flags $budget $other)
     (let* (($line (car-atom $lines)) ($canonical (re:captures (get-state &gv-goal) $line))
            ($legacy (if (== $canonical re:no-match) (re:captures (get-state &gv-legacy) $line) re:no-match)))
       (if (!= $canonical re:no-match)
         (gk:parse-lines (cdr-atom $lines) (+ $number 1)
           (gk:put (gk:record $canonical $line True) $goals) $flags $budget $other)
         (if (!= $legacy re:no-match)
           (gk:parse-lines (cdr-atom $lines) (+ $number 1)
             (gk:put (gk:record $legacy $line False) $goals) $flags $budget $other)
           (gk:parse-other $lines $number $goals $flags $budget $other))))))
(= (gk:parse-other $lines $number $goals $flags $budget $other)
   (let* (($line (car-atom $lines)) ($flag (re:captures (get-state &gv-flag) $line))
          ($limit (re:captures (get-state &gv-budget) $line)))
     (if (!= $flag re:no-match)
       (gk:parse-lines (cdr-atom $lines) (+ $number 1) $goals
         (unique-atom (cons-atom ((gv:group $flag $line 1) (gv:group $flag $line 2)) $flags)) $budget $other)
       (if (!= $limit re:no-match)
         (gk:parse-lines (cdr-atom $lines) (+ $number 1) $goals $flags
           (gv:float (gv:group $limit $line 1)) $other)
         (if (re:is-match (get-state &gv-mood) $line)
           (gk:parse-lines (cdr-atom $lines) (+ $number 1) $goals $flags $budget $other)
           (let $stripped (sv:strip $line)
             (if (or (str:starts-with $stripped "(goal ") (str:starts-with $stripped "(goal-budget"))
               (GkErr (str:concat "malformed goal record at line " (repr $number)))
               (gk:parse-lines (cdr-atom $lines) (+ $number 1) $goals $flags $budget
                 (sv:append $other ($line))))))))))

(= (gk:fmt (GkGoal $name $area $_ $_ $vibes $blocked $verified $note $_) $sti $lti)
   (str:join "" ("(goal " $name " " $area " sti:" $sti " lti:" $lti " vibes:(" $vibes
     ") blocked-by:" $blocked " last-verified:" $verified " note:\"" $note "\")")))
(= (gk:goal-line $goal)
   (let (GkGoal $_ $_ $sti $lti $_ $_ $_ $_ $_) $goal
     (gk:fmt $goal (gk:r $sti) (gk:r $lti))))
(= (gk:mood-line $mood)
   (str:join "" ("(mood " (str:join " " (map-atom (gk:dims) $dim
     (str:join ":" ($dim (gk:r (sv:field $mood $dim (Error gk:mood $dim))))))) ")")))
(= (gk:emit $goals $flags $budget $other $mood)
   (let* (($prefix (if (== $other ()) $other
                    (if (!= (sv:strip (index-atom $other (- (size-atom $other) 1))) "")
                      (sv:append $other ("")) $other)))
          ($lines (sv:append $prefix (cons-atom (str:join "" ("(goal-budget " (gk:r $budget) ")"))
            (sv:append (map-atom $goals $goal (gk:goal-line $goal))
              (sv:append (map-atom (sort-atom $flags) $flag
                (let ($name $kind) $flag (str:join "" ("(goal-flag " $name " " $kind ")"))))
                (if (sv:truth $mood) ((gk:mood-line $mood)) ())))))))
     (str:concat (str:join "\n" $lines) "\n")))

; I/O results are checked explicitly. A let-bound Error is not automatically
; exceptional in PeTTa. Failed/uncertain effects are never retried here.
(= (gk:io-result $result)
   (case $result
     ((() (GkOk ())) ((Error $_ $why) (GkErr (gk:detail $why)))
      ($other (GkErr (gk:detail $other))))))
(= (gk:write $path $text) (gk:io-result (catch (fs:write $path $text))))
(= (gk:rename $source $target) (gk:io-result (catch (fs:rename $source $target))))
(= (gk:append $path $text) (gk:io-result (catch (fs:append-text $path $text))))
(= (gk:atomic $path $text)
   (case (gk:write (str:concat $path ".tmp") $text)
     (((GkOk $_) (gk:rename (str:concat $path ".tmp") $path)) ($failure $failure))))
(= (gk:json $value)
   (let $result (catch (json:stringify-python $value))
     (if (== (get-type $result) String) (GkOk $result)
       (GkErr (str:concat "native json:stringify-python emission failed: " (gk:detail $result))))))
(= (gk:emit-result $goals $flags $budget $other $mood)
   (let $missing (if (sv:truth $mood)
     (filter-atom (gk:dims) $dim (== (sv:field $mood $dim GkMissing) GkMissing)) ())
     (if (!= $missing ()) (GkErr (str:join "" ("'" (car-atom $missing) "'")))
       (let $text (catch (gk:emit $goals $flags $budget $other $mood))
         (if (== (get-type $text) String) (GkOk $text) (GkErr (gk:detail $text)))))))

; Offset is a BYTE offset before replacement decoding/newline translation.
; metadata + native tail reader seeks before replacement decoding. A changed
; size between these observations is an explicit failure, never shifted data.
; Concurrent log mutation is not qualified as equivalent to Python's open/seek.
!(bind! &gk-affect (new-state (re:compile "⋄⟨([^⟩]*)⟩")))
!(bind! &gk-affect-pair (new-state (re:compile "(Cn|Ct|Co|Sp|C|I|J|A|S):(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+))")))
(= (gk:mood-samples $path $offset)
   (if (< $offset 0) (GkErr (str:concat "negative seek position " (repr $offset)))
     (case (fs:metadata $path follow)
       (((fs:info regular $size $_)
         (let $start (if (> $offset $size) 0 $offset)
           (if (== $start $size) (GkSamples () $size)
             (case (fs:tail-text $path (- $size $start))
               (((fs:tail $actual $_ $text)
                 (if (== $actual $size)
                   (gk:sample-lines (str:split "\n" (sv:universal $text)) () $actual)
                   (GkErr "log size changed during read; absolute-offset read primitive required")))
                ($unreadable (GkSamples () $start)))))))
        ($unreadable (GkSamples () $offset))))))
(= (gk:sample-lines $lines $samples $offset)
   (if (== $lines ()) (GkSamples $samples $offset)
     (case (json:parse (car-atom $lines))
       (((JsonFailureV1 $_ $_ $_ $_) (gk:sample-lines (cdr-atom $lines) $samples $offset))
        ((JsonObject $pairs)
          (let $record (JsonObject (sv:unique-pairs $pairs))
            (if (== (sv:field $record "kind" JsonNull) "outbound")
              (let $text (sv:field $record "text" "")
                (if (== (get-type $text) String)
                  (let $next (gk:traces $text)
                    (gk:sample-lines (cdr-atom $lines) (sv:append $samples $next) $offset))
                  (GkErr (str:join "" ("expected string or bytes-like object, got '" (gk:pytype $text) "'")))))
              (gk:sample-lines (cdr-atom $lines) $samples $offset))))
        ((JsonArray $_) (GkErr "'list' object has no attribute 'get'"))
        (JsonNull (GkErr "'NoneType' object has no attribute 'get'"))
        ($other (gk:no-get $other))))))
(= (gk:traces $text)
   (let (re:matches $matches) (re:find-all (get-state &gk-affect) $text)
     (gk:trace-matches $matches $text)))
(= (gk:trace-matches $matches $text)
   (case $matches
     ((LNil ())
      ((LCons $match $rest)
        (let* (($trace (re:group-text $match $text 1))
               ((re:matches $pairs) (re:find-all (get-state &gk-affect-pair) $trace))
               ($sample (gk:affect-pairs $pairs $trace (JsonObject ())))
               ((JsonObject $fields) $sample))
          (if (>= (size-atom $fields) 6)
            (cons-atom $sample (gk:trace-matches $rest $text))
            (gk:trace-matches $rest $text)))))))
(= (gk:affect-pairs $pairs $text $sample)
   (case $pairs
     ((LNil $sample)
      ((LCons $match $rest)
        (gk:affect-pairs $rest $text (gk:set $sample (re:group-text $match $text 1)
          (gv:float (re:group-text $match $text 2))))))))
(= (gk:mood-vector $mood)
   (map-atom (gk:dims) $dim (gv:float (sv:field $mood $dim 0.0))))
(= (gk:vector-object $dims $values)
   (if (== $dims ()) ()
     (cons-atom (JsonPair (car-atom $dims) (car-atom $values))
       (gk:vector-object (cdr-atom $dims) (cdr-atom $values)))))
(= (gk:ema $samples $mood $have)
   (if (== $samples ()) (if $have (JsonObject (gk:vector-object (gk:dims) $mood)) (JsonObject ()))
     (let* (($sample (car-atom $samples))
            ($values (map-atom (gk:dims) $dim (sv:field $sample $dim GkaAbsent)))
            ($next (if $have (gka:mood $mood $values) (gka:seed $values))))
       (gk:ema (cdr-atom $samples) $next True))))

(= (gk:without-flag $flags $name $flag)
   (filter-atom $flags $pair (!= $pair ($name $flag))))
(= (gk:flag $flags $name $flag $on)
   (if $on (unique-atom (cons-atom ($name $flag) $flags)) (gk:without-flag $flags $name $flag)))
(= (gk:decay-goals $goals $streaks $flags $out)
   (if (== $goals ()) (GkDecayed (path:reverse-atom-expr $out) $streaks $flags)
     (let* (($goal (car-atom $goals))
            ((GkGoal $name $area $sti $lti $vibes $blocked $verified $note $canonical) $goal)
            (($next-sti $next-lti) (gka:decay ($sti $lti)))
            ($prev (sv:field $streaks $name (JsonObject ())))
            ($streak (if (and (!= $blocked "none") (== $blocked (sv:field $prev "blocked" JsonNull)))
                       (+ (sv:field $prev "streak" 0) 1) 0))
            ($next-streaks (gk:set $streaks $name (JsonObject
              ((JsonPair "blocked" $blocked) (JsonPair "streak" $streak)))))
            ($next-flags (gk:flag (gk:flag $flags $name "stuck" (>= (+ $streak 1) 3))
                          $name "cull-review" (and (< $next-sti 0.05) (< $next-lti 0.1)))))
       (gk:decay-goals (cdr-atom $goals) $next-streaks $next-flags
         (cons-atom (GkGoal $name $area $next-sti $next-lti $vibes $blocked $verified $note $canonical) $out)))))
(= (gk:pairs $goals)
   (map-atom $goals $goal (let (GkGoal $_ $_ $sti $lti $_ $_ $_ $_ $_) $goal ($sti $lti))))
(= (gk:scale $goals $budget)
   (let $total (gka:total (gk:pairs $goals) 0)
     (if (and (> $total $budget) (> $budget 0))
       (let $scale (/ $budget $total)
         (map-atom $goals $goal
           (let (GkGoal $name $area $sti $lti $vibes $blocked $verified $note $canonical) $goal
             (GkGoal $name $area (* $sti $scale) $lti $vibes $blocked $verified $note $canonical)))) $goals)))
(= (gk:status $goals $flags $budget)
   (str:join "" ("goal-kernel: " (repr (size-atom $goals)) " goals, sti "
     (gk:r (gka:total (gk:pairs $goals) 0)) "/" (gk:r $budget)
     (if (== $flags ()) "" (str:concat ", flags " (str:join " " (map-atom (sort-atom $flags) $pair
       (let ($name $flag) $pair (str:join ":" ($name $flag))))))))))
(= (gk:prepare $path $log $token)
   (case (gk:inventory $path (";; goal stack — syntax in SKILLS; kernel decays/flags at each wake"))
     (((GkParsed $goals $flags $budget $other)
       (case (gk:state $path)
         (((JsonObject $pairs) (gk:prepare-state $goals $flags (gk:budget $budget) $other
                               (JsonObject $pairs) $log $token)) ($failure $failure))))
      ($failure $failure))))
(= (gk:prepare-state $goals $flags $budget $other $state $log $token)
   (let* (($wake (if (or (== $token GkNoWake) (== $token "")) GkNoWake (str:sha256 $token)))
          ($previous (sv:field $state "last_human_wake" JsonNull)))
     (if (and (!= $wake GkNoWake) (== $wake $previous)) (GkRepeat "goal-kernel: human wake already applied")
       (case (gk:object (sv:field $state "streaks" (JsonObject ())))
         (((JsonObject $streaks) (gk:prepare-decay $goals $flags $budget $other $state $log $wake $previous
                                  (JsonObject $streaks))) ($failure $failure))))))
(= (gk:prepare-decay $goals $flags $budget $other $state $log $wake $previous $streaks)
   (let* (((GkDecayed $decayed $updated $marks) (gk:decay-goals $goals $streaks $flags ()))
          ($scaled (gk:scale $decayed $budget))
          ($names (map-atom $scaled $goal (gk:name $goal)))
          ($pruned-flags (filter-atom $marks $pair (sv:member (car-atom $pair) $names)))
          ((JsonObject $all-streaks) $updated)
          ($pruned-streaks (JsonObject (filter-atom $all-streaks $pair
            (let (JsonPair $name $_) $pair (sv:member $name $names)))))
          ($mood (sv:field $state "mood" (JsonObject ())))
          ($offset (sv:int (sv:field $state "log_offset" 0)))
          ($observations (if (== $log "") (GkSamples () $offset) (gk:mood-samples $log $offset))))
     (case $observations
       (((GkSamples $samples $next-offset)
         (let* (($next-mood (gk:ema $samples (gk:mood-vector $mood) (sv:truth $mood)))
                ($base (JsonObject ((JsonPair "streaks" $pruned-streaks)
                  (JsonPair "log_offset" $next-offset) (JsonPair "mood" $next-mood))))
                ($next-state (if (!= $wake GkNoWake) (gk:set $base "last_human_wake" $wake)
                               (if (sv:truth $previous) (gk:set $base "last_human_wake" $previous) $base))))
           (GkReady $scaled $pruned-flags $budget $other $next-state (gk:status $scaled $pruned-flags $budget))))
        ($failure $failure)))))
(= (gk:persist $path (GkReady $goals $flags $budget $other $state $message))
   (case (gk:emit-result $goals $flags $budget $other (sv:field $state "mood" (JsonObject ())))
     (((GkOk $text)
       (case (gk:atomic $path $text)
         (((GkOk $_)
           (case (gk:json $state)
             (((GkOk $json)
               (case (gk:atomic (gk:kernel-path $path) $json)
                 (((GkOk $_) (GkStatus True $message)) ($failure $failure))))
              ($failure $failure)))) ($failure $failure))))
      ($failure $failure))))
(= (gk:kernel-status $path $log $token)
   (let $result (catch (gk:kernel-attempt $path $log $token))
     (case $result
       (((GkStatus $applied $message) (GkStatus $applied $message))
        ((GkErr $why) (GkStatus False (str:concat "goal-kernel error: " $why)))
        ((Error $_ $why) (GkStatus False (str:concat "goal-kernel error: " (gk:detail $why))))
        ($other (GkStatus False (str:concat "goal-kernel error: " (gk:detail $other))))))))
(= (gk:kernel-attempt $path $log $token)
   (case (gk:prepare $path $log $token)
     (((GkRepeat $message) (GkStatus False $message))
      ((GkReady $goals $flags $budget $other $state $message)
        (gk:persist $path (GkReady $goals $flags $budget $other $state $message)))
      ($failure $failure))))
(= (gk:kernel-pass)
   (let (GkStatus $_ $message) (gk:kernel-status (gv:path) (gk:default-log) GkNoWake) $message))
(= (gk:human-wake $token) (gk:human-wake $token (gv:path) (gk:default-log)))
(= (gk:human-wake $token $path $log)
   (let* (($text (if (sv:truth $token) (gk:text $token) ""))
          ($digest (str:sha256 $text)))
     (if (== $digest (get-state &gk-last-wake)) (GoalWake 0 0 "goal-kernel: human wake already applied")
       (progn (change-state! &gk-last-wake $digest)
         (let (GkStatus $applied $message) (gk:kernel-status $path $log $text)
           (GoalWake (if (or $applied (str:starts-with $message "goal-kernel error:")) 1 0)
                     (if $applied 1 0) $message))))))

; Actual CeTTa skill atoms are rendered/decoded natively, not marshalled to a
; Python list. Literal Python-list-string input is not an atom bridge contract.
!(bind! &gk-vibes (new-state (re:compile "vibes:\\s*\\(([^)]*)\\)")))
!(bind! &gk-vibe-separators (new-state (gv:regex "[,\\s]+")))
(= (gk:join-fields $fields $text)
   (if (== $fields ()) $text
     (let* (($field (car-atom $fields))
            ($joined (re:replace-literal (re:compile (str:join "" ("\\b" $field "\\s+\\(")))
                       $text (str:concat $field "("))))
       (gk:join-fields (cdr-atom $fields) $joined))))
(= (gk:normalize-vibes $text $start)
   (case (re:find (get-state &gk-vibes) (str:byte-slice $text $start (str:byte-length $text)))
     ((re:no-match $text)
      ($match
        (let* (($tail (str:byte-slice $text $start (str:byte-length $text)))
               ((re:span $from $to) (re:group-span $match 0))
               ($words (filter-atom (str:split " " (re:replace-literal (get-state &gk-vibe-separators)
                          (re:group-text $match $tail 1) " ")) $word (!= $word "")))
               ($vibes (str:join "" ("vibes:(" (str:join " " $words) ")")))
               ($prefix (str:concat (str:byte-slice $text 0 (+ $start $from)) $vibes))
               ($next (str:concat $prefix (str:byte-slice $tail $to (str:byte-length $tail)))))
          (gk:normalize-vibes $next (str:byte-length $prefix)))))))
(= (gk:normalize $text)
   (let $joined (gk:normalize-vibes (gk:join-fields
     ("vibes:" "blocked-by:" "last-verified:" "note:" "sti:" "lti:") (sv:strip $text)) 0)
     (if (and (str:starts-with $joined "(goal ") (not (sv:contains $joined "vibes:")))
       (case (re:find (gv:regex "\\s+blocked-by:") $joined)
         ((re:no-match $joined)
          ($match (let (re:span $from $_) (re:group-span $match 0)
            (str:join "" ((str:byte-slice $joined 0 $from) " vibes:()" (str:byte-slice $joined $from (str:byte-length $joined)))))))) $joined)))
(= (gk:rejected)
   "rejected: expected (goal <name> <area> sti:<0-1> lti:<0-1> vibes:(..) blocked-by:<none|hyphenated-token> last-verified:<never|timestamp> note:free text) on one line — no quotes needed, hyphenate blocked-by")
(= (gk:goal-write $atom) (gk:goal-write $atom (gv:path)))
(= (gk:goal-write $atom $path)
   (let* (($text (gk:normalize (claw-text:decode-safe $atom)))
          ($budget (re:captures (get-state &gv-budget) $text))
          ($goal (re:captures (get-state &gv-goal) $text)))
     (if (and (== $goal re:no-match) (== $budget re:no-match)) (gk:rejected)
       (let $limit (if (== $budget re:no-match) GkNoBudget (gv:float (gv:group $budget $text 1)))
         (if (== $limit GkNoBudget) (gk:write-valid $path $text $goal $limit)
           (if (and (>= $limit 0.5) (<= $limit 10)) (gk:write-valid $path $text $goal $limit)
             "goal-budget must be in [0.5, 10]"))))))
(= (gk:write-valid $path $text $match $limit)
   (case (gk:inventory $path ())
     (((GkErr $why) (str:concat "goal-write rejected: " $why))
      ((GkParsed $goals $flags $budget $other)
        (let* (($goal (if (== $limit GkNoBudget) (gk:record $match $text True) GkNoGoal))
               ($next (if (== $limit GkNoBudget) (gk:put $goal $goals) $goals))
               ($verdict (if (!= $limit GkNoBudget) (str:concat "budget set to " (gk:r $limit))
                 (str:join "" ("goal " (gk:name $goal)
                   (if (sv:member (gk:name $goal) (map-atom $goals $g (gk:name $g))) " updated" " added")))))
               ($state (gk:state $path)))
          (case $state
            (((JsonObject $_)
              (gk:write-emitted $path $next $flags (if (== $limit GkNoBudget) (gk:budget $budget) $limit)
                $other (sv:field $state "mood" (JsonObject ())) $verdict))
             ((GkErr $why) (Error gk:goal-write $why)))))))))
(= (gk:write-emitted $path $goals $flags $budget $other $mood $verdict)
   (case (gk:emit-result $goals $flags $budget $other $mood)
     (((GkOk $text) (case (gk:atomic $path $text)
       (((GkOk $_) $verdict) ((GkErr $why) (Error gk:write-emitted $why)))))
      ((GkErr $why) (Error gk:write-emitted $why)))))

(= (gk:stamp) (str:symbol->string (format-time "%Y-%m-%dT%H:%M:%S")))
(= (gk:compost-record $goal)
   (let (GkGoal $_ $_ $sti $lti $_ $_ $_ $_ $_) $goal
     (case (gk:json $sti)
       (((GkOk $s) (case (gk:json $lti)
         (((GkOk $l) (GkOk (gk:fmt $goal $s $l))) ($failure $failure))))
        ($failure $failure)))))
(= (gk:retire $name $reason)
   (case (catch (py-call (strategy_host.retire_goal $name $reason)))
     (((Error $_ $_) 0) ($closed $closed))))
(= (gk:goal-drop $name $reason) (gk:goal-drop $name $reason (gv:path)))
(= (gk:goal-drop $name $reason $path)
   (gk:drop-text (gk:text $name) (gk:text $reason) $path))
(= (gk:drop-text $name $reason $path)
   (case (gk:inventory $path ())
     (((GkErr $why) (str:concat "goal-drop rejected: " $why))
      ((GkParsed $goals $flags $budget $other)
        (let* (($matches (filter-atom $goals $g (== (gk:name $g) $name))))
          (if (== $matches ()) (str:concat "no goal named " $name)
            (let* (($goal (car-atom $matches)) ((GkGoal $_ $_ $_ $_ $_ $_ $verified $_ $_) $goal))
              (if (== (sv:strip $reason) "") "rejected: give a reason, or 'solved' for a verified goal"
                (if (and (== $reason "solved") (== $verified "never"))
                  "rejected: last-verified is 'never' — verify progress (goal-write with a last-verified timestamp) before claiming solved, or retire it with another reason"
                  (gk:drop-valid $path $name $reason $goal $goals $flags (gk:budget $budget) $other))))))))))
(= (gk:drop-valid $path $name $reason $goal $goals $flags $budget $other)
   (case (gk:compost-record $goal)
     (((GkOk $record)
       (case (gk:append (gk:compost-path $path) (str:join "" ((gk:stamp) " " $reason " " $record "\n")))
         (((GkOk $_) (gk:drop-written $path $name $reason $goals $flags $budget $other))
          ((GkErr $why) (str:concat "goal-drop failed: compost log was not written: " $why)))))
      ((GkErr $why) (Error gk:goal-drop $why)))))
(= (gk:drop-written $path $name $reason $goals $flags $budget $other)
   (let $state (gk:state $path)
     (case $state
       (((JsonObject $_)
         (let $written (gk:write-emitted $path (filter-atom $goals $g (!= (gk:name $g) $name))
             (filter-atom $flags $pair (!= (car-atom $pair) $name)) $budget $other
             (sv:field $state "mood" (JsonObject ())) GkDropped)
           (if (== $written GkDropped)
             (let $closed (gk:retire $name $reason)
               (str:join "" ("goal " $name " composted (" $reason ")"
                 (if (sv:truth $closed) (str:join "" ("; " (repr $closed) " open cycle(s) closed, not achieved")) "")
                 " — remember a compost note"))) $written)))
        ((GkErr $why) (Error gk:goal-drop $why))))))
