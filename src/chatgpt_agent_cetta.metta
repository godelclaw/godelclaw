; SPDX-License-Identifier: MIT
; ChatGPT-plan policy and command-loop integration. OAuth and bearer bytes stay
; in CeTTa. Existing host callbacks retain normal call recovery and usage data.
!(import! &self ./src/chatgpt_plan_cetta.metta)
!(import! &self ./src/api_registry.metta)
!(import! &self io)
!(import! &self fs)
!(import! &self path:)
!(import! &self system)

(CommandSpec 1 "chatgpt" "chatgpt-policy" 0 2 "(chatgpt-policy [\"key\" [value]])" "Inspect/change account, deadlines and response size. Subscription use requires an SIWC-enabled CeTTa in godelclaw command mode; model ids use chatgpt:slug." "chatgpt")
(CommandSpec 1 "chatgpt" "chatgpt-login" 0 3 "(chatgpt-login [\"registration|new\" [port [deadline-ms]]])" "Start browser sign-in. Returns an owned handle; chatgpt-login-status shows the browser link or validated result. No credential bytes enter MeTTa." "")
(CommandSpec 1 "chatgpt" "chatgpt-login-status" 1 1 "(chatgpt-login-status id)" "Observe sign-in progress/completion; a successful login reports the registration id for chatgpt-policy account." "")
(CommandSpec 1 "chatgpt" "chatgpt-accounts" 0 0 "(chatgpt-accounts)" "List safe native account metadata, including expiry and renewal state." "")
(CommandSpec 1 "chatgpt" "chatgpt-models" 0 0 "(chatgpt-models)" "List account-visible model slugs and labels in provider order. No model is selected automatically." "")
(CommandSpec 1 "chatgpt" "chatgpt-logout" 1 1 "(chatgpt-logout \"registration\")" "Revoke and clear this native session; registration identity remains for reauthorization." "")
(SettingSpec 1 "chatgpt" "account" "" "registration id" Text "persistent" "Native registration used for chatgpt: model ids. Empty means unconfigured; no provider fallback." chatgpt-policy chatgpt-policy)
(SettingSpec 1 "chatgpt" "auth-deadline-ms" 300000 "milliseconds" (IntegerFrom 0) "persistent" "Default browser sign-in and renewal deadline; zero disables it. A sign-in call may override it." chatgpt-policy chatgpt-policy)
(SettingSpec 1 "chatgpt" "model-list-deadline-ms" 30000 "milliseconds" (IntegerFrom 0) "persistent" "Model discovery deadline; zero disables it." chatgpt-policy chatgpt-policy)
(SettingSpec 1 "chatgpt" "response-bytes" 8388608 "bytes" (IntegerFrom 1) "persistent" "Collected Responses SSE body allowance; raise it for larger reasoning/output streams." chatgpt-policy chatgpt-policy)

(= (chatgpt:available?) (let $providers (io:capabilities) (llm:v1:member? siwc $providers)))
!(if (chatgpt:available?) (import! &self siwc) True)
(= (chatgpt:model? $name) (str:starts-with $name "chatgpt:"))
(= (chatgpt:policy-path)
   (system:getenv-or-default "METTACLAW_CHATGPT_POLICY_PATH"
     (path:join (path:dirname (system:getenv-or-default "METTACLAW_ENGINE_STATE_PATH"
        (path:join (system:getenv-or-default "HOME" ".") ".local/state/godelclaw/engine"))) "chatgpt.json")))
(= (chatgpt:policy-load)
   (if (fs:exists (chatgpt:policy-path))
     (case (fs:read-text-result (chatgpt:policy-path) 0 "raw")
       ((("ok" $text) (llm:v1:parse $text)) ($other (llm:v1:failure policy-read-error))))
     (JsonObject ())))
(= (chatgpt-policy) (settings "chatgpt"))
(= (chatgpt-policy $key)
   (let* (($policy (chatgpt:policy-load)) ($value (llm:v1:get $policy $key)))
     (case $value
       ((JsonNull (settings:default "chatgpt" $key))
        ((JsonString $text) $text) ((JsonNumber $text) (parse $text)) ($bad $bad)))))
(= (chatgpt-policy $key $raw)
   (let* (($value (if (== $key "account") $raw (if (== (get-type $raw) String) (parse $raw) $raw)))
          ($valid (settings:validate "chatgpt" $key $value)))
     (if (== $valid True)
       (let* (($json (if (== (get-type $value) String) (JsonString $value) (JsonNumber (repr $value))))
              ($policy (chatgpt:policy-load)) ($updated (llm:v1:with $policy $key $json))
              ($text (llm:v1:render $updated)))
         (case (fs:update-text (chatgpt:policy-path) "replace" $text "" "")
           ((("written" $path $bytes $hash $backup) (ChatGPTConfigured $key $value))
            ($error (ChatGPTPolicyError $error))))) $valid)))
(= (chatgpt:collect $pending)
   (case $pending
     (((io:pending $id) (chatgpt:collect-id $id)) ($other (ChatGPTUnavailable io-submit)))))
(= (chatgpt:collect-id $id)
   (let $event (siwc:observe $id 250)
    (case $event
     (((io:idle) (chatgpt:collect-id $id)) ($done $done)))))
(= (chatgpt-login) (chatgpt-login "new" 0 (chatgpt-policy "auth-deadline-ms")))
(= (chatgpt-login $registration) (chatgpt-login $registration 0 (chatgpt-policy "auth-deadline-ms")))
(= (chatgpt-login $registration $port) (chatgpt-login $registration $port (chatgpt-policy "auth-deadline-ms")))
(= (chatgpt-login $registration $port $deadline)
   (if (chatgpt:available?) (siwc:sign-in $registration $port $deadline) (ChatGPTUnavailable native-auth-not-built)))
(= (chatgpt-login-status $id)
   (if (chatgpt:available?)
     (let $event (siwc:observe $id 0)
       (case $event (((io:idle) (siwc:status $id)) ($done $done))))
     (ChatGPTUnavailable native-auth-not-built)))
(= (chatgpt-accounts)
   (if (chatgpt:available?) (let $pending (siwc:accounts) (chatgpt:collect $pending))
     (ChatGPTUnavailable native-auth-not-built)))
(= (chatgpt-logout $registration)
   (if (chatgpt:available?)
     (let* (($deadline (chatgpt-policy "auth-deadline-ms")) ($pending (siwc:sign-out $registration $deadline))
            ($_ (py-call (process_supervision.provider_wait (/ $deadline 1000)))))
       (chatgpt:collect $pending)) (ChatGPTUnavailable native-auth-not-built)))
(= (chatgpt:session)
   (if (chatgpt:available?)
     (let $account (chatgpt-policy "account")
       (if (== $account "") (ChatGPTUnavailable account-not-selected)
         (let* (($deadline (chatgpt-policy "auth-deadline-ms")) ($pending (siwc:ensure $account $deadline))
                ($_ (py-call (process_supervision.provider_wait (/ $deadline 1000))))
                ($result (chatgpt:collect $pending)))
           (if (== (llm:v1:get $result "status") (JsonString "ok")) $result
             (ChatGPTUnavailable (llm:v1:get $result "code"))))))
     (ChatGPTUnavailable native-auth-not-built)))
(= (chatgpt:wait-http $id)
   (let $event (io:try-wait $id 250)
    (case $event
     (((io:idle) (chatgpt:wait-http $id))
      ((io:event $id (http:response 200 $body)) (llm:v1:parse $body))
      ($other (ChatGPTUnavailable model-list-http-error))))))
(= (chatgpt:visible-models $items)
   (if (== $items ()) ()
     (let* (($item (car-atom $items)) ($tail (chatgpt:visible-models (cdr-atom $items))))
       (if (== (llm:v1:get $item "visibility") (JsonString "list"))
         (let* (($slug (llm:v1:get $item "slug")) ($label (llm:v1:get $item "display_name")))
           (cons-atom (ChatGPTModel $slug $label) $tail)) $tail))))
(= (chatgpt-models)
   (let $session-value (chatgpt:session)
    (case $session-value
     (((ChatGPTUnavailable $why) (ChatGPTUnavailable $why))
      ($session
       (chatgpt:models-session $session))))))
(= (chatgpt:models-session $session)
       (let* (($account (llm:v1:get $session "value"))
              ($alias-json (llm:v1:get $account "credential_alias")) ($alias (llm:v1:text $alias-json))
              ($base-json (llm:v1:get $session "api_base")) ($base (llm:v1:text $base-json))
              ($url (str:concat $base "models"))
              ($deadline (chatgpt-policy "model-list-deadline-ms")) ($cap (chatgpt-policy "response-bytes"))
              ($pending (io:try-submit (http:request "GET" $url ((http:credential $alias)) "" $deadline $cap))))
         (chatgpt:models-submitted $pending)))
(= (chatgpt:models-submitted $pending)
   (case $pending
     (((io:pending $id)
       (let* (($reply (chatgpt:wait-http $id)) ($models (llm:v1:get $reply "models")))
         (case $models
           (((JsonArray $items)
             (let $visible (chatgpt:visible-models $items) (ChatGPTModels $visible)))
            ($other (ChatGPTUnavailable model-list-invalid))))))
      ($other (ChatGPTUnavailable model-list-submit-error)))))

; Controlled subscription-route repeats reused cache with session_id; the
; body's cache key alone did not reliably produce repeat hits. Keep this
; empirical routing hint local to this transport. One identifier per agent,
; account and model remains stable as the prompt changes.
(= (chatgpt:session-id $model)
   (let* (($seed (str:concat (chatgpt:policy-path)
                   (str:concat ":" (str:concat (chatgpt-policy "account") (str:concat ":" $model)))))
          ($hex (str:sha256 $seed)))
     (str:concat (str:byte-slice $hex 0 8)
       (str:concat "-" (str:concat (str:byte-slice $hex 8 12)
         (str:concat "-" (str:concat (str:byte-slice $hex 12 16)
           (str:concat "-" (str:concat (str:byte-slice $hex 16 20)
             (str:concat "-" (str:byte-slice $hex 20 32)))))))))))

; Transcript chunk markers only matter to providers with block caching; this
; provider caches by prefix, so the chunks are joined as plain text. The cache
; key follows the first, unchanging stable part.
(= (chatgpt:unchunk $text)
   (case (str:find $text "\n_cache_chunk_\n")
     (((TextNotFound $_) $text)
      ($at (str:join "" ((str:byte-slice $text 0 $at) "\n\n"
             (chatgpt:unchunk (str:byte-slice $text (+ $at 15) (str:byte-length $text)))))))))
(= (chatgpt:unchunk-all $parts)
   (if (== $parts ()) ()
     (let (JsonString $text) (car-atom $parts)
       (cons-atom (JsonString (chatgpt:unchunk $text)) (chatgpt:unchunk-all (cdr-atom $parts))))))
; Only three layout markers have structural meaning. Later occurrences remain
; literal user text, matching the existing command-loop prompt contract.
(= (chatgpt:split $text $remaining $stable)
   (if (== $remaining 0) (ChatGPTPrompt $stable $text)
     (case (str:find $text "_cache_boundary_")
       (((TextNotFound $needle) (ChatGPTPrompt $stable $text))
        ($at
         (let* (($before (str:byte-slice $text 0 $at))
                ($after (str:byte-slice $text (+ $at 16) (str:byte-length $text)))
                ($next (llm:v1:append $stable ((JsonString $before)))))
           (chatgpt:split $after (- $remaining 1) $next)))))))
(= (chatgpt:attributes $plan $fields)
   (if (== $fields ()) $plan
     (let* ((($key $value) (car-atom $fields))
            ($_ (py-call (builtins.setattr $plan $key $value)))
            ($rest (cdr-atom $fields))) (chatgpt:attributes $plan $rest))))
(= (chatgpt:command-plan $selected $tokens $effort $prompt $session)
   (let* (($model (str:byte-slice $selected 8 (str:byte-length $selected)))
          ($effort-text (str:concat "" $effort))
          ((ChatGPTPrompt $parts $user) (chatgpt:split $prompt 3 ()))
          ($stable (chatgpt:unchunk-all $parts))
          ($base-request (JsonObject ((JsonPair "model" (JsonString $model))
             (JsonPair "max_tokens" (JsonNumber (repr $tokens)))
             (JsonPair "stable" (JsonArray $stable)) (JsonPair "user" (JsonString $user)))))
          ($reasoned-request (if (or (== $effort-text "default") (or (== $effort-text "") (== $effort-text "None"))) $base-request
             (llm:v1:with $base-request "reasoning" (JsonObject ((JsonPair "effort" (JsonString $effort-text)))))))
          ($cache (str:sha256 (repr ($model (if (== $stable ()) () (car-atom $stable))))))
          ($request (llm:v1:with $reasoned-request "cache_key" (JsonString $cache)))
          ($wire-request (llm:v1:render $request))
          ($account (llm:v1:get $session "value"))
          ($alias-json (llm:v1:get $account "credential_alias")) ($alias (llm:v1:text $alias-json))
          ($api-json (llm:v1:get $session "api_base")) ($api (llm:v1:text $api-json))
          ($base (str:char-slice $api 0 (- (str:char-length $api) 1)))
          ($session-id (chatgpt:session-id $model))
          ($headers (llm:v1:render (JsonArray ((JsonArray ((JsonString "http:header") (JsonString "Content-Type") (JsonString "application/json")))
                      (JsonArray ((JsonString "http:header") (JsonString "session_id") (JsonString $session-id)))
                      (JsonArray ((JsonString "http:credential") (JsonString $alias)))))))
          ($wait (py-call (native_llm_host.wait_settings)))
          ($soft (py-call (operator.getitem $wait "soft")))
          ($hard (py-call (operator.getitem $wait "hard")))
          ($connect (py-call (operator.getitem $wait "connect")))
          ($first (py-call (operator.getitem $wait "first")))
          ($idle (py-call (operator.getitem $wait "idle")))
          ($cap (chatgpt-policy "response-bytes"))
          ($activity (py-call (native_llm_host.call_scope)))
          ($lane (py-call (native_llm_host.call_lane)))
          ; Subscription quotas are independent of API-key billing/cooldowns.
          ($ticket (py-call (llm_policy.admit "chatgpt" $tokens)))
          ($plan (py-call (types.SimpleNamespace))))
     ; Numeric false flags preserve Python truth values across the historical
     ; PeTTa foreign bridge, whose ungrounded False spelling is a Python string.
     (chatgpt:attributes $plan
       (("kind" "command") ("encoding" "default")
        ("ready" "true") ("claimed" 0) ("sent" 0) ("stream" 0)
        ("request_profile" "chatgpt-plan") ("epoch" $ticket) ("correlation" $ticket)
        ("provider" "openai") ("protocol" "responses") ("base" $base) ("headers" $headers)
        ("request" $wire-request) ("timeout" $hard) ("soft" $soft) ("connect" $connect)
        ("first" $first) ("idle" $idle) ("cap" $cap) ("prompt_text" $prompt)
        ("activity" $activity) ("lane" $lane)))))

; Structured sessions use the same authenticated subscription route. Only the
; request/encoding changes; admission, peer-owned credentials and recovery are
; identical to ordinary agent calls.
(= (chatgpt:structured-plan $selected $request $session)
   (let* (((JsonNumber $token-text) (llm:v1:get $request "max_tokens"))
          ($tokens (str:string->number $token-text))
          ($plan (chatgpt:command-plan $selected $tokens "default" "" $session))
          ($model (str:byte-slice $selected 8 (str:byte-length $selected)))
          ((JsonObject $fields) $request)
          ($uncached (llm:v1:without $fields "cache_messages"))
          ($remaining (llm:v1:without $uncached "cache_ttl"))
          ($portable (JsonObject $remaining))
          ($named (llm:v1:with $portable "model" (JsonString $model)))
          ($canonical (llm:v1:with $named "role_policy" (JsonString "merge-system-developer")))
          ($wire (llm:v1:render $canonical)))
     (chatgpt:attributes $plan (("kind" "structured") ("request" $wire)))))
(= (chatgpt:command $selected $tokens $effort $prompt)
   (let $session-value (chatgpt:session)
    (case $session-value
     (((ChatGPTUnavailable $why) (py-call (synthetic_llm._empty_action $why)))
      ($session
       (let $planned (catch (chatgpt:command-plan $selected $tokens $effort $prompt $session))
        (case $planned
         (((Error $source $reason) (py-call (synthetic_llm._empty_action chatgpt-plan-error)))
          ($plan (llm:run $plan))))))))))
(= (chatgpt:plan? $plan)
   (let* (($profile (py-call (builtins.getattr $plan "request_profile" "")))
          ($text (str:concat "" $profile))) (== $text "chatgpt-plan")))
