; Local settings pages share the native selection and observation owners.
!(import! &self ./model_menu_cetta.metta)
!(import! &self ./loop_modes_cetta.metta)
!(import! &self ./fuel_cetta.metta)
(= (menu:state $prefix)
   (case $prefix
     (("mode" (MenuStateV1 (loop-mode:names) (loop-mode:active) (loop-mode:current) () (loop-mode:view)))
      ("fuel" (MenuStateV1 (fuel:names) (fuel:current) "" () (fuel:list-view)))
      ("model"
        (let (ModelMenuV1 $ids $current $unavailable $status) (model:menu-state)
          (MenuStateV1 $ids $current "" $unavailable (str:concat "tap to switch — " $status))))
      ($bad (Error settings-menu (Unsolvable $prefix))))))
(= (menu:provider $name)
   (if (str:starts-with $name "kimi:") "kimi"
     (if (str:starts-with $name "chatgpt:") "chatgpt"
       (if (str:starts-with $name "openai:") "openai"
         (if (str:starts-with $name "claude-") "anthropic" "synthetic")))))
(= (menu:providers) (("kimi" "Kimi Code") ("synthetic" "Synthetic") ("anthropic" "Anthropic") ("chatgpt" "ChatGPT") ("openai" "OpenAI API")))
(= (menu:provider-label $provider)
   (let $found (filter-atom (menu:providers) $row (== (car-atom $row) $provider))
     (if (== $found ()) "" (index-atom (car-atom $found) 1))))
(= (menu:button $label $data) (JsonArray ($label $data)))
(= (menu:row $label $data) (JsonArray ((menu:button $label $data))))
(= (menu:result $text $rows) (JsonObject ((JsonPair "text" $text) (JsonPair "rows" (JsonArray $rows)))))
(= (menu:page $prefix $offset $provider)
   (let (MenuStateV1 $names $current $selected $unavailable $text) (menu:state $prefix)
     (if (and (== $prefix "model") (== $provider ""))
       (menu:result (str:concat "Choose a provider, then tap to switch models — " $text)
         (menu:provider-rows (menu:providers) $names (menu:provider $current)))
       (let* (($filtered (if (== $provider "") $names
                            (filter-atom $names $name (== (menu:provider $name) $provider))))
              ($length (size-atom $filtered))
              ($bounded (max 0 (min $offset (max 0 (- $length 1)))))
              ($start (- $bounded (% $bounded 24)))
              ($page (list:take 24 (list:drop $start $filtered)))
              ($route (str:concat $prefix (if (== $provider "") "" (str:concat ":" $provider))))
              ($choices (map-atom $page $name (menu:choice-row $prefix $name $current $selected $unavailable)))
              ($navigation (list:append
                (if (> $start 0) ((menu:button "Previous" (str:join "" ("menu:" $route ":" (repr (max 0 (- $start 24))))))) ())
                (if (< (+ $start 24) $length) ((menu:button "Next" (str:join "" ("menu:" $route ":" (repr (+ $start 24)))))) ())))
              ($rows (list:append $choices
                (list:append (if (== $navigation ()) () ((JsonArray $navigation)))
                  (if (== $provider "") () ((menu:row "Providers" "menu:model:providers"))))))
              ($heading (if (== $provider "") $text (str:join "" ((menu:provider-label $provider) " — " $text)))))
         (menu:result
           (str:concat $heading (if (> $length 24)
             (str:join "" (" — choices " (repr (+ $start 1)) "–" (repr (min (+ $start 24) $length)) " of " (repr $length))) ""))
           $rows)))))
(= (menu:provider-rows $providers $names $current)
   (if (== $providers ()) ()
     (let* ((($provider $label) (car-atom $providers))
            ($count (size-atom (filter-atom $names $name (== (menu:provider $name) $provider))))
            ($rest (menu:provider-rows (cdr-atom $providers) $names $current)))
       (if (== $count 0) $rest
         (cons-atom (menu:row (str:join "" ((if (== $provider $current) "● " "") $label " (" (repr $count) ")"))
                       (str:join "" ("menu:model:" $provider ":0"))) $rest)))))
(= (menu:choice-row $prefix $name $current $selected $unavailable)
   (let* (($full (str:join "" ($prefix ":" $name)))
          ($data (if (> (str:byte-length $full) 64)
                   (str:join "" ("choice:" $prefix ":" (str:char-slice (str:sha256 $full) 0 40))) $full))
          ($mark (if (== $name $current) "● " (if (== $name $selected) "◌ "
                    (if (model:member? $name $unavailable) "⚠ " ""))))
          ($label (str:concat $mark $name)))
     (menu:row (str:char-slice $label 0 (min 64 (str:char-length $label))) $data)))
(= (menu:button-page $argument)
   (let $parts (str:split ":" $argument)
     (if (< (size-atom $parts) 2) (Error settings-menu (Unsolvable invalid-page))
       (let* (($prefix (car-atom $parts)) ($tail (cdr-atom $parts)))
         (if (and (== $prefix "model") (== (car-atom $tail) "providers")) (menu:page "model" 0 "")
           (let* (($provider (if (== (size-atom $tail) 2) (car-atom $tail) ""))
                  ($offset (str:string->number (if (== $provider "") (car-atom $tail) (index-atom $tail 1)))))
             (if (== (get-type $offset) Number) (menu:page $prefix $offset $provider)
               (Error settings-menu (Unsolvable invalid-page)))))))))
(= (menu:button-choice $argument)
   (let $parts (str:split ":" $argument)
     (if (!= (size-atom $parts) 2) (Error settings-menu (Unsolvable invalid-choice))
       (let* (($prefix (car-atom $parts)) ($token (index-atom $parts 1))
              ((MenuStateV1 $names $_ $_ $_ $_) (menu:state $prefix))
              ($matches (filter-atom (map-atom $names $name (str:join "" ($prefix ":" $name)))
                          $data (== (str:char-slice (str:sha256 $data) 0 40) $token))))
         (if (== (size-atom $matches) 1) (car-atom $matches)
           (Error settings-menu (Incomplete choice-expired-or-ambiguous)))))))
