; SPDX-License-Identifier: MIT
; Small experimental selectors. Observations are not factual evidence.
; One constant-size trace per memory; no mandatory feedback or history quota.
!(import! &self ./src/api_registry.metta)
!(import! &self (library json))
!(bind! &ax-override (new-state ""))
!(bind! &ax-inputs (new-state Missing))
!(bind! &ax-last (new-state (AttentionStudy none ())))
!(bind! &ax-time (new-state 0))
!(bind! &ax-config (new-state Missing))

(CommandSpec 1 "attention-study" "attention-studies" 0 0 "(attention-studies)" "Inspect the research coverage catalogue: simple candidates, implementation stage, tests and sources. No memory text." "attention")
(CommandSpec 1 "attention-study" "attention-try" 2 3 "(attention-try \"baseline|power-law|gain-need|inhibition\" \"phrase\" [count])" "Try one experimental native-memory selector for this query; persistent settings are restored. Baseline uses the ordinary hybrid selector. Default count 20; zero selects all." "attention")
(CommandSpec 1 "attention-study" "attention-compare" 0 1 "(attention-compare [count])" "Compare all four selectors on the last query's same candidate pool and pre-query observations. No extra retrieval, feedback or attention stimulus." "")
(CommandSpec 1 "attention-study" "attention-feedback" 2 3 "(attention-feedback \"memory-id\" usefulness [weight])" "Optional usefulness observation in [0,1], with nonnegative weight (default 1). This updates a retrieval-gain proxy, never factual confidence. Unused memories receive no automatic negative feedback." "")

(SettingSpec 1 "attention" "study-arm" "baseline" "experimental selector" (Choice ("baseline" "power-law" "gain-need" "inhibition")) "persistent" "Baseline preserves ordinary ranking. Other arms are independently selectable experiments; explicit similarity queries retain similarity ordering." attention-policy attention-policy)
(SettingSpec 1 "attention" "study-mix" 0.5 "fraction" (Interval 0 1) "persistent" "Mix experimental score into the ordinary hybrid score. Zero disables the experimental effect. Comparisons use the same value." attention-policy attention-policy)
(SettingSpec 1 "attention" "power-decay" 0.5 "exponent" Nonnegative "persistent" "Power-law-lite uses n/(1+age/time-scale)^exponent, with n deliberate uses and age since last use. This constant-space proxy is not exact ACT-R history summation. Zero disables its aging." attention-policy attention-policy)
(SettingSpec 1 "attention" "power-time-scale" 60 "seconds" Nonnegative "persistent" "Age scale of the power-law-lite experiment. Zero disables aging; frequency still contributes." attention-policy attention-policy)
(SettingSpec 1 "attention" "gain-prior" 1 "observations per outcome" Nonnegative "persistent" "Symmetric positive/negative prior for explicit usefulness feedback. With no evidence and a zero prior the gain proxy is 0.5. This is not a PLN truth value or a measured Bellman improvement." attention-policy attention-policy)
(SettingSpec 1 "attention" "inhibition-strength" 0.8 "fraction" (Interval 0 1) "persistent" "Temporary score reduction after a returned hit. Zero disables inhibition; memories remain accessible through ordinary similarity and direct ID reads." attention-policy attention-policy)
(SettingSpec 1 "attention" "inhibition-half-life" 60 "seconds" Nonnegative "persistent" "Half-life of the temporary repetition penalty. Zero disables it. It is a retrieval experiment, not a clinical model." attention-policy attention-policy)

(= (ax:arms) ("baseline" "power-law" "gain-need" "inhibition"))
(= (ax:arm $bank)
   (if (== (am:get $bank "study-mix") 0) "baseline"
     (if (== (get-state &ax-override) "") (am:get $bank "study-arm") (get-state &ax-override))))
(= (ax:begin $bank)
   (let* (($_ (change-state! &ax-time (system:wall-time)))
          ($_ (change-state! &ax-last (AttentionStudy none ())))
          ($_ (change-state! &ax-config
                (StudyConfig (ax:arm $bank) (am:get $bank "study-mix")
                  (am:get $bank "power-decay") (am:get $bank "power-time-scale")
                  (am:get $bank "gain-prior") (am:get $bank "inhibition-strength")
                  (am:get $bank "inhibition-half-life"))))
          ($_ (change-state! &ax-inputs (new-space)))) True))
(= (ax:trace $bank $id)
   (case (collapse (match $bank (StudyTrace $id $uses $first $last $shown $latest $positive $negative)
                 (StudyTrace $id $uses $first $last $shown $latest $positive $negative)))
     ((() (StudyTrace $id 0 0 0 0 0 0 0)) (($row) $row))))
(= (ax:replace $bank $row)
   (let (StudyTrace $id $n $first $last $shown $latest $pos $neg) $row
     (let* (($_ (collapse (match $bank (StudyTrace $id $a $b $c $d $e $f $g)
                         (remove-atom $bank (StudyTrace $id $a $b $c $d $e $f $g)))))
            ($_ (add-atom $bank $row))) True)))
(= (ax:used $bank $id $amount)
   (if (<= $amount 0) True
     (let* (((StudyTrace $id $n $first $last $shown $latest $pos $neg) (ax:trace $bank $id))
            ($now (system:wall-time))
            ($next (StudyTrace $id (+ $n 1) (if (== $n 0) $now $first) $now $shown $latest $pos $neg)))
       (ax:replace $bank $next))))
(= (ax:shown $bank $rows)
   (if (== $rows ()) True
     (let* ((($score (MemoryInfo $id $r $doc $meta)) (car-atom $rows))
            ((StudyTrace $id $n $first $last $shown $latest $pos $neg) (ax:trace $bank $id))
            ($next (StudyTrace $id $n $first $last (+ $shown 1) (system:wall-time) $pos $neg))
            ($_ (ax:replace $bank $next)))
       (ax:shown $bank (cdr-atom $rows)))))
(= (ax:state $bank)
   (collapse (match $bank (StudyTrace $id $n $first $last $shown $latest $pos $neg)
     (StudyTrace $id $n $first $last $shown $latest $pos $neg))))
(= (ax:drop $bank $id)
   (collapse (match $bank (StudyTrace $id $n $first $last $shown $latest $pos $neg)
     (remove-atom $bank (StudyTrace $id $n $first $last $shown $latest $pos $neg)))))

; Bounded features: frequency-recency proxy, feedback mean, fading inhibition.
(= (ax:power $n $age $scale $decay)
   (if (== $n 0) 0
     (let $raw (if (== $scale 0) $n (/ $n (pow-math (+ 1 (/ (max 0 $age) $scale)) $decay)))
       (/ $raw (+ 1 $raw)))))
(= (ax:gain $positive $negative $prior)
   (let $total (+ (+ $positive $negative) (* 2 $prior))
     (if (> $total 0) (/ (+ $positive $prior) $total) 0.5)))
(= (ax:inhibition $shown $age $strength $half-life)
   (if (or (== $shown 0) (== $half-life 0)) 1
     (- 1 (* $strength (pow-math 0.5 (/ (max 0 $age) $half-life))))))
(= (ax:features $bank $id $sim $need $base)
   (let* (((StudyTrace $id $n $first $last $shown $latest $pos $neg) (ax:trace $bank $id))
          ((StudyConfig $arm $mix $decay $scale $prior $strength $half-life) (get-state &ax-config))
          ($now (get-state &ax-time))
          ($power (ax:power $n (- $now $last) $scale $decay))
          ($gain (ax:gain $pos $neg $prior))
          ($inhibition (ax:inhibition $shown (- $now $latest) $strength $half-life)))
     (StudyCandidate $id $sim $need $base $power $gain $inhibition)))
(= (ax:score $arm $mix (StudyCandidate $id $sim $need $base $power $gain $inhibition))
   (if (== $arm "baseline") $base
     (let $alternative (case $arm
       (("power-law" $power) ("gain-need" (* $need $gain))
        ("inhibition" (* $base $inhibition)) ($other $base)))
       (+ (* (- 1 $mix) $base) (* $mix $alternative)))))
(= (ax:rank $bank $id $sim $need $base)
   (let* (($candidate (ax:features $bank $id $sim $need $base))
          ((StudyConfig $arm $mix $a $b $c $d $e) (get-state &ax-config))
          ($_ (add-atom (get-state &ax-inputs) $candidate)))
     (ax:score $arm $mix $candidate)))

; The existing top-k certificate applies to the ordinary blended score.
; Experimental readouts use the caller's finite work budget, without claiming
; that certificate. Candidate expansion and workspace filtering stay native.
(= (ax:spread $bank $profile $vector $seeds $current $rounds $done $restart $mix $count $sims $floor)
   (if (== (ax:arm $bank) "baseline")
     (am:spread-certified $bank $profile $vector $seeds $current $rounds $done
                          $restart $mix $count $sims $floor)
     (let $result (am:rounds $bank $seeds $current $rounds $restart)
       (AttentionSpread $result (+ $done $rounds) ExperimentalUncertified))))
(= (ax:finish $bank $selected)
   (let* (($candidates (collapse (get-atoms (get-state &ax-inputs))))
          ($ids (am:hit-ids $selected))
          ($repeat (ax:repeat-share $bank $ids))
          ($label (ax:arm $bank))
          ($_ (change-state! &ax-last
            (AttentionStudy $label (Candidates $candidates) (Selected $ids)
              (Diagnostics (RepeatWithinHalfLife $repeat)))))) True))
(= (ax:repeat-share $bank $ids)
   (if (== $ids ()) 0
     (/ (ax:recent-count $bank $ids) (size-atom $ids))))
(= (ax:recent-count $bank $ids)
   (if (== $ids ()) 0
     (let (StudyTrace $id $n $first $last $shown $latest $pos $neg) (ax:trace $bank (car-atom $ids))
       (+ (if (and (> $shown 0) (<= (- (get-state &ax-time) $latest) (am:get $bank "inhibition-half-life"))) 1 0)
         (ax:recent-count $bank (cdr-atom $ids))))))

(= (attention-compare) (attention-compare 20))
(= (attention-compare $raw)
   (let* (($count (am:number $raw)) ($valid (am:integer count $count 0)))
     (if (== $valid True)
       (case (get-state &ax-last)
         (((AttentionStudy $used (Candidates $candidates) (Selected $ids) $diagnostics)
           (case (am:open)
             (((AttentionReady $bank $time)
               (StudyComparison (SameCandidatePool True) (PreQueryObservations True)
                 (Arms (ax:compare-arms (ax:arms) (am:get $bank "study-mix") $candidates $count))
                 $diagnostics)) ($error $error))))
          ($other (StudyUnavailable "run a hybrid/attention query first")))) $valid)))
(= (ax:compare-arms $arms $mix $candidates $count)
   (if (== $arms ()) ()
     (let* (($arm (car-atom $arms))
            ($scored (collapse (let $candidate (superpose $candidates)
              (let (StudyCandidate $id $a $b $c $d $e $f) $candidate
                (let $score (ax:score $arm $mix $candidate) ($score $id))))))
            ($top (list:retain-top-k-keyed $scored (if (== $count 0) (size-atom $scored) $count))))
       (cons-atom (StudyRanking $arm $top) (ax:compare-arms (cdr-atom $arms) $mix $candidates $count)))))
(= (attention-try $arm $text) (attention-try $arm $text 20))
(= (attention-try $arm $text $count)
   (if (memory:member $arm (ax:arms))
     (let* (($old (get-state &ax-override)) ($_ (change-state! &ax-override $arm))
            ($answer (catch (semantic:query $text $count "hybrid")))
            ($_ (change-state! &ax-override $old))) $answer)
     (StudyError selector "inspect attention-studies for available arms")))
(= (attention-feedback $id $rating) (attention-feedback $id $rating 1))
(= (attention-feedback $id $raw $weight-raw)
   (let* (($rating (am:number $raw)) ($weight (am:number $weight-raw))
          ($valid (and (== (ecan:fraction feedback usefulness $rating) True)
                       (== (ecan:nonnegative feedback weight $weight) True))))
     (if $valid
       (if (am:current? $id)
         (case (am:open)
           (((AttentionReady $bank $time)
             (let* (((StudyTrace $id $n $first $last $shown $latest $pos $neg) (ax:trace $bank $id))
                    ($next (StudyTrace $id $n $first $last $shown $latest
                             (+ $pos (* $weight $rating)) (+ $neg (* $weight (- 1 $rating)))))
                    ($_ (ax:replace $bank $next)) ($saved (am:save)))
               (StudyFeedback $id (GainProxy (ax:gain (+ $pos (* $weight $rating))
                 (+ $neg (* $weight (- 1 $rating))) (am:get $bank "gain-prior"))) (Persistence $saved))))
            ($error $error))) (StudyError memory "ID is absent or unavailable"))
       (StudyError feedback "expected usefulness in [0,1] and a nonnegative weight"))))

(= (attention-studies)
   (case (fs:read-text-result "./src/attention_studies.json" 0 "raw")
     ((("ok" $text) (json-parse $text)) ($error (StudyUnavailable $error)))))
