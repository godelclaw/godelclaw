; Completion and mail acceptance are different facts. The worker commits a
; pending ending in state.json; report-outbox holds immutable message bodies
; and separate accepted receipts. Recording acceptance never rewrites worker state.
; Retries share one occurrence id, including after a crash or session resume.
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library proc))
!(import! &self (library system))
!(import! &self (library str))
!(import! &self (library json))
!(import! &self ./mail_cetta.metta)

(= (delivery:json $path) (if (fs:is-file $path) (json-parse (fs:read-text $path)) (JsonObject ())))
(= (delivery:field $value $key)
   (case $value (((JsonObject $pairs) (delivery:member $pairs $key)) ($other JsonNull))))
(= (delivery:member $pairs $key)
   (if (== $pairs ()) JsonNull
     (let (JsonPair $name $value) (car-atom $pairs)
       (if (== $name $key) $value (delivery:member (cdr-atom $pairs) $key)))))
(= (delivery:text $value)
   (case $value (((JsonString $text) $text) ((JsonNumber $text) $text) ($other ""))))
(= (delivery:last $items) (if (== (cdr-atom $items) ()) (car-atom $items) (delivery:last (cdr-atom $items))))
(= (delivery:outbox $dir) (path:join $dir "report-outbox"))
(= (delivery:space $task $requester)
   (case (delivery:field $task "requester_space")
     (((JsonString $space) $space)
      ($other (if (== $requester (system:getenv-or-default "METTACLAW_MAIL_NAME" ""))
                (system:getenv-or-default "METTACLAW_MAIL_SPACE" "agent-mail") "")))))
(= (delivery:report $dir $state)
   (if (or (== (delivery:field $state "delivery_version") (JsonNumber "1"))
           (== (delivery:field $state "delivery_version") (JsonNumber "2")))
     (delivery:text (delivery:field $state "progress"))
     (if (fs:is-file (path:join $dir "report.txt")) (fs:read-text (path:join $dir "report.txt")) "")))
(= (delivery:identity $dir $state $status)
   (let $previous (if (== (delivery:field $state "status") (JsonString $status))
                    (delivery:text (delivery:field $state "delivery_id")) "")
     (if (!= $previous "") $previous
       (let $report (if (== (delivery:field $state "delivery_version") JsonNull) (delivery:report $dir $state) "")
       (str:char-slice (str:sha256 (json-stringify (JsonArray (
         (JsonString (delivery:last (str:split "/" $dir))) (JsonString $status)
         (JsonString $report) (delivery:field $state "updated") (delivery:field $state "steps"))))) 0 32)
       ))))
(= (delivery:message-path $dir $state $status)
   (path:join (delivery:outbox $dir) (str:concat (delivery:identity $dir $state $status) ".json")))

; Read all message facts from one ending snapshot. Once queued, neither a
; changed report.txt nor a running/resumed worker can change those bytes.
(= (delivery:prepare $dir $state $status)
   (let* (($task (delivery:json (path:join $dir "task.json")))
          ($requester (delivery:text (delivery:field $task "requester"))))
     (if (== $requester "") ""
       (let* (($id (delivery:last (str:split "/" $dir)))
              ($steps (delivery:text (delivery:field $state "steps")))
              ($report (delivery:report $dir $state))
              ($mail (delivery:identity $dir $state $status))
              ($path (path:join (delivery:outbox $dir) (str:concat $mail ".json"))))
         (if (fs:is-file $path) $path
           (delivery:write $dir $path $mail $id $requester $task $state $status $steps $report))))))
(= (delivery:write $dir $path $mail $id $requester $task $state $status $steps $report)
   (let* (($text (str:join "" ("Work " $id " " $status " after " (if (== $steps "") "0" $steps)
                                   " steps. Ending recorded at " (delivery:text (delivery:field $state "updated"))
                                   ". Task: " (delivery:text (delivery:field $task "task"))
                                   "\n\nReport:\n" $report)))
              ($envelope (JsonObject ((JsonPair "id" (JsonString $mail)) (JsonPair "from" (JsonString $id))
                                     (JsonPair "to" (JsonString $requester)) (JsonPair "text" (JsonString $text))
                                     (JsonPair "space" (JsonString (delivery:space $task $requester))))))
              ($_ (fs:make-directories (delivery:outbox $dir) 504))
              ($_ (fs:update-text $path "replace" (json-stringify $envelope) "" "")))
     $path))

(= (delivery:accepted? $text $id)
   (let* (($receipt (json-parse $text))
          ($status (delivery:text (delivery:field $receipt "status"))))
     (and (== (delivery:field $receipt "id") (JsonString $id))
          (or (== $status "accepted") (== $status "duplicate")))))
(= (delivery:failure $result)
   (case $result
     (((proc:exited 0 $out $err) "mailer returned no matching acceptance receipt")
      ((proc:exited $code $out $err) (str:join "" ("mailer exited " (repr $code) ": " (str:trim $err))))
      ((proc:signaled $signal $out $err) (str:concat "mailer killed by signal " (repr $signal)))
      ((proc:timed-out $out $err) "mailer timed out")
      ($other "mailer did not run"))))
(= (delivery:native $item $id)
   (let* (($socket (system:getenv-or-default "METTACLAW_MAIL_SOCKET"
                    (system:getenv-or-default "CETTA_SHARED_MAIL_SOCKET" "")))
          ($to (delivery:text (delivery:field $item "to")))
          ($explicit (delivery:text (delivery:field $item "space")))
          ((mail:route-to $routed $recipient) (mail:route $to))
          ($space (if (== $explicit "") $routed $explicit))
          ($sender (delivery:text (delivery:field $item "from")))
          ($body (delivery:text (delivery:field $item "text"))))
     (if (== $socket "") (DeliveryFailedV1 "native mailbox has no configured socket")
       (case (mailbox:send $socket $space $id $recipient $sender $body)
         (((mailbox:sent $sent $status)
           (if (and (== $sent $id) (or (== $status accepted) (== $status duplicate)))
             (DeliveryAcceptedV1 (json-stringify (JsonObject
               ((JsonPair "id" (JsonString $id)) (JsonPair "status" (JsonString (mail:text $status)))))))
             (DeliveryFailedV1 "native mailbox returned no matching acceptance")))
          ($bad (DeliveryFailedV1 "native mailbox has not established acceptance; retain this occurrence for retry")))))))
; An explicitly configured custom transport remains an external tool. The
; ordinary claw-mail command, including its absolute installed path, uses the
; native mailbox path and never launches its Python CLI.
(= (delivery:submit $dir $item $id $mailer)
   (if (or (== $mailer "") (== (delivery:last (str:split "/" $mailer)) "claw-mail"))
     (delivery:native $item $id)
     (let* (($sender (delivery:text (delivery:field $item "from")))
            ($to (delivery:text (delivery:field $item "to")))
            ($body (delivery:text (delivery:field $item "text")))
            ($space (delivery:text (delivery:field $item "space")))
            ($argv ($mailer "send" $to $body "--id" $id "--json" "--space" $space))
            ($result (proc:run $argv $dir (inherit (("CLAW_MAIL_AGENT" $sender))) 60000 0 "separate")))
       (case $result
         (((proc:exited 0 $out $err)
           (if (delivery:accepted? $out $id) (DeliveryAcceptedV1 $out)
             (DeliveryFailedV1 (delivery:failure $result))))
          ($failed (DeliveryFailedV1 (delivery:failure $failed))))))))
(= (delivery:attempt $dir $path)
   (if (== $path "") "none"
     (if (fs:is-file (str:concat $path ".accepted")) "delivered"
       (let* (($item (delivery:json $path))
              ($id (delivery:text (delivery:field $item "id")))
              ($mailer (system:getenv-or-default "METTACLAW_WORK_MAIL" "claw-mail")))
         (if (== $id "") (delivery:pending-error $path "report envelope has no message identity")
           (case (delivery:submit $dir $item $id $mailer)
             (((DeliveryAcceptedV1 $receipt)
               (let $_ (fs:update-text (str:concat $path ".accepted") "replace" $receipt "" "")
                 (if (fs:is-file (str:concat $path ".accepted")) "delivered" "pending")))
              ((DeliveryFailedV1 $why) (delivery:pending-error $path $why))
              ($bad (delivery:pending-error $path "mail transport produced no acceptance receipt")))))))))
(= (delivery:pending-error $path $why)
   (let $_ (fs:update-text (str:concat $path ".error") "replace" $why "" "") "pending"))
(= (delivery:preserve $dir)
   (let $state (delivery:json (path:join $dir "state.json"))
     (if (== (delivery:field $state "delivery") (JsonString "pending"))
       (delivery:prepare $dir $state (delivery:text (delivery:field $state "status"))) "")))
(= (delivery:flush $dir)
   (if (fs:exists (delivery:outbox $dir))
     (delivery:flush-names $dir (fs:entries (delivery:outbox $dir))) 0))
(= (delivery:flush-names $dir $names)
   (if (== $names ()) 0
     (let* (($name (car-atom $names))
            ($_ (if (str:ends-with $name ".json") (delivery:attempt $dir (path:join (delivery:outbox $dir) $name)) ())))
       (delivery:flush-names $dir (cdr-atom $names)))))

(= (delivery:scan $dir $names $total $pending)
   (if (== $names ()) (ReportMail $total $pending)
     (let* (($name (car-atom $names)) ($message (str:ends-with $name ".json"))
            ($waiting (and $message (not (fs:is-file (str:concat (path:join (delivery:outbox $dir) $name) ".accepted"))))))
       (delivery:scan $dir (cdr-atom $names) (+ $total (if $message 1 0)) (+ $pending (if $waiting 1 0))))))
(= (delivery:status $dir)
   (let* (($state (delivery:json (path:join $dir "state.json")))
          ($names (if (fs:exists (delivery:outbox $dir)) (fs:entries (delivery:outbox $dir)) ()))
          ((ReportMail $total $pending) (delivery:scan $dir $names 0 0))
          ($current (delivery:message-path $dir $state (delivery:text (delivery:field $state "status"))))
          ($waiting (and (== (delivery:field $state "delivery") (JsonString "pending"))
                     (not (fs:is-file (str:concat $current ".accepted"))))))
     (if (or (> $pending 0) $waiting) "pending"
       (if (> $total 0) "accepted"
         (delivery:text (delivery:field $state "delivery"))))))

(= (coding:deliver $dir $status)
   (delivery:attempt $dir (delivery:prepare $dir (delivery:json (path:join $dir "state.json")) $status)))
(= (coding:announce $dir $status)
   (let* (($outcome (coding:deliver $dir $status))
          ($worklog (system:getenv-or-default "METTACLAW_WORKLOG_COMMAND" ""))
          ($report (if (fs:is-file (path:join $dir "report.txt")) (fs:read-text (path:join $dir "report.txt")) ""))
          ($id (delivery:last (str:split "/" $dir)))
          ($_ (if (== $worklog "") ()
                (proc:run ($worklog "add" (str:join "" ("Work " $id " " $status ": " (str:char-slice $report 0 900))))
                          $dir inherit 60000 0 "merged"))))
     $outcome))
