; Resource claims and durable dispatch registration, without external I/O.
; Active frontiers contain only live claims; the archive is never scanned.
; A registered intent means the transport may run, not provider acceptance.
!(import! &self ./provider_admission_cetta.metta)

(= (pc:lane? $lane)
  (case $lane ((ProviderInteractiveV3 True) (ProviderBackgroundV3 True) ($other False))))
(= (pc:activity? $activity)
  (case $activity
    ((ProviderExclusiveActivityV3 True)
     ((ProviderNamedActivityV3 $name $lane)
      (if (provider-domain:id? $name) (pc:lane? $lane) False))
     ($other False))))
(= (pc:policy? $policy)
  (case $policy
    (((ProviderSchedulerPolicyV3 $capacity $reserve)
      (if (pa:positive-integer? $capacity)
        (if (pa:integer? $reserve) (if (>= $reserve 0) (< $reserve $capacity) False) False) False))
     ($other False))))
(= (pc:entry? $entry)
  (case $entry
    (((ProviderActiveClaimV3 $call $owner $process $activity)
      (if (provider-domain:id? $call)
        (if (provider-domain:id? $owner)
          (if (provider-domain:id? $process) (pc:activity? $activity) False) False) False))
     ($other False))))
(= (pc:background? $entry)
  (case $entry
    (((ProviderActiveClaimV3 $call $owner $process (ProviderNamedActivityV3 $name ProviderBackgroundV3)) True)
     ($other False))))
(= (pc:conflicting
      (ProviderActiveClaimV3 $call $owner $process $activity)
      (ProviderActiveClaimV3 $other $old-owner $old-process $old-activity))
  (if (== $call $other) True
    (case ($activity $old-activity)
      (((ProviderExclusiveActivityV3 $old) True)
       (($new ProviderExclusiveActivityV3) True)
       (((ProviderNamedActivityV3 $name $lane) (ProviderNamedActivityV3 $old-name $old-lane)) (== $name $old-name))
       ($other True)))))
(= (pc:any-conflict $incoming $entries)
  (if (== $entries ()) False
    (if (pc:entry? (car-atom $entries))
      (if (pc:conflicting $incoming (car-atom $entries)) True
        (pc:any-conflict $incoming (cdr-atom $entries))) True)))
(= (pc:frontier? $entries)
  (if (== $entries ()) True
    (if (pc:entry? (car-atom $entries))
      (if (pc:any-conflict (car-atom $entries) (cdr-atom $entries)) False
        (pc:frontier? (cdr-atom $entries))) False)))
(= (pc:background-count $entries)
  (if (== $entries ()) 0
    (+ (if (pc:background? (car-atom $entries)) 1 0) (pc:background-count (cdr-atom $entries)))))
(= (pc:eligible (ProviderSchedulerPolicyV3 $capacity $reserve) $entries $incoming)
  (if (pc:policy? (ProviderSchedulerPolicyV3 $capacity $reserve))
    (if (pc:frontier? $entries)
      (if (pc:entry? $incoming)
        (if (pc:any-conflict $incoming $entries) False
          (if (< (size-atom $entries) $capacity)
            (if (pc:background? $incoming) (< (pc:background-count $entries) (- $capacity $reserve)) True)
            False)) False) False) False))

(= (pc:keys $command)
  (case $command
    (((ProviderAcquireV3 $scope $call $owner $process $activity)
      (if (provider-domain:id? $scope)
        (if (pc:entry? (ProviderActiveClaimV3 $call $owner $process $activity))
          (ProviderClaimKeysV3
            ((ProviderCallKeyV2 $call) (ProviderLeaseKeyV2 $call) (ProviderAdmissionKeyV2 $call)
             (ProviderClaimKeyV3 $call) (ProviderAnswerKeyV2 $call) (ProviderDispatchKeyV3 $call)
             (ProviderAttemptKeyV2 $call $owner)
             (ProviderSchedulerPolicyKeyV3 $scope) (ProviderActiveClaimsKeyV3 $scope)
             (ProviderActiveClaimKeyV3 $scope $call)))
          (ProviderClaimRefusedV3 claim-format))
        (ProviderClaimRefusedV3 scope-identity)))
     ((ProviderBeginDispatchV3 $call $owner $process $transport)
      (if (provider-domain:id? $call)
        (if (provider-domain:id? $owner)
          (if (provider-domain:id? $process)
            (if (kb:ground-identity? $transport)
              (ProviderClaimKeysV3
                ((ProviderCallKeyV2 $call) (ProviderLeaseKeyV2 $call) (ProviderClaimKeyV3 $call)
                 (ProviderAnswerKeyV2 $call) (ProviderDispatchKeyV3 $call) (ProviderAttemptKeyV2 $call $owner)))
              (ProviderClaimRefusedV3 transport-identity))
            (ProviderClaimRefusedV3 process-identity))
          (ProviderClaimRefusedV3 owner-identity))
        (ProviderClaimRefusedV3 call-identity)))
     ($other (ProviderClaimRefusedV3 command-format)))))
(= (pc:observe $view $command $budget)
  (case (pc:keys $command)
    (((ProviderClaimKeysV3 $identities)
      (case (kb:observe $view $identities $budget)
        (((KnowledgeObservedV1 $points $reads)
          (case $command
            (((ProviderBeginDispatchV3 $call $owner $process $transport)
              (case (kb:lookup $points (ProviderClaimKeyV3 $call))
                (((KnowledgePresentV1 (ProviderClaimV3 $scope $old-owner $old-process $activity $stage))
                  (case (kb:observe $view ((ProviderActiveClaimKeyV3 $scope $call)) $budget)
                    (((KnowledgeObservedV1 $more $extra)
                      (KnowledgeObservedV1 (kb:append $points $more)
                        (cons-atom reads (kb:append (cdr-atom $reads) (cdr-atom $extra)))))
                     ($error $error))))
                 ($other (KnowledgeObservedV1 $points $reads)))))
             ($acquire (KnowledgeObservedV1 $points $reads)))))
         ($error $error))))
     ($error $error))))
(= (pc:refuse $why) (ProviderClaimPlanV3 (ProviderClaimRefusedV3 $why) ()))
(= (pc:frontier $points $scope)
  (case (kb:lookup $points (ProviderActiveClaimsKeyV3 $scope))
    ((KnowledgeAbsentV1 (ProviderFrontierV3 ()))
     ((KnowledgePresentV1 (ProviderActiveClaimsV3 $entries))
      (if (pc:frontier? $entries) (ProviderFrontierV3 $entries) (ProviderClaimRefusedV3 frontier-format)))
     ($other (ProviderClaimRefusedV3 frontier-format)))))
(= (pc:find-call $entries $call)
  (if (== $entries ()) KnowledgeAbsentV1
    (let (ProviderActiveClaimV3 $identity $owner $process $activity) (car-atom $entries)
      (if (== $identity $call) (KnowledgePresentV1 (car-atom $entries))
        (pc:find-call (cdr-atom $entries) $call)))))

(= (pc:plan (ProviderAcquireV3 $scope $call $owner $process $activity) $points)
  (let* (($info (kb:lookup $points (ProviderCallKeyV2 $call)))
         ($admission (kb:lookup $points (ProviderAdmissionKeyV2 $call)))
         ($lease (kb:lookup $points (ProviderLeaseKeyV2 $call))))
    (case ($info $admission $lease)
      ((((KnowledgePresentV1 $call-info)
         (KnowledgePresentV1 (ProviderAdmissionV2 $original $recorded-info $terms))
         (KnowledgePresentV1 (ProviderLeaseV2 $current ProviderLeaseActiveV2)))
        (if (== $current $owner)
          (case (kb:same $call-info $recorded-info)
            (((KnowledgeEqualV1 True)
              (if (pa:admit? $call $original $recorded-info $terms)
                (pc:acquire-context $scope $call $owner $process $activity $points)
                (pc:refuse admission-format)))
             ($other (pc:refuse admission-format))))
          (pc:refuse not-owned)))
       ($other (pc:refuse active-admission-required))))))
(= (pc:acquire-context $scope $call $owner $process $activity $points)
  (case (kb:lookup $points (ProviderSchedulerPolicyKeyV3 $scope))
    (((KnowledgePresentV1 $policy)
      (if (pc:policy? $policy)
        (case (pc:frontier $points $scope)
          (((ProviderFrontierV3 $entries)
            (pc:acquire-ready $scope $call $owner $process $activity $points $policy $entries))
           ((ProviderClaimRefusedV3 $why) (pc:refuse $why))
           ($other (pc:refuse frontier-format))))
        (pc:refuse scheduler-policy-format)))
     ($other (pc:refuse scheduler-policy-required)))))
(= (pc:acquire-ready $scope $call $owner $process $activity $points $policy $entries)
  (let* (($claim (kb:lookup $points (ProviderClaimKeyV3 $call)))
         ($entry (ProviderActiveClaimV3 $call $owner $process $activity)))
    (case $claim
      ((KnowledgeAbsentV1
        (case ((kb:lookup $points (ProviderAnswerKeyV2 $call))
               (kb:lookup $points (ProviderDispatchKeyV3 $call))
               (kb:lookup $points (ProviderAttemptKeyV2 $call $owner))
               (kb:lookup $points (ProviderActiveClaimKeyV3 $scope $call))
               (pc:find-call $entries $call))
          (((KnowledgeAbsentV1 KnowledgeAbsentV1 KnowledgeAbsentV1 KnowledgeAbsentV1 KnowledgeAbsentV1)
            (if (pc:eligible $policy $entries $entry)
              (ProviderClaimPlanV3 (ProviderClaimAcquiredV3 $call)
                ((KnowledgePutV1 (ProviderClaimKeyV3 $call)
                   (ProviderClaimV3 $scope $owner $process $activity ProviderClaimReservedV3))
                 (KnowledgePutV1 (ProviderActiveClaimsKeyV3 $scope)
                   (ProviderActiveClaimsV3 (kb:append $entries (cons-atom $entry ()))))
                 (KnowledgePutV1 (ProviderActiveClaimKeyV3 $scope $call) $entry)))
              (ProviderClaimPlanV3 (ProviderClaimBusyV3 $call) ())))
           ($other (pc:refuse inconsistent-claim)))))
       ((KnowledgePresentV1 $stored)
        (pc:existing-claim $scope $call $owner $process $activity $points $entries $stored))
       ($other (pc:refuse stored-claim-format))))))

(= (pc:existing-claim $scope $call $owner $process $activity $points $entries $stored)
  (case $stored
    (((ProviderClaimV3 $old-scope $old-owner $old-process $old-activity $stage)
      (case (kb:same ($scope $owner $process $activity) ($old-scope $old-owner $old-process $old-activity))
        (((KnowledgeEqualV1 True)
          (let $expected (KnowledgePresentV1 (ProviderActiveClaimV3 $call $owner $process $activity))
            (case (kb:same ((pc:find-call $entries $call)
                           (kb:lookup $points (ProviderActiveClaimKeyV3 $scope $call)))
                          ($expected $expected))
              (((KnowledgeEqualV1 True) (ProviderClaimPlanV3 (ProviderClaimAlreadyOwnedV3 $call $stage) ()))
               ($other (pc:refuse inconsistent-claim))))))
         ($other (pc:refuse claim-owner-conflict)))))
     ($other (pc:refuse stored-claim-format)))))

(= (pc:plan (ProviderBeginDispatchV3 $call $owner $process $transport) $points)
  (case (kb:lookup $points (ProviderDispatchKeyV3 $call))
    ((KnowledgeAbsentV1 (pc:dispatch-fresh $call $owner $process $transport $points))
     ((KnowledgePresentV1 $existing)
      (case (kb:same $existing (ProviderDispatchIntentV3 $call $owner $process $transport))
        (((KnowledgeEqualV1 True) (ProviderClaimPlanV3 (ProviderIntentAlreadyRegisteredV3 $call $transport) ()))
         ($other (pc:refuse dispatch-identity-conflict)))))
     ($other (pc:refuse dispatch-not-observed)))))
(= (pc:dispatch-fresh $call $owner $process $transport $points)
  (case ((kb:lookup $points (ProviderCallKeyV2 $call))
         (kb:lookup $points (ProviderClaimKeyV3 $call))
         (kb:lookup $points (ProviderLeaseKeyV2 $call))
         (kb:lookup $points (ProviderAnswerKeyV2 $call))
         (kb:lookup $points (ProviderAttemptKeyV2 $call $owner)))
    ((((KnowledgePresentV1 (ProviderCallInfoV2 $provider $model $purpose $origin))
       (KnowledgePresentV1 (ProviderClaimV3 $scope $who $birth $activity ProviderClaimReservedV3))
       (KnowledgePresentV1 (ProviderLeaseV2 $current ProviderLeaseActiveV2)) KnowledgeAbsentV1 KnowledgeAbsentV1)
      (if (== $owner $who)
        (if (== $process $birth)
          (if (== $owner $current)
            (pc:dispatch-index $scope $call $owner $process $activity $transport $points)
            (pc:refuse not-owned))
          (pc:refuse not-owned))
        (pc:refuse not-owned)))
     ($other (pc:refuse reserved-claim-required)))))

(= (pc:dispatch-index $scope $call $owner $process $activity $transport $points)
  (case (kb:same (kb:lookup $points (ProviderActiveClaimKeyV3 $scope $call))
                (KnowledgePresentV1 (ProviderActiveClaimV3 $call $owner $process $activity)))
    (((KnowledgeEqualV1 True)
      (ProviderClaimPlanV3 (ProviderIntentRegisteredV3 $call $transport)
        ((KnowledgePutV1 (ProviderDispatchKeyV3 $call) (ProviderDispatchIntentV3 $call $owner $process $transport))
         (KnowledgePutV1 (ProviderClaimKeyV3 $call)
           (ProviderClaimV3 $scope $owner $process $activity (ProviderClaimDispatchV3 $transport)))
         ; This is registered potential submission, not remote acceptance.
         (KnowledgePutV1 (ProviderAttemptKeyV2 $call $owner) (ProviderSubmittedAttemptV2 $transport)))))
     ($other (pc:refuse active-claim-index)))))

(= (pc:execute $owner $view $receipt $command $budget)
  (case (kb:receipt $view $receipt $command $budget)
    ((KnowledgeReceiptAbsentV1
      (case (pc:observe $view $command $budget)
        (((KnowledgeObservedV1 $points $reads)
          (case (pc:plan $command $points)
            (((ProviderClaimPlanV3 $answer $changes)
              (kb:publish $owner $view $reads $receipt $command $answer $changes $budget))
             ($error $error))))
         ($error $error))))
     ($replay-or-error $replay-or-error))))
