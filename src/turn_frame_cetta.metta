; Process-local turn observations. The ledger remains the durable authority.
!(import! &self ./state_ledger.metta)
!(import! &self ./effect_receipt_values_cetta.metta)
!(import! &self ./input_scope_cetta.metta)
!(import! &self ./loop_modes_cetta.metta)
!(import! &self ./lifecycle_cetta.metta)
!(import! &self ./boot_state_cetta.metta)
!(import! &self ./turn_health_cetta.metta)
!(import! &self ./agent_history_cetta.metta)
!(bind! &turn-frame (new-state ()))

(= (strategy:enabled?) (== (system:getenv-or-default "METTACLAW_OBSERVED_STRATEGY" "0") "1"))
(= (strategy:enabled-flag) (if (strategy:enabled?) 1 0))

(= (turn:find $fields $key $default)
   (if (== $fields ()) $default
     (let (($name $value) $rest) (decons-atom $fields)
       (if (== $key $name) $value (turn:find $rest $key $default)))))
(= (turn:without $fields $key)
   (if (== $fields ()) ()
     (let (($name $value) $rest) (decons-atom $fields)
       (let $tail (turn:without $rest $key)
         (if (== $name $key) $tail (cons-atom ($name $value) $tail))))))
(= (turn:get $key $default) (turn:find (get-state &turn-frame) $key $default))
(= (turn:put $key $value)
   (let $rest (turn:without (get-state &turn-frame) $key)
     (let $_ (change-state! &turn-frame (cons-atom ($key $value) $rest)) $value)))
(= (turn:clear)
   (change-state! &turn-frame ()))
(= (turn:failed? $value)
   (case $value (((Error $_ $_) True) ((ContextPreparationFailed $_) True) ($other False))))
(= (turn:text $value)
   ; A callable head remains a value; ($value) would invoke a nullary command.
   (if (== (get-type $value) String) $value (format-args "{}" (cons-atom $value ()))))
(= (turn:json $value)
   (json:stringify-python-with $value ((ensure-ascii False) (sort-keys True) (separators "," ":"))))
(: turn:command-json (-> Atom %Undefined%))
(= (turn:command-json $commands) (turn:json (erv:cross $commands)))
(: turn:syntax-text (-> Atom %Undefined%))
(= (turn:syntax-text $value) (repr (quote $value)))
(= (turn:digest $value) (str:sha256 (turn:json $value)))
(= (turn:write $verb $arguments)
   (let $id (state:request-id)
     (state:ledger $verb (list:append $arguments ($id)))))
(= (turn:checked $where $answer $expected)
   (if (== $answer $expected) True (Error $where $answer)))
(= (turn:owner)
   (let $cached (turn:get "owner" "")
     (if (not (== $cached "")) $cached
       (let $owner (turn:write "owner" ((system:uuid4-hex)))
         (if (== (get-type $owner) String) (turn:put "owner" $owner)
           (Error turn:owner $owner))))))
(= (turn:focus) (turn:get "focus" "autonomous"))
(= (turn:trigger) (turn:get "trigger" "continuation-tick"))
(= (turn:cognition-paused?)
   (case (lifecycle-native:enabled) ((1 False) ($unavailable True))))
(= (turn:sample) (turn:get "sample" none))
(= (turn:serial)
   (case (turn:sample) (((captured $serial $revision $mode $owner) $serial) ($none -1))))
(= (turn:commit-scope $activity)
   (if (and (strategy:enabled?) (or (== (turn:get "phase" "") "failed") (== (turn:get "phase" "") "begin")))
     (Error turn:commit-scope failed-turn)
     ((if (== $activity 1) (turn:get "inputs" ()) ()) (turn:get "message-focus" ""))))
(= (turn:context-presented $text)
   (case (catch (json:parse $text))
     (((JsonArray $ids) (let $_ (turn:put "presented" $ids) 1))
      ($bad (Error turn:context-presented invalid-call-identities)))))
(= (turn:context-prepared $digest $incomplete)
   (if (and (== (str:char-length $digest) 64) (or (== $incomplete 0) (== $incomplete 1)))
     (let* (($ids (turn:get "presented" ())) ($_ (turn:put "prepared" (PreparedContextV1 $digest $incomplete $ids)))
            ($_ (turn:put "presented" ()))) 1)
     (Error turn:context-prepared invalid-context-receipt)))
(= (turn:call-id $identity)
   (let* (($parts (str:split ":" $identity)) ($n (size-atom $parts)))
     (if (< $n 2) none
       (let* (($position (str:string->number (index-atom $parts (- $n 1))))
              ($ticket (str:join ":" (list:take (- $n 1) $parts))))
         (if (and (== (get-type $position) Number) (>= $position 0)) ($ticket $position) none)))))
(= (turn:presented-pairs $ids)
   (if (== $ids ()) ()
     (let* (($id (car-atom $ids)) ($rest (turn:presented-pairs (cdr-atom $ids))))
       (case $id
         (((JsonString $text) (case (turn:call-id $text) ((none $rest) ($pair (cons-atom $pair $rest)))))
          ($other $rest))))))
(= (turn:observe-chunks $pairs)
   (if (== $pairs ()) True
     (let $answer (turn:write "observe" ((list:take 20 $pairs)))
       (if (== $answer True) (turn:observe-chunks (list:drop 20 $pairs)) $answer))))
(= (turn:observe-presented)
   (let* (($ids (turn:get "answered-presented" ())) ($_ (turn:put "answered-presented" ())))
     (if (== $ids ()) True
       (let $pairs (state:ledger "presented-receipts" ((turn:presented-pairs $ids)))
         (if (turn:failed? $pairs) $pairs (turn:observe-chunks $pairs))))))
(= (turn:capture $prompt $wake)
   (if (not (strategy:enabled?)) 1
     (if (!= (turn:get "phase" "") "preparing") (Error turn:capture turn-not-prepared)
       (turn:capture-ready $prompt $wake))))
(= (turn:capture-ready $prompt $wake)
   (if (not (strategy:enabled?)) 1
     (let* (($control (turn:write "control" (none (turn:cognition-paused?) none)))
            ($owner (turn:owner)))
       (if (or (turn:failed? $control) (turn:failed? $owner)) (Error turn:capture unavailable)
         (let $sample (turn:write "capture" ((turn:focus) (turn:digest $prompt) "{}" "" $owner))
           (case $sample
             (((captured $serial $revision $mode $captured-owner)
               (let* (($digest (str:sha256 $prompt))
                      ($receipt (turn:get "prepared" none))
                      ($exact (case $receipt (((PreparedContextV1 $wanted $_ $_) (== $wanted $digest)) ($other False))))
                      ($_ (turn:put "sample" $sample))
                      ($_ (turn:put "context-incomplete"
                            (if $exact (case $receipt (((PreparedContextV1 $_ $flag $_) $flag))) 1)))
                      ($_ (turn:put "answered-presented"
                            (if $exact (case $receipt (((PreparedContextV1 $_ $_ $ids) $ids))) ())))
                      ($_ (turn:put "prepared" none))
                      ($_ (turn:put "phase" "captured"))) 1))
              (paused 0)
              ($bad (Error turn:capture $bad)))))))))
(= (turn:broker-turn $fallback)
   (if (or (not (strategy:enabled?)) (< (turn:serial) 0)) $fallback (+ (turn:serial) 1)))
(= (turn:feedback $reason)
   (let $_ (turn:put "broker-feedback" $reason)
     (0 "")))
(= (turn:broker-feedback)
   (turn:json (JsonObject ((JsonPair "reason" (JsonString (turn:get "broker-feedback" "no-current-capture")))))))
(: turn:broker-begin (-> Number Atom Number %Undefined%))
(= (turn:broker-begin $turn $commands $limit)
   (let $calls (case $commands (((quote $items) $items) ($items $items)))
     (if (not (strategy:enabled?)) (1 "")
       (if (or (< (turn:serial) 0) (!= $turn (+ (turn:serial) 1)))
         (turn:feedback "no-current-capture")
         (case (state:meta "pending")
           (((JsonNumber $pending)
             (if (!= (str:string->number $pending) (turn:serial)) (turn:feedback "capture-already-settled")
               (turn:decide-batch $turn $calls)))
            ($other (turn:feedback "capture-already-settled"))))))))
(: turn:decide-batch (-> Number Atom %Undefined%))
(= (turn:decide-batch $turn $calls)
   (let* (($serial (turn:serial)) ($focus (turn:focus)) ($commands (turn:command-json $calls))
          ($proposed (turn:write "task-proposal" ($serial $focus $commands "not run: batch interrupted"))))
     (if (!= $proposed ok) (Error turn:broker-begin $proposed)
       (let* (($empty (== $calls ()))
              ($command (if $empty ""
                (turn:json (JsonObject ((JsonPair "commands" (erv:cross $calls))
                                       (JsonPair "limit" (size-atom $calls)))))))
              ($decided (turn:write "decide" ($serial (if $empty "text" "command") (if $empty "" "batch") $command))))
         (case $decided
           (((issued $ticket) (turn:admitted $turn $ticket))
            ((decided $kind) (turn:admitted $turn ""))
            (ignored (turn:feedback "capture-already-settled"))
            ($bad (Error turn:broker-begin $bad))))))))
(= (turn:admitted $turn $ticket)
   (let* (($_ (turn:put "turn" (turn:text $turn))) ($_ (turn:put "ticket" $ticket))
          ($_ (turn:put "broker-feedback" "recorded")) ($_ (turn:put "phase" "executing"))
          ($observed (turn:observe-presented)))
     (let $_ (if (turn:failed? $observed) (println! (OBSERVE_PRESENTED_FAILED $observed)) True)
       (1 $ticket))))
(= (turn:report $ticket $payload)
   (turn:write "report" ($ticket $payload "returned" "unknown" (turn:digest $payload) (str:char-length $payload))))
(: turn:after-broker-report (-> Number String %Undefined%))
(= (turn:after-broker-report $turn $ticket) True)
(: turn:broker-end (-> Number Atom %Undefined%))
(= (turn:broker-end $turn $records)
   (if (== (turn:get "phase" "") "failed") (Error turn:broker-end failed-attempt)
    (if (and (strategy:enabled?) (== (turn:text $turn) (turn:get "turn" "")))
     (let $ticket (turn:get "ticket" "")
       (if (== $ticket "") $records
         (let $answer (turn:report $ticket (turn:syntax-text $records))
           (if (turn:failed? $answer) $answer
             (let* (($_ (turn:put "phase" "reported"))
                    ($after (turn:after-broker-report $turn $ticket)))
               (if (turn:failed? $after) $after $records))))))
     $records)))
(= (turn:provider-failed)
   (if (< (turn:serial) 0) 1
     (let $answer (turn:write "decide" ((turn:serial) "failure" "" ""))
       (if (turn:failed? $answer) $answer 1))))
(= (turn:conversation-mode)
   (if (or (not (strategy:enabled?)) (== (turn:trigger) "operator-event")) "chat" "task"))
(= (turn:retire-goal $name $reason) 0)
(= (turn:goal-review-save $digest $entries) "Goal inventory reviews are no longer required. Use goals and goal-write as needed.")
(= (turn:wake $now) 0)
(= (turn:autonomous-ready $scheduled) $scheduled)

; A fresh turn resets volatile observations, never the durable input set.
(= (turn:boot)
   (if (turn:get "booted" False) True
     (let* (($owner (turn:owner)) ($restored (turn:write "restore" ())))
       (if (or (turn:failed? $owner) (!= $restored True)) (Error turn:boot unavailable)
         (let $recovered (turn:recover-actions)
           (if (turn:failed? $recovered) $recovered (turn:put "booted" True)))))))
(= (turn:current-focus)
   (case (state:meta "context_focus")
     (((JsonString $focus) $focus) (JsonNull none) ($error $error))))
(= (turn:selectable? $request)
   (case (state:ledger "request-get" ($request head))
     (((got $id $kind $checker $status $processed $note $content)
       (or (== $status "active") (and (== $status "processed") (or (== $kind "message") (== $kind "notification")))))
      ($other False))))
(= (turn:accept $request $message $kind)
   (let $answer (turn:write "request-accept"
                 ($request $message "operator" $kind
                   (str:char-slice $message 0 (min 180 (str:char-length $message))) (turn:digest $message)))
     (case $answer ((created True) (exists True) ($bad (Error turn:accept $bad))))))
(= (turn:begin $turn $source $message)
   (turn:begin $turn $source $message (input-scope:json)))
(= (turn:begin $turn $source $message $ids-json)
   (case (catch (json:parse $ids-json))
     (((JsonArray $items)
       (case (input-scope:decode-ids $items)
         (((InputScopeIdsV1 $ids)
           (turn:begin-ids $turn (turn:text $source) $message (sort-strings (unique-atom $ids))))
          ($bad (Error turn:begin invalid-delivery-identities)))))
      ($bad (Error turn:begin invalid-delivery-identities)))))
(= (turn:begin-ids $turn $source $message $ids)
   (let $incoming (and (!= (str:trim $message) "") (or (== $source "operator-event") (== $source "channel-event")))
     (if (and (strategy:enabled?) (and $incoming (== $ids ()))) (Error turn:begin missing-transport-delivery-identities)
       (let* (($_ (turn:put "inputs" $ids)) ($_ (turn:put "turn" (turn:text $turn)))
              ($_ (turn:put "sample" none)) ($_ (turn:put "ticket" ""))
              ($_ (turn:put "prepared" none)) ($_ (turn:put "presented" ()))
              ($_ (turn:put "message-focus" "")) ($_ (turn:put "trigger" $source))
              ($_ (turn:put "phase" "begin")))
         (if (not (strategy:enabled?)) 1
           (let $ready (turn:boot)
             (if (turn:failed? $ready) $ready
               (turn:begin-managed $source $message $ids $incoming))))))))
(= (turn:input-focus $ids)
   (str:concat "input:"
     (turn:digest (JsonArray
       ((JsonString (system:getenv-or-default "METTACLAW_INSTANCE" "default"))
        (JsonArray (input-scope:tag-ids $ids)))))))
(= (turn:resume-focus $previous $source)
   (let $resumed (state:ledger "task-resume" ($previous))
     (if (and (== $resumed none) (!= $previous none))
       (if (or (== $source "operator-event") (== $source "channel-event")) none
         (case (state:ledger "request-get" ($previous head))
           (((got $_ $_ $_ "addressed" $_ $_ $_) $previous) ($other none))))
       $resumed)))
; What another loop wrote since this loop's last turn joins the conversation
; first, so this turn's input follows it.
(= (turn:begin-managed $source $message $ids $incoming)
   (let* (($_ (collapse (agent-history:catch-up)))
          ($previous (turn:get "focus" (turn:current-focus)))
          ($continued (turn:resume-focus $previous $source))
          ($control (turn:write "control"
                      ((loop-mode:process) (turn:cognition-paused?) (turn:json "sequential-tools-v1")))))
     (if (or (turn:failed? $continued) (turn:failed? $control)) (Error turn:begin unavailable)
       (let $focus (if $incoming (turn:input-focus $ids)
                       (if (== $continued none) "autonomous" $continued))
         (turn:begin-task $focus $previous $continued $source $message $ids $incoming)))))
(= (turn:begin-task $focus $previous $continued $source $message $ids $incoming)
   (let $accepted
       (if $incoming (turn:accept $focus $message (if (== $source "operator-event") "message" "notification"))
         (if (== $continued none)
           (turn:accept $focus "Ongoing autonomous work; rest and nop do not certify task completion." "autonomous") True))
     (if (turn:failed? $accepted) $accepted
       (turn:link-task $focus $previous $source $ids $incoming))))
(= (turn:link-task $focus $previous $source $ids $incoming)
   (let $linked (if $incoming (turn:write "link-inputs" ($focus $ids)) ok)
     (if (!= $linked ok) (Error turn:begin $linked)
       (let $begun (turn:write "task-begin" ($focus $source $previous (turn:get "reply-chat" "") none))
         (if (!= $begun ok) (Error turn:begin $begun)
           (let* (($_ (turn:put "focus" $focus))
                  ($_ (turn:put "message-focus" (if $incoming $focus "")))
                  ($_ (turn:put "input-turn"
                        (or $incoming (and (turn:get "input-turn" False) (== $source "continuation-tick")))))
                  ($_ (turn:put "phase" "preparing"))) 1))))))
(: turn:begin-continuation (-> Number Atom %Undefined%))
(= (turn:begin-continuation $turn $commands)
   (let $begun (turn:begin $turn "scheduled-command" "" "[]")
     (if (turn:failed? $begun) $begun
       (let $captured (turn:capture "agent scheduled continuation" 0)
         (if (!= $captured 1) ($turn "")
           (let* (($actual (+ (turn:serial) 1)) (($admitted $ticket) (turn:broker-begin $actual $commands 1)))
             ($actual $ticket)))))))
(= (turn:fault)
   (let* (($restored (if (strategy:enabled?) (turn:write "restore" ()) True))
          ($_ (turn:put "sample" none)) ($_ (turn:put "ticket" ""))
          ($_ (turn:put "phase" "failed")))
     (if (!= $restored True) (Error turn:fault $restored)
       (let $recovered (if (strategy:enabled?) (turn:recover-actions) True)
         (if (turn:failed? $recovered) (Error turn:fault $recovered)
           (if (not (strategy:enabled?)) 1
             (case (boot-state:recycle)
               ((True 1)
                (False (if (== (health:fail "host-transition-error" 0) 1) 1
                         (Error turn:fault health-publication-unavailable)))
                ($unknown (Error turn:fault recycle-observation-unavailable))))))))))
(: turn:command-result (-> Number Atom Atom Atom Number %Undefined%))
(= (turn:command-result $turn $disposition $command $result $position)
   (if (and (strategy:enabled?) (== (turn:text $turn) (turn:get "turn" "")))
     (let $ticket (turn:get "ticket" "")
       (if (== $ticket "") 1
         (let* (($command-text (turn:command-json $command))
                ($result-text (erv:str (erv:cross $result)))
                ($outcome (turn:json (JsonObject ((JsonPair "disposition" (JsonString (turn:text $disposition)))
                                                  (JsonPair "result" (JsonString $result-text))))))
                ($recorded (turn:write "attempt-result" ($ticket $position $command-text $outcome))))
           (if (turn:failed? $recorded) $recorded
             (let $_ (turn:close-answered $command $result-text) 1)))))
     1))
(: turn:close-answered (-> Atom String %Undefined%))
(= (turn:close-answered $command $result)
   (if (or (!= (turn:get "context-incomplete" 1) 0) (== $command ())) 0
     (let $name (turn:text (car-atom $command))
       (if (not (and (or (== $name "send") (== $name "send-telegram-chat"))
                     (str:starts-with $result "sent message "))) 0
         (let $focus (turn:focus)
           (case (state:ledger "request-get" ($focus head))
             (((got $_ $kind $_ $_ $_ $_ $_)
               (if (not (or (== $kind "message") (== $kind "notification"))) 0
                 (case (state:ledger "request-context" ($focus))
                   (((context $chat $ids)
                     (if (and (== (size-atom $ids) 1) (!= $chat ""))
                       (let $target (tg:reply-target (if (== $name "send-telegram-chat") (turn:text (index-atom $command 1)) ""))
                         (if (== $target $chat) (turn:write "request-answered" ($focus)) 0)) 0))
                    ($other 0)))))
              ($other 0))))))))
(= (turn:recover-actions)
   (let $actions (state:ledger "actions" ((status "uncertain")))
     (if (turn:failed? $actions) $actions (turn:recover-rows $actions 0))))
(= (turn:recover-rows $actions $count)
   (if (== $actions ()) $count
     (let* (($row (car-atom $actions)) ($rest (cdr-atom $actions))
            ($recovered (turn:recover-one $row)))
       (if (turn:failed? $recovered) $recovered
         (turn:recover-rows $rest (+ $count (if (== $recovered True) 1 0)))))))
(= (turn:recover-one $row)
   (case $row
     (((action $ticket $request $serial $tool $command $status $observed $receipt $payload)
       (let* (($proposal (catch (json:parse $command)))
              ($commands (state:json-field $proposal "commands"))
              ($limit (erv:get $proposal "limit" -1))
              ($attempts (state:ledger "attempts" ((ticket $ticket)))))
         (if (turn:failed? $attempts) $attempts
           (case $commands
             (((JsonArray $calls)
               (let $expected (min (size-atom $calls) $limit)
                 (if (or (< $limit 0) (!= (size-atom $attempts) $expected)) False
                   (case (turn:recover-results $attempts $calls 0 ())
                     (((RecoveredV1 $results)
                       (turn:report $ticket (turn:json (JsonObject
                         ((JsonPair "recovered_results" (JsonArray $results))
                          (JsonPair "deferred_commands" (JsonArray (list:drop $expected $calls))))))))
                      ($incomplete False))))))
              ($other False))))))
      ($bad (Error turn:recover $bad)))))
(= (turn:recover-results $attempts $commands $position $reverse)
   (if (== $attempts ()) (RecoveredV1 (list:reverse $reverse))
     (case (car-atom $attempts)
       (((attempt $ticket $at $command $result $order)
         (if (or (!= $at $position) (== $result none)) IncompleteRecoveryV1
           (let $decoded (catch (json:parse $command))
             (if (!= (state:canonical $decoded) (state:canonical (index-atom $commands $position))) IncompleteRecoveryV1
               (let $answer (catch (json:parse $result))
                 (if (turn:failed? $answer) IncompleteRecoveryV1
                   (turn:recover-results (cdr-atom $attempts) $commands (+ $position 1)
                     (cons-atom $answer $reverse))))))))
        ($other IncompleteRecoveryV1)))))
