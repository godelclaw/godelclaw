; Lazy coding-session facade for the agent loop: keeps SettingSpec visible at
; boot and defers importing coding_work_core.metta (and coding_io_cetta.metta)
; until a work command runs or memory/coding actually contains sessions.
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library system))
!(import! &self ./src/settings_registry.metta)

(SettingSpec 1 "work" "context" "open" "mode" (Choice ("open" "summary" "off")) "persistent"
  "Coding-session context source mode: open lists due open sessions, summary shows counts and verbs, off omits the source."
  work-setting work-setting)
(SettingSpec 1 "work" "resume" "pinned" "mode" (Choice ("pinned" "current")) "persistent"
  "Coding-session default resume mode: pinned resumes on the session's pin, current re-pins to the current runtime after checking a copy of the checkpoint."
  work-setting work-setting)

!(bind! &work-core-loaded (new-state False))
(= (work-lazy:call $expr) (eval $expr))
(= (work-lazy:ensure!)
   (if (get-state &work-core-loaded) True
     (progn (import! &self ./src/coding_work_core.metta)
            (change-state! &work-core-loaded True) True)))

(= (work-setting) (settings "work"))
(= (work-setting $key)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:setting-1 ($key)))))
(= (work-setting $key $raw)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:setting-2 ($key $raw)))))
(= (work $task)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:work-1 ($task)))))
(= (work $task $workdir)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:work-2 ($task $workdir)))))
(= (work $task $workdir $model)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:work-3 ($task $workdir $model)))))
(= (work $task $workdir $model $effort)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:work-4 ($task $workdir $model $effort)))))
(= (work-resume $id)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:resume-1 ($id)))))
(= (work-resume $id $mode)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:resume-2 ($id $mode)))))
(= (work-status)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:status-0 ()))))
(= (work-status $id)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:status-1 ($id)))))
(= (work-hold $id $why)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:hold-2 ($id $why)))))
(= (work-hold $id $why $review)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:hold-3 ($id $why $review)))))
(= (work-archive $id $why)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:archive-2 ($id $why)))))
(= (work-steer $id $text)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:steer-2 ($id $text)))))
(= (work-stop $id)
   (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:stop-1 ($id)))))
(= (work-lazy:dir? $path)
   (case (fs:metadata $path follow)
     (((fs:info directory $_ $_) True)
      ($other False))))
(= (work:reap)
   (let $root (path:join (system:cwd) "memory/coding")
     (if (and (work-lazy:dir? $root) (not (== (fs:entries $root) ())))
       (let $ok (work-lazy:ensure!) (work-lazy:call (cons-atom work-core:reap ())))
       0)))
