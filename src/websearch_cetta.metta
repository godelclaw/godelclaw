; Search policy is native MeTTa. Results come from a local metasearch service
; (SearXNG) and, when it answers nothing, from Tavily.
!(import! &self ./tool_output_cetta.metta)
!(import! &self ./line_rpc_cetta.metta)
!(import! &self ./turn_frame_cetta.metta)
!(import! &self ./uri_cetta.metta)
(= (search:failure $provider $reason $attempts)
   (SearchFailureV1 $provider $reason $attempts))
(= (search:failed? $value) (case $value (((SearchFailureV1 $_ $_ $_) True) ($other False))))
(= (search:error $value)
   (case $value
     (((SearchFailureV1 $provider $reason $attempts)
       (sf:put-all (JsonObject ((JsonPair "provider" $provider) (JsonPair "reason" $reason)))
         (if (== $attempts ()) () ((JsonPair "attempts" (JsonArray $attempts)))))))))
(= (search:clean $text)
   (str:trim (re:replace-literal (re:compile "\\s+") (if (== $text JsonNull) "" (erv:str $text)) " ")))
(= (search:http $method $url $headers $body $seconds)
   (let* (($milliseconds (* $seconds 1000))
          ($deadline (+ (system:monotonic-ns) (* $seconds 1000000000))))
    (case (rpc:perform (http:request $method $url $headers $body $milliseconds 8388608) $deadline)
     (((http:response $status $text)
       (if (and (>= $status 200) (< $status 300)) $text (SearchHttpFailedV1 $status)))
      ((http:response-with-metadata $status $text $_)
       (if (and (>= $status 200) (< $status 300)) $text (SearchHttpFailedV1 $status)))
      ($bad (SearchHttpFailedV1 0))))))
(= (search:http-reason $status)
   (if (> $status 0) (str:concat "http-" (repr $status)) "network-error"))
(= (search:trim-slash $text)
   (if (str:ends-with $text "/")
     (search:trim-slash (str:byte-slice $text 0 (- (str:byte-length $text) 1))) $text))
(= (search:tavily $query $count)
   (if (not (system:env-nonempty? "TAVILY_API_KEY")) (search:failure "tavily" "missing-api-key" ())
     (let* (($depth (system:getenv-or-default "TAVILY_SEARCH_DEPTH" ""))
            ($topic (system:getenv-or-default "TAVILY_TOPIC" ""))
            ($payload (JsonObject (list:append
              ((JsonPair "query" $query) (JsonPair "max_results" $count))
              (list:append
                (if (erv:contains ("1" "true" "yes") (str:lower (system:getenv-or-default "TAVILY_INCLUDE_ANSWER" "")))
                  ((JsonPair "include_answer" True)) ())
                (list:append (if (== $depth "") () ((JsonPair "search_depth" $depth)))
                             (if (== $topic "") () ((JsonPair "topic" $topic))))))))
            ($url (str:concat (search:trim-slash (system:getenv-or-default "TAVILY_BASE_URL" "https://api.tavily.com")) "/search"))
            ($response (search:http "POST" $url
              ((http:credential "SEARCH_TAVILY") (http:header "Content-Type" "application/json")
               (http:header "User-Agent" "pettaclaw-websearch/1.0")) (turn:json $payload) 30)))
       (case $response
         (((SearchHttpFailedV1 $status) (search:failure "tavily" (search:http-reason $status) ()))
          ($text (case (catch (json:parse $text))
            (((JsonObject $pairs) (search:tavily-results (JsonObject $pairs) $count))
             ($bad (search:failure "tavily" "invalid-response" ()))))))))))
(= (search:tavily-results $payload $count)
   (case (sf:get $payload "results" (JsonArray ()))
     (((JsonArray $rows)
       (let* (($answer (search:clean (sf:get $payload "answer" "")))
              ($values (map-atom (list:take $count $rows) $row
                (JsonObject ((JsonPair "title" (search:clean (sf:get $row "title" "")))
                  (JsonPair "url" (search:clean (sf:get $row "url" "")))
                  (JsonPair "snippet" (search:clean (sf:get $row "content" (sf:get $row "snippet" "")))))))))
         (list:take $count (if (== $answer "") $values
           (cons-atom (JsonObject ((JsonPair "title" "Tavily answer") (JsonPair "url" "") (JsonPair "snippet" $answer))) $values)))))
      ($bad (search:failure "tavily" "invalid-response" ())))))
(= (search:format $rows)
   (str:join "" ("(" (str:join "" (map-atom $rows $row
     (str:join "" ("(TITLE: " (sf:get $row "title" "")
       (if (== (sf:get $row "url" "") "") "" (str:concat " URL: " (sf:get $row "url" "")))
       " SNIPPET: " (sf:get $row "snippet" "") ") ")))) ")")))
(= (search:public $result)
   (if (search:failed? $result) (str:concat "SEARCH_ERROR: " (turn:json (search:error $result))) (search:format $result)))
; Providers: the local metasearch (searxng, local), DuckDuckGo through it
; (ddg), Tavily (tavily, api), or auto: the metasearch, then Tavily.
(= (search:run $provider $query)
   (if (erv:contains ("tavily" "api") $provider) (search:public (search:tavily $query 10))
     (if (erv:contains ("searxng" "local") $provider) (search:public (search:searxng $query 10 ""))
       (if (erv:contains ("ddg" "duckduckgo" "html") $provider) (search:public (search:searxng $query 10 "duckduckgo"))
         (if (!= $provider "auto") (search:public (search:failure "configured" "unknown-provider" ()))
           (search:batch ($query)))))))
; One query per line: one line is one query (with any provider prefix);
; several lines are a batch.
(= (search:query-lines $text)
   (list:take 6 (filter-atom (map-atom (str:split "\n" $text) $line (str:trim $line)) $line (!= $line ""))))
(= (search:lines $text)
   (let $queries (search:query-lines $text)
     (if (> (size-atom $queries) 1) (search:batch $queries) (search:auto $text))))
(= (search:auto $query)
   (let $text (str:trim $query)
     (search:prefixes ("tavily:" "searxng:" "local:" "ddg:" "duckduckgo:" "auto:") $text)))
(= (search:prefixes $prefixes $text)
   (if (== $prefixes ()) (search:run (str:lower (str:trim (system:getenv-or-default "METTACLAW_SEARCH_PROVIDER" "auto"))) $text)
     (let $prefix (car-atom $prefixes)
       (if (str:starts-with (str:lower $text) $prefix)
         (search:run (str:char-slice $prefix 0 (- (str:char-length $prefix) 1))
                     (str:trim (str:char-slice $text (str:char-length $prefix) (str:char-length $text))))
         (search:prefixes (cdr-atom $prefixes) $text)))))

;; ---------------------------------------------------------------- batches
; SearXNG is a local metasearch service (no API key): its JSON API lists each
; result's title, url and content. METTACLAW_SEARXNG_URL names the instance.
(= (search:searxng-base)
   (search:trim-slash (system:getenv-or-default "METTACLAW_SEARXNG_URL" "http://127.0.0.1:8888")))
(= (search:searxng $query $count $engines)
   (let* (($query-url (str:concat (search:searxng-base) (str:concat "/search?format=json&q=" (uri:encode $query))))
          ($url (if (== $engines "") $query-url (str:concat $query-url (str:concat "&engines=" (uri:encode $engines)))))
          ($response (search:http "GET" $url
             ((http:header "Accept" "application/json") (http:header "User-Agent" "pettaclaw-websearch/1.0")) "" 20)))
     (case $response
       (((SearchHttpFailedV1 $status) (search:failure "searxng" (search:http-reason $status) ()))
        ($text (case (catch (json:parse $text))
          (((JsonObject $pairs) (search:searxng-results (JsonObject $pairs) $count))
           ($bad (search:failure "searxng" "invalid-response" ())))))))))
(= (search:searxng-results $payload $count)
   (case (sf:get $payload "results" (JsonArray ()))
     (((JsonArray $rows)
       (map-atom (list:take $count $rows) $row
         (JsonObject ((JsonPair "title" (search:clean (sf:get $row "title" "")))
                      (JsonPair "url" (search:clean (sf:get $row "url" "")))
                      (JsonPair "snippet" (search:clean (sf:get $row "content" "")))))))
      ($bad (search:failure "searxng" "invalid-response" ())))))

; The merge of Mettapedia.Algorithms.Retrieval.BatchedQueryMerge: rounds over
; the result lists (the rank-0 result of every list, then rank 1, ...), the
; first result with each key kept. With n lists, every list's top r results
; have their keys among the first n * r merged results.
(= (search:heads $lists)
   (if (== $lists ()) ()
     (let* (($first (car-atom $lists)) ($rest (search:heads (cdr-atom $lists))))
       (if (== $first ()) $rest (cons-atom (car-atom $first) $rest)))))
(= (search:tails $lists)
   (if (== $lists ()) ()
     (let* (($first (car-atom $lists)) ($rest (search:tails (cdr-atom $lists))))
       (cons-atom (if (== $first ()) () (cdr-atom $first)) $rest))))
(= (search:total $lists)
   (if (== $lists ()) 0 (+ (size-atom (car-atom $lists)) (search:total (cdr-atom $lists)))))
(= (search:rounds $fuel $lists)
   (if (== $fuel 0) ()
     (list:append (search:heads $lists) (search:rounds (- $fuel 1) (search:tails $lists)))))
; A result's key is its URL without fragment or trailing slash (its title when
; it has no URL, as a provider's answer row does).
(= (search:key $row)
   (let* (($url (sf:get $row "url" ""))
          ($bare (search:trim-slash (car-atom (str:split "#" $url)))))
     (if (== $bare "") (str:concat "title:" (sf:get $row "title" "")) (str:lower $bare))))
(= (search:dedup-keep $seen $rows)
   (if (== $rows ()) ()
     (let* (($row (car-atom $rows)) ($key (search:key $row)))
       (if (erv:contains $seen $key) (search:dedup-keep $seen (cdr-atom $rows))
         (cons-atom $row (search:dedup-keep (cons-atom $key $seen) (cdr-atom $rows)))))))
(= (search:merge $lists) (search:dedup-keep () (search:rounds (search:total $lists) $lists)))

; One query's results, tagged with the query's position (1-based) for the
; listing: the local metasearch first; Tavily only when it is configured and
; the metasearch answered nothing.
(= (search:tag $rows $index)
   (map-atom $rows $row (sf:put $row "query" (repr $index))))
(= (search:one $query $count)
   (let $local (search:searxng $query $count "")
     (if (and (not (search:failed? $local)) (!= $local ())) (SearchRowsV1 $local ())
       (let $remote (search:tavily $query $count)
         (if (and (not (search:failed? $remote)) (!= $remote ()))
           (SearchRowsV1 $remote (if (search:failed? $local) ((search:error $local)) ()))
           (SearchRowsV1 () (list:append (if (search:failed? $local) ((search:error $local)) ())
                                         (if (search:failed? $remote) ((search:error $remote)) ()))))))))
(= (search:batch-lists $queries $index $count)
   (if (== $queries ()) ()
     (let* (($query (str:trim (car-atom $queries)))
            ((SearchRowsV1 $rows $failures) (search:one $query $count))
            ($rest (search:batch-lists (cdr-atom $queries) (+ $index 1) $count)))
       (cons-atom (SearchListV1 (search:tag $rows $index) $failures) $rest))))
(= (search:list-rows $lists) (map-atom $lists $l (case $l (((SearchListV1 $rows $_) $rows)))))
(= (search:list-failures $lists)
   (if (== $lists ()) ()
     (case (car-atom $lists)
       (((SearchListV1 $_ $failures) (list:append $failures (search:list-failures (cdr-atom $lists))))))))
(= (search:format-batch $rows)
   (str:join "" ("(" (str:join "" (map-atom $rows $row
     (str:join "" ("(Q" (sf:get $row "query" "") " TITLE: " (sf:get $row "title" "")
       (if (== (sf:get $row "url" "") "") "" (str:concat " URL: " (sf:get $row "url" "")))
       " SNIPPET: " (sf:get $row "snippet" "") ") ")))) ")")))
; Several queries in one command: each searched, the result lists merged
; fairly, at most `per-query` results per query, each tagged Q1, Q2, ...
(= (search:batch $queries)
   (let* (($per-query (str:string->number (system:getenv-or-default "METTACLAW_SEARCH_PER_QUERY" "6")))
          ($lists (search:batch-lists $queries 1 $per-query))
          ($merged (search:merge (search:list-rows $lists)))
          ($kept (list:take (* (size-atom $queries) $per-query) $merged))
          ($failures (search:list-failures $lists)))
     (if (== $kept ())
       (search:public (search:failure "batch" "no-results" $failures))
       (str:concat (if (== $failures ()) "" (str:concat "SEARCH_PARTIAL: " (str:concat (turn:json (JsonArray $failures)) "\n")))
                   (search:format-batch $kept)))))
