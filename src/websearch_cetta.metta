; Search policy is native MeTTa; HTML recovery uses the configured native parser.
!(import! &self ./tool_output_cetta.metta)
!(import! &self ./line_rpc_cetta.metta)
!(import! &self ./turn_frame_cetta.metta)
!(import! &self ./uri_cetta.metta)
(= (search:failure $provider $reason $attempts)
   (SearchFailureV1 $provider $reason $attempts))
(= (search:failed? $value) (case $value (((SearchFailureV1 $_ $_ $_) True) ($other False))))
(= (search:error $value)
   (case $value
     (((SearchFailureV1 $provider $reason $attempts)
       (sf:put-all (JsonObject ((JsonPair "provider" $provider) (JsonPair "reason" $reason)))
         (if (== $attempts ()) () ((JsonPair "attempts" (JsonArray $attempts)))))))))
(= (search:clean $text)
   (str:trim (re:replace-literal (re:compile "\\s+") (if (== $text JsonNull) "" (erv:str $text)) " ")))
(= (search:http $method $url $headers $body $seconds)
   (let* (($milliseconds (* $seconds 1000))
          ($deadline (+ (system:monotonic-ns) (* $seconds 1000000000))))
    (case (rpc:perform (http:request $method $url $headers $body $milliseconds 8388608) $deadline)
     (((http:response $status $text)
       (if (and (>= $status 200) (< $status 300)) $text (SearchHttpFailedV1 $status)))
      ((http:response-with-metadata $status $text $_)
       (if (and (>= $status 200) (< $status 300)) $text (SearchHttpFailedV1 $status)))
      ($bad (SearchHttpFailedV1 0))))))
(= (search:http-reason $status)
   (if (> $status 0) (str:concat "http-" (repr $status)) "network-error"))
(= (search:trim-slash $text)
   (if (str:ends-with $text "/")
     (search:trim-slash (str:byte-slice $text 0 (- (str:byte-length $text) 1))) $text))
(= (search:tavily $query $count)
   (if (not (system:env-nonempty? "TAVILY_API_KEY")) (search:failure "tavily" "missing-api-key" ())
     (let* (($depth (system:getenv-or-default "TAVILY_SEARCH_DEPTH" ""))
            ($topic (system:getenv-or-default "TAVILY_TOPIC" ""))
            ($payload (JsonObject (list:append
              ((JsonPair "query" $query) (JsonPair "max_results" $count))
              (list:append
                (if (erv:contains ("1" "true" "yes") (str:lower (system:getenv-or-default "TAVILY_INCLUDE_ANSWER" "")))
                  ((JsonPair "include_answer" True)) ())
                (list:append (if (== $depth "") () ((JsonPair "search_depth" $depth)))
                             (if (== $topic "") () ((JsonPair "topic" $topic))))))))
            ($url (str:concat (search:trim-slash (system:getenv-or-default "TAVILY_BASE_URL" "https://api.tavily.com")) "/search"))
            ($response (search:http "POST" $url
              ((http:credential "SEARCH_TAVILY") (http:header "Content-Type" "application/json")
               (http:header "User-Agent" "pettaclaw-websearch/1.0")) (turn:json $payload) 30)))
       (case $response
         (((SearchHttpFailedV1 $status) (search:failure "tavily" (search:http-reason $status) ()))
          ($text (case (catch (json:parse $text))
            (((JsonObject $pairs) (search:tavily-results (JsonObject $pairs) $count))
             ($bad (search:failure "tavily" "invalid-response" ()))))))))))
(= (search:tavily-results $payload $count)
   (case (sf:get $payload "results" (JsonArray ()))
     (((JsonArray $rows)
       (let* (($answer (search:clean (sf:get $payload "answer" "")))
              ($values (map-atom (list:take $count $rows) $row
                (JsonObject ((JsonPair "title" (search:clean (sf:get $row "title" "")))
                  (JsonPair "url" (search:clean (sf:get $row "url" "")))
                  (JsonPair "snippet" (search:clean (sf:get $row "content" (sf:get $row "snippet" "")))))))))
         (list:take $count (if (== $answer "") $values
           (cons-atom (JsonObject ((JsonPair "title" "Tavily answer") (JsonPair "url" "") (JsonPair "snippet" $answer))) $values)))))
      ($bad (search:failure "tavily" "invalid-response" ())))))
(= (html:entity $name)
   (case $name
     (("amp" "&") ("lt" "<") ("gt" ">") ("quot" "\"") ("apos" "'") ("nbsp" " ")
      ($numeric
        (let $number (if (str:starts-with $numeric "#x")
                        (html:hex (str:char-slice $numeric 2 (str:char-length $numeric)) 0)
                        (str:string->number (str:char-slice $numeric 1 (str:char-length $numeric))))
          (str:from-python-codepoints ($number)))))))
(= (html:hex $text $n)
   (if (== $text "") $n
     (html:hex (str:char-slice $text 1 (str:char-length $text))
       (+ (* $n 16) (uri:hex-value (str:char-slice $text 0 1))))))
(= (html:decode $text) (html:decode-pieces $text ()))
(= (html:decode-pieces $text $reverse)
   (case (re:captures (re:pattern "&(amp|lt|gt|quot|apos|nbsp|#[0-9]+|#x[0-9A-Fa-f]+);") $text)
     ((re:no-match (str:join "" (list:reverse (cons-atom $text $reverse))))
      ($match
        (let* (((re:span $start $end) (re:group-span $match 0))
               ($value (html:entity (re:group-text $match $text 1))))
          (html:decode-pieces (str:byte-slice $text $end (str:byte-length $text))
            (cons-atom $value (cons-atom (str:byte-slice $text 0 $start) $reverse))))))))
(= (html:tokens $text)
   (case (re:find-all (re:pattern "<!--[\\s\\S]*?-->|<(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>|[^<]+") $text)
     (((re:matches $matches) (html:matched-tokens $text $matches))
      ($bad (Error html:tokens (Fault $bad))))))
(= (html:matched-tokens $text $matches)
   (case $matches
     ((LNil ())
      ((LCons (re:match $start $end $_) $rest)
        (cons-atom (str:byte-slice $text $start $end) (html:matched-tokens $text $rest))))))
(= (html:attribute $tag $name)
   (case (re:captures (re:pattern (str:join "" ("\\s" $name "\\s*=\\s*([\"'])(.*?)\\1"))) $tag)
     ((re:no-match "") ($match (html:decode (re:group-text $match $tag 2))))))
(= (html:tag-name $tag)
   (case (re:captures (re:pattern "^</?([A-Za-z0-9:_-]+)") $tag)
     ((re:no-match "") ($match (str:lower (re:group-text $match $tag 1))))))
(= (html:void? $tag $name)
   (or (str:ends-with $tag "/>") (erv:contains ("area" "base" "br" "col" "embed" "hr" "img" "input" "link" "meta" "param" "source" "track" "wbr") $name)))
(= (search:ddg-url $href)
   (let* (($url (if (str:starts-with $href "//") (str:concat "https:" $href) $href))
          ($query (cdr-atom (str:split "?" $url))))
     (if (== $query ()) $url
       (let $encoded (search:parameter (str:split "&" (car-atom $query)) "uddg")
         (if (== $encoded "") $url (uri:decode $encoded))))))
(= (search:parameter $pairs $key)
   (if (== $pairs ()) ""
     (let $parts (str:split "=" (car-atom $pairs))
       (if (and (== (car-atom $parts) $key) (> (size-atom $parts) 1))
         (str:join "=" (cdr-atom $parts)) (search:parameter (cdr-atom $pairs) $key)))))
(= (html:walk $tokens $depth $kind $pieces $title $url $rows)
   (if (== $tokens ()) (list:reverse $rows)
     (let* (($token (car-atom $tokens)) ($rest (cdr-atom $tokens))
            ($tag (str:starts-with $token "<")) ($name (if $tag (html:tag-name $token) ""))
            ($classes (if $tag (str:split-whitespace (html:attribute $token "class")) ()))
            ($title-anchor (and (== $name "a") (not (erv:contains $classes "result__snippet")))))
       (if (not $tag)
         (html:walk $rest $depth $kind (if (> $depth 0) (cons-atom $token $pieces) $pieces) $title $url $rows)
         (if (or (== $name "") (html:void? $token $name))
           (html:walk $rest $depth $kind $pieces $title $url $rows)
           (if (== $depth 0)
             (html:walk $rest 1 (if $title-anchor "title" "snippet") () $title
               (if $title-anchor (search:ddg-url (html:attribute $token "href")) $url) $rows)
             (let $next (+ $depth (if (str:starts-with $token "</") -1 1))
               (if (> $next 0) (html:walk $rest $next $kind $pieces $title $url $rows)
                 (let $text (search:clean (html:decode (str:join "" (list:reverse $pieces))))
                   (if (== $kind "title") (html:walk $rest 0 "" () $text $url $rows)
                     (html:walk $rest 0 "" () "" ""
                       (if (or (== $title "") (== $text "")) $rows
                         (cons-atom (JsonObject ((JsonPair "title" $title) (JsonPair "url" $url) (JsonPair "snippet" $text))) $rows)))))))))))))
(= (search:html $text)
   (if (== (str:utf8-error $text) StrUtf8WellFormedV1) (search:html-text $text)
     (search:failure "ddg" "invalid-utf8" ())))
(= (search:html-text $text)
   (let* (($root (artifact:directory)) ($_ (fs:make-directories $root 504))
          ($path (path:join $root (str:concat ".html-" (system:uuid4-hex))))
          ($input (str:concat "<?xml encoding=\"UTF-8\"?>\n" $text))
          ($stored (sf:replace $path $input 432 False)))
     (if (!= $stored True) (search:failure "ddg" "unavailable-storage" ())
       (let* (($xpath "//a[contains(concat(' ',normalize-space(@class),' '),' result__a ') or contains(concat(' ',normalize-space(@class),' '),' result-link ')] | //a[contains(concat(' ',normalize-space(@class),' '),' result__snippet ')] | //td[contains(concat(' ',normalize-space(@class),' '),' result__snippet ') or contains(concat(' ',normalize-space(@class),' '),' result-snippet ')]")
              ($parser (system:getenv-or-default "METTACLAW_XMLLINT_BIN" "xmllint"))
              ($parsed (proc:run ($parser "--html" "--recover" "--nonet" "--encode" "UTF-8" "--xpath" $xpath $path) (system:getcwd) inherit 10000 16777216))
              ($_ (fs:remove $path)))
         (case $parsed
           (((proc:exited 0 $xml $_) (html:walk (html:tokens $xml) 0 "" () "" "" ()))
            ((proc:exited 11 $_ $_) ())
            ($bad (search:failure "ddg" "html-parser-unavailable" ()))))))))
(= (search:ddg $query $count)
   (search:ddg-each (str:split "," (system:getenv-or-default "METTACLAW_DDG_ENDPOINTS"
     "https://lite.duckduckgo.com/lite/?q=,https://html.duckduckgo.com/html/?q=")) $query $count False ()))
(= (search:ddg-each $endpoints $query $count $completed $failures)
   (if (== $endpoints ())
     (if $completed () (search:failure "ddg" "all-endpoints-failed" (list:reverse $failures)))
     (let* (($response (search:http "GET" (str:concat (car-atom $endpoints) (uri:encode $query))
                         ((http:header "User-Agent" "Mozilla/5.0")) "" 10))
            ($rows (search:ddg-response $response)))
       (if (search:failed? $rows)
         (search:ddg-each (cdr-atom $endpoints) $query $count $completed (cons-atom (search:error $rows) $failures))
         (if (!= $rows ()) (list:take $count $rows)
           (search:ddg-each (cdr-atom $endpoints) $query $count True $failures))))))
(= (search:ddg-response $response)
   (case $response
     (((SearchHttpFailedV1 $status) (search:failure "ddg" (search:http-reason $status) ()))
      ($text
        (let $parsed (search:html $text)
          (if (and (== $parsed ()) (re:is-match (re:pattern "(?i)anomaly-modal|challenge-form|bots use duckduckgo too") $text))
            (search:failure "ddg" "challenge-required" ()) $parsed))))))
(= (search:format $rows)
   (str:join "" ("(" (str:join "" (map-atom $rows $row
     (str:join "" ("(TITLE: " (sf:get $row "title" "")
       (if (== (sf:get $row "url" "") "") "" (str:concat " URL: " (sf:get $row "url" "")))
       " SNIPPET: " (sf:get $row "snippet" "") ") ")))) ")")))
(= (search:public $result)
   (if (search:failed? $result) (str:concat "SEARCH_ERROR: " (turn:json (search:error $result))) (search:format $result)))
(= (search:run $provider $query)
   (if (erv:contains ("tavily" "api") $provider) (search:public (search:tavily $query 10))
     (if (erv:contains ("ddg" "duckduckgo" "html") $provider) (search:public (search:ddg $query 10))
       (if (!= $provider "auto") (search:public (search:failure "configured" "unknown-provider" ()))
         (let $first (search:tavily $query 10)
           (if (and (not (search:failed? $first)) (!= $first ())) (search:format $first)
             (let* (($second (search:ddg $query 10))
                    ($failures (if (search:failed? $first) ((search:error $first)) ())))
               (if (search:failed? $second)
                 (search:public (search:failure "auto" "all-providers-failed" (list:append $failures ((search:error $second)))))
                 (str:concat (if (== $failures ()) "" (str:concat "SEARCH_FALLBACK: " (str:concat (turn:json (JsonArray $failures)) "\n")))
                             (search:format $second))))))))))
(= (search:auto $query)
   (let $text (str:trim $query)
     (search:prefixes ("tavily:" "ddg:" "duckduckgo:" "auto:") $text)))
(= (search:prefixes $prefixes $text)
   (if (== $prefixes ()) (search:run (str:lower (str:trim (system:getenv-or-default "METTACLAW_SEARCH_PROVIDER" "auto"))) $text)
     (let $prefix (car-atom $prefixes)
       (if (str:starts-with (str:lower $text) $prefix)
         (search:run (str:char-slice $prefix 0 (- (str:char-length $prefix) 1))
                     (str:trim (str:char-slice $text (str:char-length $prefix) (str:char-length $text))))
         (search:prefixes (cdr-atom $prefixes) $text)))))
