(ArityBaseV1 "setting" 2 3)
(ArityBaseV1 "remember" 1 1)
(ArityBaseV1 "query" 1 3)
(ArityBaseV1 "forget" 1 2)
(ArityBaseV1 "memory-edit" 2 2)
(ArityBaseV1 "memory-read" 1 1)
(ArityBaseV1 "memory-history" 1 1)
(ArityBaseV1 "memory-pending" 0 0)
(ArityBaseV1 "memory-retry" 0 0)
(ArityBaseV1 "memory-retire" 1 2)
(ArityBaseV1 "pin" 1 1)
(ArityBaseV1 "unpin" 1 1)
(ArityBaseV1 "pins" 0 0)
(ArityBaseV1 "goals" 0 0)
