; Native owner of the bare-command vocabulary and its equation refinement.
; The Python module remains the SWI compatibility path and the parity oracle.
; Source discovery happens once when this module is loaded. Only literal base
; arities are data below; equation-only commands and refined bounds come from
; the actual src/*.metta and channels/*.metta files in the running source tree.

!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library re))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self ./src/undelivered_prose_unicode.metta)

