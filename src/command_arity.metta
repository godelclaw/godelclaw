(ArityBaseV1 "task-read" 1 3)
(ArityBaseV1 "task-history" 1 3)
(ArityBaseV1 "task-note" 1 2)
(ArityBaseV1 "requests" 0 0)
(ArityBaseV1 "request-status" 1 1)
(ArityBaseV1 "request-focus" 1 1)
(ArityBaseV1 "request-page" 1 1)
(ArityBaseV1 "request-read" 2 2)
(ArityBaseV1 "request-disposition" 3 3)
(ArityBaseV1 "command-receipts" 0 1)
