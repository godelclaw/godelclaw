!(import! &self fs)
!(import! &self str)
(= (file-io:read $path $max-bytes)
   (fs:read-text-result $path $max-bytes "replace"))
(= (file-io:join $parts) (str:join "" $parts))
(= (file-io:number $value) (str:number->string $value))

!(import! &self system)
!(import! &self path)
(= (file-io:lines $path $start $count) (fs:line-window $path $start $count))
(= (file-io:tree $path $depth $limit $offset $skips) (fs:tree-page $path $depth $limit $offset $skips))
(= (file-io:grep $pattern $path $limit $offset $skips) (fs:grep-page $pattern $path $limit $offset $skips))
(= (file-io:exists $path) (fs:is-file $path))
(= (file-io:update $path $op $first $second)
   (let* (($state (system:getenv-or-default "XDG_STATE_HOME" "~/.local/state"))
          ($cwd (system:cwd))
          ($instance (system:getenv-or-default "METTACLAW_INSTANCE" ""))
          ($name (if (== $instance "") (car-atom (path:reverse-atom-expr (str:split "/" $cwd))) $instance))
          ($backup (file-io:join ($state "/" $name "/file-backups"))))
      (fs:update-text $path $op $first $second $backup)))
