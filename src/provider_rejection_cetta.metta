; Deterministic provider refusals remain held until observed correction.
!(import! &self ./turn_health_cetta.metta)
!(import! &self ./state_ledger.metta)
!(import! &self ./turn_frame_cetta.metta)
!(import! &self ./model_selection_cetta.metta)
!(import! &self ./diagnostic_cetta.metta)
!(import! &self ../channels/telegram_control_io.metta)
!(bind! &rejection-overlay (new-state NoRejectionOverlayV1))

(= (rejection:json $value)
   (json:stringify-python-with $value ((ensure-ascii True))))
(= (rejection:equal $left $right) (== (turn:json $left) (turn:json $right)))
(= (rejection:state-dir) (path:dirname (health:path)))
(= (rejection:read-object $path) (sf:native-object $path))
(= (rejection:read-value $path)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $text)
       (case (catch (json:parse $text))
         (((Error $_ $_) RejectionUnavailableV1) ($value $value))))
      ($bad RejectionUnavailableV1))))
(= (rejection:health)
   (let $record (health:read)
     (case (get-state &rejection-overlay)
       ((NoRejectionOverlayV1 $record)
        ((RejectionOverlayV1 JsonNull) (sf:drop $record "provider_rejection"))
        ((RejectionOverlayV1 $block) (sf:put $record "provider_rejection" $block))))))
(= (rejection:save $record)
   (let $written (health:write $record)
     (let $_ (change-state! &rejection-overlay
                (if (== $written 1) NoRejectionOverlayV1
                  (RejectionOverlayV1 (sf:get $record "provider_rejection" JsonNull))))
       $written)))
(= (rejection:stamp $path)
   (case (fs:metadata $path follow-observed)
     (((fs:info-v2 $kind $size (fs:identity $device $inode) (fs:modified $sec $nsec)
                    (fs:changed $_ $_) $mode $blocks)
       (let* (($number (str:string->number $inode)) ($stamp (+ (* $sec 1000000000) $nsec)))
         (JsonArray ($path $number $stamp $size))))
      ((fs:missing $_) (JsonArray ((JsonString $path) JsonNull)))
      ((fs:failed fs:missing $_ $_ $_ $_ $_) (JsonArray ((JsonString $path) JsonNull)))
      ($other UnavailableStampV1))))
(= (rejection:stamps $paths)
   (if (== $paths ()) ()
     (let $head (rejection:stamp (car-atom $paths))
       (if (== $head UnavailableStampV1) UnavailableStampV1
         (let $tail (rejection:stamps (cdr-atom $paths))
           (if (== $tail UnavailableStampV1) $tail (cons-atom $head $tail)))))))
(= (rejection:extra-paths $keys)
   (if (== $keys ()) ()
     (let* (($key (car-atom $keys)) ($value (system:getenv-or-default $key ""))
            ($rest (rejection:extra-paths (cdr-atom $keys))))
       (if (== $value "") $rest (cons-atom $value $rest)))))
(= (rejection:configuration)
   (let* (($root (system:getenv-or-default "METTACLAW_RUNTIME_ROOT" (system:getcwd)))
          ($paths (list:append
                    ((path:join $root "config/local.toml") (path:join $root "config/default.toml")
                     (path:join (rejection:state-dir) "context-policy.json"))
                    (rejection:extra-paths ("METTACLAW_MODEL_STATE_PATH" "METTACLAW_CHATGPT_POLICY_PATH" "METTACLAW_LLM_POLICY_PATH"))))
          ($stamps (rejection:stamps $paths)))
     (if (== $stamps UnavailableStampV1) JsonNull
       (let* (($body (JsonArray $stamps)) ($text (rejection:json $body)) ($digest (str:sha256 $text)))
         (JsonString $digest)))))
(= (rejection:context)
   (let* (($release (rejection:read-object (path:join (rejection:state-dir) "runtime-release.json")))
          ($selected (model:current ""))
          ($initial (JsonObject ((JsonPair "model" $selected))))
          ($with-release (case (sf:get $release "release" JsonNull)
                           ((JsonNull $initial) ($id (sf:put $initial "release" $id)))))
          ($configuration (rejection:configuration))
          ($with-config (if (== $configuration JsonNull) $with-release (sf:put $with-release "configuration" $configuration)))
          ($mode-root (system:getenv-or-default "METTACLAW_MODE_STATE_ROOT" (path:join (rejection:state-dir) "modes")))
          ($control (rejection:read-object (path:join $mode-root "control-status.json")))
          ($inbox (sf:get $control "operator_inbox" JsonNull))
          ($pending (sf:get $inbox "pending" -1))
          ($with-inbox (if (< $pending 0) $with-config
             (sf:put $with-config "operator_input" (JsonArray
               (if (> $pending 0) ((sf:get $inbox "pending" JsonNull) (sf:get $inbox "newestMessageAt" JsonNull)
                                   (sf:get $inbox "oldestMessageAt" JsonNull)) ((JsonNumber "0") JsonNull JsonNull))))))
          ($runtime (system:getenv-or-default "METTACLAW_MODE_RUNTIME" ""))
          ($offered (if (== $runtime "") JsonNull (rejection:read-value (path:join $runtime "offered-input.json"))))
          ($with-mode (rejection:mode-fact $with-inbox $runtime $offered))
          ($checkpoint (state:ledger "meta-prefix" ("task_window:"))))
     (if (turn:failed? $checkpoint) $with-mode
       (let* (($encoded (erv:cross $checkpoint)) ($text (rejection:json $encoded)) ($digest (str:sha256 $text)))
         (sf:put $with-mode "checkpoint" $digest)))))
(= (rejection:mode-fact $base $runtime $offered)
   (if (== $runtime "") (sf:put $base "mode_input" (JsonString ""))
     (case $offered
       ((RejectionUnavailableV1 $base) (JsonNull $base)
        ($known
          (let $digest (if (erv:truth $known)
                          (str:sha256 (json:stringify-python-with $known ((sort-keys True)))) "")
            (sf:put $base "mode_input" (JsonString $digest))))))))
(= (rejection:changed? $pairs $now)
   (if (== $pairs ()) False
     (let (JsonPair $key $old) (car-atom $pairs)
       (let $current (sf:get $now $key RejectionFieldMissingV1)
         (if (and (not (== $current RejectionFieldMissingV1)) (not (rejection:equal $old $current))) True
           (rejection:changed? (cdr-atom $pairs) $now))))))
(= (rejection:blocked?)
   (let* (($health (rejection:health)) ($block (sf:get $health "provider_rejection" JsonNull)))
     (case $block
       (((JsonObject $_)
         (let* (($old (sf:get $block "context" (JsonObject ())))
                ($before (sf:put-all
                   (JsonObject ((JsonPair "operator_input" (JsonArray ((JsonNumber "0") JsonNull JsonNull)))
                                (JsonPair "mode_input" (JsonString ""))))
                   (case $old (((JsonObject $old-pairs) $old-pairs) ($other ())))))
                ($now (rejection:context)))
           (if (rejection:changed? (case $before (((JsonObject $expected-pairs) $expected-pairs))) $now)
             (let $_ (rejection:save (sf:put (sf:drop $health "provider_rejection") "retry_at" 0)) False)
             (let* (($merged (sf:put-all $now (case $before (((JsonObject $merge-pairs) $merge-pairs)))))
                    ($updated (sf:put $block "context" $merged))
                    ($_ (rejection:save (sf:put $health "provider_rejection" $updated)))) True))))
        ($none False)))))
(= (rejection:safe $text $limit)
   (diagnostic:text $text $limit))
(= (rejection:error-fields $body)
   (let $decoded (catch (json:parse $body))
     (case $decoded
       (((Error $_ $_) ("" "Non-JSON provider rejection"))
        ((JsonObject $_)
          (let* (($error (sf:get $decoded "error" $decoded))
                 ($code (sf:get $error "code" (sf:get $error "type" "")))
                 ($message (sf:get $error "message" (sf:get $decoded "detail" "Provider rejected the request"))))
            ((rejection:safe $code 64) (rejection:safe $message 400))))
        ($other ("" "Provider rejected the request"))))))
(= (rejection:reason $status $code $message)
   (if (or (== $status 413) (or (erv:contains ("context_length_exceeded" "string_above_max_length") $code)
         (and (erv:contains (400 422) $status)
              (or (re:is-match (re:compile "prompt is too long|maximum context length|context window exceeded") (str:lower $message)) False))))
     "context-size" "invalid-request"))
(= (rejection:record $status $code $message $context)
   (if (not (gate:invalid-request? $status)) False
     (let* (($identity (str:sha256 (json:stringify-python-with
                         (JsonArray ((JsonNumber (repr $status)) (JsonString $code) $context)) ((sort-keys True)))))
            ($record (rejection:health)) ($old (sf:get $record "provider_rejection" (JsonObject ())))
            ($reason (rejection:reason $status $code $message))
            ($fresh (JsonObject ((JsonPair "id" (JsonString $identity)) (JsonPair "status" (JsonNumber (repr $status)))
                                (JsonPair "code" (JsonString (rejection:safe $code 64)))
                                (JsonPair "message" (JsonString (rejection:safe $message 400)))
                                (JsonPair "context" $context) (JsonPair "reason" (JsonString $reason)))))
            ($repair (and (== $reason "context-size") (and (== (context:mode) full) (strategy:enabled?))))
            ($block (if (rejection:equal (sf:get $old "id" JsonNull) (JsonString $identity)) $old
                       (if (and $repair (not (rejection:equal (sf:get $record "provider_context_repair" JsonNull) $context)))
                         (sf:put $fresh "repair" "requested") $fresh)))
            ($_ (rejection:save (sf:put (sf:put $record "provider_rejection" $block) "retry_at" 0))))
       (let $_ (collapse (catch (rejection:notify))) True))))
(= (rejection:repair-pending?)
   (== (erv:get (sf:get (rejection:health) "provider_rejection" (JsonObject ())) "repair" "") "requested"))
(= (rejection:begin-context-repair)
   (let* (($record (rejection:health)) ($block (sf:get $record "provider_rejection" (JsonObject ()))))
     (if (not (== (erv:get $block "repair" "") "requested")) 0
       (rejection:save (sf:put
         (sf:put $record "provider_rejection" (sf:put $block "repair" "attempted"))
         "provider_context_repair" (sf:get $block "context" (JsonObject ())))))))
(= (turn:preparation-failed $reason)
   (let $code (if (and (<= (str:char-length $reason) 64)
                       (re:is-match (re:compile "^context-[a-z0-9]+(?:-[a-z0-9]+)*$") $reason)) $reason "context-preparation-failed")
     ("failed" $code 0 False -1.0 (rejection:blocked?) True)))

; Reserve the durable notice key before publishing, and reuse it on retry.
(= (rejection:notify)
   (let* (($record (rejection:health)) ($block (sf:get $record "provider_rejection" JsonNull)))
     (case $block
       (((JsonObject $_)
         (if (or (sf:get $block "alert_queued" False) (== (erv:get $block "repair" "") "requested")) 0
           (let $key (erv:get $block "alert_key" "")
             (if (== $key "")
               (case (collapse (catch (tio:operator-key)))
                 ((($fresh) (if (== (get-type $fresh) String)
                              (rejection:publish-notice $record (sf:put $block "alert_key" $fresh) $fresh) 0))
                  ($unavailable 0)))
               (rejection:publish-notice $record $block $key)))))
        ($none 0)))))
(= (rejection:publish-notice $record $block $key)
   (if (not (== (rejection:save (sf:put $record "provider_rejection" $block)) 1)) 0
     (let* (($code (erv:get $block "code" "invalid request"))
            ($text (str:join "" ("Provider request blocked: HTTP " (repr (erv:get $block "status" 0))
                    " (" $code "). " (erv:get $block "message" "")
                    "\nThe request and input are retained. A corrected configuration, deployment, model selection or new operator input can resume it. Controls remain available.")))
            ($intent (JsonObject ((JsonPair "key" $key)
                      (JsonPair "commands" (JsonArray ((JsonArray ("send" $text "plain"))))))))
            ($stored (tio:store-intent $key $intent)))
       (if (not (== $stored True)) 0
         (rejection:save (sf:put $record "provider_rejection" (sf:put $block "alert_queued" True)))))))
