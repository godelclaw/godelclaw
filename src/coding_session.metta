; Coding mode runs Codex's work loop over one task. A session is a folder:
;   task.json       {"task", "workdir", "requester", "effort"}
;   messages.jsonl  the conversation, one JSON message per line, append-only
;   plan.json       the latest plan
;   inbox.jsonl     steering from the requester, one JSON string per line
;   state.json      status, steps, the latest progress text, inbox position
;   report.txt      the final reply
;   stop            present once the requester stops the session
; The model is asked, its tool calls run, their results are appended, and the
; loop continues until a reply calls no tool: there is no step cap. Output is
; cut in the middle at about 10k tokens, and past 90% of the model's window
; the history becomes a handoff summary, as Codex does.
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library proc))
!(import! &self (library system))
!(import! &self (library str))
!(import! &self (library math))
!(import! &self (library json))
!(import! &self ./src/apply_patch.py)
!(import! &self ./src/coding_io.py)

(= (coding:file $dir $name) (path:join $dir $name))
(= (coding:member $pairs $key)
   (if (== $pairs ()) JsonNull
     (let (JsonPair $name $value) (car-atom $pairs)
       (if (== $name $key) $value (coding:member (cdr-atom $pairs) $key)))))
(= (coding:field $value $key)
   (case $value (((JsonObject $pairs) (coding:member $pairs $key)) ($other JsonNull))))
(= (coding:text $value) (case $value (((JsonString $text) $text) ($other ""))))
(= (coding:items $value) (case $value (((JsonArray $items) $items) ($other ()))))
(= (coding:reverse $items $out)
   (if (== $items ()) $out (coding:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out))))
(= (coding:append-list $first $second) (coding:reverse (coding:reverse $first ()) $second))
(= (coding:drop $items $count)
   (if (or (<= $count 0) (== $items ())) $items (coding:drop (cdr-atom $items) (- $count 1))))
(= (coding:number $value $default)
   (case $value (((JsonNumber $text) (str:string->number $text)) ($other $default))))

(= (coding:json-file $path $default)
   (if (fs:is-file $path) (json-parse (fs:read-text $path)) $default))
(= (coding:parse-lines $lines $out)
   (if (== $lines ()) (coding:reverse $out ())
     (let $line (car-atom $lines)
       (if (== (str:trim $line) "") (coding:parse-lines (cdr-atom $lines) $out)
         (coding:parse-lines (cdr-atom $lines) (cons-atom (json-parse $line) $out))))))
(= (coding:json-lines $path)
   (if (fs:is-file $path) (coding:parse-lines (str:split "\n" (fs:read-text $path)) ()) ()))

(= (coding:message $role $text)
   (JsonObject ((JsonPair "role" (JsonString $role)) (JsonPair "content" (JsonString $text)))))
(= (coding:tool-message $id $text)
   (JsonObject ((JsonPair "role" (JsonString "tool")) (JsonPair "tool_call_id" (JsonString $id))
                (JsonPair "content" (JsonString $text)))))
(= (coding:record $dir $message)
   (let* (($path (coding:file $dir "messages.jsonl")) ($line (json-stringify $message))
          ($_ (py-call (coding_io.append_line $path $line))))
     $message))
(= (coding:record-all $dir $messages $out)
   (if (== $messages ()) (coding:reverse $out ())
     (coding:record-all $dir (cdr-atom $messages) (cons-atom (coding:record $dir (car-atom $messages)) $out))))
(= (coding:state $dir $status $steps $progress $inbox)
   (fs:update-text (coding:file $dir "state.json") "replace"
     (json-stringify (JsonObject ((JsonPair "status" (JsonString $status))
                                  (JsonPair "steps" (JsonNumber (repr $steps)))
                                  (JsonPair "progress" (JsonString $progress))
                                  (JsonPair "inbox" (JsonNumber (repr $inbox)))
                                  (JsonPair "updated" (JsonNumber (repr (coding:now)))))))
     "" ""))

; Codex keeps the beginning and the end of long output.
(= (coding:cut $text)
   (let $length (str:char-length $text)
     (if (<= $length 40000) $text
       (str:join "" ((str:char-slice $text 0 20000)
                     (str:join "" ("\n…" (repr (math:ceil (/ (- $length 40000) 4))) " tokens truncated…\n"))
                     (str:char-slice $text (- $length 20000) $length))))))

(= (coding:exec-report $code $seconds $output)
   (str:join "" ("Exit code: " $code "\nWall time: " (repr $seconds) " seconds\nOutput:\n" (coding:cut $output))))
(= (coding:exec $workdir $args)
   (let* (($cmd (coding:text (coding:field $args "cmd")))
          ($given (coding:text (coding:field $args "workdir")))
          ($dir (if (== $given "") $workdir $given))
          ($timeout (coding:number (coding:field $args "timeout_ms") 600000))
          ($start (system:monotonic-ns))
          ($result (proc:run ("bash" "-lc" $cmd) $dir inherit $timeout 0 "merged"))
          ($seconds (/ (math:floor (/ (- (system:monotonic-ns) $start) 10000000)) 100.0)))
     (case $result
       (((proc:exited $code $out $err) (coding:exec-report (repr $code) $seconds (str:concat $out $err)))
        ((proc:signaled $signal $out $err)
          (coding:exec-report (str:concat "signal " (repr $signal)) $seconds (str:concat $out $err)))
        ((proc:timed-out $out $err) (coding:exec-report "timed out" $seconds (str:concat $out $err)))
        ($other (str:concat "The command could not run: " (repr $other)))))))
(= (coding:now) (py-call (time.time)))
(= (coding:patch $workdir $patch)
   (let $receipt (py-call (apply_patch.apply $patch $workdir)) (format-args "{}" ($receipt))))
(= (coding:plan $dir $args)
   (let $_ (fs:update-text (coding:file $dir "plan.json") "replace" (json-stringify $args) "" "") "Plan updated"))
(= (coding:tool $dir $workdir $name $args)
   (if (== $name "exec_command") (coding:exec $workdir $args)
     (if (== $name "apply_patch")
       (coding:patch $workdir (coding:text (coding:field $args "patch")))
       (if (== $name "update_plan") (coding:plan $dir $args)
         (str:concat "Unknown tool: " $name)))))
(= (coding:arguments $raw)
   (case (catch (json-parse (if (== $raw "") "{}" $raw)))
     (((Error $where $why) (JsonObject ())) ($parsed $parsed))))
(= (coding:run-call $dir $workdir $call)
   (let* (($id (coding:text (coding:field $call "id")))
          ($function (coding:field $call "function"))
          ($name (coding:text (coding:field $function "name")))
          ($args (coding:arguments (coding:text (coding:field $function "arguments"))))
          ($output (coding:tool $dir $workdir $name $args)))
     (coding:record $dir (coding:tool-message $id $output))))
; What a reply without text did, for the progress line, as Codex shows the
; commands it runs: the command, the patched files or the plan update.
(= (coding:call-line $call)
   (let* (($function (coding:field $call "function"))
          ($name (coding:text (coding:field $function "name")))
          ($args (coding:arguments (coding:text (coding:field $function "arguments")))))
     (case $name
       (("exec_command" (str:concat "$ " (coding:text (coding:field $args "cmd"))))
        ("apply_patch" (str:concat "apply_patch" (coding:patch-files (str:split "\n" (coding:text (coding:field $args "patch"))) "")))
        ($other $name)))))
(= (coding:patch-files $lines $out)
   (if (== $lines ()) $out
     (let* (($line (car-atom $lines))
            ($file (if (str:starts-with $line "*** ") (str:concat " " (str:char-slice $line 4 (str:char-length $line))) "")))
       (coding:patch-files (cdr-atom $lines) (if (or (== $file "") (or (str:starts-with $line "*** Begin") (str:starts-with $line "*** End")))
                                                $out (str:concat $out $file))))))
(= (coding:call-lines $calls $out)
   (if (== $calls ()) (coding:reverse $out ())
     (let $line (coding:call-line (car-atom $calls)) (coding:call-lines (cdr-atom $calls) (cons-atom $line $out)))))
(= (coding:progress $text $calls)
   (if (not (== (str:trim $text) "")) $text
     (let $lines (coding:call-lines $calls ())
       (let $joined (str:join " · " $lines)
         (if (<= (str:char-length $joined) 300) $joined (str:concat (str:char-slice $joined 0 300) " …"))))))
(= (coding:run-calls $dir $workdir $calls $out)
   (if (== $calls ()) (coding:reverse $out ())
     (coding:run-calls $dir $workdir (cdr-atom $calls)
       (cons-atom (coding:run-call $dir $workdir (car-atom $calls)) $out))))

(= (coding:tools) (json-parse (fs:read-text "identity/coding-tools.json")))
(= (coding:request $messages $effort $tools)
   (let* (($pairs ((JsonPair "model" (JsonString "session")) (JsonPair "max_tokens" (JsonNumber "32768"))
                   (JsonPair "messages" (JsonArray $messages)) (JsonPair "cache_messages" (JsonBool True))))
          ($reasoned (if (== $effort "default") $pairs
                       (cons-atom (JsonPair "reasoning" (JsonObject ((JsonPair "effort" (JsonString $effort))))) $pairs))))
     (JsonObject (if (== $tools ()) $reasoned (cons-atom (JsonPair "tools" $tools) $reasoned)))))
(= (coding:ask-once $dir $request)
   (let* (($text (json-stringify $request))
          ($plan (py-call (native_llm_host.structured_json_plan $text)))
          ($box (llm:run $plan))
          ($reply (coding:file $dir "reply.json"))
          ($_ (py-call (native_llm_host.structured_json_result $box $reply))))
     (json-parse (fs:read-text $reply))))
; Failed calls are retried with a growing wait, as Codex retries five times.
(= (coding:ask $dir $request $attempt)
   (case (catch (coding:ask-once $dir $request))
     (((Error $where $why)
        (let $_ (println! (CodingCallFailed attempt $attempt $where $why))
          (if (>= $attempt 4) (CallFailed (str:join " " ((repr $where) (repr $why))))
            (let* (($wait (* 2 (+ $attempt 1))) ($_ (py-call (time.sleep $wait)))) (coding:ask $dir $request (+ $attempt 1))))))
      ($reply (case (coding:field $reply "message")
                ((JsonNull (if (>= $attempt 4) (CallFailed "no message in the reply")
                             (coding:ask $dir $request (+ $attempt 1))))
                 ($message $reply)))))))

; Tokens are estimated at four bytes each, as Codex estimates new items.
(= (coding:estimate $messages) (/ (str:byte-length (json-stringify (JsonArray $messages))) 4))
(= (coding:window)
   (let $capacity (py-call (strategy_host.context_capacity 32768))
     (if (== (get-metatype $capacity) Grounded) $capacity 200000)))
(= (coding:steering $lines $out)
   (if (== $lines ()) (coding:reverse $out ())
     (coding:steering (cdr-atom $lines)
       (cons-atom (coding:message "user" (str:concat "From the requester, mid-task: " (coding:text (car-atom $lines)))) $out))))
(= (coding:fold-inbox $dir $messages $consumed)
   (let* (($lines (coding:json-lines (coding:file $dir "inbox.jsonl")))
          ($new (coding:drop $lines $consumed)))
     (if (== $new ()) (Folded $messages $consumed)
       (let $added (coding:record-all $dir (coding:steering $new ()) ())
         (Folded (coding:append-list $messages $added) (+ $consumed (length $new)))))))

; The compacted history keeps the instructions, the task and the requester's
; later messages, then the handoff summary; the full history is archived.
(= (coding:requester-messages $messages $out)
   (if (== $messages ()) (coding:reverse $out ())
     (let $message (car-atom $messages)
       (coding:requester-messages (cdr-atom $messages)
         (if (== (coding:text (coding:field $message "role")) "user") (cons-atom $message $out) $out)))))
(= (coding:rewrite $dir $messages)
   (let* (($history (coding:file $dir "messages.jsonl"))
          ($archive (str:join "" ($history "." (repr (coding:now)) ".archived")))
          ($_ (py-call (os.replace $history $archive)))
          ($_ (coding:record-all $dir $messages ())))
     $messages))
(= (coding:compact $dir $messages $effort)
   (let* (($ask (coding:append-list $messages ((coding:message "user" (fs:read-text "identity/coding-compact.txt")))))
          ($reply (coding:ask $dir (coding:request $ask $effort ()) 0)))
     (case $reply
       (((CallFailed $why) $messages)
        ($ok (let* (($summary (coding:text (coding:field (coding:field $ok "message") "content")))
                    ($head (cons-atom (car-atom $messages) (coding:requester-messages (cdr-atom $messages) ())))
                    ($handoff (coding:message "user" (str:concat
                      "Another model began this task and left this handoff summary; continue from it and do not restart from scratch.\n\n"
                      $summary))))
               (coding:rewrite $dir (coding:append-list $head ($handoff)))))))))

(= (coding:finish $dir $status $text $steps $inbox)
   (let* (($_ (fs:update-text (coding:file $dir "report.txt") "replace" $text "" ""))
          ($_ (coding:state $dir $status $steps $text $inbox)))
     (CodingFinished $status)))
(= (coding:loop $dir $workdir $effort $window $tools $messages $steps $inbox)
   (if (fs:is-file (coding:file $dir "stop")) (coding:finish $dir "stopped" "Stopped by the requester." $steps $inbox)
     (let* (((Folded $steered $next) (coding:fold-inbox $dir $messages $inbox))
            ($current (if (> (coding:estimate $steered) (* 0.9 $window)) (coding:compact $dir $steered $effort) $steered))
            ($reply (coding:ask $dir (coding:request $current $effort $tools) 0)))
       (case $reply
         (((CallFailed $why) (coding:finish $dir "failed" (str:concat "The model call failed: " $why) $steps $next))
          ($ok
            (let* (($message (coding:record $dir (coding:field $ok "message")))
                   ($calls (coding:items (coding:field $message "tool_calls")))
                   ($text (coding:text (coding:field $message "content")))
                   ($_ (coding:state $dir "running" (+ $steps 1) (coding:progress $text $calls) $next)))
              (if (== $calls ()) (coding:finish $dir "done" $text (+ $steps 1) $next)
                (let $results (coding:run-calls $dir $workdir $calls ())
                  (coding:loop $dir $workdir $effort $window $tools
                    (coding:append-list $current (cons-atom $message $results)) (+ $steps 1) $next))))))))))

(= (coding:begin $dir $task $workdir)
   (let* (($instructions (fs:read-text "identity/coding-instructions.txt"))
          ($system (coding:message "system" (str:join "" ($instructions "\nWorkspace: " $workdir)))))
     (coding:record-all $dir ($system (coding:message "user" $task)) ())))
(= (coding:start $dir)
   (let* (($task-json (coding:json-file (coding:file $dir "task.json") (JsonObject ())))
          ($task (coding:text (coding:field $task-json "task")))
          ($given (coding:text (coding:field $task-json "workdir")))
          ($workdir (if (== $given "") $dir $given))
          ($chosen (coding:text (coding:field $task-json "effort")))
          ($effort (if (== $chosen "") "high" $chosen))
          ($existing (coding:json-lines (coding:file $dir "messages.jsonl")))
          ($messages (if (== $existing ()) (coding:begin $dir $task $workdir) $existing))
          ($state (coding:json-file (coding:file $dir "state.json") (JsonObject ())))
          ($steps (coding:number (coding:field $state "steps") 0))
          ($inbox (coding:number (coding:field $state "inbox") 0))
          ($_ (coding:state $dir "running" $steps "started" $inbox)))
     (coding:loop $dir $workdir $effort (coding:window) (coding:tools) $messages $steps $inbox)))

(= (coding:last $items) (if (== (cdr-atom $items) ()) (car-atom $items) (coding:last (cdr-atom $items))))
(= (coding:notify $dir $status)
   (let* (($task (coding:json-file (coding:file $dir "task.json") (JsonObject ())))
          ($requester (coding:text (coding:field $task "requester")))
          ($state (coding:json-file (coding:file $dir "state.json") (JsonObject ())))
          ($id (coding:last (str:split "/" $dir)))
          ($report (if (fs:is-file (coding:file $dir "report.txt")) (fs:read-text (coding:file $dir "report.txt")) ""))
          ($text (str:join "" ("Work " $id " " $status " after " (repr (coding:number (coding:field $state "steps") 0))
                               " steps. Task: " (coding:text (coding:field $task "task")) "\n\nReport:\n" $report)))
          ($mailer (system:getenv-or-default "METTACLAW_WORK_MAIL" "claw-mail"))
          ($worklog (system:getenv-or-default "METTACLAW_WORKLOG_COMMAND" ""))
          ($_ (if (== $requester "") ()
                (proc:run ("env" (str:concat "CLAW_MAIL_AGENT=" $id) $mailer "send" $requester $text) $dir inherit 60000 0 "merged")))
          ($_ (if (== $worklog "") ()
                (proc:run ($worklog "add" (str:join "" ("Work " $id " " $status ": " (str:char-slice $report 0 900))))
                          $dir inherit 60000 0 "merged"))))
     (CodingNotified $status)))
