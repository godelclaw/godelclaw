; Request projections and recovery views over existing native ledger verbs.
!(import! &self ./turn_frame_cetta.metta)
(= (turn:json-atom $value)
   (case $value
     ((none JsonNull) (True True) (False False)
      ($other (if (== (get-type $other) String) (JsonString $other)
                (if (== (get-type $other) Number) (JsonNumber (repr $other)) (JsonString (repr $other))))))))
(= (turn:record-pairs $names $values)
   (if (== $names ()) ()
     (cons-atom (JsonPair (car-atom $names) (turn:json-atom (car-atom $values)))
       (turn:record-pairs (cdr-atom $names) (cdr-atom $values)))))
(= (turn:record $names $values) (JsonObject (turn:record-pairs $names $values)))
(= (turn:records $names $rows)
   (if (== $rows ()) ()
     (cons-atom (turn:record $names (car-atom $rows)) (turn:records $names (cdr-atom $rows)))))
(= (turn:request-read $request $offset)
   (if (not (strategy:enabled?)) "PROTECTED_STRATEGY_DISABLED"
     (case (state:ledger "request-record" ($request (max 0 $offset)))
       ((none (turn:json (JsonObject ((JsonPair "id" (JsonString $request)) (JsonPair "status" (JsonString "unknown"))))))
        ((record $id $kind $checker $status $processed $note $piece $length $digest)
          (turn:json (JsonObject
            (list:append (turn:record-pairs ("id" "status" "checker" "kind" "processed" "note" "content" "content_digest" "offset")
                           ($id $status $checker $kind $processed $note $piece $digest (max 0 $offset)))
              ((JsonPair "next_offset" (if (< (+ (max 0 $offset) 4000) $length)
                                         (JsonNumber (repr (+ (max 0 $offset) 4000))) JsonNull)))))))
        ($bad (Error turn:request-read $bad))))))
(= (turn:request-status $request) (turn:request-read $request 0))
(= (turn:request-page $offset) (turn:request-page $offset 8))
(= (turn:request-page $offset $limit)
   (if (not (strategy:enabled?)) "PROTECTED_STRATEGY_DISABLED"
     (case (state:ledger "request-page" ((max 0 $offset) (max 1 $limit)))
       (((page $total $rows)
         (let $next (+ (max 0 $offset) (size-atom $rows))
           (turn:json (JsonObject
             ((JsonPair "records" (JsonArray (turn:records ("id" "status" "checker" "kind" "processed" "summary" "note") $rows)))
              (JsonPair "total" (JsonNumber (repr $total)))
              (JsonPair "next_offset" (if (< $next $total) (JsonNumber (repr $next)) JsonNull)))))))
        ($bad (Error turn:request-page $bad))))))
(= (turn:request-disposition $request $disposition $note)
   (if (not (strategy:enabled?)) "PROTECTED_STRATEGY_DISABLED"
     (case (state:ledger "request-get" ($request head))
       ((none (str:join "" ("REQUEST_DISPOSITION_WITHHELD: unknown ID " $request "; (requests) lists request IDs")))
        ((got $_ $_ $_ $_ $_ $_ $_)
          (case (turn:write "request-disposition" ($request (turn:text $disposition) $note))
            ((ok "REQUEST_DISPOSITION_RECORDED")
             ((refused $why) (str:join "" ("REQUEST_DISPOSITION_WITHHELD: " $why " (request " $request ")")))
             ($bad (Error turn:request-disposition $bad)))))
        ($bad (Error turn:request-disposition $bad))))))
(= (turn:focus-request $request)
   (if (not (strategy:enabled?)) "PROTECTED_STRATEGY_DISABLED"
     (if (not (turn:selectable? $request)) "REQUEST_FOCUS_WITHHELD_UNKNOWN_OR_FINISHED"
       (case (turn:write "task-focus" ($request))
         ((ok (let $_ (turn:put "focus" $request) (str:concat "REQUEST_FOCUSED " $request)))
          ($bad (Error turn:focus-request $bad)))))))
(= (turn:protected-results $rows)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((action $ticket $request $serial $tool $command $status $observed (receipt $disposition $domain) $payload)
         (let* (($piece (str:char-slice $payload 0 (min 6000 (str:char-length $payload))))
                ($record (JsonObject
                  ((JsonPair "ticket" (JsonString $ticket)) (JsonPair "payload" (JsonString $piece))
                   (JsonPair "disposition" (JsonString $disposition)) (JsonPair "domain" (JsonString $domain))
                   (JsonPair "payload_digest" (JsonString (turn:digest $payload)))
                   (JsonPair "truncated" (> (str:char-length $payload) 6000))))))
           (cons-atom $record (turn:protected-results (cdr-atom $rows)))))
        ($other (turn:protected-results (cdr-atom $rows)))))))
(= (turn:view)
   (if (not (strategy:enabled?)) ""
     (case (state:ledger "request-protected" ((turn:focus)))
       (((protected $counts $total $unfinished $slice)
         (let* (($focus (turn:focus)) ($owner (turn:owner))
                (($piece $length) (case $slice (((slice $text $n) ($text $n)) ($none ("" 0)))))
                ($actions (state:ledger "actions" ((protected $focus)))))
           (if (turn:failed? $actions) $actions
             (turn:json (JsonObject
               ((JsonPair "owner" (JsonString $owner)) (JsonPair "focus" (JsonString $focus))
                (JsonPair "request" (JsonString $piece))
                (JsonPair "unfinished" (JsonArray (turn:records ("id" "summary" "content_digest" "checker") $unfinished)))
                (JsonPair "counts" (JsonObject (turn:count-pairs $counts)))
                (JsonPair "omitted_active" (JsonNumber (repr (max 0 (- (turn:count-active $counts) (size-atom $unfinished))))))
                (JsonPair "request_truncated" (> $length 4000))
                (JsonPair "request_index" (JsonObject ((JsonPair "retrieve" (JsonArray ((JsonString "request-page") (JsonNumber "0"))))
                                                       (JsonPair "scope" (JsonString "all retained requests")))))
                (JsonPair "results" (JsonArray (turn:protected-results $actions)))))))))
        ($bad (Error turn:view $bad))))))
(= (turn:count-pairs $rows)
   (if (== $rows ()) ()
     (let* ((($key $value) (car-atom $rows)) ($rest (turn:count-pairs (cdr-atom $rows))))
       (cons-atom (JsonPair $key (JsonNumber (repr $value))) $rest))))
(= (turn:count-active $rows)
   (if (== $rows ()) 0
     (let (($name $value) $rest) (decons-atom $rows)
       (if (== $name "active") $value (turn:count-active $rest)))))
(= (turn:attempt-not-recorded $ticket $position $why)
   (let $_ (turn:put "phase" "failed")
     (Error strategy:attempt-not-recorded (Incomplete ($ticket $position $why)))))
(= (turn:receipt-row $row)
   (case $row
     (((attempt $ticket $position $command $result $order)
       (let* (($id (str:concat $ticket (str:concat ":" (repr $position))))
              ($value (if (== $result none)
                        (JsonObject ((JsonPair "disposition" (JsonString "uncertain"))
                                     (JsonPair "reason" (JsonString "no terminal receipt recorded; do not replay"))))
                        (json:parse $result)))
              ($record (JsonObject ((JsonPair "command" (json:parse $command)) (JsonPair "id" (JsonString $id))
                                    (JsonPair "position" (JsonNumber (repr $position))) (JsonPair "result" $value)
                                    (JsonPair "ticket" (JsonString $ticket))))))
         (ReceiptRowV1 $order $id $record)))
      ($bad (Error turn:receipt $bad)))))
(= (turn:receipt-envelope $records $next)
   (JsonObject ((JsonPair "receipts" (JsonArray $records)) (JsonPair "next_cursor" $next))))
(= (turn:receipt-cursor $row $offset) (JsonString (str:join ":" ((repr $row) (repr $offset)))))
(= (turn:receipt-fragment $row $id $raw $offset $end $next)
   (turn:receipt-envelope
     ((JsonObject ((JsonPair "id" (JsonString $id))
                   (JsonPair "chunk" (JsonString (str:char-slice $raw $offset $end)))
                   (JsonPair "offset" (JsonNumber (repr $offset))) (JsonPair "total" (JsonNumber (repr (str:char-length $raw)))))))
     (if (< $end (str:char-length $raw)) (turn:receipt-cursor $row $end) $next)))
(= (turn:receipt-fit $row $id $raw $offset $low $high $next)
   (if (>= $low $high) (turn:receipt-fragment $row $id $raw $offset $low $next)
     (let* (($mid (math:floor (/ (+ $low $high 1) 2)))
            ($candidate (turn:receipt-fragment $row $id $raw $offset $mid $next)))
       (if (<= (str:byte-length (turn:json $candidate)) 8192)
         (turn:receipt-fit $row $id $raw $offset $mid $high $next)
         (turn:receipt-fit $row $id $raw $offset $low (- $mid 1) $next)))))
(= (turn:receipt-page $rows $bound $offset $records $left)
   (if (or (== $rows ()) (== $left 0)) (turn:receipt-envelope $records JsonNull)
     (case (turn:receipt-row (car-atom $rows))
       (((ReceiptRowV1 $order $id $record)
         (let* (($rest (cdr-atom $rows)) ($raw (turn:json $record))
                ($start (if (== $order $bound) $offset 0))
                ($next (if (== $rest ()) JsonNull (turn:receipt-cursor (- $order 1) 0)))
                ($candidate (turn:receipt-envelope (list:append $records ($record)) $next)))
           (if (> $start (str:char-length $raw)) (JsonObject ((JsonPair "error" (JsonString "receipt cursor beyond record"))))
             (if (and (== $start 0) (<= (str:byte-length (turn:json $candidate)) 8192))
               (if (or (== $rest ()) (== $left 1)) $candidate
                 (turn:receipt-page $rest $bound $offset (list:append $records ($record)) (- $left 1)))
               (if (!= $records ())
                 (turn:receipt-envelope $records (turn:receipt-cursor $order $start))
                 (turn:receipt-fit $order $id $raw $start $start (min (str:char-length $raw) (+ $start 8192)) $next))))))
        ($bad $bad)))))
(= (turn:command-receipts) (turn:command-receipts ""))
(= (turn:command-receipts $cursor)
   (if (not (strategy:enabled?)) "command receipts require the managed strategy"
     (if (and (!= $cursor "") (not (re:is-match (re:compile "^[0-9]{1,18}:[0-9]{1,18}$") $cursor)))
       (turn:json (JsonObject ((JsonPair "error" (JsonString "invalid receipt cursor")))))
       (let* (($parts (if (== $cursor "") ("4611686018427387904" "0") (str:split ":" $cursor)))
              ($bound (str:string->number (car-atom $parts))) ($offset (str:string->number (index-atom $parts 1)))
              ($rows (state:ledger "attempts" ((recent $bound 33)))))
         (if (turn:failed? $rows) $rows
           (turn:json (turn:receipt-page $rows $bound $offset () 32)))))))
