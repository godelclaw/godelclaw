!(import! &self ./src/hierarchy_store)
!(import! &self system)
!(import! &self json)
!(bind! &hierarchy-task (new-state "autonomous"))
(= (hierarchy:task) (get-state &hierarchy-task))
!(bind! &hierarchy-boot (new-state (space:request-id)))

(= (hierarchy:socket)
   (system:getenv-or-default "METTACLAW_HIERARCHY_SOCKET"
     (system:getenv-or-default "METTACLAW_MAIL_SOCKET" "")))
(= (hierarchy:space)
   (system:getenv-or-default "METTACLAW_HIERARCHY_SPACE"
     (str:join "" ("agent-memory-" (system:getenv-or-default "METTACLAW_INSTANCE" "default")))))
(= (hierarchy:project)
   (system:getenv-or-default "METTACLAW_MEMORY_PROJECT" "runtime"))
(= (hierarchy:enabled?) (not (== (hierarchy:socket) "")))
(= (hierarchy:append-context $request $context) (str:join "" ($request "\n" $context)))
(= (hierarchy:begin $turn $source $projection)
   (case (json-object-get (json-parse $projection) "focus")
     (((JsonString $id) (change-state! &hierarchy-task $id)) ($other True))))
(= (hierarchy:report $value)
   (case $value
     (((HStored $id $r $status) True)
      ((HSummarized $id $r) True)
      ($error (let $printed (println! (HIERARCHY_ERROR $error)) False)))))
; The runner captures full turn evidence automatically after its existing
; history commit. Failure is reported and never blocks commands or messages.
(= (hierarchy:record $turn $source $message $response $results)
   (if (hierarchy:enabled?)
     (let* (($task (get-state &hierarchy-task))
            ($project (hierarchy:project))
            ($turn-text (repr $turn))
            ($episode (str:join ":" ((get-state &hierarchy-boot) $turn-text)))
            ($body (repr (HTurn $source $message $response $results))))
       (hierarchy:report (hm:record (hierarchy:socket) (hierarchy:space)
         $project $task $episode $turn-text (repr $message) $body)))
     True))

(= (memory-node $id $kind $title $body) (memory-node $id $kind $title $body () ()))
(= (memory-node $id $kind $title $body $children) (memory-node $id $kind $title $body $children ()))
(= (memory-node $id $kind $title $body $children $sources)
   (hm:put (hierarchy:socket) (hierarchy:space) $id $kind $title $body $children $sources))
(= (memory-link $parent $child)
   (hm:link (hierarchy:socket) (hierarchy:space) $parent $child))
(= (memory-summary $id $text)
   (hm:summarize (hierarchy:socket) (hierarchy:space) $id $text))
(= (memory-retire $id) (memory-retire $id ""))
(= (memory-retire $id $reason)
   (hm:retire (hierarchy:socket) (hierarchy:space) $id $reason))
(= (memory-open $id)
   (memory-open $id (hm:setting (hierarchy:socket) (hierarchy:space) depth 1)))
(= (memory-open $id $depth)
   (hm:expand (hierarchy:socket) (hierarchy:space) $id $depth))
(= (memory-find $phrase) (memory-find $phrase ""))
(= (memory-find $phrase $root)
   (hm:search (hierarchy:socket) (hierarchy:space) $phrase $root))
(= (memory-original $id $revision)
   (hm:history (hierarchy:socket) (hierarchy:space) $id $revision))
(= (memory-focus $id)
   (hm:set-setting (hierarchy:socket) (hierarchy:space) focus $id))
(= (memory-focus $id $depth)
   (if (< $depth 0) (HFailure invalid-depth $depth)
     (case (hm:set-setting (hierarchy:socket) (hierarchy:space) depth $depth)
       (((HConfigured depth $depth) (memory-focus $id)) ($error $error)))))
(= (memory-window $characters)
   (if (< $characters 0) (HFailure invalid-window $characters)
     (hm:set-setting (hierarchy:socket) (hierarchy:space) characters $characters)))
(= (hierarchy:context)
   (if (hierarchy:enabled?)
     (let $chosen (hm:setting (hierarchy:socket) (hierarchy:space) focus "")
       (let $id (if (== $chosen "") (get-state &hierarchy-task) $chosen)
         (case (hm:context (hierarchy:socket) (hierarchy:space) $id)
           (((HFailure missing-node $missing) "")
            ((HInactive $id $reason) "")
            ((HContext $cid $r $kind $title $overview $children)
             (hierarchy:context-text $cid $r $kind $title $overview $children))
            ($error (repr (HIERARCHY_UNAVAILABLE $error)))))))
     ""))
(= (hierarchy:context-text $id $r $kind $title $overview $children)
   (let* (($brief (case $overview
                    (((HOverview $status $summary-text $sources) (HOverview $status $summary-text)) ($error $error))))
          ($text (repr (HIERARCHICAL_MEMORY $id $r $kind $title $brief $children)))
          ($characters (hm:setting (hierarchy:socket) (hierarchy:space) characters 8000)))
     (if (or (== $characters 0) (<= (str:char-length $text) $characters)) $text
       (str:join "" ((str:char-slice $text 0 $characters)
         "\n[context excerpt; expand with memory-open " (repr $id) "]")))))
