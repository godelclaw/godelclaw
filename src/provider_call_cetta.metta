; Native request preparation bound to an existing owned provider lifecycle.
!(import! &self ./provider_request_cetta.metta)
!(import! &self ./native_call_cetta.metta)
!(import! &self ./call_gate_cetta.metta)

; Call boundaries consume computed values in both extended dialects.
(: pcall:begin (-> %Undefined% %Undefined% %Undefined%))
(: pcall:command-plan (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:command-plan-purpose (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:contains (-> %Undefined% %Undefined% %Undefined%))
(: pcall:encoded (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:fact (-> %Undefined% %Undefined% %Undefined%))
(: pcall:metadata (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:prepared (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:refused (-> %Undefined% %Undefined% %Undefined%))
(: pcall:seal (-> %Undefined% %Undefined%))
(: pcall:submit (-> %Undefined% %Undefined% %Undefined%))
(: pcall:transport (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:bound (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:bindable? (-> %Undefined% %Undefined% %Undefined%))
(: pcall:metadata-of (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:structured-plan (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:structured-prepared (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:structured-encoded (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:offered-tokens (-> %Undefined% %Undefined%))

(= (pcall:fact $facts $key)
   (let $value (preq:field $facts $key)
     (case $value (((JsonString $text) $text) ((JsonNumber $text) (json:parse $text))
       ((JsonBool $flag) $flag) ($other $other)))))
(= (pcall:contains $text $needle)
   (case (str:find $text $needle) (((TextNotFound $missing) False) ($found True))))
(= (pcall:seal (PreparedProviderTransportV1 $epoch $correlation $protocol $url $headers $wire
                                       $timeout $cap $connect $first $idle))
   (let* (($hard-text (preq:repr $timeout)) ($cap-text (preq:repr $cap))
          ($connect-text (preq:repr $connect)) ($first-text (preq:repr $first)) ($idle-text (preq:repr $idle))
          ($records ($epoch $correlation $protocol $url $headers $wire
                     $hard-text $cap-text $connect-text $first-text $idle-text))
          ((Sha256ChainV1 $initial $rows) (str:sha256-chain "prepared-provider-transport-v1" $records))
          ($last (- (preq:size $rows) 1))
          (($bytes $own $digest) (preq:nth $rows $last))) $digest))
(= (pcall:transport $facts $path $wire)
   (let* (($epoch (pcall:fact $facts "epoch")) ($correlation (pcall:fact $facts "correlation"))
          ($protocol (pcall:fact $facts "protocol")) ($base (pcall:fact $facts "base"))
          ($url (str:concat $base $path)) ($headers (pcall:fact $facts "headers"))
          ($timeout (pcall:fact $facts "timeout")) ($cap (pcall:fact $facts "cap"))
          ($connect (pcall:fact $facts "connect")) ($first (pcall:fact $facts "first")) ($idle (pcall:fact $facts "idle")))
     (PreparedProviderTransportV1 $epoch $correlation $protocol $url $headers $wire
                                  $timeout $cap $connect $first $idle)))
(= (pcall:metadata $request $encoding $profile $prompt $active $model $layout)
   (let* (($canonical (preq:canonical $request)) ($fingerprint (str:sha256 $canonical))
          ($bytes (str:byte-length $prompt))
          ($feedback (pcall:contains $prompt "PREVIOUS_COMMAND_OUTPUT_REJECTED"))
          ($footer (pcall:contains $prompt "REQUIRED_COMMAND_OUTPUT")))
     (preq:object ((preq:pair "fingerprint" (preq:string $fingerprint))
       (preq:pair "encoding" (preq:string $encoding)) (preq:pair "prompt_layout" $profile)
       (preq:pair "prompt_bytes" (preq:number (preq:repr $bytes)))
       (preq:pair "feedback_visible" (preq:bool $feedback)) (preq:pair "footer_visible" (preq:bool $footer))
       (preq:pair "stream" (preq:bool $active)) (preq:pair "model" $model) (preq:pair "cache_layout" $layout)))))
; A refused preparation keeps its host handle for the failure it settles as;
; it never becomes a call owner.
(= (pcall:refused $plan $reason)
   (let* (($text (preq:repr $reason))
          ($host (py-call (native_llm_host.native_preparation_failed $plan $text))))
     (RefusedProviderCallV1 $host)))
; A command's metadata measures its prompt; a structured request has none.
(= (pcall:metadata-of (CommandMetadataV1 $request $encoding $profile $prompt) $active $model $layout)
   (pcall:metadata $request $encoding $profile $prompt $active $model $layout))
(= (pcall:metadata-of (StructuredMetadataV1 $request) $active $model $layout)
   (let $fingerprint (str:sha256 (preq:canonical $request))
     (preq:object ((preq:pair "fingerprint" (preq:string $fingerprint))
       (preq:pair "encoding" (preq:string "default")) (preq:pair "prompt_layout" JsonNull)
       (preq:pair "prompt_bytes" (preq:number "0"))
       (preq:pair "feedback_visible" (preq:bool False)) (preq:pair "footer_visible" (preq:bool False))
       (preq:pair "stream" (preq:bool $active)) (preq:pair "model" $model) (preq:pair "cache_layout" $layout)))))
; The prepared wire is sealed and owned natively. The owner's phase is the
; binding: a call is bound once, to a wire for the model its seed named. The
; host handle takes no part; it is only what the remaining host observers hold.
(= (pcall:bound $plan $facts $path $spec $result)
   (case $result
     (((PreparedProviderWireV1 $wire $active $model $layout)
       (if (pcall:bindable? $facts $model)
         (let* (($transport (pcall:transport $facts $path $wire)) ($seal (pcall:seal $transport))
                ($metadata (pcall:metadata-of $spec $active $model $layout)))
           (PreparedProviderCallV1 (call:owner $plan (pcall:owner-facts $facts $metadata $active) $seal) $transport))
         (pcall:refused $plan native-binding-refused)))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:bindable? $facts $model)
   (and (== $model (preq:string (pcall:fact $facts "wire_model")))
        (not (call:live? (pcall:fact $facts "correlation")))))
; The owner's immutable facts: the seed's, plus what preparation fixed.
(= (pcall:owner-facts $facts $metadata $active)
   (let* (((JsonObject $seed) (json:parse (preq:render $facts)))
          ((JsonObject $prepared) (json:parse (preq:render $metadata)))
          ($fingerprint (lp:field (JsonObject $prepared) "fingerprint" ""))
          ($layout (if (== (pcall:fact $facts "protocol") "anthropic")
                     (lp:field (JsonObject $prepared) "cache_layout" JsonNull) JsonNull))
          ($stream (if $active true false))
          ($prompt-layout (lp:field (JsonObject $prepared) "prompt_layout" JsonNull))
          ($prompt-bytes (lp:field (JsonObject $prepared) "prompt_bytes" 0))
          ($feedback (lp:field (JsonObject $prepared) "feedback_visible" false))
          ($footer (lp:field (JsonObject $prepared) "footer_visible" false))
          ($pairs (call:append $seed ((JsonPair "fingerprint" $fingerprint) (JsonPair "prepared_stream" $stream)
                                      (JsonPair "cache_layout" $layout) (JsonPair "prompt_layout" $prompt-layout)
                                      (JsonPair "prompt_bytes" $prompt-bytes)
                                      (JsonPair "feedback_visible" $feedback) (JsonPair "footer_visible" $footer)))))
     (JsonObject $pairs)))
(= (pcall:encoded $plan $facts $request $encoding $cache $profile $prompt $encoded)
   (case $encoded
     (((llm:v1:ok (llm:v1:wire $path $body))
       (let* (($provider (pcall:fact $facts "provider")) ($protocol (pcall:fact $facts "protocol"))
              ($stream (preq:truthy (preq:field $facts "stream")))
              ($visible (preq:truthy (preq:field $facts "visible")))
              ($result (preq:wire $body $provider $protocol "command" $stream $visible $cache)))
         (pcall:bound $plan $facts $path (CommandMetadataV1 $request $encoding $profile $prompt) $result)))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:prepared $plan $facts $prompt $prepared)
   (case $prepared
     (((PreparedProviderCommandV1 $request $encoding $cache $profile)
       (let* (($provider (pcall:fact $facts "provider")) ($protocol (pcall:fact $facts "protocol"))
              ($validation (if (== $provider "synthetic") (preq:synthetic $request) $request)))
         (case $validation
           (((ProviderPreparationRefusedV1 $why) (pcall:refused $plan $why))
            ($valid (let $encoded (preq:encode $protocol $encoding $request)
                      (pcall:encoded $plan $facts $request $encoding $cache $profile $prompt $encoded)))))))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:command-plan $selected $tokens $effort $prompt)
   (pcall:command-plan-purpose $selected $tokens $effort $prompt "turn"))
(= (pcall:command-plan-purpose $selected $tokens $effort $prompt $purpose)
   (let* ((($plan $text) (py-call (native_llm_host.native_call_seed $selected $tokens "command" $purpose)))
          ($facts (preq:parse $text)))
     (if (not (preq:truthy (preq:field $facts "ready"))) (RefusedProviderCallV1 $plan)
       (if (not (== (str:utf8-error $prompt) StrUtf8WellFormedV1)) (pcall:refused $plan invalid-prompt-utf8)
         (let* (($protocol (pcall:fact $facts "protocol")) ($model (pcall:fact $facts "wire_model"))
                ($tool (preq:field $facts "tool")) ($ttl (pcall:fact $facts "ttl"))
                ($prepared (preq:prepare-command $protocol $model $tokens $effort $prompt $tool $ttl)))
           (pcall:prepared $plan $facts $prompt $prepared))))))
; Structured (coding and iter) requests take the command's owned route: one
; seed of host facts, native preparation and wire, and the native call owner.
; Their purpose ("turn", "coding" or "compaction") is fixed here, before any claim.
(= (pcall:offered-tokens $request)
   (case (preq:get $request "max_tokens" JsonNull)
     (((JsonNumber $text) (if (preq:integer? (JsonNumber $text)) (str:string->number $text) 0))
      ($other 0))))
(= (pcall:structured-plan $selected $request $purpose)
   (let* ((($plan $text) (py-call (native_llm_host.native_call_seed $selected (pcall:offered-tokens $request) "structured" $purpose)))
          ($facts (preq:parse $text)))
     (if (not (preq:truthy (preq:field $facts "ready"))) (RefusedProviderCallV1 $plan)
       (let* (($protocol (pcall:fact $facts "protocol")) ($model (pcall:fact $facts "wire_model")))
         (pcall:structured-prepared $plan $facts (preq:prepare-structured $protocol $model $request))))))
(= (pcall:structured-prepared $plan $facts $prepared)
   (case $prepared
     (((PreparedProviderStructuredV1 $request $tokens)
       (let $checked (if (== (pcall:fact $facts "provider") "synthetic") (preq:structured-synthetic $request) $request)
         (case $checked
           (((ProviderPreparationRefusedV1 $why) (pcall:refused $plan $why))
            ($valid (let $encoded (preq:encode (pcall:fact $facts "protocol") "messages" $request)
                      (pcall:structured-encoded $plan $facts $request $encoded)))))))
      ((ProviderPreparationRefusedV1 $why) (pcall:refused $plan $why))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:structured-encoded $plan $facts $request $encoded)
   (case $encoded
     (((llm:v1:ok (llm:v1:wire $path $body))
       (let* (($stream (preq:truthy (preq:field $facts "stream")))
              ($visible (preq:truthy (preq:field $facts "visible")))
              ($result (preq:wire $body (pcall:fact $facts "provider") (pcall:fact $facts "protocol")
                                  "structured" $stream $visible ProviderCacheNoneV1)))
         (pcall:bound $plan $facts $path (StructuredMetadataV1 $request) $result)))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:begin $plan $transport)
   (if (not (llm:plan-ready $plan))
     (llm:v1:failed unsubmitted unsubmitted admission-error not-started)
    (let $seal (pcall:seal $transport)
     (if (not (call:seal-matches? $plan $seal))
       (llm:v1:rejected prepared-configuration-mismatch)
       (if (not (account:claim $plan))
         (if (llm:plan-ready $plan) (llm:v1:failed duplicate duplicate duplicate-plan not-started)
           (llm:v1:failed unsubmitted unsubmitted admission-error not-started))
         ; Distinct names: HE unifies a repeated $_ binding.
         (let* (($gated (call-gate:pass))
                ($shown (if (== (call:fact $plan "visible" false) true)
                          (py-call (native_llm_host.native_wire_started (call:host $plan))) False)))
           (pcall:submit $plan $transport)))))))
(= (pcall:submit $plan (PreparedProviderTransportV1 $epoch $correlation $protocol $url $headers-json $wire
                                              $timeout $cap $connect $first $idle))
   (case (llm:v1:headers-json $headers-json)
     (((llm:v1:ok $headers)
       (let $observed (llm:observe-wire (call:host $plan) $wire)
         (llm:network-ready $plan $epoch $correlation $protocol $url $headers $observed $timeout $cap
                            (NativeCallWaitsV1 $connect $first $idle))))
      ((llm:v1:error $why) (llm:v1:failed $epoch $correlation $why not-started)))))
