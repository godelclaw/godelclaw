; Native request preparation bound to an existing owned provider lifecycle.
!(import! &self ./provider_request_cetta.metta)

; Call boundaries consume computed values in both extended dialects.
(: pcall:begin (-> %Undefined% %Undefined% %Undefined%))
(: pcall:command-plan (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:contains (-> %Undefined% %Undefined% %Undefined%))
(: pcall:encoded (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:fact (-> %Undefined% %Undefined% %Undefined%))
(: pcall:metadata (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:prepared (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:refused (-> %Undefined% %Undefined% %Undefined%))
(: pcall:seal (-> %Undefined% %Undefined%))
(: pcall:submit (-> %Undefined% %Undefined% %Undefined%))
(: pcall:transport (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(: pcall:wire-result (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))

(= (pcall:fact $facts $key)
   (let $value (preq:field $facts $key)
     (case $value (((JsonString $text) $text) ((JsonNumber $text) (json:parse $text))
       ((JsonBool $flag) $flag) ($other $other)))))
(= (pcall:contains $text $needle)
   (case (str:find $text $needle) (((TextNotFound $missing) False) ($found True))))
(= (pcall:seal (PreparedProviderTransportV1 $epoch $correlation $protocol $url $headers $wire
                                       $timeout $cap $connect $first $idle))
   (let* (($hard-text (preq:repr $timeout)) ($cap-text (preq:repr $cap))
          ($connect-text (preq:repr $connect)) ($first-text (preq:repr $first)) ($idle-text (preq:repr $idle))
          ($records ($epoch $correlation $protocol $url $headers $wire
                     $hard-text $cap-text $connect-text $first-text $idle-text))
          ((Sha256ChainV1 $initial $rows) (str:sha256-chain "prepared-provider-transport-v1" $records))
          ($last (- (preq:size $rows) 1))
          (($bytes $own $digest) (preq:nth $rows $last))) $digest))
(= (pcall:transport $facts $path $wire)
   (let* (($epoch (pcall:fact $facts "epoch")) ($correlation (pcall:fact $facts "correlation"))
          ($protocol (pcall:fact $facts "protocol")) ($base (pcall:fact $facts "base"))
          ($url (str:concat $base $path)) ($headers (pcall:fact $facts "headers"))
          ($timeout (pcall:fact $facts "timeout")) ($cap (pcall:fact $facts "cap"))
          ($connect (pcall:fact $facts "connect")) ($first (pcall:fact $facts "first")) ($idle (pcall:fact $facts "idle")))
     (PreparedProviderTransportV1 $epoch $correlation $protocol $url $headers $wire
                                  $timeout $cap $connect $first $idle)))
(= (pcall:metadata $request $encoding $profile $prompt $active $model $layout)
   (let* (($canonical (preq:canonical $request)) ($fingerprint (str:sha256 $canonical))
          ($bytes (str:byte-length $prompt))
          ($feedback (pcall:contains $prompt "PREVIOUS_COMMAND_OUTPUT_REJECTED"))
          ($footer (pcall:contains $prompt "REQUIRED_COMMAND_OUTPUT")))
     (preq:object ((preq:pair "fingerprint" (preq:string $fingerprint))
       (preq:pair "encoding" (preq:string $encoding)) (preq:pair "prompt_layout" $profile)
       (preq:pair "prompt_bytes" (preq:number (preq:repr $bytes)))
       (preq:pair "feedback_visible" (preq:bool $feedback)) (preq:pair "footer_visible" (preq:bool $footer))
       (preq:pair "stream" (preq:bool $active)) (preq:pair "model" $model) (preq:pair "cache_layout" $layout)))))
(= (pcall:refused $plan $reason)
   (let $text (preq:repr $reason)
     (py-call (native_llm_host.native_preparation_failed $plan $text))))
(= (pcall:wire-result $plan $facts $request $encoding $profile $prompt $path $result)
   (case $result
     (((PreparedProviderWireV1 $wire $active $model $layout)
       (let* (($transport (pcall:transport $facts $path $wire)) ($seal (pcall:seal $transport))
              ($metadata (pcall:metadata $request $encoding $profile $prompt $active $model $layout))
              ($metadata-text (preq:render $metadata))
              ($bound (py-call (native_llm_host.bind_native_command $plan $seal $metadata-text))))
         (if (host:flag $bound) (PreparedProviderCallV1 $plan $transport)
           (pcall:refused $plan native-binding-refused))))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:encoded $plan $facts $request $encoding $cache $profile $prompt $encoded)
   (case $encoded
     (((llm:v1:ok (llm:v1:encoded $path $body))
       (let* (($provider (pcall:fact $facts "provider")) ($protocol (pcall:fact $facts "protocol"))
              ($stream (preq:truthy (preq:field $facts "stream")))
              ($visible (preq:truthy (preq:field $facts "visible")))
              ($result (preq:wire (preq:parse $body) $provider $protocol "command" $stream $visible $cache)))
         (pcall:wire-result $plan $facts $request $encoding $profile $prompt $path $result)))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:prepared $plan $facts $prompt $prepared)
   (case $prepared
     (((PreparedProviderCommandV1 $request $encoding $cache $profile)
       (let* (($provider (pcall:fact $facts "provider")) ($protocol (pcall:fact $facts "protocol"))
              ($validation (if (== $provider "synthetic") (preq:synthetic $request) $request)))
         (case $validation
           (((ProviderPreparationRefusedV1 $why) (pcall:refused $plan $why))
            ($valid (let* (($text (preq:render $request))
                          ($encoded (if (== $encoding "default")
                         (llm:v1:encode-command $protocol $text) (llm:v1:encode $protocol $text))))
                      (pcall:encoded $plan $facts $request $encoding $cache $profile $prompt $encoded)))))))
      ($invalid (pcall:refused $plan $invalid)))))
(= (pcall:command-plan $selected $tokens $effort $prompt)
   (let* ((($plan $text) (py-call (native_llm_host.native_command_seed $selected $tokens)))
          ($facts (preq:parse $text)))
     (if (not (preq:truthy (preq:field $facts "ready"))) $plan
       (if (not (== (str:utf8-error $prompt) StrUtf8WellFormedV1)) (pcall:refused $plan invalid-prompt-utf8)
         (let* (($protocol (pcall:fact $facts "protocol")) ($model (pcall:fact $facts "wire_model"))
                ($tool (preq:field $facts "tool")) ($ttl (pcall:fact $facts "ttl"))
                ($prepared (preq:prepare-command $protocol $model $tokens $effort $prompt $tool $ttl)))
           (pcall:prepared $plan $facts $prompt $prepared))))))
(= (pcall:begin $plan $transport)
   (if (not (llm:plan-ready $plan))
     (llm:v1:failed unsubmitted unsubmitted admission-error not-started)
    (let $seal (pcall:seal $transport)
     (if (not (host:flag (py-call (native_llm_host.native_prepared_matches $plan $seal))))
       (llm:v1:rejected prepared-configuration-mismatch)
       (if (not (llm:plan-claim $plan))
         (if (llm:plan-ready $plan) (llm:v1:failed duplicate duplicate duplicate-plan not-started)
           (llm:v1:failed unsubmitted unsubmitted admission-error not-started))
         (let* (($_ (py-call (native_llm_host.gate)))
                ($_ (py-call (native_llm_host.native_wire_started $plan))))
           (pcall:submit $plan $transport)))))))
(= (pcall:submit $plan (PreparedProviderTransportV1 $epoch $correlation $protocol $url $headers-json $wire
                                              $timeout $cap $connect $first $idle))
   (case (llm:v1:headers-json $headers-json)
     (((llm:v1:ok $headers)
       (let $observed (llm:observe-wire $plan $wire)
         (llm:network-ready $plan $epoch $correlation $protocol $url $headers $observed $timeout $cap
                            (NativeCallWaitsV1 $connect $first $idle))))
      ((llm:v1:error $why) (llm:v1:failed $epoch $correlation $why not-started)))))
