; Bounded, non-authoritative observations for the managed model context, read
; natively: the same facts and text as src/runtime_context.py, which the SWI
; lane keeps using. tests/test_runtime_cetta.py compares the two.
;
; Reading never acknowledges input, observes a command receipt, spends a
; budget or dispatches an effect. A missing, stale, malformed or unsupported
; source is unknown and is named in `unavailable`. The model name and memory
; reachability come from the subsystems that own them.
!(import! &self (library fs))
!(import! &self (library json))
!(import! &self (library math))
!(import! &self (library path))
!(import! &self (library proc))
!(import! &self (library sqlite))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self ./src/memory_health.py)
!(import! &self ./src/synthetic_llm.py)

(= (rt:max-chars) 2400)
(= (rt:receipt-window) 16)
(= (rt:number-limit) 1000000000000)
(= (rt:reasons)
   ("stale" "unknown-tool" "wrong-arity" "malformed-command" "no-current-capture" "paused"
    "uncertain" "exhausted" "cooldown" "authority" "request-budget" "output-token-budget"
    "retry-budget" "provider-cooldown" "single-action-observation-boundary" "host-transition-error"))

; ---- small helpers -------------------------------------------------------
(= (rt:member $item $items)
   (if (== $items ()) False (if (== (car-atom $items) $item) True (rt:member $item (cdr-atom $items)))))
(= (rt:append $left $right)
   (if (== $left ()) $right (let $rest (rt:append (cdr-atom $left) $right) (cons-atom (car-atom $left) $rest))))
(= (rt:nth $items $index)
   (if (== $items ()) "" (if (== $index 0) (car-atom $items) (rt:nth (cdr-atom $items) (- $index 1)))))
(= (rt:last $items) (if (== (cdr-atom $items) ()) (car-atom $items) (rt:last (cdr-atom $items))))
(= (rt:take-last $items $count) (rt:drop $items (max 0 (- (size-atom $items) $count))))
(= (rt:drop $items $count) (if (or (== $items ()) (<= $count 0)) $items (rt:drop (cdr-atom $items) (- $count 1))))
(= (rt:contains $text $part) (== (get-type (str:find $text $part)) Number))
(= (rt:text $number) (format-args "{}" ($number)))
; Python writes a float with a point or exponent even when it is whole.
(= (rt:float-text $number)
   (let $text (rt:text $number)
     (if (or (rt:contains $text ".") (or (rt:contains $text "e") (rt:contains $text "n"))) $text
       (str:concat $text ".0"))))
(= (rt:int-json $number) (JsonNumber (rt:text $number)))
(= (rt:opt-json $value) (case $value (((Val $n) (rt:int-json $n)) (None JsonNull))))
(= (rt:try $value) (case (catch $value) (((Error $where $why) None) ($result $result))))

; ---- JSON reading, with Python's dict.get semantics ------------------------
(= (rt:field $value $key)
   (case $value (((JsonObject $pairs) (rt:last-member $pairs $key Absent)) ($other Absent))))
(= (rt:last-member $pairs $key $found)
   (if (== $pairs ()) $found
     (let (JsonPair $name $value) (car-atom $pairs)
       (rt:last-member (cdr-atom $pairs) $key (if (== $name $key) $value $found)))))
(= (rt:get $value $key) (let $found (rt:field $value $key) (if (== $found Absent) JsonNull $found)))
(= (rt:get-or $value $key $default) (let $found (rt:field $value $key) (if (== $found Absent) $default $found)))
(= (rt:has $value $key) (!= (rt:field $value $key) Absent))
(= (rt:object-value $value) (case $value (((JsonObject $pairs) True) ($other False))))
(= (rt:true-json $value) (case $value (((JsonBool true) True) ((JsonBool True) True) ($other False))))
(= (rt:bool-json $value)
   (case $value (((JsonBool true) (Val True)) ((JsonBool True) (Val True))
                 ((JsonBool false) (Val False)) ((JsonBool False) (Val False)) ($other None))))
(= (rt:truthy $value)
   (case $value
     ((JsonNull False) ((JsonBool false) False) ((JsonBool False) False) ((JsonString "") False)
      ((JsonArray ()) False) ((JsonObject ()) False) (Absent False)
      ((JsonNumber $text) (case (rt:try (str:string->number $text)) ((None True) ($n (!= $n 0)))))
      ($other True))))
(= (rt:first-truthy $values $default)
   (if (== $values ()) $default
     (if (rt:truthy (car-atom $values)) (car-atom $values) (rt:first-truthy (cdr-atom $values) $default))))
(= (rt:integer-text $text)
   (let $digits (if (str:starts-with $text "-") (str:byte-slice $text 1 (str:byte-length $text)) $text)
     (and (!= $digits "") (str:is-all-in digit $digits))))
; A JSON integer in [0, 10^12], as Python's _nat: (Val n) or None.
(= (rt:nat $value)
   (case $value
     (((JsonNumber $text)
       (if (and (rt:integer-text $text) (<= (str:byte-length $text) 13))
         (let $n (str:string->number $text) (if (and (>= $n 0) (<= $n (rt:number-limit))) (Val $n) None))
         None))
      ($other None))))
; Any JSON integer, as Python's `type(value) is int`: (Val n) or None.
(= (rt:int $value)
   (case $value
     (((JsonNumber $text)
       (if (and (rt:integer-text $text) (<= (str:byte-length $text) 18)) (Val (str:string->number $text)) None))
      ($other None))))
; A finite JSON number in [0, 10^12], as Python's _number: (Val n) or None.
(= (rt:number $value)
   (case $value
     (((JsonNumber $text)
       (if (and (rt:integer-text $text) (> (str:byte-length $text) 13)) None
         (case (rt:try (str:string->number $text))
           ((None None)
            ($n (if (== (get-type $n) Number) (if (and (>= $n 0) (<= $n (rt:number-limit))) (Val $n) None) None))))))
      ($other None))))
(= (rt:age $stamp $now)
   (case (rt:number $stamp)
     (((Val $s) (if (and (> $s 0) (<= $s $now)) (Val (math:trunc (- $now $s))) None))
      (None None))))
(= (rt:older $age $limit) (case $age (((Val $a) (> $a $limit)) (None True))))
; A JSON object file of at most 64 KiB: (Val object) or None.
(= (rt:json-object $path)
   (if (not (fs:is-file $path)) None
     (let $text (fs:read-text $path)
       (if (> (str:byte-length $text) 65536) None
         (case (rt:try (json-parse $text))
           (((JsonObject $pairs) (Val (JsonObject $pairs))) ($other None)))))))

; ---- provider and settlement ---------------------------------------------
(= (rt:health-path)
   (let $configured (system:getenv-or-default "METTACLAW_COGNITIVE_HEALTH_PATH" "")
     (if (!= $configured "") $configured
       (let* (($home (system:getenv-or-default "HOME" ""))
              ($state (system:getenv-or-default "XDG_STATE_HOME" (path:join $home ".local/state")))
              ($instance (system:getenv-or-default "METTACLAW_INSTANCE" "default")))
         (path:join $state (path:join "pettaclaw" (path:join $instance "cognitive-health.json")))))))
(= (rt:schema-two $value)
   (case $value (((JsonNumber $text) (case (rt:try (str:string->number $text)) ((None False) ($n (== $n 2)))))
                 ($other False))))
(= (rt:failure-label $value)
   (let $text (case $value
                ((Absent "") ((JsonString $s) $s) (JsonNull "None")
                 ((JsonBool true) "True") ((JsonBool True) "True") ((JsonBool false) "False") ((JsonBool False) "False")
                 ((JsonNumber $t) $t) ($other (json-stringify $other))))
     (str:lower (if (> (str:char-length $text) 64) (str:char-slice $text 0 64) $text))))
(= (rt:classify $label)
   (if (rt:contains $label "timeout") "timeout"
     (if (or (rt:contains $label "rate") (rt:contains $label "quota")) "rate-limit"
       (if (rt:member $label (rt:reasons)) $label "unclassified-failure"))))
(= (rt:thousandths $ms) (math:trunc (/ (- $ms (% $ms 1000)) 1000)))
(= (rt:waiting-pairs $health $now)
   (let* (($base ((JsonPair "phase" (JsonString (if (rt:true-json (rt:get $health "local_commit_pending")) "recording" "waiting")))
                  (JsonPair "ageSeconds" (rt:opt-json (rt:age (rt:get $health "in_flight_since") $now)))))
          ($soft (if (rt:true-json (rt:get $health "soft_wait_elapsed"))
                   ((JsonPair "softWaitElapsed" (JsonBool True))) ()))
          ($bytes (case (rt:int (rt:get $health "response_bytes"))
                    (((Val $b) ((JsonPair "transportBytes" (rt:int-json (max 0 $b))))) (None ()))))
          ($quiet (case (rt:int (rt:get $health "transport_quiet_ms"))
                    (((Val $q) ((JsonPair "transportQuietSeconds" (rt:int-json (rt:thousandths (max 0 $q)))))) (None ())))))
     (rt:append $base (rt:append $soft (rt:append $bytes $quiet)))))
(= (rt:failed-pairs $health $now $retry)
   (let* (($backoff (> $retry $now))
          ($label (rt:failure-label (rt:field $health "last_failure_type")))
          ($base ((JsonPair "phase" (JsonString (if $backoff "backoff" "failed")))
                  (JsonPair "ageSeconds" (rt:opt-json (rt:age (rt:get $health "last_failed_at") $now)))
                  (JsonPair "reason" (JsonString (rt:classify $label))))))
     (if $backoff
       (rt:append $base ((JsonPair "retrySeconds" (rt:int-json (math:trunc (math:ceil (- $retry $now)))))))
       $base)))
(= (rt:call-pairs $health $now $pending $retry)
   (if (!= $pending 0) (rt:waiting-pairs $health $now)
    (if (rt:object-value (rt:get $health "provider_rejection"))
     (let $block (rt:get $health "provider_rejection")
       ((JsonPair "phase" (JsonString "blocked")) (JsonPair "status" (rt:get $block "status"))
        (JsonPair "code" (rt:get-or $block "code" (JsonString "")))
        (JsonPair "message" (rt:get-or $block "message" (JsonString "")))))
     (let $outcome (rt:get $health "last_outcome")
       (if (== $outcome (JsonString "failed")) (rt:failed-pairs $health $now $retry)
         (if (== $outcome (JsonString "completed"))
           ((JsonPair "phase" (JsonString "returned"))
            (JsonPair "ageSeconds" (rt:opt-json (rt:age (rt:get $health "last_completed_at") $now))))
           ((JsonPair "phase" (JsonString "idle")))))))))
(= (rt:cache-observation $usage)
   (if (not (rt:object-value $usage)) (JsonObject ((JsonPair "status" (JsonString "unknown"))))
     (let* (($details (rt:first-truthy ((rt:get $usage "prompt_tokens_details") (rt:get $usage "input_tokens_details"))
                                       (JsonObject ())))
            ($direct (if (rt:object-value $details) (rt:nat (rt:get $details "cached_tokens")) None))
            ($cached (if (== $direct None)
                       (rt:nat (rt:get-or $usage "cache_read_input_tokens" (rt:get $usage "prompt_cache_hit_tokens")))
                       $direct))
            ($reported (rt:nat (rt:get-or $usage "prompt_tokens" (rt:get $usage "input_tokens"))))
            ($total (if (and (rt:has $usage "cache_read_input_tokens") (!= $reported None))
                      (let $write (rt:nat (rt:get-or $usage "cache_creation_input_tokens" (JsonNumber "0")))
                        (if (and (!= $cached None) (!= $write None))
                          (let* (((Val $t) $reported) ((Val $c) $cached) ((Val $w) $write)) (Val (+ $t (+ $c $w))))
                          None))
                      $reported)))
       (rt:cache-result $cached $total))))
(= (rt:cache-result $cached $total)
   (if (or (== $total None) (== $cached None)) (JsonObject ((JsonPair "status" (JsonString "unknown"))))
     (let* (((Val $c) $cached) ((Val $t) $total))
       (if (> $c $t) (JsonObject ((JsonPair "status" (JsonString "unknown"))))
         (JsonObject ((JsonPair "status" (JsonString "reported")) (JsonPair "input_tokens" (rt:int-json $t))
                      (JsonPair "cached_tokens" (rt:int-json $c))
                      (JsonPair "fraction" (JsonNumber (if (== $t 0) "0.0" (rt:float-text (/ $c $t)))))))))))
(= (rt:completion-path)
   (let $configured (system:getenv-or-default "METTACLAW_LLM_COMPLETION_PATH" "")
     (if (!= $configured "") $configured (path:join (path:dirname (rt:health-path)) "llm-completion.json"))))
; Recent completion facts; any failure here leaves the provider facts as they are.
(= (rt:completion-pairs $now)
   (case (rt:json-object (rt:completion-path))
     ((None ())
      ((Val $completion)
       (if (rt:older (rt:age (rt:get $completion "observed_at") $now) 3600) ()
         (let* (($cache ((JsonPair "lastCache" (rt:cache-observation (rt:get $completion "usage")))))
                ($cut (if (== (rt:get $completion "finish_reason") (JsonString "length"))
                        ((JsonPair "responseCut" (JsonString "output limit reached; complete calls retained; trailing incomplete call was not run")))
                        ()))
                ($layout (rt:get-or $completion "prompt_layout" (JsonObject ())))
                ($stable (if (rt:object-value $layout)
                           (case (rt:nat (rt:get $layout "stable_chars"))
                             (((Val $n) ((JsonPair "stablePrefixChars" (rt:int-json $n)))) (None ())))
                           ())))
           (rt:append $cache (rt:append $cut $stable))))))))
; (Provider call-object turn-pending) or None.
(= (rt:provider $now)
   (case (rt:json-object (rt:health-path))
     ((None None)
      ((Val $health)
       (if (not (rt:schema-two (rt:get $health "schema"))) None
         (let* (($obligation (rt:number (rt:get $health "obligation_since")))
                ($pending (rt:number (rt:get $health "in_flight_since")))
                ($retry (rt:number (rt:get $health "retry_at"))))
           (if (or (== $obligation None) (or (== $pending None) (== $retry None))) None
             (let* (((Val $o) $obligation) ((Val $p) $pending) ((Val $r) $retry))
               (if (or (> $o $now) (> $p $now)) None
                 (let* (($call (rt:call-pairs $health $now $p $r))
                        ($extra (case (rt:try (rt:completion-pairs $now)) ((None ()) ($pairs $pairs)))))
                   (Provider (JsonObject (rt:append $call $extra)) (!= $o 0))))))))))))

; ---- local channel and operator inbox -------------------------------------
(= (rt:mode-state)
   (let $configured (system:getenv-or-default "METTACLAW_MODE_STATE_ROOT" "")
     (if (!= $configured "") (Val $configured)
       (let $engine (system:getenv-or-default "METTACLAW_ENGINE_STATE_PATH" "")
         (if (== $engine "") None (Val (path:join (path:dirname $engine) "modes")))))))
(= (rt:control)
   (case (rt:mode-state) ((None None) ((Val $dir) (rt:json-object (path:join $dir "control-status.json"))))))
; Local service readiness, not evidence that Telegram is reachable.
(= (rt:channel $now)
   (case (rt:control)
     ((None None)
      ((Val $control)
       (if (rt:older (rt:age (rt:get $control "observed_at") $now) 30) None
         (rt:bool-json (rt:get $control "channel_ready")))))))
; Dates are Telegram message times. Processing means durable history and input
; acknowledgement, not that an answer or task was completed.
(= (rt:inbox $now)
   (case (rt:control)
     ((None None)
      ((Val $control)
       (let $value (rt:get $control "operator_inbox")
         (if (or (rt:older (rt:age (rt:get $control "observed_at") $now) 30)
                 (or (not (rt:true-json (rt:get $control "channel_ready"))) (not (rt:object-value $value))))
           None
           (let* (($sample (rt:age (rt:get $value "observedAt") $now)) ($count (rt:nat (rt:get $value "pending"))))
             (if (or (rt:older $sample 30) (== $count None)) None
               (let* (((Val $n) $count) ((Val $s) $sample))
                 (Val (JsonObject ((JsonPair "pending" (rt:int-json $n)) (JsonPair "sampleAgeSeconds" (rt:int-json $s))
                                   (JsonPair "newestAgeSeconds" (if (== $n 0) JsonNull (rt:opt-json (rt:age (rt:get $value "newestMessageAt") $now))))
                                   (JsonPair "oldestAgeSeconds" (if (== $n 0) JsonNull (rt:opt-json (rt:age (rt:get $value "oldestMessageAt") $now))))))))))))))))

; ---- command receipts -----------------------------------------------------
(= (rt:receipt-lines $path)
   (case (rt:try (fs:tail-text $path 180000))
     (((fs:tail $total $truncated $text)
       (let* (($split (str:split "\n" $text))
              ($whole (if (== (rt:last $split) "") (rt:drop-last $split) $split))
              ($lines (rt:strip-returns $whole)))
         (Val (if (and $truncated (!= $lines ())) (cdr-atom $lines) $lines))))
      ($other None))))
(= (rt:drop-last $items) (if (== (cdr-atom $items) ()) () (let $rest (rt:drop-last (cdr-atom $items)) (cons-atom (car-atom $items) $rest))))
(= (rt:strip-returns $lines)
   (if (== $lines ()) ()
     (let* (($line (car-atom $lines))
            ($clean (if (str:ends-with $line "\r") (str:byte-slice $line 0 (- (str:byte-length $line) 1)) $line))
            ($rest (rt:strip-returns (cdr-atom $lines))))
       (cons-atom $clean $rest))))
; Every line must be a JSON object, or the whole window is unknown.
(= (rt:command-records $lines $newest-first)
   (if (== $lines ()) (Val $newest-first)
     (case (rt:try (json-parse (car-atom $lines)))
       (((JsonObject $pairs)
         (let $record (JsonObject $pairs)
           (rt:command-records (cdr-atom $lines)
             (if (or (rt:has $record "command") (rt:has $record "commands")) (cons-atom $record $newest-first) $newest-first))))
        ($other None)))))
(= (rt:reverse $items $out) (if (== $items ()) $out (rt:reverse (cdr-atom $items) (cons-atom (car-atom $items) $out))))
(= (rt:take $items $count) (if (or (== $items ()) (<= $count 0)) () (let $rest (rt:take (cdr-atom $items) (- $count 1)) (cons-atom (car-atom $items) $rest))))
(= (rt:reason $value)
   (case $value
     (((JsonString $text)
       (if (rt:member $text (rt:reasons)) $text
         (case (rt:try (json-parse $text)) (((JsonObject $pairs) (rt:reason-field (JsonObject $pairs))) ($other "other")))))
      ((JsonObject $pairs) (rt:reason-field (JsonObject $pairs)))
      ($other "other"))))
(= (rt:reason-field $object)
   (case (rt:get $object "reason")
     (((JsonString $reason) (if (rt:member $reason (rt:reasons)) $reason "other")) ($other "other"))))
(= (rt:kind $record)
   (case (rt:get $record "disposition")
     (((JsonString "exception") "failed") ((JsonString "no_result") "failed")
      ((JsonString $kind) (if (rt:member $kind ("returned" "withheld" "deferred" "uncertain" "failed")) $kind "uncertain"))
      ($other "uncertain"))))
(= (rt:returned-disposition $record) (== (rt:get $record "disposition") (JsonString "returned")))
(= (rt:tally $records $kind)
   (if (== $records ()) 0
     (+ (if (== (rt:kind (car-atom $records)) $kind) 1 0) (rt:tally (cdr-atom $records) $kind))))
(= (rt:record-reasons $records $found)
   (if (== $records ()) $found
     (let $record (car-atom $records)
       (rt:record-reasons (cdr-atom $records)
         (if (rt:returned-disposition $record) $found (rt:insert-text (rt:reason (rt:get $record "reason")) $found))))))
; Sorted by code point, without duplicates.
(= (rt:insert-text $text $sorted)
   (if (== $sorted ()) (cons-atom $text ())
     (let $order (str:compare $text (car-atom $sorted))
       (if (== $order 0) $sorted
         (if (< $order 0) (cons-atom $text $sorted)
           (let $rest (rt:insert-text $text (cdr-atom $sorted)) (cons-atom (car-atom $sorted) $rest)))))))
(= (rt:strings-json $items)
   (if (== $items ()) () (let $rest (rt:strings-json (cdr-atom $items)) (cons-atom (JsonString (car-atom $items)) $rest))))
(= (rt:commands)
   (let $path (str:trim (system:getenv-or-default "METTACLAW_EFFECT_RECEIPT_PATH" ""))
     (if (or (== $path "") (not (fs:is-file $path))) None
       (case (rt:receipt-lines $path)
         ((None None)
          ((Val $lines)
           (case (rt:command-records $lines ())
            ((None None)
             ((Val $newest-first)
           (let $records (rt:reverse (rt:take $newest-first (rt:receipt-window)) ())
             (Val (JsonObject ((JsonPair "returned" (rt:int-json (rt:tally $records "returned")))
                               (JsonPair "withheld" (rt:int-json (rt:tally $records "withheld")))
                               (JsonPair "deferred" (rt:int-json (rt:tally $records "deferred")))
                               (JsonPair "uncertain" (rt:int-json (rt:tally $records "uncertain")))
                               (JsonPair "failed" (rt:int-json (rt:tally $records "failed")))
                               (JsonPair "windowRecords" (rt:int-json (size-atom $records)))
                               (JsonPair "reasons" (JsonArray (rt:strings-json (rt:record-reasons $records ())))))))))))))))))

; ---- memory ----------------------------------------------------------------
(= (rt:backend-path)
   (let $configured (system:getenv-or-default "METTACLAW_MEMORY_BACKEND_CONFIG" "")
     (if (!= $configured "") $configured (path:join (system:cwd) "repos/petta_lib_chromadb/memory_backend.json"))))
; The configured backend: a JSON object, (JsonObject ()) for "chroma", or None.
(= (rt:backend-config)
   (let $path (rt:backend-path)
     (if (not (fs:is-file $path)) (JsonObject ())
       (case (rt:try (json-parse (fs:read-text $path)))
         (((JsonObject $pairs) (JsonObject $pairs))
          ((JsonFailureV1 $a $b $c $d) (JsonObject ()))
          (None (JsonObject ()))
          ($other None))))))
(= (rt:reachable $socket)
   (case $socket (((JsonString $path) (py-call (memory_health.native_reachable $path))) ($other False))))
(= (rt:memory)
   (let $config (rt:backend-config)
     (if (== $config None) None
       (if (== (rt:get-or $config "mode" (JsonString "chroma")) (JsonString "native"))
         (Val (JsonObject ((JsonPair "backend" (JsonString "native")) (JsonPair "collection" (rt:get $config "name"))
                           (JsonPair "reachable" (JsonBool (rt:reachable (rt:get $config "socket")))))))
         (rt:chroma)))))
(= (rt:chroma-dir)
   (let $first (system:getenv-or-default "METTACLAW_CHROMA_DIR" "")
     (if (!= $first "") $first
       (let $second (system:getenv-or-default "OMEGACLAW_CHROMA_DIR" "")
         (if (!= $second "") $second "./chroma_db")))))
; Rows of a read-only query; a failed or unavailable query is None.
(= (rt:rows $db $sql $parameters)
   (case (sqlite:observe $db $sql $parameters 20)
     (((sqlite:result $columns $rows $changes $rowid) (Val $rows)) ($other None))))
(= (rt:sql-nat $value)
   (if (== (get-type $value) Number) (if (and (>= $value 0) (<= $value (rt:number-limit))) (Val $value) None) None))
(= (rt:segment $rows $scope)
   (if (== $rows ()) None
     (let ($id $kind) (car-atom $rows) (if (== $kind $scope) (Val $id) (rt:segment (cdr-atom $rows) $scope)))))
(= (rt:sequence $rows $segment)
   (if (== $rows ()) None
     (let ($id $seq) (car-atom $rows) (if (== $id $segment) (rt:sql-nat $seq) (rt:sequence (cdr-atom $rows) $segment)))))
; The first sync_threshold number found depth-first, as memory_health does.
(= (rt:threshold $value)
   (case $value
     (((JsonObject $pairs)
       (case (rt:get $value "sync_threshold")
         (((JsonNumber $text) (case (rt:try (str:string->number $text)) ((None None) ($n (Val (math:trunc $n))))))
          ((JsonBool true) (Val 1)) ((JsonBool false) (Val 0))
          ($other (rt:threshold-pairs $pairs)))))
      ((JsonArray $items) (rt:threshold-items $items))
      ($other None))))
(= (rt:threshold-pairs $pairs)
   (if (== $pairs ()) None
     (let (JsonPair $key $child) (car-atom $pairs)
       (case (rt:threshold $child) ((None (rt:threshold-pairs (cdr-atom $pairs))) ($found $found))))))
(= (rt:threshold-items $items)
   (if (== $items ()) None
     (case (rt:threshold (car-atom $items)) ((None (rt:threshold-items (cdr-atom $items))) ($found $found)))))
(= (rt:column-threshold $db $collection $columns $names)
   (if (== $columns ()) None
     (let $column (car-atom $columns)
       (let $found (if (rt:member $column $names)
                     (case (rt:rows $db (str:join "" ("SELECT " $column " FROM collections WHERE id=?")) ($collection))
                       (((Val (($raw))) (if (== (get-type $raw) String)
                                          (if (and (!= $raw "") (<= (str:char-length $raw) 65536))
                                            (case (json-parse $raw)
                                              (((JsonFailureV1 $a $b $c $d) Broken)
                                               ($parsed (case (rt:threshold $parsed) (((Val $n) (rt:sql-nat $n)) ($none None))))))
                                            None)
                                          None))
                        ($other None)))
                     None)
         (if (== $found Broken) Broken
           (let $later (rt:column-threshold $db $collection (cdr-atom $columns) $names)
             (if (== $later None) $found $later)))))))
(= (rt:column-names $rows)
   (if (== $rows ()) ()
     (let ($cid $name $type $notnull $default $pk) (car-atom $rows)
       (let $rest (rt:column-names (cdr-atom $rows)) (cons-atom $name $rest)))))
; Staged in small definitions: one deeply nested case does not reduce here.
(= (rt:chroma)
   (let* (($db (path:join (rt:chroma-dir) "chroma.sqlite3"))
          ($name (system:getenv-or-default "METTACLAW_CHROMA_COLLECTION" "memories")))
     (if (not (fs:is-file $db)) None
       (case (rt:rows $db "SELECT id FROM collections WHERE name=?" ($name))
         (((Val (($collection))) (rt:chroma-segments $db $collection))
          ($missing None))))))
(= (rt:chroma-segments $db $collection)
   (case (rt:rows $db "SELECT id,scope FROM segments WHERE collection=?" ($collection))
     (((Val $segments) (rt:chroma-watermarks $db $collection (rt:segment $segments "METADATA") (rt:segment $segments "VECTOR")))
      ($failed None))))
(= (rt:chroma-watermarks $db $collection $meta $vector)
   (if (or (== $meta None) (== $vector None)) None
     (let* (((Val $m) $meta) ((Val $v) $vector))
       (case (rt:rows $db "SELECT segment_id,seq_id FROM max_seq_id WHERE segment_id IN (?,?)" ($m $v))
         (((Val $sequences) (rt:chroma-facts $db $collection $m (rt:sequence $sequences $m) (rt:sequence $sequences $v)))
          ($failed None))))))
; The vector index may trail the metadata, never lead it.
(= (rt:chroma-facts $db $collection $meta $before $after)
   (if (or (== $before None) (== $after None)) None
     (let* (((Val $b) $before) ((Val $a) $after))
       (if (> $a $b) None
         (rt:chroma-result (rt:chroma-documents $db $meta) (- $b $a)
           (rt:column-threshold $db $collection ("config_json_str" "schema_str") (rt:chroma-columns $db)))))))
(= (rt:chroma-documents $db $meta)
   (case (rt:rows $db "SELECT COUNT(*) FROM embeddings WHERE segment_id=?" ($meta))
     (((Val (($count))) (rt:sql-nat $count)) ($failed None))))
(= (rt:chroma-columns $db)
   (case (rt:rows $db "PRAGMA table_info(collections)" ()) (((Val $rows) (rt:column-names $rows)) ($failed ()))))
(= (rt:chroma-result $documents $gap $threshold)
   (if (or (== $threshold None) (== $threshold Broken)) None
     (let (Val $t) $threshold
       (Val (JsonObject ((JsonPair "documents" (rt:opt-json $documents))
                         (JsonPair "persistedSequenceGap" (rt:int-json $gap))
                         (JsonPair "threshold" (rt:int-json $t))))))))

; ---- process and model -----------------------------------------------------
(= (rt:btime $lines)
   (if (== $lines ()) None
     (let $line (car-atom $lines)
       (if (str:starts-with $line "btime ") (Val (str:string->number (rt:nth (str:split-whitespace $line) 1)))
         (rt:btime (cdr-atom $lines))))))
(= (rt:cgroup $lines)
   (if (== $lines ()) ""
     (let $line (car-atom $lines)
       (if (str:starts-with $line "0::") (str:byte-slice $line 3 (str:byte-length $line)) (rt:cgroup (cdr-atom $lines))))))
(= (rt:strip-slashes $text)
   (if (and (!= $text "") (str:ends-with $text "/")) (rt:strip-slashes (str:byte-slice $text 0 (- (str:byte-length $text) 1))) $text))
(= (rt:restarts)
   (let $unit (rt:last (str:split "/" (rt:strip-slashes (rt:cgroup (str:split "\n" (fs:read-text "/proc/self/cgroup"))))))
     (if (not (str:ends-with $unit ".service")) ()
       (case (rt:try (proc:run ("systemctl" "--user" "show" $unit "--property=NRestarts" "--value") (system:cwd) inherit 2000 0))
         (((proc:exited 0 $out $err)
           (let $count (str:trim $out)
             (if (and (!= $count "") (str:is-all-in digit $count))
               ((JsonPair "serviceRestarts" (rt:int-json (str:string->number $count)))) ())))
          ($other ()))))))
; This process's age and the service's restart count, so a restart is visible.
(= (rt:process $now)
   (let* (($fields (str:split-whitespace (rt:last (str:split ")" (fs:read-text "/proc/self/stat")))))
          ($ticks (str:string->number (rt:nth $fields 19)))
          ($boot (rt:btime (str:split "\n" (fs:read-text "/proc/stat"))))
          ($hertz (py-call (os.sysconf "SC_CLK_TCK"))))
     (case $boot
       (((Val $seconds)
         (let $started (+ $seconds (/ $ticks $hertz))
           (Val (JsonObject (rt:append ((JsonPair "startedAt" (rt:int-json (math:trunc $started)))
                                        (JsonPair "uptimeSeconds" (rt:int-json (max 0 (math:trunc (- $now $started))))))
                                       (rt:restarts))))))
        ($other None)))))
(= (rt:model)
   (let $name (py-call (synthetic_llm.current_model))
     (Val (JsonObject ((JsonPair "name" (JsonString (format-args "{}" ($name))))
                       (JsonPair "reasoningEffort" (JsonString (system:getenv-or-default "METTACLAW_REASONING_EFFORT" "default"))))))))

; ---- assembly and projection ----------------------------------------------
(= (rt:unavailable $name $result) (if (== $result None) (cons-atom $name ()) ()))
(= (rt:value-or-null $result) (case $result (((Val $value) $value) (None JsonNull))))
(= (rt:optional-pair $name $result) (case $result (((Val $value) ((JsonPair $name $value))) (None ()))))
(= (runtime:read $now)
   (let* (($provider (rt:try (rt:provider $now)))
          ($channel (rt:try (rt:channel $now)))
          ($inbox (rt:try (rt:inbox $now)))
          ($commands (rt:try (rt:commands)))
          ($memory (rt:try (rt:memory)))
          ($process (rt:try (rt:process $now)))
          ($model (rt:try (rt:model)))
          ($call (case $provider (((Provider $call-object $call-pending) $call-object)
                                  ($no-call (JsonObject ((JsonPair "phase" (JsonString "unknown"))))))))
          ($pending (case $provider (((Provider $turn-object $turn-pending) (JsonBool $turn-pending)) ($no-turn JsonNull))))
          ($missing (rt:append (if (== $provider None) ("provider-and-settlement") ())
                      (rt:append (rt:unavailable "localChannelReady" $channel)
                        (rt:append (rt:unavailable "humanInbox" $inbox)
                          (rt:append (rt:unavailable "commands" $commands)
                            (rt:append (rt:unavailable "memory" $memory)
                              (rt:append (rt:unavailable "process" $process) (rt:unavailable "model" $model))))))))
          ($pairs ((JsonPair "schema" (JsonNumber "1")) (JsonPair "sampledAt" (rt:int-json (math:trunc $now)))
                   (JsonPair "call" $call) (JsonPair "turnPending" $pending)
                   (JsonPair "localChannelReady" (case $channel (((Val $ready) (JsonBool $ready)) (None JsonNull))))
                   (JsonPair "humanInbox" (rt:value-or-null $inbox)) (JsonPair "commands" (rt:value-or-null $commands))
                   (JsonPair "memory" (rt:value-or-null $memory)) (JsonPair "background" JsonNull)
                   (JsonPair "budgetStatus" (JsonString "no-volume-caps"))))
          ($present (rt:append $pairs (rt:append (rt:optional-pair "process" $process) (rt:optional-pair "model" $model)))))
     (JsonObject (if (== $missing () ) $present
                   (rt:append $present ((JsonPair "unavailable" (JsonArray (rt:strings-json $missing)))))))))

; Keys sorted by code point at every level, as Python's json.dumps(sort_keys=True).
(= (rt:sorted $value)
   (case $value
     (((JsonObject $pairs) (JsonObject (rt:sort-pairs $pairs ())))
      ((JsonArray $items) (JsonArray (rt:sorted-items $items)))
      ($other $other))))
(= (rt:sorted-items $items)
   (if (== $items ()) () (let* (($head (rt:sorted (car-atom $items))) ($rest (rt:sorted-items (cdr-atom $items)))) (cons-atom $head $rest))))
(= (rt:sort-pairs $pairs $sorted)
   (if (== $pairs ()) $sorted
     (let (JsonPair $key $value) (car-atom $pairs)
       (let $child (rt:sorted $value)
         (rt:sort-pairs (cdr-atom $pairs) (rt:insert-pair (JsonPair $key $child) $sorted))))))
(= (rt:insert-pair $pair $sorted)
   (if (== $sorted ()) (cons-atom $pair ())
     (let* (((JsonPair $key $value) $pair) ((JsonPair $other $rest-value) (car-atom $sorted)))
       (if (< (str:compare $key $other) 0) (cons-atom $pair $sorted)
         (let $rest (rt:insert-pair $pair (cdr-atom $sorted)) (cons-atom (car-atom $sorted) $rest))))))
(= (runtime:render $facts)
   (let* (($body (json-stringify (rt:sorted $facts)))
          ($text (str:join "" ("SOURCE[runtime-state] revision=sha256:" (str:sha256 $body) "\nRUNTIME_STATE " $body
                               "\nSampled facts; unavailable means unknown. Details: vitals, command-receipts, model-jobs."))))
     ; Do not clip structured facts or turn partial information into health.
     (if (> (str:char-length $text) (rt:max-chars))
       (runtime:render (JsonObject ((JsonPair "schema" (JsonNumber "1"))
                                    (JsonPair "unavailable" (JsonArray ((JsonString "projection-overflow")))))))
       $text)))
(= (runtime:projection) (runtime:render (runtime:read (system:wall-time))))
