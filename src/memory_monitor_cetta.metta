; Resource observations are grouped by service invocation. Warnings never
; restart services, reset budgets or change cognitive state.
!(import! &self ./cli_values_cetta.metta)
!(import! &self (library proc))
!(import! &self (library math))
(= (mm:trend $previous $sample $window $rate-limit $minimum)
   (let* (($identity (sf:get $sample "invocation" "")) ($now (sf:get $sample "at" 0)) ($cutoff (- $now $window))
          ((JsonArray $stored) (sf:get $previous "history" (JsonArray ())))
          ($valid (filter-atom $stored $row
            (and (!= $identity "") (and (== (sf:get $row "invocation" "") $identity) (< (sf:get $row "at" 0) $now)))))
          ($older (filter-atom $valid $row (<= (sf:get $row "at" 0) $cutoff)))
          ($recent (filter-atom $valid $row (> (sf:get $row "at" 0) $cutoff)))
          ($history (list:append (if (== $older ()) () ((sf:last $older))) (list:append $recent ($sample))))
          ($first (car-atom $history)) ($elapsed (- $now (sf:get $first "at" 0)))
          ($growth (- (sf:get $sample "total_bytes" 0) (sf:get $first "total_bytes" 0)))
          ($rate (if (> $elapsed 0) (/ (* $growth 60) (* 1048576 $elapsed)) 0))
          ($alarm (and (!= $identity "") (and (> $rate-limit 0) (and (>= $elapsed $window)
                        (and (>= $rate $rate-limit) (>= $growth (* $minimum 1048576))))))))
     (JsonObject ((JsonPair "history" (JsonArray $history)) (JsonPair "sample" $sample)
       (JsonPair "window_seconds" $elapsed) (JsonPair "growth_mib_per_minute" $rate) (JsonPair "alarm" $alarm)))))
(= (mm:properties $text)
   (foldl-atom (str:split "\n" $text) (JsonObject ()) $object $line
     (case (str:find $line "=")
       (((TextNotFound $_) $object)
        ($at (sf:put $object (str:byte-slice $line 0 $at)
                         (str:byte-slice $line (+ $at 1) (str:byte-length $line))))))))
(= (mm:observe $props $previous $now $window $rate $minimum)
   (let* (($ram (cli:number (sf:get $props "MemoryCurrent" "") MemoryUnavailableV1))
          ($swap (cli:number (sf:get $props "MemorySwapCurrent" "") MemoryUnavailableV1))
          ($pid (cli:number (sf:get $props "MainPID" "0") MemoryUnavailableV1))
          ($load (sf:get $props "LoadState" "unknown")) ($active (sf:get $props "ActiveState" JsonNull))
          ($restart-unavailable (and (== $active "active") (and (!= $load "loaded") (!= $load "unknown"))))
          ($base (JsonObject ((JsonPair "load_state" $load) (JsonPair "restart_unavailable" $restart-unavailable)))))
     (if (or (== $ram MemoryUnavailableV1) (or (== $swap MemoryUnavailableV1) (== $pid MemoryUnavailableV1)))
       (sf:put-all $base ((JsonPair "history" (JsonArray ())) (JsonPair "alarm" False) (JsonPair "unavailable" True)))
       (let $sample (JsonObject ((JsonPair "at" $now) (JsonPair "invocation" (sf:get $props "InvocationID" ""))
          (JsonPair "pid" $pid) (JsonPair "active" $active) (JsonPair "load_state" $load)
          (JsonPair "ram_bytes" $ram) (JsonPair "swap_bytes" $swap) (JsonPair "total_bytes" (+ $ram $swap))))
         (case $base (((JsonObject $extra) (sf:put-all (mm:trend $previous $sample $window $rate $minimum) $extra))))))))
(= (mm:units $units $previous $now $window $rate $minimum)
   (if (== $units ()) ()
     (let* (($unit (car-atom $units))
            ($result (proc:run ("systemctl" "--user" "show" $unit "--property=InvocationID" "--property=MainPID"
              "--property=LoadState" "--property=ActiveState" "--property=MemoryCurrent" "--property=MemorySwapCurrent")
              (system:getcwd) inherit 30000 65536))
            ($props (case $result (((proc:exited $_ $out $_) (mm:properties $out)) ($bad (JsonObject ())))))
            ($facts (mm:observe $props (sf:get $previous $unit (JsonObject ())) $now $window $rate $minimum))
            ($_ (mm:print $unit $facts)) ($rest (mm:units (cdr-atom $units) $previous $now $window $rate $minimum)))
       (cons-atom (JsonPair $unit $facts) $rest))))
(= (mm:rounded $number) (repr (/ (math:floor (+ (* $number 10) 0.5)) 10)))
(= (mm:print $unit $facts)
   (let* (($_ (if (sf:get $facts "restart_unavailable" False)
              (system:write stdout (str:join "" ("WARNING restart-unavailable: " $unit " load=" (sf:get $facts "load_state" "unknown") "\n"))) True))
          ($sample (sf:get $facts "sample" JsonNull)))
     (system:write stdout (if (== $sample JsonNull) (str:concat "memory-observation unavailable: " (str:concat $unit "\n"))
       (str:join "" ((if (sf:get $facts "alarm" False) "WARNING memory-growth " "memory-observation ") $unit
         ": total=" (mm:rounded (/ (sf:get $sample "total_bytes" 0) 1048576)) " MiB ram="
         (mm:rounded (/ (sf:get $sample "ram_bytes" 0) 1048576)) " MiB swap="
         (mm:rounded (/ (sf:get $sample "swap_bytes" 0) 1048576)) " MiB growth="
         (mm:rounded (sf:get $facts "growth_mib_per_minute" 0)) " MiB/min over="
         (repr (math:floor (+ (sf:get $facts "window_seconds" 0) 0.5))) "s\n"))))))
(= (mm:arguments $args $options $units $collect)
   (if (== $args ()) (sf:put $options "--units" (JsonArray $units))
     (let $head (car-atom $args)
       (if (== $head "--units") (mm:arguments (cdr-atom $args) $options $units True)
         (if (str:starts-with $head "--")
           (if (or (== (cdr-atom $args) ()) (not (cli:member? $head ("--state" "--window" "--growth-mib-per-minute" "--minimum-growth-mib"))))
             (CliFailureV1 "invalid memory monitor option")
             (mm:arguments (cdr-atom (cdr-atom $args)) (sf:put $options $head (car-atom (cdr-atom $args))) $units False))
           (if $collect (mm:arguments (cdr-atom $args) $options (list:append $units ($head)) True)
             (CliFailureV1 "unexpected memory monitor argument")))))))
(= (mm:main $args)
   (let* (($options (mm:arguments (cli:strings $args) (JsonObject ()) () False))
          ($path (sf:get $options "--state" "")) ((JsonArray $units) (sf:get $options "--units" (JsonArray ())))
          ($window (cli:number (sf:get $options "--window" "180") -1))
          ($rate (cli:number (sf:get $options "--growth-mib-per-minute" "16") -1))
          ($minimum (cli:number (sf:get $options "--minimum-growth-mib" "32") -1)))
     (if (or (== $path "") (or (== $units ()) (or (< $window 0) (or (< $rate 0) (< $minimum 0))))) 78
       (let* (($previous (sf:get (sf:native-object $path) "services" (JsonObject ()))) ($now (system:wall-time))
              ($pairs (mm:units $units $previous $now $window $rate $minimum))
              ($alarms (mm:flagged $pairs "alarm")) ($unavailable (mm:flagged $pairs "restart_unavailable"))
              ($record (JsonObject ((JsonPair "observed_at" $now) (JsonPair "services" (JsonObject $pairs))
                (JsonPair "alarms" (JsonArray $alarms)) (JsonPair "restart_unavailable" (JsonArray $unavailable)))))
              ($_ (fs:make-directories (path:dirname $path) 448))
              ($saved (sf:replace $path (sf:python-json $record) 384 True)))
         (if (== $saved True) 0 1)))))
(= (mm:flagged $pairs $key)
   (if (== $pairs ()) ()
     (let* (((JsonPair $unit $facts) (car-atom $pairs)) ($rest (mm:flagged (cdr-atom $pairs) $key)))
       (if (sf:get $facts $key False) (cons-atom $unit $rest) $rest))))
!(import! &self (library list))
