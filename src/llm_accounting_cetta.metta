; The native call path owns its SQLite policy and lifecycle transactions.
; Host calls here only read interop facts or publish existing host effects.
!(import! &self ./native_lifetime_cetta.metta)
!(import! &self ./native_llm_host.py)
!(import! &self ./interop_flags_cetta.metta)

(: account:ready (-> %Undefined% %Undefined%))
(= (account:ready $plan)
   (host:flag (py-call (native_llm_host.field $plan "ready"))))

(: account:metadata (-> %Undefined% %Undefined%))
(= (account:metadata $plan)
   (json:parse (lp:text (py-call (native_llm_host.policy_metadata $plan)))))
(: account:reject (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:reject $plan $reason $retry)
   (let $ignored0 (py-call (native_llm_host.policy_rejected $plan $reason $retry)) False))
(: account:cleanup-unsent (-> %Undefined% %Undefined% %Undefined%))
(= (account:cleanup-unsent $plan $metadata)
   (let $ignored1 (nl:fail $metadata "submit-error" JsonNull JsonNull
                       (lp:field $metadata "soft_elapsed" 0) (system:wall-time))
     (account:reject $plan "native-admission-error" -1)))
(: account:claimed (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:claimed $plan $metadata $answer)
   (case $answer
     (((LedgerChanged True)
       (if (host:flag (py-call (native_llm_host.claim_effect $plan))) True
         (account:cleanup-unsent $plan $metadata)))
      ((LedgerChanged False)
       (case (lp:fail (lp:field $metadata "id" "") False JsonNull JsonNull (system:wall-time))
         (((LedgerError $ignored2) (account:reject $plan "native-claim-error" -1))
          ($settled (account:reject $plan "native-call-capacity" -1)))))
      ($error (account:cleanup-unsent $plan $metadata)))))
(: account:admitted (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:admitted $plan $metadata $answer)
   (case $answer
     (((LedgerAdmitted $ignored3)
       (if (host:flag (py-call (native_llm_host.note_admitted $plan)))
         (account:claimed $plan $metadata (nl:claim $metadata (system:wall-time)))
         (account:cleanup-unsent $plan $metadata)))
      ((LedgerDenied $reason $retry) (account:reject $plan $reason $retry))
      ($error (account:reject $plan "native-admission-error" -1)))))
(: account:claim (-> %Undefined% %Undefined%))
(= (account:claim $plan)
   (if (not (host:flag (py-call (native_llm_host.begin_native_claim $plan)))) False
     (let $metadata (account:metadata $plan)
       (account:admitted $plan $metadata
         (lp:admit (lp:field $metadata "id" "") (lp:field $metadata "provider" "")
                   (lp:field $metadata "maximum" 0) (lp:field $metadata "fingerprint" "") (system:wall-time))))))
; The host's Python route passes `request_origin(plan) or None` to describe,
; so an empty origin is omitted there; mirror that falsiness here.
(: account:request-origin (-> %Undefined% %Undefined%))
(= (account:request-origin $metadata)
   (let $origin (lp:field $metadata "origin" JsonNull)
     (if (ue:truthy $origin) $origin JsonNull)))
(: account:describe (-> %Undefined% %Undefined%))
(= (account:describe $plan)
   (let $metadata (json:parse (lp:text (py-call (native_llm_host.request_metadata $plan))))
     (case (lp:describe-origin (lp:field $metadata "id" "") (lp:field $metadata "model" "")
                        (lp:field $metadata "protocol" "") (lp:field $metadata "purpose" "turn")
                        "native" (account:request-origin $metadata) (system:wall-time))
       (((LedgerChanged $ignored4) True)
        ($error (let $ignored5 (py-call (native_llm_host.accounting_observation_error $plan "metadata")) False))))))
(: account:submitted (-> %Undefined% %Undefined% %Undefined%))
(= (account:submitted $plan $id)
   (let* (($ignored6 (py-call (native_llm_host.submitted $plan $id))) ($metadata (account:metadata $plan)))
     (case (nl:submitted $metadata $id (system:wall-time))
       (((sqlite:committed $ignored7) 1)
        ($error (py-call (native_llm_host.accounting_observation_error $plan "submitted")))))))
(: account:progress (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:progress $plan $bytes $quiet)
   (let $ignored8 (py-call (native_llm_host.waiting $plan $bytes $quiet))
     (if (host:flag (py-call (native_llm_host.field $plan "progress_record_due")))
       (let $metadata (account:metadata $plan)
         (case (nl:progress $metadata $bytes $quiet (lp:field $metadata "progress_soft" 0) (system:wall-time))
           (((sqlite:committed $ignored9) 1)
            ($error (py-call (native_llm_host.accounting_observation_error $plan "progress")))))) 1)))
(: account:failed (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:failed $plan $correlation $kind $status)
   (if (account:ready $plan)
     (let $metadata (account:metadata $plan)
       (case (nl:fail $metadata (lp:text $kind) (if (ue:equal $status 0) JsonNull $status)
                      (lp:field $metadata "retry_after" JsonNull) (lp:field $metadata "soft_elapsed" 0) (system:wall-time))
         (((LedgerError $ignored10)
           (let $ignored11 (py-call (native_llm_host.accounting_observation_error $plan "failure"))
             (py-call (native_llm_host.failed $plan $correlation $kind $status))))
          ($settled (py-call (native_llm_host.failed $plan $correlation $kind $status))))))
     (py-call (native_llm_host.failed $plan $correlation $kind $status))))
(: account:note-rejection (-> %Undefined% %Undefined%))
(= (account:note-rejection $plan)
   (let $code (lp:text (py-call (native_llm_host.rejection_code $plan)))
     (if (ue:equal $code "") 1
       (case (nl:command-output-rejected (account:metadata $plan) $code (system:wall-time))
         (((LedgerError $ignored12) (py-call (native_llm_host.accounting_observation_error $plan "rejection")))
          ($recorded 1))))))
(: account:publish (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:publish $plan $epoch $correlation $legacy $canonical $usage)
   (if (ue:equal (py-call (native_llm_host.policy_committed $plan (json:stringify (ue:evidence $usage)))) 1)
    (let* (
          ($answer (py-call (native_llm_host.finish $plan $epoch $correlation $legacy $canonical)))
          ($ignored14 (account:note-rejection $plan))) $answer)
    (py-call (native_llm_host.completion_duplicate $plan))))
(: account:finished (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:finished $plan $metadata $epoch $correlation $legacy $canonical $usage $answer)
   (account:finished-step $plan $metadata $epoch $correlation $legacy $canonical $usage 0 $answer))
(: account:finished-step (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:finished-step $plan $metadata $epoch $correlation $legacy $canonical $usage $attempt $answer)
   (case $answer
     (((LedgerChanged True) (account:publish $plan $epoch $correlation $legacy $canonical $usage))
      ((LedgerChanged False) (account:reconcile $plan $metadata $epoch $correlation $legacy $canonical $usage $attempt))
      ((LedgerInvalid $invalid) (account:failed $plan $correlation invalid-native-evidence 0))
      ((LedgerError $storage) (account:reconcile $plan $metadata $epoch $correlation $legacy $canonical $usage $attempt))
      ($invalid (py-call (native_llm_host.completion_conflict $plan))))))

; Keep the received answer in this owned continuation. Local write/read errors
; never escape into a caller's provider-retry loop, and never release the lease.
(: account:reconcile (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:reconcile $plan $metadata $epoch $correlation $legacy $canonical $usage $attempt)
   (case (nl:completion-state $metadata (lp:text $canonical))
     (((LedgerCompletion committed) (account:publish $plan $epoch $correlation $legacy $canonical $usage))
      ((LedgerCompletion pending)
       (let* (($wait (py-call (native_llm_host.completion_wait $plan $attempt)))
              ($reason (lp:field (account:first-choice (json:parse $legacy)) "finish_reason" "unknown")))
         (account:finished-step $plan $metadata $epoch $correlation $legacy $canonical $usage (+ $attempt 1)
           (nl:complete $metadata $usage $reason (lp:text $canonical)
                        (lp:field $metadata "soft_elapsed" 0) (system:wall-time)))))
      ((LedgerError $unreadable)
       (let $wait (py-call (native_llm_host.completion_wait $plan $attempt))
         (account:reconcile $plan $metadata $epoch $correlation $legacy $canonical $usage (+ $attempt 1))))
      ($conflict (py-call (native_llm_host.completion_conflict $plan))))))
(: account:complete (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (account:complete $plan $epoch $correlation $legacy $canonical)
   (let* (($metadata (account:metadata $plan)) ($result (json:parse $legacy))
          ($choice (account:first-choice $result))
          ($reason (lp:field $choice "finish_reason" "unknown"))
          ($usage (lp:field $result "usage" (JsonObject ())))
          ($message (lp:field $choice "message" (JsonObject ()))))
     (if (or (not (ue:equal (lp:text $epoch) (lp:field $metadata "epoch" "")))
             (not (ue:equal (lp:text $correlation) (lp:field $metadata "id" ""))))
       (account:failed $plan $correlation correlation-error 0)
       (if (not (or (ue:equal $reason "stop") (or (ue:equal $reason "tool_calls")
                     (or (ue:equal $reason "length") (or (ue:equal $reason "refusal") (ue:equal $reason "content_filter"))))))
         (account:failed $plan $correlation unfinished-provider-response 0)
         (if (and (or (ue:equal $reason "refusal") (ue:equal $reason "content_filter"))
                  (ue:truthy (lp:field $message "tool_calls" JsonNull)))
           (account:failed $plan $correlation refused-tool-call 0)
           (account:finished $plan $metadata $epoch $correlation $legacy $canonical $usage
             (nl:complete $metadata $usage $reason (lp:text $canonical)
                          (lp:field $metadata "soft_elapsed" 0) (system:wall-time))))))))
(: account:first-choice (-> %Undefined% %Undefined%))
(= (account:first-choice $result)
   (case (lp:field $result "choices" (JsonArray ()))
     (((JsonArray $items) (if (ue:equal $items ()) (JsonObject ()) (car-atom $items)))
      ($other (JsonObject ())))))
