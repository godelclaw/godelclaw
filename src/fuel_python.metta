!(import! &self ./src/fuel_modes.py)
(= (fuel:current) (py-call (fuel_modes.current_fuel)))
(= (fuel:refuel $loops $grant) (py-call (fuel_modes.refuel $loops $grant)))
(= (fuel:ceiling $grant) (py-call (fuel_modes.ceiling $grant)))
(= (fuel:spend $loops) (py-call (fuel_modes.spend $loops)))
(= (fuel:view) (py-call (fuel_modes.fuel_view)))
(= (fuel:context-view $loops) (py-call (fuel_modes.context_view $loops)))
(= (fuel:list-view) (py-call (fuel_modes.fuels_view)))
(= (fuel:set $name) (py-call (fuel_modes.set_fuel $name)))
