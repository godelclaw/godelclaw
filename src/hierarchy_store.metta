; Hierarchical memory over a native named space. Text is agent-authored;
; summaries are derived interpretations, never substitutes for source bodies.
; A snapshot carries current metadata only. Bodies and summaries are immutable
; versioned records, fetched on demand. No Python or Prolog is used here.
!(import! &self (library space_service))
!(import! &self (library list))
!(import! &self (library str))

(= (hm:append $a $b) (union-atom $a $b))
(= (hm:unique $xs) (unique-atom $xs))
(= (hm:contains $text $phrase)
   (case (str:find $text $phrase) (((TextNotFound $needle) False) ($offset True))))
(= (hm:has $x $xs) (not (== (collapse (let $y (superpose $xs) (if (== $x $y) True (empty)))) ())))
(= (hm:find $nodes $id)
   (case (collapse (let $node (superpose $nodes)
       (case $node (((HNode 1 $id $r $k $t $cs $ss $q) $node) ($other (empty))))))
     ((() (HFailure missing-node $id)) (($node) $node) ($other (HFailure duplicate-node $id)))))
(= (hm:replace $nodes $id $node)
   (cons-atom $node (collapse (let $old (superpose $nodes)
     (case $old (((HNode 1 $id $r $k $t $cs $ss $q) (empty)) ($other $other)))))))

; Every dependency includes its node revision (and thus its membership).
; Child summary versions are dependencies too; the root's own summary is not.
(= (hm:retired? $kind)
   (case $kind (((retired $original $reason) True) ($other False))))
(= (hm:stamp $nodes $id) (hm:stamp-in $nodes $id () True))
(= (hm:stamp-in $nodes $id $path $root)
   (if (hm:has $id $path) (HFailure cycle $id)
     (case (hm:find $nodes $id)
       (((HNode 1 $id $r (retired $original $reason) $t $cs $ss $q) ((HSource $id $r)))
        ((HNode 1 $id $r $k $t $cs $ss $q)
         (case (hm:stamp-children $nodes $cs (cons-atom $id $path))
           (((HFailure $why $at) (HFailure $why $at))
            ($tail (let $own (if $root ((HSource $id $r)) ((HSource $id $r) (HSummarySource $id $q)))
              (hm:unique (hm:append $own (hm:append $ss $tail))))))))
        ($error $error)))))
(= (hm:stamp-children $nodes $cs $path)
   (if (== $cs ()) ()
     (case (hm:stamp-in $nodes (car-atom $cs) $path False)
       (((HFailure $why $at) (HFailure $why $at))
        ($head (case (hm:stamp-children $nodes (cdr-atom $cs) $path)
          (((HFailure $why $at) (HFailure $why $at)) ($tail (hm:append $head $tail)))))))))
(= (hm:same-set $a $b)
   (and (== (size-atom (hm:unique $a)) (size-atom (hm:unique $b)))
     (hm:all-in $a $b)))
(= (hm:all-in $a $b)
   (if (== $a ()) True (and (hm:has (car-atom $a) $b) (hm:all-in (cdr-atom $a) $b))))

(= (hm:open $socket $name)
   (case (space:open $socket $name native)
     (((reply $rid ok $space) $space) ($error $error))))
(= (hm:at (space $uuid $id $name $backend $kind $rev $count) $next)
   (space $uuid $id $name $backend $kind $next $count))
; Fetch an exhaustive metadata snapshot, not a silently truncated selection.
; The query limit is derived from the current count; service limits remain
; explicit errors. Page size changes only transport, never recall or depth.
(= (hm:snapshot $socket $name)
   (case (hm:open $socket $name)
     (((space $uuid $id $sn $b $k $rev $count)
       (hm:snapshot-in $socket (space $uuid $id $sn $b $k $rev $count)))
      ($error $error))))
(= (hm:snapshot-in $socket $space)
   (case (space:count $socket $space (HNode 1 $id $r $k $t $cs $ss $q))
     (((reply $rid ok $count)
       (let $limit (if (== $count 0) 1 $count)
         (case (space:query $socket $space (HNode 1 $id $r $k $t $cs $ss $q)
                   (HNode 1 $id $r $k $t $cs $ss $q) $limit 30000)
           (((reply $rid2 ok (snapshot $boot $cursor $source $rev $total $lease))
             (let $snapshot (snapshot $boot $cursor $source $rev $total $lease)
               (let $nodes (hm:pages $socket $snapshot 0 $total 128)
                 (let $closed (space:close $socket $snapshot)
                   (case $nodes (((HFailure $why $at) $nodes)
                     ($rows (HView (hm:at $space $rev) $rows))))))))
            ((reply $rid2 error query-row-limit) (hm:snapshot-in $socket $space))
            ($error $error)))))
      ($error $error))))
(= (hm:pages $socket $snapshot $offset $total $size)
   (if (>= $offset $total) ()
     (case (space:fetch $socket $snapshot $offset $size)
       (((reply $rid ok (page $rev $off $rows $next $done))
         (case (hm:pages $socket $snapshot $next $total $size)
           (((HFailure $why $at) (HFailure $why $at))
            ($tail (hm:append (cdr-atom $rows) $tail)))))
        ((reply $rid error page-byte-limit)
         (if (> $size 1) (hm:pages $socket $snapshot $offset $total 1)
           (HFailure body-too-large $offset)))
        ($error (HFailure transport $error))))))

; Query one immutable body. A missing result is an explicit failure.
(= (hm:one $socket $space $pattern $template)
   (case (space:query $socket $space $pattern $template 2 30000)
     (((reply $rid ok (snapshot $boot $cursor $source $rev $total $lease))
       (let $snapshot (snapshot $boot $cursor $source $rev $total $lease)
         (let $page (space:fetch $socket $snapshot 0 2)
           (let $closed (space:close $socket $snapshot)
             (case $page
               (((reply $rid2 ok (page $r $o (rows $value) $next $done)) $value)
                ((reply $rid2 ok (page $r $o (rows) $next $done)) (HFailure missing-record $pattern))
                ($error (HFailure record $error))))))))
      ($error (HFailure transport $error)))))
(= (hm:body $socket $space $id $r)
   (hm:one $socket $space (HBody 1 $id $r $text) $text))
(= (hm:summary-record $socket $space $id $q)
   (if (== $q 0) (HNoSummary)
     (hm:one $socket $space (HSummary 1 $id $q $text $stamp) (HSummary 1 $id $q $text $stamp))))
(= (hm:commit $socket $space $ops)
   (case (space:batch $socket $space (cons-atom ops $ops))
     (((space:uncertain $rid $why)
       (case (space:receipt $socket $space $rid)
         (((reply $read ok (reply $original ok $answer)) (reply $original ok $answer))
          ($other (space:uncertain $rid $why)))))
      ($answer $answer))))

(= (hm:put $socket $name $id $kind $title $text $children $sources)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes) (hm:put-view $socket $name $space $nodes $id $kind $title $text (hm:unique $children) $sources))
      ($error $error))))
(= (hm:put-view $socket $name $space $nodes $id $kind $title $text $cs $ss)
   (case (hm:find $nodes $id)
     (((HFailure missing-node $id) (hm:put-in $socket $name $space $nodes () $id 1 $kind $title $text $cs $ss 0))
      ((HNode 1 $id $r $k $t $oldcs $oldss $q)
       (hm:put-old $socket $name $space $nodes $id $kind $title $text $cs $ss $r $k $t $oldcs $oldss $q))
      ($error $error))))
(= (hm:put-old $socket $name $space $nodes $id $kind $title $text $cs $ss $r $k $t $oldcs $oldss $q)
   (case (hm:body $socket $space $id $r)
     (((HFailure $why $at) (HFailure $why $at))
      ($oldtext (if (and (== ($kind $title $cs $ss) ($k $t $oldcs $oldss)) (== $text $oldtext))
         (HStored $id $r unchanged)
         (hm:put-in $socket $name $space $nodes ((remove (HNode 1 $id $r $k $t $oldcs $oldss $q)))
            $id (+ $r 1) $kind $title $text $cs $ss $q))))))
(= (hm:put-in $socket $name $space $nodes $prefix $id $r $kind $title $text $cs $ss $q)
   (let $node (HNode 1 $id $r $kind $title $cs $ss $q)
     (case (hm:stamp (hm:replace $nodes $id $node) $id)
       (((HFailure $why $at) (HFailure $why $at))
        ($stamp (let $ops (hm:append $prefix
          ((add $node) (add (HVersion 1 $id $r $kind $title $cs $ss)) (add (HBody 1 $id $r $text))))
          (case (hm:commit $socket $space $ops)
            (((reply $rid ok $answer) (HStored $id $r updated))
             ((reply $rid error stale-revision) (HFailure changed-sources $id))
             ($error $error)))))))))
(= (hm:link $socket $name $parent $child)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes)
       (case (hm:find $nodes $parent)
         (((HNode 1 $parent $r $k $t $cs $ss $q)
           (hm:link-in $socket $name $space $nodes $parent $child $r $k $t $cs $ss $q))
          ($error $error))))
      ($error $error))))
(= (hm:link-in $socket $name $space $nodes $parent $child $r $k $t $cs $ss $q)
   (if (hm:has $child $cs) (HStored $parent $r unchanged)
     (case (hm:body $socket $space $parent $r)
       (((HFailure $why $at) (HFailure $why $at))
        ($text (case (hm:put-in $socket $name $space $nodes
          ((remove (HNode 1 $parent $r $k $t $cs $ss $q)))
          $parent (+ $r 1) $k $t $text (hm:append $cs ($child)) $ss $q)
            (((HFailure changed-sources $id) (hm:link $socket $name $parent $child))
             ($answer $answer))))))))

(= (hm:summarize $socket $name $id $text)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes)
       (case (hm:find $nodes $id)
         (((HNode 1 $id $r $k $t $cs $ss $q)
           (hm:summarize-in $socket $space $nodes $id $text $r $k $t $cs $ss $q))
          ($error $error))))
      ($error $error))))
(= (hm:summarize-in $socket $space $nodes $id $text $r $k $t $cs $ss $q)
   (case (hm:stamp $nodes $id)
     (((HFailure $why $at) (HFailure $why $at))
      ($stamp (let $next (+ $q 1)
        (case (hm:commit $socket $space
           ((remove (HNode 1 $id $r $k $t $cs $ss $q))
            (add (HNode 1 $id $r $k $t $cs $ss $next))
            (add (HSummary 1 $id $next $text $stamp))))
          (((reply $rid ok $answer) (HSummarized $id $next))
           ((reply $rid error stale-revision) (HFailure changed-sources $id))
           ($error $error))))))))

(= (hm:overview $socket $space $nodes $id $q)
   (case (hm:summary-record $socket $space $id $q)
     (((HNoSummary) (HOverview absent "" ()))
      ((HSummary 1 $id $q $text $saved)
       (case (hm:stamp $nodes $id)
         (((HFailure $why $at) (HFailure $why $at))
          ($now (HOverview (if (hm:same-set $saved $now) fresh stale) $text $saved)))))
      ($error $error))))
(= (hm:expand $socket $name $id $depth)
   (if (< $depth 0) (HFailure invalid-depth $depth)
     (case (hm:snapshot $socket $name)
       (((HView $space $nodes) (hm:expand-in $socket $space $nodes $id $depth ()))
        ($error $error)))))
(= (hm:expand-in $socket $space $nodes $id $depth $path)
   (if (hm:has $id $path) (HFailure cycle $id)
     (case (hm:find $nodes $id)
       (((HNode 1 $id $r (retired $original $reason) $t $cs $ss $q)
         (HRetired $id $r $original $t $reason))
        ((HNode 1 $id $r $k $t $cs $ss $q)
         (let* (($body (hm:body $socket $space $id $r))
                ($overview (hm:overview $socket $space $nodes $id $q))
                ($children (if (== $depth 0) (HChildren $cs)
                   (hm:expand-children $socket $space $nodes $cs (- $depth 1) (cons-atom $id $path)))))
           (HMemory $id $r $k $t $body $overview $ss $children)))
        ($error $error)))))
(= (hm:expand-children $socket $space $nodes $cs $depth $path)
   (if (== $cs ()) ()
     (cons-atom (hm:expand-in $socket $space $nodes (car-atom $cs) $depth $path)
       (hm:expand-children $socket $space $nodes (cdr-atom $cs) $depth $path))))

; Literal search includes original bodies even when their summary omits them.
; Empty root searches all nodes; depth is an explicit caller choice elsewhere.
(= (hm:search $socket $name $phrase $root)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes)
       (let $scope (if (== $root "") $nodes
         (case (hm:stamp $nodes $root)
           (((HFailure $why $at) (HFailure $why $at))
            ($stamp (collapse (let $ref (superpose $stamp)
              (case $ref (((HSource $id $r) (hm:find $nodes $id)) ($other (empty))))))))))
         (case $scope (((HFailure $why $at) $scope)
           ($members (hm:search-in $socket $space $nodes $members $phrase))))))
      ($error $error))))
(= (hm:search-in $socket $space $nodes $members $phrase)
   (if (== $members ()) ()
     (let (HNode 1 $id $r $kind $t $cs $ss $q) (car-atom $members)
       (if (hm:retired? $kind) (hm:search-in $socket $space $nodes (cdr-atom $members) $phrase)
         (hm:search-active $socket $space $nodes $members $phrase)))))
(= (hm:search-active $socket $space $nodes $members $phrase)
   (if (== $members ()) ()
     (let (HNode 1 $id $r $k $t $cs $ss $q) (car-atom $members)
       (case (hm:body $socket $space $id $r)
         (((HFailure $why $at) (HFailure $why $at))
          ($text (let* (($overview (hm:overview $socket $space $nodes $id $q))
                        ($match (or (hm:contains $text $phrase) (hm:contains $t $phrase)))
                        ($summary-match (case $overview (((HOverview $s $summary $refs) (hm:contains $summary $phrase)) ($other False))))
                        ($tail (hm:search-in $socket $space $nodes (cdr-atom $members) $phrase)))
            (case $tail (((HFailure $why $at) $tail)
              ($rows (if (or $match $summary-match)
                (cons-atom (HHit $id $r $k $t (if $match source summary) $overview) $rows) $rows)))))))))))

(= (hm:history $socket $name $id $revision)
   (case (hm:open $socket $name)
     (((space $uuid $sid $sn $b $k $rev $count)
       (let $space (space $uuid $sid $sn $b $k $rev $count)
         (case (hm:one $socket $space (HVersion 1 $id $revision $kind $title $cs $ss)
                      (HVersion 1 $id $revision $kind $title $cs $ss))
           (((HVersion 1 $id $revision $kind $title $cs $ss)
             (HOriginal $id $revision $kind $title (hm:body $socket $space $id $revision) $cs $ss))
            ($error $error)))))
      ($error $error))))

; A small context view leaves original bodies out until explicitly expanded.
(= (hm:context $socket $name $id)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes)
       (case (hm:find $nodes $id)
         (((HNode 1 $id $r (retired $original $reason) $title $cs $ss $q) (HInactive $id $reason))
          ((HNode 1 $id $r $kind $title $cs $ss $q)
           (HContext $id $r $kind $title (hm:overview $socket $space $nodes $id $q)
             (collapse (let $child (superpose $cs)
               (case (hm:find $nodes $child)
                 (((HNode 1 $child $cr (retired $original $reason) $ct $cc $css $cq) (empty))
                  ((HNode 1 $child $cr $ck $ct $cc $css $cq) (HChild $child $cr $ck $ct))
                  ($error $error)))))))
          ($error $error))))
      ($error $error))))
(= (hm:retire $socket $name $id $reason)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes)
       (case (hm:find $nodes $id)
         (((HNode 1 $id $r $kind $title $cs $ss $q)
           (let $original (case $kind (((retired $old $why) $old) ($active $active)))
             (case (hm:body $socket $space $id $r)
               (((HFailure $why $at) (HFailure $why $at))
                ($body (case (hm:put-view $socket $name $space $nodes $id
                          (retired $original $reason) $title $body $cs $ss)
                  (((HFailure changed-sources $changed) (hm:retire $socket $name $id $reason))
                   ($answer $answer))))))))
          ($error $error))))
      ($error $error))))
(= (hm:setting $socket $name $key $default)
   (case (hm:open $socket $name)
     (((space $uuid $sid $sn $b $k $rev $count)
       (case (hm:one $socket (space $uuid $sid $sn $b $k $rev $count)
                 (HSetting 1 $key $value) $value)
         (((HFailure missing-record $pattern) $default) ($value $value))))
      ($error $error))))
(= (hm:set-setting $socket $name $key $value)
   (case (hm:open $socket $name)
     (((space $uuid $sid $sn $b $k $rev $count)
       (let $space (space $uuid $sid $sn $b $k $rev $count)
         (case (hm:one $socket $space (HSetting 1 $key $old) (HSetting 1 $key $old))
           (((HFailure missing-record $pattern) (hm:setting-commit $socket $name $space $key $value ()))
            ((HSetting 1 $key $old) (hm:setting-commit $socket $name $space $key $value ((remove (HSetting 1 $key $old)))))
            ($error $error)))))
      ($error $error))))
(= (hm:setting-commit $socket $name $space $key $value $prefix)
   (case (hm:commit $socket $space (hm:append $prefix ((add (HSetting 1 $key $value)))))
     (((reply $rid ok $answer) (HConfigured $key $value))
      ((reply $rid error stale-revision) (hm:set-setting $socket $name $key $value))
      ($error $error))))

; A committed turn, its task membership, and its project membership are one
; conditional batch. A store failure cannot leave an unlinked new episode.
(= (hm:record $socket $name $project $task $episode $title $message $body)
   (case (hm:snapshot $socket $name)
     (((HView $space $nodes)
       (case (hm:record-plan $socket $space $nodes () $episode episode $title $body () ((LedgerRequest $task)))
         (((HPlan $enodes $eops)
           (case (hm:record-plan $socket $space $enodes $eops $task task $task $message ($episode) ())
             (((HPlan $tnodes $tops)
               (case (hm:record-plan $socket $space $tnodes $tops $project project $project "" ($task) ())
                 (((HPlan $pnodes $pops)
                   (case (hm:stamp $pnodes $project)
                     (((HFailure $why $at) (HFailure $why $at))
                      ($stamp (case (hm:commit $socket $space $pops)
                        (((reply $rid ok $answer) (hm:record-receipt $pnodes $episode))
                         ((reply $rid error stale-revision) (hm:record $socket $name $project $task $episode $title $message $body))
                         ($error $error)))))))
                  ($error $error))))
              ($error $error))))
          ($error $error))))
      ($error $error))))
(= (hm:record-receipt $nodes $episode)
   (case (hm:find $nodes $episode)
     (((HNode 1 $episode $r $k $t $cs $ss $q) (HStored $episode $r captured))
      ($error $error))))
(= (hm:record-plan $socket $space $nodes $ops $id $kind $title $body $children $sources)
   (case (hm:find $nodes $id)
     (((HFailure missing-node $id)
       (hm:record-next $nodes $ops () $id 1 $kind $title $body $children $sources 0))
      ((HNode 1 $id $r $k $t $cs $ss $q)
       (case (hm:body $socket $space $id $r)
         (((HFailure $why $at) (HFailure $why $at))
          ($oldbody (let* (($newcs (hm:unique (hm:append $cs $children)))
                           ($text (if (== $kind episode) $body $oldbody)))
            (if (and (== $cs $newcs) (== $text $oldbody)) (HPlan $nodes $ops)
              (hm:record-next $nodes $ops ((remove (HNode 1 $id $r $k $t $cs $ss $q)))
                $id (+ $r 1) $k $t $text $newcs $ss $q)))))))
      ($error $error))))
(= (hm:record-next $nodes $ops $prefix $id $r $k $t $body $cs $ss $q)
   (let $node (HNode 1 $id $r $k $t $cs $ss $q)
     (HPlan (hm:replace $nodes $id $node)
       (hm:append $ops (hm:append $prefix
         ((add $node) (add (HVersion 1 $id $r $k $t $cs $ss)) (add (HBody 1 $id $r $body))))))))
