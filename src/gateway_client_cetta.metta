; Agent-side client of the existing gateway wire protocol.
!(import! &self ./line_rpc_cetta.metta)
!(import! &self ./state_file_cetta.metta)
!(import! &self ./state_ledger.metta)
!(import! &self ./llm_policy_cetta.metta)
(= (gateway:error $code)
   (json:stringify-python (JsonObject ((JsonPair "ok" False) (JsonPair "error" $code)))))
(= (gateway:reply $agent $text)
   (case (catch (json:parse $text))
     (((JsonObject $pairs)
       (let $reply (JsonObject $pairs)
         (if (!= (sf:get $reply "agent" JsonNull) $agent) (gateway:error "wrong-agent")
           (case (sf:get $reply "error" JsonNull)
             (((JsonObject $_) (gateway:error (sf:get (sf:get $reply "error" JsonNull) "code" "invalid-response")))
              ($none
                (let $value (sf:get $reply "value" GatewayReceiptMissingV1)
                  (if (== $value GatewayReceiptMissingV1) (gateway:error "invalid-response")
                    (json:stringify-python (JsonObject ((JsonPair "ok" True) (JsonPair "value" $value))))))))))))
      ($bad (gateway:error "invalid-response")))))
(= (gateway:call $operation $fields)
   (let* (($socket (system:getenv-or-default "METTACLAW_GATEWAY_SOCKET" ""))
          ($agent (system:getenv-or-default "METTACLAW_GATEWAY_AGENT" ""))
          ($message (JsonObject (list:append
                       ((JsonPair "version" 1) (JsonPair "agent" $agent) (JsonPair "operation" $operation)) $fields)))
          ($text (str:concat (json:stringify-python $message) "\n")))
     (if (or (== $socket "") (== $agent "")) (gateway:error "KeyError")
       (if (> (str:byte-length $text) 1048576) (gateway:error "frame-too-large")
         (case (rpc:line (str:concat "unix://" (if (path:is-absolute $socket) $socket (path:join (system:getcwd) $socket))) $text 3000 1048576)
           (((RpcReplyV1 $reply) (gateway:reply $agent $reply))
            ((RpcFailedV1 $why) (gateway:error $why))))))))
(= (gateway:tools) (gateway:call "tools" ()))
(= (gateway:status $id) (gateway:call "status" ((JsonPair "id" $id))))
(= (gateway:cancel $id) (gateway:call "cancel" ((JsonPair "id" $id))))
(= (gateway:start $id $tool $input-json $seconds)
   (let* (($input (catch (json:parse $input-json))) ($number (lp:python-float $seconds)))
     (if (or (turn:failed? $input) (case $number (((PythonException $_ $_) True) ($other False))))
       (gateway:error "invalid-request")
       (gateway:call "submit" ((JsonPair "request" (JsonObject
         ((JsonPair "id" $id) (JsonPair "tool" $tool) (JsonPair "arguments" (JsonArray ()))
          (JsonPair "input" $input) (JsonPair "deadline" (+ (system:wall-time) $number))))))))))
(= (gateway:start $id $tool $input-json) (gateway:start $id $tool $input-json 30))
(= (gateway:boot-probe)
   (if (!= (system:getenv-or-default "METTACLAW_GATEWAY_BOOT_PROBE" "0") "1") "gateway boot probe disabled"
     (gateway:start (str:join "-" ("boot" (repr (system:pid)) (repr (system:wall-time-ns)))) "project-status" "{}" 10)))
