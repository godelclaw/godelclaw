; SPDX-License-Identifier: MIT
; Component-owned declarations are data. Discovery does not invoke commands.
!(import! &self (library str))
!(import! &self ./src/settings_registry.metta)

(= (api:commands)
   (unique-atom (collapse (match &self
     (CommandSpec 1 $component $name $min $max $usage $description $settings)
     (CommandSpec 1 $component $name $min $max $usage $description $settings)))))
(= (api:find $rows $name)
   (if (== $rows ()) (APINotRegistered $name)
     (let (CommandSpec 1 $owner $key $min $max $usage $description $settings) (car-atom $rows)
       (if (== $key $name) (car-atom $rows) (api:find (cdr-atom $rows) $name)))))
(= (api:command $name) (api:find (api:commands) $name))
(= (api:prompt-rows $rows)
   (if (== $rows ()) ()
     (let (CommandSpec 1 $owner $name $min $max $usage $description $settings) (car-atom $rows)
       (cons-atom (str:join "" ("- " $usage " — " $description))
         (api:prompt-rows (cdr-atom $rows))))))
(= (api:prompt-lines) (api:prompt-rows (api:commands)))
(= (api:help-index) (str:join "\n" (cons-atom "" (api:prompt-lines))))
(= (api:help $name)
   (if (== $name "api") (api:protocol)
    (case (api:command $name)
     (((CommandSpec 1 $owner $name $min $max $usage $description $settings)
       (CommandHelp $owner $name (Usage $usage) (Arguments $min $max)
         (Description $description)
         (if (== $settings "") () (settings $settings))))
      ($unknown $unknown)))))
(= (api:argument-error $command)
   (if (== (get-metatype $command) Expression)
     (if (== (size-atom $command) 0) (APINotRegistered "")
       (let* (($name (repr (car-atom $command))) ($count (- (size-atom $command) 1)))
         (case (api:command $name)
           (((CommandSpec 1 $owner $name $min $max $usage $description $settings)
             (if (and (>= $count $min) (<= $count $max)) ""
               (str:join "" ("COMMAND_ERROR: wrong number of arguments. usage: " $usage))))
            ($unknown $unknown)))))
     (APINotRegistered "")))
(= (api:check $command)
   (case (api:argument-error $command)
     (("" (str:join "" ("OK: " (repr $command) " — valid call, not executed")))
      ($result $result))))

; A portable view for a .module declaration layer. The consumer explicitly
; interprets literal text; these fields do not install equations or commands.
(= (api:command-fields $owner $rows)
   (if (== $rows ()) ()
     (let (CommandSpec 1 $component $name $min $max $usage $description $settings) (car-atom $rows)
       (let $tail (api:command-fields $owner (cdr-atom $rows))
         (if (== $owner $component)
           (cons-atom (CommandField $component $name $min $max $usage $description) $tail) $tail)))))
(= (api:setting-fields $rows)
   (if (== $rows ()) ()
     (let (SettingSpec 1 $ns $key $default $unit $domain $life $description $reader $writer) (car-atom $rows)
       (cons-atom (SettingField $ns $key (repr $default) $unit (repr $domain) $life
                    $description (repr $reader) (repr $writer))
         (api:setting-fields (cdr-atom $rows))))))
(= (api:module-fields $component)
   (union-atom (api:command-fields $component (api:commands))
               (api:setting-fields (settings:specs $component))))

(= (api:protocol)
   (ComponentAPIProtocol 1
     (CommandFields (component name min-arguments max-arguments usage description settings-namespace))
     (Declare "Import api_registry and add a (CommandSpec 1 ...) data fact beside the component's implementation.")
     (Discover "Loaded declarations appear in getSkills, help, check and command argument checks without a Python table edit.")
     (Settings (settings:protocol))
     (Export "api:module-fields component exports the same metadata for the optional ComponentAPI.module consumer.")))
