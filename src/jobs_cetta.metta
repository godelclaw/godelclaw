; Job policy and presentation in MeTTa. Processes, clocks, JSON and files are
; native. Existing numeric job IDs and JSON records remain readable.
!(import! &self (library io))
!(import! &self (library math))
!(import! &self (library fs))
!(import! &self (library system))
!(import! &self (library str))
!(import! &self (library path))
!(import! &self (library json))
!(import! &self (library space_service))

(= (jobs:root) (system:getenv-or-default "METTACLAW_JOBS_DIR" "memory/jobs"))
(= (jobs:path $id $suffix) (path:join (jobs:root) (str:concat $id $suffix)))
(= (jobs:text $value) (format-args "{}" ($value)))
(= (jobs:number $value) (let $text (jobs:text $value) (JsonNumber $text)))
(= (jobs:string $value) (let $text (jobs:text $value) (JsonString $text)))
(= (jobs:field $record $key $default)
   (case (json-object-get $record $key)
     (((JsonString $text) $text)
      ((JsonNumber $text) (str:string->number $text))
      ((JsonBool $value) $value)
      ($other $default))))
(= (jobs:load $id)
   (case (fs:read-text-result (jobs:path $id ".json") 0 "replace")
     ((("ok" $text) (json-parse $text)) ($other (JsonNull)))))
(= (jobs:set $record $key $value)
   (let (JsonObject $pairs) $record
     (let* (($remaining (jobs:without $pairs $key))
            ($members (cons-atom (JsonPair $key $value) $remaining)))
       (JsonObject $members))))
(= (jobs:without $pairs $key)
   (if (== $pairs ()) ()
     (let* (($pair (car-atom $pairs)) ((JsonPair $name $_) $pair))
       (if (== $name $key) (jobs:without (cdr-atom $pairs) $key)
         (cons-atom $pair (jobs:without (cdr-atom $pairs) $key))))))
(= (jobs:save $record)
   (let $id (jobs:field $record "id" "")
     (fs:update-text (jobs:path $id ".json") "replace" (json-stringify $record) "" "")))
(= (jobs:records)
   (let $names (if (fs:exists (jobs:root)) (fs:entries (jobs:root)) ())
     (jobs:ordered (sort-atom (jobs:read-names $names)))))
(= (jobs:read-names $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($rest (jobs:read-names (cdr-atom $names))))
       (if (str:ends-with $name ".json")
         (let* (($id (str:byte-slice $name 0 (- (str:byte-length $name) 5)))
                ($record (jobs:load $id)))
           (case $record
             (((JsonObject $_) (let $started (jobs:field $record "started" 0) (cons-atom ($started $record) $rest)))
              ($other $rest)))) $rest))))
(= (jobs:ordered $pairs)
   (if (== $pairs ()) ()
     (let ($_ $record) (car-atom $pairs)
       (cons-atom $record (jobs:ordered (cdr-atom $pairs))))))

(= (background $command) (background $command 0))
(= (background $command $seconds)
   (if (== (str:trim $command) "") "background: empty command, nothing started"
     (let* (($id (space:request-id)) ($started (system:wall-time))
            ($log (path:join (system:cwd) (jobs:path $id ".log")))
            ($started-text (jobs:text $started))
            ($cwd (system:cwd)) ($milliseconds (math:ceil (* $seconds 1000)))
            ($record (JsonObject ((JsonPair "id" (JsonString $id))
              (JsonPair "command" (JsonString $command)) (JsonPair "log" (JsonString $log))
              (JsonPair "started" (JsonNumber $started-text))
              (JsonPair "state" (JsonString "starting")))))
            ($saved (jobs:save $record)))
       (case $saved
         ((("written" $_ $_ $_ $_)
           (case (catch (io:submit (proc:request ("bash" "-c" $command) $cwd inherit
                              $milliseconds $log $log)))
             (((io:pending $handle)
               (let* (($pid (jobs:pid (io:status $handle)))
                      ($running (jobs:set (jobs:set $record "pid" (jobs:number $pid)) "state" (JsonString "running")))
                      ($_ (jobs:save $running))
                      ($_ (add-atom &self (job:live $id $handle))))
                 (str:join "" ("job " $id " started (pid " (jobs:text $pid) "); output: " $log "; you will be woken when it ends"))))
              ($error
               (progn (jobs:save (jobs:set $record "state" (JsonString "failed to start")))
                      (str:join "" ("background: " (repr $error))))))))
          ($error (str:join "" ("background: could not persist job: " (repr $error)))))))))
(= (jobs:pid $status)
   (case $status (((proc:running $pid $_ $_ $_) $pid)
                  ((proc:finished $pid $_ $_ $_ $_) $pid) ($other 0))))

; Consume only owned process handles; HTTP and unrelated timers stay queued.
(= (jobs:harvest)
   (jobs:harvest-list (collapse (match &self (job:live $id $handle) (job:live $id $handle)))))
(= (jobs:harvest-list $live)
   (if (== $live ()) ()
     (let (job:live $id $handle) (car-atom $live)
       (progn
         (case (io:status $handle)
           (((proc:finished $pid $state $code $out $err)
             (jobs:finish $id $handle $state $code))
            ($other ())))
         (jobs:harvest-list (cdr-atom $live))))))
(= (jobs:finish $id $handle $state $code)
   (let* (($old (jobs:load $id))
          ($with-state (jobs:set $old "state" (jobs:string $state)))
          ($with-code (jobs:set $with-state "exit" (jobs:number $code)))
          ($with-time (jobs:set $with-code "ended" (jobs:number (system:wall-time))))
          ($next (jobs:set $with-time "notified" (JsonBool False))))
     (case (jobs:save $next)
       ((("written" $_ $_ $_ $_)
         (progn (io:poll $handle) (remove-atom &self (job:live $id $handle))))
        ($error (println! (JOB_RECORD_ERROR $id $error)))))))
(= (jobs:running-count)
   (progn (jobs:harvest) (length (collapse (match &self (job:live $id $_) $id)))))
(= (jobs:tail $record $bytes)
   (fs:tail-text (jobs:field $record "log" "") $bytes))
(= (job-output $id) (job-output $id 8000))
(= (job-output $id $bytes)
   (let $record (jobs:load (jobs:text $id))
     (case $record
       (((JsonObject $_)
         (case (jobs:tail $record $bytes)
           (((fs:tail $size $cut $text)
             (str:join "" ("job " (jobs:text $id) " output, " (jobs:text $size) " bytes"
                            (if $cut " (tail)" "") ":\n" (if $cut "…" "") $text)))
            ($error (str:join "" ("job-output: " (repr $error)))))))
        ($other (str:concat "job-output: no job " (jobs:text $id)))))))
(= (job-stop $id) (job-stop $id 15))
(= (job-stop $id $signal)
   (let $name (jobs:text $id)
   (let $live (collapse (match &self (job:live $name $handle) $handle))
     (if (== $live ()) (str:concat "job-stop: not running here: " (jobs:text $id))
       (progn (io:signal (car-atom $live) $signal)
              (str:concat "job stopping; completion remains observable: " $name))))))

(= (jobs:line $record)
   (let* (($id (jobs:field $record "id" ""))
          ($state (jobs:field $record "state" "unknown"))
          ($live (collapse (match &self (job:live $id $_) True)))
          ($description (if (and (or (== $state "running") (== $state "starting")) (== $live ()))
            "interrupted or outside this runtime; exit unknown" $state)))
     (str:join "" ("job " $id " " $description " exit " (jobs:text (jobs:field $record "exit" "unknown"))
       ": " (jobs:field $record "command" "")))))
(= (jobs) (jobs 20))
(= (jobs $count)
   (progn (jobs:harvest)
     (let* (($records (jobs:records))
            ($skip (if (<= $count 0) 0 (max 0 (- (length $records) $count))))
            ($lines (jobs:lines $records $skip)))
       (if (== $lines ()) "no background jobs" (str:join "\n" $lines)))))
(= (jobs:lines $records $skip)
   (if (== $records ()) ()
     (if (> $skip 0) (jobs:lines (cdr-atom $records) (- $skip 1))
       (cons-atom (jobs:line (car-atom $records)) (jobs:lines (cdr-atom $records) 0)))))

; Finished jobs wait as durable activity until the loop acknowledges its turn.
(= (jobs:pending?) (> (length (jobs:ready)) 0))
(= (jobs:ready) (progn (jobs:harvest) (jobs:unnotified (jobs:records))))
(= (jobs:unnotified $records)
   (if (== $records ()) ()
     (let $record (car-atom $records)
       (if (jobs:field $record "notified" True)
         (jobs:unnotified (cdr-atom $records)) ($record)))))
(= (jobs:active?) (not (== (collapse (match &self (job:prepared $id) $id)) ())))
(= (jobs:reset)
   (progn (jobs:recover (jobs:records))
          (jobs:forget-prepared (collapse (match &self (job:prepared $id) $id)))))
(= (jobs:recover $records)
   (if (== $records ()) ()
     (let* (($record (car-atom $records))
            ($id (jobs:field $record "id" ""))
            ($state (jobs:field $record "state" ""))
            ($live (collapse (match &self (job:live $id $_) True))))
       (progn
         (if (and (== $live ()) (or (== $state "running") (== $state "starting")))
           (jobs:save (jobs:set (jobs:set $record "state" (JsonString "interrupted; exit unknown"))
                               "notified" (JsonBool False))) ())
         (jobs:recover (cdr-atom $records))))))
(= (jobs:forget-prepared $ids)
   (if (== $ids ()) ()
     (let $id (car-atom $ids)
       (progn (remove-atom &self (job:prepared $id))
              (jobs:forget-prepared (cdr-atom $ids))))))
(= (jobs:receive)
   (let $ready (jobs:ready)
     (if (== $ready ()) ""
       (let* (($record (car-atom $ready)) ($id (jobs:field $record "id" ""))
              ($_ (if (jobs:active?) () (add-atom &self (job:prepared $id)))))
         (str:join "" ("[job completion] " (jobs:line $record) "\n" (job-output $id 1500)))))))
(= (jobs:ack)
   (jobs:ack-list (collapse (match &self (job:prepared $id) $id))))
(= (jobs:ack-list $ids)
   (if (== $ids ()) 1
     (let $id (car-atom $ids)
       (case (jobs:save (jobs:set (jobs:load $id) "notified" (JsonBool True)))
         ((("written" $_ $_ $_ $_)
           (progn (remove-atom &self (job:prepared $id)) (jobs:ack-list (cdr-atom $ids))))
          ($error (progn (println! (JOB_ACK_ERROR $id $error)) 0))))))
)
