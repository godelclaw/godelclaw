; Persistent single-owner execution-gateway adapter over space_job_queue.metta.
; All normal queue transitions, receipt checks, and event queries delegate
; directly to the unmodified qualified definitions in kb/space_job_queue.metta.
!(import! &self "kb/space_job_queue.metta")

!(bind! &gw:owner-state (new-state GatewayClosedStateV1))
!(bind! &gw:scan-state (new-state GatewayNoScanV1))
!(bind! &gw:export-state (new-state GatewayNoExportV1))

(= (gw:close-scan-state)
  (case (get-state &gw:scan-state)
    (((GatewayLiveScanV1 $view $scan $pos $keys $kb $vb)
      (let* (($_ (store:close $scan))
             ($_ (store:close $view))
             ($_ (change-state! &gw:scan-state GatewayNoScanV1)))
        GatewayScanClosedV1))
     ($none GatewayScanClosedV1))))

(= (gw:close-export-state)
  (case (get-state &gw:export-state)
    (((GatewayExportCursorsV1 $view $jobs $events)
      (let* (($_ (if (kbq:cursor? $jobs) (kbq:close $jobs) GatewayCursorDoneV1))
             ($_ (if (kbq:cursor? $events) (kbq:close $events) GatewayCursorDoneV1))
             ($_ (store:close $view))
             ($_ (change-state! &gw:export-state GatewayNoExportV1)))
        GatewayExportClosedV1))
     ($none GatewayExportClosedV1))))

(= (gw:close-owner)
  (let* (($_ (gw:close-scan-state))
         ($_ (gw:close-export-state)))
    (case (get-state &gw:owner-state)
      (((GatewayOpenStateV1 $path $agent $owner)
        (let* (($closed (store:close $owner))
               ($_ (change-state! &gw:owner-state GatewayClosedStateV1)))
          $closed))
       ($none StoreClosed)))))

(= (gw:attach-existing $path $agent)
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $_ (change-state! &gw:owner-state (GatewayOpenStateV1 $path $agent $owner))
        GatewayReadyV1))
     ($failure $failure))))

(= (gw:open $path $agent)
  (let $_ (gw:close-owner)
    (case (jobs:initialize $path $agent)
      (((KnowledgeCommittedV1 $value $epoch $revision) (gw:attach-existing $path $agent))
       ((KnowledgeReplayedV1 $value) (gw:attach-existing $path $agent))
       (GatewayReadyV1 (gw:attach-existing $path $agent))
       ($failure $failure)))))

(= (gw:scan-step $view $scan $pos $remaining $keys $kb $vb)
  (if (<= $remaining 0)
    (let $_ (change-state! &gw:scan-state (GatewayLiveScanV1 $view $scan $pos $keys $kb $vb))
      (GatewayLiveStatsMoreV1 $keys $kb $vb))
    (case (store:scan-next $scan $pos)
      ((StoreEnd
        (let $_ (gw:close-scan-state)
          (GatewayLiveStatsDoneV1 $keys $kb $vb)))
       ((StoreKey $key $size $next)
        (gw:scan-step $view $scan $next (- $remaining 1)
          (+ $keys 1) (+ $kb (str:byte-length $key)) (+ $vb $size)))
       ($failure
        (let $_ (gw:close-scan-state) $failure))))))

(= (gw:all-jobs-plan)
  (KqSpace gateway-jobs
    (GatewayJobV1 $id $state $first $ready $running $effect $fields)
    (GatewayJobV1 $id $state $first $ready $running $effect $fields)))

(= (gw:all-events-plan)
  (KqSpace gateway-jobs
    (GatewayEventV1 $id $sequence $state $at $detail)
    (GatewayEventV1 $id $sequence $state $at $detail)))

(: gw:dispatch (-> Atom %Undefined%))
(= (gw:dispatch (Open $path $agent)) (gw:open $path $agent))
(= (gw:dispatch (Close)) (gw:close-owner))

(= (gw:dispatch (ReadExistingOwner $path))
  (if (== (get-type $path) String)
    (case (store:open $path "existing")
      (((StoreOpened $owner)
        (let $answer
          (case (store:snapshot $owner)
            (((StoreSnapshot $view $epoch $revision)
              (let $probed (jobs:probe $view (GatewayOwnerV1 $stored) $stored)
                (let $_ (store:close $view) $probed)))
             ($failure $failure)))
          (let $_ (store:close $owner) $answer)))
       ($failure $failure)))
    (GatewayRefusedV1 configuration)))

(= (gw:dispatch (RecoverOwner))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (case (store:recover $owner)
        (((StoreSnapshot $view $epoch $revision)
          (let $_ (store:close $view) (GatewayOwnerRecoveredV1 $epoch $revision)))
         ($failure $failure))))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (ApplyOpen $request $command))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (case (store:snapshot $owner)
        (((StoreSnapshot $view $epoch $revision)
          (let $result (jobs:commit $owner $view $agent $request $command)
            (let $_ (store:close $view) $result)))
         ($failure $failure))))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (FindOpen $id))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (if (== (get-type $id) String)
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $result (jobs:find $view $id)
              (let $_ (store:close $view) $result)))
           ($failure $failure)))
        (GatewayRefusedV1 job-identity)))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (InspectOpen $id))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (if (== (get-type $id) String)
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($job (jobs:find $view $id))
                   ($plan (jobs:events $id))
                   ($cursor (kbq:open-space $view $plan (durable-space:wire-limit)))
                   ($_ (store:close $view)))
              (if (kbq:cursor? $cursor)
                (GatewayInspectionV1 $job (jobs:collect $cursor ()))
                $cursor)))
           ($failure $failure)))
        (GatewayRefusedV1 job-identity)))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (ResolveOpen $request $command))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (case (store:snapshot $owner)
        (((StoreSnapshot $view $epoch $revision)
          (let $result
            (jobs:server-resolve
              (ServiceCallV1 (GatewayConfigurationV1 $owner $agent) local $view
                (GatewayResolveV1 $request $command)))
            (let $_ (store:close $view) $result)))
         ($failure $failure))))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (CompactOpen))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (let* (($_ (gw:close-scan-state))
             ($_ (gw:close-export-state)))
        (case (store:compact $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($_ (store:close $view))
                   ($collected (store:collect $owner)))
              (StoreCompacted $epoch $revision $collected)))
           ($failure $failure)))))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (LiveStatsStart))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (let $_ (gw:close-scan-state)
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (case (store:scan-open $view NoBound NoBound)
              (((StoreScan $scan)
                (let $_ (change-state! &gw:scan-state (GatewayLiveScanV1 $view $scan 0 0 0 0))
                  (GatewayLiveScanStartedV1 $epoch $revision)))
               ($failure (let $_ (store:close $view) $failure)))))
           ($failure $failure)))))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (LiveStatsStep $steps))
  (case (get-state &gw:scan-state)
    (((GatewayLiveScanV1 $view $scan $pos $keys $kb $vb)
      (if (and (kb:integer? $steps) (and (> $steps 0) (<= $steps 512)))
        (gw:scan-step $view $scan $pos $steps $keys $kb $vb)
        (let $_ (gw:close-scan-state) (GatewayRefusedV1 scan-step-limit))))
     ($none (GatewayRefusedV1 scan-closed)))))

(= (gw:dispatch (ImportChunkOpen $request $edits $final-sequence))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (if (and (== (get-type $request) String) (== (get-metatype $edits) Expression))
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $answer
              (case $final-sequence
                ((NoSequenceUpdateV1
                  (durable-space:commit-command $owner $view gateway-jobs $request
                    (GatewayImportChunkV1 $request) $edits))
                 ((SetSequenceV1 $max-seq)
                  (if (and (kb:integer? $max-seq) (>= $max-seq 0))
                    (case (jobs:sequence $view)
                      (((GatewaySequenceAtV1 $last $counter)
                        (let $all (cons-atom (SpaceUpdateV1 $counter (GatewaySequenceV1 $max-seq)) $edits)
                          (durable-space:commit-command $owner $view gateway-jobs $request
                            (GatewayImportChunkV1 $request) $all)))
                       ($failure $failure)))
                    (GatewayRefusedV1 sequence-format)))
                 ($bad (GatewayRefusedV1 sequence-format))))
              (let $_ (store:close $view) $answer)))
           ($failure $failure)))
        (GatewayRefusedV1 import-format)))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (ExportOpen))
  (case (get-state &gw:owner-state)
    (((GatewayOpenStateV1 $path $agent $owner)
      (let $_ (gw:close-export-state)
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (case (jobs:probe $view (GatewayOwnerV1 $stored) $stored)
              (((SpaceProbeFoundV1 $stored $owner-refs)
                (case (jobs:sequence $view)
                  (((GatewaySequenceAtV1 $max-seq $counter)
                    (let* (($jobs-plan (gw:all-jobs-plan))
                           ($events-plan (gw:all-events-plan))
                           ($jobs (kbq:open-space $view $jobs-plan (durable-space:wire-limit)))
                           ($events (kbq:open-space $view $events-plan (durable-space:wire-limit))))
                      (if (and (kbq:cursor? $jobs) (kbq:cursor? $events))
                        (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view $jobs $events))
                          (GatewayExportOpenedV1 $epoch $revision $stored $max-seq))
                        (let* (($_ (if (kbq:cursor? $jobs) (kbq:close $jobs) GatewayCursorDoneV1))
                               ($_ (if (kbq:cursor? $events) (kbq:close $events) GatewayCursorDoneV1))
                               ($_ (store:close $view)))
                          (GatewayRefusedV1 export-cursor-open)))))
                   ($failure (let $_ (store:close $view) $failure)))))
               ($failure (let $_ (store:close $view) $failure)))))
           ($failure $failure)))))
     ($closed (GatewayRefusedV1 owner-closed)))))

(= (gw:dispatch (ExportJobsPage $count))
  (case (get-state &gw:export-state)
    (((GatewayExportCursorsV1 $view $jobs $events)
      (if (not (kbq:cursor? $jobs))
        (GatewayExportPageV1 () Complete)
        (if (and (kb:integer? $count) (and (> $count 0) (<= $count 256)))
          (case (kbq:page $jobs $count 4096)
            (((KqPage $rows (KqMore $next))
              (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view $next $events))
                (GatewayExportPageV1 $rows More)))
             ((KqPage $rows (KqPaused $next))
              (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view $next $events))
                (GatewayExportPageV1 $rows Paused)))
             ((KqPage $rows (KqComplete $work))
              (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view GatewayCursorDoneV1 $events))
                (GatewayExportPageV1 $rows Complete)))
             ($failure (let $_ (gw:close-export-state) $failure))))
          (let $_ (gw:close-export-state) (GatewayRefusedV1 export-page-limit)))))
     ($none (GatewayRefusedV1 export-closed)))))

(= (gw:dispatch (ExportEventsPage $count))
  (case (get-state &gw:export-state)
    (((GatewayExportCursorsV1 $view $jobs $events)
      (if (not (kbq:cursor? $events))
        (GatewayExportPageV1 () Complete)
        (if (and (kb:integer? $count) (and (> $count 0) (<= $count 256)))
          (case (kbq:page $events $count 4096)
            (((KqPage $rows (KqMore $next))
              (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view $jobs $next))
                (GatewayExportPageV1 $rows More)))
             ((KqPage $rows (KqPaused $next))
              (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view $jobs $next))
                (GatewayExportPageV1 $rows Paused)))
             ((KqPage $rows (KqComplete $work))
              (let $_ (change-state! &gw:export-state (GatewayExportCursorsV1 $view $jobs GatewayCursorDoneV1))
                (GatewayExportPageV1 $rows Complete)))
             ($failure (let $_ (gw:close-export-state) $failure))))
          (let $_ (gw:close-export-state) (GatewayRefusedV1 export-page-limit)))))
     ($none (GatewayRefusedV1 export-closed)))))

(= (gw:dispatch (ExportClose)) (gw:close-export-state))

; Top-level cetta-value-worker entry: value_worker_main.c wraps the decoded
; request in (quote <request>), so leaving gw:run untyped unwraps that quote
; once and hands the literal expression to typed gw:dispatch.
(= (gw:run $message) (gw:dispatch $message))
