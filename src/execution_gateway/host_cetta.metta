; The queue has one owner. Socket readiness and isolated tool streams share
; one bounded event loop; journal transitions stay in the existing kernel.
!(import! &self ./protocol_cetta.metta)
!(import! &self (library host_io))
!(import! &self ../tool_output_cetta.metta)
!(bind! &ng-config (new-state (JsonObject ())))
!(bind! &ng-clients (new-state ()))
!(bind! &ng-active (new-state GatewayIdleV1))
!(bind! &ng-fatal (new-state ""))
!(bind! &ng-requested-stop (new-state False))
!(bind! &ng-maintenance (new-state (GatewayMaintenanceV1 1048576 0)))
(= (ng:root) (sf:get (get-state &ng-config) "state_directory" ""))
(= (ng:agent) (sf:get (get-state &ng-config) "agent" ""))
(= (ng:fatal $reason)
   (let* (($_ (change-state! &ng-fatal $reason)) ($_ (system:write stderr (str:concat $reason "\n")))) False))
(= (ng:host-failed? $value) (case $value (((HostFailure $_ $_ $_) True) ($other False))))
(= (ng:reply-buffer $value)
   (let* (($text (str:concat (json:stringify-python (ng:envelope (ng:agent) $value)) "\n"))
          ($actual (if (> (str:byte-length $text) 1048576)
                     (str:concat (json:stringify-python (ng:envelope (ng:agent)
                       (GatewayProtocolErrorV1 "frame-too-large" "reply exceeds protocol frame; inspect retained artifacts"))) "\n") $text))
          ($owner (buffer:new 1048576 bytes)) ($_ (buffer:append $owner $actual))) $owner))
(= (ng:client-close (GatewayClientV1 $fd $input $output $offset $until))
   (progn (host:close $fd) (host:close $input)
     (if (== $output GatewayNoReplyV1) True (host:close $output))))
(= (ng:accept $listener $left $clients)
   (if (or (<= $left 0) (>= (size-atom $clients) 64)) $clients
     (case (host:accept $listener)
       (((HostAccepted $fd (HostPeer $pid $uid $gid))
         (let (HostPeer $_ $own-uid $_) (host:identity)
           (if (!= $uid $own-uid) (progn (host:close $fd) (ng:accept $listener (- $left 1) $clients))
             (let* (($input (buffer:new 1048576 bytes)) ($until (+ (system:monotonic-ns) 3000000000))
                    ($client (GatewayClientV1 $fd $input GatewayNoReplyV1 0 $until)))
               (ng:accept $listener (- $left 1) (cons-atom $client $clients))))))
        (HostPending $clients)
        ($bad (progn (ng:fatal "listener unavailable") $clients))))))
(= (ng:client-step (GatewayClientV1 $fd $input $output $offset $until))
   (if (>= (system:monotonic-ns) $until) (progn (ng:client-close (GatewayClientV1 $fd $input $output $offset $until)) GatewayClientClosedV1)
     (if (!= $output GatewayNoReplyV1)
       (case (host:write-buffer $fd $output $offset 65536)
         (((HostWritten $count)
           (let (HostBufferInfo $length $_) (buffer:info $output)
             (if (>= (+ $offset $count) $length)
               (progn (ng:client-close (GatewayClientV1 $fd $input $output $offset $until)) GatewayClientClosedV1)
               (GatewayClientV1 $fd $input $output (+ $offset $count) $until))))
          (HostPending (GatewayClientV1 $fd $input $output $offset $until))
          ($bad (progn (ng:client-close (GatewayClientV1 $fd $input $output $offset $until)) GatewayClientClosedV1))))
       (case (host:read $fd 65536)
         (((HostBytes $bytes)
           (let $appended (buffer:append $input $bytes)
             (if (ng:host-failed? $appended)
               (GatewayClientV1 $fd $input (ng:reply-buffer (ng:invalid "invalid gateway frame")) 0 $until)
               (case (buffer:line $input)
                 (((HostLine $line)
                   (let* (($message (json:parse-python $line))
                          ($result (if (ng:object? $message) (ng:dispatch $message (get-state &ng-config))
                                     (ng:invalid "invalid JSON gateway frame"))))
                     (progn (if (ngq:failed? $result) (ng:fatal "queue transition unavailable") True)
                       (GatewayClientV1 $fd $input (ng:reply-buffer $result) 0 $until))))
                  ($pending (GatewayClientV1 $fd $input GatewayNoReplyV1 0 $until)))))))
          (HostPending (GatewayClientV1 $fd $input GatewayNoReplyV1 0 $until))
          ($end (progn (ng:client-close (GatewayClientV1 $fd $input $output $offset $until)) GatewayClientClosedV1)))))))
(= (ng:clients-step $clients)
   (if (== $clients ()) ()
     (let* (($next (ng:client-step (car-atom $clients))) ($rest (ng:clients-step (cdr-atom $clients))))
       (if (== $next GatewayClientClosedV1) $rest (cons-atom $next $rest)))))
(= (ng:client-interests $clients)
   (map-atom $clients $client
     (let (GatewayClientV1 $fd $_ $output $_ $_) $client
       ($fd (if (== $output GatewayNoReplyV1) read write)))))
(= (ng:environment $tool)
   (let $object (sf:put (JsonObject ((JsonPair "PATH" "/bin:/usr/bin"))) "PATH" "/bin:/usr/bin")
     (case (sf:get $tool "environment" (JsonObject ()))
       (((JsonObject $pairs) (ng:environment-pairs (sf:put-all $object $pairs)))
        ($bad GatewayInvalidEnvironmentV1)))))
(= (ng:environment-pairs (JsonObject $pairs))
   (map-atom $pairs $pair (let (JsonPair $name $value) $pair ($name $value))))
(= (ng:credentials $tool)
   (case (sf:get $tool "credential_files" (JsonObject ()))
     (((JsonObject $pairs) (map-atom $pairs $pair (let (JsonPair $name $path) $pair ($name $path))))
      ($bad GatewayInvalidCredentialBindingsV1))))
(= (ng:command $tool $request $input-path)
   (case (ng:legacy-read (sf:get $tool "command" JsonNull))
     (((GatewayNativeReadV1 $name)
       (let* (($binary (system:executable)) ($entry (sf:get (get-state &ng-config) "native_read_entry" ""))
              ((JsonArray $arguments) (sf:get $request "arguments" (JsonArray ()))))
         (list:append ($binary "--no-results" "--lang" "petta" "--profile" "extended"
                       "--import-mode" "ancestor-walk" $entry $name $input-path) $arguments)))
      (GatewayExternalToolV1
       (let* (((JsonArray $command) (sf:get $tool "command" JsonNull))
              ((JsonArray $arguments) (sf:get $request "arguments" (JsonArray ())))) (list:append $command $arguments))))))
(= (ng:finish $id $state $result $error $outputs)
   (case (ngq:finish $id $state $result $error $outputs)
     (((GatewayAppliedV1 $_ $_) True) ($bad (ng:fatal "job settlement unavailable")))))
(= (ng:start (GatewayJobV1 $id $state $sequence $ready $running $effect
       (GatewayFieldsV1 $fingerprint $request-json $stored-effect $cancel $result $error $outputs $deadline)))
   (let* (($request (json:parse-python $request-json))
          ($tool (sf:get (sf:get (get-state &ng-config) "tools" (JsonObject ())) (sf:get $request "tool" "") JsonNull)))
     (if (or (== $tool JsonNull) (!= (ng:fingerprint $request $tool) $fingerprint))
       (ng:finish $id (quote failed) JsonNull "tool-configuration-changed" JsonNull)
       (let* (($directory (path:join (path:join (ng:root) "captures") $id))
              ($_ (fs:make-directories $directory 448)) ($input-path (path:join $directory "input.json"))
              ($input (json:stringify-python (sf:get $request "input" JsonNull)))
              ($saved (sf:replace $input-path $input 384 False))
              ($out-path (path:join $directory "stdout.bin")) ($err-path (path:join $directory "stderr.bin"))
              ($out (fs:open-write $out-path ("create" "truncate") 384))
              ($err (fs:open-write $err-path ("create" "truncate") 384)))
         (if (or (!= $saved True) (or (sf:failed? $out) (sf:failed? $err)))
           (progn (fs:close $out) (fs:close $err) (ng:finish $id (quote failed) JsonNull "capture-unavailable" JsonNull))
           (let* (($argv (ng:command $tool $request $input-path)) ($environment (ng:environment $tool))
                  ($credentials (ng:credentials $tool))
                  ($options ((cwd (sf:get $tool "cwd" (system:getcwd))) (env $environment)
                    (credential-files $credentials) (mode stream) (max-bytes 262144) (stdin $input) (lifetime owner)))
                  ($child (proc:spawn $argv $options)))
             (case $child
               (((NativeHandle $_ $_)
                 (let* (($until (+ (system:monotonic-ns) (math:floor (* (max 0 (- $deadline (system:wall-time))) 1000000000))))
                        ($_ (proc:close-input $child)))
                   (change-state! &ng-active (GatewayActiveV1 $id $effect $tool $child $out $err
                       $out-path $err-path $until False False ""))))
                ($failed (progn (fs:close $out) (fs:close $err)
                  (ng:finish $id (quote failed) JsonNull "tool-launch-refused" JsonNull)))))))))))
(= (ng:reserve $root)
   (case (host:volume $root)
     (((HostVolume $total $available)
       (let* (($explicit (system:getenv-or-default "METTACLAW_TOOL_STORAGE_RESERVE_BYTES" ""))
              ($fraction (parse (system:getenv-or-default "METTACLAW_TOOL_STORAGE_RESERVE_FRACTION" "0.01")))
              ($reserve (if (== $explicit "") (max 67108864 (* $total $fraction)) (parse $explicit))))
         (if (and (ng:finite? $reserve) (and (>= $reserve 0) (and (>= $fraction 0) (<= $fraction 1))))
           (GatewayAvailableV1 $available $reserve) GatewayStorageRefusedV1)))
      ($bad GatewayStorageRefusedV1))))
(= (ng:drain $child $stream $file $ended $left)
   (if (or $ended (<= $left 0)) (GatewayDrainV1 $ended "")
     (case (ng:reserve (ng:root))
       (((GatewayAvailableV1 $available $reserve)
         (if (< $available (+ $reserve 65536)) (GatewayDrainV1 False "storage-exhausted")
           (case (proc:read $child $stream 0)
             (((proc:chunk $bytes)
               (let $wrote (fs:write-all $file $bytes)
                 (if (sf:failed? $wrote) (GatewayDrainV1 False "storage-exhausted")
                   (ng:drain $child $stream $file False (- $left 1)))))
              (proc:eof (GatewayDrainV1 True ""))
              (proc:pending (GatewayDrainV1 False ""))
              ($bad (GatewayDrainV1 False "capture-failed"))))))
        ($bad (GatewayDrainV1 False "storage-exhausted"))))))
(= (ng:preview $path)
   (let* (($file (fs:open-read $path)) ($bytes (fs:read-chunk $file 6000)) ($_ (fs:close $file))
          ($decoder (str:utf8-new replace)))
     (case $bytes
       (((fs:chunk $data $_) (case (str:utf8-feed $decoder $data True) (((Utf8DecodedV1 $text $_) $text) ($bad ""))))
        ((fs:end $_) "") ($bad "")))))
(= (ng:artifact $path $complete)
   (let* (($preview (ng:preview $path)) ($file (fs:open-read $path)) ($synced (fs:sync $file)) ($_ (fs:close $file)))
     (if (sf:failed? $synced) (GatewayHostFaultV1 "capture sync failed")
       (case (fs:sha256-file $path)
         (((fs:hashed-v1 $digest (fs:info-v2 $_ $bytes $_ $_ $_ $_ $_))
           (let* (($root (path:join (ng:root) "tool-results")) ($_ (fs:make-directories $root 448))
                  ($target (path:join $root (str:concat $digest ".txt"))) ($saved (fs:rename $path $target))
                  ($directory-synced (if (sf:failed? $saved) False (sf:sync-directory $root))))
             (if (!= $directory-synced True) (GatewayHostFaultV1 "artifact publication uncertain")
               (GatewayOutputV1 $preview (JsonObject ((JsonPair "path" $target) (JsonPair "sha256" $digest)
                 (JsonPair "bytes" $bytes) (JsonPair "preview_truncated" (> $bytes 6000)) (JsonPair "complete" $complete)))))))
          ($bad (GatewayHostFaultV1 "capture hash failed")))))))
(= (ng:exit-code $result)
   (case $result (((proc:result (proc:exited $code) $_ $_ $_ $_) $code)
                 ((proc:result (proc:signaled $signal) $_ $_ $_ $_) (- 0 $signal)) ($bad -1))))
(= (ng:launch-error $result)
   (case $result
     (((proc:result (proc:launch-failed $code $_) $_ $_ $_ $_)
       (if (== $code (system:errno-value "ENOENT")) "FileNotFoundError"
         (if (== $code (system:errno-value "EACCES")) "PermissionError" "OSError")))
      ($launched ""))))
(= (ng:settle-active $id $effect $tool $child $out $err $out-path $err-path $reason $until)
   (let* (($result (proc:await $child)) ($_ (proc:close $child))
          ($_ (fs:sync $out)) ($_ (fs:sync $err)) ($_ (fs:close $out)) ($_ (fs:close $err))
          ($launch-error (ng:launch-error $result))
          ($complete (== $reason "")) ($stdout (ng:artifact $out-path $complete)) ($stderr (ng:artifact $err-path $complete)))
     (if (or (ngq:failed? $stdout) (ngq:failed? $stderr)) (ng:fatal "artifact retention unavailable; claimed effect remains unresolved")
       (let* (((GatewayOutputV1 $out-text $out-artifact) $stdout) ((GatewayOutputV1 $err-text $err-artifact) $stderr)
              ($code (ng:exit-code $result))
              ($outputs (JsonObject ((JsonPair "stdout" $out-artifact) (JsonPair "stderr" $err-artifact))))
              ($large (or (sf:get $out-artifact "preview_truncated" False) (sf:get $err-artifact "preview_truncated" False)))
              ($base (JsonObject ((JsonPair "stdout" $out-text) (JsonPair "stderr" $err-text) (JsonPair "exit_code" $code))))
              ($value (if $large (sf:put-all $base ((JsonPair "artifacts" $outputs) (JsonPair "preview_truncated" True))) $base)))
         (if (!= $launch-error "") (ng:finish $id (quote failed) JsonNull $launch-error $outputs)
          (if (and $complete (== $code 0))
           (ng:success $id $effect $tool $value $outputs $out-artifact $until)
           (ng:finish $id (if (== (ngq:text $effect) "write") (quote uncertain)
                            (if (== $reason "cancelled") (quote cancelled) (quote failed)))
             $value (if (== $reason "") "tool-exit" $reason) $outputs)))))))
(= (ng:success $id $effect $tool $value $outputs $out-artifact $until)
   (if (!= (sf:get $tool "result_format" "text") "json")
     (ng:finish $id (quote succeeded) $value JsonNull $outputs)
     (let $cursor (host:json-open (sf:get $out-artifact "path" ""))
       (if (ng:host-failed? $cursor)
         (ng:finish $id (if (== (ngq:text $effect) "write") (quote uncertain) (quote failed)) $value "OSError" $outputs)
         (progn (change-state! &ng-active (GatewayValidatingV1 $id $effect $cursor $value $outputs $out-artifact $until))
                GatewayKeepActiveV1)))))
(= (ng:validation-failed $id $effect $cursor $value $outputs $reason)
   (progn (host:close $cursor)
     (ng:finish $id (if (== (ngq:text $effect) "write") (quote uncertain)
                       (if (== $reason "cancelled") (quote cancelled) (quote failed))) $value $reason $outputs)
     (change-state! &ng-active GatewayIdleV1)))
(= (ng:validation-step $id $effect $cursor $value $outputs $artifact $until $stopping)
   (let* (($cancel (ngq:cancellation-requested? $id))
          ($reason (if $stopping "gateway-stopped" (if (== $cancel True) "cancelled"
                     (if (>= (system:monotonic-ns) $until) "deadline" "")))))
     (if (ngq:failed? $cancel) (ng:fatal "validation cancellation observation unavailable")
       (if (!= $reason "") (ng:validation-failed $id $effect $cursor $value $outputs $reason)
         (case (host:json-step $cursor 65536)
           (((HostJsonMore $_) True)
            ((HostJsonValid $_)
             (let* (($parsed (if (sf:get $artifact "preview_truncated" False)
                      (sf:put-all $value ((JsonPair "result_format" "json") (JsonPair "stored_json" $artifact)))
                      (case (host:json-text $cursor 6000)
                        (((HostJsonText $text) (json:parse-python $text)) ($bad GatewayJsonMaterializationFailedV1)))))
                    ($_ (host:close $cursor)))
               (progn (if (or (== $parsed GatewayJsonMaterializationFailedV1) (ng:json-error? $parsed))
                 (ng:finish $id (if (== (ngq:text $effect) "write") (quote uncertain) (quote failed)) $value "JSONDecodeError" $outputs)
                 (ng:finish $id (quote succeeded) $parsed JsonNull $outputs))
               (change-state! &ng-active GatewayIdleV1))))
            ((HostFailure $_ $code $_)
             (ng:validation-failed $id $effect $cursor $value $outputs
               (if (== $code (system:errno-value "ERANGE")) "ValueError"
                 (if (== $code (system:errno-value "EILSEQ")) "UnicodeDecodeError" "JSONDecodeError"))))
            ($bad (ng:validation-failed $id $effect $cursor $value $outputs "validation-unavailable"))))))))
(= (ng:json-error? $value)
   (case $value (((JsonPythonErrorV1 $_ $_) True) ((JsonPythonErrorV1 $_ $_ $_ $_ $_ $_) True)
                ((JsonFailureV1 $_ $_ $_ $_) True) ((Error $_ $_) True) ($other False))))
(= (ng:active-step $stopping)
   (case (get-state &ng-active)
     ((GatewayIdleV1
       (if $stopping True
         (case (ngq:claim)
           ((GatewayNoJobV1 True) ((GatewayDispatchJobV1 $row) (ng:start $row))
            ($bad (ng:fatal "queue claim unavailable"))))))
      ((GatewayActiveV1 $id $effect $tool $child $out $err $out-path $err-path $until $out-eof $err-eof $prior)
       (let* (($cancelled (ngq:cancellation-requested? $id))
              ($reason (if (!= $prior "") $prior
                (if $stopping "gateway-stopped"
                  (if (== $cancelled True) "cancelled"
                    (if (>= (system:monotonic-ns) $until) "deadline" "")))))
              ($_ (if (ngq:failed? $cancelled) (ng:fatal "cancellation observation unavailable") True))
              ((GatewayDrainV1 $next-out $out-error) (ng:drain $child stdout $out $out-eof 2))
              ((GatewayDrainV1 $next-err $err-error) (ng:drain $child stderr $err $err-eof 2))
              ($failure (if (!= $reason "") $reason (if (!= $out-error "") $out-error $err-error)))
              ($_ (if (!= $failure "") (proc:cancel $child) True))
              ($status (proc:status $child)))
         (if (or (and $next-out $next-err) (and (!= $failure "") (== $status proc:ready)))
           (let $settled (ng:settle-active $id $effect $tool $child $out $err $out-path $err-path $failure $until)
             (if (== $settled GatewayKeepActiveV1) True (change-state! &ng-active GatewayIdleV1)))
           (change-state! &ng-active (GatewayActiveV1 $id $effect $tool $child $out $err
             $out-path $err-path $until $next-out $next-err $failure)))))
      ((GatewayValidatingV1 $id $effect $cursor $value $outputs $artifact $until)
       (ng:validation-step $id $effect $cursor $value $outputs $artifact $until $stopping)))))
(= (ng:close-clients $clients)
   (if (== $clients ()) True (progn (ng:client-close (car-atom $clients)) (ng:close-clients (cdr-atom $clients)))))
(= (ng:loop $listener $signals)
   (let* (($requested (!= (host:signal $signals) 0))
          ($_ (if $requested (change-state! &ng-requested-stop True) True))
          ($stop (or $requested (!= (get-state &ng-fatal) "")))
          ($clients (if $stop (get-state &ng-clients) (ng:accept $listener 8 (get-state &ng-clients))))
          ($next (ng:clients-step $clients)) ($_ (change-state! &ng-clients $next))
          ($_ (ng:active-step $stop))
          ($_ (if (and (not $stop) (== (get-state &ng-active) GatewayIdleV1)) (ng:maintenance) True)))
     (if (and $stop (== (get-state &ng-active) GatewayIdleV1)) True
       (let* (($interests (cons-atom ($listener read) (ng:client-interests $next)))
              ($timeout (case (get-state &ng-active) ((GatewayIdleV1 50) ((GatewayValidatingV1 $_ $_ $_ $_ $_ $_ $_) 0) ($other 5))))
              ($_ (host:wait $interests $timeout)))
         (ng:loop $listener $signals)))))
(= (ng:physical $path)
   (foldl-atom (fs:entries $path) 0 $sum $name
     (+ $sum (case (fs:metadata (path:join $path $name) no-follow)
       (((fs:info $_ $bytes $_) $bytes) ($missing 0))))))
(= (ng:maintenance)
   (case (get-state &ng-maintenance)
     (((GatewayMaintenanceV1 $threshold $when)
       (if (< (system:monotonic-ns) $when) True
         (let* (($path (path:join (ng:root) "queue.db")) ($physical (ng:physical $path))
                ($capacity (ng:reserve $path))
                ($low (case $capacity (((GatewayAvailableV1 $available $_) (< $available 67108864)) ($bad True))))
                ($floor (if $low 262144 1048576)))
           (if (or (< $physical $floor) (and (not $low) (< $physical $threshold)))
             (change-state! &ng-maintenance (GatewayMaintenanceV1 $threshold (+ (system:monotonic-ns) 5000000000)))
             (case (gw:run (LiveStatsStart))
               (((GatewayLiveScanStartedV1 $_ $_)
                 (change-state! &ng-maintenance (GatewayScanningV1 $physical $low)))
                ($bad (ng:fatal "queue maintenance snapshot unavailable"))))))))
      ((GatewayScanningV1 $physical $low)
       (case (gw:run (LiveStatsStep 256))
         (((GatewayLiveStatsMoreV1 $_ $_ $_) True)
          ((GatewayLiveStatsDoneV1 $keys $key-bytes $value-bytes)
           (let* (($live (max 4096 (+ (+ $key-bytes $value-bytes) (+ (* $keys 48) 4096))))
                  ($ratio (if $low 1.5 2.5)) ($reclaim (if $low 131072 524288))
                  ($headroom (case (host:volume (ng:root)) (((HostVolume $_ $free) $free) ($bad 0))))
                  ($compact (and (>= (- $physical $live) $reclaim)
                             (and (>= $physical (* $live $ratio)) (>= $headroom (+ (* $live 2) 65536)))))
                  ($after (if $compact (case (gw:run (CompactOpen))
                    (((StoreCompacted $_ $_ $_) (ng:physical (path:join (ng:root) "queue.db")))
                     ($bad (progn (ng:fatal "queue compaction unavailable") $physical)))) $physical))
                  ($next (if $compact (max 1048576 (math:floor (* $after $ratio)))
                           (max (+ $physical (max (math:floor (/ $reclaim 2)) 16384)) (math:floor (* $live $ratio))))))
             (change-state! &ng-maintenance (GatewayMaintenanceV1 $next (+ (system:monotonic-ns) 5000000000)))))
          ($bad (ng:fatal "queue live scan unavailable"))))))))
(= (ng:run-held $config $lock)
   (let* (($agent (sf:get $config "agent" ""))
          ($root (fs:canonical-path (sf:get $config "state_directory" "")))
          ($entry (path:join (path:dirname (system:entry-directory)) "scripts/gateway_read_cetta.metta"))
          ($actual (sf:put-all $config ((JsonPair "state_directory" $root) (JsonPair "native_read_entry" $entry))))
          ($_ (change-state! &ng-config $actual)) ($queue (ngq:open (path:join $root "queue.db") $agent)))
     (progn (if (!= $queue GatewayReadyV1) (ng:fatal "queue open refused")
       (let* (($recovered (ngq:recover)) ($signals (host:signals))
              ($listener (host:listen-recover (path:join $root "gateway.sock") 64)))
         (progn (if (or (ngq:failed? $recovered) (or (ng:host-failed? $signals) (ng:host-failed? $listener)))
           (ng:fatal "gateway admission refused")
           (let* (($ready (JsonObject ((JsonPair "pid" (system:pid)) (JsonPair "agent" $agent)
                     (JsonPair "engine" (system:executable)) (JsonPair "ready_at" (system:wall-time)))))
                  ($saved (sf:replace (path:join $root "gateway-native-ready.json") (json:stringify-python $ready) 384 False)))
             (if (!= $saved True) (ng:fatal "readiness record unavailable")
               (progn (system:notify "READY=1") (ng:loop $listener $signals)))))
         (ng:close-clients (get-state &ng-clients)) (host:close $listener) (ngq:close) (host:close $signals)
         (fs:remove (path:join $root "gateway-native-ready.json")))))
     (fs:unlock $lock) (fs:close $lock)
     (if (or (get-state &ng-requested-stop) (== (get-state &ng-fatal) "")) 0 1))))
(= (ng:main $config-path)
   (let* (($config (sf:native-object $config-path)) ($agent (sf:get $config "agent" ""))
          ($root (sf:get $config "state_directory" "")) ($tools (sf:get $config "tools" JsonNull)))
     (if (not (and (ng:name? $agent) (and (!= $root "")
                 (case $tools (((JsonObject $pairs) (ng:tools-valid? $pairs)) ($bad False)))))) 78
       (let* (($_ (fs:make-directories $root 448)) ($lock-path (path:join $root "worker.lock")))
         (if (ngq:symlink? $lock-path) 78
           (let $lock (fs:open-write $lock-path ("create" "append") 384)
             (if (sf:failed? $lock) 78
               (let $held (fs:lock $lock exclusive-nowait)
                 (if (sf:failed? $held) (progn (fs:close $lock) 78) (ng:run-held $config $lock))))))))))
