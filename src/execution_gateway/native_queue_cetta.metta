; In-process adapter over the qualified queue kernel. Wire JSON and durable
; queue facts keep their established formats; live handles never cross JSON.
!(import! &self ./metta/gateway_queue.metta)
!(import! &self ../state_file_cetta.metta)
!(import! &self (library list))
!(bind! &ngq-state (new-state NGQueueClosedV1))
(: ngq:text (-> Atom %Undefined%))
(= (ngq:text $value) (if (== (get-type $value) String) $value (repr (quote $value))))
(= (ngq:fault $kind) (GatewayHostFaultV1 $kind))
(= (ngq:failed? $value) (case $value (((GatewayHostFaultV1 $kind) True) ($other False))))
(= (ngq:agent)
   (case (get-state &ngq-state) (((NGQueueOpenV1 $agent $path $lock) $agent) ($closed ""))))
(= (ngq:basename $path) (car-atom (path:reverse-atom-expr (str:split "/" $path))))
(= (ngq:symlink? $path)
   (case (fs:metadata $path no-follow) (((fs:info symlink $size $identity) True) ($other False))))
(= (ngq:close)
   (case (get-state &ngq-state)
     (((NGQueueOpenV1 $agent $path $lock)
       (let* (($_ (gw:run (Close))) ($_ (fs:unlock $lock)) ($_ (fs:close $lock))
              ($_ (change-state! &ngq-state NGQueueClosedV1))) True))
      ($closed True))))
(= (ngq:open $path $agent)
   (let* (($_ (ngq:close)) ($parent (path:dirname $path)) ($_ (fs:make-directories $parent 448))
          ($canonical (fs:canonical-path $parent)) ($name (ngq:basename $path))
          ($actual (path:join $canonical $name))
          ($lock-path (path:join $canonical (str:join "" ("." $name ".owner.lock"))))
          ($marker (path:join $canonical (str:join "" ("." $name ".activated.json")))))
     (if (or (ngq:symlink? $lock-path) (ngq:symlink? $marker)) (ngq:fault "unsafe-owner-path")
       (let $lock (fs:open-write $lock-path ("create" "append") 384)
         (if (sf:failed? $lock) (ngq:fault "owner-lock-unavailable")
           (let* (($_ (fs:set-mode $lock 384)) ($held (fs:lock $lock exclusive-nowait)))
             (if (sf:failed? $held)
               (progn (fs:close $lock) (ngq:fault "queue-already-owned"))
               (ngq:open-held $actual $agent $lock $marker))))))))
(= (ngq:open-held $path $agent $lock $marker)
   (let* (($root (path:join $path "root.csl")) ($activated (fs:exists $marker))
          ($record (if $activated (sf:native-object $marker) (JsonObject ())))
          ($conflict (and $activated (or (!= (sf:get $record "schema" 0) 1)
                                       (!= (sf:get $record "agent" "") $agent))))
          ($has-root (fs:is-file $root))
          ($legacy (path:join (path:dirname $path) "queue.sqlite3"))
          ($bad-directory (if (fs:exists $path)
            (case (fs:metadata $path no-follow)
              (((fs:info directory $bytes $identity)
                (and (not $has-root) (not (== (fs:entries $path) ()))))
               ($bad True))) False))
          ($refuse (or $conflict (or (and $activated (not $has-root))
                     (or $bad-directory (and (and (== (ngq:basename $path) "queue.db") (fs:exists $legacy)) (not $has-root)))))))
     (if $refuse (progn (fs:unlock $lock) (fs:close $lock) (ngq:fault "activated-store-unavailable-or-wrong-owner"))
       (let* (($_ (fs:make-directories $path 448))
              ($directory (fs:open-read $path)) ($private (fs:set-mode $directory 448)) ($_ (fs:close $directory))
              ($opened (if (sf:failed? $private) (ngq:fault "queue-permissions-unavailable")
                        (if $has-root (gw:run (OpenExisting $path $agent)) (gw:run (Open $path $agent))))))
         (if (!= $opened GatewayReadyV1)
           (progn (fs:unlock $lock) (fs:close $lock) (ngq:fault "queue-open-failed"))
           (let* (($_ (change-state! &ngq-state (NGQueueOpenV1 $agent $path $lock)))
                  ($saved (if $activated True
                    (sf:replace $marker (json:stringify-python (JsonObject
                      ((JsonPair "schema" 1) (JsonPair "agent" $agent) (JsonPair "mode" "initialized")
                       (JsonPair "activated_at" (system:wall-time))))) 384 True))))
             (if (== $saved True) GatewayReadyV1 (progn (ngq:close) (ngq:fault "activation-not-durable")))))))))
(: ngq:apply (-> %Undefined% Atom %Undefined% %Undefined%))
(= (ngq:apply $id $command $allow-replay)
   (case (gw:run (ApplyOpen $id $command))
     (((GatewayCommittedV1 $value $created $epoch $revision) (GatewayAppliedV1 $value False))
      ((GatewayReplayedV1 $value $epoch)
       (if $allow-replay (GatewayAppliedV1 $value True) (ngq:fault "replayed-claim-grants-no-dispatch")))
      ((GatewayEmptyReadOnlyV1 $epoch $revision) (GatewayAppliedV1 GatewayEmptyV1 False))
      ((GatewayRefusedV1 fingerprint-conflict) (GatewayHostConflictV1 "request ID already names a different operation"))
      ((GatewayRefusedV1 owner-conflict) (GatewayHostConflictV1 "queue belongs to another agent"))
      ($bad (ngq:fault "queue-transition-not-established")))))
(= (ngq:operation) (str:concat "queue-op-" (system:uuid4-hex)))
(: ngq:bool (-> Atom %Undefined%))
(= (ngq:bool $flag)
   (case $flag ((True True) (true True) (False False) (false False) ($bad (ngq:fault "invalid-boolean-record")))))
(: ngq:option (-> Atom %Undefined% %Undefined%))
(= (ngq:option $record $json)
   (case $record
     ((NoValueV1 JsonNull)
      ((SomeValueV1 $text) (if $json (json:parse-python $text) $text))
      ($bad (ngq:fault "invalid-optional-record")))))
(= (ngq:encoded-option $value $json)
   (if (== $value JsonNull) NoValueV1
     (let $text (if $json (json:stringify-python $value) $value) (SomeValueV1 $text))))
(: ngq:detail (-> Atom %Undefined%))
(= (ngq:detail $detail)
   (case $detail
     (((GatewayDetailV1) (JsonObject ()))
      ((GatewayDispatchedV1 $flag) (let $value (ngq:bool $flag) (JsonObject ((JsonPair "dispatched" $value)))))
      ((GatewayAttemptV1 $attempt) (JsonObject ((JsonPair "dispatch_attempt" $attempt))))
      ((GatewayErrorDetailV1 $error) (JsonObject ((JsonPair "error" $error))))
      ($bad (ngq:fault "invalid-event-detail")))))
(: ngq:event (-> Atom %Undefined%))
(= (ngq:event (SpaceAnswerV1 (GatewayEventV1 $id $sequence $state $at $detail) $refs))
   (let* (($name (ngq:text $state)) ($value (ngq:detail $detail)))
     (JsonObject ((JsonPair "sequence" $sequence) (JsonPair "state" $name)
                  (JsonPair "at" $at) (JsonPair "detail" $value)))))
(: ngq:job-view (-> Atom %Undefined% %Undefined%))
(= (ngq:job-view
     (GatewayJobV1 $id $state $sequence $ready $running $effect
       (GatewayFieldsV1 $fingerprint $request $stored-effect $cancel $result $error $outputs $deadline)) $receipts)
   (let* (($status (ngq:text $state)) ($value (ngq:option $result True))
          ($failure (ngq:option $error False)) ($artifacts (ngq:option $outputs True))
          ($events (map-atom $receipts $event (ngq:event $event))) ($agent (ngq:agent)))
     (JsonObject ((JsonPair "agent" $agent) (JsonPair "id" $id) (JsonPair "state" $status)
       (JsonPair "result" $value) (JsonPair "error" $failure) (JsonPair "outputs" $artifacts)
       (JsonPair "receipts" (JsonArray $events))))))
(= (ngq:get $id)
   (case (gw:run (InspectOpen $id))
     (((GatewayInspectionV1 SpaceProbeAbsentV1 $events) JsonNull)
      ((GatewayInspectionV1 (SpaceProbeFoundV1 $job $refs) (GatewayEventsV1 $rows $work)) (ngq:job-view $job $rows))
      ($bad (ngq:fault "queue-inspection-not-established")))))
(= (ngq:submit $request $fingerprint $effect)
   (let* (($id (sf:get $request "id" "")) ($payload (json:stringify-python $request))
          ($deadline (sf:get $request "deadline" 0)) ($now (system:wall-time))
          ($operation (ngq:operation))
          ($command (GatewaySubmitV1 $id $fingerprint $payload $effect $deadline $now))
          ($answer (ngq:apply $operation $command True)))
     (case $answer (((GatewayAppliedV1 $value $replay) (ngq:get $id)) ($bad $bad)))))
(= (ngq:claim)
   (let* (($id (ngq:operation)) ($now (system:wall-time)) ($command (GatewayClaimV1 $now))
          ($answer (ngq:apply $id $command False)))
     (case $answer
       (((GatewayAppliedV1 GatewayEmptyV1 False) GatewayNoJobV1)
        ((GatewayAppliedV1 (GatewayClaimedV1 $job) False)
         (case (gw:run (InspectOpen $job))
           (((GatewayInspectionV1 (SpaceProbeFoundV1 $row $refs) $events) (GatewayDispatchJobV1 $row))
            ($bad (ngq:fault "claimed-job-missing")))))
        ($bad $bad)))))
(= (ngq:finish $id $state $result $error $outputs)
   (let* (($value (ngq:encoded-option $result True)) ($failure (ngq:encoded-option $error False))
          ($artifacts (ngq:encoded-option $outputs True)) ($now (system:wall-time))
          ($operation (ngq:operation)) ($command (GatewayFinishV1 $id $state $value $failure $artifacts $now)))
     (ngq:apply $operation $command True)))
(= (ngq:cancel $id)
   (let* (($operation (ngq:operation)) ($now (system:wall-time)) ($command (GatewayCancelV1 $id $now))
          ($answer (ngq:apply $operation $command True)))
     (case $answer (((GatewayAppliedV1 $value $replay) (ngq:get $id)) ($bad $bad)))))
(= (ngq:cancellation-requested? $id)
   (case (gw:run (InspectOpen $id))
     (((GatewayInspectionV1 (SpaceProbeFoundV1
         (GatewayJobV1 $id $_ $_ $_ $_ $_ (GatewayFieldsV1 $_ $_ $_ $cancel $_ $_ $_ $_)) $_) $_)
       (ngq:bool $cancel))
      ($bad (ngq:fault "cancellation observation unavailable")))))
(= (ngq:recover)
   (let* (($operation (ngq:operation)) ($now (system:wall-time)) ($command (GatewayRecoverV1 $now)))
     (ngq:apply $operation $command True)))
