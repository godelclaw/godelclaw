; Trusted tool descriptors stay in fingerprints. Compatibility descriptors for
; the supplied read adapters bind to native handlers, never Python entrypoints.
!(import! &self ./native_queue_cetta.metta)
!(import! &self (library re))
!(import! &self (library math))
!(import! &self (library proc))
!(bind! &ng-name-re (new-state (re:compile "\\A[A-Za-z0-9_.-]{1,100}\\z")))
!(bind! &ng-python-re (new-state (re:compile "\\Apython(?:3(?:\\.[0-9]+)?)?\\z")))
!(bind! &ng-nul-byte (new-state (str:from-python-codepoints (0))))
!(bind! &ng-advertised-cache (new-state GatewayNoAdvertisedCacheV1))
(= (ng:invalid $message) (GatewayProtocolErrorV1 "invalid-request" $message))
(= (ng:name? $name)
   (if (!= (get-type $name) String) False
     (re:is-match (get-state &ng-name-re) $name)))
(= (ng:strings? $items)
   (if (== $items ()) True
     (and (== (get-type (car-atom $items)) String) (ng:strings? (cdr-atom $items)))))
(= (ng:arguments? $items)
   (if (== $items ()) True
     (and (and (== (get-type (car-atom $items)) String)
               (case (str:find (car-atom $items) (get-state &ng-nul-byte))
                 (((TextNotFound $_) True) ($found False)))) (ng:arguments? (cdr-atom $items)))))
(= (ng:keys? $pairs $allowed)
   (if (== $pairs ()) True
     (let (JsonPair $key $_) (car-atom $pairs)
       (and (ng:member? $key $allowed) (ng:keys? (cdr-atom $pairs) $allowed)))))
(= (ng:member? $key $items)
   (if (== $items ()) False
     (if (== $key (car-atom $items)) True (ng:member? $key (cdr-atom $items)))))
(= (ng:object? $value) (case $value (((JsonObject $_) True) ($other False))))
(= (ng:array-strings? $value)
   (case $value (((JsonArray $items) (ng:arguments? $items)) ($bad False))))
(= (ng:finite? $number)
   (if (== (get-type $number) Number) (and (not (math:isnan $number)) (not (math:isinf $number))) False))
(= (ng:finite-json? $value)
   (case $value
     (((JsonObject $pairs) (ng:finite-items? (map-atom $pairs $pair (let (JsonPair $_ $item) $pair $item))))
      ((JsonArray $items) (ng:finite-items? $items))
      ($scalar (if (== (get-type $scalar) Number) (ng:finite? $scalar) True)))))
(= (ng:finite-items? $items)
   (if (== $items ()) True (and (ng:finite-json? (car-atom $items)) (ng:finite-items? (cdr-atom $items)))))
(= (ng:fingerprint $request $tool)
   (let $intent (JsonObject ((JsonPair "id" (sf:get $request "id" JsonNull))
          (JsonPair "tool" (sf:get $request "tool" JsonNull))
          (JsonPair "arguments" (sf:get $request "arguments" JsonNull))
          (JsonPair "input" (sf:get $request "input" JsonNull))))
     (str:sha256 (json:stringify-python-with (JsonObject ((JsonPair "intent" $intent) (JsonPair "tool" $tool)))
                  ((sort-keys True))))))
(= (ng:tool-valid? $name $tool)
   (let* (($effect (sf:get $tool "effect" "")) ($command (sf:get $tool "command" JsonNull))
          ($format (sf:get $tool "result_format" "text")))
     (and (ng:name? $name) (and (or (== $effect "read") (== $effect "write"))
       (and (case $command (((JsonArray $argv) (and (not (== $argv ())) (ng:arguments? $argv))) ($bad False)))
            (or (== $format "text") (== $format "json")))))))
(= (ng:tools-valid? $pairs)
   (if (== $pairs ()) True
     (let (JsonPair $name $tool) (car-atom $pairs)
       (and (ng:tool-valid? $name $tool) (ng:tools-valid? (cdr-atom $pairs))))))
(= (ng:advertise-compute $tools)
   (case $tools (((JsonObject $pairs) (JsonObject (map-atom $pairs $pair
     (let (JsonPair $name $tool) $pair
       (JsonPair $name (JsonObject (ng:advertised-fields $tool ("effect" "description" "input_schema")))))))))))
(= (ng:advertise $tools)
   (case (get-state &ng-advertised-cache)
     (((GatewayAdvertisedCacheV1 $cached-source $cached-view)
       (if (== $cached-source $tools) $cached-view (ng:advertise-compute $tools)))
      ($miss (ng:advertise-compute $tools)))))
(= (ng:advertised-fields $tool $keys)
   (if (== $keys ()) ()
     (let* (($key (car-atom $keys)) ($value (sf:get $tool $key GatewayFieldAbsentV1))
            ($rest (ng:advertised-fields $tool (cdr-atom $keys))))
       (if (== $value GatewayFieldAbsentV1) $rest (cons-atom (JsonPair $key $value) $rest)))))
(= (ng:dispatch $message $config)
   (if (not (ng:object? $message)) (ng:invalid "gateway envelope must be an object")
     (if (or (!= (sf:get $message "version" 0) 1)
             (!= (sf:get $message "agent" "") (sf:get $config "agent" "")))
       (ng:invalid "wrong protocol version or agent")
       (let* (($operation (sf:get $message "operation" "")) ($id (sf:get $message "id" JsonNull))
              ($tools (sf:get $config "tools" (JsonObject ()))))
         (case $operation
           (("tools" (ng:advertise $tools))
            ("status" (if (ng:name? $id) (ngq:get $id) (ng:invalid "invalid request ID")))
            ("cancel" (if (ng:name? $id) (ngq:cancel $id) (ng:invalid "invalid request ID")))
            ("submit" (ng:submit (sf:get $message "request" JsonNull) $tools))
            ($unknown (ng:invalid "unknown gateway operation"))))))))
(= (ng:submit $request $tools)
   (case $request
     (((JsonObject $pairs)
       (let* (($tool (sf:get $tools (sf:get $request "tool" "") GatewayToolAbsentV1))
              ($valid (and (ng:keys? $pairs ("id" "tool" "arguments" "input" "deadline"))
                        (and (ng:name? (sf:get $request "id" JsonNull))
                         (and (ng:array-strings? (sf:get $request "arguments" JsonNull))
                          (and (!= (sf:get $request "input" GatewayFieldAbsentV1) GatewayFieldAbsentV1)
                               (ng:finite? (sf:get $request "deadline" JsonNull))))))))
         (if (not $valid) (ng:invalid "invalid request fields")
           (if (== $tool GatewayToolAbsentV1) (ng:invalid "unknown tool or field")
             (if (and (ng:finite-json? $request) (ng:finite-json? $tool))
               (ngq:submit-with-tool $request (ng:fingerprint $request $tool)
                 (if (== (sf:get $tool "effect" "read") "write") (quote write) (quote read)) $tool)
               (ng:invalid "non-finite request or tool configuration"))))))
      ($bad (ng:invalid "invalid request fields")))))
(= (ng:envelope $agent $result)
   (case $result
     (((GatewayProtocolErrorV1 $code $message)
       (JsonObject ((JsonPair "agent" $agent) (JsonPair "error" (JsonObject
         ((JsonPair "code" $code) (JsonPair "message" $message)))))))
      ((GatewayHostConflictV1 $message)
       (ng:envelope $agent (GatewayProtocolErrorV1 "conflict" $message)))
      ((GatewayHostFaultV1 $message)
       (ng:envelope $agent (GatewayProtocolErrorV1 "unavailable" $message)))
      ($value (JsonObject ((JsonPair "agent" $agent) (JsonPair "value" $value)))))))
(= (ng:legacy-read $command)
   (case $command
     (((JsonArray ($python "-m" "execution_gateway.read_tools" $name))
       (if (and (re:is-match (get-state &ng-python-re) (sf:basename $python))
                (ng:member? $name ("project-status" "vitals" "read-lines" "ls-tree" "grep-files")))
         (GatewayNativeReadV1 $name) GatewayExternalToolV1))
      ($external GatewayExternalToolV1))))
