; Native MCP configuration and explicit JSON-RPC session ownership.
!(import! &self ./line_rpc_cetta.metta)
!(import! &self ./state_file_cetta.metta)
!(import! &self ./request_state_cetta.metta)
!(import! &self ./stream_sse.metta)
!(import! &self ./diagnostic_cetta.metta)
!(import! &self ./progress_receipt_cetta.metta)
!(import! &self ./llm_policy_cetta.metta)
!(import! &self (library proc))
!(import! &self (library re))
(= (mcp:failure $code $detail) (McpFailureV1 $code $detail))
(= (mcp:failed? $value) (case $value (((McpFailureV1 $_ $_) True) ((Error $_ $_) True) ($other False))))
(= (mcp:expand $text)
   (case (re:find (re:pattern "\\$(\\w+|\\{[^}]*\\})") $text)
     ((re:no-match $text)
      ((re:match $start $end $_)
        (let* (($original (str:byte-slice $text $start $end))
               ($name (if (str:starts-with $original "${") (str:byte-slice $original 2 (- (str:byte-length $original) 1))
                          (str:byte-slice $original 1 (str:byte-length $original))))
               ($value (system:getenv-or-default $name $original))
               ($rest (mcp:expand (str:byte-slice $text $end (str:byte-length $text)))))
          (str:join "" ((str:byte-slice $text 0 $start) $value $rest))))
      ($bad (mcp:failure "configuration" "environment expansion failed")))))
(= (mcp:parents $directory $home)
   (let $here (path:join $directory ".mcp.json")
     (if (or (== $directory $home) (== $directory "/")) ($here)
       (cons-atom $here (mcp:parents (path:dirname $directory) $home)))))
(= (mcp:config-paths)
   (let* (($home (system:expanduser "~"))
          ($explicit (system:getenv-or-default "METTACLAW_MCP_CONFIG" (system:getenv-or-default "MCP_CONFIG_PATH" "")))
          ($parents (list:append (mcp:parents (system:getcwd) $home) ((path:join $home ".mcp.json")))))
     (unique-atom (if (== $explicit "") $parents (cons-atom (mcp:expand $explicit) $parents)))))
(= (mcp:configuration) (mcp:read-first (mcp:config-paths)))
(= (mcp:read-first $paths)
   (if (== $paths ()) (mcp:failure "configuration" "no .mcp.json found")
     (let $path (car-atom $paths)
       (if (not (fs:exists $path)) (mcp:read-first (cdr-atom $paths))
         (case (fs:read-text-result $path 0 "raw")
           ((("ok" $text)
             (case (catch (json:parse $text))
               (((JsonObject $pairs)
                 (case (sf:get (JsonObject $pairs) "mcpServers" JsonNull)
                   (((JsonObject $servers) (JsonObject $servers))
                    ($bad (mcp:failure "configuration" "mcpServers must be an object")))))
                ($bad (mcp:failure "configuration" "invalid MCP JSON")))))
            ($bad (mcp:failure "configuration" "MCP configuration is unreadable"))))))))
(= (mcp:server $name)
   (let $servers (mcp:configuration)
     (if (mcp:failed? $servers) $servers
       (case (sf:get $servers $name JsonNull)
         (((JsonObject $pairs) (JsonObject $pairs))
          ($missing (mcp:failure "configuration" (str:concat "unknown MCP server: " $name))))))))
(= (mcp:seconds $spec $key $fallback)
   (let* (($environment (case $key
             (("readTimeoutSeconds" "READTIMEOUTSECONDS")
              ("totalTimeoutSeconds" "TOTALTIMEOUTSECONDS")
              ("connectTimeoutSeconds" "CONNECTTIMEOUTSECONDS")
              ($other "MCP_UNUSED_TIMEOUT"))))
          ($value (sf:get $spec $key (system:getenv-or-default $environment (repr $fallback)))))
     (let $number (lp:python-float $value)
       (case $number
         (((PythonException $_ $_) $fallback)
          ($n (if (== (get-type $n) Number)
                (if (or (math:isnan $n) (math:isinf $n)) $fallback (max 0.1 $n)) $fallback)))))))
(= (mcp:env-defaults $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($value (system:getenv-or-default $name McpEnvMissingV1))
            ($rest (mcp:env-defaults (cdr-atom $names))))
       (if (== $value McpEnvMissingV1) $rest
         (if (str:starts-with $value "()") $rest (cons-atom ($name $value) $rest))))))
(= (mcp:pairs $object)
   (case $object (((JsonObject $pairs) (mcp:expanded-pairs $pairs)) (JsonNull ()) ($bad (mcp:failure "configuration" "headers/env must be an object")))))
(= (mcp:env-without $defaults $extra)
   (let $keys (map-atom $extra $entry (car-atom $entry))
     (filter-atom $defaults $entry (not (erv:contains $keys (car-atom $entry))))))
(= (mcp:expanded-pairs $pairs)
   (if (== $pairs ()) ()
     (let* (((JsonPair $key $value) (car-atom $pairs)) ($text (mcp:expand (erv:str $value)))
            ($rest (mcp:expanded-pairs (cdr-atom $pairs))))
       (cons-atom ($key $text) $rest))))
(= (mcp:arguments $array)
   (case $array
     (((JsonArray $items) (map-atom $items $value (mcp:expand (erv:str $value))))
      ($bad (mcp:failure "configuration" "args must be an array")))))
(= (mcp:open $name)
   (let $spec (mcp:server $name)
     (if (mcp:failed? $spec) $spec
       (let* (($transport (str:lower (str:join "-" (str:split "_" (sf:get $spec "type" "stdio")))))
              ($read (mcp:seconds $spec "readTimeoutSeconds" 30))
              ($seconds (mcp:seconds $spec "totalTimeoutSeconds" (max 60 (+ $read 10))))
              ($deadline (+ (system:monotonic-ns) (* $seconds 1000000000)))
              ($state (new-space))
              ($_ (mcp:set $state "spec" $spec)) ($_ (mcp:set $state "name" $name))
              ($_ (mcp:set $state "transport" $transport)) ($_ (mcp:set $state "deadline" $deadline))
              ($_ (mcp:set $state "read-ms" (math:ceil (* $read 1000)))) ($_ (mcp:set $state "next-id" 0))
              ($_ (mcp:set $state "reply-ready" False)) ($_ (mcp:set $state "reply" none))
              ($_ (mcp:set $state "fragment-owner" none)) ($_ (mcp:set $state "fragment-parts" 0))
              ($_ (mcp:set $state "stderr" "")) ($_ (mcp:set $state "sse" (sse:new)))
              ($_ (mcp:set $state "offset" 0)) ($_ (mcp:set $state "protocol" "2025-11-25"))
              ($_ (progress:phase "mcp-wait" $seconds))
              ($opened (if (== $transport "stdio") (mcp:open-stdio $state)
                         (if (erv:contains ("http" "streamable-http" "sse" "http-sse") $transport)
                           (mcp:open-http $state) (mcp:failure "configuration" "unsupported MCP transport")))))
         (if (mcp:failed? $opened) (let $_ (mcp:close $state) $opened) $state)))))
(= (mcp:get $state $key $default)
   (case (collapse (match $state (McpFieldV1 $key $value) $value))
     ((() $default) (($value) $value) ($bad (Error mcp:state (Fault duplicate-field))))))
(= (mcp:set $state $key $value)
   (let* (($_ (collapse (match $state (McpFieldV1 $key $old)
                         (remove-atom $state (McpFieldV1 $key $old)))))
          ($_ (add-atom $state (McpFieldV1 $key $value))))
     True))
(= (mcp:deadline? $state)
   (>= (system:monotonic-ns) (mcp:get $state "reply-deadline" (mcp:get $state "deadline" 0))))
(= (mcp:open-stdio $state)
   (let* (($spec (mcp:get $state "spec" (JsonObject ())))
          ($command (mcp:expand (sf:get $spec "command" "")))
          ($args (mcp:arguments (sf:get $spec "args" (JsonArray ()))))
          ($extra (mcp:pairs (sf:get $spec "env" JsonNull)))
          ($defaults (mcp:env-defaults ("HOME" "LOGNAME" "PATH" "SHELL" "TERM" "USER")))
          ($cwd (mcp:expand (sf:get $spec "cwd" (system:getcwd)))))
     (if (or (== $command "") (or (mcp:failed? $args) (mcp:failed? $extra))) (mcp:failure "configuration" "invalid stdio server")
       (let $owner (catch (proc:spawn (cons-atom $command $args)
                          ((cwd $cwd) (env (list:append (mcp:env-without $defaults $extra) $extra)) (mode stream) (max-bytes 16777216))))
         (case $owner
           (((Error $_ $_) (mcp:failure "transport" "MCP server launch failed"))
            ((proc:failed $_) (mcp:failure "transport" "MCP server launch failed"))
            ($ready (let $_ (mcp:set $state "process" $ready) True))))))))
(= (mcp:stdio-write $state $message)
   (let* (($owner (mcp:get $state "process" none))
          ($wire (str:concat (turn:json $message) "\n")))
     (case (proc:write $owner $wire)
       (((proc:queued $_) True)
        ($bad (mcp:failure "transport" "MCP request was not queued"))))))
(= (mcp:stdio-pump $state)
   (let* (($owner (mcp:get $state "process" none))
          ($out (proc:read $owner stdout 50))
          ($err (proc:read $owner stderr 0))
          ($_ (case $err
                (((proc:chunk $text) (mcp:set $state "stderr" (str:char-slice $text (max 0 (- (str:char-length $text) 2000)) (str:char-length $text))))
                 ($other True)))))
     (case $out
       (((proc:chunk $bytes) (mcp:stdio-lines $state (str:split "\n" $bytes)))
        (proc:pending True) (proc:eof (mcp:failure "transport" "MCP server closed its output"))
        ($bad (mcp:failure "transport" "MCP stdout read failed"))))))
; Incomplete wire fragments are separate occurrences in an owned space.
; Updating a small handle never copies all previously received bytes.
(= (mcp:keep-fragment $state $bytes)
   (if (== $bytes "") True
     (let* (($prior (mcp:get $state "fragment-owner" none))
            ($owner (if (== $prior none) (new-space) $prior))
            ($index (mcp:get $state "fragment-parts" 0))
            ($_ (add-atom $owner (McpFragmentV1 $index $bytes)))
            ($_ (mcp:set $state "fragment-owner" $owner))
            ($_ (mcp:set $state "fragment-parts" (+ $index 1)))) True)))
(= (mcp:finish-line $state $last)
   (let* (($owner (mcp:get $state "fragment-owner" none))
          ($parts (if (== $owner none) ()
                    (collapse (match $owner (McpFragmentV1 $index $bytes) ($index $bytes)))))
          ($ordered (sort-atom $parts))
          ($chunks (map-atom $ordered $pair (index-atom $pair 1)))
          ($pieces (list:append $chunks ($last))) ($line (str:join "" $pieces))
          ($_ (mcp:set $state "fragment-owner" none)) ($_ (mcp:set $state "fragment-parts" 0))
          ($_ (mcp:set $state "fragment-bytes" 0))) $line))
(= (mcp:stdio-lines $state $lines)
   (let* (($part (car-atom $lines)) ($rest (cdr-atom $lines))
          ($size (+ (mcp:get $state "fragment-bytes" 0) (str:byte-length $part))))
     (if (> $size 16777216) (mcp:failure "resource" "MCP message exceeds wire limit")
       (if (== $rest ())
         (let* (($_ (mcp:keep-fragment $state $part)) ($_ (mcp:set $state "fragment-bytes" $size))) True)
         (let* (($line (mcp:finish-line $state $part))
                ($decoded (if (not (== (str:utf8-error $line) StrUtf8WellFormedV1))
                            (mcp:failure "protocol" "MCP frame contains invalid UTF-8")
                            (if (== (str:trim $line) "") True (mcp:accept-message $state $line)))))
           (if (mcp:failed? $decoded) $decoded (mcp:stdio-lines $state $rest)))))))
(= (mcp:accept-message $state $line)
   (case (catch (json:parse $line))
     (((JsonObject $pairs)
       (let* (($message (JsonObject $pairs)) ($method (sf:get $message "method" JsonNull))
              ($id (sf:get $message "id" McpNoIdV1)))
         (if (not (== (sf:get $message "jsonrpc" "") "2.0"))
           (mcp:failure "protocol" "invalid JSON-RPC version")
           (if (not (== $method JsonNull)) (mcp:unsupported-request $state $id)
             (if (or (not (== $id (mcp:get $state "expected-id" McpNoIdV1)))
                     (mcp:get $state "reply-ready" False)) True
               (let* (($_ (mcp:set $state "reply" $message))
                      ($_ (mcp:set $state "reply-ready" True))) True))))))
      ($bad (mcp:failure "protocol" "invalid JSON-RPC message")))))
(= (mcp:reply-ready? $state) (mcp:get $state "reply-ready" False))
(= (mcp:message $id $method $params)
   (JsonObject (list:append ((JsonPair "jsonrpc" "2.0") (JsonPair "method" $method))
                 (list:append (if (== $id none) () ((JsonPair "id" $id)))
                   (if (== $params none) () ((JsonPair "params" $params)))))))
(= (mcp:send $state $message)
   (if (== (mcp:get $state "transport" "") "stdio") (mcp:stdio-write $state $message)
     (mcp:http-write $state $message)))
(= (mcp:notify $state $method $params) (mcp:send $state (mcp:message none $method $params)))
(= (mcp:call $state $method $params)
   (let* (($id (mcp:get $state "next-id" 0)) ($_ (mcp:set $state "next-id" (+ $id 1)))
          ($_ (mcp:set $state "expected-id" $id)) ($_ (mcp:set $state "reply-ready" False))
          ($_ (mcp:set $state "reply" none))
          ($_ (mcp:set $state "reply-deadline"
                (min (mcp:get $state "deadline" 0) (+ (system:monotonic-ns) (* (mcp:get $state "read-ms" 30000) 1000000)))))
          ($queued (mcp:send $state (mcp:message $id $method $params))))
     (let* (($answer (if (mcp:failed? $queued) $queued (mcp:wait-reply $state $id)))
            ($_ (mcp:release-response $state))
            ($_ (mcp:set $state "reply-deadline" (mcp:get $state "deadline" 0)))) $answer)))
(= (mcp:release-response $state)
   (if (erv:contains ("stdio" "sse" "http-sse") (mcp:get $state "transport" "")) True
     (let* (($stream (mcp:get $state "http" 0))
            ($_ (if (> $stream 0) (io:cancel $stream) True))
            ($_ (mcp:set $state "http" 0)))
       True)))
(= (mcp:wait-reply $state $id)
   (if (mcp:deadline? $state)
     (mcp:failure "incomplete" "MCP request timed out; effects may be uncertain")
     (if (not (mcp:reply-ready? $state))
       (let $pumped (if (== (mcp:get $state "transport" "") "stdio")
                       (mcp:stdio-pump $state) (mcp:http-pump $state))
         (if (mcp:failed? $pumped) $pumped (mcp:wait-reply $state $id)))
       (let* (($message (mcp:get $state "reply" none))
              ($_ (mcp:set $state "reply-ready" False)) ($_ (mcp:set $state "reply" none))
              ($_ (mcp:set $state "expected-id" McpNoIdV1)))
         (if (not (== (sf:get $message "error" JsonNull) JsonNull))
           (mcp:failure "remote" (diagnostic:text
             (sf:get (sf:get $message "error" JsonNull) "message" "MCP request rejected") 400))
           (sf:get $message "result" (mcp:failure "protocol" "MCP reply has no result")))))))
(= (mcp:unsupported-request $state $id)
   (if (== $id McpNoIdV1) True
     (mcp:send $state
       (JsonObject ((JsonPair "jsonrpc" "2.0") (JsonPair "id" $id)
         (JsonPair "error" (JsonObject
           ((JsonPair "code" -32601) (JsonPair "message" "client method not offered")))))))))
(= (mcp:initialize $state)
   (let $reply (mcp:call $state "initialize"
                  (JsonObject ((JsonPair "protocolVersion" "2025-11-25") (JsonPair "capabilities" (JsonObject ()))
                               (JsonPair "clientInfo" (JsonObject ((JsonPair "name" "mcp") (JsonPair "version" "0.1.0")))))))
     (if (mcp:failed? $reply) $reply
       (let $version (sf:get $reply "protocolVersion" "")
         (if (not (erv:contains ("2024-11-05" "2025-03-26" "2025-06-18" "2025-11-25") $version))
           (mcp:failure "protocol" "unsupported MCP protocol version")
           (let* (($_ (mcp:set $state "protocol" $version))
                  ($_ (mcp:set $state "initialized" True))
                  ($notified (mcp:notify $state "notifications/initialized" none)))
             (if (mcp:failed? $notified) $notified True)))))))
(= (mcp:close-process $owner)
   (let* (($_ (proc:close-input $owner))
          ($ended (proc:wait $owner 100))
          ($_ (if (== $ended proc:pending) (proc:cancel $owner) True)))
     (proc:close $owner)))
(= (mcp:close $state)
   (let* (($owner (mcp:get $state "process" none))
          ($_ (if (== $owner none) True (mcp:close-process $owner)))
          ($stream (mcp:get $state "http" 0))
          ($_ (if (> $stream 0) (io:cancel $stream) True))
          ($_ (collapse (match $state $row (remove-atom $state $row))))
          ($_ (progress:phase "mcp-returned")))
     True))
