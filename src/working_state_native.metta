; CeTTa working-state public operations. Every one has the old Python helper's
; single-answer contract; internal native search must not multiply effects.
!(import! &self ./src/working_state_cetta.metta)

(= (working:boot) (once (working-state:working-boot)))
(= (working:boot-str $key $default) (once (working-state:boot-str $key $default)))
(= (working:boot-int $key $default) (once (working-state:boot-int $key $default)))
(= (working:boot-num $key $default) (once (working-state:boot-num $key $default)))
(= (working:save $loops $sleep $results $heartbeat $continuation $banked $await)
   (once (working-state:working-set-save $loops $sleep $results $heartbeat $continuation $banked $await)))
(= (working:rest-schedule $seconds $command) (once (working-state:rest-schedule $seconds $command)))
(= (working:rest-cancel) (once (working-state:rest-cancel)))
(= (working:rest-hold $seconds) (once (working-state:rest-hold $seconds)))
(= (working:rest-release) (once (working-state:rest-release)))
(= (working:rest-until) (once (working-state:rest-until)))
(= (working:rest-holding) (once (working-state:rest-holding)))
(= (working:rest-pending) (once (working-state:rest-pending)))
(= (working:rest-due $timed-out) (once (working-state:rest-due $timed-out)))
(= (working:rest-claim) (once (working-state:rest-claim)))
(= (working:rest-finish) (once (working-state:rest-finish)))
(= (working:wait-seconds $requested $last-heartbeat $interval)
   (once (working-state:wait-seconds $requested $last-heartbeat $interval)))
(= (working:intent-save $why) (once (working-state:intent-save $why)))
(= (working:turn-commit-reset) (once (working-state:turn-commit-reset)))
(= (working:turn-commit-stage $provider $history $activity)
   (once (working-state:turn-commit-stage $provider $history $activity)))
(= (working:turn-commit-ready) (once (working-state:turn-commit-ready)))
