; Python loop_modes' runtime-reached policy state. No cached file contents.
!(import! &self (library str))
!(import! &self (library system))
!(import! &self ./src/mode_values_cetta.metta)
!(import! &self ./src/mode_io_cetta.metta)
!(import! &self ./src/mode_paths_cetta.metta)
!(import! &self ./src/engine_modes_cetta.metta)

(= (loop-mode:names) ("godelclaw" "coding" "iter" "omega"))
(= (loop-mode:description "godelclaw") "event-armed life, renewed by Iter's transformations after each idle boundary")
(= (loop-mode:description "coding") "godelclaw with high reasoning effort")
(= (loop-mode:description "iter") "qualified MeTTa port of the pinned Iter loop with native tool calls")
(= (loop-mode:description "omega") "qualified current Omega native-tool loop with NAL/PLN")
(= (loop-mode:alias $name)
   (case $name (("agent" "godelclaw") ("default" "godelclaw")
     ("generic" "godelclaw") ("claw23" "godelclaw") ("iter-coding" "coding") ($other $other))))
; active_mode returns this text WITHOUT membership validation. Full Python
; lower (not casefold) is necessary for arbitrary JSON names echoed by view.
(= (loop-mode:clean $value)
   (let $text (erv:str (if (erv:truth $value) $value ""))
     (if (mv:failed? $text) $text (str:python-lower (mode-text:strip $text)))))
(= (loop-mode:canonical $value) (loop-mode:alias (loop-mode:clean $value)))
(= (loop-mode:path) (mio:env "METTACLAW_LOOP_MODE_PATH" "memory/loop_mode.json"))
(= (loop-mode:current-result)
   (let $object (mio:load-object (loop-mode:path))
     (if (mv:failed? $object) $object
       (let $name (loop-mode:canonical (erv:get $object "mode" "godelclaw"))
         (if (mv:failed? $name) $name
           (if (mv:contains (loop-mode:names) $name) $name "godelclaw"))))))
(= (loop-mode:current) (mv:raise (loop-mode:current-result)))
(= (loop-mode:process)
   (let $name (loop-mode:canonical (mio:env "METTACLAW_ACTIVE_LOOP_MODE" ""))
     (if (mv:contains (loop-mode:names) $name) $name (loop-mode:current))))
; The actual py-call result is a named atom, not a native String. Policy
; presets in loop_policy match that atom. Keep internal JSON names as text.
(= (loop-mode:process-crossed)
   (let $name (loop-mode:process)
     (if (== (get-type $name) String) (str:string->symbol $name) $name)))
(= (loop-mode:probe $pid)
   (case (catch (system:signal-probe $pid))
     ((True True) ((system:os-error $_ $_) False)
      ((Error $_ $_) (erv:fail OverflowError
        ; CPython 3.12's POSIX LP64 crossing converts to C long before pid_t.
        ; These are integer conversion bounds, NOT errno platform constants.
        (if (or (> $pid 9223372036854775807) (< $pid -9223372036854775808))
          "Python int too large to convert to C long"
          (if (< $pid 0) "signed integer is less than minimum" "signed integer is greater than maximum"))))
      ($other (ErFailure NativeEvaluationError "missing signal-probe outcome" $other)))))
(= (loop-mode:active-object $object)
   (case $object
     (((JsonObject $_)
       (if (not (erv:has $object "pid")) JsonNull
         (let $pid (mv:int (erv:get $object "pid" JsonNull))
           (if (mv:failed? $pid)
             (case $pid (((ErFailure OverflowError $_ $_) $pid) ($other JsonNull)))
             (let $alive (loop-mode:probe $pid)
               (if (mv:failed? $alive) $alive
                 (if (and $alive (erv:has $object "mode"))
                   (loop-mode:canonical (erv:get $object "mode" JsonNull)) JsonNull)))))))
      ($other JsonNull))))
(= (loop-mode:active-result)
   (let $path (mode-path:active-loop)
     (if (mv:failed? $path) (if (mio:os-error? $path) JsonNull $path)
       (let $object (mio:load-object $path)
         (if (mv:failed? $object) $object (loop-mode:active-object $object))))))
(= (loop-mode:active) (mv:raise (loop-mode:active-result)))
(= (loop-mode:view)
   (let $mode (loop-mode:current-result)
     (if (mv:failed? $mode) (mv:raise $mode)
       (let $active (loop-mode:active-result)
         (if (mv:failed? $active) (mv:raise $active)
           (if (and (erv:truth $active) (!= $active $mode))
             (str:join "" ("active mode: " $active "; requested " $mode " — recycling"))
             (str:join "" ((if (erv:truth $active) "active" "selected") " mode: " $mode " — "
               (loop-mode:description $mode)))))))))
(= (loop-mode:list-view)
   (let $active (loop-mode:active-result)
     (if (mv:failed? $active) (mv:raise $active)
       (str:join "\n" (map-atom (loop-mode:names) $name
         (str:join "" ((if (== $name $active) "● " "  ") $name " — " (loop-mode:description $name))))))))
(= (loop-mode:wake)
   (let* (($flag (mio:env "METTACLAW_RECYCLE_REQUEST_PATH" ""))
          ($wake (mio:env "METTACLAW_WAKE_REQUEST_PATH" (mio:join (mio:dirname $flag) "wake.requested"))))
     (mio:write $wake "mode switch\n" ("create" "truncate") 438 False ())))
(= (loop-mode:set $value)
   (let $requested (loop-mode:clean (erv:cross $value))
     (if (mv:failed? $requested) (mv:raise $requested)
       (let $name (loop-mode:alias $requested)
         (if (not (mv:contains (loop-mode:names) $name))
           "mode-set failed: choose one of godelclaw, coding, iter, omega, agent, default, generic, claw23, iter-coding"
           (let $previous (loop-mode:current-result)
             (if (mv:failed? $previous) (mv:raise $previous)
               (if (mio:save-json (loop-mode:path) (JsonObject ((JsonPair "mode" $name))) "loop")
                 (let $woken (if (!= $previous $name)
                   (if (engine-native:recycle) (loop-mode:wake) 1) 1)
                   (if (mv:failed? $woken) (mv:raise $woken)
                     (str:join "" ("mode set to '" $name "'"
                       (if (!= $requested $name) (str:join "" (" (from alias '" $requested "')")) "")
                       "; persists across restarts"))))
                 "mode-set failed: could not persist"))))))))
(= (loop-mode:wait-timed-out $value)
   (let $text (erv:str (erv:cross $value))
     (if (mv:failed? $text) (mv:raise $text)
       (if (str:starts-with $text "rested ") 1 0))))
