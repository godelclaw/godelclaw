; One presentation layer for native CeTTa and SWI-PeTTa file reads.
; Select I/O once at startup, never on the file-read hot path.
!(import! &self ./src/engine_modes.py)
(= (file-io:cetta? $engine)
   (case $engine ((cetta True) ("cetta" True) ($other False))))
!(if (file-io:cetta? (py-call (engine_modes.active_engine)))
     (import! &self ./src/file_io_cetta)
     (import! &self ./src/file_io_python))

(= (read-file $path)
   (file-io:present $path (file-io:read $path 2000000)))
(= (read-file $path $max-bytes)
   (file-io:present $path (file-io:read $path $max-bytes)))

(= (file-io:present $path $result)
   (case $result
     ((("ok" $text)
       (if (== $text "")
           (file-io:join ("READ_OK_EMPTY_FILE: " $path " exists and holds zero bytes"))
           $text))
      (("limit" $limit)
       (let $number (file-io:number $limit)
         (file-io:join ("read failed: " $path " exceeds " $number
                       " bytes — use read-lines for a window, or supply a larger max_bytes (0 means unlimited)"))))
      (("missing" $cwd)
       (file-io:join ("read failed: no such file: " $path " (cwd " $cwd ")")))
      (("directory" $_)
       (let $quoted (repr $path)
         (file-io:join ("read failed: " $path " is a directory — use (ls-tree " $quoted " 1)"))))
      (("denied" $_)
       (file-io:join ("read failed: permission denied: " $path)))
      (("error" $class $detail)
       (file-io:join ("read failed (" $class "): " $detail)))
      ($other $other))))

; Defaults and result presentation are shared across both engines.
(= (file-io:skips) (".git" "__pycache__" "node_modules" "chroma_db" ".venv"))
(= (read-lines $path) (read-lines $path 1 2000))
(= (read-lines $path $start) (read-lines $path $start 2000))
(= (read-lines $path $start $count)
   (case (file-io:lines $path $start $count)
     ((("window" $first $size $more $body $empty)
       (if (== $size 0)
           (if (and $empty (== $first 1))
               (file-io:join ("READ_OK_EMPTY_FILE: " $path " exists and holds zero bytes"))
               (file-io:no-lines $path $first))
           (let* (($last (- (+ $first $size) 1))
                  ($first-text (file-io:number $first))
                  ($last-text (file-io:number $last))
                  ($next-text (file-io:number (+ $last 1)))
                  ($suffix (if $more (file-io:join ("; next start " $next-text)) "; end of file")))
             (file-io:join ($path ": showing " $first-text "-" $last-text $suffix "\n" $body)))))
      (("error" $detail) (file-io:join ("read-lines failed: " $detail)))
      ($other $other))))
(= (file-io:no-lines $path $start)
   (let $number (file-io:number $start)
     (file-io:join ($path ": no lines at or after " $number))))

(= (ls-tree $path) (ls-tree $path 2 1000 0))
(= (ls-tree $path $depth) (ls-tree $path $depth 1000 0))
(= (ls-tree $path $depth $limit) (ls-tree $path $depth $limit 0))
(= (ls-tree $path $depth $limit $offset)
   (let $skips (file-io:skips)
     (case (file-io:tree $path $depth $limit $offset $skips)
       ((("page" $body $more $next)
         (let* (($number (file-io:number $next))
                ($suffix (if $more (file-io:join ("\n[more entries; next offset " $number "]")) "")))
           (file-io:join ($path "\n" $body $suffix))))
        (("not-directory" $_) (file-io:join ("ls-tree failed: not a directory: " $path)))
        ($other $other)))))

(= (grep-files $pattern $path) (grep-files $pattern $path 200 0))
(= (grep-files $pattern $path $limit) (grep-files $pattern $path $limit 0))
(= (grep-files $pattern $path $limit $offset)
   (let $skips (file-io:skips)
     (case (file-io:grep $pattern $path $limit $offset $skips)
       ((("matches" $body $more $next $scanned $errors)
         (let* (($number (file-io:number $next))
                ($files (file-io:number $scanned))
                ($quoted (repr $pattern))
                ($text (if (== $body "")
                   (file-io:join ("no matches in this page for " $quoted " under " $path " (" $files " files scanned)")) $body))
                ($suffix (if $more (file-io:join ("\n[more matches; next offset " $number "]")) ""))
                ($error-text (if (== $errors "") "" (file-io:join ("\n[unreadable files]\n" $errors)))))
           (file-io:join ($text $suffix $error-text))))
        (("error" $detail) (file-io:join ("grep-files failed: " $detail)))
        ($other $other)))))

(= (write-file $path $text) (file-io:write-present "write" (file-io:update $path "write" $text "")))
(= (append-file $path $text) (file-io:write-present "append" (file-io:update $path "append" $text "")))
(= (edit-file $path $old $new) (file-io:write-present "edit" (file-io:update $path "edit" $old $new)))
(= (file-io:write-present $operation $result)
   (case $result
     ((("written" $path $bytes $hash $backup)
       (let* (($number (file-io:number $bytes))
              ($previous (if (== $backup "") "" (file-io:join (" previous=" $backup)))))
         (file-io:join ("WROTE " $path " op=" $operation " bytes=" $number " sha256=" $hash $previous))))
      (("count" $count $path)
       (let $number (file-io:number $count)
         (file-io:join ("edit failed: old-string occurs " $number " times in " $path "; it must occur exactly once"))))
      (("error" $detail) (file-io:join ($operation " failed: " $detail)))
      ($other $other))))
