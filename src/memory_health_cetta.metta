; Read-only backend configuration and a connection-only service probe.
!(import! &self (library fs))
!(import! &self (library json))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self (library space_service))
!(import! &self ./src/effect_receipt_values_cetta.metta)

(= (memory-health:unconfigured) (JsonObject ((JsonPair "mode" "unconfigured"))))
(= (memory-health:field $object $key $fallback)
  (erv:get $object $key $fallback))
(= (memory-health:backend $root)
  (let* (($fallback (str:concat $root "/repos/petta_lib_chromadb/memory_backend.json"))
         ($path (system:getenv-or-default "METTACLAW_MEMORY_BACKEND_CONFIG" $fallback)))
    (case (fs:read-text-result (if (== $path "") $fallback $path) 0 "raw")
      ((("ok" $text)
        (case (if (== (str:utf8-error $text) StrUtf8WellFormedV1) (json:parse-python $text) JsonNull)
          (((JsonObject $pairs)
            (let $object (JsonObject $pairs)
              (JsonObject
                ((JsonPair "mode" (memory-health:field $object "mode" "unconfigured"))
                 (JsonPair "name" (memory-health:field $object "name" JsonNull))
                 (JsonPair "socket" (memory-health:field $object "socket" JsonNull))))))
           ($bad (memory-health:unconfigured)))))
       ($bad (memory-health:unconfigured))))))
(= (memory-health:reachable? $value)
  (let $text (erv:str $value)
    (if (not (== (get-type $text) String)) False
      (let $path (if (str:starts-with $text "/") $text
                    (let $cwd (system:cwd) (str:join "/" ($cwd $text))))
        (case (catch (space:connect $path 2000))
          (((SpaceConnected $owner)
            (case (space:disconnect $owner) ((SpaceDisconnected True) ($bad False))))
           ($bad False)))))))
(= (memory-health:report $root)
  (let* (($configured (memory-health:backend $root))
         ($mode (memory-health:field $configured "mode" "unconfigured")))
    (if (not (== $mode "native"))
      (str:join "" ("memory-health: no native memory is configured (backend " (erv:str $mode) ")"))
      (let* (($name (erv:str (memory-health:field $configured "name" JsonNull)))
             ($reachable (memory-health:reachable? (memory-health:field $configured "socket" JsonNull)))
             ($status (if $reachable "reachable" "UNREACHABLE")))
        (str:join "" ("memory-health: native backend " $name " — service " $status))))))
