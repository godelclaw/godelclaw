!(import! &self ./src/fsops.py)
!(import_prolog_functions_from_file ./src/file_io_python.pl (file_io_python_read file_io_python_lines file_io_python_tree file_io_python_grep file_io_python_update file_io_python_exists))
!(import_prolog_function atomic_list_concat)
!(import_prolog_function swrite)
(= (file-io:read $path $max-bytes)
   (file_io_python_read $path $max-bytes))
(= (file-io:join $parts) (atomic_list_concat $parts ""))
(= (file-io:number $value) (swrite $value))

!(import! &self ./src/file_tools.py)
(= (file-io:lines $path $start $count) (file_io_python_lines $path $start $count))
(= (file-io:tree $path $depth $limit $offset $skips) (file_io_python_tree $path $depth $limit $offset $skips))
(= (file-io:grep $pattern $path $limit $offset $skips) (file_io_python_grep $pattern $path $limit $offset $skips))
(= (file-io:update $path $op $first $second) (file_io_python_update $path $op $first $second ""))
(= (file-io:exists $path) (file_io_python_exists $path))
