!(import! &self (library system))
!(import! &self (library str))
(= (dispatch:env $name $default) (system:getenv-or-default $name $default))
(= (dispatch:length $text) (str:byte-length $text))
(= (dispatch:compare $left $right) (str:compare $left $right))
(= (dispatch:empty? $text) (== (str:byte-length $text) 0))
(= (dispatch:text-equal? $left $right) (== (str:compare $left $right) 0))
(= (first_char $text)
   (if (== (str:char-length $text) 0) "" (str:char-slice $text 0 1)))
