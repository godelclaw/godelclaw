; One collector owns recovery and publication under .collector.lock. Stage new
; projection bytes before admitting publication; a failed source publishes none.
; A durable prepared receipt fixes file identities, byte ranges and both cursors.
; Recovery checks the exact appended prefix, then writes only its missing suffix.
; Equal records are occurrences, never deduplicated by their content.
;
; Existing report readers remain best-effort during publication. Use a quiescent
; snapshot for an authoritative multi-file report; this is not reader isolation.
!(import! &self ./state_file_cetta.metta)
!(import! &self (library re))
!(bind! &op-batch (new-state JsonNull))
(= (op:names) ("samples.jsonl" "effects.jsonl" "turns.jsonl" "llm.jsonl" "lifecycle.jsonl"))
(= (op:receipt $root) (path:join $root ".observation-publication.json"))
(= (op:stage $root $id $name) (path:join $root (str:join "" (".observation-" $id "-" $name ".stage"))))
(= (op:failure $why) (ObservatoryFailureV1 $why))
(= (op:read $path)
   (case (fs:read-text-result $path 0 "raw")
     ((("ok" $text) $text) (("missing" $_) JsonNull)
      ($bad (op:failure "publication state is unreadable")))))
(= (op:valid-id? $id)
   (and (== (get-type $id) String) (re:is-match (re:compile "^[0-9a-f]{32}$") $id)))
(= (op:begin $root)
   (if (fs:exists (op:receipt $root)) (op:failure "previous publication must be recovered first")
    (let* (($before (op:read (path:join $root "cursor.json"))) ($id (system:uuid4-hex))
          ($receipt (JsonObject ((JsonPair "version" 1) (JsonPair "phase" "collecting")
                     (JsonPair "id" $id) (JsonPair "before" $before)))))
     (if (not (or (== $before JsonNull) (== (get-type $before) String))) $before
       (let $saved (sf:replace (op:receipt $root) (sf:python-json $receipt) 384 True)
         (if (== $saved True) (progn (change-state! &op-batch $receipt) True)
           (op:failure "cannot establish collection receipt")))))))
(= (op:writer-path $root $name)
   (let $batch (get-state &op-batch)
     (if (== $batch JsonNull) (path:join $root $name)
       (op:stage $root (sf:get $batch "id" "") $name))))
(= (op:remove $path)
   (if (not (fs:exists $path)) True
     (if (sf:failed? (fs:remove $path)) (op:failure "publication cleanup refused") True)))
(= (op:remove-stages $root $id $names)
   (if (== $names ()) True
     (let $removed (op:remove (op:stage $root $id (car-atom $names)))
       (if (== $removed True) (op:remove-stages $root $id (cdr-atom $names)) $removed))))
(= (op:cleanup $root $id)
   ; Remove and sync the receipt first. While it exists all staged bytes remain
   ; available to recovery. A crash after this sync can leave only inert stages.
   (let $removed (op:remove (op:receipt $root))
     (if (!= $removed True) $removed
       (let $synced (sf:sync-directory $root)
         (if (!= $synced True) (op:failure "publication cleanup sync refused")
           (let $stages (op:remove-stages $root $id (op:names))
             (if (== $stages True) (progn (change-state! &op-batch JsonNull) True) $stages)))))))
(= (op:file $path)
   (case (fs:metadata $path no-follow)
     (((fs:info regular $bytes (fs:identity $device $inode)) (PublicationFileV1 $bytes $device $inode))
      ($bad (op:failure "publication file identity unavailable")))))
(= (op:hash $path)
   (case (fs:sha256-file $path)
     (((fs:hashed-v1 $digest $_) $digest) ($bad (op:failure "publication stage digest unavailable")))))
(= (op:entries $root $id $names)
   (if (== $names ()) ()
     (let* (($name (car-atom $names)) ($stage (op:stage $root $id $name)))
       (if (not (fs:is-file $stage)) (op:entries $root $id (cdr-atom $names))
         (let* (($file (fs:open-write (path:join $root $name) ("create" "append") 384))
                ($synced (if (sf:failed? $file) $file (fs:sync $file)))
                ($_ (if (sf:failed? $file) True (fs:close $file)))
                ($info (op:file (path:join $root $name))) ($digest (op:hash $stage))
                ($size (fs:size $stage)) ($rest (op:entries $root $id (cdr-atom $names))))
           (if (or (sf:failed? $synced) (or (!= (get-type $digest) String) (!= (get-type $size) Number)))
             (op:failure "cannot prepare projection destinations")
             (case $info
               (((PublicationFileV1 $start $device $inode)
                 (case $rest
                   (((ObservatoryFailureV1 $_) $rest)
                    ($items (cons-atom (JsonObject ((JsonPair "name" $name) (JsonPair "start" $start)
                      (JsonPair "device" $device) (JsonPair "inode" $inode)
                      (JsonPair "bytes" $size) (JsonPair "digest" $digest))) $items)))))
                ($failed $failed)))))))))
(= (op:prepare $root $cursor)
   (let* (($batch (get-state &op-batch)) ($id (sf:get $batch "id" ""))
          ($entries (if (and (op:valid-id? $id) (== (sf:get $batch "phase" "") "collecting"))
                      (op:entries $root $id (op:names)) (op:failure "no owned collection to prepare"))))
     (case $entries
       (((ObservatoryFailureV1 $_) $entries)
        ($items
         (let* (($next (sf:python-json (sf:put $cursor "projection_publication" $id)))
                ($receipt (sf:put-all $batch ((JsonPair "phase" "prepared")
                     (JsonPair "after" $next) (JsonPair "files" (JsonArray $items)))))
                ($synced (sf:sync-directory $root))
                ($saved (if (== $synced True) (sf:replace (op:receipt $root) (sf:python-json $receipt) 384 True) $synced)))
           (if (== $saved True) (progn (change-state! &op-batch $receipt) True)
             (op:failure "cannot prepare durable projection receipt"))))))))
(= (op:prefix $stage $target $start $at $until)
   (if (>= $at $until) True
     (let* (($n (min 65536 (- $until $at)))
            ($wanted (fs:read-chunk $stage $n $at))
            ($actual (fs:read-chunk $target $n (+ $start $at))))
       (case ($wanted $actual)
         ((((fs:chunk $a $_) (fs:chunk $b $_))
           (if (and (== (str:byte-length $a) $n) (== $a $b))
             (op:prefix $stage $target $start (+ $at $n) $until)
             (op:failure "projection prefix conflicts with prepared bytes")))
          ($failed (op:failure "projection prefix is unreadable")))))))
(= (op:copy $stage $target $at $until)
   (if (>= $at $until) True
     (let $n (min 65536 (- $until $at))
       (case (fs:read-chunk $stage $n $at)
         (((fs:chunk $bytes $_)
           (if (!= (str:byte-length $bytes) $n) (op:failure "projection stage is truncated")
             (case (fs:write-all $target $bytes)
               (((fs:written $wrote)
                 (if (== $wrote $n) (op:copy $stage $target (+ $at $n) $until)
                   (op:failure "projection append is incomplete")))
                ($failed (op:failure "projection append refused"))))))
          ($failed (op:failure "projection stage is unreadable")))))))
(= (op:publish-owned $root $entry $stage $target $present $committed)
   (let* (($start (sf:get $entry "start" -1)) ($bytes (sf:get $entry "bytes" -1))
          ($checked (op:prefix $stage $target $start 0 $present)))
     (if (!= $checked True) $checked
       (if (and $committed (!= $present $bytes)) (op:failure "committed projection has changed")
         (let* (($writer (fs:open-write (path:join $root (sf:get $entry "name" "")) ("append") 384))
                ($copied (if (sf:failed? $writer) (op:failure "projection destination refused")
                           (op:copy $stage $writer $present $bytes)))
                ($synced (if (== $copied True) (fs:sync $writer) $copied))
                ($_ (if (sf:failed? $writer) True (fs:close $writer))))
           (if (== $synced fs:synced) True
             (if (== $copied True) (op:failure "projection sync refused") $copied)))))))
(= (op:publish-file $root $id $entry $committed)
   (let* (($name (sf:get $entry "name" "")) ($stage-path (op:stage $root $id $name))
          ($target-path (path:join $root $name)) ($info (op:file $target-path))
          ($start (sf:get $entry "start" -1)) ($bytes (sf:get $entry "bytes" -1)))
     (if (or (!= (get-type $start) Number) (!= (get-type $bytes) Number))
       (op:failure "invalid prepared projection byte range")
      (if (or (< $start 0) (< $bytes 0)) (op:failure "invalid prepared projection byte range")
      (if (not (or (== $name "samples.jsonl") (or (== $name "effects.jsonl")
               (or (== $name "turns.jsonl") (or (== $name "llm.jsonl") (== $name "lifecycle.jsonl"))))))
       (op:failure "unknown projection destination")
       (case $info
         (((PublicationFileV1 $size $device $inode)
           (if (or (!= $device (sf:get $entry "device" JsonNull))
                   (or (!= $inode (sf:get $entry "inode" JsonNull))
                       (or (< $size $start) (> $size (+ $start $bytes)))))
             (op:failure "projection identity or length changed")
             (if (or (!= (fs:size $stage-path) $bytes) (!= (op:hash $stage-path) (sf:get $entry "digest" JsonNull)))
               (op:failure "projection stage changed")
               (let* (($stage (fs:open-read $stage-path)) ($target (fs:open-read $target-path))
                      ($result (op:publish-owned $root $entry $stage $target (- $size $start) $committed))
                      ($_ (fs:close $stage)) ($_ (fs:close $target))) $result))))
          ($failed $failed))))))))
(= (op:publish-files $root $id $entries $committed)
   (if (== $entries ()) True
     (let $result (op:publish-file $root $id (car-atom $entries) $committed)
       (if (== $result True) (op:publish-files $root $id (cdr-atom $entries) $committed) $result))))
(= (op:publish $root $receipt)
   (let* (($current (op:read (path:join $root "cursor.json")))
          ($before (sf:get $receipt "before" JsonNull)) ($after (sf:get $receipt "after" JsonNull))
          ($id (sf:get $receipt "id" "")) ($committed (== $current $after)))
     (if (or (!= (get-type $after) String) (not (or $committed (== $current $before))))
       (op:failure "projection cursor conflicts with prepared transaction")
       (case (sf:get $receipt "files" JsonNull)
         (((JsonArray $entries)
           (let $written (op:publish-files $root $id $entries $committed)
             (if (!= $written True) $written
               (let* (($synced (sf:sync-directory $root))
                      ($saved (if (!= $synced True) $synced
                                (sf:replace (path:join $root "cursor.json") $after 384 True))))
                 (if (== $saved True) (op:cleanup $root $id)
                   (op:failure "projection cursor commit refused"))))))
          ($bad (op:failure "projection receipt has no file ranges")))))))
(= (op:recover $root)
   (let $raw (op:read (op:receipt $root))
     (if (== $raw JsonNull) True
      (if (!= (get-type $raw) String) (op:failure "projection receipt is unreadable")
       (case (json:parse $raw)
         (((JsonObject $fields)
           (let* (($receipt (JsonObject $fields)) ($id (sf:get $receipt "id" "")))
             (if (or (!= (sf:get $receipt "version" 0) 1) (not (op:valid-id? $id)))
               (op:failure "invalid projection receipt")
               (case (sf:get $receipt "phase" "")
                 (("collecting" (op:cleanup $root $id))
                  ("prepared" (op:publish $root $receipt))
                  ($bad (op:failure "unknown projection publication phase")))))))
          ($bad (op:failure "projection receipt is unreadable"))))))))
