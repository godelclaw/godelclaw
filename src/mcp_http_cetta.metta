; MCP HTTP transports share the native HTTP owner and incremental SSE framer.
!(import! &self ./mcp_client_cetta.metta)
(= (mcp:origin $url) (str:join "/" (list:take 3 (str:split "/" $url))))
(= (mcp:endpoint $base $offered)
   (let $url
       (if (str:starts-with $offered "//")
         (str:concat (car-atom (str:split ":" $base)) (str:concat ":" $offered))
         (if (or (str:starts-with $offered "http://") (str:starts-with $offered "https://")) $offered
           (if (str:starts-with $offered "/") (str:concat (mcp:origin $base) $offered)
             (str:concat (str:join "/" (list:take (- (size-atom (str:split "/" $base)) 1) (str:split "/" $base)))
                         (str:concat "/" $offered)))))
     (if (== (str:lower (mcp:origin $url)) (str:lower (mcp:origin $base))) $url
       (mcp:failure "protocol" "MCP endpoint changed origin"))))
(= (mcp:header $headers $name)
   (if (== $headers ()) ""
     (case (car-atom $headers)
       (((http:header $key $value) (if (== (str:lower $key) $name) $value (mcp:header (cdr-atom $headers) $name)))
        ($other (mcp:header (cdr-atom $headers) $name))))))
(= (mcp:http-headers $state)
   (let* (($spec (mcp:get $state "spec" (JsonObject ()))) ($extra (mcp:pairs (sf:get $spec "headers" JsonNull)))
          ($session (mcp:get $state "session" ""))
          ($defaults ((http:header "Accept" "application/json, text/event-stream") (http:header "Content-Type" "application/json")))
          ($with-session (if (== $session "") $defaults (list:append $defaults ((http:header "Mcp-Session-Id" $session)))))
          ($version (if (mcp:get $state "initialized" False)
                        ((http:header "MCP-Protocol-Version" (mcp:get $state "protocol" "2025-11-25"))) ())))
     (if (mcp:failed? $extra) $extra
       (list:append (list:append $with-session $version)
         (map-atom $extra $pair (let ($key $value) $pair (http:header $key $value)))))))
(= (mcp:http-start $state $method $url $body)
   (let* (($headers (mcp:http-headers $state))
          ($remaining (max 1 (math:ceil (/ (- (mcp:get $state "reply-deadline" (mcp:get $state "deadline" 0))
                                             (system:monotonic-ns)) 1000000)))))
     (if (mcp:failed? $headers) $headers
       (case (io:try-submit (http:request $method $url $headers $body $remaining 16777216 False))
         (((io:pending $id) $id)
          ($bad (mcp:failure "transport" "MCP HTTP submission failed")))))))
(= (mcp:http-head $state $id)
   (if (mcp:deadline? $state) (mcp:failure "incomplete" "MCP HTTP response timed out")
     (case (catch (io:http-head $id))
       (((http:head $status $headers) (McpHttpHeadV1 $status $headers))
        ((http:head-waiting)
          (let $_ (io:wait-ready $id 50) (mcp:http-head $state $id)))
        ($bad (mcp:failure "transport" "MCP HTTP response headers unavailable"))))))
(= (mcp:http-exchange $state $method $url $body $left)
   (let $id (mcp:http-start $state $method $url $body)
     (if (mcp:failed? $id) $id
       (case (mcp:http-head $state $id)
         (((McpHttpHeadV1 $status $headers)
           (if (and (> $left 0) (or (erv:contains (307 308) $status)
                  (and (== $method "GET") (erv:contains (301 302 303) $status))))
             (let* (($_ (io:cancel $id))
                    ($next (mcp:endpoint $url (mcp:header $headers "location"))))
               (if (or (mcp:failed? $next) (== $next $url))
                 (mcp:failure "protocol" "invalid or cross-origin MCP redirect")
                 (mcp:http-exchange $state $method $next $body (- $left 1))))
             (McpHttpExchangeV1 $id $status $headers $url)))
          ($bad (let $_ (io:cancel $id) $bad)))))))
(= (mcp:open-http $state)
   (let* (($spec (mcp:get $state "spec" (JsonObject ())))
          ($url (mcp:expand (sf:get $spec "url" "")))
          ($_ (mcp:set $state "url" $url)) ($_ (mcp:set $state "post-url" $url)))
     (if (== $url "") (mcp:failure "configuration" "HTTP MCP server needs url")
       (if (erv:contains ("sse" "http-sse") (mcp:get $state "transport" ""))
         (case (mcp:http-exchange $state "GET" $url "" 5)
           (((McpHttpExchangeV1 $id $status $headers $final-url)
             (if (and (>= $status 200) (< $status 300))
               (let* (($_ (mcp:set $state "url" $final-url)) ($_ (mcp:set $state "http" $id)))
                 (mcp:await-endpoint $state))
               (let $_ (io:cancel $id)
                 (mcp:failure "transport" (str:concat "MCP SSE HTTP " (repr $status))))))
            ($bad $bad)))
         True))))
(= (mcp:await-endpoint $state)
   (if (mcp:get $state "endpoint-ready" False) True
     (if (mcp:deadline? $state) (mcp:failure "incomplete" "MCP SSE endpoint timed out")
       (let $pumped (mcp:http-pump $state)
         (if (mcp:failed? $pumped) $pumped (mcp:await-endpoint $state))))))
(= (mcp:http-write $state $message)
   (let* (($legacy (erv:contains ("sse" "http-sse") (mcp:get $state "transport" "")))
          ($url (mcp:get $state "post-url" ""))
          ($body (turn:json $message))
          ($exchange (mcp:http-exchange $state "POST" $url $body 5)))
     (case $exchange
       (((McpHttpExchangeV1 $id $status $headers $final-url)
         (if (or (< $status 200) (>= $status 300))
           (let $_ (io:cancel $id) (mcp:failure "transport" (str:concat "MCP HTTP " (repr $status))))
           (let* (($session (mcp:header $headers "mcp-session-id"))
                  ($_ (mcp:set $state "post-url" $final-url))
                  ($_ (if (!= $session "") (mcp:set $state "session" $session) True))
                  ($has-id (and (!= (sf:get $message "id" McpNoIdV1) McpNoIdV1)
                                (!= (sf:get $message "method" JsonNull) JsonNull))))
             (if (or $legacy (not $has-id))
               (let $_ (io:cancel $id) True)
               (mcp:http-reply $state $id (str:lower (mcp:header $headers "content-type")))))))
        ($bad $bad)))))
(= (mcp:http-reply $state $id $content-type)
   (if (re:is-match (re:pattern "application/json") $content-type)
     (mcp:json-http-reply $state $id)
     (if (re:is-match (re:pattern "text/event-stream") $content-type)
       (let* (($_ (mcp:set $state "http" $id)) ($_ (mcp:set $state "offset" 0))
              ($_ (mcp:set $state "sse" (sse:new)))) True)
       (let $_ (io:cancel $id) (mcp:failure "protocol" "unsupported MCP response content type")))))
(= (mcp:json-http-reply $state $id)
   (let $answer (rpc:await $id (mcp:get $state "reply-deadline" (mcp:get $state "deadline" 0)))
     (case $answer
       (((http:response $status $body)
         (if (and (>= $status 200) (< $status 300)) (mcp:accept-message $state $body)
           (mcp:failure "transport" (str:concat "MCP HTTP " (repr $status)))))
        ((http:response-with-metadata $status $body $_)
         (if (and (>= $status 200) (< $status 300)) (mcp:accept-message $state $body)
           (mcp:failure "transport" (str:concat "MCP HTTP " (repr $status)))))
        ($bad (mcp:failure "incomplete" "MCP HTTP reply unavailable; effects may be uncertain"))))))
(= (mcp:http-pump $state)
   (let* (($id (mcp:get $state "http" 0))
          ($offset (mcp:get $state "offset" 0))
          ($read (catch (io:http-read $id $offset 65536))))
     (case $read
       (((http:chunk $next $text $status)
         (let $_ (mcp:set $state "offset" $next)
           (case (sse:feed (mcp:get $state "sse" (sse:new)) $text 16777216)
             (((SSEBatch $remaining $events)
               (let* (($_ (mcp:set $state "sse" $remaining))
                      ($queued (mcp:sse-events $state $events)))
                 (if (mcp:failed? $queued) $queued
                   (mcp:after-events $state $id $status))))
              ($bad (mcp:failure "protocol" "invalid MCP SSE frame"))))))
        ($bad (mcp:failure "incomplete" "MCP stream became unavailable"))))))
(= (mcp:after-events $state $id $status)
   (if (mcp:reply-ready? $state) True
     (if (== $status failed) (mcp:failure "incomplete" "MCP stream failed")
       (if (== $status complete) (mcp:failure "transport" "MCP stream ended before its reply")
         (let $_ (io:wait-ready $id 50) True)))))
(= (mcp:sse-events $state $events)
   (if (== $events ()) True
     (let* (((SSEEvent $kind $data) (car-atom $events))
            ($accepted
              (if (== $kind "endpoint")
                (let $endpoint (mcp:endpoint (mcp:get $state "url" "") $data)
                  (if (mcp:failed? $endpoint) $endpoint
                    (let* (($_ (mcp:set $state "post-url" $endpoint)) ($_ (mcp:set $state "endpoint-ready" True))) True)))
                (if (and (or (== $kind "") (== $kind "message")) (!= (str:trim $data) ""))
                  (mcp:accept-message $state $data) True))))
       (if (mcp:failed? $accepted) $accepted (mcp:sse-events $state (cdr-atom $events))))))
