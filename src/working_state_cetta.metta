; Native working-self transitions. Pure state/event/time algebra first; the
; only effects are the existing idempotent ledger transaction, its operator
; projection, and the retained progress observer. Python remains the SWI path.
!(import! &self (library str))
!(import! &self (library json))
!(import! &self (library math))
!(import! &self (library system))
!(import! &self ./src/effect_receipt_values_cetta.metta)
!(import! &self ./src/mode_io_cetta.metta)
!(import! &self ./src/checkpoint_ledger_cetta.metta)
!(import! &self ./src/working_state_host.py)
!(import! &self ./src/progress_receipt_cetta.metta)

!(bind! &working-state-boot (new-state (JsonObject ())))
!(bind! &working-state-turn-commit (new-state WorkingNoCommit))

(= (working-state:path) (system:getenv-or-default "METTACLAW_WORKING_SET_PATH" "./memory/working_set.json"))
(= (working-state:managed?) (== (system:getenv-or-default "METTACLAW_OBSERVED_STRATEGY" "0") "1"))
(= (working-state:failed? $value)
   (case $value (((ErFailure $_ $_ $_) True) ((Error $_ $_) True) ($other False))))
(= (working-state:answer $answers)
   (case $answers ((($value) $value)
     ($other (ErFailure NativeEvaluationError "working-state host call did not return one outcome" $answers)))))
(= (working-state:remove-pairs $pairs $key)
   (if (== $pairs ()) ()
     (let (JsonPair $name $value) (car-atom $pairs)
       (if (== $name $key) (working-state:remove-pairs (cdr-atom $pairs) $key)
         (cons-atom (car-atom $pairs) (working-state:remove-pairs (cdr-atom $pairs) $key))))))
(= (working-state:remove $object $key)
   (let (JsonObject $pairs) $object (JsonObject (working-state:remove-pairs $pairs $key))))
(= (working-state:set-all $object $pairs)
   (if (== $pairs ()) $object
     (let (JsonPair $key $value) (car-atom $pairs)
       (working-state:set-all (erv:put $object $key $value) (cdr-atom $pairs)))))
(= (working-state:bool $value) (if (== $value 0) False True))
(= (working-state:number $value)
   (case $value
     ((True 1.0) (False 0.0)
      ($other (if (== (get-type $other) Number) $other
        (if (== (get-type $other) String)
          (case (json:parse-python $other)
            (($number (if (== (get-type $number) Number) $number
              (erv:fail ValueError "working-state number expected")))))
          (erv:fail TypeError "working-state number expected")))))))
(= (working-state:number-or-zero $value)
   (let $number (working-state:number $value) (if (working-state:failed? $number) 0 $number)))
(= (working-state:float $value)
   (let $number (working-state:number $value)
     (if (working-state:failed? $number) $number
       (case (json:stringify-python $number)
         (("NaN" $number) ("Infinity" $number) ("-Infinity" $number)
          ($text (if (and (== (str:find $text ".") (TextNotFound "."))
                          (== (str:find $text "e") (TextNotFound "e")))
            (json:parse-python (str:concat $text ".0")) $number)))))))
(= (working-state:tail $text)
   (let $length (str:char-length $text)
     (str:char-slice $text (max 0 (- $length 200000)) $length)))
(= (working-state:encoded $object)
   (json:stringify-python-with $object
     ((ensure-ascii False) (sort-keys True) (separators "," ":"))))

; One state snapshot is decoded here. Managed reads never mistake an
; unavailable ledger for an empty state; only its explicit no-checkpoint answer
; falls back to the file projection.
; The mode-I/O defaultable-error predicate may prove the same fallback more
; than once. A working snapshot is one observation, never alternative worlds.
(= (working-state:read-file) (once (mio:load-object (working-state:path))))
(= (working-state:read-ledger $answer)
   (case $answer
     (((0) (working-state:read-file))
      ((1 $text)
       (let $parsed (mio:parse $text)
         (case $parsed (((JsonObject $pairs) $parsed) ($other
           (if (working-state:failed? $parsed) $parsed
             (erv:fail ValueError "native working checkpoint is not an object")))))))
      ($other (ErFailure NativeEvaluationError "invalid native working-set answer" $other)))))
(= (working-state:read)
   (if (working-state:managed?)
     (working-state:read-ledger (checkpoint:read))
     (working-state:read-file)))

; The operator projection follows the native commit. A projection failure after
; commit is not a failed checkpoint; without a commit it remains a failure.
(= (working-state:project $committed $encoded)
   (let $projected (mio:save (working-state:path) (str:concat (working-state:path) ".tmp") $encoded True ())
     (if (== $projected 1) WorkingWritten
       (if $committed WorkingWritten (WorkingFailure projection $projected)))))
(= (working-state:write-encoded $data $encoded $ids $request)
   (if (working-state:managed?)
     (let* (($saved (working-state:number-or-zero (erv:get $data "saved_at" 0)))
            ($committed (checkpoint:write $encoded $ids $request $saved)))
       (if (== $committed True) (working-state:project True $encoded)
         (WorkingFailure checkpoint $committed)))
     (working-state:project False $encoded)))
(= (working-state:write $data $ids $request)
   (let $encoded (working-state:encoded $data)
     (if (working-state:failed? $encoded) (WorkingFailure encoding $encoded)
       (working-state:write-encoded $data $encoded $ids $request))))
(= (working-state:one $outcome)
   (case $outcome ((WorkingWritten 1)
     ((WorkingFailure $kind $detail) (Error working-state ($kind $detail)))
     ($other (Error working-state (invalid-write-outcome $other))))))
(= (working-state:save-flag $outcome) (case $outcome ((WorkingWritten 1) ($other 0))))

; Pure transition algebra: current JSON object + event + one time observation.
(= (working-state:transition $state $event $now)
   (case $event
     (((WorkingSaveV1 $loops $sleep $results $heartbeat $continuation $banked $await)
       (working-state:save-transition $state $loops $sleep $results $heartbeat $continuation $banked $await $now))
      ((WorkingRestScheduleV1 $seconds $command) (working-state:schedule-transition $state $seconds $command $now))
      (WorkingRestCancelV1 (working-state:remove (working-state:remove $state "rest_timer") "rest_until"))
      ((WorkingRestHoldV1 $seconds) (working-state:hold-transition $state $seconds $now))
      (WorkingRestReleaseV1 (working-state:remove $state "rest_until"))
      (WorkingRestClaimV1 (working-state:claim-transition $state))
      ((WorkingIntentV1 $why) (erv:put $state "intent" $why))
      ($other (ErFailure ValueError "unknown working-state event" $other)))))
(= (working-state:save-transition $state $loops $sleep $results $heartbeat $continuation $banked $await $now)
   (let* (($l (erv:int $loops)) ($s (erv:int $sleep)) ($r (erv:str $results))
          ($h (working-state:float $heartbeat)) ($b (erv:int $banked))
          ($failure (erv:first-failure ($l $s $r $h $b))))
     (if (not (== $failure ErNoFailure)) $failure
       (working-state:set-all $state
         ((JsonPair "loops" $l) (JsonPair "sleepInterval" $s)
          (JsonPair "lastresults" (working-state:tail $r)) (JsonPair "last_heartbeat" $h)
          (JsonPair "continuation_pending" (working-state:bool $continuation))
          (JsonPair "banked_loops" (max 0 $b)) (JsonPair "rest_await_input" (working-state:bool $await))
          (JsonPair "saved_at" $now))))))
(= (working-state:schedule-transition $state $seconds $command $now)
   (let $duration (working-state:float $seconds)
     (if (working-state:failed? $duration) $duration
       (erv:put $state "rest_timer"
         (JsonObject ((JsonPair "deadline" (+ $now (max 0 $duration)))
                      (JsonPair "command" (erv:cross $command))
                      (JsonPair "status" "waiting")))))))
(= (working-state:hold-transition $state $seconds $now)
   (let $duration (working-state:float $seconds)
     (if (working-state:failed? $duration) $duration
       (erv:put $state "rest_until" (+ $now (max 0 $duration))))))
(= (working-state:claim-transition $state)
   (case (erv:get $state "rest_timer" ErMissing)
     ((ErMissing $state)
      ((JsonObject $pairs)
       (erv:put $state "rest_timer"
         (erv:put (JsonObject $pairs) "status" "running")))
      ($other $state))))
(= (working-state:apply $event $now)
   (let $state (working-state:read)
     (if (working-state:failed? $state) (WorkingFailure read $state)
       (let $next (working-state:transition $state $event $now)
         (if (working-state:failed? $next) (WorkingFailure transition $next)
           (working-state:write $next () ""))))))
(= (working-state:rest-cancel) (working-state:one (working-state:apply WorkingRestCancelV1 (system:wall-time))))
(= (working-state:rest-hold $seconds) (working-state:one (working-state:apply (WorkingRestHoldV1 $seconds) (system:wall-time))))
(= (working-state:rest-schedule $seconds $command)
   (working-state:one (working-state:apply (WorkingRestScheduleV1 $seconds $command) (system:wall-time))))
(= (working-state:rest-claim) (working-state:one (working-state:apply WorkingRestClaimV1 (system:wall-time))))
(= (working-state:rest-finish) (working-state:rest-cancel))
(= (working-state:rest-release)
   (let $state (working-state:read)
     (if (working-state:failed? $state) (Error working-state (read $state))
       (if (erv:has $state "rest_until") (working-state:one (working-state:apply WorkingRestReleaseV1 (system:wall-time))) 1))))
(= (working-state:intent-save $why)
   (working-state:save-flag (working-state:apply (WorkingIntentV1 $why) (system:wall-time))))

; Pure rest queries share the same state/time snapshot as their caller.
(= (working-state:rest-until-at $state $now)
   (let $until (working-state:number-or-zero (erv:get $state "rest_until" 0))
     (if (> $until $now) $until 0)))
(= (working-state:rest-pending-state $state)
   (case (erv:get $state "rest_timer" ErMissing)
     (((JsonObject $pairs)
       (let $timer (JsonObject $pairs)
         (if (== (erv:get $timer "status" "") "waiting")
           (case (erv:get $timer "command" (JsonArray ()))
             (((JsonArray $items) ("continuation-value" $items))
              ($command ("continuation-value" $command))))
           "no-continuation")))
      ($other "no-continuation"))))
(= (working-state:rest-due-at $state $timed-out $now)
   (case (erv:get $state "rest_timer" ErMissing)
     ((ErMissing (if (== $timed-out 0) 0 1))
      ((JsonObject $pairs)
       (let* (($timer (JsonObject $pairs))
              ($deadline (working-state:number (erv:get $timer "deadline" 0))))
         (if (working-state:failed? $deadline) $deadline
           (if (and (== (erv:get $timer "status" "") "waiting") (>= $now $deadline)) 1 0))))
      ($other (if (== $timed-out 0) 0 1)))))
(= (working-state:rest-query $function)
   (let $state (working-state:read)
     (if (working-state:failed? $state) (Error working-state (read $state)) ($function $state))))
(= (working-state:rest-until)
   (let $now (system:wall-time)
     (working-state:rest-query (|-> ($state) (working-state:rest-until-at $state $now)))))
(= (working-state:rest-holding) (let $until (working-state:rest-until) (if (working-state:failed? $until) $until (if (> $until 0) 1 0))))
(= (working-state:rest-pending) (working-state:rest-query working-state:rest-pending-state))
(= (working-state:rest-due $timed-out)
   (let $now (system:wall-time)
     (working-state:rest-query (|-> ($state) (working-state:rest-due-at $state $timed-out $now)))))
(= (working-state:min $left $right) (if (<= $left $right) $left $right))
(= (working-state:wait-at $state $requested $last-heartbeat $interval $now)
   (let* (($requested-number (working-state:number $requested)) ($heartbeat-number (working-state:number $last-heartbeat))
          ($interval-number (working-state:number $interval))
          ($failure (erv:first-failure ($requested-number $heartbeat-number $interval-number))))
     (if (not (== $failure ErNoFailure)) $failure
       (let* (($first (max 0 $requested-number))
              ($with-heartbeat (if (> $interval-number 0)
                (working-state:min $first (max 0 (- (+ $heartbeat-number $interval-number) $now))) $first))
              ($timer (erv:get $state "rest_timer" (JsonObject ())))
              ($with-timer (if (== (erv:get $timer "status" "") "waiting")
                (let $deadline (working-state:number (erv:get $timer "deadline" 0))
                  (if (working-state:failed? $deadline) $deadline
                    (working-state:min $with-heartbeat (max 0 (- $deadline $now))))) $with-heartbeat))
              ($until (working-state:rest-until-at $state $now)))
         (if (working-state:failed? $with-timer) $with-timer
           (math:ceil (if (> $until 0) (working-state:min $with-timer (- $until $now)) $with-timer)))))))
(= (working-state:wait-seconds $requested $last-heartbeat $interval)
   (let $now (system:wall-time)
     (working-state:rest-query (|-> ($state) (working-state:wait-at $state $requested $last-heartbeat $interval $now)))))

; Successful provider+history stages sample the current delivery/request scope
; once. The staged value is volatile, never a second durable authority.
(= (working-state:turn-commit-reset) (let $_ (change-state! &working-state-turn-commit WorkingNoCommit) 1))
(= (working-state:turn-commit-stage $provider $history $activity)
   (if (and (== $provider 1) (== $history 1))
     (let* (($scope (working-state:answer (collapse (catch (py-call (working_state_host.commit_scope $activity))))))
            ($valid (case $scope ((($ids $request) True) ($other False)))))
       (if $valid
         (let* (($ids (car-atom $scope)) ($request (car-atom (cdr-atom $scope)))
                ($_ (change-state! &working-state-turn-commit (WorkingCommit $ids $request)))) 1)
         (let $_ (change-state! &working-state-turn-commit WorkingNoCommit)
           (Error working-state (invalid-commit-scope $scope)))))
     (working-state:turn-commit-reset)))
(= (working-state:turn-commit-ready)
   (case (get-state &working-state-turn-commit) ((WorkingNoCommit 0) ($other 1))))
(= (working-state:working-set-save $loops $sleep $results $heartbeat $continuation $banked $await)
   (let* (($now (system:wall-time)) ($state (working-state:read)))
     (if (working-state:failed? $state) 0
       (let $next (working-state:transition $state
         (WorkingSaveV1 $loops $sleep $results $heartbeat $continuation $banked $await) $now)
         (if (working-state:failed? $next) 0
           (let* (($scope (get-state &working-state-turn-commit))
                  ($written (case $scope
                    (((WorkingCommit $ids $request) (working-state:write $next $ids $request))
                     ($other (working-state:write $next () ""))))))
             (case $written
               ((WorkingWritten (let $_ (progress:phase "turn-checkpoint") 1))
                ($other 0)))))))))

; Boot is a pure persisted/cache transition followed by at most one persistence
; of intent consumption or interrupted-timer retirement. Running commands are
; reported unknown and removed, never replayed.
(= (working-state:boot-transition $state $now $stamp)
   (if (== $state (JsonObject ())) (WorkingBootV1 $state $state False)
     (let* (($intent (erv:get $state "intent" ErMissing))
            ($has-intent (not (== $intent ErMissing)))
            ($data (working-state:remove $state "intent")) ($cache (working-state:remove $state "intent"))
            ($timer (erv:get $data "rest_timer" (JsonObject ())))
            ($status (erv:get $timer "status" ""))
            ($base (str:concat "CONTINUITY: resumed " $stamp))
            ($with-intent (if (and $has-intent (erv:truth $intent))
              (str:join "" ($base " | WOKE_FROM_REST: " (erv:str $intent))) $base))
            ($marker (if (== $status "running")
              (str:join "" ($with-intent " | SCHEDULED_COMMAND_INTERRUPTED: outcome unknown; not replayed: "
                (erv:repr (erv:get $timer "command" JsonNull)))) $with-intent))
            ($persisted (if (== $status "running") (working-state:remove $data "rest_timer") $data))
            ($held (working-state:rest-until-at $data $now))
            ($cache-timer (if (== $status "waiting")
              (let $deadline (working-state:number (erv:get $timer "deadline" 0))
                (if (working-state:failed? $deadline) $cache
                  (erv:put $cache "sleepInterval" (max 0 (math:ceil (- $deadline $now))))))
              (if (> $held 0) (erv:put $cache "sleepInterval" (math:ceil (- $held $now))) $cache)))
            ($prior (erv:str (erv:get $cache-timer "lastresults" "")))
            ($last (if (erv:truth $prior)
              (str:char-slice (str:join "" ($marker "\n" $prior)) 0 200000) $marker))
            ($final (erv:put $cache-timer "lastresults" $last)))
       (WorkingBootV1 $persisted $final (or $has-intent (== $status "running"))))))
(= (working-state:working-boot)
   (let* (($now (system:wall-time)) ($stamp (system:format-time "%Y-%m-%d %H:%M:%S" $now "local"))
          ($state (working-state:read)))
     (if (working-state:failed? $state) (Error working-state (read $state))
       (let (WorkingBootV1 $persisted $cache $write) (working-state:boot-transition $state $now $stamp)
         (let $outcome (if $write (working-state:write $persisted () "") WorkingWritten)
           (case $outcome
             ((WorkingWritten (let $_ (change-state! &working-state-boot $cache) 1))
              ($other (Error working-state (boot $outcome))))))))))
(= (working-state:boot-value $key) (erv:get (get-state &working-state-boot) $key ErMissing))
(= (working-state:boot-str $key $default)
   (let $value (working-state:boot-value $key) (erv:str (if (== $value ErMissing) $default $value))))
(= (working-state:boot-int $key $default)
   (let* (($value (working-state:boot-value $key))
          ($converted (if (== $value ErMissing) (erv:fail ValueError "missing") (erv:int $value))))
     (if (working-state:failed? $converted)
       (let $fallback (erv:int $default) (if (working-state:failed? $fallback) 0 $fallback)) $converted)))
(= (working-state:boot-num $key $default)
   (let* (($value (working-state:boot-value $key))
          ($converted (if (== $value ErMissing) (erv:fail ValueError "missing") (working-state:float $value))))
     (if (working-state:failed? $converted)
       (let $fallback (working-state:number $default) (if (working-state:failed? $fallback) 0.0 $fallback)) $converted)))
