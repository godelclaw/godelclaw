; Read-only process observations and incremental journal/receipt projections.
; The files retain the longitudinal report schema; message bodies are not kept.
!(import! &self ./memory_monitor_cetta.metta)
!(import! &self ./observatory_publication_cetta.metta)
!(import! &self ./observatory_stream_cetta.metta)
!(import! &self ./observatory_report_cetta.metta)
!(import! &self (library host_io))
!(bind! &obs-options (new-state (JsonObject ())))
!(bind! &obs-cursor (new-state (JsonObject ())))
!(bind! &obs-counts (new-state (JsonObject ())))
!(bind! &obs-write-failed (new-state False))
!(bind! &obs-journal-cursor (new-state ""))
!(bind! &obs-fast-frame-bytes (new-state 262144))
!(bind! &obs-writers (new-space))
(= (obs:option $key $fallback) (sf:get (get-state &obs-options) $key $fallback))
(= (obs:path $name) (path:join (obs:option "--data" "") $name))
(= (obs:read $path)
   (case (fs:read-text-result $path 0 "replace") ((("ok" $text) $text) ($missing ""))))
(= (obs:nth $items $at $fallback) (if (> (size-atom $items) $at) (index-atom $items $at) $fallback))
(= (obs:round1 $n) (str:string->number (str:format-fixed $n 1)))
(= (obs:command $argv)
   (case (proc:run $argv (system:getcwd) inherit 10000 1048576) (((proc:exited 0 $out $_) $out) ($failed ""))))
(= (obs:set-cursor $key $value) (change-state! &obs-cursor (sf:put (get-state &obs-cursor) $key $value)))
(= (obs:writer $name)
   (case (collapse (match &obs-writers (ObservationWriterV1 $name $owner) $owner))
     ((($owner) $owner)
      ($none (let $owner (fs:open-write (op:writer-path (obs:option "--data" "") $name) ("create" "append") 384)
         (if (sf:failed? $owner) $owner
           (progn (add-atom &obs-writers (ObservationWriterV1 $name $owner)) $owner)))))))
(= (obs:close-writers)
   (let $owners (collapse (match &obs-writers (ObservationWriterV1 $name $owner) ($name $owner)))
     (map-atom $owners $entry
       (let* ((($name $owner) $entry) ($synced (fs:sync $owner)) ($c1 (fs:close $owner))
              ($r1 (remove-atom &obs-writers (ObservationWriterV1 $name $owner))))
         (if (sf:failed? $synced) (change-state! &obs-write-failed True) True)))))
(= (obs:append $name $record)
   (let* (($text (str:concat (json:stringify-python-with $record ((ensure-ascii True) (separators "," ":"))) "\n"))
          ($owner (obs:writer $name))
          ($written (if (sf:failed? $owner) $owner (fs:write-all $owner $text))))
     (if (sf:failed? $written)
       (progn (change-state! &obs-write-failed True) (ObservatoryFailureV1 "observation write failed"))
       (progn (change-state! &obs-counts (sf:put (get-state &obs-counts) $name (+ (sf:get (get-state &obs-counts) $name 0) 1))) True))))
(= (obs:match $pattern $text) (re:captures (re:compile $pattern) $text))
(= (obs:group $match $text $number)
   (case (re:group-text $match $text $number) (($value (if (== (get-type $value) String) $value "")))))
(= (obs:matched? $match) (case $match (((re:match $_1 $_2 $_3) True) ($none False))))
(= (obs:number-field $lines $name $fallback)
   (if (== $lines ()) $fallback
     (let $parts (str:split-whitespace (car-atom $lines))
       (if (== (obs:nth $parts 0 "") $name) (cli:number (obs:nth $parts 1 "") $fallback)
         (obs:number-field (cdr-atom $lines) $name $fallback)))))
(= (obs:engine $rows $found)
   (if (== $rows ()) $found
     (let* (($parts (str:split-whitespace (car-atom $rows))) ($name (obs:nth $parts 1 ""))
            ($next (if (or (== $name "cetta") (== $name "swipl"))
                     (ObservedEngineV1 (cli:number (obs:nth $parts 0 "0") 0) $name) $found)))
       (obs:engine (cdr-atom $rows) $next))))
(= (obs:heap $lines $inside)
   (if (== $lines ()) JsonNull
     (let $line (car-atom $lines)
       (if (and $inside (str:starts-with $line "Size:"))
         (math:floor (+ 0.5 (/ (obs:number-field ($line) "Size:" 0) 1024)))
         (obs:heap (cdr-atom $lines)
           (if (str:starts-with $line "Size:") $inside
             (case (str:find $line "-")
               (((TextNotFound $_) $inside) ($header (str:ends-with $line "[heap]"))))))))))
(= (obs:exe $pid)
   (let* (($path (str:join "" ("/proc/" (repr $pid) "/exe")))
          ($resolved (catch (fs:canonical-path $path)))
          ($metadata (fs:metadata-v2 $path follow)))
     (case $metadata
       (((fs:info-v2 regular $_sz (fs:identity $_dev $inode) (fs:modified $mtime $_ns) $_m1 $_m2 $_m3)
         (if (!= (get-type $resolved) String) (JsonNull JsonNull)
           (let* (($key (str:join ":" ($resolved $inode (repr $mtime))))
                  ($cache (sf:get (get-state &obs-cursor) "digests" (JsonObject ())))
                  ($known (sf:get $cache $key JsonNull))
                  ($digest (if (!= $known JsonNull) $known
                    (case (fs:sha256-file $path) (((fs:hashed-v1 $hash $_n) (str:byte-slice $hash 0 16)) ($bad JsonNull)))))
                  ($saved (if (!= $digest JsonNull) (obs:set-cursor "digests" (sf:put $cache $key $digest)) True)))
             ($resolved $digest))))
        ($unavailable (JsonNull JsonNull))))))
(= (obs:process-pairs $pid $name)
   (let* (($base (str:join "" ("/proc/" (repr $pid))))
          ($status (str:split "\n" (obs:read (path:join $base "status"))))
          ($raw-stat (obs:read (path:join $base "stat")))
          ($fields (str:split-whitespace (sf:last (str:split ")" $raw-stat))))
          ($ticks (cli:number (str:trim (obs:command ("getconf" "CLK_TCK"))) 100))
          ($cpu (/ (+ (cli:number (obs:nth $fields 11 "0") 0) (cli:number (obs:nth $fields 12 "0") 0)) $ticks))
          ($up (cli:number (obs:nth (str:split-whitespace (obs:read "/proc/uptime")) 0 "0") 0))
          ($started (- $up (/ (cli:number (obs:nth $fields 19 "0") 0) $ticks)))
          (($exe $digest) (obs:exe $pid))
          ($heap (obs:heap (str:split "\n" (obs:read (path:join $base "smaps"))) False)))
     ((JsonPair "engine" $name) (JsonPair "pid" $pid) (JsonPair "exe" $exe) (JsonPair "exe_sha" $digest)
      (JsonPair "rss_mb" (math:floor (+ 0.5 (/ (obs:number-field $status "VmRSS:" 0) 1024))))
      (JsonPair "swap_mb" (math:floor (+ 0.5 (/ (obs:number-field $status "VmSwap:" 0) 1024))))
      (JsonPair "hwm_mb" (math:floor (+ 0.5 (/ (obs:number-field $status "VmHWM:" 0) 1024))))
      (JsonPair "heap_mb" $heap) (JsonPair "cpu_s" (obs:round1 $cpu))
      (JsonPair "uptime_s" (if (== $fields ()) JsonNull (math:floor (+ $started 0.5)))))))
(= (obs:sample)
   (let* (($unit (obs:option "--unit" ""))
          ($props (mm:properties (obs:command ("systemctl" "--user" "show" $unit "-p" "MainPID" "-p" "InvocationID" "-p" "ActiveState"))))
          ($main (cli:number (sf:get $props "MainPID" "0") 0))
          ($engine (if (> $main 0) (obs:engine (str:split "\n" (obs:command ("ps" "-o" "pid=,comm=" "--ppid" (repr $main)))) NoObservedEngineV1) NoObservedEngineV1))
          ($model-text (obs:read (path:join (obs:option "--root" "") "memory/persistent.metta")))
          ($model-match (re:captures (get-state &obs-re-model) $model-text))
          ($model (if (obs:matched? $model-match) (obs:group $model-match $model-text 1) JsonNull))
          ($health (sf:native-object (path:join (obs:option "--state" "") "cognitive-health.json")))
          ($pstate (obs:option "--persistent-state" ""))
          ($telegram (sf:native-object (path:join $pstate "telegram-health.json")))
          ($quota (sf:native-object (path:join $pstate "provider-observations.json")))
          ($weekly (sf:get (sf:get (sf:get $quota "quota" (JsonObject ())) "value" (JsonObject ())) "weeklyTokenLimit" (JsonObject ())))
          ($mem (str:split "\n" (obs:read "/proc/meminfo")))
          ($total (obs:number-field $mem "MemTotal:" 1)) ($available (obs:number-field $mem "MemAvailable:" 0))
          ($swap-total (obs:number-field $mem "SwapTotal:" 0)) ($swap-free (obs:number-field $mem "SwapFree:" 0))
          ($process (case $engine (((ObservedEngineV1 $pid $name) (obs:process-pairs $pid $name)) ($none ()))))
          ($base ((JsonPair "t" (obs:round1 (system:wall-time))) (JsonPair "state" (sf:get $props "ActiveState" JsonNull))
             (JsonPair "invocation" (str:char-slice (sf:get $props "InvocationID" "") 0 (min 12 (str:char-length (sf:get $props "InvocationID" "")))))
             (JsonPair "model" $model) (JsonPair "provider" (sf:get $health "provider" JsonNull))
             (JsonPair "turns" (JsonObject (map-atom ("started_count" "completed_count" "failed_count" "settled_count") $key (JsonPair $key (sf:get $health $key JsonNull)))))
             (JsonPair "loop" (sf:get $telegram "loop_status" JsonNull)) (JsonPair "waiting_until" (sf:get $telegram "waiting_until" JsonNull))
             (JsonPair "synthetic_pct_left" (sf:get $weekly "percentRemaining" JsonNull))
             (JsonPair "load1" (cli:number (obs:nth (str:split-whitespace (obs:read "/proc/loadavg")) 0 "0") 0))
             (JsonPair "mem_pct" (obs:round1 (* 100 (- 1 (/ $available $total)))))
             (JsonPair "swap_pct" (if (> $swap-total 0) (obs:round1 (* 100 (- 1 (/ $swap-free $swap-total)))) 0))))
          ($row (JsonObject (list:append $base $process))))
     (obs:append "samples.jsonl" $row)))
(= (obs:effect $receipt)
   (let* (($command (sf:get $receipt "command" JsonNull))
          ($head (case $command (((JsonArray $items) (obs:nth $items 0 "")) ($other $command))))
          ($py-match (if (== (get-type $head) String) (re:captures (get-state &obs-re-py-kind) $head) NoRegexMatchV1))
          ($metta-match (if (and (== (get-type $head) String) (not (obs:matched? $py-match)))
                          (re:captures (get-state &obs-re-metta-kind) $head) NoRegexMatchV1))
          ($kind (if (and (== $command JsonNull) (!= (sf:get $receipt "commands" JsonNull) JsonNull)) "batch"
                  (if (obs:matched? $py-match) (obs:group $py-match $head 1)
                    (if (obs:matched? $metta-match) (obs:group $metta-match $head 1)
                      (case $command (((JsonArray $_) $head) ($fallback "other"))))))))
     (obs:append "effects.jsonl" (JsonObject ((JsonPair "t" (obs:round1 (sf:get $receipt "recorded_at" 0)))
       (JsonPair "turn" (sf:get $receipt "turn" JsonNull)) (JsonPair "kind" $kind)
       (JsonPair "disposition" (sf:get $receipt "disposition" JsonNull)) (JsonPair "reason" (sf:get $receipt "reason" JsonNull)))))))
(= (obs:journal-entry-body $entry)
   (let* (($message (sf:get $entry "MESSAGE" JsonNull)) ($comm (sf:get $entry "_COMM" JsonNull))
          ($time (obs:round1 (/ (cli:number (sf:get $entry "__REALTIME_TIMESTAMP" "0") 0) 1000000)))
          ($hits (sf:get $entry "__OBS_MSG_HITS__" JsonNull)))
     (if (!= (get-type $message) String) True
       (if (== (sf:get $entry "SYSLOG_IDENTIFIER" "") "systemd")
         (let $sys-hit (case $hits
                         (((MsgHits $s $_1 $_2 $_3 $_4) $s)
                          ($none (re:is-match (get-state &obs-re-systemd) $message))))
           (if $sys-hit
             (obs:append "lifecycle.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "event" (str:char-slice $message 0 (min 120 (str:char-length $message))))))) True))
         (if (str:starts-with $message "(RESULTS:")
           (obs:append "turns.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "engine" $comm))))
           (obs:journal-provider $entry $message $time $comm $hits))))))
(= (obs:journal-entry $entry)
   (let* (($cursor (sf:get $entry "__CURSOR" ""))
          ($c1 (if (!= $cursor "") (obs:set-cursor "journal_cursor" $cursor) True)))
     (obs:journal-entry-body $entry)))
(= (obs:journal-entry-stream $entry)
   (let* (($cursor (sf:get $entry "__CURSOR" ""))
          ($c1 (if (!= $cursor "") (change-state! &obs-journal-cursor $cursor) True)))
     (obs:journal-entry-body $entry)))
(= (obs:journal-provider-hits (MsgHits $_s $usage $trans $fail $restored) $time $comm)
   (case $usage
     (((UsageHit $prov $tin $cread $cwrite $tout)
       (obs:append "llm.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "engine" $comm)
         (JsonPair "provider" $prov)
         (JsonPair "in" (cli:number $tin 0))
         (JsonPair "cache_read" (cli:number $cread 0))
         (JsonPair "cache_write" (cli:number $cwrite 0))
         (JsonPair "out" (cli:number $tout 0))))))
      ($no-usage
       (if $trans
         (obs:append "llm.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "engine" $comm) (JsonPair "transient" True))))
         (case $fail
           (((FailHit $eng $why)
             (obs:append "lifecycle.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "event" "engine_failed")
               (JsonPair "engine" $eng) (JsonPair "why" (str:char-slice $why 0 (min 80 (str:char-length $why))))))))
            ($no-fail
             (if $restored
               (obs:append "lifecycle.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "event" "engine_restored_petta")))) True)))))))))
(= (obs:journal-provider $entry $message $time $comm $hits)
   (case $hits
     (((MsgHits $s $u $tr $f $r) (obs:journal-provider-hits (MsgHits $s $u $tr $f $r) $time $comm))
      ($direct
       (let $usage (re:captures (get-state &obs-re-usage) $message)
         (if (obs:matched? $usage)
           (obs:append "llm.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "engine" $comm)
             (JsonPair "provider" (obs:group $usage $message 1))
             (JsonPair "in" (cli:number (obs:group $usage $message 2) 0))
             (JsonPair "cache_read" (cli:number (obs:group $usage $message 3) 0))
             (JsonPair "cache_write" (cli:number (obs:group $usage $message 4) 0))
             (JsonPair "out" (cli:number (obs:group $usage $message 5) 0)))))
           (if (oscan:contains? $message "[synthetic_llm] transient")
             (obs:append "llm.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "engine" $comm) (JsonPair "transient" True))))
             (let $failed (re:captures (get-state &obs-re-failed) $message)
               (if (obs:matched? $failed)
                 (let $why (obs:group $failed $message 2)
                   (obs:append "lifecycle.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "event" "engine_failed")
                     (JsonPair "engine" (obs:group $failed $message 1)) (JsonPair "why" (str:char-slice $why 0 (min 80 (str:char-length $why))))))))
                 (if (oscan:contains? $message "restoring stable engine")
                   (obs:append "lifecycle.jsonl" (JsonObject ((JsonPair "t" $time) (JsonPair "event" "engine_restored_petta")))) True))))))))))

; Unrestricted O(1)-memory chunked line framer: lines <= &obs-fast-frame-bytes
; parse directly via json:parse-python; larger lines transition seamlessly into
; oscan:feed so arbitrarily large records never stall collection.
(= (obs:feed-line-part $line-state $seg)
   (if (== (str:byte-length $seg) 0) $line-state
     (case $line-state
       (((ObsLineFast $buf)
         (let $limit (get-state &obs-fast-frame-bytes)
           (if (<= (+ (str:byte-length $buf) (str:byte-length $seg)) $limit)
             (ObsLineFast (str:concat $buf $seg))
             (ObsLineBig (oscan:feed (oscan:feed (oscan:new) $buf) $seg)))))
        ((ObsLineBig $scanner)
         (ObsLineBig (oscan:feed $scanner $seg)))))))

(= (obs:dispatch-record $kind $record)
   (if (== $kind receipts) (obs:effect $record) (obs:journal-entry-stream $record)))

(= (obs:dispatch-line $kind $line-state $strict-eof)
   (case $line-state
     (((ObsLineFast $buf)
       (if (== (str:byte-length $buf) 0) True
         (case (json:parse-python $buf)
           (((JsonObject $pairs) (obs:dispatch-record $kind (JsonObject $pairs)))
            ($bad (if $strict-eof (ObservatoryFailureV1 "incomplete final journal record") True))))))
      ((ObsLineBig $scanner)
       (case (oscan:finish $scanner)
         (((BigJsonOk $record) (obs:dispatch-record $kind $record))
          ($bad (if $strict-eof (ObservatoryFailureV1 "incomplete final journal record") True))))))))

(= (obs:frame-tail $kind $parts)
   (let ($head $rest) ((car-atom $parts) (cdr-atom $parts))
     (if (== $rest ())
       (FrameState (obs:feed-line-part (ObsLineFast "") $head) $head)
       (let* (($line (if (<= (str:byte-length $head) (get-state &obs-fast-frame-bytes))
                       (ObsLineFast $head)
                       (ObsLineBig (oscan:feed (oscan:new) $head))))
              ($res (obs:dispatch-line $kind $line False)))
         (if (== $res True) (obs:frame-tail $kind $rest) $res)))))

(= (obs:frame-parts $kind $line-state $parts)
   (let* (($completed (obs:feed-line-part $line-state (car-atom $parts)))
          ($first (obs:dispatch-line $kind $completed False)))
     (if (== $first True) (obs:frame-tail $kind (cdr-atom $parts)) $first)))

; Retained bounded-buffer line helpers for explicit buffer-refusal unit tests.
(= (obs:lines $input $kind $left)
   (if (<= $left 0) True
     (case (buffer:line $input)
       (((HostLine $line)
         (let $record (json:parse-python $line)
           (progn (case $record (((JsonObject $_) (if (== $kind receipts) (obs:effect $record) (obs:journal-entry $record))) ($bad True)))
                  (obs:lines $input $kind (- $left 1)))))
        (HostPending True)
        ($failed (ObservatoryFailureV1 "observation framing unavailable"))))))
(= (obs:receipts-read $file $input $at $until)
   (if (>= $at $until) $at
     (case (fs:read-chunk $file (min 65536 (- $until $at)) $at)
       (((fs:chunk $bytes $position)
         (if (== (str:byte-length $bytes) 0)
           (progn (change-state! &obs-write-failed True) $at)
           (case (buffer:append $input $bytes)
             (((HostBuffered $_) (progn (obs:lines $input receipts 65536)
                 (obs:receipts-read $file $input (+ $at (str:byte-length $bytes)) $until)))
              ($refused (progn (change-state! &obs-write-failed True) $at))))))
        ($stopped (progn (change-state! &obs-write-failed True) $at))))))

(= (obs:receipts-stream $file $at $until $committed $line-state)
   (if (>= $at $until) (ReceiptsDone $committed)
     (let $want (min 65536 (- $until $at))
       (case (fs:read-chunk $file $want $at)
         (((fs:chunk $bytes $_pos)
           (let $blen (str:byte-length $bytes)
             (if (== $blen 0)
               (progn (change-state! &obs-write-failed True) (ObservatoryFailureV1 "receipts stream ended early"))
               (let* (($next-at (+ $at $want))
                      ($parts (str:split "\n" $bytes)))
                 (if (== (cdr-atom $parts) ())
                   (obs:receipts-stream $file $next-at $until $committed (obs:feed-line-part $line-state $bytes))
                   (case (obs:frame-parts receipts $line-state $parts)
                     (((FrameState $next-line $last-str)
                       (let $next-committed
                         (if (== $last-str "") $next-at
                           (if (== $blen $want) (- $next-at (str:byte-length $last-str)) $committed))
                         (obs:receipts-stream $file $next-at $until $next-committed $next-line)))
                      ($err $err))))))))
          ($stopped (progn (change-state! &obs-write-failed True) (ObservatoryFailureV1 "receipts read failed"))))))))

(= (obs:receipts)
   (let $path (path:join (obs:option "--state" "") "effect-receipts.jsonl")
     (if (not (fs:is-file $path)) True
       (let* (($size (fs:size $path)) ($old (sf:get (get-state &obs-cursor) "receipts_offset" 0))
              ($offset (if (< $size $old) 0 $old)) ($file (fs:open-read $path)))
         (if (sf:failed? $file)
           (progn (change-state! &obs-write-failed True) (ObservatoryFailureV1 "receipts open failed"))
           (let* (($res (obs:receipts-stream $file $offset $size $offset (ObsLineFast "")))
                  ($c1 (fs:close $file)))
             (case $res
               (((ReceiptsDone $committed) (progn (obs:set-cursor "receipts_offset" $committed) True))
                ($err $err)))))))))

(= (obs:journal-pump $process $input)
   (let $derr (proc:read $process stderr 0)
    (case (proc:read $process stdout 100)
     (((proc:chunk $bytes)
       (case (buffer:append $input $bytes)
         (((HostBuffered $_)
           (let $rows (obs:lines $input journal 65536)
             (if (== $rows True) (obs:journal-pump $process $input) $rows)))
          ($refused (ObservatoryFailureV1 "journal frame buffer refused input")))))
      (proc:pending (progn (proc:read $process stderr 0) (obs:journal-pump $process $input)))
      (proc:eof (obs:journal-end $process $input))
      ($failed (ObservatoryFailureV1 "journal observation unavailable"))))))
(= (obs:journal-wait $process)
   (let $derr (proc:read $process stderr 0)
     (case (proc:status $process)
       ((proc:ready True)
        (proc:pending (progn (host:wait () 5) (obs:journal-wait $process)))
        ($failed (ObservatoryFailureV1 "journal process completion unavailable"))))))
(= (obs:journal-end $process $input)
   ; Drain every complete buffered row before interpreting EOF. A valid final
   ; record need not end in a newline; an unfinished record is not completeness.
   (let $rows (obs:lines $input journal 65536)
     (if (!= $rows True) $rows
       (case (buffer:line-ready? $input)
         ((True (obs:journal-end $process $input))
          (False
           (let (HostBufferInfo $size $_) (buffer:info $input)
             (if (== $size 0) (obs:journal-wait $process)
               (case (json:parse-python (buffer:value $input))
                 (((JsonObject $pairs)
                   (progn (obs:journal-entry (JsonObject $pairs)) (buffer:drop $input $size)
                          (obs:journal-wait $process)))
                  ($partial (ObservatoryFailureV1 "incomplete final journal record")))))))
          ($bad (ObservatoryFailureV1 "journal framing readiness unavailable")))))))
(= (obs:journal-owned $process $input $cursor)
   (let* (($ci (proc:close-input $process))
          ($result (obs:journal-pump $process $input))
          ($ended (if (== $result True) (proc:await $process)
                    (progn (proc:cancel $process) $result)))
          ($cp (proc:close $process)) ($ch (host:close $input)))
     (if (!= $result True)
       (progn (obs:set-cursor "journal_cursor" $cursor) $result)
       (case $ended
         (((proc:result (proc:exited 0) $_1 $_2 $_3 $_4) True)
          ($failed (progn (obs:set-cursor "journal_cursor" $cursor)
                         (ObservatoryFailureV1 "journal process did not complete successfully"))))))))

(= (obs:journal-stream-end $process $line-state)
   (let $final (obs:dispatch-line journal $line-state True)
     (if (== $final True) (obs:journal-wait $process) $final)))

(= (obs:journal-stream-pump $process $line-state)
   (let $derr (proc:read $process stderr 0)
     (case (proc:read $process stdout 100)
       (((proc:chunk $bytes)
         (let $parts (str:split "\n" $bytes)
           (if (== (cdr-atom $parts) ())
             (obs:journal-stream-pump $process (obs:feed-line-part $line-state $bytes))
             (case (obs:frame-parts journal $line-state $parts)
               (((FrameState $next-line $_last) (obs:journal-stream-pump $process $next-line))
                ($err $err))))))
        (proc:pending (progn (proc:read $process stderr 0) (obs:journal-stream-pump $process $line-state)))
        (proc:eof (obs:journal-stream-end $process $line-state))
        ($failed (ObservatoryFailureV1 "journal observation unavailable"))))))

(= (obs:journal-stream-owned $process $cursor)
   (let* (($rst (change-state! &obs-journal-cursor ""))
          ($ci (proc:close-input $process))
          ($result (obs:journal-stream-pump $process (ObsLineFast "")))
          ($ended (if (== $result True) (proc:await $process)
                    (progn (proc:cancel $process) $result)))
          ($cp (proc:close $process)))
     (if (!= $result True)
       (progn (obs:set-cursor "journal_cursor" $cursor) $result)
       (case $ended
         (((proc:result (proc:exited 0) $_1 $_2 $_3 $_4)
           (let $next-cur (get-state &obs-journal-cursor)
             (progn (if (!= $next-cur "") (obs:set-cursor "journal_cursor" $next-cur) True) True)))
          ($failed (progn (obs:set-cursor "journal_cursor" $cursor)
                         (ObservatoryFailureV1 "journal process did not complete successfully"))))))))

(= (obs:journal)
   (let* (($cursor (sf:get (get-state &obs-cursor) "journal_cursor" ""))
          ($command (list:append ("journalctl" "--user" "-u" (obs:option "--unit" "") "-o" "json" "--no-pager")
                       (if (== $cursor "") () ("--after-cursor" $cursor))))
          ($process (proc:spawn $command ((mode stream) (max-bytes 262144) (timeout-ms 60000) (lifetime owner)))))
     (obs:journal-stream-owned $process $cursor)))

(= (obs:finish-collection $sample $effects $journal)
   (let* (($closed (obs:close-writers))
          ($complete (and (== $sample True) (and (== $effects True) (== $journal True))))
          ($root (obs:option "--data" ""))
          ($prepared (if (or (not $complete) (get-state &obs-write-failed)) False
                       (op:prepare $root (get-state &obs-cursor))))
          ($saved (if (== $prepared True) (op:publish $root (get-state &op-batch))
                    (if (== (sf:get (get-state &op-batch) "phase" "") "collecting")
                      (progn (op:cleanup $root (sf:get (get-state &op-batch) "id" "")) False) $prepared))))
     (if (== $saved True)
       (progn (system:write stdout (str:concat "native observation sample; rows=" (str:concat (json:stringify-python (get-state &obs-counts)) "\n"))) 0)
       (progn (system:write stderr (str:join "" ("native observation incomplete; "
                 (if (== $prepared True) (op:cursor-outcome $root (get-state &op-batch)) "publication not admitted") "; rows="
                 (json:stringify-python (get-state &obs-counts)) "; sample=" (repr (quote $sample))
                 "; receipts=" (repr (quote $effects)) "; journal=" (repr (quote $journal)) "\n"))) 1))))
(= (obs:collect)
   (let $recovered (op:recover (obs:option "--data" ""))
    (if (!= $recovered True)
      (progn (system:write stderr (str:concat "observation publication unresolved: " (repr (quote $recovered)))) 1)
      (let* (($w1 (change-state! &obs-write-failed False))
          ($c1 (change-state! &obs-counts (JsonObject ())))
          ($cur1 (change-state! &obs-cursor (sf:native-object (obs:path "cursor.json"))))
          ($begun (op:begin (obs:option "--data" ""))))
        (if (!= $begun True)
          (progn (system:write stderr "observation collection could not start\n") 1)
          (let* (($sample (obs:sample)) ($effects (obs:receipts)) ($journal (obs:journal)))
            (obs:finish-collection $sample $effects $journal)))))))
(= (obs:main-report $rest)
   (let $options (cli:pair-args $rest ("--best-effort") (JsonObject ()))
     (case $options
       (((CliFailureV1 $_) 78)
        ($ok
         (let $data (sf:get $ok "--data" "")
           (if (== $data "") 78
             (let* (($days (cli:number (sf:get $ok "--days" "30") 30))
                    ($now-opt (sf:get $ok "--now" ""))
                    ($now (if (== $now-opt "") (system:wall-time) (cli:number $now-opt (system:wall-time))))
                    ($best-effort (sf:get $ok "--best-effort" False)))
               (orep:run $data $days $now $best-effort)))))))))
(= (obs:main-collect $rest)
   (let $options (cli:pair-args $rest () (JsonObject ()))
     (case $options
       (((CliFailureV1 $_) 78)
        ($ok
         (let* (($opt1 (change-state! &obs-options $ok)) ($data (obs:option "--data" "")))
           (if (or (== $data "") (== (obs:option "--unit" "") "")) 78
             (let* (($mk (fs:make-directories $data 448))
                    ($lock (fs:open-write (obs:path ".collector.lock") ("create" "append") 384))
                    ($held (fs:lock $lock exclusive-nowait)))
               (case $held
                 ((fs:locked (let* (($result (obs:collect)) ($cl (fs:close $lock))) $result))
                  ($busy (progn (fs:close $lock) (system:write stderr "observation collector is busy or unavailable\n") 1))))))))))))
(= (obs:main $args)
   (let $argv (cli:strings $args)
     (if (and (!= $argv ()) (== (car-atom $argv) "report"))
       (obs:main-report (cdr-atom $argv))
       (obs:main-collect (if (and (!= $argv ()) (== (car-atom $argv) "collect")) (cdr-atom $argv) $argv)))))
