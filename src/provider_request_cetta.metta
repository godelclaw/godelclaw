(: preq:tag (-> Atom %Undefined%))
(= (preq:tag $value)
   (case $value
     (((JsonObject $pairs) (preq:object (preq:tag-pairs $pairs)))
      ((JsonArray $items) (preq:array (preq:tag-items $items)))
      (JsonNull JsonNull)
      ($scalar (if (== (get-type $scalar) String) (preq:string $scalar)
        (if (== (get-type $scalar) Bool) (preq:bool $scalar)
          (if (== (get-type $scalar) Number)
            (let $text (json:stringify-python $scalar)
              (if (preq:member? $text ("NaN" "Infinity" "-Infinity")) $scalar (preq:number $text)))
            (ProviderPreparationRefusedV1 invalid-json-value))))))))
(= (preq:tag-pairs $pairs)
   (if (== $pairs ()) ()
     (let (JsonPair $name $value) (preq:head $pairs)
       (preq:cons (preq:pair $name (preq:tag $value)) (preq:tag-pairs (preq:tail $pairs))))))
(= (preq:tag-items $items)
   (if (== $items ()) ()
     (let $value (preq:head $items)
       (preq:cons (preq:tag $value) (preq:tag-items (preq:tail $items))))))
(= (preq:parse $text) (let $value (json:parse-python $text) (preq:tag $value)))
(= (preq:render $value)
   (json:stringify-python-with $value ((ensure-ascii False))))
(= (preq:canonical $value)
   (json:stringify-python-with $value ((ensure-ascii False) (sort-keys True) (separators "," ":"))))
(= (preq:has-pair $pairs $key)
   (if (== $pairs ()) False
     (let (JsonPair $name $value) (preq:head $pairs)
       (if (== $name $key) True (preq:has-pair (preq:tail $pairs) $key)))))
(= (preq:has $object $key)
   (case $object (((JsonObject $pairs) (preq:has-pair $pairs $key)) ($other False))))
(= (preq:get $object $key $default)
   (if (preq:has $object $key) (preq:field $object $key) $default))
; Updating a dictionary preserves its first insertion position.
(= (preq:put-pairs $pairs $key $value)
   (if (== $pairs ()) ((preq:pair $key $value))
     (let (JsonPair $name $old) (preq:head $pairs)
       (if (== $name $key) (preq:cons (preq:pair $key $value) (preq:tail $pairs))
         (preq:cons (preq:head $pairs) (preq:put-pairs (preq:tail $pairs) $key $value))))))
(= (preq:put $object $key $value)
   (case ($object $value)
     ((((ProviderPreparationRefusedV1 $why) $ignored) (ProviderPreparationRefusedV1 $why))
      (($ignored (ProviderPreparationRefusedV1 $why)) (ProviderPreparationRefusedV1 $why))
      (((JsonObject $pairs) $valid) (preq:object (preq:put-pairs $pairs $key $valid)))
      ($other (ProviderPreparationRefusedV1 expected-object)))))
(= (preq:drop $object $key)
   (case $object (((JsonObject $pairs) (preq:object (llm:v1:without $pairs $key)))
     ($other (ProviderPreparationRefusedV1 expected-object)))))
(= (preq:merge-pairs $object $pairs)
   (if (== $pairs ()) $object
     (let (JsonPair $name $value) (preq:head $pairs)
       (preq:merge-pairs (preq:put $object $name $value) (preq:tail $pairs)))))
(= (preq:merge $object $overlay)
   (case $overlay (((JsonObject $pairs) (preq:merge-pairs $object $pairs))
     ($other (ProviderPreparationRefusedV1 expected-object)))))
(= (preq:append $left $right) (llm:v1:append $left $right))
(= (preq:reverse $items $reversed)
   (if (== $items ()) $reversed (preq:reverse (preq:tail $items) (preq:cons (preq:head $items) $reversed))))
(= (preq:nonblank $texts)
   (if (== $texts ()) ()
     (let* (($text (preq:head $texts)) ($rest (preq:nonblank (preq:tail $texts))))
       (if (== (str:strip-python $text) "") $rest (preq:cons $text $rest)))))
(= (preq:finish-parts $reversed $user)
   (if (and (== (str:strip-python $user) "") (not (== $reversed ())))
     (ProviderPromptPartsV1 (preq:nonblank (preq:reverse (preq:tail $reversed) ())) (preq:head $reversed))
     (ProviderPromptPartsV1 (preq:nonblank (preq:reverse $reversed ())) $user)))
(= (preq:legacy-parts $text)
   (case (str:find $text ":-:-:-:")
     (((TextNotFound $needle)
       (case (str:find $text " LOOPS_LEFT: ")
         (((TextNotFound $other) (ProviderPromptPartsV1 () $text))
          ($at (if (> $at 0)
            (preq:finish-parts ((str:byte-slice $text 0 $at))
              (str:byte-slice $text $at (str:byte-length $text)))
            (ProviderPromptPartsV1 () $text))))))
      ($at (let* (($system (str:strip-python (str:byte-slice $text 0 $at)))
                  ($user (str:strip-python (str:byte-slice $text (+ $at 7) (str:byte-length $text)))))
             (preq:finish-parts ($system) (if (== $user "") "EMPTY / NO NEW USER INPUT." $user)))))))
(= (preq:split-markers $text $remaining $reversed)
   (if (== $remaining 0) (preq:finish-parts $reversed $text)
     (case (str:find $text "_cache_boundary_")
       (((TextNotFound $needle)
         (if (== $reversed ()) (preq:legacy-parts $text) (preq:finish-parts $reversed $text)))
        ($at (preq:split-markers (str:byte-slice $text (+ $at 16) (str:byte-length $text))
                (- $remaining 1) (preq:cons (str:byte-slice $text 0 $at) $reversed)))))))
(= (preq:split $text) (preq:split-markers $text 3 ()))
(= (preq:strip-chunks $pieces)
   (if (== $pieces ()) ()
     (let* (($piece (preq:head $pieces)) ($tail (preq:strip-chunks (preq:tail $pieces))))
       (if (== (str:strip-python $piece) "") $tail
         (preq:cons (str:strip-python $piece "\n") $tail)))))
(= (preq:chunks $part)
   (case (str:find $part "_cache_chunk_")
     (((TextNotFound $needle) (if (== (str:strip-python $part) "") () ($part)))
      ($at (preq:strip-chunks (str:split "_cache_chunk_" $part))))))
(= (preq:joined $parts)
   (if (== $parts ()) ()
     (preq:cons (str:join "\n\n" (preq:chunks (preq:head $parts))) (preq:joined (preq:tail $parts)))))
(= (preq:response-blocks $parts)
   (if (== $parts ()) ()
     (preq:append (preq:nonblank (str:split "\n_cache_chunk_\n" (preq:head $parts)))
                (preq:response-blocks (preq:tail $parts)))))
(= (preq:boundaries-at $parts $count)
   (if (== $parts ()) ()
     (let $amount (preq:size (preq:chunks (preq:head $parts)))
       (if (== $amount 0) (preq:boundaries-at (preq:tail $parts) $count)
         (preq:cons (preq:number (preq:repr (- (+ $count $amount) 1)))
                    (preq:boundaries-at (preq:tail $parts) (+ $count $amount)))))))
(= (preq:boundaries $parts) (preq:boundaries-at $parts 0))
(= (preq:first-prefix $text $marker)
   (case (str:find $text $marker)
     (((TextNotFound $needle) $text) ($at (str:byte-slice $text 0 $at)))))
(= (preq:cache-key $provider $model $system)
   (let* (($prefix (str:strip-python (preq:first-prefix $system " LAST_SKILL_USE_RESULTS: ")))
          ($hash (str:sha256 $prefix)))
     (str:join ":" ($provider $model (str:byte-slice $hash 0 24)))))

(= (preq:valid-text? $value)
   (case $value
     (((JsonString $text) (== (str:utf8-error $text) StrUtf8WellFormedV1)) ($other False))))
(= (preq:integer? $value)
   (case $value
     (((JsonNumber $text)
       (let $digits (if (str:starts-with $text "-")
                       (str:byte-slice $text 1 (str:byte-length $text)) $text)
         (and (not (== $digits "")) (str:is-all-in digit $digits)))) ($other False))))
(= (preq:integer-items? $items)
   (if (== $items ()) True
     (and (preq:integer? (preq:head $items)) (preq:integer-items? (preq:tail $items)))))
(= (preq:role-message? $message)
   (case $message
     (((JsonObject $pairs)
       (and (== (preq:size $pairs) 2)
         (and (preq:member? (preq:field $message "role")
                ((preq:string "system") (preq:string "developer") (preq:string "user") (preq:string "assistant")))
              (preq:valid-text? (preq:field $message "content"))))) ($other False))))
(= (preq:role-items? $messages)
   (if (== $messages ()) True
     (and (preq:role-message? (preq:head $messages)) (preq:role-items? (preq:tail $messages)))))
(= (preq:frame $text)
   (if (not (str:starts-with $text "{")) LegacyPrompt
     (let $frame (preq:parse $text)
       (if (not (== (preq:field $frame "kind") (preq:string "role-context-v1"))) LegacyPrompt
         (case ((preq:field $frame "messages") (preq:get $frame "cache_points" (preq:array ())))
           ((((JsonArray $messages) (JsonArray $points))
             (if (and (not (== $messages ())) (and (preq:role-items? $messages) (preq:integer-items? $points)))
               (ProviderRoleFrameV1 $messages $points)
               (ProviderPreparationRefusedV1 invalid-role-context)))
            ($other (ProviderPreparationRefusedV1 invalid-role-context))))))))
(= (preq:message $role $content)
   (preq:object ((preq:pair "role" (preq:string $role)) (preq:pair "content" (preq:string $content)))))
(= (preq:system-messages $parts)
   (if (== $parts ()) ()
     (preq:cons (preq:message "system" (preq:head $parts)) (preq:system-messages (preq:tail $parts)))))
(= (preq:all-chunks $parts)
   (if (== $parts ()) ()
     (preq:append (preq:chunks (preq:head $parts)) (preq:all-chunks (preq:tail $parts)))))
(= (preq:message-profile $messages)
   (if (== $messages ()) ()
     (let* (($message (preq:head $messages)) ((JsonString $text) (preq:field $message "content")))
       (preq:cons (preq:object ((preq:pair "role" (preq:field $message "role"))
                              (preq:pair "chars" (preq:number (preq:repr (str:codepoint-count $text))))
                              (preq:pair "digest" (preq:string (str:sha256 $text)))))
                  (preq:message-profile (preq:tail $messages))))))
(= (preq:trusted-texts $messages)
   (if (== $messages ()) ()
     (let* (($message (preq:head $messages)) ($role (preq:field $message "role"))
            ((JsonString $text) (preq:field $message "content"))
            ($tail (preq:trusted-texts (preq:tail $messages))))
       (if (preq:member? $role ((preq:string "system") (preq:string "developer")))
         (preq:cons $text $tail) $tail))))
(= (preq:char-sum $texts)
   (if (== $texts ()) 0 (+ (str:codepoint-count (preq:head $texts)) (preq:char-sum (preq:tail $texts)))))
(= (preq:text-profile $parts)
   (if (== $parts ()) ()
     (let $part (preq:head $parts)
       (preq:cons (preq:object ((preq:pair "chars" (preq:number (preq:repr (str:codepoint-count $part))))
                              (preq:pair "digest" (preq:string (str:sha256 $part)))))
                  (preq:text-profile (preq:tail $parts))))))
(= (preq:observation $prompt $frame)
   (case $frame
     (((ProviderRoleFrameV1 $messages $points)
       (let* (($stable (preq:trusted-texts $messages)) ($prefix (str:join "" $stable))
              ($all (preq:message-profile $messages))
              ($texts (preq:message-texts $messages)))
         (preq:object ((preq:pair "format" (preq:string "role-context-v1"))
           (preq:pair "stable_chars" (preq:number (preq:repr (preq:char-sum $stable))))
           (preq:pair "dynamic_chars" (preq:number (preq:repr (- (preq:char-sum $texts) (preq:char-sum $stable)))))
           (preq:pair "stable_digest" (preq:string (str:sha256 $prefix)))
           (preq:pair "blocks" (preq:array $all))))))
      ($legacy
       (let* (((ProviderPromptPartsV1 $stable $user) (preq:split $prompt)) ($prefix (str:join "" $stable)))
         (preq:object ((preq:pair "stable_chars" (preq:number (preq:repr (str:codepoint-count $prefix))))
           (preq:pair "dynamic_chars" (preq:number (preq:repr (str:codepoint-count $user))))
           (preq:pair "stable_digest" (preq:string (str:sha256 $prefix)))
           (preq:pair "blocks" (preq:array (preq:text-profile $stable))))))))))
(= (preq:message-texts $messages)
   (if (== $messages ()) ()
     (let (JsonString $text) (preq:field (preq:head $messages) "content")
       (preq:cons $text (preq:message-texts (preq:tail $messages))))))
(= (preq:header $model $tokens)
   (preq:object ((preq:pair "model" (preq:string $model)) (preq:pair "max_tokens" (preq:number (preq:repr $tokens))))))
(= (preq:messages $parts $user)
   (let* (($system (preq:system-messages $parts)) ($last (preq:message "user" $user))
          ($messages (preq:append $system (preq:cons $last ()))))
     (preq:array $messages)))
(= (preq:role-request $protocol $model $tokens $messages $ttl)
   (let* (($header (preq:header $model $tokens))
          ($conversation (preq:put $header "messages" (preq:array $messages)))
          ($request (preq:put $conversation "role_policy"
            (preq:string (if (== $protocol "responses") "preserve" "merge-system-developer")))))
     (preq:anthropic-command-options $protocol $request $ttl)))
(= (preq:anthropic-legacy $header $stable $user $ttl)
   (let* (($parts (preq:all-chunks $stable)) ($messages (preq:messages $parts $user))
          ($request (preq:put $header "messages" $messages)))
     (preq:anthropic-command-options "anthropic" $request $ttl)))
(= (preq:responses-legacy $header $model $stable $user)
   (let* (($parts (preq:response-blocks $stable)) ($messages (preq:messages $parts $user))
          ($conversation (preq:put $header "messages" $messages))
          ($request (preq:put $conversation "role_policy" (preq:string "preserve"))))
