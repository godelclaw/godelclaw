; Native deployment probation watcher and lifecycle-authority fence.
; Replaces scripts/runtime_watch.py (the last Python file in runtime-files.json).
; Delegates `memory ...` directly to src/memory_monitor_cetta.metta and runs
; native health observation, rollback-fence verification, and probation tracking
; without invoking Python.
!(import! &self ./memory_monitor_cetta.metta)
!(import! &self ./state_file_cetta.metta)
!(import! &self ./cli_values_cetta.metta)
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self (library proc))
!(import! &self (library list))

!(bind! &rw-re-metta-stop (new-state (re:compile "[;\"\\n]")))
!(bind! &rw-re-str-stop (new-state (re:compile "[\\\\\"\\n]")))
!(bind! &rw-re-paren (new-state (re:compile "[()]")))
!(bind! &rw-re-py-stop (new-state (re:compile "[#'\"\\n]")))
!(bind! &rw-re-py-cmds-a (new-state (re:compile "\\bcmd\\s+in\\s*[\\(\\[\\{][^\\)\\]\\}]*(?:\"/start\"|'/start')[^\\)\\]\\}]*(?:\"/stop\"|'/stop')")))
!(bind! &rw-re-py-cmds-b (new-state (re:compile "\\bcmd\\s+in\\s*[\\(\\[\\{][^\\)\\]\\}]*(?:\"/stop\"|'/stop')[^\\)\\]\\}]*(?:\"/start\"|'/start')")))
!(bind! &rw-re-py-def-cog (new-state (re:compile "(?m)^(?:async\\s+)?def\\s+cognition_enabled\\s*\\(")))
!(bind! &rw-re-py-def-start (new-state (re:compile "(?m)^(?:async\\s+)?def\\s+start\\s*\\(")))
!(bind! &rw-re-py-def-stop (new-state (re:compile "(?m)^(?:async\\s+)?def\\s+stop\\s*\\(")))

(= (rw:contains? $hay $needle)
   (case (str:find $hay $needle) (((TextNotFound $_) False) ($at True))))

(= (rw:spaces $n)
   (if (<= $n 0) ""
     (if (== $n 1) " "
       (let* (($half (math:floor (/ $n 2)))
              ($s (rw:spaces $half)))
         (if (== (% $n 2) 0) (str:concat $s $s) (str:join "" ($s $s " ")))))))

; Blank MeTTa comments (to EOL) and double-quoted string bodies with spaces
; while preserving line breaks and executable S-expression layout.
(= (rw:metta-code-step $src $pos $len $in-str $esc $chunks)
   (if (>= $pos $len) (str:join "" (list:reverse $chunks))
     (if $in-str
       (if $esc
         (let $ch (str:byte-slice $src $pos (+ $pos 1))
           (rw:metta-code-step $src (+ $pos 1) $len True False (cons-atom (if (== $ch "\n") "\n" " ") $chunks)))
         (let $sub (str:byte-slice $src $pos $len)
           (case (re:find (get-state &rw-re-str-stop) $sub)
             (((re:match $rel $_1 $_2)
               (let* (($stop (+ $pos $rel))
                      ($ch (str:byte-slice $src $stop (+ $stop 1)))
                      ($c1 (if (> $rel 0) (cons-atom (rw:spaces $rel) $chunks) $chunks)))
                 (if (== $ch "\n")
                   (rw:metta-code-step $src (+ $stop 1) $len True False (cons-atom "\n" $c1))
                   (if (== $ch "\\")
                     (rw:metta-code-step $src (+ $stop 1) $len True True (cons-atom " " $c1))
                     (rw:metta-code-step $src (+ $stop 1) $len False False (cons-atom " " $c1))))))
              ($none (str:join "" (list:reverse (cons-atom (rw:spaces (- $len $pos)) $chunks))))))))
       (let $sub (str:byte-slice $src $pos $len)
         (case (re:find (get-state &rw-re-metta-stop) $sub)
           (((re:match $rel $_1 $_2)
             (let* (($stop (+ $pos $rel))
                    ($ch (str:byte-slice $src $stop (+ $stop 1)))
                    ($c1 (if (> $rel 0) (cons-atom (str:byte-slice $src $pos $stop) $chunks) $chunks)))
               (if (== $ch "\n")
                 (rw:metta-code-step $src (+ $stop 1) $len False False (cons-atom "\n" $c1))
                 (if (== $ch "\"")
                   (rw:metta-code-step $src (+ $stop 1) $len True False (cons-atom " " $c1))
                   ; Comment ';' runs until next '\n' or EOF.
                   (let $rest (str:byte-slice $src $stop $len)
                     (case (str:find $rest "\n")
                       (((TextNotFound $_nf)
                         (str:join "" (list:reverse (cons-atom (rw:spaces (- $len $stop)) $c1))))
                        ($nl-rel
                         (rw:metta-code-step $src (+ $stop $nl-rel) $len False False
                           (cons-atom (rw:spaces $nl-rel) $c1))))))))))
            ($none (str:join "" (list:reverse (cons-atom $sub $chunks))))))))))

(= (rw:metta-code $source)
   (rw:metta-code-step $source 0 (str:byte-length $source) False False ()))

(= (rw:balance-end $src $pos $len $depth)
   (if (>= $pos $len) -1
     (let $sub (str:byte-slice $src $pos $len)
       (case (re:find (get-state &rw-re-paren) $sub)
         (((re:match $rel $_1 $_2)
           (let* (($at (+ $pos $rel))
                  ($ch (str:byte-slice $src $at (+ $at 1)))
                  ($nd (if (== $ch "(") (+ $depth 1) (- $depth 1))))
             (if (== $nd 0) (+ $at 1)
               (rw:balance-end $src (+ $at 1) $len $nd))))
          ($none -1))))))

(= (rw:replace $text $old $new)
   (str:join $new (str:split $old $text)))

(= (rw:escape-re $name)
   (rw:replace (rw:replace (rw:replace $name "." "\\.") "+" "\\+") "?" "\\?"))

; Extract the single balanced top-level definition (= (<name> ...) ...) so
; adjacent definitions cannot supply a missing gate.
(= (rw:metta-definition $code $name)
   (let* (($pat (re:compile (str:join "" ("(?m)^\\(=\\s+\\(" (rw:escape-re $name) "(?=[\\s)])"))))
          ($m (re:find $pat $code))
          ($cl (re:close $pat)))
     (case $m
       (((re:match $start $_end $_caps)
         (let $finish (rw:balance-end $code $start (str:byte-length $code) 0)
           (if (< $finish 0) JsonNull (str:byte-slice $code $start $finish))))
        ($none JsonNull)))))

(= (rw:metta-calls? $code $def $marker)
   (let $body (rw:metta-definition $code $def)
     (if (== (get-type $body) String)
       (rw:contains? (str:join " " (str:split-whitespace $body)) $marker)
       False)))

(= (rw:native-lifecycle-commands? $source)
   (let $code (rw:metta-code $source)
     (and (rw:metta-calls? $code "tc:answer" "(lifecycle:start)")
          (rw:metta-calls? $code "tc:answer" "(lifecycle:stop)"))))

; Strip Python # comments outside single/double quotes (keeps string literals
; intact so cmd in ("/start", "/stop") matches while commented lines do not).
(= (rw:py-strip-comments-step $src $pos $len $quote $esc $chunks)
   (if (>= $pos $len) (str:join "" (list:reverse $chunks))
     (if (!= $quote "")
       (let $ch (str:byte-slice $src $pos (+ $pos 1))
         (if $esc
           (rw:py-strip-comments-step $src (+ $pos 1) $len $quote False (cons-atom $ch $chunks))
           (if (== $ch "\\")
             (rw:py-strip-comments-step $src (+ $pos 1) $len $quote True (cons-atom $ch $chunks))
             (if (== $ch $quote)
               (rw:py-strip-comments-step $src (+ $pos 1) $len "" False (cons-atom $ch $chunks))
               (rw:py-strip-comments-step $src (+ $pos 1) $len $quote False (cons-atom $ch $chunks))))))
       (let $sub (str:byte-slice $src $pos $len)
         (case (re:find (get-state &rw-re-py-stop) $sub)
           (((re:match $rel $_1 $_2)
             (let* (($stop (+ $pos $rel))
                    ($ch (str:byte-slice $src $stop (+ $stop 1)))
                    ($c1 (if (> $rel 0) (cons-atom (str:byte-slice $src $pos $stop) $chunks) $chunks)))
               (if (== $ch "\n")
                 (rw:py-strip-comments-step $src (+ $stop 1) $len "" False (cons-atom "\n" $c1))
                 (if (or (== $ch "'") (== $ch "\""))
                   (rw:py-strip-comments-step $src (+ $stop 1) $len $ch False (cons-atom $ch $c1))
                   (let $rest (str:byte-slice $src $stop $len)
                     (case (str:find $rest "\n")
                       (((TextNotFound $_nf) (str:join "" (list:reverse $c1)))
                        ($nl-rel (rw:py-strip-comments-step $src (+ $stop $nl-rel) $len "" False $c1)))))))))
            ($none (str:join "" (list:reverse (cons-atom $sub $chunks))))))))))

(= (rw:py-strip-comments $source)
   (rw:py-strip-comments-step $source 0 (str:byte-length $source) "" False ()))

(= (rw:py-lifecycle-commands? $source)
   (let $clean (rw:py-strip-comments $source)
     (or (re:is-match (get-state &rw-re-py-cmds-a) $clean)
         (re:is-match (get-state &rw-re-py-cmds-b) $clean))))

(= (rw:py-lifecycle-defs? $source)
   (let $clean (rw:py-strip-comments $source)
     (and (re:is-match (get-state &rw-re-py-def-cog) $clean)
          (and (re:is-match (get-state &rw-re-py-def-start) $clean)
               (re:is-match (get-state &rw-re-py-def-stop) $clean)))))

; Pure check over a map of revision file texts (allows direct unit testing of
; all legacy and native negative controls without mutating git history).
(= (rw:has-lifecycle-authority-sources $sources)
   (let* (($client (sf:get $sources "channels/telegram.py" JsonNull))
          ($responder (sf:get $sources "channels/telegram_control.metta" JsonNull))
          ($has-cmds (or (and (== (get-type $client) String) (rw:py-lifecycle-commands? $client))
                         (and (== (get-type $responder) String) (rw:native-lifecycle-commands? $responder))))
          ($loop-raw (sf:get $sources "src/loop.metta" JsonNull)))
     (if (or (not $has-cmds) (!= (get-type $loop-raw) String)) False
       (let* (($loop (rw:metta-code $loop-raw))
              ($legacy (sf:get $sources "src/lifecycle.py" JsonNull))
              ($legacy-ok (and (== (get-type $legacy) String)
                               (and (rw:py-lifecycle-defs? $legacy)
                                    (and (rw:metta-calls? $loop "turnCandidate" "(lifecycle.cognition_enabled)")
                                         (rw:metta-calls? $loop "waitCandidate" "(lifecycle.cognition_enabled)"))))))
         (if $legacy-ok True
           (let* (($native-raw (sf:get $sources "src/lifecycle_cetta.metta" JsonNull))
                  ($facade-raw (sf:get $sources "src/mode_state.metta" JsonNull)))
             (if (or (!= (get-type $native-raw) String) (!= (get-type $facade-raw) String)) False
               (let* (($native (rw:metta-code $native-raw))
                      ($facade (str:join " " (str:split-whitespace (rw:metta-code $facade-raw)))))
                 (and (!= (rw:metta-definition $native "lifecycle-native:enabled") JsonNull)
                 (and (!= (rw:metta-definition $native "lifecycle-native:start") JsonNull)
                 (and (!= (rw:metta-definition $native "lifecycle-native:stop") JsonNull)
                 (and (rw:contains? $facade "(= (lifecycle:enabled) (lifecycle-native:enabled))")
                 (and (rw:contains? $facade "(= (lifecycle:start) (lifecycle-native:start))")
                 (and (rw:contains? $facade "(= (lifecycle:stop) (lifecycle-native:stop))")
                 (and (rw:metta-calls? $loop "turnCandidate" "(lifecycle:enabled)")
                      (rw:metta-calls? $loop "waitCandidate" "(lifecycle:enabled)"))))))))))))))))

(= (rw:git-show-files $root $revision $paths $acc)
   (if (== $paths ()) $acc
     (let* (($rel (car-atom $paths))
            ($res (proc:run ("git" "show" (str:join ":" ($revision $rel))) $root inherit 15000 1048576))
            ($val (case $res (((proc:exited 0 $out $_err) $out) ($missing JsonNull)))))
       (rw:git-show-files $root $revision (cdr-atom $paths) (sf:put $acc $rel $val)))))

(= (rw:has-lifecycle-authority $root $revision)
   (if (== $revision "") False
     (let $sources (rw:git-show-files $root $revision
                     ("channels/telegram.py" "channels/telegram_control.metta"
                      "src/lifecycle.py" "src/lifecycle_cetta.metta"
                      "src/loop.metta" "src/mode_state.metta")
                     (JsonObject ()))
       (rw:has-lifecycle-authority-sources $sources))))

(= (rw:run-ok? $argv $cwd)
   (case (proc:run $argv $cwd inherit 30000 65536)
     (((proc:exited 0 $_out $_err) True) ($bad False))))

(= (rw:head $root)
   (case (proc:run ("git" "rev-parse" "HEAD") $root inherit 15000 4096)
     (((proc:exited 0 $out $_err) (RwOk (str:trim $out)))
      ($bad (RwError "head-unreadable")))))

(= (rw:native-health $root $now $health $working $cog)
   (let* (($bin (system:getenv-or-default "CETTA_BIN" (system:executable)))
          ($entry (path:join $root "scripts/runtime_health_cetta.metta"))
          ($env-list (list:append
                       (("METTACLAW_HEALTH_OBSERVED_AT" (repr $now))
                        ("METTACLAW_TELEGRAM_HEALTH_PATH" $health)
                        ("METTACLAW_WORKING_SET_PATH" $working))
                       (if (== $cog "") () (("METTACLAW_COGNITIVE_HEALTH_PATH" $cog)))))
          ($cmd (list:append ("env")
                  (list:append (map-atom $env-list $kv (str:join "=" ((car-atom $kv) (car-atom (cdr-atom $kv)))))
                    ($bin "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" $entry))))
          ($res (proc:run $cmd $root inherit 30000 262144)))
     (case $res
       (((proc:exited 0 $out $_err)
         (case (json:parse-python $out)
           (((JsonObject $pairs)
             (let $obj (JsonObject $pairs)
               (case (sf:get $obj "problems" JsonNull)
                 (((JsonArray $_p) (RwOk $obj))
                  ($bad (RwError "invalid native health observation"))))))
            ($bad-j (RwError "invalid native health observation")))))
        ($bad-p (RwError "native health subprocess failed"))))))

(= (rw:unique-sorted $items)
   (rw:dedup (list:sort $items) RwNone))

(= (rw:dedup $items $prev)
   (if (== $items ()) ()
     (let ($h $t) ((car-atom $items) (cdr-atom $items))
       (if (== $h $prev) (rw:dedup $t $prev)
         (cons-atom $h (rw:dedup $t $h))))))

(= (rw:observe $opts $deployment $now)
   (let* (($root (sf:get $opts "--root" ""))
          ($service (sf:get $opts "--service" ""))
          ($health (sf:get $opts "--health" ""))
          ($working (sf:get $opts "--working-set" ""))
          ($cog (sf:get $opts "--cognitive-health" ""))
          ($canon (sf:get $opts "--canonical-memory" "")))
     (case (rw:native-health $root $now $health $working $cog)
       (((RwOk $facts)
         (let* (($p0 (case (sf:get $facts "problems" (JsonArray ())) (((JsonArray $xs) $xs) ($o ()))))
                ($active (rw:run-ok? ("systemctl" "--user" "is-active" "--quiet" $service) $root))
                ($p1 (if $active $p0 (cons-atom "service-inactive" $p0)))
                (($head $p2) (case (rw:head $root)
                               (((RwOk $h) ($h $p1))
                                ($bad ("unknown" (cons-atom "generation-unreadable" $p1))))))
                ($p3 (if (and (== (sf:get $deployment "status" "") "probation")
                              (!= $head (sf:get $deployment "candidate" "")))
                       (cons-atom "candidate-generation-mismatch" $p2) $p2))
                ($canon-bytes (if (fs:is-file $canon) (fs:size $canon) 0))
                ($baseline (sf:get $deployment "baseline_canonical_bytes" 0))
                ($p4 (if (< $canon-bytes $baseline) (cons-atom "canonical-memory-regressed" $p3) $p3))
                ($probs (rw:unique-sorted $p4)))
           (RwOk (JsonObject ((JsonPair "observed_at" $now)
                              (JsonPair "active" $active)
                              (JsonPair "head" $head)
                              (JsonPair "canonical_memory_bytes" $canon-bytes)
                              (JsonPair "runtime" $facts)
                              (JsonPair "problems" (JsonArray $probs)))))))
        ($err $err)))))

(= (rw:rollback $opts $deployment $observation)
   (let* (($root (sf:get $opts "--root" ""))
          ($service (sf:get $opts "--service" ""))
          ($prev (sf:get $deployment "previous" "")))
     (if (!= (sf:get $observation "head" "") (sf:get $deployment "candidate" ""))
       (False "rollback-refused-generation-mismatch")
       (if (not (rw:has-lifecycle-authority $root $prev))
         (False "rollback-refused-lifecycle-regression")
         (if (or (not (rw:run-ok? ("git" "diff" "--quiet") $root))
                 (not (rw:run-ok? ("git" "diff" "--cached" "--quiet") $root)))
           (False "rollback-refused-dirty-tree")
           (if (not (rw:run-ok? ("systemctl" "--user" "stop" $service) $root))
             (False "rollback-stop-failed")
             (if (not (rw:run-ok? ("git" "switch" "--detach" $prev) $root))
               (let $rs (rw:run-ok? ("systemctl" "--user" "start" $service) $root)
                 (False "rollback-switch-failed"))
               (if (rw:run-ok? ("systemctl" "--user" "start" $service) $root)
                 (True "rolled-back-to-known-good")
                 (False "rollback-start-failed")))))))))

(= (rw:append-line $path $line)
   (let* (($mk (fs:make-directories (path:dirname $path) 448))
          ($fh (fs:open-write $path ("create" "append") 384)))
     (if (sf:failed? $fh) False
       (let* (($w (fs:write-all $fh $line))
              ($c (fs:close $fh)))
         (not (sf:failed? $w))))))

(= (rw:manage-step $opts $deployment $observation $now)
   (let* (($service (sf:get $opts "--service" ""))
          ($root (sf:get $opts "--root" ""))
          ($failures (cli:number (sf:get $opts "--failures" "3") 3))
          ($probs (case (sf:get $observation "problems" (JsonArray ())) (((JsonArray $xs) $xs) ($o ()))))
          ($has-probs (!= $probs ()))
          (($dep1 $action)
            (if $has-probs
              (let* (($consec (+ (sf:get $deployment "consecutive_failures" 0) 1))
                     ($d0 (sf:put $deployment "consecutive_failures" $consec))
                     ($a0 (if (sf:get $observation "active" True) "none"
                            (let $r (rw:run-ok? ("systemctl" "--user" "restart" $service) $root) "service-restarted")))
                     ($in-prob (and (== (sf:get $d0 "status" "") "probation")
                                    (and (< $now (sf:get $d0 "probation_until" 0))
                                         (>= $consec $failures)))))
                (if $in-prob
                  (let ($ok $rb-act) (rw:rollback $opts $d0 $observation)
                    (if $ok
                      ((sf:put-all $d0 ((JsonPair "status" "rolled_back")
                                        (JsonPair "rolled_back_at" $now)
                                        (JsonPair "rollback_problems" (JsonArray $probs))
                                        (JsonPair "consecutive_failures" 0)))
                       $rb-act)
                      ($d0 $rb-act)))
                  (if (>= $consec $failures)
                    (let $r2 (rw:run-ok? ("systemctl" "--user" "restart" $service) $root)
                      ((sf:put $d0 "consecutive_failures" 0) "service-restarted-after-repeated-failure"))
                    ($d0 $a0))))
              (let $d0 (sf:put $deployment "consecutive_failures" 0)
                (if (and (== (sf:get $d0 "status" "") "probation")
                         (>= $now (sf:get $d0 "probation_until" 0)))
                  ((sf:put-all $d0 ((JsonPair "status" "accepted")
                                    (JsonPair "accepted_at" $now)
                                    (JsonPair "last_good" (sf:get $observation "head" ""))))
                   "candidate-accepted")
                  ($d0 "none")))))
          ($dep2 (sf:put-all $dep1 ((JsonPair "last_observation" $observation)
                                    (JsonPair "last_action" $action))))
          ($dep-path (sf:get $opts "--deployment" ""))
          ($mk (fs:make-directories (path:dirname $dep-path) 448))
          ($saved (sf:replace $dep-path (str:concat (json:stringify-python-with $dep2 ((sort-keys True) (indent 2))) "\n") 384 True))
          ($head (sf:get $observation "head" ""))
          ($head12 (str:char-slice $head 0 (min 12 (str:char-length $head))))
          ($iso (system:format-time "%Y-%m-%dT%H:%M:%S+00:00" (math:floor $now) "utc"))
          ($line-obj (JsonObject ((JsonPair "at" $iso)
                                  (JsonPair "state" (if $has-probs "problem" "ok"))
                                  (JsonPair "problems" (JsonArray $probs))
                                  (JsonPair "action" $action)
                                  (JsonPair "head" $head12))))
          ($line-str (str:concat (json:stringify-python-with $line-obj ((sort-keys True))) "\n"))
          ($app (rw:append-line (sf:get $opts "--log" "") $line-str))
          ($out (system:write stdout $line-str)))
     (if $has-probs 1 0)))

(= (rw:manage $opts)
   (let* (($dep-path (sf:get $opts "--deployment" ""))
          ($deployment (sf:native-object $dep-path)))
     (if (case $deployment (((JsonObject ()) True) ($nonempty False)))
       (progn (system:write stderr "deployment state is missing or invalid\n") 1)
       (let* (($now-opt (sf:get $opts "--now" ""))
              ($now (if (== $now-opt "") (system:wall-time) (cli:number $now-opt (system:wall-time)))))
         (case (rw:observe $opts $deployment $now)
           (((RwOk $obs) (rw:manage-step $opts $deployment $obs $now))
            ((RwError $msg) (progn (system:write stderr (str:concat $msg "\n")) 1))))))))

(= (rw:main $args)
   (let $argv (cli:strings $args)
     (if (and (!= $argv ()) (== (car-atom $argv) "memory"))
       (mm:main (cdr-atom $argv))
       (let $opts (cli:pair-args $argv () (JsonObject ()))
         (case $opts
           (((CliFailureV1 $why) (progn (system:write stderr (str:concat $why "\n")) 2))
            ($ok
             (if (or (== (sf:get $ok "--root" "") "")
                 (or (== (sf:get $ok "--service" "") "")
                 (or (== (sf:get $ok "--health" "") "")
                 (or (== (sf:get $ok "--working-set" "") "")
                 (or (== (sf:get $ok "--canonical-memory" "") "")
                 (or (== (sf:get $ok "--deployment" "") "")
                     (== (sf:get $ok "--log" "") "")))))))
               (progn (system:write stderr "runtime_watch: missing required arguments\n") 2)
               (rw:manage $ok)))))))))
