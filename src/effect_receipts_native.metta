!(import! &self ./src/effect_receipts_cetta.metta)
(= (effect-receipts:record-command $turn $disposition $command $result)
   (er:record-occurrence $turn $disposition $command $result JsonNull))
(= (effect-receipts:record-command $turn $disposition $command $result $occurrence)
   (er:record $turn $disposition $command $result $occurrence))
(= (effect-receipts:capture-public-epoch $turn) (er:capture $turn))
(= (effect-receipts:record-suffix $turn $disposition $commands $reason)
   (er:suffix $turn $disposition $commands $reason))
(= (effect-receipts:view) (er:view 18))
(= (effect-receipts:view $limit) (er:view (erv:cross $limit)))
(= (public-worklog:transact $root $action)
   (pw:transact (erv:cross $root) (erv:cross $action) "" JsonNull))
(= (public-worklog:transact $root $action $text)
   (pw:transact (erv:cross $root) (erv:cross $action) (erv:cross $text) JsonNull))
(= (public-worklog:transact $root $action $text $epoch)
   (pw:transact (erv:cross $root) (erv:cross $action) (erv:cross $text) (erv:cross $epoch)))
(= (public-worklog:clean $text) (pw:clean (erv:cross $text)))
