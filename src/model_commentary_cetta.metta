; Terminal provider-output classification. No publication, ledger, transport,
; streaming or command execution lives here. JSON parsing retains/rejects member
; occurrences through llm:v1:parse (JsonUniqueKeysV1), including nested arguments.
!(import! &self (library str))

(: CommentaryPublicationV1 Type)
(: CommentaryDecisionV1 Type)
(: CommentaryPublishV1 (-> String CommentaryPublicationV1))
(: CommentaryNoPublicationV1 CommentaryPublicationV1)
(: CommentaryAcceptedV1 (-> String CommentaryPublicationV1 CommentaryDecisionV1))
(: CommentaryRejectedV1 (-> Symbol CommentaryDecisionV1))
(: invalid-envelope Symbol)
(: invalid-native-tool Symbol)
(: incomplete-output Symbol)
(: refused-or-structured-output Symbol)
(: commentary:classify (-> String CommentaryDecisionV1))
(: commentary:text (-> String CommentaryDecisionV1))
(: commentary:prepare (-> Atom String %Undefined%))

(= (commentary:reject $code) (CommentaryRejectedV1 $code))
(= (commentary:accept $program $publication)
   (CommentaryAcceptedV1 $program $publication))
(= (commentary:zero-mantissa? $text $index $count)
   (if (>= $index $count) True
     (let $head (str:char-slice $text $index (+ $index 1))
       (if (or (== $head "0") (or (== $head ".") (== $head "-")))
         (commentary:zero-mantissa? $text (+ $index 1) $count) False))))
(= (commentary:zero-number? $text)
   (let* (($lower (str:split "e" $text))
          ($mantissa (car-atom (str:split "E" (car-atom $lower)))))
     (commentary:zero-mantissa? $mantissa 0 (str:char-length $mantissa))))
(= (commentary:truth $value)
   (case $value
     ((JsonNull False) ((JsonBool $flag) $flag)
      ((JsonString $text) (not (== $text "")))
      ((JsonArray $items) (not (== $items ())))
      ((JsonObject $pairs) (not (== $pairs ())))
      ((JsonNumber $text) (not (commentary:zero-number? $text)))
      ($other True))))
(= (commentary:field $object $key)
   (case $object
     (((JsonObject $pairs) (llm:v1:get $object $key)) ($other JsonNull))))
(= (commentary:member? $key $keys)
   (if (== $keys ()) False
     (if (== $key (car-atom $keys)) True
       (let $rest (cdr-atom $keys) (commentary:member? $key $rest)))))
(= (commentary:length? $items $count)
   (if (== $count 0) (== $items ())
     (if (== $items ()) False
       (let $rest (cdr-atom $items) (commentary:length? $rest (- $count 1))))))
(= (commentary:allowed-keys? $pairs $keys)
   (if (== $pairs ()) True
     (case (car-atom $pairs)
       (((JsonPair $key $value)
         (if (commentary:member? $key $keys)
           (let $rest (cdr-atom $pairs) (commentary:allowed-keys? $rest $keys)) False))
        ($other False)))))
(= (commentary:exact-object? $value $keys)
   (case $value
     (((JsonObject $pairs)
       (and (commentary:length? $pairs 2)
            (commentary:allowed-keys? $pairs $keys))) ($other False))))
(= (commentary:one-key-object? $value $key)
   (case $value
     (((JsonObject $pairs)
       (and (commentary:length? $pairs 1)
            (commentary:allowed-keys? $pairs ($key)))) ($other False))))

(= (commentary:last $items)
   (let $rest (cdr-atom $items)
     (if (== $rest ()) (car-atom $items) (commentary:last $rest))))
(= (commentary:init $items)
   (let* (($head (car-atom $items)) ($rest (cdr-atom $items)))
     (if (== (cdr-atom $rest) ()) ($head)
       (cons-atom $head (commentary:init $rest)))))
(= (commentary:framed-text $text)
   (let* (($framed (str:trim $text)) ($lines (str:split "\n" $framed))
          ($count-ok (not (or (== $lines ()) (or (== (cdr-atom $lines) ())
                       (== (cdr-atom (cdr-atom $lines)) ()))))))
     (if (not $count-ok) (commentary:reject invalid-envelope)
       (let* (($header (str:lower (str:trim (car-atom $lines))))
              ($footer (str:trim (commentary:last $lines))))
         (if (and (or (== $header "```json") (== $header "```")) (== $footer "```"))
           (let $inner (str:join "\n" (commentary:init (cdr-atom $lines)))
             (if (str:starts-with (str:trim $inner) "{")
               (commentary:envelope $inner) (commentary:reject invalid-envelope)))
           (commentary:reject invalid-envelope))))))
(= (commentary:text $text)
   (let $trimmed (str:trim $text)
     (if (str:starts-with $trimmed "```") (commentary:framed-text $text)
       (if (not (str:starts-with $trimmed "{"))
         (if (str:starts-with $trimmed "(")
           (commentary:accept $text CommentaryNoPublicationV1)
           (commentary:reject invalid-envelope))
         (commentary:envelope $text)))))
(= (commentary:envelope $text)
   (let $value (llm:v1:parse $text)
     (if (commentary:exact-object? $value ("commentary" "commands"))
       (let* (($commentary (commentary:field $value "commentary"))
              ($commands (commentary:field $value "commands")))
         (case $commentary
           (((JsonString $public)
             (case $commands
               (((JsonString $program)
                 (commentary:accept $program (CommentaryPublishV1 $public)))
                ($other (commentary:reject invalid-envelope)))))
            ($other (commentary:reject invalid-envelope)))))
       (commentary:reject invalid-envelope))))

(= (commentary:arguments $value)
   (case $value
     (((JsonString $text) (llm:v1:parse $text)) ($other $value))))
(= (commentary:program-argument $value)
   (if (commentary:one-key-object? $value "program")
     (case (commentary:field $value "program")
       (((JsonString $program) $program) ($other (commentary:reject invalid-native-tool))))
     (commentary:reject invalid-native-tool)))
(= (commentary:function $value)
   (if (commentary:exact-object? $value ("name" "arguments"))
     (case (commentary:field $value "name")
       (((JsonString "metta")
         (commentary:program-argument
           (commentary:arguments (commentary:field $value "arguments"))))
        ($other (commentary:reject invalid-native-tool))))
     (commentary:reject invalid-native-tool)))
(= (commentary:call $value)
   (case $value
     (((JsonObject $pairs)
       (let* (($type (commentary:field $value "type"))
              ($id (commentary:field $value "id")))
         (case $type
           (((JsonString "function")
             (case $id
               (((JsonString $identity)
                 (if (== $identity "") (commentary:reject invalid-native-tool)
                   (commentary:function (commentary:field $value "function"))))
                ($other (commentary:reject invalid-native-tool)))))
            ($other (commentary:reject invalid-native-tool))))))
      ($other (commentary:reject invalid-native-tool)))))
(= (commentary:calls $value)
   (case $value
     (((JsonArray $items)
       (if (commentary:length? $items 1)
         (commentary:call (car-atom $items)) (commentary:reject invalid-native-tool)))
      ($other (commentary:reject invalid-native-tool)))))
(= (commentary:publication $content)
   (case $content
     (((JsonString $text) (CommentaryPublishV1 $text))
      ($other CommentaryNoPublicationV1))))
(= (commentary:tool-result $content $result)
   (case $result
     (((CommentaryRejectedV1 $code) $result)
      ($program (commentary:accept $program (commentary:publication $content))))))
(= (commentary:content-result $content)
   (case $content
     (((JsonString $text) (commentary:text $text))
      (JsonNull (commentary:reject invalid-envelope))
      ($other (commentary:reject invalid-envelope)))))
(= (commentary:message $reason $message)
   (if (commentary:truth (commentary:field $message "refusal"))
     (commentary:reject refused-or-structured-output)
     (let* (($calls (commentary:field $message "tool_calls"))
            ($content (commentary:field $message "content")))
       (if (commentary:truth $calls)
         (if (== $reason "tool_calls")
           (commentary:tool-result $content (commentary:calls $calls))
           (commentary:reject invalid-native-tool))
         (if (== $reason "stop") (commentary:content-result $content)
           (commentary:reject incomplete-output))))))
(= (commentary:choice $choice)
   (let* (($reason-value (commentary:field $choice "finish_reason"))
          ($message (commentary:field $choice "message")))
     (case $reason-value
       (((JsonString $reason) (commentary:message $reason $message))
        ($other (commentary:reject incomplete-output))))))
(= (commentary:classify-parsed $response)
   (case (commentary:field $response "choices")
     (((JsonArray $items)
       (if (== $items ()) (commentary:reject invalid-envelope)
         (commentary:choice (car-atom $items))))
      ($other (commentary:reject invalid-envelope)))))
(= (commentary:classify $legacy)
   (commentary:classify-parsed (llm:v1:parse $legacy)))

; The host owns settlement and its existing publication observer. This pure
; decision is attached to that one owned plan before native_llm_host.finish.
(= (commentary:store $plan (CommentaryAcceptedV1 $program $publication))
   (case $publication
     (((CommentaryPublishV1 $text)
       (py-call (native_llm_host.native_classified $plan accepted $program $text "" "true")))
      (CommentaryNoPublicationV1
       (py-call (native_llm_host.native_classified $plan accepted $program "" "" false))))))
(= (commentary:store $plan (CommentaryRejectedV1 $code))
   (py-call (native_llm_host.native_classified $plan rejected "" "" $code false)))
(= (commentary:prepare $plan $legacy)
   (if (llm:host-flag (py-call (native_llm_host.native_contract $plan)))
     (let $decision (commentary:classify $legacy) (commentary:store $plan $decision)) True))
