!(import! &self (library str))
!(import! &self (library system))
!(import! &self (library io))
!(import! &self (library math))
!(import! &self ./src/text_cetta)

(= (get_time) (system:wall-time))
(= (get_time_as_string) (system:format-time "%Y-%m-%d %H:%M:%S" (get_time) "local"))
(= (string_length $text) (str:char-length $text))
(= (string_concat $a $b) (str:concat $a $b))
(= (atomic_list_concat $parts $separator) (str:join $separator $parts))
(= (swrite $value) (repr $value))
(= (newline) "\n")
(= (exists-file $file) (file-io:exists $file))
(= (string-replace $text $old $new) (claw-text:replace $text $old $new))
(= (utils:decode-safe $value) (claw-text:decode-safe $value))
(= (string-safe $text)
   (string-replace (string-replace (string-replace $text "\"\"" "_quote_") "\n" "_newline_") "'" "_apostrophe_"))
(= (last_chars $text $count)
   (let $length (str:char-length $text)
     (str:char-slice $text (max 0 (- $length $count)) $length)))

; An owned timer keeps other clients' completions available to them.
(= (sleep $seconds)
   (let $milliseconds (math:ceil (* $seconds 1000))
     (let (io:pending $id) (io:submit (timer:after $milliseconds))
       (utils:await-timer $id))))
(= (utils:await-timer $id)
   (case (io:wait $id 30000)
     (((io:event $id (timer:fired $_)) (== 0 0))
      ((io:idle) (utils:await-timer $id))
      ($error $error))))

(= (configure $name $default)
   (let* (($_ (println! (Input value for $name or press enter for default $default)))
          ($args (collapse (system:arg 1)))
          ($text (if (or (== $args (default)) (== $args ())) "" (system:read-line))))
     (progn
       (remove-atom &self (= ($name) (empty)))
       (let $value (if (or (== $text "") (== $text end_of_file)) $default
           (case (catch (str:string->number $text)) (((Error $_ $_) $text) ($number $number))))
         (add-atom &self (= ($name) $value))))))

(= (take $k ()) ())
(= (take $k (cons $h $t))
   (if (== $k 0) () (cons $h (take (- $k 1) $t))))
