; SWI-PeTTa keeps the established Python implementation and differential
; oracle. Direct wrappers preserve its original return and error behavior.
!(import! &self ./src/helper.py)

(= (working:boot) (py-call (helper.working_boot)))
(= (working:boot-str $key $default) (py-call (helper.boot_str $key $default)))
(= (working:boot-int $key $default) (py-call (helper.boot_int $key $default)))
(= (working:boot-num $key $default) (py-call (helper.boot_num $key $default)))
(= (working:save $loops $sleep $results $heartbeat $continuation $banked $await)
   (py-call (helper.working_set_save $loops $sleep $results $heartbeat $continuation $banked $await)))
(= (working:rest-schedule $seconds $command) (py-call (helper.rest_schedule $seconds $command)))
(= (working:rest-cancel) (py-call (helper.rest_cancel)))
(= (working:rest-hold $seconds) (py-call (helper.rest_hold $seconds)))
(= (working:rest-release) (py-call (helper.rest_release)))
(= (working:rest-until) (py-call (helper.rest_until)))
(= (working:rest-holding) (py-call (helper.rest_holding)))
(= (working:rest-pending) (py-call (helper.rest_pending)))
(= (working:rest-due $timed-out) (py-call (helper.rest_due $timed-out)))
(= (working:rest-claim) (py-call (helper.rest_claim)))
(= (working:rest-finish) (py-call (helper.rest_finish)))
(= (working:wait-seconds $requested $last-heartbeat $interval)
   (py-call (helper.wait_seconds $requested $last-heartbeat $interval)))
(= (working:intent-save $why) (py-call (helper.intent_save $why)))
(= (working:turn-commit-reset) (py-call (helper.turn_commit_reset)))
(= (working:turn-commit-stage $provider $history $activity)
   (py-call (helper.turn_commit_stage $provider $history $activity)))
(= (working:turn-commit-ready) (py-call (helper.turn_commit_ready)))
