; SPDX-License-Identifier: MIT
; Agent-owned workspace descriptions and undo history. Source memberships live
; beside durable memories; definitions only choose views over those sources.
!(import! &self ./src/memory_views.metta)
!(import! &self ./src/workspaces_api.metta)
!(import! &self (library fs))
!(import! &self (library path))
!(import! &self (library system))
!(bind! &ws-state (new-state Unopened))
!(bind! &ws-turn (new-state ()))
!(bind! &ws-override (new-state ""))
!(bind! &ws-filter (new-state All))
!(bind! &ws-cross (new-state "inside"))

(= (ws:path)
   (system:getenv-or-default "METTACLAW_WORKSPACES_PATH"
     (path:join (path:dirname (am:path)) "workspaces.metta")))
(= (ws:initial) (WorkspaceSnapshot 1 "all" ((Workspace "all" ("all") () "" "default" "inside")) ()))
(= (ws:open)
   (case (get-state &ws-state)
     ((Unopened
       (let $loaded (if (fs:exists (ws:path))
         (case (fs:read-text-result (ws:path) 0 "raw")
           ((("ok" $text) (ws:validate-snapshot (catch (parse $text))))
            ($error (WorkspaceError read $error)))) (ws:initial))
         (let $_ (change-state! &ws-state $loaded) $loaded)))
      ($value $value))))
(= (ws:validate-snapshot $snapshot)
   (case $snapshot
     (((WorkspaceSnapshot 1 $active $views $history)
       (if (and (ws:valid-views? $views) (ws:valid-history? $history))
         (case (ws:resolve $views $active ())
           (((WorkspaceError $why $at) (WorkspaceError snapshot $at)) ($valid $snapshot)))
         (WorkspaceError snapshot "invalid workspace data; file preserved")))
      ($other (WorkspaceError snapshot "unrecognized data; file preserved")))))
(= (ws:valid-views? $views)
   (if (== $views ()) True
     (if (== (get-metatype $views) Expression)
       (case (car-atom $views)
         (((Workspace $name $in $out $home $mode $cross)
           (and (and (== (get-type $name) String) (and (ws:string-list? $in) (ws:string-list? $out)))
             (and (and (ws:home? $home) (memory:member $mode ("default" "similarity" "attention" "hybrid")))
               (and (memory:member $cross ("inside" "linked")) (ws:valid-views? (cdr-atom $views))))))
          ($other False))) False)))
(= (ws:valid-history? $history)
   (if (== $history ()) True
     (if (== (get-metatype $history) Expression)
       (case (car-atom $history)
         (((WorkspacePrevious $name $views)
           (and (and (== (get-type $name) String) (ws:valid-views? $views)) (ws:valid-history? (cdr-atom $history))))
          ($other False))) False)))
(= (ws:find $views $name)
   (if (== $views ()) (WorkspaceError missing-workspace $name)
     (let (Workspace $id $in $out $home $mode $cross) (car-atom $views)
       (if (== $id $name) (car-atom $views) (ws:find (cdr-atom $views) $name)))))
(= (ws:without $value $xs)
   (if (== $xs ()) () (if (== (car-atom $xs) $value) (ws:without $value (cdr-atom $xs))
     (cons-atom (car-atom $xs) (ws:without $value (cdr-atom $xs))))))
(= (ws:replace $views $view)
   (let (Workspace $name $in $out $home $mode $cross) $view
     (cons-atom $view (collapse (let $old (superpose $views)
       (let (Workspace $id $a $b $c $d $e) $old (if (== $id $name) (empty) $old)))))))
(= (ws:save $snapshot)
   (case (fs:update-text (ws:path) "replace" (repr $snapshot) "" "")
     ((("written" $path $n $digest $backup)
       (let $_ (change-state! &ws-state $snapshot) (WorkspaceSaved)))
      ($error (WorkspaceError save $error)))))
(= (ws:commit $active $views)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $old $previous $history)
       (if (== ($active $views) ($old $previous)) (WorkspaceUnchanged)
         (ws:save (WorkspaceSnapshot 1 $active $views
           (cons-atom (WorkspacePrevious $old $previous) $history)))))
      ($error $error))))
(= (ws:chosen)
   (if (== (get-state &ws-override) "") (ws:setting "active") (get-state &ws-override)))
(= (ws:view $name)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history) (ws:find $views $name)) ($error $error))))

; Selectors are inert strings. Only the first colon separates kind from ID.
(= (ws:selector $views $selector $seen)
   (if (not (== (get-type $selector) String)) (WorkspaceError selector "expected a string")
     (if (== $selector "all") All
       (if (str:starts-with $selector "@")
         (ws:resolve $views (str:char-slice $selector 1 (str:char-length $selector)) $seen)
         (case (str:find $selector ":")
           (((TextNotFound $needle) (WorkspaceError selector $selector))
            ($colon (let* (($kind (str:char-slice $selector 0 $colon))
                          ($id (str:char-slice $selector (+ 1 $colon) (str:char-length $selector)))
                          ($key (str:concat "context:" $kind)))
              (if (or (== $kind "") (== $id "")) (WorkspaceError selector $selector)
                (if (== $id "*") (Exists $key) (Eq $key $id)))))))))))
(= (ws:selectors $views $selectors $seen)
   (if (== $selectors ()) ()
     (case (ws:selector $views (car-atom $selectors) $seen)
       (((WorkspaceError $why $at) (WorkspaceError $why $at))
        ($head (case (ws:selectors $views (cdr-atom $selectors) $seen)
          (((WorkspaceError $why $at) (WorkspaceError $why $at))
           ($tail (cons-atom $head $tail)))))))))
(= (ws:resolve $views $name $seen)
   (if (memory:member $name $seen) (WorkspaceError cycle $name)
     (case (ws:find $views $name)
       (((Workspace $name $in $out $home $mode $cross)
         (let* (($next (cons-atom $name $seen)) ($included (ws:selectors $views $in $next))
                ($excluded (ws:selectors $views $out $next)))
           (case ($included $excluded)
             ((((WorkspaceError $why $at) $other) (WorkspaceError $why $at))
              (($other (WorkspaceError $why $at)) (WorkspaceError $why $at))
              ($ready (if (and (== $included (All)) (== $excluded ())) All
                        (And ((Or $included) (Not (Or $excluded))))))))))
        ($error $error)))))
(= (ws:filter $name)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history) (ws:resolve $views $name ())) ($error $error))))
(= (ws:prepare)
   (case (ws:view (ws:chosen))
     (((Workspace $name $in $out $home $mode $cross)
       (let $filter (ws:filter $name)
         (case $filter
           (((WorkspaceError $why $at) $filter)
            ($ready (let* (($_ (change-state! &ws-filter $ready))
                           ($_ (change-state! &ws-cross $cross))) True))))))
      ($error $error))))
(= (ws:allows $id) (view:allows (get-state &ws-filter) $id))
(= (ws:traverse? $id) (if (== (get-state &ws-cross) "linked") True (ws:allows $id)))
(= (ws:query $profile $vector $count)
   (view:query $profile $vector $count (get-state &ws-filter)))
(= (ws:count)
   (size-atom (collapse (let (Memory $id $r $p $v $d $m) (memory:matches All)
     (if (view:matches $m (get-state &ws-filter)) $id (empty))))))
(= (ws:mode)
   (case (ws:view (ws:chosen))
     (((Workspace $name $in $out $home $mode $cross) $mode) ($error "default"))))

(= (workspaces)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history)
       (Workspaces $active $views (UndoDepth (size-atom $history)))) ($error $error))))
(= (workspace)
   (case (ws:view (ws:setting "active"))
     (((Workspace $name $in $out $home $mode $cross)
       (WorkspaceCurrent $name (Include $in) (Exclude $out) (Home $home)
         (Selector $mode) (CrossLinks $cross) (Capture (get-state &ws-turn)) (Filter (ws:filter $name))))
      ($error $error))))
(= (workspace $name)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history)
       (case (ws:resolve $views $name ())
         (((WorkspaceError $why $at) (WorkspaceError $why $at))
          ($filter (let $saved (ws:commit $name $views)
            (case $saved (((WorkspaceError $why $at) $saved) ($ok (workspace)))))))))
      ($error $error))))
(= (workspace $name $in $out $home)
   (if (and (and (== (get-type $name) String) (not (== $name "")))
            (and (ws:string-list? $in) (ws:string-list? $out)))
     (ws:define $name $in $out $home) (WorkspaceError definition "expected a nonempty name and string selector lists")))
(= (workspace $name $in) (WorkspaceError arguments "define with name, includes, excludes and home"))
(= (workspace $name $in $out) (WorkspaceError arguments "define with name, includes, excludes and home"))
(= (ws:string-list? $items)
   (if (== $items ()) True
     (if (== (get-metatype $items) Expression)
       (and (== (get-type (car-atom $items)) String) (ws:string-list? (cdr-atom $items))) False)))
(= (ws:define $name $in $out $home)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history)
       (ws:define-ready $active $views $name $in $out $home))
      ($error $error))))
(= (ws:define-ready $active $views $name $in $out $home)
   (let* (($old (ws:find $views $name))
          ($mode (case $old (((Workspace $n $a $b $c $m $x) $m) ($other "default"))))
          ($cross (case $old (((Workspace $n $a $b $c $m $x) $x) ($other "inside"))))
          ($next (ws:replace $views (Workspace $name (unique-atom $in) (unique-atom $out) $home $mode $cross))))
     (case (ws:resolve $next $name ())
       (((WorkspaceError $why $at) (WorkspaceError $why $at))
        ($ready (ws:define-save $active $next $name $home))))))
(= (ws:define-save $active $views $name $home)
   (if (ws:home? $home)
     (case (ws:commit $active $views)
       (((WorkspaceError $why $at) (WorkspaceError $why $at))
        ($ok (WorkspaceDefined $name))))
     (WorkspaceError home "expected a concrete kind:ID or empty")))
(= (ws:home? $home)
   (if (== $home "") True
     (case (ws:selector () $home ()) (((Eq $key $id) True) ($other False)))))
(= (workspace-include $name $selector) (workspace-include $name $selector True))
(= (workspace-exclude $name $selector) (workspace-exclude $name $selector True))
(= (workspace-include $name $selector $enabled) (ws:edit $name $selector $enabled include))
(= (workspace-exclude $name $selector $enabled) (ws:edit $name $selector $enabled exclude))
(= (ws:edit $name $selector $enabled $kind)
   (if (or (== $enabled True) (== $enabled False))
     (case (ws:view $name)
       (((Workspace $name $in $out $home $mode $cross)
         (let* (($old (if (== $kind include) $in $out))
                ($next (if $enabled (unique-atom (union-atom $old ($selector))) (ws:without $selector $old))))
           (workspace $name (if (== $kind include) $next $in) (if (== $kind exclude) $next $out) $home)))
        ($error $error))) (WorkspaceError enabled "expected True or False")))
(= (workspace-undo)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views ()) (WorkspaceUnchanged))
      ((WorkspaceSnapshot 1 $active $views $history)
       (let (WorkspacePrevious $previous $old) (car-atom $history)
         (ws:save (WorkspaceSnapshot 1 $previous $old (cdr-atom $history)))))
      ($error $error))))
(= (workspace-reload) (let $_ (change-state! &ws-state Unopened) (workspace)))

(= (ws:setting $key)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history)
       (if (== $key "active") $active
         (case (ws:find $views $active)
           (((Workspace $name $in $out $home $mode $cross)
             (case $key (("home" $home) ("selector" $mode) ("cross-links" $cross)
                         ($other (SettingUnknown "workspace" $key))))) ($error $error)))))
      ($error $error))))
(= (ws:setting $key $value)
   (if (== $key "active") (workspace $value)
     (case (settings:validate "workspace" $key $value)
       ((True (ws:update-preference $key $value)) ($error $error)))))
(= (ws:update-preference $key $value)
   (case (ws:open)
     (((WorkspaceSnapshot 1 $active $views $history)
       (case (ws:find $views $active)
         (((Workspace $name $in $out $home $mode $cross)
           (if (and (== $key "home") (not (ws:home? $value))) (WorkspaceError home $value)
             (ws:commit $active (ws:replace $views
               (Workspace $name $in $out (if (== $key "home") $value $home)
                 (if (== $key "selector") $value $mode)
                 (if (== $key "cross-links") $value $cross))))))
          ($error $error))))
      ($error $error))))

(= (ws:begin $task $source $chat)
   (change-state! &ws-turn
     (cons-atom (str:concat "task:" $task)
       (if (== $chat "") () ((str:concat "channel:" $chat))))))
(= (ws:capture)
   (let $home (ws:setting "home")
     (if (== $home "") (get-state &ws-turn)
       (unique-atom (cons-atom $home (get-state &ws-turn))))))
(= (ws:memberships $id $selectors)
   (if (== $selectors ()) ()
     (case (ws:selector () (car-atom $selectors) ())
       (((Eq $key $value)
         (cons-atom (MemoryScope 1 $id $key $value) (ws:memberships $id (cdr-atom $selectors))))
        ($other (ws:memberships $id (cdr-atom $selectors)))))))
(= (ws:context) (workspace))

(= (workspace-query $name $text) (workspace-query $name $text 20))
(= (workspace-query $name $text $count)
   (ws:temporary $name $text $count "default"))
(= (workspace-query $name $text $count $mode)
   (ws:temporary $name $text $count $mode))
(= (ws:temporary $name $text $count $mode)
   (case (ws:filter $name)
     (((WorkspaceError $why $at) (WorkspaceError $why $at))
      ($valid (let* (($previous (get-state &ws-override))
                     ($_ (change-state! &ws-override $name))
                     ($answer (catch (if (== $mode "default") (semantic:query $text $count)
                                       (semantic:query $text $count $mode))))
                     ($_ (change-state! &ws-override $previous))
                     ($_ (ws:prepare))) $answer)))))

; Scope facts are committed with the durable remember intent, so an embedding
; outage or restart cannot change the destination of an already queued memory.
(= (sm:workspace-snapshot $space)
   (case (sm:snapshot $space (Memory $id $r $p $v $d $m) (Memory $id $r $p $v $d $m))
     (((MSnapshot $rev $rows)
       (case (sm:snapshot $space (MemoryScope 1 $id $key $value) (MemoryScope 1 $id $key $value))
         (((MSnapshot $scope-rev $scopes)
           (if (== $rev $scope-rev)
             (let* (($index (new-space)) ($_ (am:install $index $scopes)))
               (MSnapshot $rev (sm:workspace-rows $index $rows)))
             (sm:workspace-snapshot $space)))
          ($error $error)))) ($error $error))))
(= (sm:workspace-rows $index $rows)
   (if (== $rows ()) ()
     (let* (((Memory $id $r $p $v $d $meta) (car-atom $rows))
            ($memberships (collapse (match $index (MemoryScope 1 $id $key $value) ($key $value)))))
       (cons-atom (Memory $id $r $p $v $d (unique-atom (union-atom $meta $memberships)))
         (sm:workspace-rows $index (cdr-atom $rows))))))
(= (sm:workspace-meta $space $id $meta)
   (let $scopes (sm:all $space (MemoryScope 1 $id $key $value) ($key $value))
     (case $scopes (((MemoryUnavailable $why $at) $meta)
       ($rows (unique-atom (union-atom $meta $rows)))))))
(= (workspace-tag $id $selectors) (workspace-tag $id $selectors "add"))
(= (workspace-tag $id $selectors $mode)
   (if (and (or (== $mode "add") (== $mode "remove")) (ws:concrete-list? $selectors))
     (case (sm:open)
       (((MStore $space $profile $dim)
         (case (sm:one $space $id)
           (((MemoryUnavailable $why $at) (MemoryUnavailable $why $at))
            ($row (if (and (== $row (MemoryMissing $id)) (== (sm:pending-id $space $id) ()))
              (WorkspaceError missing-memory $id)
              (let* (($memberships (ws:memberships $id (unique-atom $selectors)))
                     ($existing (sm:all $space (MemoryScope 1 $id $key $value) (MemoryScope 1 $id $key $value)))
                     ($ops (collapse (let $fact (superpose $memberships)
                       (if (== $mode "add")
                         (if (memory:member $fact $existing) (empty) (add $fact))
                         (if (memory:member $fact $existing) (remove $fact) (empty)))))))
                (if (== $ops ()) (WorkspaceTagged $id $mode $selectors unchanged)
                  (case (sm:commit $space $ops)
                    (((MemoryCommitted) (WorkspaceTagged $id $mode $selectors))
                     ((MemoryChanged) (workspace-tag $id $selectors $mode))
                     ($error $error))))))))))
        ($error $error))) (WorkspaceError memberships "expected concrete kind:ID selectors and add or remove")))
(= (ws:concrete-list? $selectors)
   (if (== $selectors ()) True
     (if (== (get-metatype $selectors) Expression)
       (and (and (ws:home? (car-atom $selectors)) (not (== (car-atom $selectors) "")))
         (ws:concrete-list? (cdr-atom $selectors))) False)))

(= (workspace-preview) (workspace-preview (ws:setting "active")))
(= (workspace-preview $name)
   (case (ws:filter $name)
     (((WorkspaceError $why $at) (WorkspaceError $why $at))
      ($filter (case (sm:open)
        (((MStore $space $profile $dim)
          (case (sm:refresh $space $profile $dim)
            ((True (let* (($ids (collapse (let (Memory $id $r $p $v $d $meta) (memory:matches All)
                               (if (view:matches $meta $filter) $id (empty)))))
                         ($contexts (unique-atom (collapse
                           (let (Memory $id $r $p $v $d $meta) (memory:matches All)
                             (let ($key $value) (superpose $meta)
                               (if (str:starts-with $key "context:") ($key $value) (empty))))))))
                     (WorkspacePreview $name (Matching (size-atom $ids))
                       (Filter $filter) (AvailableContexts $contexts))))
             ($error $error)))) ($error $error)))))))
