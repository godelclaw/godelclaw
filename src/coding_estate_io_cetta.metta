; Read-only native observation snapshot for the coding-sessions context view.
; Owns filesystem, timestamp, SHA-256, runtime block, and native ledger-selection
; observation only; coding_estate_cetta.metta owns all classification and rendering.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self (library proc))
!(import! &self (library math))
!(import! &self (library list))
!(import! &self (library space_service))
!(import! &self ./src/undelivered_prose_unicode)
!(import! &self ./src/effect_receipt_values_cetta.metta)
!(import! &self ./src/ledger_client.metta)

!(bind! &eio-engine-cache (new-state ()))
!(bind! &eio-blocks-cache (new-state ()))
!(bind! &eio-world-cache (new-state ()))
!(bind! &eio-space
   (new-state (re:compile (str:join "" ("\\A" (prose:pattern space) "+|" (prose:pattern space) "+\\z")))))
!(bind! &eio-lines
   (new-state (re:compile "\\r\\n|[\\n\\r\\x{B}\\x{C}\\x{1C}-\\x{1E}\\x{85}\\x{2028}\\x{2029}]")))
!(bind! &eio-path-needs-normalization
   (new-state (re:compile "(^|/)\\.(/|$)|//|/$|^$")))

(= (eio:clear-caches!)
   (let* (($c1 (change-state! &eio-engine-cache ()))
          ($c2 (change-state! &eio-blocks-cache ()))
          ($c3 (change-state! &eio-world-cache ())))
     True))

(= (eio:strip $text)
   (re:replace-literal (get-state &eio-space) $text ""))
(= (eio:splitlines $text)
   (str:split "\n" (re:replace-literal (get-state &eio-lines) $text "\n")))
(= (eio:contains? $text $needle)
   (case (str:find $text $needle)
     (((TextNotFound $miss) False)
      ($at (== (get-type $at) Number)))))
(= (eio:universal $text)
   (if (eio:contains? $text "\r")
     (str:join "\n" (str:split "\r" (str:join "\n" (str:split "\r\n" $text))))
     $text))
(= (eio:nul? $text)
   (eio:contains? $text (str:from-codepoints (0))))

(= (eio:append $left $right)
   (if (== $left ()) $right
     (cons-atom (car-atom $left) (eio:append (cdr-atom $left) $right))))

; Lexical POSIX path operations matching pathlib.PosixPath (preserving '..' and '//').
(= (eio:prefix $path)
   (if (and (str:starts-with $path "//") (not (str:starts-with $path "///"))) "//"
     (if (str:starts-with $path "/") "/" "")))
(= (eio:parts $path)
   (filter-atom (str:split "/" $path) $part (and (not (== $part "")) (not (== $part ".")))))
(= (eio:build-path $prefix $parts)
   (let $body (str:join "/" $parts)
     (if (== $body "") (if (== $prefix "") "." $prefix) (str:concat $prefix $body))))
(= (eio:path $path)
   (case (re:is-match (get-state &eio-path-needs-normalization) $path)
     ((False $path)
      ($other (eio:build-path (eio:prefix $path) (eio:parts $path))))))
(= (eio:join $root $leaf)
   (if (str:starts-with $leaf "/") (eio:path $leaf)
     (let $base (eio:path $root)
       (if (== $base ".") (eio:path $leaf)
         (eio:build-path (eio:prefix $base)
           (eio:append (eio:parts $base) (eio:parts $leaf)))))))
; The snapshot normalizes its base once. Directory entries and these literal
; relative children contain no redundant separators or '.' segments, so joining
; them does not require splitting and rebuilding the entire ancestor path.
(= (eio:child $base $relative)
   (if (== $base ".") $relative
     (if (str:ends-with $base "/") (str:concat $base $relative)
       (str:join "/" ($base $relative)))))
(= (eio:basename $path)
   (let* (($normalized (eio:path $path)) ($parts (str:split "/" $normalized)))
     (if (== $normalized ".") "" (index-atom $parts (- (size-atom $parts) 1)))))

; Associative in-process caches keyed by normalized path string.
(= (eio:cache-get $entries $key)
   (if (== $entries ()) EioCacheMiss
     (let ($k $stamp $val) (car-atom $entries)
       (if (== $k $key) (EioCacheHit $stamp $val)
         (eio:cache-get (cdr-atom $entries) $key)))))
(= (eio:cache-put-entries $entries $key $stamp $val)
   (if (== $entries ()) (($key $stamp $val))
     (let ($k $s $v) (car-atom $entries)
       (if (== $k $key)
         (cons-atom ($key $stamp $val) (cdr-atom $entries))
         (cons-atom ($k $s $v) (eio:cache-put-entries (cdr-atom $entries) $key $stamp $val))))))
(= (eio:cache-put! $cell $key $stamp $val)
   (let $updated (change-state! $cell (eio:cache-put-entries (get-state $cell) $key $stamp $val))
     $val))

; Merge-sort strings in UTF-8 byte / codepoint order (matching Python str order).
(= (eio:split-half $items $left $right)
   (if (== $items ()) ($left $right)
     (let ($a $rest) (decons-atom $items)
       (if (== $rest ()) ((cons-atom $a $left) $right)
         (let ($b $tail) (decons-atom $rest)
           (eio:split-half $tail (cons-atom $a $left) (cons-atom $b $right)))))))
(= (eio:merge-strings $left $right)
   (if (== $left ()) $right
     (if (== $right ()) $left
       (let* (($a (car-atom $left)) ($b (car-atom $right)))
         (if (<= (str:compare $a $b) 0)
           (cons-atom $a (eio:merge-strings (cdr-atom $left) $right))
           (cons-atom $b (eio:merge-strings $left (cdr-atom $right))))))))
(= (eio:sort-strings $items)
   (if (== $items ()) ()
     (if (== (cdr-atom $items) ()) $items
       (let ($left $right) (eio:split-half $items () ())
         (eio:merge-strings (eio:sort-strings $left) (eio:sort-strings $right))))))

; Metadata predicates:
; - eio:os-exists? matches os.path.exists (all OSError and embedded NUL -> False).
; - eio:is-file? / eio:is-dir? match Python 3.12 Path.is_file / Path.is_dir
;   (embedded NUL and ENOENT/ENOTDIR/EBADF/ELOOP -> False; EACCES/EPERM/EIO -> abort).
(= (eio:ignored-stat-errno? $code)
   (or (== $code 2) (or (== $code 9) (or (== $code 20) (== $code 40)))))
(= (eio:os-exists? $path)
   (if (eio:nul? $path) False
     (case (fs:metadata $path follow)
       (((fs:info $kind $size $ident) True) ($other False)))))
(= (eio:is-file? $path)
   (if (eio:nul? $path) False
     (case (fs:metadata $path follow)
       (((fs:info regular $size $ident) True)
        ((fs:info $other-kind $size $ident) False)
        ((fs:failed fs:missing $op $p $code $prog $msg) False)
        ((fs:failed $kind $op $p $code $prog $msg)
         (if (eio:ignored-stat-errno? $code) False (empty)))
        ($other (empty))))))
(= (eio:is-dir? $path)
   (if (eio:nul? $path) False
     (case (fs:metadata $path follow)
       (((fs:info directory $size $ident) True)
        ((fs:info $other-kind $size $ident) False)
        ((fs:failed fs:missing $op $p $code $prog $msg) False)
        ((fs:failed $kind $op $p $code $prog $msg)
         (if (eio:ignored-stat-errno? $code) False (empty)))
        ($other (empty))))))

; Local calendar date formatting matching time.strftime("%Y-%m-%d", time.localtime(float(ts))).
(= (eio:number? $value)
   (case $value
     ((True True) (False True)
      ($other (== (get-type $other) Number)))))
(= (eio:float-seconds $value)
   (let $num (case $value ((True 1.0) (False 0.0) ($other (* 1.0 $other))))
     (if (or (math:isnan $num) (math:isinf $num))
       (empty)
       (math:floor $num))))
(= (eio:local-date $timestamp)
   (let* (($floored (eio:float-seconds $timestamp))
          ($formatted (system:format-time "%Y-%m-%d" $floored "local")))
     (if (== (get-type $formatted) String) $formatted (empty))))
(= (eio:mtime-seconds $sec $nsec)
   (+ (* 1.0 $sec) (* 0.000000001 $nsec)))
(= (eio:file-date $path)
   (if (eio:nul? $path)
     (empty)
     (case (fs:metadata $path follow-modified)
       (((fs:info $kind $size $ident (fs:modified $sec $nsec))
         (eio:local-date (eio:mtime-seconds $sec $nsec)))
        ($failed (eio:local-date (system:wall-time)))))))
(= (eio:candidates-date $candidates)
   (if (== $candidates ())
     (eio:local-date (system:wall-time))
     (let $candidate (car-atom $candidates)
       (if (eio:nul? $candidate)
         (empty)
         (case (fs:metadata $candidate follow-modified)
           (((fs:info $kind $size $ident (fs:modified $sec $nsec))
             (eio:local-date (eio:mtime-seconds $sec $nsec)))
            ($failed (eio:candidates-date (cdr-atom $candidates)))))))))

; JSON object lookup and tolerant readers matching coding_estate._read_json / read_runs.
(= (eio:field $object $key $default)
   (case $object
     (((JsonObject $pairs)
       (case (json:get-last $object $key)
         (((JsonFoundV1 $index $value) $value) ($missing $default))))
      ($other $default))))
(= (eio:py-str $value)
   (let $rendered (erv:str $value)
     (if (erv:failed? $rendered) (empty) $rendered)))
(= (eio:json-error? $value)
   (if (== (get-metatype $value) Expression)
     (if (== $value ()) False (== (car-atom $value) JsonPythonErrorV1))
     False))

(= (eio:read-json $path)
   (if (eio:nul? $path) (JsonObject ())
     (case (fs:read-text-result $path 0 "raw")
       ((("ok" $raw)
         (if (== (str:utf8-error $raw) StrUtf8WellFormedV1)
           (case (json:parse-python (eio:universal $raw))
             (((JsonObject $pairs) (JsonObject $pairs))
              ($non-object (JsonObject ()))))
           (JsonObject ())))
        ($read-failed (JsonObject ()))))))

(= (eio:read-lifecycle $session)
   (let $path (eio:child $session "lifecycle.json")
     (if (eio:is-file? $path) (eio:read-json $path) (JsonObject ()))))

(= (eio:nonempty-lines-acc $lines $acc)
   (if (== $lines ()) (list:reverse $acc)
     (let $trimmed (eio:strip (car-atom $lines))
       (eio:nonempty-lines-acc (cdr-atom $lines)
         (if (== $trimmed "") $acc (cons-atom $trimmed $acc))))))
(= (eio:parse-runs-acc $lines $acc)
   (if (== $lines ()) (list:reverse $acc)
     (let* (($line (car-atom $lines))
            ($tail (cdr-atom $lines))
            ($parsed (json:parse-python $line)))
       (if (eio:json-error? $parsed)
         (if (== $tail ()) (list:reverse $acc) (eio:parse-runs-acc $tail $acc))
         (case $parsed
           (((JsonObject $pairs) (eio:parse-runs-acc $tail (cons-atom (JsonObject $pairs) $acc)))
            ($non-dict (eio:parse-runs-acc $tail $acc))))))))
(= (eio:read-runs $session)
   (let $path (eio:child $session "runs.jsonl")
     (if (not (eio:is-file? $path)) ()
       (case (fs:read-text-result $path 0 "replace")
         ((("ok" $raw)
           (let $nonempty (eio:nonempty-lines-acc (eio:splitlines (eio:universal $raw)) ())
             (eio:parse-runs-acc $nonempty ())))
          ($failed ()))))))

; Cached engine binary SHA-256 matching coding_estate._engine_sha256.
(= (eio:engine-sha256 $binary)
   (if (== $binary "") JsonNull
     (let $key (eio:path $binary)
       (if (eio:nul? $key)
         (empty)
         (case (fs:metadata $key follow-modified)
           (((fs:info regular $size (fs:identity $dev $ino) (fs:modified $sec $nsec))
             (let $stamp ($dev $ino $size $sec $nsec)
               (case (eio:cache-get (get-state &eio-engine-cache) $key)
                 (((EioCacheHit $cached-stamp $digest)
                   (if (== $cached-stamp $stamp) $digest
                     (eio:engine-sha256-read $key $stamp)))
                  ($miss (eio:engine-sha256-read $key $stamp))))))
            ($other JsonNull)))))))
(= (eio:engine-sha256-read $key $stamp)
   (case (fs:read-text-result $key 0 "raw")
     ((("ok" $raw)
       (eio:cache-put! &eio-engine-cache $key $stamp (str:sha256 $raw)))
      ($failed JsonNull))))

; Non-dot subdirectory enumeration with explicit OS error reporting.
(= (eio:entry-dir-status $dir $name $hint)
   (if (== $hint directory) EioEntryDir
     (if (or (== $hint symlink) (== $hint unknown))
       (let $child (eio:child $dir $name)
         (if (eio:nul? $child) EioEntryNotDir
           (case (fs:metadata $child follow)
             (((fs:info directory $size $ident) EioEntryDir)
              ((fs:info $other $size $ident) EioEntryNotDir)
              ((fs:failed fs:missing $op $p $code $prog $msg) EioEntryNotDir)
              ((fs:failed $kind $op $p $code $prog $msg)
               (if (eio:ignored-stat-errno? $code) EioEntryNotDir EioEntryErr))
              ($other EioEntryErr)))))
       EioEntryNotDir)))
(= (eio:collect-subdirs $dir $owner $acc)
   (case (fs:next-entry $owner)
     (((fs:end $count)
       (let $closed (fs:close $owner)
         (EioDirOk (eio:sort-strings $acc))))
      ((fs:entry $name $hint $idx)
       (if (str:starts-with $name ".")
         (eio:collect-subdirs $dir $owner $acc)
         (case (eio:entry-dir-status $dir $name $hint)
           ((EioEntryDir (eio:collect-subdirs $dir $owner (cons-atom $name $acc)))
            (EioEntryNotDir (eio:collect-subdirs $dir $owner $acc))
            ($err (let $closed-e (fs:close $owner) EioDirErr))))))
      ($failed
       (let $closed-err (fs:close $owner) EioDirErr)))))
(= (eio:non-dot-subdirs $dir)
   (if (eio:nul? $dir) EioDirErr
     (let $opened (fs:open-directory $dir)
       (case $opened
         (((NativeHandle "directory-reader" $hid)
           (eio:collect-subdirs $dir $opened ()))
          ($failed EioDirErr))))))
(= (eio:coding-subdirs $coding-dir)
   (if (not (eio:is-dir? $coding-dir))
     (False ())
     (case (eio:non-dot-subdirs $coding-dir)
       (((EioDirOk $ids) (True $ids))
        ($err (False ()))))))
(= (eio:runtime-subdirs $runtimes-dir)
   (if (not (eio:is-dir? $runtimes-dir))
     ()
     (case (eio:non-dot-subdirs $runtimes-dir)
       (((EioDirOk $ids) $ids)
        ($err ())))))

; Cached 512-byte allocated block sum matching coding_estate._dir_blocks.
; Native fs:metadata does not expose st_blocks, so uncached runtime directories
; run one non-shell GNU find pass without following internal symlinks.
; Permission-limited traversal may return a partial sum on exit code 1, whereas
; missing/unsupported find, timeouts, signals, or invalid output fail observation
; without caching an invented zero.
(= (eio:find-bin)
   (let $override (system:getenv-or-default "METTACLAW_ESTATE_FIND_BIN" "")
     (if (not (== $override "")) $override
       (if (eio:os-exists? "/usr/bin/find") "/usr/bin/find" "find"))))
(= (eio:find-timeout-ms)
   (let $raw (system:getenv-or-default "METTACLAW_ESTATE_FIND_TIMEOUT_MS" "10000")
     (let $parsed (str:string->number $raw)
       (if (and (== (get-type $parsed) Number) (>= $parsed 1))
         (math:floor $parsed) 10000))))
(= (eio:safe-find-path $path)
   (if (str:starts-with $path "/") $path (str:concat "./" $path)))
(= (eio:parse-block-lines-acc $lines $sum $count)
   (if (== $lines ())
     (EioParsedBlocks $sum $count)
     (let $trimmed (eio:strip (car-atom $lines))
       (if (== $trimmed "")
         (eio:parse-block-lines-acc (cdr-atom $lines) $sum $count)
         (let $n (str:string->number $trimmed)
           (if (and (== (get-type $n) Number) (and (>= $n 0) (== $n (math:floor $n))))
             (eio:parse-block-lines-acc (cdr-atom $lines) (+ $sum $n) (+ $count 1))
             EioBlocksInvalid))))))
(= (eio:traversal-stderr-line? $line)
   (let $trimmed (eio:strip $line)
     (if (== $trimmed "") True
       (or (eio:contains? $trimmed "Permission denied")
           (or (eio:contains? $trimmed "No such file or directory")
               (eio:contains? $trimmed "Not a directory"))))))
(= (eio:traversal-stderr-only? $err)
   (let $lines (str:split "\n" $err)
     (and (not (== (eio:strip $err) ""))
          (foldl-atom $lines True $ok $line
            (and $ok (eio:traversal-stderr-line? $line))))))
(= (eio:find-env)
   (let* (($path (system:getenv-or-default "PATH" "/usr/bin:/bin"))
          ($ld (system:getenv-or-default "LD_LIBRARY_PATH" ""))
          ($base (("LC_ALL" "C") ("LANG" "C") ("LANGUAGE" "C") ("PATH" $path))))
     (if (== $ld "") $base (cons-atom ("LD_LIBRARY_PATH" $ld) $base))))
(= (eio:run-find-blocks $argv $min-lines)
   (let* (($cwd (system:cwd))
          ($child-env (eio:find-env))
          ($timeout (eio:find-timeout-ms)))
     (case (proc:run $argv ((cwd $cwd) (env $child-env) (stdin "")
                            (timeout-ms $timeout) (max-bytes 0)))
       (((proc:result (proc:exited $code) proc:normal $out $err $cap)
         (case (eio:parse-block-lines-acc (str:split "\n" $out) 0 0)
           (((EioParsedBlocks $sum $count)
             (if (< $count $min-lines)
               EioBlocksErr
               (if (== $code 0)
                 (EioBlocksOk $sum)
                 (if (and (== $code 1) (eio:traversal-stderr-only? $err))
                   (EioBlocksOk $sum)
                   EioBlocksErr))))
            ($invalid EioBlocksErr))))
        ($failed EioBlocksErr)))))
(= (eio:compute-dir-blocks $target $kind)
   (let* (($find (eio:find-bin))
          ($safe (eio:safe-find-path $target)))
     (if (== $kind symlink)
       (case (eio:run-find-blocks ($find "-P" $safe "-maxdepth" "0" "-printf" "%b\n") 1)
         (((EioBlocksOk $self-blocks)
           (case (eio:run-find-blocks ($find "-H" $safe "-mindepth" "1" "-printf" "%b\n") 0)
             (((EioBlocksOk $child-blocks) (EioBlocksOk (+ $self-blocks $child-blocks)))
              ($child-err EioBlocksErr))))
          ($self-err EioBlocksErr)))
       (eio:run-find-blocks ($find "-P" $safe "-printf" "%b\n") 1))))
(= (eio:dir-blocks-uncached $target $stamp $kind)
   (case (eio:compute-dir-blocks $target $kind)
     (((EioBlocksOk $fresh) (eio:cache-put! &eio-blocks-cache $target $stamp $fresh))
      ($err (empty)))))
(= (eio:dir-blocks $path)
   (let $target (eio:path $path)
     (if (eio:nul? $target)
       (empty)
       (case (fs:metadata $target no-follow-modified)
         (((fs:info $kind $size (fs:identity $dev $ino) (fs:modified $sec $nsec))
           (let $stamp ($dev $ino $sec $nsec)
             (case (eio:cache-get (get-state &eio-blocks-cache) $target)
               (((EioCacheHit $cached-stamp $blocks)
                 (if (== $cached-stamp $stamp) $blocks
                   (eio:dir-blocks-uncached $target $stamp $kind)))
                ($miss (eio:dir-blocks-uncached $target $stamp $kind))))))
          ($failed 0))))))

; Native LLM ledger backend selection (queried at most once per snapshot when matched).
(= (eio:unknown $reason)
   (JsonArray ("unknown" $reason)))
(= (eio:classify-selection-error $text)
   (let $lower (str:lower $text)
     (if (eio:contains? $text "llm-ledger-importing")
       (eio:unknown "importing")
       (if (or (eio:contains? $lower "timed out") (eio:contains? $lower "timeout"))
         (eio:unknown "timeout")
         (if (eio:contains? $lower "unsupported")
           (eio:unknown "unsupported")
           (eio:unknown "unreachable"))))))
(= (eio:classify-selection-value $value)
   (case $value
     (((Error $where $why) (eio:classify-selection-error (repr (Error $where $why))))
      ($answer
       (let $stripped (eio:strip
                        (if (== (get-type $answer) String) $answer
                          (if (== (get-metatype $answer) Symbol) (str:symbol->string $answer)
                            (repr $answer))))
         (if (== $stripped "native") "native"
           (if (== $stripped "legacy") "legacy"
             (eio:unknown "unsupported"))))))))
(= (eio:selection-exchange $socket $deadline-ns $left)
   (let* (($now-ns (system:monotonic-ns))
          ($rem-ms (math:floor (/ (- $deadline-ns $now-ns) 1000000))))
     (if (< $rem-ms 1)
       (eio:unknown "timeout")
       (let* (($rid (space:request-id))
              ($raw (space:call $socket
                      (request $rid (CallV1 LedgerCall (LedgerCallV1 "llm-selection" ())))
                      $rem-ms)))
         (case $raw
           (((reply $r1 ok $payload)
             (eio:classify-selection-value (ledger-client:answer ($payload))))
            ((reply $r2 error $reason) (eio:unknown "unreachable"))
            ((space:uncertain $r3 timeout) (eio:unknown "timeout"))
            ((space:unavailable $r4 timeout) (eio:unknown "timeout"))
            ((space:uncertain $r5 $why1)
             (if (> $left 1) (eio:selection-exchange $socket $deadline-ns (- $left 1))
               (eio:unknown "unreachable")))
            ((space:unavailable $r6 $why2)
             (if (> $left 1) (eio:selection-exchange $socket $deadline-ns (- $left 1))
               (eio:unknown "unreachable")))
            ($other (eio:unknown "unreachable"))))))))
(= (eio:llm-ledger-selection)
   (let $target (system:getenv-or-default "METTACLAW_INPUT_LEDGER_SOCKET" "")
     (if (or (== $target "") (not (eio:os-exists? $target)))
       (eio:unknown "unreachable")
       (if (or (not (str:starts-with $target "/")) (> (str:byte-length $target) 107))
         (eio:unknown "unreachable")
         (eio:selection-exchange $target (+ (system:monotonic-ns) 1000000000) 3)))))

; Per-session and whole-estate read-only observation snapshot.
(= (eio:status-date $session $state)
   (let $updated (eio:field $state "updated" JsonNull)
     (if (eio:number? $updated)
       (eio:local-date $updated)
       (eio:candidates-date
         ((eio:child $session "state.json") (eio:child $session "task.json") $session)))))
(= (eio:session-matched $runtime-exists $root $root-exists)
   (if (and $runtime-exists
            (and $root-exists (not (eio:is-file? (eio:join $root "src/llm_ledger.metta")))))
     ("llm-ledger-sqlite")
     ()))
; Sessions can share a runtime and engine. Observe those shared facts once in
; this view, rather than repeating stat, normalization and hashing admission for
; every session. This cache is reset at every snapshot, including warm views.
(= (eio:world-facts $root $binary)
   (let $key ($root $binary)
     (case (eio:cache-get (get-state &eio-world-cache) $key)
       (((EioCacheHit $stamp $facts) $facts)
        ($miss
         (let* (($has-root (and (== (get-type $root) String) (not (== $root ""))))
                ($root-exists (if $has-root (eio:is-dir? $root) False))
                ($root-name (eio:basename (eio:py-str $root)))
                ($matched (eio:session-matched True $root $root-exists))
                ($engine-hash (if (and (== (get-type $binary) String) (not (== $binary "")))
                                (eio:engine-sha256 $binary) JsonNull)))
           (eio:cache-put! &eio-world-cache $key True
             (EioWorldFactsV1 $root-exists $root-name $matched $engine-hash))))))))
(= (eio:repin-date $runs $pin-date)
   (if (== $runs ()) JsonNull
     (let* (($last (index-atom $runs (- (size-atom $runs) 1)))
            ($last-at (eio:field $last "at" JsonNull)))
       (if (eio:number? $last-at) (eio:local-date $last-at) $pin-date))))
(= (eio:session $coding-dir $id)
   (let* (($session (eio:child $coding-dir $id))
          ($state (eio:read-json (eio:child $session "state.json")))
          ($runtime-path (eio:child $session "runtime.json"))
          ($runtime-exists (eio:is-file? $runtime-path))
          ($runtime (if $runtime-exists (eio:read-json $runtime-path) (JsonObject ())))
          ($lifecycle (eio:read-lifecycle $session))
          ($root (eio:field $runtime "root" JsonNull))
          ($binary (eio:field $runtime "binary" JsonNull))
          ((EioWorldFactsV1 $root-exists $observed-name $world-matched $engine-hash)
           (eio:world-facts $root $binary))
          ($root-name (if (== (eio:field $runtime "root" EioAbsent) EioAbsent) "" $observed-name))
          ($matched (if $runtime-exists $world-matched ()))
          ($pin-date (if $runtime-exists (eio:file-date $runtime-path) ""))
          ($runs (eio:read-runs $session))
          ($repin-date (eio:repin-date $runs $pin-date))
          ($status-date (eio:status-date $session $state))
          ($launch-at (eio:field $runtime "at" JsonNull))
          ($launching-date (if (eio:number? $launch-at)
                             (eio:local-date $launch-at) $status-date)))
     (JsonObject
       ((JsonPair "id" $id)
        (JsonPair "state" $state)
        (JsonPair "runtime" $runtime)
        (JsonPair "lifecycle" $lifecycle)
        (JsonPair "runtime_exists" $runtime-exists)
        (JsonPair "root_exists" $root-exists)
        (JsonPair "root_name" $root-name)
        (JsonPair "matched" (JsonArray $matched))
        (JsonPair "engine_hash" $engine-hash)
        (JsonPair "pin_date" $pin-date)
        (JsonPair "status_date" $status-date)
        (JsonPair "launching_date" $launching-date)
        (JsonPair "runs_count" (size-atom $runs))
        (JsonPair "repin_date" $repin-date)))))

(= (eio:any-matched? $sessions)
   (if (== $sessions ()) False
     (let $matched (eio:field (car-atom $sessions) "matched" (JsonArray ()))
       (case $matched
         (((JsonArray ()) (eio:any-matched? (cdr-atom $sessions)))
          ((JsonArray $nonempty) True)
          ($other (eio:any-matched? (cdr-atom $sessions))))))))
(= (eio:runtime-entry $runtimes-dir $id)
   (JsonObject
     ((JsonPair "id" $id)
      (JsonPair "blocks" (eio:dir-blocks (eio:child $runtimes-dir $id))))))

(= (eio:today-string $today)
   (let $text (if (== (get-type $today) String) $today (eio:py-str $today))
     (if (== $text "") (eio:local-date (system:wall-time)) $text)))

(= (eio:snapshot $root $today)
   (let* (($_ (change-state! &eio-world-cache ()))
          ($base (if (== $root ()) (system:cwd)
                   (if (== (get-type $root) String) (eio:path $root)
                     (eio:path (eio:py-str $root)))))
          ($coding-dir (eio:child $base "memory/coding"))
          ($settings (eio:read-json (eio:child $base "memory/coding-settings.json")))
          (($available $session-ids) (eio:coding-subdirs $coding-dir))
          ($today-str (eio:today-string $today))
          ($sessions (map-atom $session-ids $sid (eio:session $coding-dir $sid)))
          ($selection (if (eio:any-matched? $sessions)
                        (JsonObject ((JsonPair "llm-ledger-sqlite" (eio:llm-ledger-selection))))
                        (JsonObject ())))
          ($runtimes-dir (eio:child $base "memory/coding-runtimes"))
          ($runtime-ids (eio:runtime-subdirs $runtimes-dir))
          ($runtimes (map-atom $runtime-ids $rid (eio:runtime-entry $runtimes-dir $rid))))
     (JsonObject
       ((JsonPair "available" $available)
        (JsonPair "mode" (eio:field $settings "context" "open"))
        (JsonPair "today" $today-str)
        (JsonPair "selection" $selection)
        (JsonPair "sessions" (JsonArray $sessions))
        (JsonPair "runtimes" (JsonArray $runtimes))))))
