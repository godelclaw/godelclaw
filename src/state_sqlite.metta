; Native access to the existing checkpoint. This file does not install a
; schema, change journal mode or rewrite identities.
!(import! &self (library sqlite))
!(import! &self ./src/state_cetta)

(= (state:checkpoint)
   (system:getenv-or-default "METTACLAW_STRATEGY_PATH"
     (path:join (path:dirname (system:getenv-or-default "METTACLAW_ENGINE_STATE_PATH" "memory/engine"))
                "observed-strategy.sqlite3")))
(= (state:busy-ms)
   (parse (system:getenv-or-default "METTACLAW_SQLITE_BUSY_MS" "10000")))
(= (state:query $sql $parameters)
   (sqlite:query (state:checkpoint) $sql $parameters (state:busy-ms)))
(= (state:transaction $mode $statements)
   (sqlite:transaction (state:checkpoint) $mode $statements (state:busy-ms)))
(= (state:rows $answer)
   (case $answer
     (((sqlite:result $_ $rows $_ $_) $rows)
      ($error (Error native-state-query $error)))))
(= (state:value $value)
   (case $value
     ((sqlite:null JsonNull)
      ((sqlite:blob $bytes) (JsonObject ((JsonPair "blob" (JsonString (repr $bytes))))))
      ($other
        (case (get-type $value)
          ((String (JsonString $value))
           (Number (JsonNumber (repr $value)))
           ($type (JsonString (repr $value)))))))))
(= (state:row-pairs $names $values)
   (if (== $names ()) ()
     (cons-atom (JsonPair (car-atom $names) (state:value (car-atom $values)))
       (state:row-pairs (cdr-atom $names) (cdr-atom $values)))))
(= (state:objects $names $rows)
   (if (== $rows ()) ()
     (let $pairs (state:row-pairs $names (car-atom $rows))
       (cons-atom (JsonObject $pairs) (state:objects $names (cdr-atom $rows))))))
(= (state:query-objects $sql $parameters)
   (case (state:query $sql $parameters)
     (((sqlite:result $names $rows $_ $_) (state:objects $names $rows))
      ($error (Error native-state-query $error)))))
(= (state:json-keys $pairs)
   (if (== $pairs ()) ()
     (let (JsonPair $key $_) (car-atom $pairs)
       (cons-atom $key (state:json-keys (cdr-atom $pairs))))))
; Members are read from the pairs themselves: json-object-get converts the
; whole object on each call, which made encoding quadratic in its size.
(= (state:json-member $pairs $key)
   (if (== $pairs ()) JsonNull
     (let (JsonPair $name $child) (car-atom $pairs)
       (if (== $name $key) $child (state:json-member (cdr-atom $pairs) $key)))))
(= (state:json-field $value $key)
   (case $value (((JsonObject $pairs) (state:json-member $pairs $key)) ($other JsonNull))))
(= (state:canonical-members $pairs $keys)
   (if (== $keys ()) ()
     (let* (($key (car-atom $keys)) ($child (state:json-member $pairs $key))
            ($next (state:canonical $child)))
       (cons-atom (JsonPair $key $next) (state:canonical-members $pairs (cdr-atom $keys))))))
(= (state:canonical-array $items)
   (if (== $items ()) ()
     (cons-atom (state:canonical (car-atom $items)) (state:canonical-array (cdr-atom $items)))))
(= (state:canonical $value)
   (case $value
     (((JsonObject $pairs)
       (let* (($keys (sort-strings (state:json-keys $pairs)))
              ($members (state:canonical-members $pairs $keys))) (JsonObject $members)))
      ((JsonArray $items) (let $next (state:canonical-array $items) (JsonArray $next)))
      ($other $other))))
(= (state:encoded $value) (json-stringify (state:canonical $value)))
(= (state:meta $key)
   (let $rows (state:rows (state:query "SELECT value FROM meta WHERE key=?" ($key)))
     (if (== $rows ()) JsonNull (json-parse (car-atom (car-atom $rows))))))
(= (state:text $value)
   (case $value (((JsonString $text) $text)
                ((JsonNumber $text) $text)
                ($other (repr $other)))))

; Names are SQL-bound text. Topics may contain Unicode, spaces or punctuation.
(= (topics:native-init)
   (state:transaction immediate
     ((sqlite:statement "CREATE TABLE IF NOT EXISTS topic_contexts (name TEXT PRIMARY KEY, revision INTEGER NOT NULL, notes TEXT NOT NULL)" ())
      (sqlite:statement "INSERT OR IGNORE INTO topic_contexts VALUES ('conversation',0,'')" ())
      (sqlite:statement "INSERT OR IGNORE INTO meta VALUES ('active_topic','\"conversation\"')" ()))))
(= (topic-select $name)
   (let* (($_ (topics:native-init)) ($encoded (state:encoded (JsonString $name))))
     (case (state:transaction immediate
       ((sqlite:statement "INSERT OR IGNORE INTO topic_contexts VALUES (?,0,'')" ($name))
        (sqlite:statement "UPDATE meta SET value=? WHERE key='active_topic'" ($encoded))))
       (((sqlite:committed $_) (str:concat "active topic: " $name))
        ($error (str:concat "topic-select: " (repr $error)))))))
(= (topic-note $text)
   (progn (topics:native-init)
     (case (state:query "UPDATE topic_contexts SET revision=revision+1,notes=? WHERE name=json_extract((SELECT value FROM meta WHERE key='active_topic'),'$')" ($text))
       (((sqlite:result $_ $_ 1 $_) "saved topic notes")
        ($error (str:concat "topic-note: " (repr $error)))))))
(= (topics)
   (progn (topics:native-init)
     (let $rows (state:query-objects "SELECT name,revision FROM topic_contexts ORDER BY name" ())
       (state:encoded (JsonObject ((JsonPair "active" (state:meta "active_topic"))
                                  (JsonPair "topics" (JsonArray $rows))))))))
(= (topics:context)
   (progn (topics:native-init)
     (let $rows (state:query-objects "SELECT name,notes FROM topic_contexts WHERE name=json_extract((SELECT value FROM meta WHERE key='active_topic'),'$') AND notes<>''" ())
       (if (== $rows ()) "" (str:concat "TOPIC_NOTES " (state:encoded (car-atom $rows)))))))
