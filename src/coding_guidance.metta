; Repository-instruction discovery: Codex 6aaac69480, core/src/agents_md.rs.
; Selection and scope follow that reference. Complete text is retained rather
; than applying its optional byte clipping. All filesystem work is native.
!(import! &self fs)
!(import! &self path)
!(import! &self str)
!(import! &self json)
!(import! &self system)
!(import! &self ./src/coding_values.metta)

(= (guidance:configuration)
   (case (catch
     (let* (($home (system:getenv-or-default "METTACLAW_CODING_GUIDANCE_DIR" (path:join (system:cwd) "identity")))
            ($markers (json-parse (system:getenv-or-default "METTACLAW_CODING_ROOT_MARKERS" "[\".git\"]")))
            ($fallbacks (json-parse (system:getenv-or-default "METTACLAW_CODING_DOC_FALLBACKS" "[]"))))
       (JsonObject ((JsonPair "home" (JsonString (if (== $home "") "" (path:join (system:cwd) $home))))
                    (JsonPair "root_markers" $markers) (JsonPair "fallback_filenames" $fallbacks)))))
     (((JsonObject $pairs) (guidance:check-options (JsonObject $pairs)))
      ($bad (GuidanceFailed "Invalid coding guidance configuration.")))))
(= (guidance:contains? $text $needle)
   (case (str:find $text $needle) (((TextNotFound $_) False) ($found True))))
(= (guidance:filename? $name)
   (if (== (get-type $name) String)
     (if (or (== $name "") (or (== $name ".") (== $name ".."))) False
       (if (guidance:contains? $name "/") False (not (guidance:contains? $name "\u0000")))) False))
(= (guidance:names? $items)
   (if (== $items ()) True
     (case (car-atom $items)
       (((JsonString $name) (if (guidance:filename? $name) (guidance:names? (cdr-atom $items)) False))
        ($bad False)))))
(= (guidance:check-options $options)
   (case ((coding:field $options "home") (coding:field $options "root_markers") (coding:field $options "fallback_filenames"))
     ((((JsonString $home) (JsonArray $markers) (JsonArray $fallbacks))
       (if (and (guidance:names? $markers) (guidance:names? $fallbacks))
         (GuidanceOptions $options) (GuidanceFailed "Guidance markers and fallbacks must be filenames.")))
      ($bad (GuidanceFailed "Invalid coding guidance configuration.")))))
(= (guidance:workspace $path)
   (case (fs:try-canonical-path $path)
     (((FS:CanonicalPath $canonical)
       (case (fs:metadata $canonical follow)
         (((fs:info directory $_ $_) (GuidanceWorkspace $canonical))
          ($bad (GuidanceFailed "The coding workspace must be an existing directory.")))))
      ($bad (GuidanceFailed "The coding workspace cannot be resolved.")))))

(= (guidance:marker $directory $markers)
   (if (== $markers ()) GuidanceAbsent
     (let* (((JsonString $name) (car-atom $markers))
            ($path (path:join $directory $name)))
       (case (fs:metadata $path follow)
         (((fs:info $_ $_ $_) GuidancePresent)
          ((fs:failed fs:missing $_ $_ $_ $_ $_) (guidance:marker $directory (cdr-atom $markers)))
          ($bad (GuidanceFailed (str:concat "Cannot inspect repository marker: " $path))))))))
(= (guidance:find-root $here $markers)
   (case (guidance:marker $here $markers)
     ((GuidancePresent (GuidanceRoot $here))
      (GuidanceAbsent
        (let $parent (path:dirname $here)
          (if (== $parent $here) GuidanceAbsent (guidance:find-root $parent $markers))))
      ($failure $failure))))
(= (guidance:directories $here $root $out)
   (let $next (cons-atom $here $out)
     (if (== $here $root) $next (guidance:directories (path:dirname $here) $root $next))))

(= (guidance:read $path $scope $kind)
   (case (fs:read-text-result $path 0 replace)
     ((("ok" $raw)
       (let $text (if (== $kind "global") (str:trim $raw) $raw)
         (if (== (str:trim $text) "") GuidanceAbsent
           (GuidanceSource (JsonObject ((JsonPair "path" (JsonString $path))
             (JsonPair "scope" (JsonString $scope)) (JsonPair "kind" (JsonString $kind))
             (JsonPair "text" (JsonString $text)) (JsonPair "text_sha256" (JsonString (str:sha256 $text)))
             (JsonPair "text_bytes" (JsonNumber (repr (str:byte-length $text))))))))))
      (("missing" $_) GuidanceAbsent)
      ($failure (GuidanceFailed (str:concat "Cannot read coding guidance: " $path))))))
; A project chooses its first regular file, even when that file is empty.
; Global guidance chooses the first nonempty file instead.
(= (guidance:select $directory $names $kind)
   (if (== $names ()) GuidanceAbsent
     (let* (($name (car-atom $names)) ($path (path:join $directory $name)))
       (case (fs:metadata $path follow)
         (((fs:info regular $_ $_)
           (let $read (guidance:read $path $directory $kind)
             (if (and (== $kind "global") (== $read GuidanceAbsent))
               (guidance:select $directory (cdr-atom $names) $kind) $read)))
          ((fs:info $_ $_ $_) (guidance:select $directory (cdr-atom $names) $kind))
          ((fs:failed fs:missing $_ $_ $_ $_ $_) (guidance:select $directory (cdr-atom $names) $kind))
          ($bad (GuidanceFailed (str:concat "Cannot inspect coding guidance: " $path))))))))
(= (guidance:project $directories $names)
   (if (== $directories ()) (GuidanceSources ())
     (case (guidance:select (car-atom $directories) $names "project")
       (((GuidanceFailed $why) (GuidanceFailed $why))
        ($selected
          (case (guidance:project (cdr-atom $directories) $names)
            (((GuidanceSources $tail)
               (case $selected
                 (((GuidanceSource $source) (GuidanceSources (cons-atom $source $tail)))
                  (GuidanceAbsent (GuidanceSources $tail)))))
             ($failure $failure))))))))
(= (guidance:fallback-names $names)
   (if (== $names ()) ()
     (let (JsonString $name) (car-atom $names)
       (cons-atom $name (guidance:fallback-names (cdr-atom $names))))))
(= (guidance:collect $workspace $options)
   (let* (($markers (coding:items (coding:field $options "root_markers")))
          ($root (guidance:find-root $workspace $markers))
          ($home (coding:text (coding:field $options "home")))
          ($global (if (== $home "") GuidanceAbsent
                     (guidance:select $home ("AGENTS.override.md" "AGENTS.md") "global"))))
     (case ($root $global)
       ((((GuidanceFailed $why) $_) (GuidanceFailed $why))
        (($_ (GuidanceFailed $why)) (GuidanceFailed $why))
        (($found $selected)
          (let* (($top (case $found (((GuidanceRoot $path) $path) (GuidanceAbsent $workspace))))
                 ($directories (guidance:directories $workspace $top ()))
                 ($extra (guidance:fallback-names (coding:items (coding:field $options "fallback_filenames"))))
                 ($names (cons-atom "AGENTS.override.md" (cons-atom "AGENTS.md" $extra))))
            (case (guidance:project $directories $names)
              (((GuidanceSources $sources)
                (let $all (case $selected (((GuidanceSource $source) (cons-atom $source $sources)) (GuidanceAbsent $sources)))
                  (GuidanceCollected $top $all)))
               ($failure $failure)))))))))
(= (guidance:paragraphs $sources)
   (if (== $sources ()) ()
     (let* (($source (car-atom $sources))
            ($heading (if (== (coding:field $source "kind") (JsonString "global")) "## Global coding guidance"
                         (str:concat "## Project guidance for " (coding:text (coding:field $source "scope")))))
            ($text (str:join "" ($heading
              "\nSource: " (coding:text (coding:field $source "path"))
              "\n<INSTRUCTIONS>\n" (coding:text (coding:field $source "text")) "\n</INSTRUCTIONS>")))
            ($tail (guidance:paragraphs (cdr-atom $sources))))
       (cons-atom $text $tail))))
(= (guidance:messages $payload $digest)
   (let $sources (coding:items (coding:field $payload "sources"))
     (if (== $sources ()) ()
       (let* (($paragraphs (guidance:paragraphs $sources))
              ($text (str:join "" ("# AGENTS.md instructions for " (coding:text (coding:field $payload "workspace"))
                "\n\nGlobal guidance applies throughout this task. Project sources follow from repository root to working directory; more local guidance takes precedence for files in its scope. Direct instructions from the requester take precedence over these files.\n\n"
                (str:join "\n\n" $paragraphs)))))
         ((JsonObject ((JsonPair "role" (JsonString "user")) (JsonPair "content" (JsonString $text))
                       (JsonPair "_coding_guidance" (JsonString $digest)))))))))
(= (guidance:store $directory $workspace $options $root $sources)
   (let* (($payload (JsonObject ((JsonPair "workspace" (JsonString $workspace))
              (JsonPair "project_root" (JsonString $root)) (JsonPair "settings" $options)
              (JsonPair "sources" (JsonArray $sources)))))
          ($digest (str:sha256 (json-stringify $payload)))
          ($snapshot (JsonObject ((JsonPair "version" (JsonNumber "1"))
                      (JsonPair "payload" $payload) (JsonPair "sha256" (JsonString $digest)))))
          ($written (fs:update-text (path:join $directory "guidance.json") "replace" (json-stringify $snapshot) "" "")))
     (case $written
       ((("written" $_ $_ $_ $_) (GuidanceReady (guidance:messages $payload $digest)))
        ($failed (GuidanceFailed "Cannot save the coding guidance snapshot."))))))
(= (guidance:restore $directory $workspace)
   (case (catch (json-parse (fs:read-text (path:join $directory "guidance.json"))))
     (((JsonObject $pairs)
       (let* (($snapshot (JsonObject $pairs)) ($payload (coding:field $snapshot "payload"))
              ($digest (coding:text (coding:field $snapshot "sha256"))))
         (if (and (== (coding:field $snapshot "version") (JsonNumber "1"))
              (and (== (coding:field $payload "workspace") (JsonString $workspace))
                   (== $digest (str:sha256 (json-stringify $payload)))))
           (GuidanceReady (guidance:messages $payload $digest))
           (GuidanceFailed "Saved coding guidance does not match its workspace or digest."))))
      ($bad (GuidanceFailed "Saved coding guidance is unreadable or invalid.")))))
(= (guidance:prepare $directory $workspace $given)
   (case (fs:metadata (path:join $directory "guidance.json") follow)
     (((fs:info regular $_ $_) (guidance:restore $directory $workspace))
      ((fs:failed fs:missing $_ $_ $_ $_ $_)
        (case (if (== $given JsonNull) (guidance:configuration) (guidance:check-options $given))
          (((GuidanceOptions $options)
            (case (guidance:collect $workspace $options)
              (((GuidanceCollected $root $sources) (guidance:store $directory $workspace $options $root $sources))
               ($failure $failure))))
           ($failure $failure))))
      ($bad (GuidanceFailed "Cannot open the coding guidance snapshot.")))))
