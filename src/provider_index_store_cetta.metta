; Inactive indexed provider storage. All logical index maintenance is MeTTa.
; Apply uses an explicit epoch/revision and conservative commit validation.
; A transition adapter may instead retain its original view and combine the
; returned mutation footprint with its complete query dependencies.
; These are decoded record/checkpoint operations, not SQL assignments. They
; do not coerce columns or enforce domain uniqueness. The transaction gateway
; must validate those constraints against its view and same-plan mutations
; before publication; no live provider gateway selects this module yet.
!(import! &self ./provider_indexes_cetta.metta)

(= (provider-index:layout-key) (provider-store:index-layout-key))
(= (provider-index:layout $view)
  (case (store:get $view (provider-index:layout-key) 256)
    (((StoreValue $bytes)
      (case (store:decode $bytes)
        (((StoreDecoded (ProviderIndexLayoutV1 1)) ProviderIndexLayoutReadyV1)
         ($other (ProviderIndexRefusedV1 unsupported-layout)))))
     (StoreAbsent (ProviderIndexRefusedV1 layout-not-initialized))
     ($error $error))))

(= (provider-index:initialize-view $owner $view $epoch $revision)
  (case (provider-index:layout $view)
    ((ProviderIndexLayoutReadyV1 (ProviderIndexedReadyV1 $epoch $revision))
     ((ProviderIndexRefusedV1 layout-not-initialized)
       (provider-index:initialize-empty $owner $view))
     ($error $error))))

(= (provider-index:initialize-empty $owner $view)
  (case (store:scan-open $view NoBound NoBound)
    (((StoreScan $scan)
      (let* (($first (store:scan-next $scan 0)) ($closed (store:close $scan)))
        (case $first
          ((StoreEnd (provider-index:publish-layout $owner $view))
           ((StoreKey $key $bytes $next) (ProviderIndexRefusedV1 nonempty-unindexed-store))
           ($error $error)))))
     ($error $error))))

(= (provider-index:publish-layout $owner $view)
  (case (store:encode (ProviderIndexLayoutV1 1))
    (((StoreEncoded $bytes)
      (let $key (provider-index:layout-key)
        (case (store:commit-scoped $owner $view (reads (range NoBound NoBound))
                (writes (point $key)) (ops (put $key $bytes)))
          (((StoreSnapshot $updated $epoch $after)
            (let $closed (store:close $updated) (ProviderIndexedReadyV1 $epoch $after)))
           ($error $error)))))
     ($error $error))))

(= (provider-index:create $path)
  (case (store:open $path "create")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (provider-index:initialize-view $owner $view $epoch $revision))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (provider-index:overlay $overlay $key)
  (if (== $overlay ()) ProviderIndexOverlayMissingV1
    (let (ProviderIndexOverlayV1 $stored $value) (car-atom $overlay)
      (if (== $stored $key) $value (provider-index:overlay (cdr-atom $overlay) $key)))))

(= (provider-index:old $view $overlay $key)
  (case (provider-index:overlay $overlay $key)
    ((ProviderIndexOverlayMissingV1
      (case (store:get $view $key 1048576)
        ((StoreAbsent ProviderIndexAbsentV1)
         ((StoreValue $bytes)
           (case (store:decode $bytes)
             (((StoreDecoded $row)
               (if (== (provider-store:key $row) $key) (ProviderIndexPresentV1 $row $bytes)
                 (ProviderIndexRefusedV1 stored-record-key)))
              ($error $error))))
         ($error $error))))
     ($value $value))))

(= (provider-index:entry-ops $entries $remove $operations $scopes)
  (if (== $entries ()) (ProviderIndexAccumulatedV1 $operations $scopes)
    (let (ProviderIndexEntryV1 $key $bytes) (car-atom $entries)
      (let* (($operation (if $remove (remove $key) (put $key $bytes)))
             ($next (cons-atom $operation $operations))
             ($writes (cons-atom (point $key) $scopes)))
        (provider-index:entry-ops (cdr-atom $entries) $remove $next $writes)))))

(= (provider-index:prepare-one $view $overlay $verb $row $key $encoded $operations $scopes)
  (let $old (provider-index:old $view $overlay $key)
    (case $old
      ((ProviderIndexAbsentV1
        (if (== $verb remove) (ProviderIndexRefusedV1 missing-row)
          (provider-index:replace-prepared $overlay $verb $row $key $encoded $old $operations $scopes)))
       ((ProviderIndexPresentV1 $before $bytes)
         (if (== $verb add) (ProviderIndexRefusedV1 existing-row)
           (if (== $verb remove)
             (if (== $bytes $encoded)
               (provider-index:replace-prepared $overlay $verb $row $key $encoded $old $operations $scopes)
               (ProviderIndexRefusedV1 row-precondition))
             (provider-index:replace-prepared $overlay $verb $row $key $encoded $old $operations $scopes))))
       ($error $error)))))

(= (provider-index:replace-prepared $overlay $verb $row $key $encoded $old $operations $scopes)
  (let $after-fields (if (== $verb remove) () (provider-index:fields $row))
    (case $old
      ((ProviderIndexAbsentV1
        (provider-index:replace-delta $overlay $verb $row $key $encoded () $after-fields $operations $scopes))
       ((ProviderIndexPresentV1 $before $bytes)
         (case (provider-index:changed-fields (provider-index:fields $before) $after-fields () ())
           (((ProviderIndexFieldChangesV1 $removed $added)
             (provider-index:replace-delta $overlay $verb $row $key $encoded $removed $added $operations $scopes))
            ($error $error))))
       ($error $error)))))

(= (provider-index:replace-delta $overlay $verb $row $key $encoded $removed $added $operations $scopes)
  (case (provider-index:entries-selected $row $removed)
    (((ProviderIndexEntriesV1 $previous)
      (case (provider-index:entry-ops $previous True $operations $scopes)
        (((ProviderIndexAccumulatedV1 $without-old $old-scopes)
          (let* (($primary (if (== $verb remove) (remove $key) (put $key $encoded)))
                 ($with-primary (cons-atom $primary $without-old))
                 ($primary-scopes (cons-atom (point $key) $old-scopes))
                 ($state (if (== $verb remove) ProviderIndexAbsentV1 (ProviderIndexPresentV1 $row $encoded)))
                 ($next-overlay (cons-atom (ProviderIndexOverlayV1 $key $state) $overlay)))
            (if (== $verb remove) (ProviderIndexPreparedV1 $next-overlay $with-primary $primary-scopes)
              (case (provider-index:entries-selected $row $added)
                (((ProviderIndexEntriesV1 $next)
                  (case (provider-index:entry-ops $next False $with-primary $primary-scopes)
                    (((ProviderIndexAccumulatedV1 $after $new-scopes)
                      (ProviderIndexPreparedV1 $next-overlay $after $new-scopes))
                     ($error $error))))
                 ($error $error))))))
         ($error $error))))
     ($error $error))))

(= (provider-index:prepare $view $remaining $overlay $operations $scopes)
  (if (== $remaining ())
    (let* (($ordered (provider-store:reverse $operations ()))
           ($writes (provider-store:reverse $scopes ())))
      (ProviderIndexMutationPlanV1 (cons-atom ops $ordered) (cons-atom writes $writes)))
    (case (car-atom $remaining)
      ((($verb $row)
        (provider-index:prepare-mutation $view $remaining $overlay $verb $row $operations $scopes))
       ($other (ProviderIndexRefusedV1 mutation-shape))))))

(= (provider-index:prepare-mutation $view $remaining $overlay $verb $row $operations $scopes)
  (if (or (== $verb put) (or (== $verb add) (== $verb remove)))
    (case (provider-store:key $row)
      (((ProviderStoreRefused $why) (ProviderIndexRefusedV1 $why))
       ($key
        (case (store:encode $row)
          (((StoreEncoded $encoded)
            (case (provider-index:prepare-one $view $overlay $verb $row $key $encoded $operations $scopes)
              (((ProviderIndexPreparedV1 $next $after $writes)
                (provider-index:prepare $view (cdr-atom $remaining) $next $after $writes))
               ($error $error))))
           ($error $error))))))
    (ProviderIndexRefusedV1 unknown-mutation)))

(= (provider-index:apply-view $owner $view $epoch $revision $expected-epoch $expected-revision $mutations)
  (if (== $epoch $expected-epoch)
    (if (== $revision $expected-revision)
      (case (provider-index:plan-mutations $view $mutations)
        (((ProviderIndexDeltaV1 $operations $reads $writes)
          (case (store:commit $owner $view $operations)
            (((StoreSnapshot $updated $same-epoch $after)
              (let $closed (store:close $updated) (ProviderIndexAppliedV1 $same-epoch $after)))
             ($error $error))))
         ($error $error)))
      (ProviderStoreChanged $epoch $revision))
    (ProviderStoreChanged $epoch $revision)))

(= (provider-index:plan-mutations $view $mutations)
  (case (provider-index:layout $view)
    ((ProviderIndexLayoutReadyV1
      (case (provider-index:prepare $view $mutations () () ())
        (((ProviderIndexMutationPlanV1 $operations $writes)
          (let $layout-key (provider-index:layout-key)
            (ProviderIndexDeltaV1 $operations (reads (point $layout-key)) $writes)))
         ($error $error))))
     ($error $error))))

(= (provider-index:apply $path $expected-epoch $expected-revision $mutations)
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (provider-index:apply-view $owner $view $epoch $revision $expected-epoch $expected-revision $mutations))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

(= (provider-index-store:call (Create $path)) (provider-index:create $path))
(= (provider-index-store:call (Apply $path $epoch $revision $mutations))
   (provider-index:apply $path $epoch $revision $mutations))
