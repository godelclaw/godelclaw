; Reconcile overlapping ordered fragments by occurrence identity, never value.
!(import! &self ./scoped_observation_cetta.metta)
(= (obs:event-identity $event)
  (case $event
    (((ObservationWitnessV1 $id $payload) (obs:encode $id))
     ((ObservationFaultV1 $id $diagnostic) (obs:encode $id))
     ($bad (ObservationRefusedV1 occurrence $bad)))))
(= (obs:has-event-id? $id $events)
  (if (== $events ()) False
    (or (obs:same $id (obs:event-identity (car-atom $events)))
        (obs:has-event-id? $id (cdr-atom $events)))))
(= (obs:unique-events? $events)
  (if (== $events ()) True
    (let $id (obs:event-identity (car-atom $events))
      (and (== (get-type $id) String)
        (and (not (obs:has-event-id? $id (cdr-atom $events)))
             (obs:unique-events? (cdr-atom $events)))))))
(= (obs:weave-cons $head $result)
  (case $result
    (((ObservationEventsV1 $tail)
      (let $out (cons-atom $head $tail) (ObservationEventsV1 $out)))
     ($refused $refused))))
(= (obs:weave $left $right)
  (if (== $left ()) (ObservationEventsV1 $right)
    (if (== $right ()) (ObservationEventsV1 $left)
      (let* (($a (car-atom $left)) ($b (car-atom $right))
             ($aid (obs:event-identity $a)) ($bid (obs:event-identity $b)))
        (if (obs:same $aid $bid)
          (if (obs:same $a $b)
            (obs:weave-cons $a (obs:weave (cdr-atom $left) (cdr-atom $right)))
            (ObservationRefusedV1 occurrence-conflict ()))
          (let* (($a-later (obs:has-event-id? $aid $right))
                 ($b-later (obs:has-event-id? $bid $left)))
            (if (and $a-later $b-later) (ObservationRefusedV1 occurrence-order-conflict ())
              (if $a-later
                (obs:weave-cons $b (obs:weave $left (cdr-atom $right)))
                (obs:weave-cons $a (obs:weave (cdr-atom $left) $right))))))))))
(= (obs:event-subsequence? $small $large)
  (if (== $small ()) True
    (if (== $large ()) False
      (if (obs:same (car-atom $small) (car-atom $large))
        (obs:event-subsequence? (cdr-atom $small) (cdr-atom $large))
        (obs:event-subsequence? $small (cdr-atom $large))))))
(= (obs:overlap-coverage $left $right $events)
  (if (or (and (== (obs:coverage $left) ObservationClosedV1)
               (not (obs:same (obs:events $left) $events)))
          (and (== (obs:coverage $right) ObservationClosedV1)
               (not (obs:same (obs:events $right) $events))))
    (ObservationRefusedV1 closed-observation-changed ())
    (if (or (== (obs:coverage $left) ObservationClosedV1)
            (== (obs:coverage $right) ObservationClosedV1)) ObservationClosedV1
      (if (and (== (obs:coverage $left) ObservationNotStartedV1)
               (== (obs:coverage $right) ObservationNotStartedV1)) ObservationNotStartedV1
        (ObservationOpenV1 overlapping-fragments
          (ObservationBranchesV1 (obs:coverage $left) (obs:coverage $right)))))))
(= (obs:reconcile-overlap $left $right)
  (if (not (obs:same (obs:scope $left) (obs:scope $right)))
    (ObservationRefusedV1 scope-mismatch ())
    (let* (($a (obs:events $left)) ($b (obs:events $right)))
      (if (not (and (obs:unique-events? $a) (obs:unique-events? $b)))
        (ObservationRefusedV1 nonunique-or-malformed-occurrences ())
        (case (obs:weave $a $b)
          (((ObservationEventsV1 $events)
            (if (not (and (obs:event-subsequence? $a $events) (obs:event-subsequence? $b $events)))
              (ObservationRefusedV1 occurrence-order-conflict ())
              (let $coverage (obs:overlap-coverage $left $right $events)
                (case $coverage
                  (((ObservationRefusedV1 $reason $detail) $coverage)
                   ($valid (let* (($scope (obs:scope $left))
                                  ($dependencies (obs:append (obs:dependencies $left) (obs:dependencies $right))))
                     (ObservationReportV1 $scope $events $valid $dependencies))))))))
           ($refused $refused)))))))
