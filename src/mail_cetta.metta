!(import! &self mailbox)
!(import! &self system)
!(import! &self str)
!(import! &self (library io))
(= (mail:socket) (system:getenv-or-default "METTACLAW_MAIL_SOCKET" ""))
(= (mail:space) (system:getenv-or-default "METTACLAW_MAIL_SPACE" "agent-mail"))
(= (mail:name) (system:getenv-or-default "METTACLAW_MAIL_NAME" ""))
(= (mail:enabled?) (and (not (== (mail:socket) "")) (not (== (mail:name) ""))))
(= (mail:empty? $text) (== (str:byte-length $text) 0))
(= (mail:active?) (not (== (collapse (match &self (mail:prepared $id) $id)) ())))
; Preparation belongs to the current turn, not to an earlier failed turn.
; Clearing this view never consumes the durable ready delivery.
(= (mail:reset)
   (let $_ (mail:forget-ordinals (collapse (match &self (mail:reply-ordinal $id $n) ($id $n))))
     (mail:forget (collapse (match &self (mail:prepared $id) $id)))))
(= (mail:forget $ids)
   (if (== $ids ()) ()
     (let $id (car-atom $ids)
       (let $gone (remove-atom &self (mail:prepared $id)) (mail:forget (cdr-atom $ids))))))
(= (mail:forget-ordinals $pairs)
   (if (== $pairs ()) ()
     (let ($id $n) (car-atom $pairs)
       (let $gone (remove-atom &self (mail:reply-ordinal $id $n))
         (mail:forget-ordinals (cdr-atom $pairs))))))
(= (mail:clear-ordinal-for $incoming $ns)
   (if (== $ns ()) ()
     (let $n (car-atom $ns)
       (let $gone (remove-atom &self (mail:reply-ordinal $incoming $n))
         (mail:clear-ordinal-for $incoming (cdr-atom $ns))))))
; A reply's occurrence ID is the first 32 hex digits of SHA-256 over a
; length-prefixed encoding of (incoming-delivery-id, agent, ordinal-in-turn).
(= (mail:reply-id $incoming $agent $ordinal)
   (let $material
     (str:join ""
       ((str:number->string (str:byte-length $incoming)) ":" $incoming ":"
        (str:number->string (str:byte-length $agent)) ":" $agent ":"
        (str:number->string $ordinal)))
     (str:byte-slice (str:sha256 $material) 0 32)))
(= (mail:next-reply-ordinal $incoming)
   (let $current
     (case (collapse (match &self (mail:reply-ordinal $incoming $n) $n))
       ((() 0)
        ($ns (car-atom $ns))))
     (let $_ (mail:clear-ordinal-for $incoming (collapse (match &self (mail:reply-ordinal $incoming $n) $n)))
       (let $next (+ $current 1)
         (let $_ (add-atom &self (mail:reply-ordinal $incoming $next))
           $next)))))
(= (mail:text $value)
   (case (get-metatype $value)
     ((Symbol (str:symbol->string $value))
      (Grounded (if (== (get-type $value) String) $value (repr $value)))
      ($other (repr $value)))))
; Mail from another account carries the account the service authenticated:
; (from (account UID LOGIN) AGENT) reads as LOGIN/AGENT, the name to reply to.
(= (mail:who $sender)
   (case $sender
     (((from (account $uid $login) $agent) (str:join "" ((mail:text $login) "/" (mail:text $agent))))
      ((from (account $uid) $agent) (str:join "" ((mail:text $uid) "/" (mail:text $agent))))
      ($other (mail:text $other)))))
; LOGIN/AGENT is delivered into that account's own inbox space, mail@LOGIN;
; any other name is a peer on this account's space.
(= (mail:route $to)
   (case (str:split "/" $to)
     ((($account $agent) (mail:route-to (str:join "" ("mail@" $account)) $agent))
      ($other (mail:route-to (mail:space) $to)))))
(= (mail:send $to $body)
   (if (mail:enabled?)
     (let $id
       (case (collapse (match &self (mail:prepared $incoming) $incoming))
         ((() (space:request-id))
          ($prepared
           (let $incoming (car-atom $prepared)
             (mail:reply-id $incoming (mail:name) (mail:next-reply-ordinal $incoming))))))
       (mail:send-id $to $body $id))
     "MAIL_UNAVAILABLE: configure a native socket and agent name"))
(= (mail:send-id $to $body $id)
   (if (mail:enabled?)
     (case (mail:route $to)
       (((mail:route-to $space $recipient)
         (case (mailbox:send (mail:socket) $space $id $recipient (mail:name) $body)
           (((mailbox:sent $sent $status) (str:join "" ("MAILED " $to " id=" $sent)))
            ((MailboxFailure identity-conflict)
             (str:join "" ("MAIL_CONFLICT " $to " id=" $id ": already answered")))
            ((reply $_ error id-conflict)
             (str:join "" ("MAIL_CONFLICT " $to " id=" $id ": already answered")))
            ($error (let $text (repr $error) (str:join "" ("MAIL_ERROR " $text)))))))))
     "MAIL_UNAVAILABLE: configure a native socket and agent name"))
; Ready records survive failed turns and restarts. The loop acknowledges
; automatically after committing the turn; agents have no filing chore.
(= (mail:find $text $needle)
   (case (str:find $text $needle)
     (((TextNotFound $_) -1)
      ($at $at))))
(= (mail:strip-cr $line)
   (if (str:ends-with $line "\r")
     (str:byte-slice $line 0 (- (str:byte-length $line) 1))
     $line))
(= (mail:auto-keyword $raw)
   (let $semi (mail:find $raw ";")
     (let $head (if (< $semi 0) $raw (str:byte-slice $raw 0 $semi))
       (str:lower (str:trim $head)))))
; RFC 3834 Auto-Submitted in a leading RFC 5322 header block, where every line
; before the first blank line is Field-Name: value and the value is not "no".
(= (mail:header-auto? $lines $seen $auto)
   (if (== $lines ()) false
     (let $line (mail:strip-cr (car-atom $lines))
       (if (== $line "")
         (and $seen (and (not (== $auto "")) (not (== $auto "no"))))
         (let $colon (mail:find $line ":")
           (if (< $colon 1) false
             (let $name (str:byte-slice $line 0 $colon)
               (if (not (str:is-all-in graph $name)) false
                 (let $val (str:byte-slice $line (+ $colon 1) (str:byte-length $line))
                   (let $next-auto (if (== (str:lower $name) "auto-submitted")
                                     (mail:auto-keyword $val)
                                     $auto)
                     (mail:header-auto? (cdr-atom $lines) true $next-auto)))))))))))
(= (mail:auto-submitted? $body)
   (mail:header-auto? (str:split "\n" $body) false ""))
(= (mail:receive)
   (if (mail:enabled?)
     (case (mailbox:next (mail:socket) (mail:space) (mail:name))
       (((mailbox:idle) "")
        ((mailbox:delivery $id $sender $body)
         (let $presented (collapse (match &self (mail:prepared $id) $id))
           (let $saved (if (== $presented ()) (add-atom &self (mail:prepared $id)) ())
             (let $label (if (mail:auto-submitted? $body) "[automatic mail from " "[mail from ")
               (str:join "" ($label (mail:who $sender) "; id=" $id "] " $body))))))
        ($error (let $text (repr $error) (str:join "" ("MAIL_ERROR " $text))))))
     ""))
(= (mail:ack) (mail:ack-ids (collapse (match &self (mail:prepared $id) $id))))
(= (mail:ack-ids $ids)
   (if (== $ids ()) 1
     (let $id (car-atom $ids)
       (case (mailbox:ack (mail:socket) (mail:space) (mail:name) $id)
         (((mailbox:acked $id $_)
           (let $_ (mail:clear-ordinal-for $id (collapse (match &self (mail:reply-ordinal $id $n) $n)))
             (let $gone (remove-atom &self (mail:prepared $id)) (mail:ack-ids (cdr-atom $ids)))))
          ($error (let $_ (println! (MAIL_ACK_ERROR $error)) 0)))))))
(= (mail:pending?)
   (if (mail:enabled?)
     (let $space (mailbox:open (mail:socket) (mail:space))
       (case $space
         (((space $_ $_ $_ $_ $_ $_ $_)
           (let $owner (mail:name)
             (case (mailbox:one (mail:socket) $space (MailboxReady 1 $id $owner 0 () $id) $id)
               (((mailbox:found $_ ())
                 (case (mailbox:one (mail:socket) $space (MailboxPending 1 $owner $q $s $id) $id)
                   (((mailbox:found $_ ()) False)
                    ((mailbox:found $_ ($id)) True)
                    ($error False))))
                ((mailbox:found $_ ($id)) True)
                ($error False)))))
          ($error False))))
     False))
; The store registers the revision watch atomically. Telegram retains its
; polling interval; a mail arrival ends the native idle wait immediately.
(= (mail:idle-wait $milliseconds)
   (if (mail:enabled?)
     (let $space (mailbox:open (mail:socket) (mail:space))
       (case $space
         (((space $_ $_ $_ $_ $_ $_ $_)
           (if (mail:pending?) ()
             (case (mailbox:watch (mail:socket) $space $milliseconds)
               (((reply $_ ok $watch) ())
                ($error (mail:pause $milliseconds))))))
          ($error (mail:pause $milliseconds)))))
     ()))
; A disconnected store must not turn the ordinary idle interval into a spin.
(= (mail:pause $milliseconds)
   (let (io:pending $id) (io:submit (timer:after $milliseconds))
     (mail:pause-await $id $milliseconds)))
(= (mail:pause-await $id $milliseconds)
   (case (once (io:wait $id $milliseconds))
     (((io:idle) (mail:pause-await $id $milliseconds))
      ($result ()))))
