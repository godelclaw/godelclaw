; SPDX-License-Identifier: MIT
; Native Responses SSE: keep the terminal Response intact, including ordered
; output, opaque reasoning, tool identities and usage. Deltas are provisional.
!(import! &self llm)
!(import! &self str)

(= (responses:reverse $xs $out)
   (if (== $xs ()) $out (responses:reverse (cdr-atom $xs) (cons-atom (car-atom $xs) $out))))
(= (responses:field-value $line $prefix)
   (let $value (str:char-slice $line (str:char-length $prefix) (str:char-length $line))
     (if (str:starts-with $value " ") (str:char-slice $value 1 (str:char-length $value)) $value)))
(= (responses:terminal $event $value $state)
   (case $state
     (((ResponsesComplete $old) (ResponsesStreamError data-after-completion))
      ((ResponsesStreamError $why) $state)
      ($pending (responses:terminal-first $event $value)))))
(= (responses:terminal-first $event $value)
   (let* (($kind (llm:v1:get $value "type"))
          ($name (if (== $kind JsonNull) $event
                   (case $kind (((JsonString $text) $text) ($other "")))))
          ($response (llm:v1:get $value "response")))
     (if (and (not (== $event "")) (not (== $event $name)))
       (ResponsesStreamError conflicting-event-type)
       (case $name
         (("response.completed"
           (if (== (llm:v1:get $response "status") (JsonString "completed"))
             (ResponsesComplete $response) (ResponsesStreamError invalid-completed-response)))
          ("response.failed" (ResponsesStreamError (provider-failed $response)))
          ("response.incomplete" (ResponsesStreamError (provider-incomplete $response)))
          ("error" (ResponsesStreamError (provider-error $value)))
          ($progress ResponsesPending))))))
(= (responses:dispatch $event $data $state)
   (if (== $data ()) $state
     (let $text (str:join "\n" (responses:reverse $data ()))
       (if (== $text "[DONE]")
         (case $state (((ResponsesComplete $response) $state) ($other (ResponsesStreamError missing-completion))))
         (case (llm:v1:parse $text)
           (((llm:v1:failure $code) (ResponsesStreamError $code))
            ((JsonObject $pairs) (responses:terminal $event (JsonObject $pairs) $state))
            ($other (ResponsesStreamError expected-event-object))))))))
(= (responses:scan $lines $event $data $state)
   (case $state
     (((ResponsesStreamError $why) $state)
      ($other
       (if (== $lines ())
         (if (== $data ())
           (case $state (((ResponsesComplete $value) $state) ($pending (ResponsesStreamError missing-completion))))
           (ResponsesStreamError truncated-event))
         (responses:line (car-atom $lines) (cdr-atom $lines) $event $data $state))))))
(= (responses:line $line $tail $event $data $state)
   (if (== $line "")
     (let $next (responses:dispatch $event $data $state)
       (responses:scan $tail "" () $next))
     (if (str:starts-with $line "data:")
       (responses:scan $tail $event (cons-atom (responses:field-value $line "data:") $data) $state)
       (if (== $line "data")
         (responses:scan $tail $event (cons-atom "" $data) $state)
         (if (str:starts-with $line "event:")
           (responses:scan $tail (responses:field-value $line "event:") $data $state)
           (if (== $line "event") (responses:scan $tail "" $data $state)
             (responses:scan $tail $event $data $state)))))))
(= (responses:stream $body)
   (let* (($bom (str:from-codepoints (65279)))
          ($without-bom (if (str:starts-with $body $bom)
                           (str:char-slice $body 1 (str:char-length $body)) $body))
          ($crlf (str:join "\n" (str:split "\r\n" $without-bom)))
          ($text (str:join "\n" (str:split "\r" $crlf))))
     (responses:scan (str:split "\n" $text) "" () ResponsesPending)))

; Non-streaming Responses remain readable for compatible API endpoints.
(= (responses:body $body)
   (if (str:starts-with (str:trim $body) "{")
     (case (llm:v1:parse $body)
       (((llm:v1:failure $code) (ResponsesStreamError $code))
        ($value (ResponsesComplete $value))))
     (responses:stream $body)))
