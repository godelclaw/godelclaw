; Bounded line exchanges on native owned connections. No implicit retries.
!(import! &self (library io))
!(import! &self (library system))
!(import! &self (library math))
!(import! &self (library str))
!(import! &self (library list))
(= (rpc:await $id $deadline)
   (let $remaining (max 0 (math:ceil (/ (- $deadline (system:monotonic-ns)) 1000000)))
     (if (== $remaining 0)
       (let $_ (io:cancel $id) (RpcFailedV1 "timeout"))
       (case (io:try-wait $id (min 250 $remaining))
         (((io:idle) (rpc:await $id $deadline))
          ((io:event $same $result) $result)
          ($bad (RpcFailedV1 "transport-error")))))))
(= (rpc:perform $operation $deadline)
   (case (io:try-submit $operation)
     (((io:pending $id) (rpc:await $id $deadline))
      ($bad (RpcFailedV1 "submit-error")))))
(= (rpc:close $connection)
   (let $deadline (+ (system:monotonic-ns) 1000000000)
     (rpc:perform (tcp:close $connection) $deadline)))
(= (rpc:read-line $connection $deadline $maximum $reverse $bytes)
   (case (rpc:perform (tcp:receive $connection) $deadline)
     (((tcp:received $_ $chunk)
         (let* (($parts (str:split "\n" $chunk)) ($first (car-atom $parts))
                ($size (+ $bytes (str:byte-length $first))))
           (if (>= $size $maximum) (RpcFailedV1 "invalid-response")
             (if (> (size-atom $parts) 1)
               (let $line (str:join "" (list:reverse (cons-atom $first $reverse)))
                 (if (== (str:utf8-error $line) StrUtf8WellFormedV1)
                   (RpcReplyV1 $line) (RpcFailedV1 "invalid-response")))
               (rpc:read-line $connection $deadline $maximum (cons-atom $first $reverse) $size)))))
      ($bad (RpcFailedV1 "uncertain")))))
(= (rpc:line $endpoint $request $milliseconds $maximum)
   (let* (($deadline (+ (system:monotonic-ns) (* $milliseconds 1000000)))
          ($connected (rpc:perform (tcp:connect $endpoint $milliseconds $maximum pieces) $deadline)))
     (case $connected
       (((tcp:connected $connection)
         (let* (($sent (rpc:perform (tcp:send $connection $request) $deadline))
                ($reply (case $sent
                   (((tcp:sent $_) (rpc:read-line $connection $deadline $maximum () 0))
                    ($bad $bad))))
                ($_ (rpc:close $connection)))
           (case $reply
             (((RpcReplyV1 $text) (RpcReplyV1 $text))
              ($bad (RpcFailedV1 "uncertain"))))))
        ($bad (RpcFailedV1 "unreachable"))))))
