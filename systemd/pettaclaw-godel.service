[Unit]
Description=PeTTaClaw Gödel Telegram control plane and agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
NotifyAccess=all
WatchdogSec=180
WatchdogSignal=SIGKILL
WorkingDirectory=%h/pettaclaw-godel
Environment=HOME=%h
Environment=METTACLAW_SKIP_INITIALIZE=1
Environment=CETTA_BIN=%h/repos/CeTTa-runtime/cetta
EnvironmentFile=-%h/.config/pettaclaw/godel-runtime.env
EnvironmentFile=-%h/.config/pettaclaw/godel-telegram.env
Environment=METTACLAW_LIFECYCLE_PATH=%h/.local/state/pettaclaw-godel/lifecycle.json
Environment=METTACLAW_DEPLOYMENT_STATE_PATH=%h/.local/state/pettaclaw-godel/deployment.json
ExecStart=%h/pettaclaw-godel/run.sh
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
