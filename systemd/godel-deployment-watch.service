[Unit]
Description=Gödel deployment health, probation, and automatic rollback
After=pettaclaw-godel.service

[Service]
Type=oneshot
Environment=HOME=%h
ExecStart=%h/pettaclaw-godel/scripts/runtime_watch.py --root %h/pettaclaw-godel --service pettaclaw-godel.service --health %h/.local/state/pettaclaw-godel/telegram-health.json --working-set %h/pettaclaw-godel/memory/working_set.json --cognitive-health %h/.local/state/godel/cognitive-health.json --canonical-memory %h/pettaclaw-godel/memory/remembered/cettaclaw_memory.jsonl --chroma %h/pettaclaw-godel/chroma_db --deployment %h/.local/state/pettaclaw-godel/deployment.json --log %h/archive/godel-deployment-watch.jsonl --failures 3
SuccessExitStatus=1
