!(import! &self ../tests/input_lifecycle_cetta.metta)
(= (handoff-driver:run)
   (let* (($root (system:cwd)) ($sdk (nt:required-env "NATIVE_TEST_SDK"))
          ($core (nt:required-env "NATIVE_TEST_CORE")) ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($fixture (nt:required-env "NATIVE_TEST_HTTP_FIXTURE"))
          ($world (nq:world $root $sdk $core $artifacts $fixture "handoff"))
          ($owner (il:call $world "owner" ("handoff-fixture-ledger" "handoff:owner")))
          ($accepted (il:accept $world "input:evidence" "notification" "operator"))
          ((NativeProviderTestWorldV1 $r $s $c $directory $socket $base $peer $server $env $io) $world)
          ($program (nt:join $root "tests/fixtures/handoff_evidence_kernel.metta"))
          ($environment (preq:append $env (("METTACLAW_INPUT_LEDGER_SOCKET" $socket) ("HANDOFF_FIXTURE_DIR" $directory))))
          ($result (proc:run ((nt:join $core "cetta") "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" "--quiet" $program)
                    $root $environment 30000 1048576))
          ($saved (fs:write (nq:path $world "evidence-result.metta") (preq:repr $result)))
          ($output (nt:exit-ok $result))
          ($witness (nt:require handoff-native-child-finished (nt:contains $output "NATIVE_HANDOFF_EVIDENCE_PASSED")))
          ($he-accepted (il:accept $world "input:evidence-he" "notification" "operator"))
          ($he-env (nq:overlay-env $environment (("HANDOFF_FIXTURE_REQUEST" "input:evidence-he"))))
          ($he-result (proc:run ((nt:join $core "cetta") "--lang" "he" "--profile" "extended" "--import-mode" "ancestor-walk" "--quiet" $program)
                    $root $he-env 30000 1048576))
          ($he-saved (fs:write (nq:path $world "evidence-he-result.metta") (preq:repr $he-result)))
          ($he-witness (nt:require handoff-he-child-finished (nt:contains (nt:exit-ok $he-result) "NATIVE_HANDOFF_EVIDENCE_PASSED")))
          ($bad-env (nq:overlay-env $environment (("METTACLAW_INPUT_LEDGER_SOCKET" (nq:path $world "missing.sock")) ("HANDOFF_EXPECT_UNAVAILABLE" "1"))))
          ($bad-result (proc:run ((nt:join $core "cetta") "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" "--quiet" $program)
                    $root $bad-env 30000 1048576))
          ($bad-saved (fs:write (nq:path $world "evidence-disconnected-result.metta") (preq:repr $bad-result)))
          ($bad-witness (nt:require handoff-disconnected-child-finished (nt:contains (nt:exit-ok $bad-result) "PASS disconnected-ledger-is-unavailable")))
          ($kernel (preq:repr (nt:join $root "tests/fixtures/context_handoff_kernel.metta")))
          ($forms (format-args "!(import! &self {})\n" ($kernel)))
          ($integration (nq:output (nq:guest $world "fixture-model" "petta" $forms (("HANDOFF_FIXTURE_DIR" $directory)))))
          ($integrated-check (nt:require actual-context-handoff-finished (nt:contains $integration "NATIVE_CONTEXT_HANDOFF_PASSED")))
          ($no-provider-check (nt:require handoff-checks-make-no-provider-request (nt:equal (nq:posts $world) 0)))
          ($reopened (nq:restart-ledger $world))
          ($module (preq:repr (nt:join $root "src/context_compaction.metta")))
          ($recovery-forms (format-args "!(import! &self {})\n!(nt:require recovered-checkpoint-claims (nt:equal (size-atom (task:items (state:meta (task:window-key \"conversation:handoff-fixture-ledger\")) \"claims\")) 1))\n!(println! NATIVE_HANDOFF_REOPENED)\n" ($module)))
          ($recovered (nq:output (nq:guest $reopened "fixture-model" "petta" $recovery-forms ())))
          ($recovery-check (nt:require handoff-survives-ledger-restart (nt:contains $recovered "NATIVE_HANDOFF_REOPENED")))
          ($closed (nq:close $reopened))) NativeHandoffDriverPassedV1))
!(nt:require handoff-driver-completed (nt:equal (collapse (handoff-driver:run)) (NativeHandoffDriverPassedV1)))
!(println! NATIVE_HANDOFF_DRIVER_PASSED)
