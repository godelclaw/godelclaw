; Run from the checkout root with explicit core, SDK and artifact directories.
; The coordinator is a Python-disabled CeTTa executable; all fixture state is local.
!(import! &self ../tests/provider_native_qualification.metta)
!(import! &self ../tests/native_framework_controls.metta)
(= (native-provider-test:run)
   (let* (($root (system:cwd)) ($sdk (nt:required-env "NATIVE_TEST_SDK"))
          ($core (nt:required-env "NATIVE_TEST_CORE")) ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($_ (fs:make-directories $artifacts 448))
          ($_ (nq:bundle $core True)) ($_ (nq:bundle $sdk False))
          ($_ (nf:run $core $artifacts))
          ($fixture (nt:join $artifacts "native-http-peer"))
          ($source (nt:join $root "tests/fixtures/native_http_peer.c"))
          ($env (nq:base-env $root $artifacts))
          ($_ (nt:exit-ok (proc:run ("cc" "-std=c11" "-O2" "-Wall" "-Wextra" "-Werror" $source "-o" $fixture)
                                    $root $env 30000 65536)))
          ($_ (request-test:run))
          ($_ (nq:provider-case $root $sdk $core $artifacts $fixture "synthetic" "fixture-model" "chat-completions" "petta"))
          ($_ (nq:provider-case $root $sdk $core $artifacts $fixture "kimi" "kimi:k3.1-pro" "responses" "petta"))
          ($_ (nq:provider-case $root $sdk $core $artifacts $fixture "openai" "openai:fixture" "responses" "petta"))
          ($_ (nq:provider-case $root $sdk $core $artifacts $fixture "anthropic" "claude-fixture" "anthropic" "petta"))
          ($_ (nq:provider-case $root $sdk $core $artifacts $fixture "he" "fixture-model" "chat-completions" "he"))
          ($_ (nq:refusal $root $sdk $core $artifacts $fixture "bad-role"
                 "!(nt:require no-provider-answer (nt:equal (llm:command \"fixture-model\" 42 \"low\" \"{\\\"kind\\\":\\\"role-context-v1\\\",\\\"messages\\\":[]}\") \"()\"))\n!(println! NATIVE_REFUSAL_OK)"))
          ($_ (nq:refusal $root $sdk $core $artifacts $fixture "bad-effort"
                 "!(nt:require no-provider-answer (nt:equal (llm:command \"fixture-model\" 42 \"xhigh\" \"input\") \"()\"))\n!(println! NATIVE_REFUSAL_OK)"))
          ($_ (nq:ownership $root $sdk $core $artifacts $fixture))
          ($_ (nq:owner-contracts $root $sdk $core $artifacts $fixture))
          ($_ (nq:soft-wait $root $sdk $core $artifacts $fixture))
          ($_ (nq:model-change $root $sdk $core $artifacts $fixture))
          ($_ (nq:stream-case $root $sdk $core $artifacts $fixture))
          ($_ (nq:rejected-output $root $sdk $core $artifacts $fixture))
          ($_ (nq:failed-response $root $sdk $core $artifacts $fixture "unfinished" False))
          ($_ (nq:failed-response $root $sdk $core $artifacts $fixture "disconnect-after-acceptance" True))
          ($_ (nq:oversized-response $root $sdk $core $artifacts $fixture))
          ($_ (nq:reasoning-effort $root $sdk $core $artifacts $fixture))
          ($_ (nq:commentary $root $sdk $core $artifacts $fixture "fixture-model" "chat-completions"))
          ($_ (nq:commentary $root $sdk $core $artifacts $fixture "kimi:k3.1-pro" "responses"))
          ($_ (nq:commentary $root $sdk $core $artifacts $fixture "claude-fixture" "anthropic"))
          ($_ (nq:structured $root $sdk $core $artifacts $fixture "fixture-model" "chat-completions" "coding"))
          ($_ (nq:structured $root $sdk $core $artifacts $fixture "kimi:k3.1-pro" "responses" "turn"))
          ($_ (nq:structured $root $sdk $core $artifacts $fixture "openai:fixture" "responses" "compaction"))
          ($_ (nq:structured $root $sdk $core $artifacts $fixture "claude-fixture" "anthropic" "coding"))
          ($_ (nq:long-stream $root $sdk $core $artifacts $fixture "kimi:k3.1-pro" "responses"))
          ($_ (nq:long-stream $root $sdk $core $artifacts $fixture "claude-fixture" "anthropic"))
          ($_ (nq:large-thinking $root $sdk $core $artifacts $fixture))
          ($_ (nq:coding-check $root $sdk $core $artifacts $fixture))
          ($_ (nq:rejection $root $sdk $core $artifacts $fixture False))
          ($_ (nq:rejection $root $sdk $core $artifacts $fixture True)))
     NativeProviderSuitePassedV1))
!(nt:require provider-driver-completed
   (nt:equal (collapse (native-provider-test:run)) (NativeProviderSuitePassedV1)))
!(println! NATIVE_PROVIDER_SUITE_PASSED)
