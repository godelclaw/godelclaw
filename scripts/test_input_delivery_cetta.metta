; Complete qualification for the input-delivery repair, scripted in CeTTa.
!(import! &self ../tests/native_suite_cetta.metta)
(= (input-suite:run-one $driver $marker $language) (native-suite:one $driver $marker $language))
(= (input-suite:run)
   (let* (($_ (input-suite:run-one "scripts/test_input_lifecycle_cetta.metta" "NATIVE_INPUT_LIFECYCLE_CONTRACTS_PASSED" "petta"))
          ($_ (input-suite:run-one "scripts/test_input_scope_cetta.metta" "NATIVE_INPUT_SCOPE_CONTRACTS_PASSED" "petta"))
          ($_ (input-suite:run-one "scripts/test_input_scope_cetta.metta" "NATIVE_INPUT_SCOPE_CONTRACTS_PASSED" "he"))
          ($_ (input-suite:run-one "scripts/test_input_delivery_canary_cetta.metta" "NATIVE_INPUT_CRASH_CANARY_PASSED" "petta"))
          ($_ (input-suite:run-one "scripts/test_input_lifecycle_mutants_cetta.metta" "NATIVE_INPUT_MUTANTS_PASSED" "petta"))
          ($_ (input-suite:run-one "scripts/test_native_cetta.metta" "NATIVE_REQUEST_CONTRACTS_PASSED" "he"))
          ($_ (input-suite:run-one "scripts/test_provider_native.metta" "NATIVE_PROVIDER_SUITE_PASSED" "petta"))
          ($_ (input-suite:run-one "scripts/test_runtime_probes_cetta.metta" "NATIVE_RUNTIME_PROBES_PASSED" "petta"))) NativeInputSuitePassedV1))
!(nt:require native-input-suite-completed (nt:equal (collapse (input-suite:run)) (NativeInputSuitePassedV1)))
!(println! NATIVE_INPUT_DELIVERY_SUITE_PASSED)
