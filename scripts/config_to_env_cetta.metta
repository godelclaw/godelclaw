!(import! &self ../src/configuration_cetta.metta)
!(let* (($file (system:getenv-or-default "METTACLAW_CONFIG_FILE" ""))
        ($root (system:getenv-or-default "METTACLAW_CONFIG_ROOT" ""))
        ($operation (system:getenv-or-default "METTACLAW_CONFIG_OPERATION" "print"))
        ($result (if (== $operation "channel")
                   (cfg:channel (system:getenv-or-default "METTACLAW_CONFIG_CHANNEL" ""))
                   (if (or (== $operation "publish")
                           (== (system:getenv-or-default "METTACLAW_CONFIG_PUBLISH" "0") "1"))
                     (cfg:publish $root) (cfg:render $file $root)))))
  (case $result
    (((ConfigTextV1 $text)
      (let* (($payload (str:concat "# Generated by native CeTTa configuration.\n" $text))
             ($written (collapse (system:write stdout $payload))))
        (if (== $written (())) (system:exit 0) (system:exit 2))))
     (ConfigPublishedV1 (system:exit 0))
     ((ConfigChannelTextV1 $text)
      (let $written (collapse (system:write stdout $text))
        (if (== $written (())) (system:exit 0) (system:exit 2))))
     ((ConfigFailedV1 $reason)
      (let $written (collapse (system:write stderr (str:concat $reason "\n"))) (system:exit 2)))
     ($other
      (let $written (collapse (system:write stderr "configuration rendering failed\n")) (system:exit 2))))))
