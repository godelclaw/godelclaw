; CLI presentation only. Mailbox transitions remain in the engine library.
!(import! &self mailbox)
!(import! &self json)
!(import! &self str)

; The owner can use the durable mailbox identity check, and so can a member
; on its own inbox, which it may read and write. A member writing elsewhere
; must use the shaped append path, which does not require reading other mail.
(= (shared-mail:post $socket $name $id $to $agent $body)
   (case (str:split "/" $to)
     ((($account $recipient)
       (shared-mail:post-in $socket (str:concat "mail@" $account) $id $recipient $agent $body))
      ($bare (shared-mail:post-in $socket $name $id $to $agent $body)))))
(= (shared-mail:post-in $socket $name $id $to $agent $body)
   (case (space:whoami $socket)
     (((reply $rid ok (principal $account owner))
       (mailbox:send $socket (shared-mail:owner-space $name $account) $id $to (from $account $agent) $body))
      ((reply $rid ok (principal $account member))
       (if (== $name (shared-mail:owner-space "" $account))
         (mailbox:send $socket $name $id $to (from $account $agent) $body)
         (mailbox:post $socket (if (== $name "") "agent-mail" $name) $id $to $agent $body)))
      ($error $error))))

; Foreign domains. A gateway relays between this service and agents outside
; it: mail for DOMAIN/NAME waits in the owner's space mail@DOMAIN, and mail
; arriving from outside carries the plain sender DOMAIN/NAME, so a reply goes
; back the same way. Only the service owner relays; a member's sender is
; always bound to its own account.
(= (shared-mail:as-owner $socket)
   (case (space:whoami $socket)
     (((reply $rid ok (principal $account owner)) owner)
      ((reply $rid ok (principal $account $role)) (shared-mail:refused "relaying needs the service owner"))
      ($error $error))))
(= (shared-mail:relay-in $socket $space $id $to $sender $body)
   (case (shared-mail:as-owner $socket)
     ((owner
       (case (str:split "/" $to)
         ((($login $recipient) (mailbox:send $socket (str:concat "mail@" $login) $id $recipient $sender $body))
          ($bare (mailbox:send $socket $space $id $to $sender $body)))))
      ($refused $refused))))

; The names in mail@DOMAIN that NAMES (comma separated) stands for: "*" is
; every name with mail ready or pending there, read page by page, each once.
(= (shared-mail:relay-names $socket $space $names)
   (if (== $names "*")
     (case (shared-mail:distinct $socket $space (MailboxReady 1 $id $who 0 () $id) $who ())
       (((shared-mail:names $ready) (shared-mail:distinct $socket $space (MailboxPending 1 $who $q $s $id) $who $ready))
        ($error $error)))
     (shared-mail:names (str:split "," $names))))
(= (shared-mail:distinct $socket $space $pattern $template $seen)
   (case (space:query $socket $space $pattern $template 65536 30000)
     (((reply $rid ok (snapshot $boot $cursor $source $rev $total $lease))
       (let* (($snapshot (snapshot $boot $cursor $source $rev $total $lease))
              ($names (shared-mail:pages $socket $snapshot 0 $total $seen))
              ($closed (space:close $socket $snapshot)))
         $names))
      ($error $error))))
(= (shared-mail:pages $socket $snapshot $offset $total $seen)
   (if (>= $offset $total) (shared-mail:names $seen)
     (case (space:fetch $socket $snapshot $offset 256)
       (((reply $page-id ok (page $a $b $rows $c $d))
         (shared-mail:pages $socket $snapshot (+ $offset 256) $total (shared-mail:add-names (cdr-atom $rows) $seen)))
        ($error $error)))))
(= (shared-mail:add-names $rows $seen)
   (if (== $rows ()) $seen
     (let $name (car-atom $rows)
       (shared-mail:add-names (cdr-atom $rows)
         (if (is-member $name $seen) $seen (mailbox:append $seen (cons-atom $name ())))))))

; The next mail waiting for one of the names, with the name it was written to.
(= (shared-mail:relay-scan $socket $space $names)
   (case $names
     (((shared-mail:names $list) (shared-mail:relay-scan-in $socket $space $list))
      ($error $error))))
(= (shared-mail:relay-scan-in $socket $space $names)
   (if (== $names ()) (mailbox:idle)
     (case (mailbox:next-in $socket $space (car-atom $names))
       (((mailbox:idle) (shared-mail:relay-scan-in $socket $space (cdr-atom $names)))
        ((mailbox:delivery $id $sender $body) (shared-mail:relayed (car-atom $names) $id $sender $body))
        ($error $error)))))
(= (shared-mail:relay-next $socket $domain $names $milliseconds)
   (case (shared-mail:as-owner $socket)
     ((owner
       (let* (($name (str:concat "mail@" $domain))
              ($space (mailbox:open $socket $name)))
         (case (shared-mail:relay-scan $socket $space (shared-mail:relay-names $socket $space $names))
           (((mailbox:idle)
             (if (> $milliseconds 0)
               (case (mailbox:watch $socket $space $milliseconds)
                 (((reply $rid ok $changed)
                   (let $again (mailbox:open $socket $name)
                     (shared-mail:relay-scan $socket $again (shared-mail:relay-names $socket $again $names))))
                  ($error $error)))
               (mailbox:idle)))
            ($result $result)))))
      ($refused $refused))))
(= (shared-mail:relay-ack $socket $domain $name $id)
   (case (shared-mail:as-owner $socket)
     ((owner (mailbox:ack $socket (str:concat "mail@" $domain) $name $id))
      ($refused $refused))))

; Bare recipients stay on the agent bus. Qualified recipients select an
; account inbox, as native mail does; an explicit empty space selects self.
(= (shared-mail:owner-space $name $account)
   (if (== $name "")
     (case $account
       (((account $uid $login) (str:concat "mail@" (repr $login)))
        ((account $uid) (str:concat "mail@" (repr $uid)))))
     $name))

(= (shared-mail:identity $socket)
   (case (space:whoami $socket)
     (((reply $rid ok (principal (account $uid $login) $role))
       (shared-mail:account $uid (repr $login) $role))
      ((reply $rid ok (principal (account $uid) $role))
       (shared-mail:account $uid (repr $uid) $role))
      ($error $error))))

(= (shared-mail:next $socket $agent $milliseconds)
   (case (shared-mail:identity $socket)
     (((shared-mail:account $uid $login $role)
       (let $name (str:join "" ("mail@" $login))
         (let $space (mailbox:open $socket $name)
           (case (mailbox:next-in $socket $space $agent)
             (((mailbox:idle)
               (if (> $milliseconds 0)
                 (case (mailbox:watch $socket $space $milliseconds)
                   (((reply $rid ok $changed) (mailbox:next $socket $name $agent))
                    ($error $error)))
                 (mailbox:idle)))
              ($result $result))))))
      ($error $error))))

(= (shared-mail:ack $socket $agent $id)
   (case (shared-mail:identity $socket)
     (((shared-mail:account $uid $login $role)
       (let $name (str:join "" ("mail@" $login))
         (mailbox:ack $socket $name $agent $id)))
      ($error $error))))

(= (shared-mail:sender $sender)
   (case $sender
     (((from (account $uid $login) $agent)
       (str:join "" ((repr $login) "/" $agent)))
      ((from (account $uid) $agent)
       (str:join "" ((repr $uid) "/" $agent)))
      ($other (if (== (get-type $other) String) $other (repr $other))))))

(= (shared-mail:json $result)
   (case $result
     (((mailbox:sent $id $status)
       (JsonObject ((JsonPair "status" (JsonString (repr $status)))
                    (JsonPair "id" (JsonString $id)))))
      ((mailbox:delivery $id $sender $body)
       (JsonObject ((JsonPair "status" (JsonString "delivery"))
                    (JsonPair "id" (JsonString $id))
                    (JsonPair "from" (JsonString (shared-mail:sender $sender)))
                    (JsonPair "text" (JsonString $body)))))
      ((mailbox:acked $id $status)
       (JsonObject ((JsonPair "status" (JsonString (repr $status)))
                    (JsonPair "id" (JsonString $id)))))
      ((shared-mail:relayed $to $id $sender $body)
       (JsonObject ((JsonPair "status" (JsonString "delivery"))
                    (JsonPair "id" (JsonString $id))
                    (JsonPair "from" (JsonString (shared-mail:sender $sender)))
                    (JsonPair "to" (JsonString $to))
                    (JsonPair "text" (JsonString $body)))))
      ((shared-mail:refused $why)
       (JsonObject ((JsonPair "status" (JsonString "refused"))
                    (JsonPair "reason" (JsonString $why)))))
      ((mailbox:idle) (JsonObject ((JsonPair "status" (JsonString "idle")))))
      ((shared-mail:account $uid $login $role)
       (JsonObject ((JsonPair "status" (JsonString "identity"))
                    (JsonPair "uid" (JsonNumber (repr $uid)))
                    (JsonPair "account" (JsonString $login))
                    (JsonPair "role" (JsonString (repr $role)))
                    (JsonPair "inbox" (JsonString (str:join "" ("mail@" $login)))))))
      ((shared-mail:inbox-result $count $items)
       (JsonObject ((JsonPair "status" (JsonString "inbox"))
                    (JsonPair "count" (JsonNumber (repr $count)))
                    (JsonPair "items" (JsonArray (shared-mail:items-json $items)))
                    (JsonPair "truncated" (JsonBool (> $count (size-atom $items)))))))
      ((shared-mail:busy)
       (JsonObject ((JsonPair "status" (JsonString "error"))
                    (JsonPair "reason" (JsonString "inbox changed while reading"))
                    (JsonPair "retryable" (JsonBool True)))))
      ((space:unavailable $id $why)
       (shared-mail:transport-json $id $why))
      ((space:uncertain $id $why)
       (shared-mail:transport-json $id $why))
      ($error
       (JsonObject ((JsonPair "status" (JsonString "error"))
                    (JsonPair "reason" (JsonString (repr $error)))))))))

(= (shared-mail:print $result)
   (println! (json-stringify (shared-mail:json $result))))

; Inbox inspection never takes or settles a delivery. Every observation must
; have the opening revision; a concurrent writer makes the whole read retry.
(= (shared-mail:inbox $socket $agent $limit)
   (case (shared-mail:identity $socket)
     (((shared-mail:account $uid $login $role)
       (let $name (str:join "" ("mail@" $login))
         (let $space (mailbox:open $socket $name)
           (case $space
             (((space $uuid $sid $name $backend $kind $rev $count)
               (let $result
                 (if (== $limit 0)
                   (shared-mail:count-in $socket $space $agent)
                   (shared-mail:list-in $socket $space $agent $limit $rev))
                 (case $result
                   (((shared-mail:inbox-result $total $items)
                     (case (space:describe $socket $space)
                       (((reply $rid ok (space $u $s $n $b $k $after $c))
                         (if (== $rev $after) $result (shared-mail:busy)))
                        ($error $error))))
                    ($error $error)))))
              ($error $error))))))
      ($error $error))))

(= (shared-mail:count-in $socket $space $agent)
   (case (space:count $socket $space (MailboxReady 1 $id $agent 0 () $id))
     (((reply $rid ok $ready)
       (case (space:count $socket $space (MailboxPending 1 $agent $q $sender $id))
         (((reply $other ok $pending) (shared-mail:inbox-result (+ $ready $pending) ()))
          ($error $error))))
      ($error $error))))

; Materialize only the requested preview page, and always close its snapshot.
; The service's exhaustive query limit fails explicitly rather than truncating.
(= (shared-mail:select $socket $space $pattern $template $limit)
   (case (space:query $socket $space $pattern $template 65536 30000)
     (((reply $rid ok (snapshot $boot $cursor $source $rev $total $lease))
       (let $snapshot (snapshot $boot $cursor $source $rev $total $lease)
         (let $page (if (> $limit 0)
                      (space:fetch $socket $snapshot 0 $limit)
                      (reply "empty-preview" ok (page 0 0 (rows) 0 0)))
           (let $closed (space:close $socket $snapshot)
             (case $page
               (((reply $page-id ok (page $a $b $rows $c $d))
                 (shared-mail:rows $rev $total (cdr-atom $rows)))
                ($error $error)))))))
      ($error $error))))

(= (shared-mail:list-in $socket $space $agent $limit $rev)
   (case (shared-mail:select $socket $space (MailboxReady 1 $id $agent 0 () $id)
            (shared-mail:ref $id ready) $limit)
     (((shared-mail:rows $rrev $ready $refs)
       (if (== $rrev $rev)
         (case (shared-mail:select $socket $space (MailboxPending 1 $agent $q $sender $id)
                 (shared-mail:ref $id pending) (- $limit (size-atom $refs)))
           (((shared-mail:rows $prev $pending $more)
             (if (== $prev $rev)
               (case (shared-mail:bodies $socket $space $agent
                       (mailbox:append $refs $more) $rev)
                 (((shared-mail:items $items) (shared-mail:inbox-result (+ $ready $pending) $items))
                  ($error $error)))
               (shared-mail:busy)))
            ($error $error)))
         (shared-mail:busy)))
      ($error $error))))

(= (shared-mail:bodies $socket $space $agent $refs $rev)
   (if (== $refs ()) (shared-mail:items ())
     (let (shared-mail:ref $id $state) (car-atom $refs)
       (case (mailbox:one $socket $space (MailboxMessage 1 $id $agent $q $sender $body)
               (shared-mail:item $id $sender $body $state))
         (((mailbox:found $observed ($item))
           (if (== $observed $rev)
             (case (shared-mail:bodies $socket $space $agent (cdr-atom $refs) $rev)
               (((shared-mail:items $rest) (shared-mail:items (cons-atom $item $rest)))
                ($error $error)))
             (shared-mail:busy)))
          ((mailbox:found $observed ())
           (if (== $observed $rev) (MailboxFailure missing-body) (shared-mail:busy)))
          ($error $error))))))

(= (shared-mail:items-json $items)
   (if (== $items ()) ()
     (let (shared-mail:item $id $sender $body $state) (car-atom $items)
       (cons-atom
         (JsonObject ((JsonPair "id" (JsonString $id))
                      (JsonPair "from" (JsonString (shared-mail:sender $sender)))
                      (JsonPair "text" (JsonString $body))
                      (JsonPair "state" (JsonString (repr $state)))))
         (shared-mail:items-json (cdr-atom $items))))))

(= (shared-mail:transport-json $id $why)
   (JsonObject ((JsonPair "status" (JsonString "error"))
                (JsonPair "reason" (JsonString (repr $why)))
                (JsonPair "retryable"
                  (JsonBool (or (== $why connect)
                            (or (== $why socket)
                              (or (== $why send) (== $why timeout-or-disconnect)))))))))
