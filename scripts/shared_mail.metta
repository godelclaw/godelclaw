; CLI presentation only. Mailbox transitions remain in the engine library.
!(import! &self mailbox)
!(import! &self json)
!(import! &self str)

; The owner can use the durable mailbox identity check. A restricted member
; must use the shaped append path, which does not require reading other mail.
(= (shared-mail:post $socket $name $id $to $agent $body)
   (case (space:whoami $socket)
     (((reply $rid ok (principal $account owner))
       (mailbox:send $socket $name $id $to (from $account $agent) $body))
      ((reply $rid ok (principal $account member))
       (mailbox:post $socket $name $id $to $agent $body))
      ($error $error))))

(= (shared-mail:identity $socket)
   (case (space:whoami $socket)
     (((reply $rid ok (principal (account $uid $login) $role))
       (shared-mail:account $uid (repr $login) $role))
      ((reply $rid ok (principal (account $uid) $role))
       (shared-mail:account $uid (repr $uid) $role))
      ($error $error))))

(= (shared-mail:next $socket $agent $milliseconds)
   (case (shared-mail:identity $socket)
     (((shared-mail:account $uid $login $role)
       (let $name (str:join "" ("mail@" $login))
         (let $space (mailbox:open $socket $name)
           (case (mailbox:next-in $socket $space $agent)
             (((mailbox:idle)
               (if (> $milliseconds 0)
                 (case (mailbox:watch $socket $space $milliseconds)
                   (((reply $rid ok $changed) (mailbox:next $socket $name $agent))
                    ($error $error)))
                 (mailbox:idle)))
              ($result $result))))))
      ($error $error))))

(= (shared-mail:ack $socket $agent $id)
   (case (shared-mail:identity $socket)
     (((shared-mail:account $uid $login $role)
       (let $name (str:join "" ("mail@" $login))
         (mailbox:ack $socket $name $agent $id)))
      ($error $error))))

(= (shared-mail:sender $sender)
   (case $sender
     (((from (account $uid $login) $agent)
       (str:join "" ((repr $login) "/" $agent)))
      ((from (account $uid) $agent)
       (str:join "" ((repr $uid) "/" $agent)))
      ($other (if (== (get-type $other) String) $other (repr $other))))))

(= (shared-mail:json $result)
   (case $result
     (((mailbox:sent $id $status)
       (JsonObject ((JsonPair "status" (JsonString (repr $status)))
                    (JsonPair "id" (JsonString $id)))))
      ((mailbox:delivery $id $sender $body)
       (JsonObject ((JsonPair "status" (JsonString "delivery"))
                    (JsonPair "id" (JsonString $id))
                    (JsonPair "from" (JsonString (shared-mail:sender $sender)))
                    (JsonPair "text" (JsonString $body)))))
      ((mailbox:acked $id $status)
       (JsonObject ((JsonPair "status" (JsonString (repr $status)))
                    (JsonPair "id" (JsonString $id)))))
      ((mailbox:idle) (JsonObject ((JsonPair "status" (JsonString "idle")))))
      ((shared-mail:account $uid $login $role)
       (JsonObject ((JsonPair "status" (JsonString "identity"))
                    (JsonPair "uid" (JsonNumber (repr $uid)))
                    (JsonPair "account" (JsonString $login))
                    (JsonPair "role" (JsonString (repr $role)))
                    (JsonPair "inbox" (JsonString (str:join "" ("mail@" $login)))))))
      ($error
       (JsonObject ((JsonPair "status" (JsonString "error"))
                    (JsonPair "reason" (JsonString (repr $error)))))))))

(= (shared-mail:print $result)
   (println! (json-stringify (shared-mail:json $result))))
