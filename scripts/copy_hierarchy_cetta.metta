; Copy the logical hierarchy into an empty named space on another service.
; Keep the original readable until the caller validates and switches its
; binding. Each scanned page belongs to one source revision. The copy is
; admitted only after destination readback and a final revision check.
!(import! &self (library space_service))
!(import! &self (library store))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self (library list))

(: hcopy:space (-> String String %Undefined%))
(= (hcopy:space $socket $name)
   (case (space:list $socket)
     (((reply $_ ok (catalog $_ $_ $spaces))
       (case (filter-atom (cdr-atom $spaces) $row (hcopy:named? $row $name))
         ((() HierarchySpaceAbsent)
          (($space) $space)
          ($ambiguous (HierarchyCopyFailed ambiguous-space)))))
      ($failed (HierarchyCopyFailed catalog)))))
(= (hcopy:named? (space $_ $_ $found $_ $_ $_ $_) $name) (== $found $name))

; Use a metadata-only projection if the service cannot hold a snapshot of
; all the bodies. Other record kinds have the same indexed fallback.
(= (hcopy:pattern node (HierarchyKey $id $_))
   (HNode 1 $id $r $k $title $children $sources $summary))
(= (hcopy:pattern version (HierarchyKey $id $r))
   (HVersion 1 $id $r $k $title $children $sources))
(= (hcopy:pattern body (HierarchyKey $id $r)) (HBody 1 $id $r $text))
(= (hcopy:pattern summary (HierarchyKey $id $r)) (HSummary 1 $id $r $text $stamp))
(= (hcopy:pattern setting (HierarchyKey $key $_)) (HSetting 1 $key $value))

(= (hcopy:open-view $socket $space $pattern $projection $limit)
   (let (space $uuid $sid $name $backend $kind $revision $size) $space
     (case (space:query $socket $space $pattern $projection $limit 300000)
       (((reply $_ ok (snapshot $boot $cursor $sid $revision $total $lease))
         (HierarchyView (snapshot $boot $cursor $sid $revision $total $lease) $total))
        ((reply $_ ok (snapshot $boot $cursor $source $rev $total $lease))
         (let $_ (space:close $socket (snapshot $boot $cursor $source $rev $total $lease))
           (HierarchyCopyFailed revision-changed)))
        ((reply $_ error $reason) (HierarchyCopyFailed $reason))
        ($failed (HierarchyCopyFailed query))))))

(= (hcopy:one $socket $space $kind $key)
   (let $pattern (hcopy:pattern $kind $key)
     (case (hcopy:open-view $socket $space $pattern $pattern 2)
       (((HierarchyView $view $total)
         (let* (($result (if (== $total 1) (space:fetch $socket $view 0 1)
                           (HierarchyCopyFailed ambiguous-record-key)))
                ($_ (space:close $socket $view)))
           (case $result
             (((reply $_ ok (page $_ 0 (rows $record) 1 $_)) (HierarchyRecord $record))
              ($failed (HierarchyCopyFailed record-read))))))
        ($failed $failed)))))

(= (hcopy:commit $socket $space $rows)
   (let* (((space $u $id $name $backend $kind $rev $before) $space)
          ($ops (cons-atom ops (map-atom $rows $row (add $row))))
          ($expected (+ $rev 1)))
     (case (space:batch $socket $space $ops)
       (((reply $_ ok (committed $u $id $expected))
         (space $u $id $name $backend $kind $expected (+ $before (size-atom $rows))))
        ((reply $_ error $why) (HierarchyCopyFailed $why))
        ($failed (HierarchyCopyFailed destination-write))))))

; A page and its operation wrappers must fit the service's wire frame.
; Encoding also supplies the digest of each occurrence in order, including
; equal values with different keys. Split only the transport batch.
(= (hcopy:flush $socket $space $rows)
   (if (or (== $socket "") (== $rows ())) $space
     (case (store:encode (cons-atom ops (map-atom $rows $row (add $row))))
       (((StoreEncoded $bytes)
         (if (<= (str:byte-length $bytes) 900000) (hcopy:commit $socket $space $rows)
           (if (== (size-atom $rows) 1) (HierarchyCopyFailed batch-byte-limit)
             (case (hcopy:commit $socket $space (cons-atom (car-atom $rows) ()))
               (((HierarchyCopyFailed $_) (HierarchyCopyFailed destination-write))
                ($next (hcopy:flush $socket $next (cdr-atom $rows))))))))
        ($bad (HierarchyCopyFailed encoding))))))
(= (hcopy:digest $rows $digest)
   (if (== $rows ()) $digest
     (case (store:encode (car-atom $rows))
       (((StoreEncoded $wire)
         (hcopy:digest (cdr-atom $rows) (str:sha256 (str:concat $digest $wire))))
        ($bad (HierarchyCopyFailed encoding))))))
(= (hcopy:decode-keys $socket $space $kind $keys $out)
   (if (== $keys ()) (HierarchyRecords (list:reverse $out))
     (case (hcopy:one $socket $space $kind (car-atom $keys))
       (((HierarchyRecord $record)
         (hcopy:decode-keys $socket $space $kind (cdr-atom $keys) (cons-atom $record $out)))
        ($failed $failed)))))

(= (hcopy:write-page $decoded $target $dest $digest)
   (case $decoded
     (((HierarchyRecords $atoms)
       (case (hcopy:digest $atoms $digest)
         (((HierarchyCopyFailed $_) (HierarchyCopyFailed encoding))
          ($next (case (hcopy:flush $target $dest $atoms)
            (((HierarchyCopyFailed $why) (HierarchyCopyFailed $why))
             ($space (HierarchyWritten $space $next))))))))
      ($failed $failed))))

(= (hcopy:pages $origin $space $view $kind $keys $target $dest $offset $total $digest $width)
   (if (== $offset $total) (HierarchyCopied $dest $total $digest)
     (case (space:fetch $origin $view $offset $width)
       (((reply $_ ok (page $_ $offset $entries $next $_))
         (let $rows (cdr-atom $entries)
           (if (or (<= $next $offset) (or (> $next $total) (!= (- $next $offset) (size-atom $rows))))
             (HierarchyCopyFailed invalid-page)
             (let $decoded (if $keys (hcopy:decode-keys $origin $space $kind $rows ())
                                    (HierarchyRecords $rows))
               (case (hcopy:write-page $decoded $target $dest $digest)
                 (((HierarchyWritten $updated $hash)
                   (hcopy:pages $origin $space $view $kind $keys $target $updated $next $total $hash $width))
                  ($failed $failed)))))))
        ((reply $_ error page-byte-limit)
         (if (> $width 1)
           (hcopy:pages $origin $space $view $kind $keys $target $dest $offset $total $digest 1)
           (HierarchyCopyFailed page-byte-limit)))
        ($failed (HierarchyCopyFailed fetch))))))

(= (hcopy:read $origin $space $kind $keys $target $dest $opened)
   (case $opened
     (((HierarchyView $view $total)
       (let* (($result (hcopy:pages $origin $space $view $kind $keys $target $dest 0 $total "" (if $keys 16 64)))
              ($_ (space:close $origin $view)))
         $result))
      ($failed $failed))))
(= (hcopy:group $origin $space $kind $target $dest)
   (let* (($key (HierarchyKey $id $r))
          ($pattern (hcopy:pattern $kind $key))
          ((space $_ $_ $_ $_ $_ $_ $count) $space)
          ($limit (max 1 $count)))
     (case (hcopy:open-view $origin $space $pattern $pattern $limit)
       (((HierarchyCopyFailed query-byte-limit)
         (let $_ (println! (HierarchyKeyPages $kind))
           (hcopy:read $origin $space $kind True $target $dest
             (hcopy:open-view $origin $space $pattern (if (or (== $kind node) (== $kind setting))
               (HierarchyKey $id 0) $key) $limit))))
        ($opened (hcopy:read $origin $space $kind False $target $dest $opened))))))

(= (hcopy:transfer $origin $space $target $dest $groups $out)
   (if (== $groups ()) (HierarchyTransfer $dest (list:reverse $out))
     (let $kind (car-atom $groups)
       (case (hcopy:group $origin $space $kind $target $dest)
         (((HierarchyCopied $next $count $digest)
           (let $_ (println! (HierarchyGroup $kind $count $digest))
             (hcopy:transfer $origin $space $target $next (cdr-atom $groups)
               (cons-atom (HierarchyGroup $kind $count $digest) $out))))
          ($failed $failed))))))
(= (hcopy:verify $origin $space $target $dest $wanted $groups $copied)
   (case (hcopy:transfer $target $dest "" () $groups ())
     (((HierarchyTransfer $_ $readback)
       (if (and (== $readback $copied)
              (and (== (hcopy:space $origin $wanted) $space)
                   (let (space $_ $_ $name $_ $_ $_ $_) $dest (== (hcopy:space $target $name) $dest))))
         (HierarchyCopyVerified $space $dest $copied)
         (HierarchyCopyFailed readback-or-revision)))
      ($failed $failed))))
(= (hcopy:from $origin $space $target $dest $name)
   (let* (((space $_ $_ $_ native bag $_ $count) $space)
          ($groups (node version body summary setting)))
     (case (hcopy:transfer $origin $space $target $dest $groups ())
       (((HierarchyTransfer $copied $digests)
         (let (space $_ $_ $_ native bag $_ $written) $copied
           (if (== $count $written) (hcopy:verify $origin $space $target $copied $name $groups $digests)
             (HierarchyCopyFailed uncovered-records))))
        ($failed $failed)))))
(= (hcopy:run $origin $target $name)
   (if (or (== $origin $target) (or (== $origin "") (or (== $target "") (== $name ""))))
     (HierarchyCopyFailed invalid-binding)
     (case (hcopy:space $origin $name)
       (((space $u $id $name native bag $rev $count)
         (case (hcopy:space $target $name)
           ((HierarchySpaceAbsent
             (case (space:open $target $name native)
               (((reply $_ ok (space $du $di $name native bag $dr 0))
                 (hcopy:from $origin (space $u $id $name native bag $rev $count)
                   $target (space $du $di $name native bag $dr 0) $name))
                ($failed (HierarchyCopyFailed destination-open)))))
            ($other (HierarchyCopyFailed destination-already-exists)))))
        ($failed (HierarchyCopyFailed source))))))

!(let $answer (hcopy:run (system:getenv-or-default "HIERARCHY_COPY_SOURCE" "")
                        (system:getenv-or-default "HIERARCHY_COPY_DESTINATION" "")
                        (system:getenv-or-default "HIERARCHY_COPY_NAME" ""))
   (case $answer
     (((HierarchyCopyVerified $_ $_ $_) (println! $answer))
      ($failed (let $_ (println! $failed) (system:exit 1))))))
