; Unit tests of native patch application (src/apply_patch_cetta.metta) on the
; core engine. Child processes supply a umask and a rename fault
; (tests/fixtures/fsync_fault_shim.c).
;   NATIVE_TEST_CORE=... NATIVE_TEST_ARTIFACTS=... \
;     $NATIVE_TEST_CORE/cetta --lang petta --import-mode ancestor-walk --quiet scripts/test_apply_patch_cetta.metta
!(import! &self ../tests/native_test_support.metta)
!(import! &self ../src/apply_patch_cetta.metta)

(= (apt:patch $rows) (str:join "\n" (patch:append ("*** Begin Patch") (patch:append $rows ("*** End Patch")))))
(= (apt:workspace $root $name)
   (let* (($dir (path:join $root $name)) ($_ (fs:make-directories $dir 504))
          ($_ (fs:write (path:join $dir "a.py") "one\ntwo\n")))
     $dir))
(= (apt:read $dir $name) (fs:read-text (path:join $dir $name)))
(= (apt:mode $path)
   (case (fs:metadata $path follow-permissions) (((fs:info $k $s $i (fs:permissions $bits)) $bits) ($o $o))))
(= (apt:hidden $dir) (apt:hidden-names (fs:entries $dir)))
(= (apt:hidden-names $names)
   (if (== $names ()) ()
     (let $rest (apt:hidden-names (cdr-atom $names))
       (if (str:starts-with (car-atom $names) ".") (cons-atom (car-atom $names) $rest) $rest))))
(= (apt:child $root $name $shell-prefix $env $forms)
   (let* (($script (path:join $root (str:concat $name ".metta")))
          ($_ (fs:write $script (str:join "" ("!(import! &self " (repr (nt:join (system:cwd) "src/apply_patch_cetta.metta")) ")\n" $forms))))
          ($binary (nt:join (nt:required-env "NATIVE_TEST_CORE") "cetta")))
     (nt:exit-ok (proc:run ("sh" "-c" (str:join "" ($shell-prefix " exec \"$0\" --lang petta --import-mode ancestor-walk --quiet \"$1\""))
                            $binary $script)
                           $root (patch:append (nt:environment $root) $env) 60000 65536))))

(= (apt:distinct-targets $root)
   (let* (($d (apt:workspace $root "distinct"))
          ($_ (nt:require two-updates-refused
                (nt:equal (patch:apply (apt:patch ("*** Update File: a.py" "-one" "+ONE" "*** Update File: a.py" "-two" "+TWO")) $d)
                          "Patch failed: multiple operations target a.py")))
          ($_ (nt:require move-onto-itself-refused
                (nt:equal (patch:apply (apt:patch ("*** Update File: a.py" "*** Move to: ./a.py" "-one" "+ONE")) $d)
                          "Patch failed: multiple operations target a.py")))
          ($_ (nt:require refused-patch-changes-nothing (nt:equal (apt:read $d "a.py") "one\ntwo\n"))))
     True))

(= (apt:staging-failure $root)
   (let* (($d (apt:workspace $root "staging"))
          ($locked (path:join $d "locked")) ($_ (fs:make-directories $locked 504))
          ($_ (fs:write (path:join $locked "b.py") "old\n")) ($_ (fs:set-mode $locked 365))
          ($result (patch:apply (apt:patch ("*** Update File: a.py" "-one" "+ONE" "*** Add File: fresh/c.py" "+new"
                                            "*** Update File: locked/b.py" "-old" "+new")) $d))
          ($_ (fs:set-mode $locked 493))
          ($_ (nt:require staging-failure-reported (str:starts-with $result "Patch failed: ")))
          ($_ (nt:require staging-failure-keeps-files (nt:equal (apt:read $d "a.py") "one\ntwo\n")))
          ($_ (nt:require staging-failure-removes-new-dirs (not (fs:exists (path:join $d "fresh")))))
          ($_ (nt:require staging-failure-leaves-no-temporaries (and (nt:equal (apt:hidden $d) ()) (nt:equal (apt:hidden $locked) ())))))
     True))

(= (apt:partial-commit $root)
   (let* (($d (apt:workspace $root "partial")) ($_ (fs:write (path:join $d "b.py") "old\n"))
          ($shim (path:join $root "fault.so"))
          ($_ (nt:exit-ok (proc:run ("cc" "-shared" "-fPIC" "-O2" (nt:join (system:cwd) "tests/fixtures/fsync_fault_shim.c") "-ldl" "-o" $shim)
                                    $root (nt:environment $root) 60000 65536)))
          ($out (apt:child $root "partial" "" (("LD_PRELOAD" $shim) ("FSYNC_FAULT_RENAME" (path:join $d "b.py")))
                  (format-args "!(println! (patch:apply {} {}))\n"
                    ((repr (apt:patch ("*** Update File: a.py" "-one" "+ONE" "*** Update File: b.py" "-old" "+new"))) (repr $d)))))
          ($_ (nt:require partial-commit-reported (nt:contains $out "Patch partly applied: ")))
          ($_ (nt:require partial-commit-names-applied (nt:contains $out "\nApplied: a.py\nNot applied: b.py")))
          ($_ (nt:require applied-part-written (nt:equal (apt:read $d "a.py") "ONE\ntwo\n")))
          ($_ (nt:require unapplied-part-kept (nt:equal (apt:read $d "b.py") "old\n")))
          ($_ (nt:require partial-commit-leaves-no-temporaries (nt:equal (apt:hidden $d) ()))))
     True))

(= (apt:matching $root)
   (let* (($d (apt:workspace $root "matching"))
          ($_ (fs:write (path:join $d "q.py") "say(“hi”) – x  \nend\n"))
          ($_ (nt:require typographic-context-matches
                (nt:equal (patch:apply (apt:patch ("*** Update File: q.py" " say(\"hi\") - x" "-end" "+done")) $d)
                          "Success. Updated the following files:\nM q.py")))
          ($_ (nt:require loose-context-keeps-file-text (nt:equal (apt:read $d "q.py") "say(“hi”) – x  \ndone\n")))
          ($_ (fs:write (path:join $d "r.py") "x  \ny\n"))
          ($_ (patch:apply (apt:patch ("*** Update File: r.py" " x" "-y" "+z")) $d))
          ($_ (nt:require trailing-space-ignored (nt:equal (apt:read $d "r.py") "x  \nz\n")))
          ($_ (fs:write (path:join $d "e.py") "a\nb\na\nb\n"))
          ($_ (patch:apply (apt:patch ("*** Update File: e.py" "@@" " a" "-b" "+B" "*** End of File")) $d))
          ($_ (nt:require end-of-file-hunk-at-end (nt:equal (apt:read $d "e.py") "a\nb\na\nB\n")))
          ($_ (fs:write (path:join $d "c.py") "def f():\n    x = 1\ndef g():\n    x = 1\n"))
          ($_ (patch:apply (apt:patch ("*** Update File: c.py" "@@ def g():" "-    x = 1" "+    x = 2")) $d))
          ($_ (nt:require context-anchor-picks-later-match (nt:equal (apt:read $d "c.py") "def f():\n    x = 1\ndef g():\n    x = 2\n")))
          ($_ (fs:write (path:join $d "n.py") "no newline"))
          ($_ (patch:apply (apt:patch ("*** Update File: n.py" "-no newline" "+still none")) $d))
          ($_ (nt:require missing-final-newline-kept (nt:equal (apt:read $d "n.py") "still none")))
          ($_ (nt:require missing-context-reported
                (nt:contains (patch:apply (apt:patch ("*** Update File: c.py" "@@ def h():" "-x" "+y")) $d) "context"))))
     True))

(= (apt:success $root)
   (let* (($d (apt:workspace $root "success"))
          ($_ (nt:require every-file-written
                (nt:equal (patch:apply (apt:patch ("*** Update File: a.py" "-one" "+ONE" "*** Add File: sub/b.py" "+b")) $d)
                          "Success. Updated the following files:\nM a.py\nA sub/b.py")))
          ($_ (nt:require added-file-content (nt:equal (apt:read $d "sub/b.py") "b\n")))
          ($_ (nt:require updated-file-content (nt:equal (apt:read $d "a.py") "ONE\ntwo\n")))
          ($_ (nt:require deletion-receipt
                (nt:equal (patch:apply (apt:patch ("*** Delete File: sub/b.py")) $d) "Success. Updated the following files:\nD sub/b.py")))
          ($_ (nt:require deleted (not (fs:exists (path:join $d "sub/b.py")))))
          ($_ (nt:require success-leaves-no-temporaries (nt:equal (apt:hidden $d) ()))))
     True))

(= (apt:parse-errors $root)
   (let* (($d (apt:workspace $root "parse"))
          ($_ (nt:require begin-required (nt:equal (patch:apply "*** Update File: a.py\n-one\n*** End Patch" $d) "Patch failed: a patch starts with *** Begin Patch")))
          ($_ (nt:require end-required (nt:equal (patch:apply "*** Begin Patch\n*** Delete File: a.py" $d) "Patch failed: a patch ends with *** End Patch")))
          ($_ (nt:require empty-patch (nt:equal (patch:apply (apt:patch ()) $d) "Patch failed: the patch changes nothing")))
          ($_ (nt:require added-lines-need-plus (nt:contains (patch:apply (apt:patch ("*** Add File: n.py" "oops")) $d) "added file's lines start with +")))
          ($_ (nt:require update-needs-hunks (nt:contains (patch:apply (apt:patch ("*** Update File: a.py")) $d) "has no hunks")))
          ($_ (nt:require hunk-line-prefix (nt:contains (patch:apply (apt:patch ("*** Update File: a.py" "?bad")) $d) "hunk lines start with")))
          ($_ (nt:require end-of-file-needs-hunk (nt:contains (patch:apply (apt:patch ("*** Update File: a.py" "*** End of File")) $d) "outside a hunk")))
          ($_ (nt:require unexpected-line (nt:contains (patch:apply (apt:patch ("*** Frobnicate: a.py")) $d) "unexpected")))
          ($_ (nt:require existing-add-refused (nt:contains (patch:apply (apt:patch ("*** Add File: a.py" "+x")) $d) "already exists")))
          ($_ (nt:require missing-update-refused (nt:contains (patch:apply (apt:patch ("*** Update File: zz.py" "-x" "+y")) $d) "does not exist")))
          ($_ (fs:write (path:join $d "bin.dat") "ok"))
          ($_ (nt:exit-ok (proc:run ("sh" "-c" "printf 'ok\\377\\n' > bin.dat") $d (nt:environment $d) 5000 4096)))
          ($_ (nt:require non-utf8-refused (nt:contains (patch:apply (apt:patch ("*** Update File: bin.dat" "-ok" "+no")) $d) "not UTF-8")))
          ($_ (nt:require crlf-patch-accepted
                (nt:equal (patch:apply "*** Begin Patch\r\n*** Update File: a.py\r\n-one\r\n+ONE\r\n*** End Patch\r\n" $d)
                          "Success. Updated the following files:\nM a.py"))))
     True))

; New files take the creation mode under the umask; updates and moves keep the
; source's permission bits, for a new or an existing destination.
(= (apt:modes $root)
   (let* (($d (apt:workspace $root "modes"))
          ($_ (apt:umask $root $d "002" 436)) ($_ (apt:umask $root $d "022" 420)) ($_ (apt:umask $root $d "077" 384))
          ($_ (apt:keeps-mode $d 384)) ($_ (apt:keeps-mode $d 488))
          ($_ (apt:move-keeps-mode $d 384 False)) ($_ (apt:move-keeps-mode $d 488 True))
          ($_ (nt:require modes-leave-no-temporaries (nt:equal (apt:hidden $d) ()))))
     True))
; Compared with an ordinary file the same process creates (mode 0666 under
; the umask, or the folder's default ACL where it has one).
(= (apt:umask $root $d $mask $unused)
   (let* (($name (str:concat "new-" $mask)) ($reference (path:join $d (str:concat "ordinary-" $mask)))
          ($_ (apt:child $root (str:concat "umask-" $mask) (str:join "" ("umask " $mask ";")) ()
                (format-args "!(let $w (fs:open-write {} (\"create\" \"exclusive\") 438) (let $_ (fs:write-all $w \"ordinary\\n\") (fs:close $w)))\n!(println! (patch:apply {} {}))\n"
                  ((repr $reference) (repr (apt:patch ((str:concat "*** Add File: " $name) "+patch"))) (repr $d))))))
     (nt:require (NewFileUnderUmask $mask) (nt:equal (apt:mode (path:join $d $name)) (apt:mode $reference)))))
(= (apt:keeps-mode $d $mode)
   (let* (($_ (fs:write (path:join $d "a.py") "one\ntwo\n")) ($_ (fs:set-mode (path:join $d "a.py") $mode))
          ($_ (patch:apply (apt:patch ("*** Update File: a.py" "-one" "+ONE")) $d)))
     (nt:require (UpdateKeepsMode $mode) (nt:equal (apt:mode (path:join $d "a.py")) $mode))))
(= (apt:move-keeps-mode $d $mode $existing)
   (let* (($_ (fs:write (path:join $d "a.py") "one\ntwo\n")) ($_ (fs:set-mode (path:join $d "a.py") $mode))
          ($target (path:join $d "moved.py"))
          ($_ (if (fs:exists $target) (fs:remove $target) ()))
          ($_ (if $existing (let $_ (fs:write $target "old target\n") (fs:set-mode $target 420)) ()))
          ($result (patch:apply (apt:patch ("*** Update File: a.py" "*** Move to: moved.py" "-one" "+ONE")) $d))
          ($_ (nt:require (MoveApplied $mode $existing) (str:starts-with $result "Success.")))
          ($_ (nt:require (MoveRemovesSource $mode $existing) (not (fs:exists (path:join $d "a.py")))))
          ($_ (nt:require (MoveContent $mode $existing) (nt:equal (fs:read-text $target) "ONE\ntwo\n"))))
     (nt:require (MoveKeepsMode $mode $existing) (nt:equal (apt:mode $target) $mode))))

(= (apt:check-boundary $root)
   (let* (($d (apt:workspace $root "check"))
          ($out (apt:child $root "check-boundary" "" (("METTACLAW_CODING_CHECK" "1"))
                  (format-args "!(println! (patch:apply {} {}))\n" ((repr (apt:patch ("*** Update File: a.py" "-one" "+ONE"))) (repr $d)))))
          ($_ (nt:require refused-during-check (nt:contains $out "Patch failed: patches are refused while a checkpoint is checked")))
          ($_ (nt:require check-left-file (nt:equal (apt:read $d "a.py") "one\ntwo\n"))))
     True))

(= (apt:run)
   (let* (($root (nt:join (nt:required-env "NATIVE_TEST_ARTIFACTS") (str:concat "apply-patch-" (system:uuid4-hex))))
          ($_ (fs:make-directories $root 504))
          ($_ (apt:distinct-targets $root)) ($_ (apt:staging-failure $root)) ($_ (apt:partial-commit $root))
          ($_ (apt:matching $root)) ($_ (apt:success $root)) ($_ (apt:parse-errors $root))
          ($_ (apt:modes $root)) ($_ (apt:check-boundary $root)))
     ApplyPatchPassed))
!(nt:require apply-patch-completed (nt:equal (collapse (apt:run)) (ApplyPatchPassed)))
!(println! NATIVE_APPLY_PATCH_PASSED)
