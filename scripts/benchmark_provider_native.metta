!(import! &self ../tests/provider_native_benchmark.metta)
(= (native-benchmark:run)
   (let* (($root (system:cwd)) ($sdk (nt:required-env "NATIVE_TEST_SDK"))
          ($core (nt:required-env "NATIVE_TEST_CORE")) ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($baseline-root (nt:required-env "NATIVE_BASELINE_ROOT")) ($baseline-sdk (nt:required-env "NATIVE_BASELINE_SDK"))
          ($fixture (nt:join $artifacts "native-http-peer"))
          ($large-prefix (nb:double "λ memo " 17))
          ($large (str:concat $large-prefix "_cache_boundary_input"))
          ($history (nb:chunks 200 "S_cache_boundary_T_cache_boundary_"))
          ($many (str:concat $history "_cache_boundary_U"))
          ($small-ok (nb:workload $root $sdk $core $artifacts $fixture $baseline-root $baseline-sdk ("small" "S_cache_boundary_U")))
          ($large-ok (nb:workload $root $sdk $core $artifacts $fixture $baseline-root $baseline-sdk ("large" $large)))
          ($many-ok (nb:workload $root $sdk $core $artifacts $fixture $baseline-root $baseline-sdk ("many-blocks" $many)))
          ($_ (nt:require latency-and-memory-budget (and $small-ok (and $large-ok $many-ok))))) NativeBenchmarkPassedV1))
!(nt:require benchmark-driver-completed (nt:equal (collapse (native-benchmark:run)) (NativeBenchmarkPassedV1)))
!(println! NATIVE_PROVIDER_BENCHMARK_PASSED)
