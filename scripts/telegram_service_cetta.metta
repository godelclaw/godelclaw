; Native command declarations and channel admission; the shell only execs argv.
!(import! &self ../src/state_file_cetta.metta)
!(import! &self ../channels/access_policy.metta)
!(import! &self (library re))
(= (channel-launch:env $key $default) (system:getenv-or-default $key $default))
(= (channel-launch:required $key)
   (let $value (channel-launch:env $key "")
     (if (== $value "") (channel-launch:refuse) $value)))
(= (channel-launch:refuse) (progn (system:write stderr "invalid native Telegram service configuration\n") (system:exit 78)))
(= (channel-launch:write $path $text)
   (if (== (sf:replace $path $text 432 True) True) True (channel-launch:refuse)))
(= (channel-launch:rendered $lines $key $default)
   (if (== $lines ()) $default
     (let* (($line (str:trim (car-atom $lines)))
            ($text (if (str:starts-with $line "export ") (str:byte-slice $line 7 (str:byte-length $line)) $line))
            ($parts (str:split "=" $text)))
       (if (and (> (size-atom $parts) 1) (== (str:trim (car-atom $parts)) $key))
         (let $value (str:trim (str:join "=" (cdr-atom $parts)))
           (if (or (str:starts-with $value "\"") (str:starts-with $value "'"))
             (str:byte-slice $value 1 (- (str:byte-length $value) 1)) $value))
         (channel-launch:rendered (cdr-atom $lines) $key $default)))))
(= (channel-launch:setting $key $default)
   (let $direct (channel-launch:env $key ChannelSettingMissingV1)
     (if (== $direct ChannelSettingMissingV1)
       (let $path (path:join (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_REPO") ".env")
         (if (fs:is-file $path) (channel-launch:rendered (str:split "\n" (fs:read-text $path)) $key $default) $default)) $direct)))
(= (channel-launch:menu LNil $source) ())
(= (channel-launch:menu (LCons $match $rest) $source)
   (let* (($name (re:group-text $match $source 1)) ($description (re:group-text $match $source 2))
          ($row (JsonObject ((JsonPair "command" $name) (JsonPair "description" $description)))))
     (cons-atom $row (channel-launch:menu $rest $source))))
(= (channel-launch:settings)
   (let* (($repo (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_REPO"))
          ($state (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_STATE"))
          ($commands (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_COMMANDS"))
          ($source (fs:read-text (path:join $repo "channels/telegram_commands.metta")))
          ($name (str:strip-python (channel-launch:env "METTACLAW_AGENT_NAME" "")))
          ($valid-name (and (> (str:byte-length $name) 0) (and (<= (str:byte-length $name) 32)
            (re:is-match (re:pattern "^[^\x00-\x1f\x7f\"\\\\]+$") $name))))
          ($private (ap:truthy? (channel-launch:setting "METTACLAW_TELEGRAM_ALLOW_PRIVATE" "")))
          ($bare-text (str:trim (channel-launch:setting "METTACLAW_TELEGRAM_BARE_GROUP_COMMANDS" "")))
          ($bare (or (== $bare-text "") (ap:truthy? $bare-text)))
          ($text (str:join "" ($source (if $valid-name (str:join "" ("\n(tg-cmd:agent " (repr $name) ")\n")) "")
                    (if $bare "\n(tg-cmd:bare-in-groups)\n" ""))))
          ($_ (fs:make-directories (path:dirname $commands) 504))
          ($_ (channel-launch:write $commands $text))
          ($pattern (re:compile "(?m)^\\(tg-cmd:command \"/([a-z0-9_]{1,32})\" [a-z]+ \"([^\"]{1,200})\"\\)"))
          ((re:matches $matches) (re:find-all $pattern $source))
          ($rows (channel-launch:menu $matches $source))
          ($_ (re:close $pattern))
          ($_ (channel-launch:write (path:join $state "menu.json") (json:stringify-python (JsonObject ((JsonPair "commands" (JsonArray $rows)))))))
          ($flags (str:join "\n" ((if $private "1" "0") (if $bare "1" "0") "")))
          ($_ (channel-launch:write (path:join $state "channel-flags") $flags))) True))
(= (channel-launch:ids $raw)
   (map-atom (ap:ids $raw) $id
     (if (re:is-match (re:pattern "^[+-]?[0-9]+$") $id) (str:string->number $id) (channel-launch:refuse))))
(= (channel-launch:argv-pairs $flag $ids)
   (if (== $ids ()) ()
     (cons-atom $flag (cons-atom (repr (car-atom $ids)) (channel-launch:argv-pairs $flag (cdr-atom $ids))))))
(= (channel-launch:limits $chats $owners)
   (and (and (> (size-atom $chats) 0) (<= (size-atom $chats) 128))
     (and (not (ap:member? 0 $chats))
       (and (and (> (size-atom $owners) 0) (<= (size-atom $owners) 16))
         (== (filter-atom $owners $id (<= $id 0)) ())))))
(= (channel-launch:admission $chats $owners $private)
   (if (== (ap:path) "") (ChannelAdmissionV1 $chats $owners $private)
     (let* (($_ (ap:ensure))
            ($_ (if (== (ap:get refused none) none) True (channel-launch:refuse)))
            ((TelegramAdmissionV1 $extra-chats $extra-owners $allow-private $groups) (ap:telegram-admission))
            ($all-chats (unique-atom (sort-atom (ap:append $chats (map-atom $extra-chats $id (str:string->number $id))))))
            ($all-owners (unique-atom (sort-atom (ap:append $owners (map-atom $extra-owners $id (str:string->number $id)))))))
       (progn (if $groups (system:write stderr "Telegram policy admits only explicitly named groups at this transport boundary\n") ())
         (ChannelAdmissionV1 $all-chats $all-owners $allow-private)))))
(= (channel-launch:optional-int $name $flag $minimum $maximum)
   (let $raw (str:trim (channel-launch:env $name ""))
     (if (== $raw "") ()
       (let $ids (channel-launch:ids $raw)
         (if (== (size-atom $ids) 1)
           (let $id (car-atom $ids) (if (and (>= $id $minimum) (<= $id $maximum)) ($flag (repr $id)) (channel-launch:refuse)))
           (channel-launch:refuse))))))
(= (channel-launch:argv)
   (let* (($state (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_STATE"))
          ($binary (channel-launch:required "CETTA_TELEGRAM_SERVICE_BIN"))
          ($engine-root (channel-launch:required "CETTA_TELEGRAM_SERVICE_ROOT"))
          ($instance (channel-launch:env "METTACLAW_INSTANCE" "agent"))
          ($credential (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_CREDENTIAL"))
          ($commands (channel-launch:required "METTACLAW_TELEGRAM_LAUNCH_COMMANDS"))
          ($initial-chats (channel-launch:ids (str:join "," ((channel-launch:env "METTACLAW_TELEGRAM_PRIMARY_CHAT_ID" "")
                            (channel-launch:env "METTACLAW_TELEGRAM_ALLOWED_CHAT_IDS" "")))))
          ($initial-owners (channel-launch:ids (channel-launch:required "METTACLAW_TELEGRAM_OPERATOR_IDS")))
          ((ChannelAdmissionV1 $chats $owners $private)
            (channel-launch:admission (unique-atom (sort-atom $initial-chats)) (unique-atom (sort-atom $initial-owners))
              (ap:truthy? (channel-launch:env "METTACLAW_TELEGRAM_ALLOW_PRIVATE" ""))))
          ($_ (if (channel-launch:limits $chats $owners) True (channel-launch:refuse)))
          ($peers (unique-atom (sort-atom (channel-launch:ids (channel-launch:env "METTACLAW_TELEGRAM_WAKE_IDS" "")))))
          ($base ($binary "--run" "--root" $engine-root "--state-dir" $state "--worker" $instance "--program" "channel"
                     "--listener-fd" "3" "--operator-fd" "4" "--credential-file" $credential
                     "--commands" $commands "--command-deadline-ms" "3000"))
          ($arguments (ap:append $base
             (ap:append (channel-launch:argv-pairs "--chat" $chats)
               (ap:append (channel-launch:argv-pairs "--peer" $peers)
                 (ap:append (channel-launch:argv-pairs "--operator" $owners)
                   (ap:append (if $private ("--allow-private") ())
                     (ap:append (channel-launch:optional-int "METTACLAW_TELEGRAM_INITIAL_OFFSET" "--initial-offset" 0 9223372036854775807)
                                 (channel-launch:optional-int "METTACLAW_TELEGRAM_POLL_LIMIT" "--poll-limit" 1 100))))))))
          ($nul (str:from-python-codepoints (0)))
          ($wire (str:concat (str:join $nul $arguments) $nul))
          ($_ (channel-launch:write (path:join $state "channel-argv") $wire))) True))
!(case (collapse (catch
     (if (== (channel-launch:env "METTACLAW_TELEGRAM_LAUNCH_STAGE" "") "settings")
       (channel-launch:settings) (channel-launch:argv))))
   (((True) ()) ($bad (channel-launch:refuse))))
