!(import! &self ../tests/input_lifecycle_cetta.metta)
(= (input-lifecycle-test:run)
   (let* (($root (system:cwd)) ($sdk (nt:required-env "NATIVE_TEST_SDK"))
          ($core (nt:required-env "NATIVE_TEST_CORE")) ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($fixture (nt:required-env "NATIVE_TEST_HTTP_FIXTURE"))
          ($world (nq:world $root $sdk $core $artifacts $fixture "input-contracts"))
          ($a (il:operator-input $world)) ($b (il:guards $world)) ($c (il:distinct-occurrences $world))
          ($d (il:covered $world)) ($_ (nq:close $world))) (+ (+ (+ $a $b) $c) $d)))
!(nt:require input-contracts-completed (nt:equal (collapse (input-lifecycle-test:run)) (35)))
!(println! NATIVE_INPUT_LIFECYCLE_CONTRACTS_PASSED)
