!(import! &self ../tests/provider_native_qualification.metta)
!(import! &self ../src/state_file_cetta.metta)
!(import! &self ../src/coding_io_cetta.metta)
!(import! &self (library host_io))

; Actual loop/control interleaving. HTTP is loopback; channel/ledger sockets
; and all effects belong to the test world. Fixtures implement transport only.
(= (ss:state $world) (sf:get (sf:native-object (nq:path $world "lifecycle.json")) "state" ""))
(= (ss:put $world $name $value) (sf:replace (nq:path $world $name) $value 384 True))
(= (ss:input $id $text)
   (json:stringify-python (JsonArray ("input" "42" "message" ""
     (JsonObject ((JsonPair "update_id" $id)
       (JsonPair "message" (JsonObject ((JsonPair "message_id" $id) (JsonPair "date" 1700000000)
         (JsonPair "chat" (JsonObject ((JsonPair "id" 42) (JsonPair "type" "private"))))
         (JsonPair "from" (JsonObject ((JsonPair "id" 42) (JsonPair "first_name" "fixture"))))
         (JsonPair "text" $text))))))))))
(= (ss:response $command)
   (json:stringify-python (JsonObject ((JsonPair "id" "fixture")
     (JsonPair "choices" (JsonArray ((JsonObject ((JsonPair "message"
       (JsonObject ((JsonPair "role" "assistant") (JsonPair "content" $command))))
       (JsonPair "finish_reason" "stop"))))))
     (JsonPair "usage" (JsonObject ((JsonPair "prompt_tokens" 10) (JsonPair "completion_tokens" 2))))))))
(= (ss:effect $world $char)
   (let $line (str:join "" ("printf " $char " >> " (cio:shell-quote (nq:path $world "effect.txt"))))
     (str:join "" ("((shell " (preq:repr $line) ") (rest))"))))
(= (ss:wait $world $job $kind $left)
   (let $ready (case $kind
      ((post (fs:is-file (nq:path $world "request-1.body")))
       (withheld (if (fs:is-file (nq:path $world "loop.log"))
          (nt:contains (fs:read-text (nq:path $world "loop.log")) "operator stopped cognition") False))
       (checkpoint-wait (if (fs:is-file (nq:path $world "loop.log"))
          (nt:contains (fs:read-text (nq:path $world "loop.log")) "CHECKPOINT_PENDING") False))
       (acked (fs:is-file (nq:path $world "cwp/second-acked")))))
     (if $ready True
       (if (or (<= $left 0) (== (proc:status $job) proc:ready))
         (nt:require (observed $kind) False)
         (progn (host:wait () 25) (ss:wait $world $job $kind (- $left 1)))))))
(= (ss:reply $job $buf $id $until)
   (case (buffer:line $buf)
     (((HostLine $line)
       (let* (($decoded (if (str:starts-with $line "\"") (json:parse-python $line) $line))
              ($obj (if (and (== (get-type $decoded) String) (str:starts-with $decoded "CLAW_CONTROL "))
                    (json:parse-python (str:byte-slice $decoded 13 (str:byte-length $decoded))) JsonNull)))
         (if (== (sf:get $obj "id" "") $id) $obj (ss:reply $job $buf $id $until))))
      (HostPending
       (if (>= (system:monotonic-ns) $until) (ss:control-fail timeout)
         (case (proc:read $job stdout 20)
           (((proc:chunk $chunk)
             (case (buffer:append $buf $chunk)
               (((HostBuffered $_) (ss:reply $job $buf $id $until)) ($bad (ss:control-fail buffer-refused)))))
            (proc:pending (ss:reply $job $buf $id $until))
            ($end (ss:control-fail end-of-stream))))))
      ($bad (ss:control-fail invalid-frame)))))
(= (ss:control-fail $why) (progn (println! (CONTROL_FAILURE $why)) (system:exit 1)))
(= (ss:control $job $buf $id)
   (let $text (str:concat (json:stringify-python (JsonObject ((JsonPair "id" $id)
     (JsonPair "kind" "command") (JsonPair "name" (str:concat "/" $id)) (JsonPair "arguments" "")))) "\n")
     (case (proc:write $job $text)
       (((proc:queued $_) (ss:reply $job $buf $id (+ (system:monotonic-ns) 5000000000)))
        ($bad (ss:control-fail write-refused))))))
(= (ss:text $reply) (sf:get (sf:get $reply "body" JsonNull) "text" ""))
(= (ss:stop-owner $owner) (progn (proc:cancel $owner) (proc:await $owner) (proc:close $owner)))
(= (ss:recycle $world $loop)
   (let* (($_ (ss:put $world "recycle" "fixture recycle"))
          ($_ (host:wait () 250))
          ($_ (nt:require recycle-does-not-interrupt-in-flight-provider
                 (and (not (== (proc:status $loop) proc:ready))
                      (not (fs:exists (nq:path $world "effect.txt"))))))
          ($_ (ss:put $world "release-1" "release"))
          ($_ (ss:wait $world $loop checkpoint-wait 440))
          ($_ (nt:require committed-effect-awaits-checkpoint-confirmation
                 (and (fs:is-file (nq:path $world "checkpoint-withheld"))
                      (== (fs:read-text (nq:path $world "effect.txt")) "A"))))
          ($_ (nt:require recycle-stays-pending-without-a-receipt
                 (and (not (== (proc:status $loop) proc:ready))
                      (not (fs:exists (nq:path $world "cwp/delivery-acked"))))))
          ($_ (ss:put $world "checkpoint-release" "release"))
          ($finished (proc:wait $loop 10000))
          ($_ (nt:exit-ok $finished))
          ($_ (nt:require exact-checkpoint-occurrence-replayed
                 (and (not (fs:exists (nq:path $world "checkpoint-conflict")))
                      (== (fs:read-text (nq:path $world "checkpoint-withheld"))
                          (fs:read-text (nq:path $world "checkpoint-replayed"))))))
          ($_ (nt:require confirmed-recycle-follows-acknowledgement
                 (and (fs:is-file (nq:path $world "cwp/delivery-acked"))
                      (nt:contains (fs:read-text (nq:path $world "loop.log")) "RECYCLE_AT_TURN_BOUNDARY"))))
          ($_ (nt:require checkpoint-retry-performs-no-extra-effect-or-inference
                 (and (== (fs:read-text (nq:path $world "effect.txt")) "A")
                      (== (nq:posts $world) 1)))))
     (let $_ (println! NATIVE_RECYCLE_CHECKPOINT_PASSED) True)))
(= (ss:run)
   (let* (($root (system:getenv-or-default "NATIVE_TEST_RUNTIME_ROOT" (system:cwd))) ($engine (nt:required-env "NATIVE_TEST_CORE"))
          ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($recycle (== (system:getenv-or-default "NATIVE_TEST_RECYCLE" "0") "1"))
          ($http (nt:required-env "NATIVE_TEST_HTTP_FIXTURE"))
          ($world (if $recycle
                    (nq:world-at $root $engine $engine $artifacts $http "recycle"
                      (path:join (system:cwd) "tests/fixtures/held_checkpoint.metta") "held:configuration")
                    (nq:world $root $engine $engine $artifacts $http "stop")))
          ($directory (nq:path $world "")) ($cwp-dir (nq:path $world "cwp"))
          ($chan (nq:path $world "c.sock")) ($_ (fs:make-directories $cwp-dir 448))
          ($_ (ss:put $world "cwp/delivery.json" (ss:input 777 "FIRST_FIXTURE_INPUT")))
          ($cwp (proc:spawn ((nt:required-env "NATIVE_TEST_CWP_FIXTURE") $chan $cwp-dir)
                   ((cwd $directory) (env (nt:environment $directory)) (lifetime owner) (timeout-ms 45000))))
          ($_ (nq:wait-file $cwp (nq:path $world "cwp/ready") 100))
          ($_ (ss:put $world "response-1.body" (ss:response (ss:effect $world "A"))))
          ($_ (ss:put $world "response-2.body" (ss:response (ss:effect $world "B"))))
          ($_ (ss:put $world "hold-first-response" "hold"))
          ($_ (ss:put $world "response.body" (ss:response "((rest))")))
          ($_ (ss:put $world "prompt.txt" "Offline integration fixture."))
          ($_ (ss:put $world "history.metta" ""))
          ($at (system:wall-time))
          ($_ (ss:put $world "provider.json" (json:stringify-python (JsonObject ((JsonPair "schema" 1)
             (JsonPair "models" (JsonObject ((JsonPair "observed_at" $at) (JsonPair "attempted_at" $at)
                  (JsonPair "value" (JsonArray ((JsonObject ((JsonPair "id" "fixture-model") (JsonPair "context" 262144))))))))))))))
          ($env (nq:guest-env $world "fixture-model"
            (("METTACLAW_INSTANCE" "offline-stop-fixture") ("METTACLAW_SKIP_INITIALIZE" "1") ("METTACLAW_SKIP_CONFIG" "1")
             ("METTACLAW_NATIVE_LEDGER" "1") ("METTACLAW_OBSERVED_STRATEGY" "1") ("METTACLAW_COMMAND_BATCH_LIMIT" "1")
             ("METTACLAW_CONTEXT_WINDOW_TOKENS" "262144") ("METTACLAW_LLM_SOFT_SECONDS" "3") ("METTACLAW_LLM_HARD_SECONDS" "20")
             ("METTACLAW_PROVIDER_OBSERVATION_PATH" (nq:path $world "provider.json"))
             ("METTACLAW_TELEGRAM_SERVICE_SOCKET" $chan) ("METTACLAW_TELEGRAM_PRIMARY_CHAT_ID" "42")
             ("METTACLAW_TELEGRAM_ALLOWED_CHAT_IDS" "42") ("METTACLAW_RUNTIME_ROOT" $root)
             ("METTACLAW_WAKE_REQUEST_PATH" (nq:path $world "wake"))
             ("METTACLAW_PROMPT_PATH" (nq:path $world "prompt.txt")) ("METTACLAW_HISTORY_PATH" (nq:path $world "history.metta"))
             ("METTACLAW_WORKING_SET_PATH" (nq:path $world "working.json")) ("METTACLAW_TELEGRAM_LOG_PATH" (nq:path $world "telegram.jsonl"))
             ("METTACLAW_MODE_STATE_ROOT" (nq:path $world "modes")) ("METTACLAW_LOOP_MODE_PATH" (nq:path $world "mode.json"))
             ("METTACLAW_EFFECT_RECEIPT_PATH" (nq:path $world "effects.jsonl")) ("METTACLAW_JOBS_DIR" (nq:path $world "jobs"))
             ("CLAW_MAIL_HOME" (nq:path $world "mail")) ("METTACLAW_MAIL_SOCKET" (nq:path $world "no-mail.sock"))
             ("METTACLAW_MEMORY_BACKEND_CONFIG" (nq:path $world "no-memory.json")) ("METTACLAW_PINS_PATH" (nq:path $world "pins.txt")))))
          ($run (path:join $root "run.sh"))
          ($control (proc:spawn ("bash" $run "terminal-control")
             ((cwd $root) (env $env) (mode stream) (lifetime group) (timeout-ms 45000) (max-bytes 1048576))))
          ($loop (proc:spawn ("/bin/sh" "-c" "exec /bin/bash \"$1\" run.metta >\"$2\" 2>&1" "sh" $run (nq:path $world "loop.log"))
             ((cwd $root) (env $env) (lifetime group) (timeout-ms 45000) (max-bytes 1048576))))
          ($buffer (buffer:new 1048576 bytes))
          ($_ (ss:wait $world $loop post 480))
          ($_ (nt:require first-call-is-inference-for-first-arrival
             (and (str:starts-with (fs:read-text (nq:path $world "request-1.headers")) "POST ")
                  (nt:contains (fs:read-text (nq:path $world "request-1.body")) "FIRST_FIXTURE_INPUT"))))
          ($_ (if $recycle (ss:recycle $world $loop) (ss:pause-resume $world $loop $control $buffer)))
          ($_ (ss:stop-owner $loop)) ($_ (ss:stop-owner $control)) ($_ (host:close $buffer))
          ($_ (ss:stop-owner $cwp)) ($_ (nq:close $world)))
      True))
(= (ss:pause-resume $world $loop $control $buffer)
   (let* (($stopped (ss:control $control $buffer "stop"))
          ($_ (ss:put $world "stop.json" (json:stringify-python $stopped)))
          ($_ (nt:require stop-control-durably-stopped (and (== (ss:state $world) "stopped") (str:starts-with (ss:text $stopped) "Stopped."))))
          ($_ (ss:put $world "cwp/second.json" (ss:input 778 "SECOND_FIXTURE_INPUT")))
          ($_ (ss:put $world "release-1" "release"))
          ($_ (ss:wait $world $loop withheld 400)) ($_ (host:wait () 500))
          ($_ (nt:require in-flight-response-effect-withheld (not (fs:exists (nq:path $world "effect.txt")))))
          ($_ (nt:require queued-input-not-acked-or-submitted-while-paused
             (and (not (fs:exists (nq:path $world "cwp/second-acked"))) (== (nq:posts $world) 1))))
          ($started (ss:control $control $buffer "start"))
          ($_ (ss:put $world "start.json" (json:stringify-python $started)))
          ($_ (nt:require start-control-durably-running (and (== (ss:state $world) "running") (str:starts-with (ss:text $started) "Started."))))
          ($_ (ss:wait $world $loop acked 560))
          ; Observe beyond one ordinary five-second channel wait, so a
          ; deferred extra inference cannot hide in the immediate idle gap.
          ($_ (host:wait () 5250))
          ($_ (nt:require second-arrival-in-next-model-request (and (>= (nq:posts $world) 2)
               (nt:contains (fs:read-text (nq:path $world "request-2.body")) "SECOND_FIXTURE_INPUT"))))
          ($_ (nt:require new-effect-executed-exactly-once (== (fs:read-text (nq:path $world "effect.txt")) "B")))
          ($_ (nt:require no-extra-inference-after-rest (== (nq:posts $world) 2)))
          ($lines (str:split "\n" (fs:read-text (nq:path $world "cwp/requests"))))
          ($acks (filter-atom $lines $line (str:starts-with $line "2\tfixture-second\t")))
          ($_ (nt:require second-transport-acknowledged-once (== (size-atom $acks) 1))))
      True))
!(let* (($root (system:cwd)) ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
         ($http (path:join $artifacts "stop-http-peer")) ($cwp (path:join $artifacts "stop-cwp-peer"))
         ($_ (fs:make-directories $artifacts 448))
         ($_ (nt:require http-fixture-binary-is-the-one-configured-for-the-test
               (== $http (nt:required-env "NATIVE_TEST_HTTP_FIXTURE"))))
         ($_ (nt:require channel-fixture-binary-is-the-one-configured-for-the-test
               (== $cwp (nt:required-env "NATIVE_TEST_CWP_FIXTURE"))))
         ($_ (nt:exit-ok (proc:run ("cc" "-std=c11" "-O2" "-Wall" "-Wextra" "-Werror"
                    (path:join $root "tests/fixtures/native_http_peer.c") "-o" $http) $root inherit 30000 65536)))
         ($_ (nt:exit-ok (proc:run ("cc" "-std=c11" "-O2" "-Wall" "-Wextra" "-Werror"
                    (path:join $root "tests/fixtures/native_cwp_peer.c") "-o" $cwp) $root inherit 30000 65536)))
         ($result (ss:run)))
   (if (== $result True)
       (if (== (system:getenv-or-default "NATIVE_TEST_RECYCLE" "0") "1") True
         (println! NATIVE_STOP_START_PASSED))
       (system:exit 1)))
