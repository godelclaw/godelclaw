; Exercise the real terminal launch and structured calls against a loopback peer.
!(import! &self ../tests/native_test_support.metta)
!(import! &self ../tests/provider_native_qualification.metta)
!(import! &self ../src/state_file_cetta.metta)
!(import! &self ../modes/runtime_host_cetta.metta)

(= (standalone-test:call $id $name $arguments)
   (JsonObject ((JsonPair "id" $id) (JsonPair "type" "function")
      (JsonPair "function" (JsonObject ((JsonPair "name" $name)
        (JsonPair "arguments" (json:stringify-python (JsonObject $arguments)))))))))
(= (standalone-test:reply "omega" $calls)
   (json:stringify-python (JsonObject ((JsonPair "id" "fixture")
     (JsonPair "choices" (JsonArray ((JsonObject ((JsonPair "finish_reason" "tool_calls")
       (JsonPair "message" (JsonObject ((JsonPair "role" "assistant")
          (JsonPair "tool_calls" (JsonArray $calls))))))))))
     (JsonPair "usage" (JsonObject ((JsonPair "prompt_tokens" 10) (JsonPair "completion_tokens" 2))))))))
(= (standalone-test:reply "iter" $calls)
   (let $output (map-atom $calls $call
           (let* (($id (sf:get $call "id" "")) ($function (sf:get $call "function" (JsonObject ()))))
             (JsonObject ((JsonPair "type" "function_call") (JsonPair "status" "completed")
               (JsonPair "id" (str:concat "fc_" $id)) (JsonPair "call_id" $id)
               (JsonPair "name" (sf:get $function "name" ""))
               (JsonPair "arguments" (sf:get $function "arguments" "{}"))))))
     (json:stringify-python (JsonObject ((JsonPair "id" "fixture") (JsonPair "status" "completed")
       (JsonPair "output" (JsonArray $output))
       (JsonPair "usage" (JsonObject ((JsonPair "input_tokens" 10) (JsonPair "output_tokens" 2)))))))))
(= (standalone-test:calls "iter" $text $_)
   ((standalone-test:call "terminal-send" "send" ((JsonPair "channel" "terminal") (JsonPair "content" $text)))))
(= (standalone-test:calls "omega" $text $counter)
   ((standalone-test:call "terminal-send" "send" ((JsonPair "content" $text)))
    (standalone-test:call "retained-memory" "remember" ((JsonPair "content" "Stand-alone memory λ")))
    (standalone-test:call "read-memory" "query" ((JsonPair "content" "STAND-ALONE MEMORY Λ")))
    (standalone-test:call "native-nal" "metta"
      ((JsonPair "sexpression" "(collapse (|- ((--> a b) (stv 1.0 0.9)) ((--> b c) (stv 1.0 0.9))))")))
    (standalone-test:call "native-pln" "metta"
      ((JsonPair "sexpression" "(collapse (|~ ((Inheritance a b) (stv 1.0 0.9)) ((Implication (Inheritance a b) (Inheritance a c)) (stv 1.0 0.9))))")))
    (standalone-test:call "append-first" "append-file" ((JsonPair "filename" $counter) (JsonPair "content" "x")))
    (standalone-test:call "append-second" "append-file" ((JsonPair "filename" $counter) (JsonPair "content" "x")))
    (standalone-test:call "read-counter" "read-file" ((JsonPair "filename" $counter)))
    (standalone-test:call "rejected-write" "append-file" ((JsonPair "filename" $counter)))))
(= (standalone-test:wait $owner $path $needle $left)
   (if (fs:is-file $path)
     (let $text (fs:read-text $path)
       (if (and (nt:contains $text $needle)
                (if (str:ends-with $path "native-checkpoint-v1.json")
                    (== (sf:get (json:parse-python $text) "status" "") "settled") True))
         True (standalone-test:wait-next $owner $path $needle $left)))
     (standalone-test:wait-next $owner $path $needle $left)))
; A child that ends while the test waits keeps its completion for the log.
!(bind! &standalone-ended (new-state none))
(= (standalone-test:ended $owner $completion)
   (let $_ (change-state! &standalone-ended (Ended $owner $completion)) False))
(= (standalone-test:wait-next $owner $path $needle $left)
   (if (<= $left 0) False
     (case (proc:wait $owner 30)
       (((proc:result $a $b $c $d $e) (standalone-test:ended $owner (proc:result $a $b $c $d $e)))
        ((proc:exited $a $b $c) (standalone-test:ended $owner (proc:exited $a $b $c)))
        ($pending (standalone-test:wait $owner $path $needle (- $left 1)))))))
(= (standalone-test:send $owner $line)
   (case (proc:write $owner (str:concat $line "\n"))
     (((proc:queued $_) True) ($other False))))
(= (standalone-test:stop $owner $path)
   (let* (($_ (proc:cancel $owner)) ($awaited (proc:await $owner))
          ($exit (case (get-state &standalone-ended)
                   (((Ended $owner $completion) $completion) ($other $awaited))))
          ($_ (proc:close $owner)) ($_ (fs:write $path (repr $exit)))) $exit))
(= (standalone-test:unexpected $completion) (let $_ (println! (unexpected-launch $completion)) False))
; Launches that cannot run say so. An over-long socket path is refused before
; the engine starts, and a ledger that never answers stops the mode with its
; reason, not with a silent exit 0.
(= (standalone-test:refusals $mode $root $paths $sockets $home $environment $prompt)
   (let* (($argv ("bash" (path:join $root "run.sh") "--mode" $mode
                  "--state-dir" (path:join $paths "refused-state") "--prompt" $prompt))
          ($long (path:join $paths "a-socket-directory-whose-name-is-long-enough-to-overflow-the-unix-limit"))
          ($refused (proc:run $argv $home (nq:overlay-env $environment (("XDG_RUNTIME_DIR" $long))) 30000 65536))
          ($_ (nt:require ($mode refuses-overlong-socket-path)
                (case $refused (((proc:exited 2 $_ $err) (nt:contains $err "longer than 107 bytes"))
                                ($other (standalone-test:unexpected $other))))))
          ($closed (path:join $sockets "closed"))
          ($_ (fs:make-directories $closed 448))
          ($_ (proc:run ("chmod" "500" $closed) $home $environment 5000 4096))
          ($stopped (proc:run $argv $home (nq:overlay-env $environment (("XDG_RUNTIME_DIR" $closed))) 60000 65536))
          ($_ (proc:run ("chmod" "700" $closed) $home $environment 5000 4096)))
     (nt:require ($mode reports-unready-ledger)
       (case $stopped (((proc:exited 75 $_ $err) (nt:contains $err "ledger-not-ready"))
                       ($other (standalone-test:unexpected $other)))))))
(= (standalone-test:history $runtime $mode)
   (path:join $runtime (if (== $mode "omega") "repos/Omega/memory/history.metta" "experience.json")))
(= (standalone-test:prompt $runtime $mode)
   (path:join $runtime (if (== $mode "omega") "repos/Omega/memory/prompt.txt" "prompt.txt")))
(= (standalone-test:request $path $mode)
   (let* (($body (sf:native-object $path))
          ($omega (== $mode "omega"))
          ($messages (mode-host:array $body (if $omega "messages" "input")))
          ($system (filter-atom $messages $row (== (sf:get $row "role" "") "system"))))
     (nt:require ($mode correct-provider-request)
       (and (and (== (sf:get $body "model" "") "fixture-model") (== (size-atom $system) 1))
            (and (== (sf:get $body (if $omega "max_tokens" "max_output_tokens") 0) (if $omega 6000 2524))
                 (and (nt:contains (sf:get (car-atom $system) "content" "") "Standalone prompt addition λ")
                      (not (nt:contains (fs:read-text $path) "PRIVATE_INSTANCE_SENTINEL"))))))))
(= (standalone-test:tool-result $path $id $marker)
   (let* (($body (sf:native-object $path))
          ($rows (filter-atom (mode-host:array $body "messages") $row
                    (and (== (sf:get $row "role" "") "tool") (== (sf:get $row "tool_call_id" "") $id)))))
     (nt:require (native-tool-result $id)
       (and (== (size-atom $rows) 1) (nt:contains (sf:get (car-atom $rows) "content" "") $marker)))))
(= (standalone-test:omega-results $path $counter)
   (let* (($wanted (("terminal-send" "SUCCESS") ("retained-memory" "REMEMBER-SUCCESS")
                     ("read-memory" "Stand-alone memory λ") ("native-nal" "(--> a c)") ("native-pln" "(Inheritance a c)")
                     ("append-first" "SUCCESS") ("append-second" "SUCCESS") ("read-counter" "'xx'")
                     ("rejected-write" "Call tool parameter is not set")))
          ($_ (map-atom $wanted $expected (let ($id $marker) $expected (standalone-test:tool-result $path $id $marker))))
          ($rows (filter-atom (mode-host:array (sf:native-object $path) "messages") $row
                             (== (sf:get $row "role" "") "tool")))
          ($_ (nt:require tool-occurrence-order
                (== (map-atom $rows $row (sf:get $row "tool_call_id" ""))
                    (map-atom $wanted $one (car-atom $one))))))
     (nt:require once-per-effecting-occurrence (== (fs:read-text $counter) "xx"))))
(= (standalone-test:iter-result $path)
   (let $rows (filter-atom (mode-host:array (sf:native-object $path) "input") $row
                 (and (== (sf:get $row "type" "") "function_call_output")
                      (== (sf:get $row "call_id" "") "terminal-send")))
     (nt:require iter-tool-result
        (and (== (size-atom $rows) 1) (nt:contains (sf:get (car-atom $rows) "output" "") "SUCCESS")))))

(= (standalone-test:mode $mode)
   (let* (($root (nt:required-env "NATIVE_TEST_RUNTIME_ROOT"))
          ($core (nt:required-env "NATIVE_TEST_CORE"))
          ($paths (path:join (nt:required-env "NATIVE_TEST_ARTIFACTS") $mode))
          ($_ (fs:make-directories $paths 448))
          ($state (path:join $paths "state")) ($runtime (path:join $state $mode))
          ($home (path:join $paths "home")) ($_ (fs:make-directories $home 448))
          ($socket-root (nt:required-env "NATIVE_TEST_MODE_SOCKET_ROOT"))
          ($_ (fs:make-directories $socket-root 448))
          ($foreign (path:join $paths "instance-prompt"))
          ($_ (fs:write $foreign "PRIVATE_INSTANCE_SENTINEL"))
          ($prompt (path:join $paths "new-prompt"))
          ($counter (path:join $paths "effect-counter"))
          ($_ (fs:write $prompt "Standalone prompt addition λ\n"))
          ($_ (fs:write (path:join $paths "status") "200"))
          ($_ (fs:write (path:join $paths "delay-ms") "0"))
          ($nop (standalone-test:reply $mode ((standalone-test:call "no-effect" "nop" ()))))
          ($_ (fs:write (path:join $paths "response.body") $nop))
          ($_ (fs:write (path:join $paths "response-1.body")
                 (standalone-test:reply $mode (standalone-test:calls $mode "terminal-fixture-reply λ" $counter))))
          ($http (proc:spawn ((nt:required-env "NATIVE_TEST_HTTP_FIXTURE") $paths)
                   ((cwd $paths) (env (nt:environment $home)) (max-bytes 65536))))
          ($_ (nq:wait-file $http (path:join $paths "port") 200))
          ($base (format-args "http://127.0.0.1:{}/v1" ((nq:read-number (path:join $paths "port")))))
          ($engine (if (== (system:getenv-or-default "NATIVE_TEST_USE_BUNDLED_CORE" "0") "1") ""
                       (path:join $core "cetta")))
          ($environment (nq:overlay-env (nt:environment $home)
            (("XDG_RUNTIME_DIR" $socket-root) ("CETTA_BIN" $engine)
             ("CETTA_VALUE_WORKER_BIN" "/absent/instance-worker")
             ("METTACLAW_MODE_CETTA_BIN" "/absent/instance-engine")
             ("METTACLAW_PROMPT_PATH" $foreign) ("METTACLAW_TELEGRAM_SERVICE_SOCKET" "/absent/instance-inbox")
             ("METTACLAW_INPUT_LEDGER_SOCKET" "/absent/instance-ledger")
             ("METTACLAW_MODEL_STATE_PATH" "/absent/instance-model")
             ("OMEGA_provider" "OpenAIAPI") ("OMEGA_model" "fixture-model")
             ("OMEGA_openaiapi_url" $base) ("OMEGA_api_token_var" "FIXTURE_OMEGA_KEY")
             ("FIXTURE_OMEGA_KEY" "fixture-key") ("LLM_MODEL" "fixture-model")
             ("BASE_URL" $base) ("AI_API_KEY" "fixture-key"))))
          ($command ("bash" (path:join $root "run.sh") "--mode" $mode "--state-dir" $state "--prompt" $prompt))
          ($_ (standalone-test:refusals $mode $root $paths $socket-root $home $environment $prompt))
          ($first (proc:spawn $command ((cwd $home) (env $environment) (mode stream) (timeout-ms 35000) (max-bytes 1048576))))
          ($queued (standalone-test:send $first "terminal-fixture-input λ"))
          ($checkpoint (path:join $runtime "native-checkpoint-v1.json"))
          ($ready (standalone-test:wait $first $checkpoint "terminal-fixture-input" 400))
          ($_ (if $ready True (progn (standalone-test:stop $first (path:join $paths "first-process.log"))
                                     (nt:require ($mode real-terminal-checkpoint) False))))
          ($_ (nt:require ($mode delivered-input-and-settled) $queued))
          ($initial (path:join $paths "request-1.body"))
          ($_ (nt:require ($mode real-provider-request) (standalone-test:wait $first $initial "fixture-model" 240)))
          ($_ (standalone-test:request $initial $mode))
          ($history (standalone-test:history $runtime $mode))
          ($_ (nt:require ($mode durable-input-text) (nt:contains (fs:read-text $history) "terminal-fixture-input λ")))
          ($second (path:join $paths "request-2.body"))
          ($_ (standalone-test:send $first "terminal-follow-up λ"))
          ($_ (nt:require ($mode subsequent-provider-request)
                (standalone-test:wait $first $second "terminal-send" 240)))
          ($_ (if (== $mode "omega")
                (standalone-test:omega-results $second $counter) (standalone-test:iter-result $second)))
          ($busy (proc:run $command $home $environment 5000 65536))
          ($_ (nt:require ($mode rejects-competing-state-owner)
                (case $busy (((proc:exited 2 $_ $err) (nt:contains $err "live cognitive owner")) ($other False)))))
          ($ended (standalone-test:stop $first (path:join $paths "first-process.log")))
          ($_ (nt:require ($mode terminal-reply-is-visible)
                (nt:contains (repr $ended) "terminal-fixture-reply λ")))
          ($_ (nt:require ($mode no-generic-configuration-prompts)
                (not (nt:contains (repr $ended) "Input value for"))))
          ($saved (fs:read-text $history))
          ($prompt-path (standalone-test:prompt $runtime $mode))
          ($saved-prompt (fs:read-text $prompt-path))
          ($_ (fs:write $prompt "A replacement argument must not reseed the prompt"))
          ($again (proc:spawn $command ((cwd $home) (env $environment) (mode stream) (timeout-ms 35000) (max-bytes 1048576))))
          ($_ (standalone-test:send $again "terminal-after-restart λ"))
          ($recovered (standalone-test:wait $again $checkpoint "terminal-after-restart" 400))
          ($_ (standalone-test:stop $again (path:join $paths "restart-process.log")))
          ($_ (nt:require ($mode real-restart-checkpoint) $recovered))
          ($_ (nt:require ($mode original-prompt-survives) (== (fs:read-text $prompt-path) $saved-prompt)))
          ($_ (nt:require ($mode original-input-is-still-reachable)
                (nt:contains (fs:read-text $history) "terminal-fixture-input λ")))
          ($_ (if (== $mode "omega")
                (nt:require omega-restart-preserves-history-and-does-not-replay-remember
                   (and (str:starts-with (fs:read-text $history) $saved)
                        (== (size-atom (str:split "Stand-alone memory λ"
                             (fs:read-text (path:join $runtime "remembered.jsonl")))) 2)))
                True))
          ($_ (nt:require ($mode no-instance-files-used)
                (and (== (fs:read-text $foreign) "PRIVATE_INSTANCE_SENTINEL")
                     (not (fs:exists (path:join $home ".local/state/godel"))))))
          ($_ (proc:cancel $http)) ($_ (proc:await $http)) ($_ (proc:close $http))
          ($_ (nt:require ($mode no-leaked-processes) (nt:no-leaked-processes? $paths 20))))
     (let $_ (println! (NATIVE_STANDALONE_MODE_OK $mode)) True)))

!(let $_ (nt:require standalone-suite-completed
    (let $mode (system:getenv-or-default "NATIVE_STANDALONE_TEST_MODE" "all")
      (case $mode
        (("all" (let True (standalone-test:mode "iter") (standalone-test:mode "omega")))
         ("iter" (standalone-test:mode "iter"))
         ("omega" (standalone-test:mode "omega"))
         ($unknown False)))))
   (let $_ (nt:require standalone-no-leaked-processes
             (nt:no-leaked-processes? (nt:required-env "NATIVE_TEST_ARTIFACTS") 20))
     (println! NATIVE_STANDALONE_MODES_PASSED)))
