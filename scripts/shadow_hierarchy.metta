; Both trials execute the selected application's real hierarchy module.
; The scratch service receives the same writes and is reopened from disk.
!(import! &self /app/src/hierarchy_store.metta)
!(import! &self (library proc))
!(import! &self (library fs))
!(import! &self (library json))
!(import! &self (library system))

(= (shadow-hierarchy:socket) "/work/hierarchy.sock")
(= (shadow-hierarchy:space) "hierarchy-replay")
(= (shadow-hierarchy:store) "/work/hierarchy")
(= (shadow-hierarchy:fail $where)
   (progn (println! (SHADOW_HIERARCHY_INCOMPLETE $where)) (system:exit 2)))
(= (shadow-hierarchy:connected?)
   (if (fs:exists (shadow-hierarchy:socket))
     (case (space:list (shadow-hierarchy:socket))
       (((reply $_ ok (catalog $_ $_ $_)) True) ($other False)))
     False))
(= (shadow-hierarchy:ready $owner $attempts)
   (if (shadow-hierarchy:connected?) $owner
     (if (or (== $attempts 0) (== (proc:status $owner) proc:ready))
       (shadow-hierarchy:fail service-start)
       (let $_ (proc:wait $owner 10) (shadow-hierarchy:ready $owner (- $attempts 1))))))
(= (shadow-hierarchy:start)
   (let* (($owner (proc:spawn ("/sdk/cetta-space-service" "--socket" (shadow-hierarchy:socket)
                             "--data" (shadow-hierarchy:store))
                  ((cwd "/work") (max-bytes 65536)))))
     (shadow-hierarchy:ready $owner 300)))
(= (shadow-hierarchy:stop $owner)
   (let* (($_ (proc:cancel $owner)) ($_ (proc:await $owner))) (proc:close $owner)))

(= (shadow-hierarchy:put $id $kind $title $body $children)
   (hm:put (shadow-hierarchy:socket) (shadow-hierarchy:space) $id $kind $title $body $children ()))
(= (shadow-hierarchy:link $child)
   (hm:link (shadow-hierarchy:socket) (shadow-hierarchy:space) "task" $child))
(= (shadow-hierarchy:read $id $revision)
   (hm:history (shadow-hierarchy:socket) (shadow-hierarchy:space) $id $revision))
(= (shadow-hierarchy:view)
   (hm:context (shadow-hierarchy:socket) (shadow-hierarchy:space) "task"))
(= (shadow-hierarchy:archives)
   ((shadow-hierarchy:read "task" 1)
    (shadow-hierarchy:read "task" 2)
    (shadow-hierarchy:read "task" 3)
    (shadow-hierarchy:read "task" 4)
    (shadow-hierarchy:read "alpha" 1)
    (shadow-hierarchy:read "beta" 1)
    (shadow-hierarchy:read "episode" 1)))
(= (shadow-hierarchy:expected $body)
   ((HOriginal "task" 1 task "Task" "Task body" ("alpha") ())
    (HOriginal "task" 2 task "Task" "Task body" ("alpha" "beta") ())
    (HOriginal "task" 3 task "Task" "Task body" ("beta" "alpha") ())
    (HOriginal "task" 4 task "Task" "Task body" ("beta" "alpha" "episode") ())
    (HOriginal "alpha" 1 episode "A" $body () ())
    (HOriginal "beta" 1 episode "B" $body () ())
    (HOriginal "episode" 1 episode "Episode" "New episode" () ((LedgerRequest "task")))))
(= (shadow-hierarchy:visible $view)
   (case $view
     (((HContext "task" 4 task "Task" $_ ((HChild "alpha" 1 episode "A")
                                            (HChild "episode" 1 episode "Episode"))) True)
      ($other False))))
(= (shadow-hierarchy:record)
   (hm:record (shadow-hierarchy:socket) (shadow-hierarchy:space)
      "project" "task" "episode" "Episode" "Task body" "New episode"))
(= (shadow-hierarchy:run $body)
   (let* (($owner (shadow-hierarchy:start))
          ($alpha (shadow-hierarchy:put "alpha" episode "A" $body ()))
          ($beta (shadow-hierarchy:put "beta" episode "B" $body ()))
          ($task (shadow-hierarchy:put "task" task "Task" "Task body" ("alpha")))
          ($append (shadow-hierarchy:link "beta"))
          ($repeat (shadow-hierarchy:link "beta"))
          ($reorder (shadow-hierarchy:put "task" task "Task" "Task body" ("beta" "alpha")))
          ($added (shadow-hierarchy:record))
          ($retired (hm:retire (shadow-hierarchy:socket) (shadow-hierarchy:space) "beta" "fixture retirement"))
          ($before (shadow-hierarchy:archives))
          ($first-view (shadow-hierarchy:view))
          ($_ (shadow-hierarchy:stop $owner))
          ($reopened (shadow-hierarchy:start))
          ($after (shadow-hierarchy:archives))
          ($last-view (shadow-hierarchy:view))
          ($_ (shadow-hierarchy:stop $reopened))
          ($writes ($alpha $beta $task $append $repeat $reorder $added $retired))
          ($expected-writes ((HStored "alpha" 1 updated) (HStored "beta" 1 updated)
             (HStored "task" 1 updated) (HStored "task" 2 updated) (HStored "task" 2 unchanged)
             (HStored "task" 3 updated) (HStored "episode" 1 captured) (HStored "beta" 2 updated)))
          ($valid (and (and (== $writes $expected-writes) (== $before (shadow-hierarchy:expected $body)))
                    (and (== $before $after) (and (== $first-view $last-view) (shadow-hierarchy:visible $last-view)))))
          ($bytes (fs:size (str:concat (shadow-hierarchy:store) "/journal.csl"))))
     (if (== (get-type $bytes) Number)
       (JsonObject ((JsonPair "schema" 1) (JsonPair "complete" True) (JsonPair "checks_passed" $valid)
         (JsonPair "observations" (JsonArray ((JsonString (repr $writes))
            (JsonString (repr $before)) (JsonString (repr $after))
            (JsonString (repr $first-view)) (JsonString (repr $last-view)))))
         (JsonPair "metrics" (JsonObject ((JsonPair "journal_bytes" $bytes))))))
       (shadow-hierarchy:fail journal-size))))

!(let* (($input (system:getenv-or-default "SHADOW_INPUT" ""))
         ($body (if (== $input "") "equal source bodies λ" (fs:read-text $input)))
         ($path (system:getenv-or-default "SHADOW_REPORT" ""))
         ($_ (if (and (== (get-type $body) String) (!= $path "")) True (shadow-hierarchy:fail fixture-input)))
         ($_ (fs:make-directories (shadow-hierarchy:store) 448))
         ($_ (fs:set-mode (shadow-hierarchy:store) 448))
         ($report (shadow-hierarchy:run $body)))
   (fs:write $path (json:stringify $report)))
