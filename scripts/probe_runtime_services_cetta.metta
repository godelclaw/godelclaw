; Read-only transport and tool-discovery checks. Policy stays in MeTTa.
!(import! &self ../src/provider_request_cetta.metta)
!(import! &self (library proc))

(: protocol-probe:check (-> %Undefined% %Undefined%))
(= (protocol-probe:check $condition)
   (if $condition True (let $_ (println! NATIVE_PROTOCOL_NOT_READY) (system:exit 1))))
(: protocol-probe:run (-> %Undefined% %Undefined% %Undefined%))
(= (protocol-probe:run $helper $arguments)
   (let* (($argv (preq:cons $helper $arguments))
          ($result (proc:run $argv (system:cwd) () 6000 1048576)))
     (case $result
       (((proc:exited 0 $stdout $stderr) (preq:parse $stdout))
        ($failed (let $_ (println! NATIVE_PROTOCOL_IO_FAILED) (system:exit 2)))))))
(: protocol-probe:byte (-> %Undefined% Number Number))
(= (protocol-probe:byte $hex $index)
   (let* (($at (* $index 2)) ($middle (+ $at 1)) ($end (+ $at 2))
          ($high (str:find "0123456789abcdef" (str:byte-slice $hex $at $middle)))
          ($low (str:find "0123456789abcdef" (str:byte-slice $hex $middle $end))))
     (+ (* $high 16) $low)))
(: protocol-probe:telegram (-> %Undefined% %Undefined% %Undefined%))
(= (protocol-probe:telegram $helper $socket)
   (let* (($reply (protocol-probe:run $helper ("packet" $socket "435750310100" "6")))
          ((JsonNumber $count) (preq:field $reply "packet_bytes"))
          ((JsonString $prefix) (preq:field $reply "prefix_hex"))
          ($bytes (json:parse $count))
          ($_ (protocol-probe:check (and (>= $bytes 6) (== (str:byte-length $prefix) 12))))
          ($kind (protocol-probe:byte $prefix 4)) ($id-bytes (protocol-probe:byte $prefix 5))
          ($_ (protocol-probe:check (and (str:starts-with $prefix "43575031")
                 (and (>= $bytes (+ 6 $id-bytes)) (or (== $kind 64) (== $kind 65)))))))
     (TelegramProtocolReadyV1 (== $kind 65))))
(: protocol-probe:gateway (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (protocol-probe:gateway $helper $socket $agent)
   (let* (($request (preq:render (preq:object ((JsonPair "version" (JsonNumber "1"))
             (preq:pair "agent" (preq:string $agent)) (JsonPair "operation" (JsonString "tools"))))))
          ($line (str:concat $request "\n"))
          ($reply (protocol-probe:run $helper ("line" $socket $line "1048576")))
          ($_ (protocol-probe:check (and (== (preq:field $reply "agent") (preq:string $agent))
                                        (not (preq:has $reply "error")))))
          ((JsonObject $tools) (preq:field $reply "value")))
     (GatewayProtocolReadyV1 $agent (preq:size $tools))))
(: protocol-probe:telegrams (-> %Undefined% %Undefined% %Undefined%))
(= (protocol-probe:telegrams $helper $sockets)
   (if (== $sockets ()) ()
     (let* (($answer (protocol-probe:telegram $helper (preq:head $sockets)))
            ($rest (protocol-probe:telegrams $helper (preq:tail $sockets))))
       (preq:cons $answer $rest))))
(: protocol-probe:gateways (-> %Undefined% %Undefined% %Undefined%))
(= (protocol-probe:gateways $helper $sockets)
   (if (== $sockets ()) ()
     (let* ((($socket $agent) (preq:head $sockets))
            ($answer (protocol-probe:gateway $helper $socket $agent))
            ($rest (protocol-probe:gateways $helper (preq:tail $sockets))))
       (preq:cons $answer $rest))))
(: protocol-probe:runtime (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (protocol-probe:runtime $helper $telegrams $gateways)
   (let* (($transports (protocol-probe:telegrams $helper $telegrams))
          ($tools (protocol-probe:gateways $helper $gateways)))
     (NativeRuntimeProtocolsReadyV1 $transports $tools)))
