; The coding-session estate on the core engine: every verdict of the ordered
; classifier and every listing branch (the Lean model CodingSessionLifecycle:
; classify, guard and listed), the exact context view and its bound, the
; refusal a pinned resume gives, the work-status lines and details, and the
; hold, archive and settings verbs.
;   NATIVE_TEST_ARTIFACTS=... $NATIVE_TEST_CORE/cetta --lang petta --import-mode ancestor-walk \
;     --quiet scripts/test_coding_estate_cetta.metta
!(import! &self ../tests/native_test_support.metta)
!(import! &self ../src/coding_io_cetta.metta)
!(import! &self ../src/coding_estate_cetta.metta)

(= (ces:session $base $id $runtime $state)
   (let* (($dir (path:join (path:join $base "memory/coding") $id)) ($_ (fs:make-directories $dir 504))
          ($_ (fs:write (path:join $dir "task.json") "{\"task\":\"t\"}"))
          ($_ (if (== $runtime "") () (fs:write (path:join $dir "runtime.json") $runtime)))
          ($_ (fs:write (path:join $dir "state.json") $state)))
     $dir))
(= (ces:runtime $root $binary $sha $phase)
   (json-stringify (JsonObject (cio:append-list
     ((JsonPair "root" (JsonString $root)) (JsonPair "digest" (JsonString "0123456789abcdef"))
      (JsonPair "binary" (JsonString $binary)))
     (cio:append-list (if (== $sha "") () ((JsonPair "binary_sha256" (JsonString $sha))))
                      (if (== $phase "") () ((JsonPair "phase" (JsonString $phase)))))))))
(= (ces:verdict $base $id)
   (let (EstateView $facts $session) (estate:session-view $base $id) (estate:classify $facts $session)))
(= (ces:problem $base $id)
   (let (EstateView $facts $session) (estate:session-view $base $id) (estate:resume-problem $facts $session)))
(= (ces:suffix $base $id)
   (let (EstateView $facts $session) (estate:session-view $base $id) (estate:status-suffix $facts $session)))
(= (ces:detail $base $id)
   (let (EstateView $facts $session) (estate:session-view $base $id) (estate:status-detail $facts $session)))
(= (ces:sha $path) (case (fs:sha256-file $path) (((fs:hashed-v1 $hex $info) $hex) ($o $o))))
(= (ces:mode $path)
   (case (fs:metadata $path follow-permissions) (((fs:info $k $s $i (fs:permissions $bits)) $bits) ($o $o))))
; Child processes keep the engine's notion of local time.
(= (ces:env)
   (let $tz (system:getenv-or-default "TZ" "")
     (if (== $tz "") (nt:environment "/") (cons-atom ("TZ" $tz) (nt:environment "/")))))
(= (ces:sh $script $args)
   (nt:exit-ok (proc:run (cons-atom "sh" (cons-atom "-c" (cons-atom $script (cons-atom "sh" $args))))
                         "/" (ces:env) 60000 65536)))
(= (ces:touch $path $when) (ces:sh "touch -m -d \"$1\" \"$2\"" ($when $path)))
(= (ces:epoch $when) (str:trim (ces:sh "date -d \"$1\" +%s" ($when))))
(= (ces:fixed) "2026-10-23 12:00:00")
(= (ces:pinned) "2026-10-22 09:00:00")
(= (ces:digest $prefix) (str:concat $prefix "00000000000000000000000000000000000000000000000000000000"))
(= (ces:selection $snapshot $value)
   (sf:put $snapshot "selection" (JsonObject ((JsonPair "llm-ledger-sqlite" $value)))))
(= (ces:facts $value)
   (JsonObject ((JsonPair "today" "2026-10-25")
                (JsonPair "selection" (JsonObject ((JsonPair "llm-ledger-sqlite" $value)))))))
(= (ces:view $base $value) (estate:context-view (ces:selection (estate:snapshot $base "2026-10-25") $value)))

; An agent's estate: its engine, the current runtime, a runtime frozen before
; the native LLM ledger, an unused runtime, and memory/coding.
(= (ces:world $root $name)
   (let* (($base (path:join $root $name))
          ($runtimes (path:join $base "memory/coding-runtimes"))
          ($_ (fs:make-directories (path:join $base "memory/coding") 504))
          ($current (path:join $runtimes (ces:digest "aaaa1111")))
          ($old (path:join $runtimes (ces:digest "8acffdbd")))
          ($unused (path:join $runtimes (ces:digest "cccc3333")))
          ($_ (fs:make-directories (path:join $current "src") 504))
          ($_ (fs:write (path:join $current "coding_main.metta") "; main\n"))
          ($_ (fs:write (path:join $current "src/llm_ledger.metta") "; native ledger\n"))
          ($_ (fs:make-directories (path:join $old "src") 504))
          ($_ (fs:write (path:join $old "coding_main.metta") "; old main\n"))
          ($_ (fs:make-directories (path:join $unused "src") 504))
          ($_ (fs:write (path:join $unused "coding_main.metta") "; unused\n"))
          ($engine (path:join $base "cetta-engine"))
          ($_ (fs:write $engine "#!/bin/sh\nexit 0\n")))
     (CesWorld $base $engine (ces:sha $engine) $current $old (ces:epoch (ces:fixed)))))
; A pin as the coding worker records it; an empty hash leaves the engine unrecorded.
(= (ces:pin $world $bundle $sha)
   (let (CesWorld $base $engine $hash $current $old $fixed) $world
     (cio:append-list
       ((JsonPair "root" (JsonString $bundle)) (JsonPair "digest" (JsonString (cio:basename $bundle)))
        (JsonPair "binary" (JsonString $engine)))
       (cio:append-list (if (== $sha "") () ((JsonPair "binary_sha256" (JsonString $sha))))
                        ((JsonPair "phase" (JsonString "ended")))))))
; A session's files: task.json, state.json (unless the status is "") updated
; at the fixed time, and runtime.json when pinned.
(= (ces:files $world $name $status $pin)
   (let* (((CesWorld $base $engine $hash $current $old $fixed) $world)
          ($dir (path:join (path:join $base "memory/coding") $name))
          ($_ (fs:make-directories $dir 504))
          ($_ (fs:write (path:join $dir "task.json")
                (json-stringify (JsonObject ((JsonPair "task" (JsonString (str:concat "Task for " $name)))
                                             (JsonPair "model" (JsonString "fixture-model"))
                                             (JsonPair "effort" (JsonString "high")))))))
          ($_ (if (== $status "") ()
                (fs:write (path:join $dir "state.json")
                  (json-stringify (JsonObject ((JsonPair "status" (JsonString $status)) (JsonPair "steps" (JsonNumber "3"))
                                               (JsonPair "progress" (JsonString "step 3")) (JsonPair "inbox" (JsonNumber "0"))
                                               (JsonPair "updated" (JsonNumber $fixed))))))))
          ($_ (if (== $pin ()) () (fs:write (path:join $dir "runtime.json") (json-stringify (JsonObject $pin))))))
     $dir))
; The same session with its files dated: task and state at the fixed time,
; the pin at the pin time.
(= (ces:make $world $name $status $pin)
   (let* (($dir (ces:files $world $name $status $pin))
          ($_ (ces:touch (path:join $dir "task.json") (ces:fixed)))
          ($_ (if (== $status "") () (ces:touch (path:join $dir "state.json") (ces:fixed))))
          ($_ (if (== $pin ()) () (ces:touch (path:join $dir "runtime.json") (ces:pinned)))))
     $dir))

(= (ces:verdicts $root)
   (let* (($base (path:join $root "agent"))
          ($bundle (path:join $root "bundle")) ($_ (fs:make-directories (path:join $bundle "src") 504))
          ($_ (fs:write (path:join $bundle "src/llm_ledger.metta") "; selected\n"))
          ($old-bundle (path:join $root "old-bundle")) ($_ (fs:make-directories $old-bundle 504))
          ($engine (path:join $root "engine")) ($_ (fs:write $engine "engine one"))
          ($sha (ces:sha $engine))
          ($done "{\"status\":\"done\",\"steps\":3,\"updated\":1794500000.0}")
          ($_ (ces:session $base "s-unpinned" "" $done))
          ($_ (ces:session $base "s-root-gone" (ces:runtime "/nonexistent-bundle" $engine $sha "ended") $done))
          ($_ (ces:session $base "s-engine-gone" (ces:runtime $bundle "/nonexistent-engine" $sha "ended") $done))
          ($_ (ces:session $base "s-engine-changed" (ces:runtime $bundle $engine "beef" "ended") $done))
          ($_ (ces:session $base "s-pre-token" (ces:runtime $bundle $engine $sha "") $done))
          ($_ (ces:session $base "s-unrecorded" (ces:runtime $bundle $engine "" "ended") $done))
          ($_ (ces:session $base "s-resumable" (ces:runtime $bundle $engine $sha "ended") $done))
          ($_ (ces:session $base "s-ledger" (ces:runtime $old-bundle $engine $sha "ended") $done))
          ($_ (nt:require unpinned (nt:equal (ces:verdict $base "s-unpinned") (EstateVerdict "unpinned" "a resume pins the current runtime"))))
          ($_ (nt:require frozen-runtime-gone (nt:equal (ces:verdict $base "s-root-gone") (EstateVerdict "needs-current" "its frozen runtime is gone"))))
          ($_ (nt:require engine-gone (nt:equal (ces:verdict $base "s-engine-gone") (EstateVerdict "needs-current" "its engine binary is gone"))))
          ($_ (nt:require engine-changed (nt:equal (ces:verdict $base "s-engine-changed") (EstateVerdict "needs-current" "its engine binary has changed"))))
          ($_ (nt:require predates-tokens (nt:equal (ces:verdict $base "s-pre-token") (EstateVerdict "needs-current" "its runtime predates run tokens"))))
          ($_ (nt:require engine-unrecorded (nt:equal (ces:verdict $base "s-unrecorded") (EstateVerdict "unverified" "engine not recorded"))))
          ($_ (nt:require resumable (nt:equal (ces:verdict $base "s-resumable") (EstateVerdict "resumable" ""))))
          ;; A pin on the retired SQLite ledger: unknown selection refuses
          ;; retryably; a native selection retires the pin.
          ($_ (nt:require ledger-unknown-unverified
                (case (ces:verdict $base "s-ledger")
                  (((EstateVerdict "unverified" $why) (str:starts-with $why "the LLM ledger's backend selection is unavailable (")) ($o False)))))
          ($_ (nt:require ledger-unknown-retryable (str:ends-with (ces:problem $base "s-ledger") "; its pin cannot be checked now. Try again later.")))
          ($retired (let (EstateView $facts $session) (estate:session-view $base "s-ledger")
                      (estate:classify (JsonObject ((JsonPair "today" "2026-11-12")
                                                    (JsonPair "selection" (JsonObject ((JsonPair "llm-ledger-sqlite" "native"))))))
                                       $session)))
          ($_ (nt:require ledger-retired (nt:equal $retired (EstateVerdict "needs-current" "it uses the retired SQLite LLM ledger"))))
          ($_ (nt:require needs-current-refused (nt:equal (ces:problem $base "s-engine-changed") "its engine binary has changed")))
          ($_ (nt:require unverified-engine-allowed (nt:equal (ces:problem $base "s-unrecorded") "")))
          ($_ (nt:require resumable-allowed (nt:equal (ces:problem $base "s-resumable") "")))
          ($_ (nt:require unpinned-allowed (nt:equal (ces:problem $base "s-unpinned") ""))))
     True))

(= (ces:status-lines $root)
   (let* (($base (path:join $root "agent"))
          ($_ (nt:require unpinned-suffix (nt:equal (ces:suffix $base "s-unpinned") " · unpinned")))
          ($_ (nt:require pinned-suffix (str:starts-with (ces:suffix $base "s-resumable") " · pin 01234567 ")))
          ($_ (nt:require pinned-suffix-verdict (str:ends-with (ces:suffix $base "s-resumable") " · resumable")))
          ($detail (ces:detail $base "s-engine-changed"))
          ($_ (nt:require detail-names-bundle (nt:contains $detail "\npin: bundle 0123456789abcdef · engine engine (recorded beef, current ")))
          ($_ (nt:require detail-names-verdict (nt:contains $detail " · needs-current: its engine binary has changed\n")))
          ($_ (nt:require detail-no-lifecycle (str:ends-with $detail "\nlifecycle: none")))
          ($_ (nt:require detail-unpinned (str:starts-with (ces:detail $base "s-unpinned") "\npin: unpinned (a resume pins the current runtime)")))
          ($l (ces:session $base "s-launching" (ces:runtime (path:join $root "bundle") (path:join $root "engine") "" "reserved") "{\"status\":\"done\"}"))
          ($_ (fs:write (path:join $l "runtime.json")
                (json-stringify (sf:put (sf:object (path:join $l "runtime.json")) "at" (JsonNumber "1794500000.5")))))
          ($view (estate:session-view $base "s-launching"))
          ($_ (nt:require launching-shown
                (case $view (((EstateView $f $s) (nt:equal (estate:effective-status $s False)
                                                           (str:concat "launching since " (system:format-time "%Y-%m-%d" 1794500000.5 "local"))))))))
          ($_ (nt:require active-scope-shows-status
                (case $view (((EstateView $f $s) (nt:equal (estate:effective-status $s True) "done"))))))
          ($all (estate:sessions-view $base))
          ($_ (nt:require listing-has-every-session
                (case $all (((EstateSessions $facts $sessions) (nt:equal (size-atom $sessions) 9)))))))
     True))

(= (ces:verbs $root)
   (let* (($base (path:join $root "agent")) ($dir (path:join $base "memory/coding/s-resumable"))
          ($_ (nt:require hold-without-date (nt:equal (cio:hold-session $dir "waiting for review" "") "WORK_HELD s-resumable")))
          ($_ (nt:require hold-recorded (nt:equal (coding:field (coding:field (sf:object (path:join $dir "lifecycle.json")) "hold") "review") JsonNull)))
          ($_ (nt:require hold-with-date (nt:equal (cio:hold-session $dir "later" "2028-02-29") "WORK_HELD_UNTIL 2028-02-29 s-resumable")))
          ($_ (nt:require held-suffix (str:ends-with (ces:suffix $base "s-resumable") " · held until 2028-02-29: later")))
          ($_ (nt:require held-detail (nt:contains (ces:detail $base "s-resumable") "\nlifecycle: hold until 2028-02-29: later ({\"hold\": {\"at\": ")))
          ($_ (nt:require held-detail-record-sorted (str:ends-with (ces:detail $base "s-resumable") ", \"review\": \"2028-02-29\", \"why\": \"later\"}})")))
          ($_ (nt:require invalid-day-refused (nt:equal (cio:hold-session $dir "x" "2026-02-29") "work-hold: invalid review date \"2026-02-29\"; use YYYY-MM-DD")))
          ($_ (nt:require invalid-shape-refused (str:starts-with (cio:hold-session $dir "x" "2026-1-01") "work-hold: invalid review date")))
          ($_ (nt:require refused-hold-keeps-label (nt:equal (coding:field (coding:field (sf:object (path:join $dir "lifecycle.json")) "hold") "review") (JsonString "2028-02-29"))))
          ($_ (nt:require archive (nt:equal (cio:archive-session $dir "superseded") "WORK_ARCHIVED s-resumable")))
          ($_ (nt:require archived-suffix (str:ends-with (ces:suffix $base "s-resumable") " · archived: superseded")))
          ($_ (nt:require archived-detail (nt:contains (ces:detail $base "s-resumable") "\nlifecycle: archive: superseded ({\"archive\": {\"at\": ")))
          ($_ (nt:require archive-replaces-hold (nt:equal (coding:field (sf:object (path:join $dir "lifecycle.json")) "hold") JsonNull)))
          ($_ (nt:require hold-needs-session (nt:equal (cio:hold-session (path:join $base "memory/coding/nope") "x" "") "work-hold: no session nope")))
          ($_ (nt:require archive-needs-session (nt:equal (cio:archive-session (path:join $base "memory/coding/nope") "x") "work-archive: no session nope")))
          ($_ (nt:require no-temporaries (nt:equal (cio:hidden-names (fs:entries $dir)) (".lifecycle.lock")))))
     True))
(= (cio:hidden-names $names)
   (if (== $names ()) ()
     (let $rest (cio:hidden-names (cdr-atom $names))
       (if (str:starts-with (car-atom $names) ".") (cons-atom (car-atom $names) $rest) $rest))))

(= (ces:settings $root)
   (let* (($base (path:join $root "settings")) ($_ (fs:make-directories (path:join $base "memory") 504))
          ($_ (nt:require context-default (nt:equal (cio:work-setting $base "context") "open")))
          ($_ (nt:require resume-default (nt:equal (cio:work-setting $base "resume") "pinned")))
          ($_ (nt:require context-saved (nt:equal (cio:set-work-setting $base "context" "summary") (path:join $base "memory/coding-settings.json"))))
          ($_ (nt:require context-read (nt:equal (cio:work-setting $base "context") "summary")))
          ($_ (cio:set-work-setting $base "resume" "current"))
          ($_ (nt:require both-kept (and (nt:equal (cio:work-setting $base "resume") "current") (nt:equal (cio:work-setting $base "context") "summary"))))
          ($_ (fs:write (path:join $base "memory/coding-settings.json") "{\"context\":\"loud\",\"resume\":7}"))
          ($_ (nt:require unknown-context-default (nt:equal (cio:work-setting $base "context") "open")))
          ($_ (nt:require unknown-resume-default (nt:equal (cio:work-setting $base "resume") "pinned"))))
     True))

; Every branch of the Lean model's classify and guard: the verdict, and
; whether a pinned resume is allowed.
(= (ces:branch $base $id $selection)
   (let* (((EstateView $f $session) (estate:session-view $base $id))
          ($facts (ces:facts $selection))
          ((EstateVerdict $verdict $reason) (estate:classify $facts $session)))
     ($id $verdict (== (estate:resume-problem $facts $session) ""))))
(= (ces:lean-branches $root)
   (let* (($world (ces:world $root "lean"))
          ((CesWorld $base $engine $hash $current $old $fixed) $world)
          ($_ (ces:files $world "unpinned" "stopped" ()))
          ($_ (ces:files $world "bundle-missing" "stopped" (ces:pin $world (path:join $root "absent-bundle") $hash)))
          ($_ (ces:files $world "retired" "stopped" (ces:pin $world $old $hash)))
          ($_ (ces:files $world "engine-gone" "stopped"
                (sf:put-pairs (ces:pin $world $current $hash) "binary" (JsonString (path:join $root "absent-engine")))))
          ($_ (ces:files $world "no-hash" "stopped" (ces:pin $world $current "")))
          ($_ (ces:files $world "hash-diff" "stopped" (ces:pin $world $current (str:concat "b" (ces:digest "bbbbbbb")))))
          ($_ (ces:files $world "resumable" "stopped" (ces:pin $world $current $hash)))
          ($legacy "legacy") ($native "native") ($unknown (eio:unknown "unreachable"))
          ($_ (nt:require lean-classify-and-guard
                (nt:equal ((ces:branch $base "unpinned" $legacy) (ces:branch $base "bundle-missing" $legacy)
                           (ces:branch $base "retired" $native) (ces:branch $base "retired" $unknown)
                           (ces:branch $base "engine-gone" $legacy) (ces:branch $base "no-hash" $legacy)
                           (ces:branch $base "hash-diff" $legacy) (ces:branch $base "resumable" $legacy)
                           (ces:branch $base "retired" $legacy))
                          (("unpinned" "unpinned" True) ("bundle-missing" "needs-current" False)
                           ("retired" "needs-current" False) ("retired" "unverified" False)
                           ("engine-gone" "needs-current" False) ("no-hash" "unverified" True)
                           ("hash-diff" "needs-current" False) ("resumable" "resumable" True)
                           ("retired" "resumable" True))))))
     True))

; Every branch of listed: a running session always shows; done and archived
; never do; a hold hides a session until its review date, an open hold for good.
(= (ces:listed-branches $root)
   (let* (($world (ces:world $root "listed"))
          ((CesWorld $base $engine $hash $current $old $fixed) $world)
          ($pin (ces:pin $world $current $hash))
          ($_ (ces:files $world "running_free" "running" $pin))
          ($_ (cio:archive-session (ces:files $world "running_archived" "running" $pin) "archived"))
          ($_ (cio:hold-session (ces:files $world "running_held_indef" "running" $pin) "held" ""))
          ($_ (ces:files $world "done_free" "done" $pin))
          ($_ (cio:archive-session (ces:files $world "archived_stopped" "stopped" $pin) "archived"))
          ($_ (ces:files $world "stopped_free" "stopped" $pin))
          ($_ (cio:hold-session (ces:files $world "stopped_held_future" "stopped" $pin) "held" "2026-10-30"))
          ($_ (cio:hold-session (ces:files $world "stopped_held_today" "stopped" $pin) "held" "2026-10-25"))
          ($_ (cio:hold-session (ces:files $world "stopped_held_past" "stopped" $pin) "held" "2026-10-20"))
          ($_ (cio:hold-session (ces:files $world "stopped_held_indef" "stopped" $pin) "held" ""))
          ((EstateSessions $facts $sessions) (estate:sessions-view $base))
          ($today (ces:facts "legacy"))
          ($_ (nt:require lean-listed
                (nt:equal (map-atom $sessions $s ((estate:field $s "id" "") (estate:listed $today $s)))
                          (("archived_stopped" False) ("done_free" False) ("running_archived" True)
                           ("running_free" True) ("running_held_indef" True) ("stopped_free" True)
                           ("stopped_held_future" False) ("stopped_held_indef" False)
                           ("stopped_held_past" True) ("stopped_held_today" True))))))
     True))

; The whole view of an estate covering every status, verdict and label.
(= (ces:exact-view $root)
   (let* (($empty (path:join $root "empty-agent")) ($_ (fs:make-directories $empty 504))
          ($_ (nt:require no-coding-directory-no-view (nt:equal (estate:context-view-root $empty "2026-10-25") EstateMissing)))
          ($world (ces:world $root "exact"))
          ((CesWorld $base $engine $hash $current $old $fixed) $world)
          ($pin (ces:pin $world $current $hash))
          ($_ (ces:make $world "work-01-done" "done" $pin))
          ($_ (ces:make $world "work-02-unpinned" "failed" ()))
          ($_ (ces:make $world "work-03-retired" "stopped" (ces:pin $world $old $hash)))
          ($_ (ces:make $world "work-04-no-hash" "interrupted" (ces:pin $world $current "")))
          ($_ (ces:make $world "work-05-resumable" "running" $pin))
          ($future (ces:make $world "work-06-held-future" "stopped" $pin))
          ($_ (cio:hold-session $future "waiting on upstream" "2026-11-10"))
          ($_ (cio:hold-session (ces:make $world "work-07-held-past" "stopped" $pin) "check after release" "2026-10-20"))
          ($_ (cio:hold-session (ces:make $world "work-08-held-indef" "failed" $pin) "parked indefinitely" ""))
          ($_ (cio:archive-session (ces:make $world "work-09-archived" "stopped" $pin) "superseded by new work"))
          ($_ (ces:make $world "work-10-nostate" "" $pin))
          ($_ (nt:require lifecycle-lock-group-writable (nt:equal (ces:mode (path:join $future ".lifecycle.lock")) 432)))
          ($_ (nt:require lifecycle-file-group-writable (nt:equal (ces:mode (path:join $future "lifecycle.json")) 432)))
          ($first (ces:view $base "native"))
          ($_ (nt:require view-idempotent (nt:equal (ces:view $base "native") $first)))
          ($head "CODING_SESSIONS 10: 1 done · 1 failed · 1 stopped · 1 interrupted · 1 running · 1 unknown · 3 held · 1 archived · needs-current 1 · unverified 1 · resumable 7 · unpinned 1 · runtimes 3 (0 MB; 1 used by no open session)")
          ($_ (nt:require exact-view
                (nt:equal $first
                  (str:join "\n" ($head
                    "work-02-unpinned failed 2026-10-23 · unpinned: a resume pins the current runtime"
                    "work-03-retired stopped 2026-10-23 · pin 8acffdbd 2026-10-22 · needs-current: it uses the retired SQLite LLM ledger"
                    "work-04-no-hash interrupted 2026-10-23 · pin aaaa1111 2026-10-22 · unverified: engine not recorded"
                    "work-05-resumable running 2026-10-23 · pin aaaa1111 2026-10-22 · resumable"
                    "work-07-held-past stopped 2026-10-23 · pin aaaa1111 2026-10-22 · resumable · held until 2026-10-20: check after release"
                    "work-10-nostate unknown 2026-10-23 · pin aaaa1111 2026-10-22 · resumable"
                    "verbs: (work-status \"id\") (work-resume \"id\" [\"current\"]) (work-hold \"id\" \"why\" [\"YYYY-MM-DD\"]) (work-archive \"id\" \"why\")")))))
          ($_ (cio:set-work-setting $base "context" "summary"))
          ($_ (nt:require summary-view (nt:equal (ces:view $base "native") (str:join "\n" ($head (estate:verbs))))))
          ($_ (cio:set-work-setting $base "context" "off"))
          ($_ (nt:require off-view-missing (nt:equal (ces:view $base "native") EstateMissing))))
     True))

; With 200 sessions the view keeps its bound, its full counts and its verbs,
; and names how many lines it left out.
(= (ces:four-digits $i)
   (str:concat (if (< $i 10) "000" (if (< $i 100) "00" (if (< $i 1000) "0" ""))) (repr $i)))
(= (ces:sessions $world $i $n)
   (if (>= $i $n) True
     (let* (((CesWorld $base $engine $hash $current $old $fixed) $world)
            ($name (str:concat "work-20261023-" (ces:four-digits $i)))
            ($kind (% $i 4))
            ($_ (if (== $kind 0) (ces:files $world $name "failed" ())
                  (if (== $kind 1) (ces:files $world $name "stopped" (ces:pin $world $old $hash))
                    (if (== $kind 2) (ces:files $world $name "interrupted" (ces:pin $world $current ""))
                      (ces:files $world $name "stopped" (ces:pin $world $current $hash)))))))
       (ces:sessions $world (+ $i 1) $n))))
(= (ces:bound $root)
   (let* (($world (ces:world $root "many"))
          ((CesWorld $base $engine $hash $current $old $fixed) $world)
          ($_ (ces:sessions $world 0 200))
          ($view (ces:view $base "native"))
          ($lines (str:split "\n" $view))
          ($count (size-atom $lines))
          ($more (str:split " " (index-atom $lines (- $count 2))))
          ($_ (nt:require view-bounded (<= (str:char-length $view) 2000)))
          ($_ (nt:require view-counts-all
                (str:starts-with $view "CODING_SESSIONS 200: 50 failed · 100 stopped · 50 interrupted · needs-current 50 · unverified 50 · resumable 50 · unpinned 50 · ")))
          ($_ (nt:require view-keeps-verbs (nt:equal (index-atom $lines (- $count 1)) (estate:verbs))))
          ($_ (nt:require view-names-omitted
                (and (nt:equal (index-atom $more 0) "…") (nt:equal (cdr-atom (cdr-atom $more)) ("more:" "(work-status)")))))
          ($_ (nt:require shown-and-omitted-are-all
                (nt:equal (+ (- $count 3) (str:string->number (index-atom $more 1))) 200))))
     True))

(= (ces:run)
   (let* (($root (nt:join (nt:required-env "NATIVE_TEST_ARTIFACTS") (str:concat "estate-" (system:uuid4-hex))))
          ($_ (fs:make-directories $root 504))
          ($_ (ces:verdicts $root)) ($_ (ces:status-lines $root)) ($_ (ces:verbs $root))
          ($_ (ces:settings $root)) ($_ (ces:lean-branches $root)) ($_ (ces:listed-branches $root))
          ($_ (ces:exact-view $root)) ($_ (ces:bound $root)))
     CodingEstatePassed))
!(nt:require coding-estate-completed (nt:equal (collapse (ces:run)) (CodingEstatePassed)))
!(println! NATIVE_CODING_ESTATE_PASSED)
