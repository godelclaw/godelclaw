!(import! &self ../tests/native_test_support.metta)
!(import! &self ../src/input_scope_cetta.metta)
(= (scope-contract:run)
   (let* (($reset-first (input-scope:reset))
          ($known (nt:require empty-scope-is-known (input-scope:known?)))
          ($not-settled (nt:require empty-scope-does-not-prove-settlement (not (input-scope:all-settled ()))))
          ($prepared (input-scope:prepare-json "[\"mail:a,b\",\"irc:λ\"]"))
          ($opaque (nt:require parsed-identities-are-opaque-text (nt:equal (input-scope:ids) ("mail:a,b" "irc:λ"))))
          ($encoded (input-scope:json))
          ($reset-second (input-scope:reset)) ($prepared-again (input-scope:prepare-json $encoded))
          ($round-trip (nt:require scope-round-trip-keeps-identities (nt:equal (input-scope:ids) ("mail:a,b" "irc:λ"))))
          ($refused (nt:require malformed-identity-array-refused
             (case (input-scope:prepare-json "[false]") (((Error $call $why) True) ($bad False)))))
          ($preserved (nt:require refusal-preserves-prior-scope (nt:equal (input-scope:ids) ("mail:a,b" "irc:λ"))))) ScopedInputContractsPassedV1))
!(nt:require scope-contract-completed (nt:equal (collapse (scope-contract:run)) (ScopedInputContractsPassedV1)))
!(println! NATIVE_INPUT_SCOPE_CONTRACTS_PASSED)
