!(import! &self ../tests/input_delivery_canary.metta)
(= (input-canary:world $name)
   (let* (($root (system:cwd)) ($sdk (nt:required-env "NATIVE_TEST_SDK"))
          ($core (nt:required-env "NATIVE_TEST_CORE")) ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($fixture (nt:required-env "NATIVE_TEST_HTTP_FIXTURE")))
     (nq:world $root $sdk $core $artifacts $fixture $name)))
(= (input-canary:disposed)
   (let* (($world (input-canary:world "mail-crash"))
          ($mail (ic:mail-server $world))
          ($_ (ic:send $mail "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
          ($_ (ic:expect-crash (ic:run $mail "dispose-crash")))
          ($_ (nt:require disposition-survived-process-death
             (il:committed $world ("mail:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))))
          ($_ (nt:require crash-created-no-checkpoint (nt:equal (il:call $world "working-set" ()) none)))
          ($quiet (nq:output (ic:run $mail "quiet")))
          ($_ (nt:require completed-notice-stays-quiet (nt:contains $quiet "NativeKernelQuietV1")))
          ($_ (ic:send $mail "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
          ($fresh (nq:output (ic:run $mail "read-only")))
          ($_ (nt:require equal-body-new-occurrence-is-presented (nt:contains $fresh "mail:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))
          ($_ (nt:require equal-body-new-occurrence-remains-unsettled
             (not (il:committed $world ("mail:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))))
          ($_ (nt:require only-novel-occurrence-is-open (nt:equal (preq:size (il:requests $world "")) 1)))
          ($_ (ic:close $mail))) 1))
(= (input-canary:unsettled)
   (let* (($world (input-canary:world "mail-retry")) ($mail (ic:mail-server $world))
          ($_ (ic:send $mail "cccccccccccccccccccccccccccccccc"))
          ($_ (ic:expect-crash (ic:run $mail "read-crash")))
          ($_ (nt:require process-death-never-settles-presentation
             (not (il:committed $world ("mail:cccccccccccccccccccccccccccccccc")))))
          ($replayed (nq:output (ic:run $mail "read-only")))
          ($_ (nt:require unsettled-occurrence-reappears-with-same-identity
             (nt:contains $replayed "mail:cccccccccccccccccccccccccccccccc")))
          ($_ (nt:require repeated-presentation-creates-no-new-request (nt:equal (preq:size (il:requests $world "")) 1)))
          ($_ (ic:close $mail))) 1))
(= (input-canary:late)
   (let* (($world (input-canary:world "mail-late")) ($mail (ic:mail-server $world))
          ($_ (ic:send $mail "dddddddddddddddddddddddddddddddd"))
          ($_ (ic:send $mail "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"))
          ($output (nq:output (ic:run $mail "late-scope")))
          ($_ (nt:require old-turn-scope-remains-frozen (nt:contains $output "NativeKernelLateScopeV1")))
          ($_ (nt:require first-occurrence-settled (il:committed $world ("mail:dddddddddddddddddddddddddddddddd"))))
          ($_ (nt:require late-occurrence-not-settled
             (not (il:committed $world ("mail:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")))))
          ($late (nq:output (ic:run $mail "read-only")))
          ($_ (nt:require late-occurrence-survives-old-ack
             (nt:contains $late "mail:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")))
          ($_ (ic:close $mail))) 1))
(= (input-canary:jobs)
   (let* (($world (input-canary:world "job-crash")) ($mail (ic:mail-server $world))
          ($_ (ic:job $world "first" 1))
          ($_ (ic:expect-crash (ic:run $mail "job-dispose-crash")))
          ($_ (nt:require job-disposition-survives-death (il:committed $world ("job:first"))))
          ($quiet (nq:output (ic:run $mail "job-quiet")))
          ($_ (nt:require job-notice-stays-quiet (nt:contains $quiet "NativeKernelJobQuietV1")))
          ($_ (ic:job $world "second" 2))
          ($fresh (nq:output (ic:run $mail "job-read")))
          ($_ (nt:require equal-job-output-new-identity-is-presented (nt:contains $fresh "job:second")))
          ($_ (nt:require novel-job-remains-unsettled (not (il:committed $world ("job:second")))))
          ($_ (ic:close $mail))) 1))
(= (input-canary:run)
   (let* (($_ (input-canary:disposed)) ($_ (input-canary:unsettled))
          ($_ (input-canary:late)) ($_ (input-canary:jobs))
          ($world (input-canary:world "adapter-ids")) ($mail (ic:mail-server $world))
          ($output (nq:output (ic:run $mail "adapter-identities")))
          ($_ (nt:require adapter-identities-complete (nt:contains $output "NativeKernelAdapterIdentitiesV1")))
          ($_ (nt:require missing-ids-create-no-request (nt:equal (il:requests $world "") ())))
          ($_ (ic:send $mail "ffffffffffffffffffffffffffffffff"))
          ($fallthrough (nq:output (ic:run $mail "settled-channel-fallthrough")))
          ($_ (nt:require settled-conversation-fallthrough-complete
             (nt:contains $fallthrough "NativeKernelFallthroughV1")))
          ($unavailable (nq:output (ic:run-with $mail "unavailable-ledger"
             (("METTACLAW_INPUT_LEDGER_SOCKET" (nq:path $world "missing-ledger.sock"))))))
          ($_ (nt:require transport-fault-is-not-new-work (nt:contains $unavailable "NativeKernelUnavailableV1")))
          ($retried (nq:output (ic:run $mail "read-only")))
          ($_ (nt:require unavailable-ledger-never-consumes-delivery (nt:contains $retried "mail:ffffffffffffffffffffffffffffffff")))
          ($_ (ic:close $mail))) NativeInputCanaryPassedV1))
!(nt:require input-crash-canary-completed (nt:equal (collapse (input-canary:run)) (NativeInputCanaryPassedV1)))
!(println! NATIVE_INPUT_CRASH_CANARY_PASSED)
