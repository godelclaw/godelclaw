; Audit the actual release selection without importing candidate source.
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library re))
!(import! &self (library json))
!(import! &self (library system))
!(import! &self (library path))
!(import! &self (library list))
!(import! &self ../src/state_file_cetta.metta)

(= (audit:fail $detail)
   (progn (println! (NATIVE_DEPENDENCY_FAILURE $detail)) (system:exit 1)))
(= (audit:member? $value $items)
   (if (== $items ()) False
     (if (== $value (car-atom $items)) True (audit:member? $value (cdr-atom $items)))))
(= (audit:array $object $key)
   (case (sf:get $object $key JsonNull)
     (((JsonArray $values) $values) ($bad (audit:fail (missing-list $key))))))
(= (audit:unique? $items $previous)
   (if (== $items ()) True
     (if (== (car-atom $items) $previous) False
       (audit:unique? (cdr-atom $items) (car-atom $items)))))
(= (audit:tokens $matches $source $done)
   (case $matches
     ((LNil (list:reverse $done))
      ((LCons $match $rest)
       (let $token (re:group-text $match $source 0)
         (audit:tokens $rest $source
           (if (str:starts-with $token ";") $done (cons-atom $token $done))))))))
(= (audit:target $token)
   (if (str:starts-with $token "\"") (json:parse $token) $token))
(= (audit:resolve $root $directory $target)
   (let* (($candidate (path:normalize (path:join $directory $target)))
          ($name (if (fs:is-file $candidate) $candidate (str:concat $candidate ".metta"))))
     (if (fs:is-file $name) (str:byte-slice $name (+ (str:byte-length $root) 1) (str:byte-length $name))
       (if (== $directory $root) "" (audit:resolve $root (path:dirname $directory) $target)))))
(= (audit:import $root $file $tail $files $dynamic)
   (if (< (size-atom $tail) 2) (audit:fail (malformed-import $file))
     (let* (($target (audit:target (car-atom (cdr-atom $tail))))
            ($computed (or (str:starts-with $target "$") (== $target "("))))
       (if $computed
         (if (and (== $target "(") (== (car-atom (cdr-atom (cdr-atom $tail))) "library")) True
           (if (audit:member? $file $dynamic) True (audit:fail (unadmitted-dynamic-import $file))))
         (if (str:ends-with $target ".py") (audit:fail (python-import $file $target))
           (if (or (== $target "lib_llm") (== $target "lib_python"))
             (audit:fail (foreign-library $file $target))
             (if (str:starts-with $target ".")
               (let $resolved (audit:resolve $root (path:dirname (path:join $root $file)) $target)
                 (if (or (audit:member? $resolved $files) (== $target "./config/channel.metta")) True
                   (audit:fail (unselected-import $file $target $resolved))))
               True)))))))
(= (audit:scan $root $file $tokens $files $dynamic)
   (if (== $tokens ()) True
     (let $rest (cdr-atom $tokens)
       (if (and (== (car-atom $tokens) "(") (not (== $rest ())))
         (let* (($head (car-atom $rest)) ($tail (cdr-atom $rest))
                ($_ (if (or (audit:member? $head ("py-call" "py-dot" "py-eval"))
                            (str:starts-with $head "py:"))
                      (audit:fail (foreign-call $file $head)) True))
                ($_ (if (== $head "import!") (audit:import $root $file $tail $files $dynamic) True)))
           (audit:scan $root $file $rest $files $dynamic))
         (audit:scan $root $file $rest $files $dynamic)))))
(= (audit:source $root $file $lexer $files $dynamic)
   (let $text (fs:read-text (path:join $root $file))
     (case (re:find-all $lexer $text)
       (((re:matches $matches)
         (audit:scan $root $file (audit:tokens $matches $text ()) $files $dynamic))
        ($bad (audit:fail (source-lexing-failed $file $bad)))))))
(= (audit:launcher $root $file $python)
   (let $code (str:join "\n" (filter-atom (str:split "\n" (fs:read-text (path:join $root $file))) $line
                 (not (str:starts-with (str:trim $line) "#"))))
     (if (re:is-match $python $code) (audit:fail (python-launcher $file)) True)))
(= (audit:artifact)
   (let $prefix (system:getenv-or-default "NATIVE_CORE_PREFIX" "")
     (if (== $prefix "") False
       (let $manifest (sf:native-object (path:join $prefix "build-manifest.json"))
         (if (and (== (sf:get $manifest "python_enabled" JsonNull) False)
                  (== (sf:get $manifest "runtime_profile" "") "native-agent"))
           True (audit:fail core-artifact-is-not-python-disabled))))))
(= (audit:run)
   (let* (($root (system:getcwd))
          ($selection (sf:native-object (path:join $root "config/runtime-files.json")))
          ($files (audit:array $selection "files")) ($roles (sf:get $selection "roles" JsonNull))
          ($core (audit:array $roles "cognitive-core"))
          ($runtime (unique-atom (list:append $core
             (list:append (audit:array $roles "console-frontend")
               (list:append (audit:array $roles "gateway-server")
                 (list:append (audit:array $roles "periodic-monitor") (audit:array $roles "service-launchers")))))))
          ($dynamic (map-atom (audit:array $selection "dynamic_imports") $row (sf:get $row "file" "")))
          ; A selected imported module can be missing from a role's hand-written
          ; list. Inspect every selected MeTTa source, including such modules.
          ($inspected (unique-atom (list:append $runtime
             (filter-atom $files $file (str:ends-with $file ".metta")))))
          ($lexer (re:compile ";[^\n]*|\"(?:\\\\.|[^\"\\\\])*\"|[()]|[^\\s();]+"))
          ($python (re:compile "(^|[; \\t])python[0-9.]*[ \\t]|PYTHON(HOME|PATH)=|METTACLAW_MODE_PYTHON"))
          ($_ (if (audit:unique? (sort-strings $files) "") True (audit:fail duplicate-selected-file)))
          ($_ (map-atom $files $file
            (if (fs:is-file (path:join $root $file)) True (audit:fail (missing-selected-file $file)))))
          ($_ (map-atom $inspected $file
            (if (str:ends-with $file ".py") (audit:fail (python-in-core $file))
              (if (str:ends-with $file ".metta") (audit:source $root $file $lexer $files $dynamic)
                (if (or (str:ends-with $file ".sh") (str:ends-with $file ".service")) (audit:launcher $root $file $python) True)))))
          ($_ (re:close $lexer)) ($_ (re:close $python))
          ($artifact (audit:artifact))
          ($inventory (sf:native-object (path:join $root "config/native-migration.json")))
          ($remaining (sf:get (sf:get $inventory "current_batch" JsonNull) "remaining_python_services" JsonNull))
          ($declared-closed (case $remaining (((JsonArray $services) (== $services ())) ($unreported False)))))
     (system:write stdout (str:concat (json:stringify-python
       (JsonObject ((JsonPair "schema" 3) (JsonPair "statically_closed_core" True)
         (JsonPair "native_selection_closed" True)
         (JsonPair "statically_closed_runtime" $declared-closed) (JsonPair "runtime_files" (size-atom $runtime))
         (JsonPair "core_files" (size-atom $core)) (JsonPair "selected_files" (size-atom $files))
         (JsonPair "python_disabled_artifact" $artifact)
         (JsonPair "remaining_services" $remaining)
         (JsonPair "installed_runtime_audited" False)
         (JsonPair "scope" "selected native source closure; runtime roles declared by migration inventory; installed bindings require a separate check")
         (JsonPair "functional_qualification" "separate required gate")))) "\n"))))
!(audit:run)
