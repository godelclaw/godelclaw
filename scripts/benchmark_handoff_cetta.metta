; Alternating cold SDK runs measure the existing no-claims context-view path.
!(import! &self ../tests/provider_native_benchmark.metta)
(= (hb:measure $world $runtime)
   (let* (($module (preq:repr (nt:join $runtime "src/context_compaction.metta")))
          ($output-file (preq:repr (nq:path $world "rendered.txt")))
          ($forms (format-args "!(import! &self {})\n!(let $rendered (task:checkpoint-handoff \"fixture-root\" (JsonObject ((JsonPair \"summary\" (JsonString \"continue from the evidence\"))))) (let $_ (fs:write {} $rendered) (println! CONTEXT_VIEW_BENCHMARK_OK)))\n" ($module $output-file)))
          ((NativeTestGuestResultV1 $elapsed $result) (nq:guest $world "fixture-model" "petta" $forms ()))
          ($checked (nt:require context-view-benchmark-finished (nt:contains (nt:exit-ok $result) "CONTEXT_VIEW_BENCHMARK_OK")))
          ($rss (nq:read-number (nq:path $world "peak-rss-kib")))) (NativeBenchSampleV1 $elapsed $rss)))
(= (hb:pairs $baseline $candidate $old-root $root $left $old-times $new-times)
   (if (<= $left 0) (HandoffBenchmarkV1 $old-times $new-times)
     (let* (($old (if (not (nb:even $left)) (hb:measure $baseline $old-root) (hb:measure $candidate $root)))
            ($new (if (not (nb:even $left)) (hb:measure $candidate $root) (hb:measure $baseline $old-root)))
            ($before (if (not (nb:even $left)) $old $new)) ($after (if (not (nb:even $left)) $new $old))
            ($same (nt:require legacy-handoff-text-unchanged
               (nt:equal (fs:read-text (nq:path $baseline "rendered.txt")) (fs:read-text (nq:path $candidate "rendered.txt")))))
            ($old-next (preq:cons $before $old-times)) ($new-next (preq:cons $after $new-times)))
       (hb:pairs $baseline $candidate $old-root $root (- $left 1) $old-next $new-next))))
(= (hb:run)
   (let* (($root (system:cwd)) ($old-root (nt:required-env "NATIVE_BASELINE_ROOT"))
          ($sdk (nt:required-env "NATIVE_TEST_SDK")) ($core (nt:required-env "NATIVE_TEST_CORE"))
          ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS")) ($fixture (nt:required-env "NATIVE_TEST_HTTP_FIXTURE"))
          ($baseline (nq:world $old-root $sdk $core $artifacts $fixture "handoff-before"))
          ($candidate (nq:world $root $sdk $core $artifacts $fixture "handoff-after"))
          ((HandoffBenchmarkV1 $old $new) (hb:pairs $baseline $candidate $old-root $root 21 () ()))
          ($old-sorted (sort-atom (map-atom $old $sample (nb:time $sample))))
          ($new-sorted (sort-atom (map-atom $new $sample (nb:time $sample))))
          ($old-p95 (preq:nth $old-sorted 19)) ($new-p95 (preq:nth $new-sorted 19))
          ($old-rss (preq:nth (sort-atom (map-atom $old $sample (nb:rss $sample))) 20))
          ($new-rss (preq:nth (sort-atom (map-atom $new $sample (nb:rss $sample))) 20))
          ($budget (nt:require no-material-context-view-regression (<= $new-p95 (* 1.15 $old-p95))))
          ($memory-budget (nt:require no-material-context-view-memory-regression (<= $new-rss (* 1.15 $old-rss))))
          ($reported (println! (HANDOFF_CONTEXT_VIEW_P95_NS $old-p95 $new-p95 (peak-rss-kib $old-rss $new-rss) (before $old) (after $new))))
          ($base-closed (nq:close $baseline)) ($new-closed (nq:close $candidate))) NativeHandoffBenchmarkPassedV1))
!(nt:require handoff-benchmark-completed (nt:equal (collapse (hb:run)) (NativeHandoffBenchmarkPassedV1)))
!(println! NATIVE_HANDOFF_BENCHMARK_PASSED)
