; The curated public-note policy is shared with the cognitive core.
!(import! &self ../src/public_worklog_cetta.metta)
!(import! &self ../src/cli_values_cetta.metta)
!(import! &self (library host_io))
(= (worklog:args $args $root $words $options)
   (if (== $args ()) (WorklogArgumentsV1 $root (list:reverse $words))
     (let $word (car-atom $args)
       (if (and $options (== $word "--")) (worklog:args (cdr-atom $args) $root $words False)
         (if (and $options (== $word "--dir"))
           (if (== (cdr-atom $args) ()) (CliFailureV1 "--dir needs a path")
             (worklog:args (cdr-atom (cdr-atom $args)) (car-atom (cdr-atom $args)) $words $options))
           (if (and $options (str:starts-with $word "--dir="))
             (worklog:args (cdr-atom $args) (str:byte-slice $word 6 (str:byte-length $word)) $words $options)
             (if (and $options (str:starts-with $word "--")) (CliFailureV1 "unknown public-worklog option")
               (worklog:args (cdr-atom $args) $root (cons-atom $word $words) $options))))))))
(= (worklog:read-step $root $seen $enabled)
   (once
    (case (pw:transact $root "read" "" JsonNull)
      (((PublicWorkRead $state (JsonArray $entries))
        (let* (($on (sf:get $state "enabled" False))
               ($_ (if (!= $enabled $on) (system:write stdout (if $on "[ON]\n" "[OFF — new notes are dropped]\n")) True))
               ($next (foldl-atom $entries $seen $last $entry
                 (let $seq (sf:get $entry "seq" 0)
                   (if (> $seq $last)
                     (progn (system:write stdout (str:join "" ((sf:get $entry "time" "") "  " (pw:clean (sf:get $entry "text" "")) "\n"))) $seq)
                     $last))))) (WorklogReadV1 $next $on)))
       ($failure (progn (system:write stderr "public-worklog observation unavailable\n") WorklogReadFailedV1))))))
(= (worklog:watch $root $seen $enabled $signals $once)
   (case (worklog:read-step $root $seen $enabled)
     (((WorklogReadV1 $next $on)
       (if (or $once (!= (host:signal $signals) 0)) 0
         (progn (host:wait () 500) (worklog:watch $root $next $on $signals $once))))
      ($failed 1))))
(= (worklog:main $arguments)
   (case (worklog:args (cli:strings $arguments) (system:expanduser "~/.local/state/godel-worklog") () True)
     (((WorklogArgumentsV1 $root $words)
       (if (or (< (size-atom $words) 1) (> (size-atom $words) 2)) 78
         (let* (($action (car-atom $words)) ($text (if (== (size-atom $words) 2) (car-atom (cdr-atom $words)) "")))
           (if (not (cli:member? $action ("on" "off" "add" "status" "show" "watch"))) 78
             (if (or (== $action "show") (== $action "watch"))
               (let* (($_ (system:write stdout "GODEL WORKLOG — curated progress/results, not private deliberation\nDisplay-only switch; retained notes and terminal scrollback are not erased.\n"))
                      ($signals (host:signals)) ($status (worklog:watch $root 0 WorklogUnobservedV1 $signals (== $action "show")))
                      ($_ (host:close $signals))) $status)
               (let $result (pw:transact $root $action $text JsonNull)
                 (if (erv:failed? $result) (progn (system:write stderr "public-worklog transaction failed\n") 1)
                   (progn (system:write stdout (str:concat (json:stringify-python-with $result ((ensure-ascii True))) "\n")) 0))))))))
      ($bad 78))))
!(system:exit (worklog:main (system:args)))
