; Unit tests of the native coding-session files (src/coding_io_cetta.metta),
; run on the Python-disabled core engine:
;   NATIVE_TEST_ARTIFACTS=<dir> $NATIVE_TEST_CORE/cetta --lang petta \
;     --import-mode ancestor-walk --quiet scripts/test_coding_io_cetta.metta
!(import! &self ../tests/native_test_support.metta)
!(import! &self ../src/coding_io_cetta.metta)

(= (cit:session $root $name $runtime $state)
   (let* (($dir (path:join $root $name)) ($_ (fs:make-directories $dir 504))
          ($_ (if (== $runtime "") () (fs:write (path:join $dir "runtime.json") $runtime)))
          ($_ (if (== $state "") () (fs:write (path:join $dir "state.json") $state))))
     $dir))
(= (cit:field $dir $file $key) (coding:field (cio:json (path:join $dir $file)) $key))
(= (cit:text $dir $file) (fs:read-text (path:join $dir $file)))
(= (cit:no-temporaries $dir)
   (cit:none-hidden (fs:entries $dir)))
(= (cit:none-hidden $names)
   (if (== $names ()) True
     (let $name (car-atom $names)
       (if (and (str:starts-with $name ".") (!= $name ".ending.lock")) False (cit:none-hidden (cdr-atom $names))))))
(= (cit:mode $path)
   (case (fs:metadata $path follow-permissions)
     (((fs:info $kind $size $identity (fs:permissions $bits)) $bits) ($other $other))))

; A token is consumed once, only while it is the newest reservation.
(= (cit:run-tokens $root)
   (let* (($d (cit:session $root "consume" "{\"run\":\"tok1\",\"phase\":\"reserved\"}"
                 "{\"status\":\"done\",\"steps\":4,\"inbox\":2}"))
          ($_ (nt:require empty-token-refused (nt:equal (cio:consume-run $d "" "1:a" $root) 0)))
          ($_ (nt:require other-token-refused (nt:equal (cio:consume-run $d "tok2" "1:a" $root) 0)))
          ($_ (nt:require refusal-logged (nt:contains (cit:text $d "run.log") "refused run token tok2: manifest run=tok1 phase=reserved")))
          ($_ (nt:require reserved-token-consumed (nt:equal (cio:consume-run $d "tok1" "1:a" $root) 1)))
          ($_ (nt:require run-started (nt:equal (cit:field $d "runtime.json" "phase") (JsonString "started"))))
          ($_ (nt:require state-running (nt:equal (cit:field $d "state.json" "status") (JsonString "running"))))
          ($_ (nt:require owner-recorded (nt:equal (cit:field $d "state.json" "worker_owner") (JsonString "1:a"))))
          ($_ (nt:require run-recorded (nt:equal (cit:field $d "state.json" "run") (JsonString "tok1"))))
          ($_ (nt:require steps-carried (nt:equal (cit:field $d "state.json" "steps") (JsonNumber "4"))))
          ($_ (nt:require inbox-carried (nt:equal (cit:field $d "state.json" "inbox") (JsonNumber "2"))))
          ($_ (nt:require token-single-use (nt:equal (cio:consume-run $d "tok1" "2:b" $root) 0)))
          ($n (cit:session $root "negative" "{\"run\":\"t\",\"phase\":\"reserved\"}" "{\"steps\":-2,\"inbox\":1.5}"))
          ($_ (cio:consume-run $n "t" "1:a" $root))
          ($_ (nt:require integer-count-carried (nt:equal (cit:field $n "state.json" "steps") (JsonNumber "-2"))))
          ($_ (nt:require fraction-count-zeroed (nt:equal (cit:field $n "state.json" "inbox") (JsonNumber "0"))))
          ($_ (nt:require second-claim-left-owner (nt:equal (cit:field $d "state.json" "worker_owner") (JsonString "1:a"))))
          ($bundle (path:join $root "bundle-a")) ($_ (fs:make-directories $bundle 504))
          ($other (path:join $root "bundle-b")) ($_ (fs:make-directories $other 504))
          ($b (cit:session $root "bound" (format-args "{\"root\":\"{}\",\"run\":\"t\",\"phase\":\"reserved\"}" ($bundle)) ""))
          ($_ (nt:require foreign-bundle-refused (nt:equal (cio:consume-run $b "t" "1:a" $other) 0)))
          ($_ (nt:require foreign-bundle-logged (nt:contains (cit:text $b "run.log") "bundle mismatch")))
          ($_ (nt:require reservation-kept (nt:equal (cit:field $b "runtime.json" "phase") (JsonString "reserved"))))
          ($_ (nt:require own-bundle-accepted (nt:equal (cio:consume-run $b "t" "1:a" (path:join $root "bundle-a/.")) 1))))
     True))

; Worker writes need the started run and its owner; an ending ends the run.
(= (cit:worker-writes $root)
   (let* (($w (cit:session $root "worker" "{\"run\":\"t\",\"phase\":\"reserved\"}" ""))
          ($_ (nt:require worker-claims (nt:equal (cio:consume-run $w "t" "9:x" $root) 1)))
          ($_ (nt:require stranger-refused (nt:equal (cio:worker-state $w "t" "8:y" "running" 1 "p" 0 "" NoReport) 0)))
          ($_ (nt:require stale-token-refused (nt:equal (cio:worker-state $w "u" "9:x" "running" 1 "p" 0 "" NoReport) 0)))
          ($_ (nt:require progress-written (nt:equal (cio:worker-state $w "t" "9:x" "running" 2 "working" 1 "" NoReport) 1)))
          ($_ (nt:require progress-recorded (nt:equal (cit:field $w "state.json" "progress") (JsonString "working"))))
          ($_ (nt:require progress-keeps-run (nt:equal (cit:field $w "runtime.json" "phase") (JsonString "started"))))
          ($_ (nt:require progress-no-delivery (nt:equal (cit:field $w "state.json" "delivery") (JsonString "none"))))
          ($_ (nt:require ending-written (nt:equal (cio:worker-state $w "t" "9:x" "done" 3 "finished" 1 "given-id" "the report") 1)))
          ($_ (nt:require ending-ends-run (nt:equal (cit:field $w "runtime.json" "phase") (JsonString "ended"))))
          ($_ (nt:require ending-pending-delivery (nt:equal (cit:field $w "state.json" "delivery") (JsonString "pending"))))
          ($_ (nt:require ending-identity-kept (nt:equal (cit:field $w "state.json" "delivery_id") (JsonString "given-id"))))
          ($_ (nt:require report-written (nt:equal (cit:text $w "report.txt") "the report")))
          ($_ (nt:require ended-run-refuses (nt:equal (cio:worker-state $w "t" "9:x" "running" 4 "late" 1 "" NoReport) 0)))
          ($_ (nt:require refused-write-left-state (nt:equal (cit:field $w "state.json" "status") (JsonString "done"))))
          ($v (cit:session $root "computed" "{\"run\":\"t\",\"phase\":\"reserved\"}" ""))
          ($_ (cio:consume-run $v "t" "9:x" $root))
          ($_ (cio:worker-state $v "t" "9:x" "failed" 1 "gave up" 0 "" NoReport))
          ($_ (nt:require ending-identity-computed
                (nt:equal (str:char-length (coding:text (cit:field $v "state.json" "delivery_id"))) 32)))
          ($_ (nt:require no-report-no-file (not (fs:is-file (path:join $v "report.txt")))))
          ($legacy (cit:session $root "legacy" "" "{\"status\":\"running\"}"))
          ($_ (nt:require unpinned-session-writes (nt:equal (cio:worker-state $legacy "" "1:a" "running" 1 "p" 0 "" NoReport) 1)))
          ($_ (nt:require published-without-temporaries (and (cit:no-temporaries $w) (cit:no-temporaries $v))))
          ($_ (nt:require state-group-shared (nt:equal (cit:mode (path:join $w "state.json")) 432))))
     True))

; A stop revokes a reservation nobody consumed, never a started run.
(= (cit:stops $root)
   (let* (($s (cit:session $root "stop" "{\"run\":\"r\",\"phase\":\"reserved\"}" ""))
          ($_ (nt:require stop-answers (nt:equal (cio:stop-session $s) 1)))
          ($_ (nt:require stop-flag (fs:is-file (path:join $s "stop"))))
          ($_ (nt:require reservation-revoked (nt:equal (cit:field $s "runtime.json" "phase") (JsonString "ended"))))
          ($_ (nt:require revoked-token-refused (nt:equal (cio:consume-run $s "r" "1:a" $root) 0)))
          ($t (cit:session $root "stop-started" "{\"run\":\"r\",\"phase\":\"started\"}" ""))
          ($_ (cio:stop-session $t))
          ($_ (nt:require started-run-kept (nt:equal (cit:field $t "runtime.json" "phase") (JsonString "started")))))
     True))

(= (cit:dead-session $root $name $extra)
   (let* (($d (cit:session $root $name "{\"run\":\"r\",\"phase\":\"started\"}"
                (str:concat "{\"status\":\"running\",\"worker_owner\":\"4194301:1\",\"run\":\"r\",\"steps\":2,\"progress\":\"half way\",\"updated\":5.0" $extra)))
          ($_ (fs:write (path:join $d "plan.json") "{\"plan\":[\"step one\"]}")))
     $d))

; An ending is recorded once, only over the run the caller observed.
(= (cit:endings $root)
   (let* (($e (cit:dead-session $root "settle" "}"))
          ($_ (fs:write (path:join $e "report.txt") "partial findings"))
          ($_ (nt:require dead-run-interrupted (nt:equal (cio:settle-ending $e) "interrupted")))
          ($_ (nt:require interrupted-recorded (nt:equal (cit:field $e "state.json" "status") (JsonString "interrupted"))))
          ($_ (nt:require interrupted-ends-run (nt:equal (cit:field $e "runtime.json" "phase") (JsonString "ended"))))
          ($_ (nt:require interrupted-pending (nt:equal (cit:field $e "state.json" "delivery") (JsonString "pending"))))
          ($report (cit:text $e "report.txt"))
          ($_ (nt:require handover-keeps-saved-report (nt:contains $report "Saved report:\npartial findings")))
          ($_ (nt:require handover-keeps-progress (nt:contains $report "Last progress:\nhalf way")))
          ($_ (nt:require handover-keeps-plan (nt:contains $report "step one")))
          ($_ (nt:require handover-names-resume (nt:contains $report "(work-resume \"settle\")")))
          ($_ (nt:require handover-is-progress (nt:equal (cit:field $e "state.json" "progress") (JsonString $report))))
          ($_ (nt:require ending-identity (nt:equal (str:char-length (coding:text (cit:field $e "state.json" "delivery_id"))) 32)))
          ($_ (nt:require settled-once (nt:equal (cio:settle-ending $e) "")))
          ($s (cit:dead-session $root "settle-stopped" "}"))
          ($_ (fs:write (path:join $s "stop") ""))
          ($_ (nt:require stop-flag-means-stopped (nt:equal (cio:settle-ending $s) "stopped")))
          ($_ (nt:require stopped-handover (nt:contains (cit:text $s "report.txt") "Stopped by the requester.")))
          ($o (cit:dead-session $root "settle-owner" "}"))
          ($_ (nt:require other-owner-untouched (nt:equal (cio:settle-ending $o "1:other") "")))
          ($_ (nt:require observed-owner-settles (nt:equal (cio:settle-ending $o "4194301:1") "interrupted")))
          ($live (cit:session $root "settle-live" "{\"run\":\"r\",\"phase\":\"started\"}"
                   (format-args "{\"status\":\"running\",\"worker_owner\":\"{}\",\"run\":\"r\"}" ((process:owner)))))
          ($_ (nt:require live-owner-kept
                (nt:equal (cio:locked $live (cio:settle-ending-locked $live Observed RequireDead)) "")))
          ($_ (nt:require live-run-still-running (nt:equal (cit:field $live "state.json" "status") (JsonString "running"))))
          ($n (cit:dead-session $root "settle-superseded" "}"))
          ($_ (fs:write (path:join $n "runtime.json") "{\"run\":\"newer\",\"phase\":\"started\"}"))
          ($_ (nt:require superseded-run-untouched (nt:equal (cio:settle-ending $n) "")))
          ($r (cit:dead-session $root "settle-reserved" "}"))
          ($_ (fs:write (path:join $r "runtime.json") "{\"run\":\"r\",\"phase\":\"reserved\"}"))
          ($_ (nt:require reserved-run-untouched (nt:equal (cio:settle-ending $r) "")))
          ($done (cit:session $root "settle-done" "" "{\"status\":\"done\"}"))
          ($_ (nt:require finished-run-untouched (nt:equal (cio:settle-ending $done) ""))))
     True))

; The session lock excludes other holders of the same flock, such as another
; process's worker or an older Python runtime.
(= (cit:lock-exclusion $root)
   (let* (($l (cit:session $root "locked" "{\"run\":\"t\",\"phase\":\"reserved\"}" ""))
          ($_ (fs:write (path:join $l ".ending.lock") ""))
          ($acquired (path:join $l "acquired"))
          ($holder (proc:spawn ("flock" (path:join $l ".ending.lock") "sh" "-c" (str:concat "touch '" (str:concat $acquired "'; sleep 1")))
                               ((cwd $root) (env (nt:environment $root)) (max-bytes 4096))))
          ($_ (cit:wait-file $acquired 200))
          ($start (system:monotonic-ns))
          ($claimed (cio:consume-run $l "t" "1:a" $root))
          ($waited (- (system:monotonic-ns) $start))
          ($_ (proc:await $holder)) ($_ (proc:close $holder))
          ($_ (nt:require claim-after-holder (nt:equal $claimed 1)))
          ($_ (nt:require claim-waited-for-holder (> $waited 500000000))))
     True))
(= (cit:wait-file $path $left)
   (if (fs:exists $path) True
     (if (<= $left 0) (let $_ (println! (LOCK_HOLDER_NOT_READY $path)) (system:exit 2))
       (let $_ (proc:run ("sleep" "0.02") "/" (nt:environment "/") 5000 0) (cit:wait-file $path (- $left 1))))))

(= (cit:append $root)
   (let* (($path (path:join $root "lines.jsonl"))
          ($_ (cio:append-line $path "{\"a\":1}")) ($_ (cio:append-line $path "\"λ\"")))
     (nt:require lines-appended (nt:equal (fs:read-text $path) "{\"a\":1}\n\"λ\"\n"))))

; Commands are recorded before they start; results show a bounded excerpt.
(= (cit:executions $root)
   (let* (($d (cit:session $root "executions" "" ""))
          ($id "0123456789abcdef0123456789abcdef")
          ($created (cio:execution-create $d $id "echo hi"))
          ($log (case $created (((ExecutionLog $path) $path) ($other ""))))
          ($_ (nt:require execution-created (nt:equal $log (path:join $d (str:concat "executions/" (str:concat $id ".log"))))))
          ($_ (nt:require execution-dispatching
                (nt:equal (coding:field (cio:json (path:join $d (str:concat "executions/" (str:concat $id ".json")))) "status")
                          (JsonString "dispatching"))))
          ($_ (nt:require identity-used-once
                (case (cio:execution-create $d $id "again") (((ExecutionRefused $why) True) ($other False)))))
          ($_ (nt:require invalid-identity-refused
                (case (cio:execution-create $d "../escape" "x") (((ExecutionRefused $why) True) ($other False)))))
          ($_ (nt:require uppercase-identity-refused
                (case (cio:execution-create $d "0123456789ABCDEF0123456789ABCDEF" "x") (((ExecutionRefused $why) True) ($other False)))))
          ($_ (nt:require unfinished-is-uncertain
                (nt:contains (cio:execution-result $d $id) "uncertain: this runtime does not own the execution")))
          ($_ (fs:write $log "hello\n"))
          ($result (cio:execution-finish $d $id "exited" 3 1.5))
          ($_ (nt:require exit-code-shown (nt:contains $result "Exit code: 3\nWall time: 1.5 seconds\n")))
          ($_ (nt:require identity-shown (nt:contains $result (str:concat "Execution ID: " $id))))
          ($_ (nt:require artifact-shown (nt:contains $result (str:concat "Output artifact: " $log))))
          ($_ (nt:require output-shown (nt:contains $result "Output:\nhello\n")))
          ($_ (nt:require unknown-identity (nt:equal (cio:execution-result $d "ffffffffffffffffffffffffffffffff")
                                                     "Unknown execution ID; nothing was started.")))
          ($signal "1111111111111111aaaaaaaaaaaaaaaa")
          ($_ (cio:execution-create $d $signal "sleep 9"))
          ($_ (nt:require signal-status-shown
                (nt:contains (cio:execution-finish $d $signal "signaled" 15 0.25) "Exit code: signaled\n")))
          ($big "2222222222222222bbbbbbbbbbbbbbbb")
          ($_ (cio:execution-create $d $big "yes"))
          ($_ (nt:exit-ok (proc:run ("sh" "-c" (format-args "{ printf HEAD-MARK; head -c 100000 /dev/zero | tr '\\0' m; printf TAIL-MARK; } > {}.log" ($big)))
                                    (path:join $d "executions") (nt:environment $root) 30000 4096)))
          ($excerpt (cio:execution-finish $d $big "exited" 0 2.0))
          ($_ (nt:require long-output-keeps-head (nt:contains $excerpt "HEAD-MARK")))
          ($_ (nt:require long-output-keeps-tail (nt:contains $excerpt "TAIL-MARK")))
          ($_ (nt:require long-output-cut (nt:contains $excerpt "\n... tokens truncated; full output in artifact ...\n")))
          ($_ (nt:require long-output-bounded (< (str:byte-length $excerpt) 41000)))
          ($bad "3333333333333333cccccccccccccccc")
          ($_ (cio:execution-create $d $bad "printf"))
          ($_ (nt:exit-ok (proc:run ("sh" "-c" (format-args "printf 'ok\\377\\376done' > {}.log" ($bad)))
                                    (path:join $d "executions") (nt:environment $root) 30000 4096)))
          ($repaired (cio:execution-finish $d $bad "exited" 0 0.1))
          ($_ (nt:require malformed-output-is-text (nt:equal (str:utf8-error $repaired) StrUtf8WellFormedV1)))
          ($_ (nt:require malformed-output-kept (and (nt:contains $repaired "ok") (nt:contains $repaired "done")))))
     True))

; A runtime tree as config/runtime-files.json selects it; its digest is the one
; earlier runtimes computed for the same files, so cached runtimes keep names.
(= (cit:fixture-root $root)
   (let* (($tree (path:join $root "program"))
          ($_ (nt:exit-ok (proc:run ("sh" "-c" (str:join "" (
                "mkdir -p src bin config data && printf '; fixture\\n' > coding_main.metta && "
                "printf '(= (a) 1)\\n' > src/a.metta && printf '#!/bin/sh\\necho hi\\n' > bin/tool.sh && "
                "chmod 755 bin/tool.sh && printf '\\000\\377\\376 raw\\n' > data/bytes.bin && "
                "printf '[\"coding_main.metta\", \"src/a.metta\", \"bin/tool.sh\", \"config/runtime-files.json\", \"data/bytes.bin\"]\\n' > config/runtime-files.json")))
                (let $_ (fs:make-directories $tree 504) $tree) (nt:environment $root) 30000 4096))))
     $tree))
(= (cit:sha $path) (case (fs:sha256-file $path) (((fs:hashed-v1 $hex $info) $hex) ($other $other))))

(= (cit:freezing $root)
   (let* (($program (cit:fixture-root $root))
          ($cache (path:join $root "runtimes"))
          ($frozen (cio:freeze-bundle $program $cache))
          ($digest "be914a006ebbb316bab87c226b2f8bbe9462c3fb9ab1306393573110773fae57")
          ($_ (nt:require digest-compatible (nt:equal $frozen (FrozenBundle (path:join $cache $digest) $digest))))
          ($copy (path:join $cache $digest))
          ($_ (nt:require bytes-copied (nt:equal (cit:sha (path:join $copy "data/bytes.bin")) (cit:sha (path:join $program "data/bytes.bin")))))
          ($_ (nt:require nested-copied (nt:equal (fs:read-text (path:join $copy "src/a.metta")) "(= (a) 1)\n")))
          ($_ (nt:require mode-copied (nt:equal (cit:mode (path:join $copy "bin/tool.sh")) 493)))
          ($_ (nt:require cache-reused (nt:equal (cio:freeze-bundle $program $cache) $frozen)))
          ($_ (nt:require no-stage-left (nt:equal (fs:entries $cache) ($digest))))
          ($_ (fs:write (path:join $program "config/runtime-files.json") "[\"../outside\"]"))
          ($_ (nt:require escaping-selection-refused
                (case (cio:freeze-bundle $program $cache) (((CioFreezeFailed $why) True) ($other False)))))
          ($_ (fs:write (path:join $program "config/runtime-files.json") "[\"/etc/passwd\"]"))
          ($_ (nt:require absolute-selection-refused
                (case (cio:freeze-bundle $program $cache) (((CioFreezeFailed $why) True) ($other False)))))
          ($_ (fs:write (path:join $program "config/runtime-files.json") "[\"coding_main.metta\", \"src/a.metta\"]")))
     True))

; A new session is pinned to a frozen copy; a pinned one gets a fresh token on
; its own pin; a live one is left alone.
(= (cit:reservations $root)
   (let* (($program (path:join $root "program"))
          ($sessions (path:join $root "memory/coding"))
          ($new (path:join $sessions "work-new"))
          ($_ (fs:make-directories $new 504))
          ($first (cio:freeze-runtime $program $new NoNote))
          ($manifest (cio:json (path:join $new "runtime.json")))
          ($run (coding:text (coding:field $manifest "run")))
          ($_ (nt:require new-session-reserved
                (case $first (((CodingLaunch reserved $r $b $t "") (nt:equal $t $run)) ($other False)))))
          ($_ (nt:require pinned-to-frozen-copy
                (nt:equal (coding:text (coding:field $manifest "root"))
                          (path:join (path:join $root "memory/coding-runtimes") (coding:text (coding:field $manifest "digest"))))))
          ($_ (nt:require frozen-copy-runnable (fs:is-file (path:join (coding:text (coding:field $manifest "root")) "coding_main.metta"))))
          ($_ (nt:require token-is-fresh (cio:execution-id? $run)))
          ($_ (nt:require reservation-phase (nt:equal (coding:field $manifest "phase") (JsonString "reserved"))))
          ($_ (nt:require no-checkpoint-yet (nt:equal (coding:field $manifest "checkpoint") JsonNull)))
          ($_ (nt:require engine-recorded (nt:equal (coding:text (coding:field $manifest "binary")) (cio:engine-binary))))
          ;; A resume after the run ended: flags cleared, report and label kept aside, note queued.
          ($_ (fs:write (path:join $new "state.json") "{\"status\":\"done\",\"steps\":3}"))
          ($_ (fs:write (path:join $new "stop") "")) ($_ (fs:write (path:join $new "recycle.requested") "x"))
          ($_ (fs:write (path:join $new "report.txt") "old report"))
          ($_ (fs:write (path:join $new "lifecycle.json") "{\"hold\":{\"why\":\"later\"}}"))
          ($second (cio:freeze-runtime $program $new "Resume from the evidence."))
          ($again (cio:json (path:join $new "runtime.json")))
          ($_ (nt:require resume-reserved
                (case $second (((CodingLaunch reserved $r $b $t "") (nt:equal $t (coding:text (coding:field $again "run")))) ($other False)))))
          ($_ (nt:require resume-new-token (not (nt:equal (coding:text (coding:field $again "run")) $run))))
          ($_ (nt:require resume-keeps-pin (nt:equal (coding:field $again "digest") (coding:field $manifest "digest"))))
          ($_ (nt:require resume-clears-stop (not (fs:exists (path:join $new "stop")))))
          ($_ (nt:require resume-clears-recycle (not (fs:exists (path:join $new "recycle.requested")))))
          ($_ (nt:require resume-keeps-report (nt:equal (fs:read-text (path:join $new "report.previous.txt")) "old report")))
          ($_ (nt:require resume-clears-label (and (not (fs:exists (path:join $new "lifecycle.json")))
                                                    (fs:is-file (path:join $new "lifecycle.previous.json")))))
          ($_ (nt:require resume-note-queued (nt:equal (fs:read-text (path:join $new "inbox.jsonl")) "\"Resume from the evidence.\"\n")))
          ;; A live worker keeps its run.
          ($_ (fs:write (path:join $new "state.json")
                (format-args "{\"status\":\"running\",\"worker_owner\":\"{}\"}" ((process:owner)))))
          ($before (fs:read-text (path:join $new "runtime.json")))
          ($_ (nt:require live-session-running
                (case (cio:freeze-runtime $program $new NoNote) (((CodingLaunch running $r $b $t $d) True) ($other False)))))
          ($_ (nt:require live-manifest-unchanged (nt:equal (fs:read-text (path:join $new "runtime.json")) $before)))
          ;; A dead run is settled before the next reservation.
          ($_ (fs:write (path:join $new "state.json")
                (format-args "{\"status\":\"running\",\"worker_owner\":\"4194301:1\",\"run\":\"{}\"}" ((coding:text (coding:field $again "run"))))))
          ($_ (fs:write (path:join $new "runtime.json") (json-stringify (cio:put $again "phase" (JsonString "started")))))
          ($_ (cio:freeze-runtime $program $new NoNote))
          ($_ (nt:require dead-run-settled-first (nt:equal (coding:field (cio:json (path:join $new "state.json")) "status") (JsonString "interrupted"))))
          ;; A pin whose runtime is gone cannot resume on it.
          ($gone (path:join $sessions "work-gone")) ($_ (fs:make-directories $gone 504))
          ($_ (fs:write (path:join $gone "runtime.json") "{\"root\":\"/nonexistent-runtime\",\"run\":\"x\",\"phase\":\"ended\"}"))
          ($_ (nt:require missing-runtime-refused
                (case (cio:freeze-runtime $program $gone NoNote) (((CodingLaunch failed $r $b $t $d) (nt:contains $d "runtime is missing")) ($other False))))))
     True))

(= (cit:launch-values $root)
   (let* (($m (path:join $root "model-session")) ($_ (fs:make-directories $m 504))
          ($_ (fs:write (path:join $m "task.json") "{\"model\":\"kimi-k2\"}"))
          ($_ (nt:require recorded-model-kept (nt:equal (cio:session-model $m "agent-model") "kimi-k2")))
          ($_ (nt:require model-state-written (nt:equal (fs:read-text (path:join $m "model.metta")) "(active-model kimi-k2)\n")))
          ($o (path:join $root "old-session")) ($_ (fs:make-directories $o 504))
          ($_ (fs:write (path:join $o "task.json") "{\"task\":\"t\"}"))
          ($_ (fs:write (path:join $o "model.metta") "(active-model  syn:large:text )\n"))
          ($_ (nt:require saved-model-kept (nt:equal (cio:session-model $o "agent-model") "syn:large:text")))
          ($f (path:join $root "fresh-session")) ($_ (fs:make-directories $f 504))
          ($_ (fs:write (path:join $f "task.json") "{\"task\":\"t\"}"))
          ($_ (nt:require fallback-model (nt:equal (cio:session-model $f "agent-model") "agent-model")))
          ($tricky "it's \"$HOME\" `x`\nnext; rm -rf /")
          ($echoed (nt:exit-ok (proc:run ("sh" "-c" (str:concat "printf %s " (cio:shell-quote $tricky))) $root (nt:environment $root) 5000 4096)))
          ($_ (nt:require shell-quote-round-trip (nt:equal $echoed $tricky))))
     True))

; Re-pinning checks a copy of the checkpoint with the current runtime's
; checker; this fixture checker reads the copy (and, asked to, changes the
; live session during the check).
(= (cit:check-program $root)
   (let* (($tree (path:join $root "program-check")) ($_ (fs:make-directories (path:join $tree "config") 504))
          ($_ (fs:write (path:join $tree "coding_main.metta") "; fixture\n"))
          ($_ (fs:write (path:join $tree "coding_check.metta") (str:join "" (
                "!(import! &self (library fs))\n!(import! &self (library system))\n!(import! &self (library path))\n"
                "!(let $dir (system:arg (- (system:argc) 1))\n"
                "   (if (fs:is-file (path:join $dir \"mutate-live\"))\n"
                "     (let $_ (fs:append-text (fs:read-text (path:join $dir \"mutate-live\")) \"x\\n\") (CheckpointReady 1))\n"
                "     (if (fs:is-file (path:join $dir \"task.json\")) (CheckpointReady 2) (CheckpointFailed \"no task here\"))))\n"))))
          ($_ (fs:write (path:join $tree "config/runtime-files.json")
                "[\"coding_main.metta\", \"coding_check.metta\", \"config/runtime-files.json\"]")))
     $tree))
(= (cit:pin-elsewhere $dir)
   (fs:write (path:join $dir "runtime.json")
     (json-stringify (cio:put (cio:put (cio:json (path:join $dir "runtime.json")) "digest" (JsonString "old-digest")) "phase" (JsonString "ended")))))
(= (cit:repins $root)
   (let* (($program (cit:check-program $root))
          ($sessions (path:join $root "memory/coding"))
          ($d (path:join $sessions "work-repin")) ($_ (fs:make-directories $d 504))
          ($_ (fs:write (path:join $d "task.json") "{\"task\":\"t\"}"))
          ($_ (fs:write (path:join $d "messages.jsonl") "{\"role\":\"user\",\"content\":\"t\"}\n"))
          ($_ (cio:freeze-runtime $program $d NoNote))
          ($digest (coding:text (coding:field (cio:json (path:join $d "runtime.json")) "digest")))
          ($_ (fs:write (path:join $d "inbox.jsonl") ""))
          ($same (cio:repin $program $d))
          ($_ (nt:require current-pin-is-same
                (case $same (((CodingLaunch same $r $b $t $x) (nt:equal $t (coding:text (coding:field (cio:json (path:join $d "runtime.json")) "run")))) ($o False)))))
          ($_ (nt:require same-note (nt:contains (fs:read-text (path:join $d "inbox.jsonl")) "Verify uncertain effects")))
          ($_ (cit:pin-elsewhere $d))
          ($_ (fs:write (path:join $d "runs.jsonl") "{\"from\":null,\"to\":\"a\"}\nnot json\n{\"torn\":"))
          ($moved (cio:repin $program $d))
          ($pin (cio:json (path:join $d "runtime.json")))
          ($_ (nt:require older-pin-repinned (case $moved (((CodingLaunch repinned $r $b $t $x) True) ($o False)))))
          ($_ (nt:require repinned-to-current (nt:equal (coding:field $pin "digest") (JsonString $digest))))
          ($_ (nt:require checkpoint-recorded (nt:equal (coding:field $pin "checkpoint") (JsonString (cio:checkpoint-revision $d)))))
          ($_ (nt:require previous-pin-kept (nt:equal (coding:field (coding:field $pin "previous") "digest") (JsonString "old-digest"))))
          ($_ (nt:require repin-run-logged
                (nt:contains (fs:read-text (path:join $d "runs.jsonl")) (str:concat "\"from\":\"old-digest\",\"to\":\"" $digest))))
          ($_ (nt:require run-log-cleaned
                (nt:equal (size-atom (cio:object-lines (str:split "\n" (fs:read-text (path:join $d "runs.jsonl")))))
                          (size-atom (cio:nonblank (str:split "\n" (fs:read-text (path:join $d "runs.jsonl"))))))))
          ($_ (nt:require repinned-note (nt:contains (fs:read-text (path:join $d "inbox.jsonl")) "newer runtime")))
          ($_ (nt:require check-copy-removed (nt:equal (fs:entries (path:join $root "memory/coding-checks")) ())))
          ;; A refused check leaves the pin.
          ($_ (cit:pin-elsewhere $d)) ($_ (fs:remove (path:join $d "task.json")))
          ($refused (cio:repin $program $d))
          ($_ (nt:require refused-check-reported (case $refused (((CodingLaunch failed $r $b $t $why) (nt:equal $why "no task here")) ($o False)))))
          ($_ (nt:require refused-pin-unchanged (nt:equal (coding:field (cio:json (path:join $d "runtime.json")) "digest") (JsonString "old-digest"))))
          ;; A session that changes during the check is not moved.
          ($_ (fs:write (path:join $d "task.json") "{\"task\":\"t\"}"))
          ($_ (fs:write (path:join $d "mutate-live") (path:join $d "messages.jsonl")))
          ($changed (cio:repin $program $d))
          ($_ (fs:remove (path:join $d "mutate-live")))
          ($_ (nt:require change-during-check-refused (case $changed (((CodingLaunch changed $r $b $t $why) True) ($o False)))))
          ($_ (nt:require changed-pin-unchanged (nt:equal (coding:field (cio:json (path:join $d "runtime.json")) "digest") (JsonString "old-digest"))))
          ;; A live session is left alone.
          ($_ (fs:write (path:join $d "state.json") (format-args "{\"status\":\"running\",\"worker_owner\":\"{}\"}" ((process:owner)))))
          ($_ (nt:require live-session-not-repinned (case (cio:repin $program $d) (((CodingLaunch running $r $b $t $x) True) ($o False))))))
     True))
; A resume whose preparation fails after the manifest was replaced is
; reported, never claimed: uncertain for a re-pin, failed for a pinned resume.
(= (cit:preparation-failures $root)
   (let* (($program (path:join $root "program-check"))
          ($d (path:join (path:join $root "memory/coding") "work-unprepared")) ($_ (fs:make-directories $d 504))
          ($_ (fs:write (path:join $d "task.json") "{\"task\":\"t\"}"))
          ($_ (cio:freeze-runtime $program $d NoNote))
          ($_ (fs:make-directories (path:join $d "inbox.jsonl") 504))
          ($_ (nt:require repin-preparation-uncertain
                (case (cio:repin $program $d) (((CodingLaunch uncertain $r $b $t $why) True) ($o False)))))
          ($_ (nt:require resume-preparation-failed
                (case (cio:freeze-runtime $program $d (cio:note-pinned))
                  (((CodingLaunch failed $r $b $t $why) (nt:contains $why "could not prepare the resume")) ($o False))))))
     True))
(= (cio:nonblank $lines)
   (if (== $lines ()) ()
     (let $rest (cio:nonblank (cdr-atom $lines)) (if (== (str:trim (car-atom $lines)) "") $rest (cons-atom (car-atom $lines) $rest)))))
(= (cit:verdicts)
   (let* (($_ (nt:require ready-verdict (nt:equal (cio:check-verdict 0 "(CheckpointReady 12)") (CheckpointPassed))))
          ($_ (nt:require ready-needs-success (nt:equal (cio:check-verdict 1 "(CheckpointReady 12)") (CheckpointRefused "the check produced no valid verdict"))))
          ($_ (nt:require failed-verdict (nt:equal (cio:check-verdict 0 "(CheckpointFailed \"bad json\")") (CheckpointRefused "bad json"))))
          ($_ (nt:require ready-inside-failure-is-failure
                (nt:equal (cio:check-verdict 0 "(CheckpointFailed \"(CheckpointReady 3)\")") (CheckpointRefused "(CheckpointReady 3)"))))
          ($_ (nt:require no-verdict (nt:equal (cio:check-verdict 0 "CheckpointReady 3") (CheckpointRefused "the check produced no valid verdict")))))
     True))

; Context accounting: four bytes a token, or the provider's rate when higher.
(= (cit:observe $dir $usage $size)
   (let $_ (fs:write (path:join $dir "reply.json") (str:join "" ("{\"usage\":" $usage "}")))
     (cio:context-observe $dir $size)))
(= (cit:context $root)
   (let* (($d (path:join $root "context")) ($_ (fs:make-directories $d 504))
          ($_ (nt:require quarter-without-count (nt:equal (cio:context-tokens $d 4000) 1000)))
          ($_ (nt:require no-input-count-no-record (nt:equal (cit:observe $d "{\"completion_tokens\":3}" 4000) 0)))
          ($_ (nt:require still-quarter (nt:equal (cio:context-tokens $d 4000) 1000)))
          ;; Anthropic: the cached and newly written prefix count toward the input.
          ($_ (nt:require cache-counts-recorded
                (nt:equal (cit:observe $d "{\"input_tokens\":2,\"cache_read_input_tokens\":1000,\"cache_creation_input_tokens\":998}" 6000) 1)))
          ($_ (nt:require provider-rate-applies (nt:equal (cio:context-tokens $d 9000) 3000)))
          ;; Responses: input_tokens is the whole input, cached part included.
          ($_ (nt:require responses-input-recorded
                (nt:equal (cit:observe $d "{\"input_tokens\":1500,\"input_tokens_details\":{\"cached_tokens\":1400}}" 6000) 1)))
          ($_ (nt:require responses-rate-applies (nt:equal (cio:context-tokens $d 12000) 3000)))
          ;; A provider counting fewer never lowers the four-byte estimate.
          ($_ (nt:require lower-count-recorded (nt:equal (cit:observe $d "{\"prompt_tokens\":10}" 6000) 1)))
          ($_ (nt:require quarter-is-the-floor (nt:equal (cio:context-tokens $d 12000) 3000)))
          ($u (path:join $root "context-unreadable")) ($_ (fs:make-directories $u 504))
          ($_ (nt:require missing-reply-ignored (nt:equal (cio:context-observe $u 100) 0)))
          ($_ (fs:write (path:join $u "reply.json") "not json"))
          ($_ (nt:require unreadable-reply-ignored (nt:equal (cio:context-observe $u 100) 0)))
          ($_ (nt:require nothing-recorded (not (fs:exists (path:join $u "context.json"))))))
     True))

(= (cit:run)
   (let* (($root (nt:join (nt:required-env "NATIVE_TEST_ARTIFACTS") (str:concat "coding-io-" (system:uuid4-hex))))
          ($_ (fs:make-directories $root 504))
          ($_ (cit:run-tokens $root)) ($_ (cit:worker-writes $root)) ($_ (cit:stops $root))
          ($_ (cit:endings $root)) ($_ (cit:lock-exclusion $root)) ($_ (cit:append $root))
          ($_ (cit:executions $root)) ($_ (cit:freezing $root)) ($_ (cit:reservations $root))
          ($_ (cit:launch-values $root)) ($_ (cit:repins $root)) ($_ (cit:verdicts))
          ($_ (cit:preparation-failures $root)) ($_ (cit:context $root)))
     CodingIoContractsPassed))
!(nt:require coding-io-contracts-completed (nt:equal (collapse (cit:run)) (CodingIoContractsPassed)))
!(println! NATIVE_CODING_IO_PASSED)
