; Unit tests of the native coding-session files (src/coding_io_cetta.metta),
; run on the Python-disabled core engine:
;   NATIVE_TEST_ARTIFACTS=<dir> $NATIVE_TEST_CORE/cetta --lang petta \
;     --import-mode ancestor-walk --quiet scripts/test_coding_io_cetta.metta
!(import! &self ../tests/native_test_support.metta)
!(import! &self ../src/coding_io_cetta.metta)

(= (cit:session $root $name $runtime $state)
   (let* (($dir (path:join $root $name)) ($_ (fs:make-directories $dir 504))
          ($_ (if (== $runtime "") () (fs:write (path:join $dir "runtime.json") $runtime)))
          ($_ (if (== $state "") () (fs:write (path:join $dir "state.json") $state))))
     $dir))
(= (cit:field $dir $file $key) (coding:field (cio:json (path:join $dir $file)) $key))
(= (cit:text $dir $file) (fs:read-text (path:join $dir $file)))
(= (cit:no-temporaries $dir)
   (cit:none-hidden (fs:entries $dir)))
(= (cit:none-hidden $names)
   (if (== $names ()) True
     (let $name (car-atom $names)
       (if (and (str:starts-with $name ".") (!= $name ".ending.lock")) False (cit:none-hidden (cdr-atom $names))))))
(= (cit:mode $path)
   (case (fs:metadata $path follow-permissions)
     (((fs:info $kind $size $identity (fs:permissions $bits)) $bits) ($other $other))))

; A token is consumed once, only while it is the newest reservation.
(= (cit:run-tokens $root)
   (let* (($d (cit:session $root "consume" "{\"run\":\"tok1\",\"phase\":\"reserved\"}"
                 "{\"status\":\"done\",\"steps\":4,\"inbox\":2}"))
          ($_ (nt:require empty-token-refused (nt:equal (cio:consume-run $d "" "1:a" $root) 0)))
          ($_ (nt:require other-token-refused (nt:equal (cio:consume-run $d "tok2" "1:a" $root) 0)))
          ($_ (nt:require refusal-logged (nt:contains (cit:text $d "run.log") "refused run token tok2: manifest run=tok1 phase=reserved")))
          ($_ (nt:require reserved-token-consumed (nt:equal (cio:consume-run $d "tok1" "1:a" $root) 1)))
          ($_ (nt:require run-started (nt:equal (cit:field $d "runtime.json" "phase") (JsonString "started"))))
          ($_ (nt:require state-running (nt:equal (cit:field $d "state.json" "status") (JsonString "running"))))
          ($_ (nt:require owner-recorded (nt:equal (cit:field $d "state.json" "worker_owner") (JsonString "1:a"))))
          ($_ (nt:require run-recorded (nt:equal (cit:field $d "state.json" "run") (JsonString "tok1"))))
          ($_ (nt:require steps-carried (nt:equal (cit:field $d "state.json" "steps") (JsonNumber "4"))))
          ($_ (nt:require inbox-carried (nt:equal (cit:field $d "state.json" "inbox") (JsonNumber "2"))))
          ($_ (nt:require token-single-use (nt:equal (cio:consume-run $d "tok1" "2:b" $root) 0)))
          ($_ (nt:require second-claim-left-owner (nt:equal (cit:field $d "state.json" "worker_owner") (JsonString "1:a"))))
          ($bundle (path:join $root "bundle-a")) ($_ (fs:make-directories $bundle 504))
          ($other (path:join $root "bundle-b")) ($_ (fs:make-directories $other 504))
          ($b (cit:session $root "bound" (format-args "{\"root\":\"{}\",\"run\":\"t\",\"phase\":\"reserved\"}" ($bundle)) ""))
          ($_ (nt:require foreign-bundle-refused (nt:equal (cio:consume-run $b "t" "1:a" $other) 0)))
          ($_ (nt:require foreign-bundle-logged (nt:contains (cit:text $b "run.log") "bundle mismatch")))
          ($_ (nt:require reservation-kept (nt:equal (cit:field $b "runtime.json" "phase") (JsonString "reserved"))))
          ($_ (nt:require own-bundle-accepted (nt:equal (cio:consume-run $b "t" "1:a" (path:join $root "bundle-a/.")) 1))))
     True))

; Worker writes need the started run and its owner; an ending ends the run.
(= (cit:worker-writes $root)
   (let* (($w (cit:session $root "worker" "{\"run\":\"t\",\"phase\":\"reserved\"}" ""))
          ($_ (nt:require worker-claims (nt:equal (cio:consume-run $w "t" "9:x" $root) 1)))
          ($_ (nt:require stranger-refused (nt:equal (cio:worker-state $w "t" "8:y" "running" 1 "p" 0 "" NoReport) 0)))
          ($_ (nt:require stale-token-refused (nt:equal (cio:worker-state $w "u" "9:x" "running" 1 "p" 0 "" NoReport) 0)))
          ($_ (nt:require progress-written (nt:equal (cio:worker-state $w "t" "9:x" "running" 2 "working" 1 "" NoReport) 1)))
          ($_ (nt:require progress-recorded (nt:equal (cit:field $w "state.json" "progress") (JsonString "working"))))
          ($_ (nt:require progress-keeps-run (nt:equal (cit:field $w "runtime.json" "phase") (JsonString "started"))))
          ($_ (nt:require progress-no-delivery (nt:equal (cit:field $w "state.json" "delivery") (JsonString "none"))))
          ($_ (nt:require ending-written (nt:equal (cio:worker-state $w "t" "9:x" "done" 3 "finished" 1 "given-id" "the report") 1)))
          ($_ (nt:require ending-ends-run (nt:equal (cit:field $w "runtime.json" "phase") (JsonString "ended"))))
          ($_ (nt:require ending-pending-delivery (nt:equal (cit:field $w "state.json" "delivery") (JsonString "pending"))))
          ($_ (nt:require ending-identity-kept (nt:equal (cit:field $w "state.json" "delivery_id") (JsonString "given-id"))))
          ($_ (nt:require report-written (nt:equal (cit:text $w "report.txt") "the report")))
          ($_ (nt:require ended-run-refuses (nt:equal (cio:worker-state $w "t" "9:x" "running" 4 "late" 1 "" NoReport) 0)))
          ($_ (nt:require refused-write-left-state (nt:equal (cit:field $w "state.json" "status") (JsonString "done"))))
          ($v (cit:session $root "computed" "{\"run\":\"t\",\"phase\":\"reserved\"}" ""))
          ($_ (cio:consume-run $v "t" "9:x" $root))
          ($_ (cio:worker-state $v "t" "9:x" "failed" 1 "gave up" 0 "" NoReport))
          ($_ (nt:require ending-identity-computed
                (nt:equal (str:char-length (coding:text (cit:field $v "state.json" "delivery_id"))) 32)))
          ($_ (nt:require no-report-no-file (not (fs:is-file (path:join $v "report.txt")))))
          ($legacy (cit:session $root "legacy" "" "{\"status\":\"running\"}"))
          ($_ (nt:require unpinned-session-writes (nt:equal (cio:worker-state $legacy "" "1:a" "running" 1 "p" 0 "" NoReport) 1)))
          ($_ (nt:require published-without-temporaries (and (cit:no-temporaries $w) (cit:no-temporaries $v))))
          ($_ (nt:require state-group-shared (nt:equal (cit:mode (path:join $w "state.json")) 432))))
     True))

; A stop revokes a reservation nobody consumed, never a started run.
(= (cit:stops $root)
   (let* (($s (cit:session $root "stop" "{\"run\":\"r\",\"phase\":\"reserved\"}" ""))
          ($_ (nt:require stop-answers (nt:equal (cio:stop-session $s) 1)))
          ($_ (nt:require stop-flag (fs:is-file (path:join $s "stop"))))
          ($_ (nt:require reservation-revoked (nt:equal (cit:field $s "runtime.json" "phase") (JsonString "ended"))))
          ($_ (nt:require revoked-token-refused (nt:equal (cio:consume-run $s "r" "1:a" $root) 0)))
          ($t (cit:session $root "stop-started" "{\"run\":\"r\",\"phase\":\"started\"}" ""))
          ($_ (cio:stop-session $t))
          ($_ (nt:require started-run-kept (nt:equal (cit:field $t "runtime.json" "phase") (JsonString "started")))))
     True))

(= (cit:dead-session $root $name $extra)
   (let* (($d (cit:session $root $name "{\"run\":\"r\",\"phase\":\"started\"}"
                (str:concat "{\"status\":\"running\",\"worker_owner\":\"4194301:1\",\"run\":\"r\",\"steps\":2,\"progress\":\"half way\",\"updated\":5.0" $extra)))
          ($_ (fs:write (path:join $d "plan.json") "{\"plan\":[\"step one\"]}")))
     $d))

; An ending is recorded once, only over the run the caller observed.
(= (cit:endings $root)
   (let* (($e (cit:dead-session $root "settle" "}"))
          ($_ (fs:write (path:join $e "report.txt") "partial findings"))
          ($_ (nt:require dead-run-interrupted (nt:equal (cio:settle-ending $e) "interrupted")))
          ($_ (nt:require interrupted-recorded (nt:equal (cit:field $e "state.json" "status") (JsonString "interrupted"))))
          ($_ (nt:require interrupted-ends-run (nt:equal (cit:field $e "runtime.json" "phase") (JsonString "ended"))))
          ($_ (nt:require interrupted-pending (nt:equal (cit:field $e "state.json" "delivery") (JsonString "pending"))))
          ($report (cit:text $e "report.txt"))
          ($_ (nt:require handover-keeps-saved-report (nt:contains $report "Saved report:\npartial findings")))
          ($_ (nt:require handover-keeps-progress (nt:contains $report "Last progress:\nhalf way")))
          ($_ (nt:require handover-keeps-plan (nt:contains $report "step one")))
          ($_ (nt:require handover-names-resume (nt:contains $report "(work-resume \"settle\")")))
          ($_ (nt:require handover-is-progress (nt:equal (cit:field $e "state.json" "progress") (JsonString $report))))
          ($_ (nt:require ending-identity (nt:equal (str:char-length (coding:text (cit:field $e "state.json" "delivery_id"))) 32)))
          ($_ (nt:require settled-once (nt:equal (cio:settle-ending $e) "")))
          ($s (cit:dead-session $root "settle-stopped" "}"))
          ($_ (fs:write (path:join $s "stop") ""))
          ($_ (nt:require stop-flag-means-stopped (nt:equal (cio:settle-ending $s) "stopped")))
          ($_ (nt:require stopped-handover (nt:contains (cit:text $s "report.txt") "Stopped by the requester.")))
          ($o (cit:dead-session $root "settle-owner" "}"))
          ($_ (nt:require other-owner-untouched (nt:equal (cio:settle-ending $o "1:other") "")))
          ($_ (nt:require observed-owner-settles (nt:equal (cio:settle-ending $o "4194301:1") "interrupted")))
          ($live (cit:session $root "settle-live" "{\"run\":\"r\",\"phase\":\"started\"}"
                   (format-args "{\"status\":\"running\",\"worker_owner\":\"{}\",\"run\":\"r\"}" ((process:owner)))))
          ($_ (nt:require live-owner-kept
                (nt:equal (cio:locked $live (cio:settle-ending-locked $live Observed RequireDead)) "")))
          ($_ (nt:require live-run-still-running (nt:equal (cit:field $live "state.json" "status") (JsonString "running"))))
          ($n (cit:dead-session $root "settle-superseded" "}"))
          ($_ (fs:write (path:join $n "runtime.json") "{\"run\":\"newer\",\"phase\":\"started\"}"))
          ($_ (nt:require superseded-run-untouched (nt:equal (cio:settle-ending $n) "")))
          ($r (cit:dead-session $root "settle-reserved" "}"))
          ($_ (fs:write (path:join $r "runtime.json") "{\"run\":\"r\",\"phase\":\"reserved\"}"))
          ($_ (nt:require reserved-run-untouched (nt:equal (cio:settle-ending $r) "")))
          ($done (cit:session $root "settle-done" "" "{\"status\":\"done\"}"))
          ($_ (nt:require finished-run-untouched (nt:equal (cio:settle-ending $done) ""))))
     True))

; The session lock excludes other holders of the same flock, such as another
; process's worker or an older Python runtime.
(= (cit:lock-exclusion $root)
   (let* (($l (cit:session $root "locked" "{\"run\":\"t\",\"phase\":\"reserved\"}" ""))
          ($_ (fs:write (path:join $l ".ending.lock") ""))
          ($acquired (path:join $l "acquired"))
          ($holder (proc:spawn ("flock" (path:join $l ".ending.lock") "sh" "-c" (str:concat "touch '" (str:concat $acquired "'; sleep 1")))
                               ((cwd $root) (env (nt:environment $root)) (max-bytes 4096))))
          ($_ (cit:wait-file $acquired 200))
          ($start (system:monotonic-ns))
          ($claimed (cio:consume-run $l "t" "1:a" $root))
          ($waited (- (system:monotonic-ns) $start))
          ($_ (proc:await $holder)) ($_ (proc:close $holder))
          ($_ (nt:require claim-after-holder (nt:equal $claimed 1)))
          ($_ (nt:require claim-waited-for-holder (> $waited 500000000))))
     True))
(= (cit:wait-file $path $left)
   (if (fs:exists $path) True
     (if (<= $left 0) (let $_ (println! (LOCK_HOLDER_NOT_READY $path)) (system:exit 2))
       (let $_ (proc:run ("sleep" "0.02") "/" (nt:environment "/") 5000 0) (cit:wait-file $path (- $left 1))))))

(= (cit:append $root)
   (let* (($path (path:join $root "lines.jsonl"))
          ($_ (cio:append-line $path "{\"a\":1}")) ($_ (cio:append-line $path "\"λ\"")))
     (nt:require lines-appended (nt:equal (fs:read-text $path) "{\"a\":1}\n\"λ\"\n"))))

(= (cit:run)
   (let* (($root (nt:join (nt:required-env "NATIVE_TEST_ARTIFACTS") (str:concat "coding-io-" (system:uuid4-hex))))
          ($_ (fs:make-directories $root 504))
          ($_ (cit:run-tokens $root)) ($_ (cit:worker-writes $root)) ($_ (cit:stops $root))
          ($_ (cit:endings $root)) ($_ (cit:lock-exclusion $root)) ($_ (cit:append $root)))
     CodingIoContractsPassed))
!(nt:require coding-io-contracts-completed (nt:equal (collapse (cit:run)) (CodingIoContractsPassed)))
!(println! NATIVE_CODING_IO_PASSED)
