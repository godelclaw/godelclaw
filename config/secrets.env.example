# Copy to config/secrets.env and fill locally. Never commit real values.
# initialize.sh creates config/secrets.env with mode 600 if it is missing.

# Synthetic / OpenAI-compatible provider key (the endpoint URL is not a secret
# and lives in config/local.toml as synthetic_base_url):
# SYNTHETIC_API_KEY=sk-...

# Telegram bot token:
# METTACLAW_TELEGRAM_BOT_TOKEN=123456789:...
# METTACLAW_TELEGRAM_BOT_USERNAME=ExampleBot

# Telegram identities and authorization sets are private operational data.
# Use comma-separated IDs; sender labels use id:Name pairs.
# METTACLAW_TELEGRAM_OPERATOR_IDS=<telegram-user-id>
# METTACLAW_TELEGRAM_ALLOWED_CHAT_IDS=<telegram-chat-id>
# Plain (send ...) is pinned here; other chats require an explicit address.
# METTACLAW_TELEGRAM_PRIMARY_CHAT_ID=<private-operator-chat-id>
# METTACLAW_TELEGRAM_LIGHT_ARM_IDS=<telegram-user-id>
# METTACLAW_TELEGRAM_SENDER_NAMES=<telegram-user-id>:Name
# Non-operator senders whose messages may end a rest (no operator controls):
# METTACLAW_TELEGRAM_WAKE_IDS=<telegram-user-id>
# The native service launcher grants these private chats as --peer IDs.
# With the legacy Python client, also list their chats in ALLOWED_CHAT_IDS.

# Optional Tavily web search key. If set, (search "...") uses Tavily first and
# falls back to DuckDuckGo if Tavily is unavailable.
# TAVILY_API_KEY=tvly-...
