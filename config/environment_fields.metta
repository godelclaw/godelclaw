; Non-secret configuration exports. Telegram identities stay in secrets.env.
(= (cfg:fields)
  ((ConfigFieldV1 "PETTA_ROOT" "paths" "petta_root" JsonNull expand)
   (ConfigFieldV1 "CETTA_ROOT" "paths" "cetta_root" JsonNull expand)
   (ConfigFieldV1 "PETTA_PY_ENV" "paths" "petta_py_env" JsonNull expand)
   (ConfigFieldV1 "SESSION_MEMORY_TOOLS" "paths" "session_memory_tools" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_OFFSET_PATH" "paths" "telegram_offset_path" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_LOG_PATH" "paths" "telegram_log_path" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_LIFECYCLE_PATH" "paths" "lifecycle_path" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_PROMPT_PATH" "paths" "prompt_path" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_HISTORY_PATH" "paths" "history_path" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_MEMORY_LOG_DIR" "paths" "memory_log_dir" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_ATTACHMENTS_DIR" "paths" "attachments_dir" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_REPOS_DIR" "paths" "repos_dir" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_PUBLIC_WORK_DIR" "paths" "public_work_dir" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_STREAM_DIR" "paths" "stream_dir" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_CODING_GUIDANCE_DIR" "paths" "coding_guidance_dir" "$ROOT/identity" expand)
   (ConfigFieldV1 "METTACLAW_CODING_CONTEXT_TOKENS" "coding" "context_window_tokens" 256000 plain)
   (ConfigFieldV1 "METTACLAW_CODING_ROOT_MARKERS" "coding" "project_root_markers" (JsonArray (".git")) json)
   (ConfigFieldV1 "METTACLAW_CODING_DOC_FALLBACKS" "coding" "project_doc_fallback_filenames" (JsonArray ()) json)
   (ConfigFieldV1 "METTACLAW_EMBED_MODEL" "paths" "embed_model" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_OWNER" "agent" "owner" JsonNull expand)
   (ConfigFieldV1 "SYNTHETIC_MODEL" "agent" "synthetic_model" JsonNull plain)
   (ConfigFieldV1 "SYNTHETIC_BASE_URL" "agent" "synthetic_base_url" JsonNull plain)
   (ConfigFieldV1 "SYNTHETIC_TIMEOUT" "agent" "llm_timeout_seconds" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_LLM_HARD_SECONDS" "agent" "llm_hard_seconds" 1800 plain)
   (ConfigFieldV1 "METTACLAW_LLM_CONNECT_SECONDS" "agent" "llm_connect_seconds" 30 plain)
   (ConfigFieldV1 "METTACLAW_LLM_FIRST_BYTE_SECONDS" "agent" "llm_first_byte_seconds" 900 plain)
   (ConfigFieldV1 "METTACLAW_LLM_IDLE_SECONDS" "agent" "llm_idle_seconds" 180 plain)
   (ConfigFieldV1 "METTACLAW_LLM_STREAM" "agent" "llm_stream" True bool-int)
   (ConfigFieldV1 "METTACLAW_MODEL_COMMENTARY" "agent" "model_commentary" False plain)
   (ConfigFieldV1 "METTACLAW_PUBLIC_TOOL_RECEIPTS" "agent" "public_tool_receipts" False plain)
   (ConfigFieldV1 "METTACLAW_INPUT_ACK_SECONDS" "agent" "input_ack_seconds" 15 plain)
   (ConfigFieldV1 "METTACLAW_INPUT_POLICY" "agent" "input_policy" "cooperative" plain)
   (ConfigFieldV1 "METTACLAW_OBSERVED_STRATEGY" "agent" "observed_strategy" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_NATIVE_LEDGER" "agent" "native_ledger" False plain)
   (ConfigFieldV1 "METTACLAW_SHELL_TIMEOUT_SECONDS" "agent" "shell_timeout_seconds" 120 plain)
   (ConfigFieldV1 "METTACLAW_REASONING_EFFORT" "agent" "reasoning_effort" "default" plain)
   (ConfigFieldV1 "METTACLAW_LLM_TRANSPORT" "agent" "llm_transport" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_LLM_POLICY" "agent" "llm_policy" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_RECYCLE_BYTES" "agent" "recycle_bytes" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_MAIL_NAME" "mail" "name" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_MAIL_SOCKET" "mail" "socket" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_MAIL_SPACE" "mail" "space" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_GATEWAY_AGENT" "gateway" "agent" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_GATEWAY_SOCKET" "gateway" "socket" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_GATEWAY_BOOT_PROBE" "gateway" "boot_probe" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_CHANNEL" "channel" "kind" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_ALLOW_PRIVATE" "telegram" "allow_private" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_TRANSPORT" "telegram" "transport" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_SERVICE_SOCKET" "telegram" "service_socket" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_CLIENT" "telegram" "client" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_TELEGRAM_POLL_LIMIT" "telegram" "poll_limit" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_SEARCH_PROVIDER" "search" "provider" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_RECENT_ACTION_TURNS" "context" "recent_action_turns" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_ANTHROPIC_CACHE_TTL" "context" "anthropic_cache_ttl" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_CONVERSATION_EVENTS" "context" "conversation_events" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_REPORTS_ROOT" "context" "reports_root" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_PROJECT_REGISTRY_PATH" "context" "project_registry_path" JsonNull expand)
   (ConfigFieldV1 "METTACLAW_CHROMA_COLLECTION" "memory" "collection" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_CHROMA_METRIC" "memory" "metric" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_BACKEND" "memory" "embed_backend" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_PROTOCOL" "memory" "embed_protocol" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_DIM" "memory" "embed_dim" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_DEVICE" "memory" "embed_device" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_QUERY_PROMPT_NAME" "memory" "embed_query_prompt_name" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_NORMALIZE" "memory" "embed_normalize" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_EMBED_MAX_TOKENS" "memory" "embed_max_tokens" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_MEMORY_SOURCE_OF_TRUTH" "memory" "source_of_truth" JsonNull plain)
   (ConfigFieldV1 "METTACLAW_MEMORY_INDEX_IS_REBUILDABLE" "memory" "index_is_rebuildable" JsonNull plain)))
