; A local owner's terminal uses exactly the operator handlers used by Telegram.
; JSON framing carries data, never MeTTa source to evaluate. Cognition is separate.
!(import! &self ./channels/telegram_control.metta)
!(import! &self ./src/runtime_context.py)

(= (terminal:body $reply)
   (case $reply
     (((tc:menu $toast $text $rows)
       (JsonObject ((JsonPair "kind" (JsonString "menu"))
         (JsonPair "text" (JsonString $text)) (JsonPair "toast" (JsonString $toast))
         (JsonPair "rows" $rows))))
      ($text (JsonObject ((JsonPair "kind" (JsonString "text"))
                          (JsonPair "text" (JsonString (tc:text $text)))))))))
(= (terminal:handle $request)
   (let* (($kind (tc:string (tc:at $request "kind")))
          ($reply (if (== $kind "command")
                   (catch (tc:answer (tc:string (tc:at $request "name"))
                                     (tc:string (tc:at $request "arguments"))))
                   (if (== $kind "choice")
                     (catch (tc:tap (tc:string (tc:at $request "value"))))
                     "Unknown terminal request kind")))
          ($body (if (== $kind "status")
                   (json-parse (tc:text (py-call (runtime_context.json_status))))
                   (terminal:body (tc:guarded $reply "control")))))
     (JsonObject ((JsonPair "id" (tc:at $request "id")) (JsonPair "body" $body)))))
(= (terminal:serve)
   (let $line (system:read-line)
     (if (== $line end_of_file) ()
       (let* (($result (catch (terminal:handle (json-parse $line))))
              ($reply (case $result
                (((Error $_ $_) (JsonObject ((JsonPair "id" JsonNull)
                  (JsonPair "error" (JsonString "invalid terminal request")))))
                 ($value $value))))
              ($_ (println! (str:concat "CLAW_CONTROL " (json-stringify $reply)))))
         (terminal:serve)))))
!(println! CLAW_CONTROL_READY)
!(terminal:serve)
