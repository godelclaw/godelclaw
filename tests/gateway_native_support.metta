!(import! &self ./native_test_support.metta)
!(import! &self ../src/line_rpc_cetta.metta)
!(import! &self ../src/state_file_cetta.metta)
!(import! &self (library host_io))
(= (gn:root) (path:join (nt:required-env "HOME") "g"))
(= (gn:call $operation $fields)
   (let $request (str:concat (json:stringify-python (JsonObject (list:append
     ((JsonPair "agent" "test-agent") (JsonPair "version" 1) (JsonPair "operation" $operation)) $fields))) "\n")
     (case (rpc:line (str:concat "unix://" (path:join (gn:root) "gateway.sock")) $request 3000 1048576)
       (((RpcReplyV1 $text) (json:parse-python $text)) ($bad $bad)))))
(= (gn:status $id) (sf:get (gn:call "status" ((JsonPair "id" $id))) "value" JsonNull))
(= (gn:submit $id $tool $input)
   (let $deadline (+ (system:wall-time) 30)
     (gn:call "submit" ((JsonPair "request" (JsonObject ((JsonPair "id" $id) (JsonPair "tool" $tool)
       (JsonPair "arguments" (JsonArray ())) (JsonPair "input" $input) (JsonPair "deadline" $deadline))))))))
(= (gn:await $id $left)
   (let $value (gn:status $id)
     (if (or (<= $left 0) (case (sf:get $value "state" "")
       (("queued" False) ("running" False) ("cancel-requested" False) ($end True)))) $value
       (progn (host:wait () 10) (gn:await $id (- $left 1))))))
(= (gn:ready $left)
   (let $reply (gn:call "tools" ())
     (if (or (ng-fixture:object? (sf:get $reply "value" JsonNull)) (<= $left 0)) $reply
       (progn (host:wait () 10) (gn:ready (- $left 1))))))
(= (ng-fixture:object? $value) (case $value (((JsonObject $_) True) ($bad False))))
(= (gn:fixture-tool $mode $effect $format)
   (let* (($binary (system:executable)) ($entry (path:join (nt:required-env "TEST_REPOSITORY") "tests/fixtures/gateway_tool_native.metta")))
     (JsonObject ((JsonPair "command" (JsonArray ($binary "--no-results" "--lang" "petta" "--profile" "extended"
                      "--import-mode" "ancestor-walk" $entry $mode)))
       (JsonPair "effect" $effect) (JsonPair "result_format" $format)))))
(= (gn:config)
   (let* (($root (nt:required-env "TEST_REPOSITORY"))
          ($reads (map-atom ("project-status" "vitals" "read-lines" "ls-tree" "grep-files") $name
            (JsonPair $name (JsonObject ((JsonPair "command" (JsonArray ("/usr/bin/python3" "-m" "execution_gateway.read_tools" $name)))
              (JsonPair "environment" (JsonObject ((JsonPair "METTACLAW_GATEWAY_AGENT" "test-agent"))))
              (JsonPair "cwd" $root) (JsonPair "effect" "read") (JsonPair "result_format" "json"))))))
          ($tools (list:append $reads ((JsonPair "echo" (gn:fixture-tool "echo" "read" "json"))
             (JsonPair "delay" (gn:fixture-tool "delay" "read" "json"))
             (JsonPair "write" (gn:fixture-tool "write" "write" "json"))
             (JsonPair "large-json" (gn:fixture-tool "large-json" "read" "json"))
             (JsonPair "invalid-json" (gn:fixture-tool "invalid-json" "write" "json"))))))
     (JsonObject ((JsonPair "agent" "test-agent") (JsonPair "state_directory" (gn:root)) (JsonPair "tools" (JsonObject $tools))))))
(= (gn:start $config)
   (let* (($root (nt:required-env "TEST_REPOSITORY")) ($path (path:join (nt:required-env "HOME") "gateway.json"))
          ($_ (sf:replace $path (json:stringify-python $config) 384 True)) ($binary (system:executable))
          ($entry (path:join $root "scripts/execution_gateway_cetta.metta"))
          ($job (proc:spawn ($binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk"
                    $entry "--config" $path) ((lifetime owner) (max-bytes 65536) (timeout-ms 40000)))))
     (let $_ (nt:require native-gateway-ready (ng-fixture:object? (sf:get (gn:ready 100) "value" JsonNull))) $job)))
