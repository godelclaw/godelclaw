!(import! &self ./native_test_support.metta)
!(import! &self (library host_io))
(= (nline:request $job $buffer $text $milliseconds)
   (case (proc:write $job $text)
     (((proc:queued $_) (nline:reply $job $buffer (+ (system:monotonic-ns) (* $milliseconds 1000000))))
      ($failed (NativeFixtureFailureV1 write-refused $failed)))))
(= (nline:reply $job $buffer $until)
   (case (buffer:line $buffer)
     (((HostLine $line) (json:parse $line))
      (HostPending
       (if (>= (system:monotonic-ns) $until) (NativeFixtureFailureV1 reply-timeout)
         (case (proc:read $job stdout 20)
           (((proc:chunk $chunk) (progn (buffer:append $buffer $chunk) (nline:reply $job $buffer $until)))
            (proc:pending (nline:reply $job $buffer $until))
            ($end (NativeFixtureFailureV1 end-of-stream))))))
      ($failed (NativeFixtureFailureV1 invalid-frame)))))
