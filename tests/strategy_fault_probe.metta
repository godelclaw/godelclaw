!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)
!(import! &self ./tests/scripted_provider.metta)
(= (assertEqual $a $b) (assert (== $a $b)))

;; Fail after the first command's result is saved. Reentering the same
;; cognitive iteration must use a new broker key and preserve that result.
!(scripted:answer 1 "((shell \"printf FIRST_FAULT_WITNESS\"))")
!(scripted:answer 2 "((shell \"printf SECOND_FAULT_WITNESS\"))")

(= (fault-probe:action-serials $rows)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((action $t $r $serial $tool $cmd $st $obs $rc $pay)
         (cons-atom $serial (fault-probe:action-serials (cdr-atom $rows))))
        ($other (fault-probe:action-serials (cdr-atom $rows)))))))

(= (fault-probe:action-statuses $rows)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((action $t $r $serial $tool $cmd $status $obs $rc $pay)
         (cons-atom $status (fault-probe:action-statuses (cdr-atom $rows))))
        ($other (fault-probe:action-statuses (cdr-atom $rows)))))))

;; The first call's batch faults immediately after turn:report saves its result.
(= (fault-probe:after-broker-report $turn $ticket)
   (if (== (scripted:calls) 1)
     (Error turn:broker-end forced-after-result)
     True))

!(initMemory)
!(configure commchannel telegram)
!(let* (($rm (collapse (match &self (= (turn:after-broker-report $t $k) $body)
               (remove-atom &self (= (turn:after-broker-report $t $k) $body)))))
        ($add (add-atom &self (= (turn:after-broker-report $t $k) (fault-probe:after-broker-report $t $k))))
        ($mode (loop-mode:set "godelclaw"))
        ($initial (initLoop))
        ($first (process-step $initial (turnProcess (process-periphery $initial))))
        ($c1 (assertEqual (loop-iteration (process-periphery $first))
                          (loop-iteration (process-periphery $initial))))
        ($c2 (assertEqual (strategy:batch) none))
        ($c3 (assertEqual (working:turn-commit-ready) 0))
        ($health1 (health:read))
        ($c4 (assertEqual (sf:get $health1 "last_failure_type" "") "host-transition-error"))
        ($c5 (assertEqual (sf:get $health1 "local_failure_count" 0) 1))
        ($actions1 (state:ledger "actions" ("all")))
        ($c6 (assertEqual (fault-probe:action-serials $actions1) (0)))
        ($c7 (assertEqual (fault-probe:action-statuses $actions1) ("returned")))
        ($second (process-step $first (turnProcess (process-periphery $first))))
        ($c8 (assertEqual (loop-iteration (process-periphery $second))
                          (+ 1 (loop-iteration (process-periphery $initial)))))
        ($c9 (assertEqual (working:turn-commit-ready) 1))
        ($actions2 (state:ledger "actions" ("all")))
        ($c10 (assertEqual (fault-probe:action-serials $actions2) (0 1)))
        ($c11 (assertEqual (fault-probe:action-statuses $actions2) ("returned" "returned")))
        ($c12 (assertEqual (scripted:calls) 2))
        ($c13 (assertEqual (scripted:prompt-has 2 "FIRST_FAULT_WITNESS") 1))
        ($c14 (assertEqual (strategy:batch) none)))
   (println! STRATEGY_FAULT_RECOVERY_OK))
