; Commentary before completion, against the native HTTP fixture peer holding a
; streamed reply after its first bytes: a chat-completions or Responses call
; publishes its commentary note while the provider is still pending, once;
; a reply that is then cut off or fails keeps that provisional note and
; yields no commands; reasoning is never a source. A note is accepted only in
; the sharing epoch its call began in: sharing turned off and on during the
; call, or off when it began, publishes nothing.
!(import! &self ./provider_native_qualification.metta)
!(import! &self ../src/public_worklog_cetta.metta)

(= (cm:body "chat") ("data: {\"id\": \"reply\", \"choices\": [{\"index\": 0, \"delta\": {\"reasoning_content\": \"PRIVATE REASONING {\\\"commentary\\\":\\\"not public\\\",\"}, \"finish_reason\": null}]}\n\ndata: {\"id\": \"reply\", \"choices\": [{\"index\": 0, \"delta\": {\"content\": \"{\\\"commentary\\\":\\\"Checking ž 🐈, safely.\\\", \\\"commands\\\":\\\"\"}, \"finish_reason\": null}]}\n\n:                                                                                                                                \n\n" "data: {\"id\": \"reply\", \"choices\": [{\"index\": 0, \"delta\": {\"content\": \"((nop))\\\"}\"}, \"finish_reason\": null}]}\n\ndata: {\"id\": \"reply\", \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}]}\n\ndata: [DONE]\n\n"))
(= (cm:body "responses") ("event: response.reasoning_text.delta\ndata: {\"type\": \"response.reasoning_text.delta\", \"delta\": \"PRIVATE REASONING {\\\"commentary\\\":\\\"not public\\\",\"}\n\nevent: response.output_text.delta\ndata: {\"type\": \"response.output_text.delta\", \"item_id\": \"msg\", \"output_index\": 1, \"content_index\": 0, \"delta\": \"{\\\"commentary\\\":\\\"Checking ž 🐈, safely.\\\", \\\"commands\\\":\\\"\"}\n\n:                                                                                                                                \n\n" "event: response.output_text.delta\ndata: {\"type\": \"response.output_text.delta\", \"item_id\": \"msg\", \"output_index\": 1, \"content_index\": 0, \"delta\": \"((nop))\\\"}\"}\n\nevent: response.completed\ndata: {\"type\": \"response.completed\", \"response\": {\"id\": \"resp_fixture\", \"status\": \"completed\", \"output\": [{\"type\": \"reasoning\", \"id\": \"reason_fixture\", \"summary\": [], \"encrypted_content\": \"opaque — Ω\"}, {\"type\": \"message\", \"role\": \"assistant\", \"status\": \"completed\", \"content\": [{\"type\": \"output_text\", \"text\": \"{\\\"commentary\\\":\\\"Checking ž 🐈, safely.\\\", \\\"commands\\\":\\\"((nop))\\\"}\", \"annotations\": []}]}], \"usage\": {\"input_tokens\": 10, \"output_tokens\": 2}}}\n\n"))
(= (cm:body "chat-truncated") ("data: {\"id\": \"reply\", \"choices\": [{\"index\": 0, \"delta\": {\"reasoning_content\": \"PRIVATE REASONING {\\\"commentary\\\":\\\"not public\\\",\"}, \"finish_reason\": null}]}\n\ndata: {\"id\": \"reply\", \"choices\": [{\"index\": 0, \"delta\": {\"content\": \"{\\\"commentary\\\":\\\"Checking ž 🐈, safely.\\\", \\\"commands\\\":\\\"\"}, \"finish_reason\": null}]}\n\n:                                                                                                                                \n\n" ":                                                                                                                                \n\n"))
(= (cm:body "responses-failed") ("event: response.reasoning_text.delta\ndata: {\"type\": \"response.reasoning_text.delta\", \"delta\": \"PRIVATE REASONING {\\\"commentary\\\":\\\"not public\\\",\"}\n\nevent: response.output_text.delta\ndata: {\"type\": \"response.output_text.delta\", \"item_id\": \"msg\", \"output_index\": 1, \"content_index\": 0, \"delta\": \"{\\\"commentary\\\":\\\"Checking ž 🐈, safely.\\\", \\\"commands\\\":\\\"\"}\n\n:                                                                                                                                \n\n" "event: response.output_text.delta\ndata: {\"type\": \"response.output_text.delta\", \"item_id\": \"msg\", \"output_index\": 1, \"content_index\": 0, \"delta\": \"((nop))\\\"}\"}\n\nevent: response.failed\ndata: {\"type\": \"response.failed\", \"response\": {\"status\": \"failed\"}}\n\n"))
(= (cm:note) "Checking ž 🐈, safely.")
(= (cm:world $root $sdk $core $artifacts $fixture $name $hold)
   (let* (($world (nq:world $root $sdk $core $artifacts $fixture (str:concat "commentary-" $name)))
          (($first $rest) (cm:body $name))
          ($_ (fs:write (nq:path $world "response.body") (str:concat $first $rest)))
          ($_ (fs:write (nq:path $world "prefix-bytes") (repr (str:byte-length $first))))
          ($_ (if $hold (fs:write (nq:path $world "hold-first-response") "hold") True))
          ($worklog (nq:path $world "public")))
     (CommentaryWorld $world $worklog)))
(= (cm:model $name) (if (str:starts-with $name "responses") "openai:fixture-model" "fixture-model"))
; The call, as a child of its own while the case watches it.
(= (cm:spawn $world $worklog $model)
   (let* (((NativeProviderTestWorldV1 $root $sdk $core $directory $socket $base $peer $server $env-base $io_fixture) $world)
          ($entry (nt:join $directory "commentary-guest.metta"))
          ($_ (fs:write $entry (str:join "" ("!(import! &self " (repr (nt:join $root "src/native_llm.metta")) ")\n"
                                             "!(println! (RESULT (llm:command " (repr $model) " 42 \"low\" \"input\")))\n"))))
          ($env (nq:guest-env $world $model (("METTACLAW_MODEL_COMMENTARY" "1") ("METTACLAW_LLM_STREAM" "1")
                                             ("METTACLAW_PUBLIC_WORK_DIR" $worklog) ("METTACLAW_PUBLIC_WORK_LIB" "")))))
     (proc:spawn ((nt:join $sdk "cetta") "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" "--quiet" $entry)
                 ((cwd $root) (env $env) (max-bytes 1048576) (lifetime owner)))))
(= (cm:notes $worklog)
   (case (pw:transact $worklog "read" "" JsonNull)
     (((PublicWorkRead $state (JsonArray $notes)) (map-atom $notes $n (json:get $n "text")))
      ($other (Unread $other)))))
; Waits run through the call's handle, which keeps it referenced.
(= (cm:until-file $owner $path $left)
   (if (fs:exists $path) True (if (<= $left 0) False (let $_ (proc:wait $owner 20) (cm:until-file $owner $path (- $left 1))))))
(= (cm:until-posted $owner $world $left)
   (if (>= (nq:posts $world) 1) True (if (<= $left 0) False (let $_ (proc:wait $owner 20) (cm:until-posted $owner $world (- $left 1))))))
(= (cm:until-noted $owner $worklog $left)
   (if (not (== (cm:notes $worklog) ())) True (if (<= $left 0) False (let $_ (proc:wait $owner 20) (cm:until-noted $owner $worklog (- $left 1))))))
(= (cm:output $owner)
   (case (proc:await $owner)
     (((proc:result (proc:exited 0) proc:normal $out $err $capture) $out)
      ($other (let $_ (println! (COMMENTARY_GUEST $other)) "")))))
; The note arrives while the provider is pending; the call then ends as $result.
(= (cm:early $root $sdk $core $artifacts $fixture $name $result)
   (let* (((CommentaryWorld $world $worklog) (cm:world $root $sdk $core $artifacts $fixture $name False))
          ($_ (pw:transact $worklog "on" "" JsonNull))
          ($owner (cm:spawn $world $worklog (cm:model $name)))
          ($_ (nt:require (str:concat "prefix-sent:" $name) (cm:until-file $owner (nq:path $world "prefix-sent") 400)))
          ($_ (nt:require (str:concat "note-before-completion:" $name)
                (and (cm:until-noted $owner $worklog 200)
                (and (== (cm:notes $worklog) ((cm:note)))
                (and (== (proc:status $owner) proc:pending)
                     (nt:equal (nq:posts $world) 1))))))
          ($_ (fs:write (nq:path $world "release-prefix") "release"))
          ($out (cm:output $owner))
          ($_ (nt:require (str:concat "call-ends-with-one-note:" $name)
                (and (nt:contains $out (str:join "" ("(RESULT " (repr $result) ")")))
                (and (== (cm:notes $worklog) ((cm:note)))
                     (nt:equal (nq:posts $world) 1)))))
          ($_ (nq:close $world)))
     True))
; Sharing changes after the call began ($off-first: it was off when it began).
(= (cm:sharing $root $sdk $core $artifacts $fixture $off-first)
   (let* (($name "chat")
          ((CommentaryWorld $world $worklog) (cm:world $root $sdk $core $artifacts $fixture $name True))
          ($_ (pw:transact $worklog (if $off-first "off" "on") "" JsonNull))
          ($owner (cm:spawn $world $worklog "fixture-model"))
          ($_ (nt:require call-began (cm:until-posted $owner $world 400)))
          ($_ (if $off-first True (pw:transact $worklog "off" "" JsonNull)))
          ($_ (pw:transact $worklog "on" "" JsonNull))
          ($_ (fs:write (nq:path $world "release-1") "release"))
          ($_ (nt:require prefix-sent-after-the-change (cm:until-file $owner (nq:path $world "prefix-sent") 400)))
          ($_ (proc:wait $owner 600))
          ($before (cm:notes $worklog))
          ($_ (fs:write (nq:path $world "release-prefix") "release"))
          ($out (cm:output $owner))
          ($quiet (and (== $before ()) (and (nt:contains $out "(RESULT \"((nop))\")") (== (cm:notes $worklog) ()))))
          ($_ (if $off-first (nt:require sharing-off-at-start-publishes-nothing $quiet)
                             (nt:require sharing-toggled-during-the-call-publishes-nothing $quiet)))
          ($_ (nq:close $world)))
     True))
(= (cm:run $root $sdk $core $artifacts $fixture)
   (let* (($_ (cm:early $root $sdk $core $artifacts $fixture "chat" "((nop))"))
          ($_ (cm:early $root $sdk $core $artifacts $fixture "responses" "((nop))"))
          ($_ (cm:early $root $sdk $core $artifacts $fixture "chat-truncated" "()"))
          ($_ (cm:early $root $sdk $core $artifacts $fixture "responses-failed" "()"))
          ($_ (cm:sharing $root $sdk $core $artifacts $fixture False))
          ($_ (cm:sharing $root $sdk $core $artifacts $fixture True)))
     NativeCommentaryCasesPassedV1))
