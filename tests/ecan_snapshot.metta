; SPDX-License-Identifier: MIT
; Run write then read in two separate processes, using ECAN_SNAPSHOT_PATH.
!(import! &self ./src/ecan_bank.metta)
!(import! &self ./src/ecan_decay.metta)
!(import! &self (library fs))
!(import! &self (library system))
(= (check $actual $expected)
   (let* (($a $actual) ($e $expected))
     (if (== $a $e) True
       (let $_ (println! (TestFailure $a $e)) (system:exit 1)))))
(= (snapshot:write $path)
   (let* (($bank (ecan:new 100 20))
          ($_ (ecan:set $bank "source:α (quoted)" 8 4))
          ($_ (ecan:stimulate $bank "task:current" 24 2))
          ($_ (ecan:set $bank "task:current" 24 11 2))
          ($_ (ecan:configure $bank sti-half-life 16))
          ($_ (ecan:configure $bank mti-half-life 64))
          ($_ (ecan:configure $bank lti-half-life 0))
          ($_ (ecan:configure $bank sti-mti-rate 0.25))
          ($_ (ecan:configure $bank mti-lti-rate 0.125))
          ($text (repr (ecan:snapshot $bank)))
          ($result (fs:update-text $path "replace" $text "" "")))
     (case $result
       ((("written" $absolute $bytes $hash $backup) (println! ECAN_SNAPSHOT_WRITTEN))
        ($other (let $_ (println! (SnapshotWriteFailed $other)) (system:exit 1)))))))
(= (snapshot:read $path)
   (let* (($bank (ecan:restore (parse (fs:read-text $path))))
          ($_ (check (ecan:get $bank "source:α (quoted)")
                     (ECANValue "source:α (quoted)" 8 0 4)))
          ($_ (check (ecan:focus $bank 1)
                     ((24 (ECANValue "task:current" 24 11 2)))))
          ($_ (check (ecan:total $bank) (ECANTotal 100 0 20)))
          ($_ (check (ecan:setting $bank sti-half-life) 16))
          ($_ (check (ecan:setting $bank mti-half-life) 64))
          ($_ (check (ecan:setting $bank lti-half-life) 0))
          ($_ (check (ecan:setting $bank sti-mti-rate) 0.25))
          ($_ (check (ecan:setting $bank mti-lti-rate) 0.125)))
     (println! ECAN_SNAPSHOT_RESTORED)))
!(let* (($path (system:getenv-or-default "ECAN_SNAPSHOT_PATH" ""))
        ($phase (system:getenv-or-default "ECAN_SNAPSHOT_PHASE" "")))
   (case $phase
     (("write" (snapshot:write $path))
      ("read" (snapshot:read $path))
      ($other (let $_ (println! (UnknownSnapshotPhase $other)) (system:exit 1))))))
