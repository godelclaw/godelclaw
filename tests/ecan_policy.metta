; SPDX-License-Identifier: MIT
!(import! &self ./src/ecan_bank.metta)
!(import! &self ./src/ecan_decay.metta)
!(import! &self (library system))
(= (check $actual $expected)
   (let* (($a $actual) ($e $expected))
     (if (== $a $e) True
       (let $_ (println! (TestFailure $a $e)) (system:exit 1)))))
(= (check-near $actual $expected)
   (if (< (abs-math (- $actual $expected)) 0.000000001) True
     (let $_ (println! (TestFailure $actual $expected)) (system:exit 1))))
!(let* (($bank (ecan:new 100 200 300))
        ($_ (ecan:configure $bank sti-half-life 10))
        ($_ (ecan:configure $bank mti-half-life 20))
        ($_ (ecan:configure $bank lti-half-life 40))
        ($_ (ecan:set $bank "x" 8 4 2))
        ($_ (check (ecan:preview $bank "x" 40) (ECANValue "x" 0.5 1 1)))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 8 4 2)))
        ($_ (ecan:advance $bank 40))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 0.5 1 1)))
        ($_ (check (ecan:total $bank) (ECANTotal 100 200 300)))
        ($_ (ecan:configure $bank lti-half-life 0))
        ($_ (ecan:set $bank "x" 8 4 2))
        ($_ (check (ecan:preview $bank "x" 40) (ECANValue "x" 0.5 1 2)))
        ($_ (ecan:configure $bank sti-mti-rate 0.5))
        ($_ (ecan:configure $bank mti-lti-rate 0.25))
        ($_ (ecan:use $bank "x" 8))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 16 10 4)))
        ($_ (ecan:focus $bank 1))
        ($_ (ecan:focus $bank 1))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 16 10 4)))
        ($_ (ecan:configure $bank sti-mti-rate 0))
        ($_ (ecan:configure $bank mti-lti-rate 0))
        ($_ (ecan:use $bank "x" 4))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 20 10 4)))
        ($_ (ecan:set $bank "y" 0 100 1))
        ($_ (ecan:set $bank "z" 0 0 100))
        ($_ (check (ecan:focus $bank 1 0 1 0) ((100 (ECANValue "y" 0 100 1)))))
        ($_ (check (ecan:focus $bank 1 1 0 0) ((20 (ECANValue "x" 20 10 4)))))
        ($_ (check (ecan:focus $bank 1 0 0 1) ((100 (ECANValue "z" 0 0 100)))))
        ($_ (ecan:set $bank "x" 22 4))
        ($_ (ecan:stimulate $bank "x" 2 3))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 24 10 7)))
        ($_ (ecan:decay $bank 0.5 0.5))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 12 10 3.5)))
        ($_ (check (ecan:total $bank) (ECANTotal 100 200 300)))
        ($_ (check-near (ecan:half-life-for 10 0.5) 10))
        ($_ (check-near (ecan:half-life-for 10 0.25) 5))
        ($_ (check (ecan:half-life-for 10 1) 0))
        ($_ (check-near (* (ecan:retention 10 20) (ecan:retention 10 20))
                       (ecan:retention 20 20)))
        ($_ (check-near (ecan:retention 10 (ecan:half-life-for 10 0.8)) 0.8))
        ($restored (ecan:restore (ecan:snapshot $bank)))
        ($_ (check (ecan:get $restored "y") (ecan:get $bank "y")))
        ($_ (check (ecan:policy $restored) (ecan:policy $bank)))
        ($legacy (ecan:restore ((ECANFunds 65 36)
                     ((ECANValue "a" 10 4) (ECANValue "b" 20 8) (ECANValue "c" 5 2)))))
        ($_ (check (ecan:get $legacy "a") (ECANValue "a" 10 0 4)))
        ($_ (check (ecan:total $legacy) (ECANTotal 100 0 50))))
   (println! ECAN_POLICY_TESTS_OK))
