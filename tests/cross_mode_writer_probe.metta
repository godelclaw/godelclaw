!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)
!(import! &self ./tests/scripted_provider.metta)

(= (assertEqual $a $b) (assert (== $a $b)))
; A mode's torn append, then this loop: before it reads, it completes the
; payload from the mode's record, so the record joins once and this loop's
; own record lands after it whole; the bytes stand in order.
(= (writer:history) (system:getenv-or-default "METTACLAW_HISTORY_PATH" ""))
(= (writer:append $text)
   (let $owner (fs:open-write (writer:history) ("create" "append") 384)
     (let* (($_ (fs:write-all $owner $text)) ($_ (fs:close $owner))) True)))
(= (writer:size) (let (AgentHistoryFileV1 $_ $_ $size) (agent-history:file) $size))
(= (writer:omega-record) (path:join (path:join (agent-history:modes-root) "omega") "native-checkpoint-v1.json"))
(= (writer:mark $offset $payload)
   (let* (((AgentHistoryFileV1 $quoted-device $quoted-inode $_) (agent-history:file))
          ($device (history-pending:bare $quoted-device)) ($inode (history-pending:bare $quoted-inode))
          ($_ (fs:make-directories (path:dirname (writer:omega-record)) 448)))
     (sf:replace (writer:omega-record)
       (json:stringify-python (JsonObject ((JsonPair "schema" 1) (JsonPair "mode" "omega") (JsonPair "operation" "append")
         (JsonPair "status" "pending") (JsonPair "path" (writer:history)) (JsonPair "payload" $payload)
         (JsonPair "sha256" (str:sha256 $payload)) (JsonPair "offset" $offset)
         (JsonPair "device" $device) (JsonPair "inode" $inode))))
       384 True)))
(= (writer:count $n $text)
   (- (size-atom (str:split (scripted:escaped $text) (fs:read-text (scripted:path (format-args "request-{}.body" ($n)))))) 1))
(= (writer:turn $state $n $note)
   (let $_ (scripted:answer $n (str:join "" ("((task-note \"" $note "\"))")))
     (process-step $state (turnProcess (process-periphery $state)))))

!(initMemory)
!(configure commchannel telegram)
!(let* (($_ (loop-mode:set "godelclaw"))
        ($s0 (initLoop))
        ($_ (writer:append "(\"2026-11-20 04:00:00\" \"\n\" \"HUMAN_MESSAGE: \" \"WRITER_BASE\" \"\n\" ((shell \"x\")) \"\n\")\n"))
        ($s1 (writer:turn $s0 1 "own turn one"))
        ($_ (assertEqual (writer:count 1 "WRITER_BASE") 1))
        ; Omega's append, torn after a few bytes, its record still pending.
        ($at (writer:size))
        ($payload "(\"2026-11-20 04:00:01\" \"\n\" ((shell \"TORN_OMEGA_COMMAND\")) \"\n\")\n(HistoryResultV1 omega \"2026-11-20 04:00:01\" (turn \"probe\" 1) (of \"0\") 0 returned full \"TORN_OMEGA_RESULT\")\n")
        ($_ (assertEqual (writer:mark $at $payload) True))
        ($_ (writer:append (str:byte-slice $payload 0 12)))
        ($s2 (writer:turn $s1 2 "own turn two"))
        ; Completed before the turn read: it joined once, whole.
        ($_ (assertEqual (writer:count 2 "TORN_OMEGA_COMMAND") 1))
        ($_ (assertEqual (writer:count 2 "TORN_OMEGA_RESULT") 1))
        ($bytes (fs:read-text (writer:history)))
        ($_ (assertEqual (str:byte-slice $bytes $at (+ $at (str:byte-length $payload))) $payload))
        ($_ (assertEqual (- (size-atom (str:split "TORN_OMEGA_RESULT" $bytes)) 1) 1))
        ; This loop's own record follows it, whole, and is not shown back.
        ($_ (assertEqual (str:starts-with (str:byte-slice $bytes (+ $at (str:byte-length $payload)) (str:byte-length $bytes)) "(\"") True))
        ($s3 (writer:turn $s2 3 "own turn three"))
        ($_ (assertEqual (writer:count 3 "TORN_OMEGA_RESULT") 1))
        ($_ (assertEqual (scripted:calls) 3)))
   (println! CROSS_MODE_WRITER_OK))
