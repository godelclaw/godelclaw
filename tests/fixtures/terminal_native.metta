!(import! &self (library host_io))
!(import! &self (library system))
!(import! &self (library str))
(= (tp:write $fd $text $at)
   (if (>= $at (str:byte-length $text)) True
     (case (host:write $fd $text $at)
       (((HostWritten $count) (tp:write $fd $text (+ $at $count)))
        (HostPending (progn (host:wait (($fd write)) 100) (tp:write $fd $text $at)))
        ($bad False)))))
(= (tp:loop $fd $signal)
   (if (!= (host:signal $signal) 0) True
     (let (HostReady $ready) (host:wait (($fd read) ($fd resize)) 100)
       (let* (($size (terminal:size $fd)) ($_ (tp:write $fd (str:concat (repr $size) "\n") 0)))
         (case (host:read $fd 4096)
           (((HostBytes $data) (progn (tp:write $fd (str:concat "INPUT=" $data) 0) (tp:loop $fd $signal)))
            (HostPending (tp:loop $fd $signal))
            ($end True)))))))
!(let* (($signal (host:signals)) ($fd (terminal:open "/dev/tty"))
         ($_ (terminal:raw $fd on)) ($_ (tp:write $fd "TERMINAL_NATIVE_READY\n" 0))
         ($_ (tp:loop $fd $signal)) ($_ (host:close $fd)) ($_ (host:close $signal)))
   True)
