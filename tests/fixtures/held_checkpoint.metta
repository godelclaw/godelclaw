; Delegate to the real ledger. Withhold one successful checkpoint reply until
; released, and require the retry to carry the same complete request.
!(import! &self ../../src/input_ledger_server.metta)
!(import! &self (library fs))
!(bind! &held-checkpoint (new-state none))
(= (held:marker $name)
   (str:concat (system:getenv-or-default "CETTA_DB_SOURCE" "") (str:concat "/../" $name)))
(= (held:route $route)
   (case $route
     (((ServiceRouteV1 LedgerCall Write ledger-server:call)
       (ServiceRouteV1 LedgerCall Write held:call))
      ($other $other))))
(= (held:configuration)
   (case (db-server:configuration)
     (((ValueServiceV2 $socket $data $routes $limits $maintenance)
       (ValueServiceV2 $socket $data (map-atom $routes $route (held:route $route)) $limits $maintenance))
      ($other $other))))
(= (held:uncertain) (LedgerAnswersV1 ((Error checkpoint fixture-reply-lost))))
(= (held:call $call)
   (case $call
     (((ServiceCallV1 $_ $_ $_ (LedgerCallV1 "checkpoint" ($text ("777") $request $now $id)))
       (let $previous (get-state &held-checkpoint)
         (if (== $previous none)
           (let $result (ledger-server:call $call)
             (case $result
               (((LedgerAnswersV1 (True))
                 (let* (($_ (change-state! &held-checkpoint ($text $request $now $id)))
                        ($_ (fs:write (held:marker "checkpoint-withheld") $id)))
                   (held:uncertain)))
                ($other $other))))
           (if (== $previous ($text $request $now $id))
             (if (fs:is-file (held:marker "checkpoint-release"))
               (let $_ (fs:write (held:marker "checkpoint-replayed") $id)
                 (ledger-server:call $call))
               (held:uncertain))
             (let $_ (fs:write (held:marker "checkpoint-conflict") $id)
               (LedgerAnswersV1 ((Error checkpoint changed-occurrence))))))))
      ($ordinary (ledger-server:call $call)))))
