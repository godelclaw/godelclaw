!(import! &self ../../tests/native_test_support.metta)
!(import! &self ../../src/handoff_evidence_cetta.metta)
!(import! &self ../../src/provider_request_cetta.metta)
!(bind! &handoff-observations (new-state 0))
(: handoff-test:claim (-> %Undefined% %Undefined% %Undefined%))
(: handoff-test:observe (-> %Undefined% %Undefined%))
(: handoff-test:double (-> %Undefined% %Undefined% %Undefined%))
(: handoff-test:repeat (-> %Undefined% %Undefined% %Undefined%))
(= (handoff-test:observe $source)
   (let* (($prior (get-state &handoff-observations))
          ($next (+ $prior 1)) ($counted (change-state! &handoff-observations $next)))
     (if (== $prior 0) (HandoffVersionUnavailableV1 transient-source)
       (HandoffVersionObservedV1 "new-observation"))))
(= (handoff-test:double $text $n)
   (if (<= $n 0) $text (handoff-test:double (str:concat $text $text) (- $n 1))))
(= (handoff-test:repeat $value $n)
   (if (<= $n 0) ()
     (let $rest (handoff-test:repeat $value (- $n 1)) (cons-atom $value $rest))))
(= (handoff-test:claim $source $version)
   (JsonObject ((JsonPair "claim" (JsonString "observed fixture"))
                (JsonPair "source" $source) (JsonPair "version" (JsonString $version)))))
(= (handoff-test:run)
   (let* (($directory (nt:required-env "HANDOFF_FIXTURE_DIR"))
          ($request-id (system:getenv-or-default "HANDOFF_FIXTURE_REQUEST" "input:evidence"))
          ($path (nt:join $directory "source.txt"))
          ($source (JsonObject ((JsonPair "kind" (JsonString "file")) (JsonPair "path" (JsonString $path)))))
          ($written (fs:write $path "version one"))
          ((HandoffVersionObservedV1 $first) (hevidence:version $source))
          ($digest-check (nt:require file-version-binds-exact-bytes (nt:equal $first (str:concat "sha256:" (str:sha256 "version one")))))
          ($claim (handoff-test:claim $source $first))
          ($claims (cons-atom $claim ()))
          ($duplicates (cons-atom $claim $claims))
          ($changed (fs:write $path "version two"))
          ($projection (hevidence:project $duplicates))
          ($duplicate-check (nt:require projection-preserves-duplicate-occurrences (nt:equal (size-atom $projection) 2)))
          ($row (car-atom $projection))
          ($recorded-check (nt:require recorded-version-is-unchanged (nt:equal (state:json-field $row "recorded_version") (JsonString $first))))
          ($current-check (nt:require current-version-observes-change
             (not (nt:equal (state:json-field $row "current_version") (JsonString $first)))))
          ($lost (JsonObject ((JsonPair "kind" (JsonString "file")) (JsonPair "path" (JsonString (nt:join $directory "missing"))))))
          ($missing-check (nt:require unavailable-is-not-a-version
             (case (hevidence:version $lost) (((HandoffVersionUnavailableV1 $missing-reason) True) ($missing-bad False)))))
          ($directory-source (JsonObject ((JsonPair "kind" (JsonString "file")) (JsonPair "path" (JsonString $directory)))))
          ($directory-check (nt:require nonregular-source-refused
             (case (hevidence:version $directory-source) (((HandoffVersionUnavailableV1 $directory-reason) True) ($directory-bad False)))))
          ($large-path (nt:join $directory "large-source.txt"))
          ($large-text (handoff-test:double "x" 21)) ($large-written (fs:write $large-path $large-text))
          ($large-source (JsonObject ((JsonPair "kind" (JsonString "file")) (JsonPair "path" (JsonString $large-path)))))
          ($limit-check (nt:require oversized-source-remains-unavailable
             (nt:equal (hevidence:version $large-source) (HandoffVersionUnavailableV1 materialization-limit))))
          ($request-source (JsonObject ((JsonPair "kind" (JsonString "request-head"))
             (JsonPair "ledger" (JsonString "handoff-fixture-ledger")) (JsonPair "id" (JsonString $request-id)))))
          ((HandoffVersionObservedV1 $head-before) (hevidence:version $request-source))
          ($settled (state:ledger "request-disposition" ($request-id "addressed" "handled" (str:concat "handoff:dispose:" $request-id))))
          ((HandoffVersionObservedV1 $head-after) (hevidence:version $request-source))
          ($head-check (nt:require request-version-observes-status-change (not (nt:equal $head-before $head-after))))
          ($wrong (preq:put $request-source "ledger" (JsonString "other-ledger")))
          ($owner-check (nt:require another-ledger-refused
             (nt:equal (hevidence:version $wrong) (HandoffVersionUnavailableV1 wrong-ledger))))
          ($missing-request (preq:put $request-source "id" (JsonString "input:missing")))
          ($absent-check (nt:require missing-request-remains-unavailable
             (nt:equal (hevidence:version $missing-request) (HandoffVersionUnavailableV1 missing-request))))
          ($envelope (JsonObject ((JsonPair "kind" (JsonString "godelclaw-handoff-v1"))
             (JsonPair "summary" (JsonString "continue the task")) (JsonPair "claims" (JsonArray $claims)))))
          ($encoded (json:stringify-python-with $envelope ((sort-keys True))))
          ($decode-check (nt:require evidence-envelope-round-trip
             (nt:equal (hevidence:decode $encoded) (HandoffEvidenceV1 "continue the task" $claims))))
          ($legacy-check (nt:require legacy-text-does-not-acquire-provenance
             (nt:equal (hevidence:decode "already reviewed") (HandoffEvidenceV1 "already reviewed" ()))))
          ($forged (preq:put $claim "trusted" (JsonBool True)))
          ($forged-check (nt:require forged-trust-field-refused (not (hevidence:claim? $forged))))
          ($duplicate-envelope (str:concat (str:byte-slice $encoded 0 (- (str:byte-length $encoded) 1)) ",\"summary\":\"different\"}"))
          ($unique-check (nt:require duplicate-envelope-fields-refused
             (nt:equal (hevidence:decode $duplicate-envelope) HandoffEvidenceRefusedV1)))
          ($shared (hevidence:project-using $duplicates handoff-test:observe))
          ($once-check (nt:require shared-source-observed-once (nt:equal (get-state &handoff-observations) 1)))
          ($coherent-check (nt:require unavailable-observation-reused (nt:equal (preq:head $shared) (preq:head (preq:tail $shared)))))
          ($refreshed (hevidence:project-using $duplicates handoff-test:observe))
          ($refresh-check (nt:require new-render-observes-again (nt:equal (get-state &handoff-observations) 2)))
          ($changed-check (nt:require next-render-can-observe-change (not (nt:equal $shared $refreshed))))
          ($many (handoff-test:repeat $claim 32))
          ($many-rows (hevidence:project-using $many handoff-test:observe))
          ($work-check (nt:require thirty-two-occurrences-need-one-more-observation (nt:equal (get-state &handoff-observations) 3)))
          ($many-check (nt:require all-thirty-two-occurrences-survive (nt:equal (size-atom $many-rows) 32)))
          ($too-many (handoff-test:repeat $claim 33))
          ($oversized-envelope (preq:put $envelope "claims" (JsonArray $too-many)))
          ($count-check (nt:require excessive-claim-count-refused (nt:equal (hevidence:decode (json:stringify-python-with $oversized-envelope ((sort-keys True)))) HandoffEvidenceRefusedV1)))
          ($marker-text "S_cache_boundary_T_cache_chunk_U")
          ($marker-claim (preq:put $claim "claim" (JsonString $marker-text)))
          ($marker-claims (cons-atom $marker-claim ()))
          ($marker-render (hevidence:render $marker-claims))
          ($marker-check (nt:require evidence-does-not-split-provider-cache
             (and (not (nt:contains $marker-render "_cache_boundary_")) (not (nt:contains $marker-render "_cache_chunk_")))))
          ($json-text (str:byte-slice $marker-render (str:byte-length "HANDOFF_EVIDENCE ") (str:byte-length $marker-render)))
          ((JsonArray $marker-rows) (json-parse $json-text))
          ($marker-row (preq:head $marker-rows))
          ($marker-value-check (nt:require escaping-preserves-the-claim-value
             (nt:equal (state:json-field $marker-row "claim") (JsonString $marker-text))))
          ($bounded-rows (hevidence:bound-rows $duplicates))
          ($bound-check (nt:require unavailable-render-within-serialized-bound
             (<= (str:byte-length (json:stringify-python-with (JsonArray $shared) ((sort-keys True))))
                 (str:byte-length (json:stringify-python-with (JsonArray $bounded-rows) ((sort-keys True)))))))) NativeHandoffEvidencePassedV1))
!(if (== (system:getenv-or-default "HANDOFF_EXPECT_UNAVAILABLE" "0") "1")
   (nt:require disconnected-ledger-is-unavailable
     (case (hevidence:request-version "handoff-fixture-ledger" "input:evidence")
       (((HandoffVersionUnavailableV1 $reason) True) ($bad False))))
   (nt:require handoff-evidence-completed (nt:equal (collapse (handoff-test:run)) (NativeHandoffEvidencePassedV1))))
!(println! NATIVE_HANDOFF_EVIDENCE_PASSED)
