; Native crash fixture. Pause only after the named physical publication step;
; the controller kills this owned process and recovers in fresh processes.
!(import! &self ../../src/observatory_cetta.metta)
(= (oc:park)
   (progn (host:wait () 1000) (oc:park)))
(= (oc:cut $root $selected $here)
   (if (!= $selected $here) True
     (progn (sf:replace (path:join $root "at-boundary.json")
              (json:stringify-python (JsonObject ((JsonPair "pid" (system:pid)) (JsonPair "at" $here)))) 384 True)
            (oc:park))))
(= (oc:partial $root $receipt)
   (let* (($id (sf:get $receipt "id" "")) ($path (op:stage $root $id "turns.jsonl"))
          ($reader (fs:open-read $path)) ((fs:chunk $bytes $_) (fs:read-chunk $reader 7 0))
          ($_ (fs:close $reader)) ($writer (fs:open-write (path:join $root "turns.jsonl") ("append") 384))
          ($_ (fs:write-all $writer $bytes)) ($_ (fs:close $writer))) True))
(= (oc:main $root $cut)
   (let* (($_ (change-state! &obs-options (JsonObject ((JsonPair "--data" $root)))))
          ($_ (change-state! &obs-cursor (JsonObject ((JsonPair "journal_cursor" "after")))))
          ($begun (op:begin $root))
          ($_ (obs:append "turns.jsonl" (JsonObject ((JsonPair "t" 1) (JsonPair "engine" "cetta")))))
          ($_ (obs:append "turns.jsonl" (JsonObject ((JsonPair "t" 1) (JsonPair "engine" "cetta")))))
          ($_ (obs:append "effects.jsonl" (JsonObject ((JsonPair "kind" "shell")))))
          ($_ (obs:close-writers)) ($_ (oc:cut $root $cut "collecting"))
          ($prepared (op:prepare $root (get-state &obs-cursor)))
          ($_ (oc:cut $root $cut "prepared"))
          ($receipt (get-state &op-batch)) ($id (sf:get $receipt "id" ""))
          ((JsonArray $entries) (sf:get $receipt "files" JsonNull))
          ($_ (if (== $cut "mid-line") (oc:partial $root $receipt) True))
          ($_ (oc:cut $root $cut "mid-line"))
          ($_ (op:publish-file $root $id (car-atom $entries) False))
          ($_ (oc:cut $root $cut "between-files"))
          ($_ (op:publish-files $root $id $entries False))
          ($_ (oc:cut $root $cut "outputs-synced"))
          ($_ (sf:replace (path:join $root "cursor.json") (sf:get $receipt "after" "") 384 True))
          ($_ (oc:cut $root $cut "cursor-committed")))
     (op:recover $root)))
!(let ($root $cut) (cli:strings (system:args))
   (let $result (if (== $cut "recover") (op:recover $root) (oc:main $root $cut))
     (progn (println! (PUBLICATION_RESULT $result)) (system:exit (if (== $result True) 0 2)))))
