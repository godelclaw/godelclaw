; Deterministic kernel actions against the real candidate and native mailbox.
!(import! &self ../../src/mail_cetta.metta)
!(import! &self ../../src/jobs_cetta.metta)
!(import! &self ../../src/strategy_host.py)
!(import! &self ../../src/working_state_host.py)
!(import! &self ../../channels/irc.py)
!(import! &self ../../channels/mattermost.py)
!(import! &self ../../src/channels.metta)
(= (commchannel) irc)
(= (input-kernel:begin)
   (let* (($_ (input-scope:reset)) ($text (mail:receive)))
     (input-kernel:begin-with $text)))
(= (input-kernel:begin-with $text)
   (let* (($_ (nt:require actual-delivery-presentation (not (mail:empty? $text))))
          ($encoded (input-scope:json))
          ($_ (py-call (strategy_host.begin "kernel-turn" "channel-event" $text $encoded)))
          (($ids $request) (py-call (working_state_host.commit_scope 1)))
          ($_ (nt:require working-scope-matches-presented-deliveries (nt:equal $ids (input-scope:ids)))))
     (KernelInputV1 $text $encoded $ids $request)))
(= (input-kernel:dispose $request)
   (let $answer (py-call (strategy_host.request_disposition $request "addressed" "handled notification"))
     (nt:require disposition-actually-recorded (nt:equal $answer "REQUEST_DISPOSITION_RECORDED"))))
(= (input-kernel:crash)
   (let* (($pid (system:pid)) ($text (preq:repr $pid)))
     (proc:run ("/bin/kill" "-KILL" $text) (system:cwd) (("PATH" "/usr/bin:/bin")) 1000 1024)))
(= (input-kernel:run "dispose-crash")
   (let* (((KernelInputV1 $text $encoded $ids $request) (input-kernel:begin))
          ($_ (input-kernel:dispose $request))) (input-kernel:crash)))
(= (input-kernel:run "read-crash")
   (let $_ (input-kernel:begin) (input-kernel:crash)))
(= (input-kernel:run "read-only")
   (let* (((KernelInputV1 $text $encoded $ids $request) (input-kernel:begin))
          ($_ (println! (KERNEL_PRESENTED_IDS $encoded)))) NativeKernelReadV1))
(= (input-kernel:run "quiet")
   (let* (($_ (input-scope:reset)) ($text (mail:receive))
          ($_ (nt:require settled-mail-is-quiet (mail:empty? $text)))
          ($_ (nt:require no-mailbox-wake (not (mail:pending?))))) NativeKernelQuietV1))
(= (input-kernel:run "late-scope")
   (let* (((KernelInputV1 $first $encoded $captured $request) (input-kernel:begin))
          ($_ (input-kernel:dispose $request)) ($late (mail:receive))
          ($_ (nt:require novel-mail-was-prepared (not (mail:empty? $late))))
          (($after $focus) (py-call (working_state_host.commit_scope 1)))
          ($_ (nt:require scope-does-not-resample-late-input (nt:equal $after $captured)))
          ($_ (nt:require late-mail-not-acknowledgeable (nt:equal (mail:ack) 0)))) NativeKernelLateScopeV1))
(= (input-kernel:run "job-dispose-crash")
   (let* (($_ (input-scope:reset)) ($text (jobs:receive))
          ((KernelInputV1 $body $encoded $ids $request) (input-kernel:begin-with $text))
          ($_ (nt:require uncommitted-job-cannot-be-acked (nt:equal (jobs:ack) 0)))
          ($_ (input-kernel:dispose $request))) (input-kernel:crash)))
(= (input-kernel:run "job-read")
   (let* (($_ (input-scope:reset)) ($text (jobs:receive))
          ((KernelInputV1 $body $encoded $ids $request) (input-kernel:begin-with $text))
          ($_ (println! (KERNEL_PRESENTED_IDS $encoded)))) NativeKernelJobReadV1))
(= (input-kernel:run "job-quiet")
   (let* (($_ (input-scope:reset)) ($text (jobs:receive))
          ($_ (nt:require settled-job-is-quiet (mail:empty? $text)))
          ($_ (nt:require no-job-wake (not (jobs:pending?))))) NativeKernelJobQuietV1))
(= (input-kernel:run "adapter-identities")
   (let* (($_ (collapse (py-call (irc._set_last "ok")))) ($first (py-call (irc.getLastMessage)))
          ($irc-old (py-call (irc.prepared_input_ids_json)))
          ($_ (collapse (py-call (irc._set_last "ok"))))
          ($_ (nt:require late-irc-does-not-rewrite-captured-ids
             (nt:equal (py-call (irc.prepared_input_ids_json)) $irc-old)))
          ($second (py-call (irc.getLastMessage))) ($irc-new (py-call (irc.prepared_input_ids_json)))
          ($_ (nt:require equal-irc-text-preserved (nt:equal $first $second)))
          ($_ (nt:require equal-irc-text-has-distinct-arrival-ids (not (nt:equal $irc-new $irc-old))))
          ($_ (input-scope:prepare-json $irc-new))
          ($_ (nt:require adapter-json-round-trip (nt:equal (preq:parse (input-scope:json)) (preq:parse $irc-new))))
          ($_ (collapse (py-call (mattermost._set_last "ok" "post,one"))))
          ($message (py-call (mattermost.getLastMessage)))
          ($_ (nt:require mattermost-body-presented (nt:equal $message "ok")))
          ($mm-old (py-call (mattermost.prepared_input_ids_json)))
          ($_ (collapse (py-call (mattermost._set_last "ok" "post-two"))))
          ($_ (nt:require late-mattermost-does-not-rewrite-captured-ids
             (nt:equal (py-call (mattermost.prepared_input_ids_json)) $mm-old)))
          ($_ (input-scope:prepare-json $mm-old))
          ($_ (nt:require opaque-comma-id-is-one-identity (nt:equal (input-scope:ids) ("mattermost:post,one"))))
          ($_ (py-call (mattermost.getLastMessage))) ($mm-new (py-call (mattermost.prepared_input_ids_json)))
          ($_ (input-scope:prepare-json $mm-new))
          ($_ (nt:require new-mattermost-id-preserved (nt:equal (input-scope:ids) ("mattermost:post-two"))))
          ($_ (collapse (catch (input-scope:prepare-json "[false]"))))
          ($_ (nt:require invalid-id-does-not-corrupt-scope (nt:equal (input-scope:ids) ("mattermost:post-two"))))
          ($_ (nt:require missing-delivery-ids-refused
             (case (catch (py-call (strategy_host.begin "missing-id" "operator-event" "ok" "[]")))
               (((Error $call $why) True) ($bad False)))))) NativeKernelAdapterIdentitiesV1))
(= (input-kernel:run "settled-channel-fallthrough")
   (let* (($_ (collapse (py-call (irc._set_last "old conversation"))))
          ($_ (py-call (irc.getLastMessage)))
          ($encoded (py-call (irc.prepared_input_ids_json)))
          ($_ (input-scope:prepare-json $encoded))
          ($ids (input-scope:ids)) ($socket (system:getenv-or-default "METTACLAW_INPUT_LEDGER_SOCKET" ""))
          ($now (system:wall-time))
          ($_ (nt:require prior-conversation-is-settled (ledger-client:call $socket "mark-processed" ($now $ids))))
          ($message (receive))
          ($_ (nt:require settled-conversation-does-not-starve-mail (str:starts-with $message "[mail from ")))
          ($_ (nt:require fallthrough-captures-mail-identity
             (nt:equal (input-scope:ids) ("mail:ffffffffffffffffffffffffffffffff"))))) NativeKernelFallthroughV1))
(= (input-kernel:run "unavailable-ledger")
   (let* (($message (receive))
          ($_ (nt:require transport-fault-not-presented-as-input (nt:equal $message "")))
          ($_ (nt:require transport-fault-creates-no-delivery-scope (nt:equal (input-scope:ids) ())))
          ($_ (nt:require transport-fault-never-acknowledgeable (not (mail:active?))))) NativeKernelUnavailableV1))
