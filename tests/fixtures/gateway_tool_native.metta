!(import! &self ../../src/state_file_cetta.metta)
!(import! &self (library io))
(= (gt:repeat $n)
   (if (<= $n 0) "" (let $half (gt:repeat (math:floor (/ $n 2)))
     (str:join "" ($half $half (if (== (% $n 2) 0) "" "x"))))))
(= (gt:delay $seconds)
   (let* (($milliseconds (math:floor (* $seconds 1000)))
          ((io:pending $timer) (io:submit (timer:after $milliseconds))))
     (io:wait $timer (+ $milliseconds 1000))))
(= (gt:main $mode $value)
   (case $mode
     (("echo" (JsonObject ((JsonPair "input" $value))))
      ("delay" (progn (gt:delay (sf:get $value "seconds" 0)) $value))
      ("write"
       (let* (($path (sf:get $value "path" "")) ($fd (fs:open-write $path ("create" "append") 384))
              ($_ (fs:write-all $fd "effect\n")) ($_ (fs:sync $fd)) ($_ (fs:close $fd))
              ($_ (gt:delay (sf:get $value "delay" 0)))) (JsonObject ((JsonPair "written" True)))))
      ("large-json" (JsonObject ((JsonPair "payload" (gt:repeat (sf:get $value "bytes" 0))))))
      ("large" (progn (system:write stdout (gt:repeat (sf:get $value "bytes" 0))) (system:exit 0)))
      ("invalid-json" (progn (system:write stdout "not JSON") (system:exit 0)))
      ($unknown (system:exit 2)))))
!(import! &self (library math))
!(let* (($arg (system:arg 0)) ($mode (str:symbol->string $arg))
         ($input (json:parse-python (system:read-line))) ($result (gt:main $mode $input)))
   (system:write stdout (str:concat (json:stringify-python $result) "\n")))
