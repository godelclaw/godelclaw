; The actual compactor/publication/view APIs, with no model request.
!(import! &self ../../src/context_compaction.metta)
(= (handoff-integration:double $text $n)
   (if (<= $n 0) $text (handoff-integration:double (str:concat $text $text) (- $n 1))))
(= (handoff-integration:run)
   (let* (($directory (nt:required-env "HANDOFF_FIXTURE_DIR"))
          ($path (nt:join $directory "context-source.txt")) ($written (fs:write $path "original"))
          ($source (JsonObject ((JsonPair "kind" (JsonString "file")) (JsonPair "path" (JsonString $path)))))
          ((HandoffVersionObservedV1 $recorded) (hevidence:version $source))
          ($claim (JsonObject ((JsonPair "claim" (JsonString "source inspected"))
             (JsonPair "source" $source) (JsonPair "version" (JsonString $recorded)))))
          ($claims (cons-atom $claim ()))
          ($envelope (JsonObject ((JsonPair "kind" (JsonString "godelclaw-handoff-v1"))
             (JsonPair "summary" (JsonString "Continue from the actual evidence.")) (JsonPair "claims" (JsonArray $claims)))))
          ($text (state:encoded $envelope))
          ($root "conversation:handoff-fixture-ledger")
          ($published (context:publish $root none 1 $text "fixture-call" "input:evidence" "input:evidence" "fixture-digest"))
          ($publish-check (nt:require evidence-checkpoint-published (nt:equal $published ContextPublished)))
          ($checkpoint (state:meta (task:window-key $root)))
          ($summary-check (nt:require readable-summary-stored (nt:equal (task:checkpoint-summary $checkpoint) "Continue from the actual evidence.")))
          ($claims-check (nt:require exact-claims-stored (nt:equal (task:items $checkpoint "claims") $claims)))
          ($stale (context:publish $root none 2 "stale overwrite" "other" "x" "y" "z"))
          ($cas-check (nt:require stale-base-refused (nt:equal $stale (ContextPreparationFailed "context-checkpoint-changed"))))
          ($changed (fs:write $path "changed"))
          ($rendered (task:checkpoint-handoff $root $checkpoint))
          ($old-check (nt:require old-version-still-visible (nt:contains $rendered $recorded)))
          ($current (str:concat "sha256:" (str:sha256 "changed")))
          ($new-check (nt:require changed-version-visible (nt:contains $rendered $current)))
          ($bound (task:checkpoint-handoff-bound $root $checkpoint))
          ($cost-check (nt:require complete-serialized-handoff-is-bounded (<= (str:byte-length $rendered) (str:byte-length $bound))))
          ($observed-view (task:conversation-projection "input:evidence" "continuation-tick" 0 8))
          ($pair (JsonObject ((JsonPair "id" (JsonString "fixture:1:0"))
             (JsonPair "command" (JsonArray ((JsonString "nop")))) (JsonPair "result" (JsonString "ok"))
             (JsonPair "disposition" (JsonString "recorded")))))
          ($pairs (cons-atom $pair ())) ($view (state:json-set $observed-view "transcript" (JsonArray $pairs)))
          ($plain-cost-check (nt:require ordinary-handoff-fits-control (context:summary-fits? $view "short handoff" 2048 4)))
          ($large-text (handoff-integration:double "x" 16))
          ($large-claim (state:json-set $claim "claim" (JsonString $large-text)))
          ($large-claims (cons-atom $large-claim ()))
          ($large-envelope (state:json-set $envelope "claims" (JsonArray $large-claims)))
          ($large-encoded (state:encoded $large-envelope))
          ($evidence-cost-check (nt:require oversized-evidence-does-not-fit
             (not (context:summary-fits? $view $large-encoded 2048 4))))
          ($bad (state:encoded (state:json-set $envelope "claims" (JsonArray ((JsonObject ()))))))
          ($refused (context:publish "invalid-evidence" none 1 $bad "none" "x" "y" "z"))
          ($refusal-check (nt:require invalid-evidence-cannot-publish (nt:equal $refused (ContextPreparationFailed "context-compaction-invalid-evidence"))))
          ($absence-check (nt:require rejected-evidence-keeps-checkpoint-absent (nt:equal (state:meta-text (task:window-key "invalid-evidence")) none)))) NativeContextHandoffPassedV1))
!(nt:require context-handoff-completed (nt:equal (collapse (handoff-integration:run)) (NativeContextHandoffPassedV1)))
!(println! NATIVE_CONTEXT_HANDOFF_PASSED)
