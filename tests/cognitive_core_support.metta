
; One real normal-loop turn, settled input, rest and recovery on the installed core.
!(import! &self ./provider_native_qualification.metta)
!(import! &self ../src/state_file_cetta.metta)
!(import! &self ../src/coding_io_cetta.metta)
(= (core-turn:wait $world $owner $left)
   (let* (($ids (ledger-client:call (nq:path $world "s.sock") "committed" (("777"))))
          ($working (ledger-client:call (nq:path $world "s.sock") "working-set" ())))
     (if (and (and (== $ids True) (!= $working none))
              (fs:is-file (nq:path $world "cwp/delivery-acked"))) $working
       (if (<= $left 0) (Error core-turn (Incomplete (checkpoint-timeout $ids $working)))
         (case (proc:wait $owner 100)
           (((proc:result $status $kind $out $err $capture)
              (progn (println! (NORMAL_EARLY_EXIT $status $kind $out $err)) (Error core-turn early-exit)))
            ($pending (core-turn:wait $world $owner (- $left 1)))))))))
(= (core-turn:restart $world $root $command $environment $effect-path)
   (let* (($restarted (proc:spawn $command ((cwd $root) (env $environment) (max-bytes 1048576))))
          ($_ (proc:wait $restarted 1500)) ($_ (proc:cancel $restarted))
          ($recovered (proc:await $restarted)) ($_ (proc:close $restarted))
          ($_ (fs:write (nq:path $world "normal-recovery.log") (repr $recovered)))
          ($_ (nt:require real-restart-reached-loop (nt:contains (repr $recovered) "iteration 1")))
          ($_ (nt:require restart-never-replays-recorded-effect (== (fs:read-text $effect-path) "X")))) True))
(= (core-turn:finish $world $owner $measured)
   (if $measured
     (let* (($result (proc:await $owner)) ($_ (fs:write (nq:path $world "normal.log") (repr $result)))
            ($_ (nt:exit-ok $result)) ($_ (proc:close $owner)))
       (ledger-client:call (nq:path $world "s.sock") "working-set" ()))
     (let* (($working (core-turn:wait $world $owner 200))
            ($_ (proc:cancel $owner)) ($ended (proc:await $owner)) ($_ (proc:close $owner))
            ($_ (fs:write (nq:path $world "normal.log") (repr $ended)))) $working)))
(= (core-turn:padding $bytes $text)
   (if (>= (str:byte-length $text) $bytes) (str:byte-slice $text 0 $bytes)
     (core-turn:padding $bytes (str:concat $text $text))))
(= (core-turn:message-settled $world)
   (case (ledger-client:call (nq:path $world "s.sock") "request-page" (0 100))
     (((page $total $rows)
       (let $messages (filter-atom $rows $row (== (preq:nth $row 3) "message"))
         (and (== (size-atom $messages) 1)
           (let $row (car-atom $messages)
             (and (== (preq:nth $row 4) 1) (not (== (preq:nth $row 1) "achieved")))))))
      ($bad False))))
(= (core-turn:run-at $root $engine $measured $prompt-bytes)
   (let* (($core (nt:required-env "NATIVE_TEST_CORE"))
          ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($world (nq:world $root $engine $core $artifacts (nt:required-env "NATIVE_TEST_HTTP_FIXTURE") "normal"))
          ($directory (nq:path $world "")) ($cwp-root (nq:path $world "cwp")) ($_ (fs:make-directories $cwp-root 448))
          ($socket (nq:path $world "c.sock"))
          ($payload "[\"input\",\"42\",\"message\",\"\",{\"update_id\":777,\"message\":{\"message_id\":1,\"date\":1700000000,\"chat\":{\"id\":42,\"type\":\"private\"},\"from\":{\"id\":42,\"first_name\":\"fixture\"},\"text\":\"Record this input and rest.\"}}]")
          ($_ (fs:write (path:join $cwp-root "delivery.json") $payload))
          ($cwp (proc:spawn ((nt:required-env "NATIVE_TEST_CWP_FIXTURE") $socket $cwp-root)
                  ((env (nt:environment $directory)) (max-bytes 65536))))
          ($_ (nq:wait-file $cwp (path:join $cwp-root "ready") 100))
          ($effect-path (nq:path $world "physical-effect"))
          ($shell (str:join "" ("printf X >> " (cio:shell-quote $effect-path)
                    (if $measured (str:concat "; : > " (cio:shell-quote (nq:path $world "recycle"))) ""))))
          ($program (str:join "" ("((shell " (repr $shell) ") (rest))")))
          ($message (JsonObject ((JsonPair "role" "assistant") (JsonPair "content" $program))))
          ($choice (JsonObject ((JsonPair "message" $message) (JsonPair "finish_reason" "stop"))))
          ($response (JsonObject ((JsonPair "id" "fixture") (JsonPair "choices" (JsonArray ($choice)))
                       (JsonPair "usage" (JsonObject ((JsonPair "prompt_tokens" 10) (JsonPair "completion_tokens" 2)))))))
          ($_ (fs:write (nq:path $world "response.body") (json:stringify-python $response)))
          ($_ (fs:write (nq:path $world "prompt.txt")
            (str:concat "Native integration fixture. Follow the requested command protocol.\n"
              (core-turn:padding $prompt-bytes "fixture context "))))
          ($_ (fs:write (nq:path $world "history.metta") ""))
          ($task-budget (system:getenv-or-default "NATIVE_TEST_TASK_BUDGET" ""))
          ($environment (nq:guest-env $world "fixture-model"
            (("METTACLAW_SKIP_INITIALIZE" "1") ("METTACLAW_SKIP_CONFIG" "1")
             ("METTACLAW_NATIVE_LEDGER" "1") ("METTACLAW_OBSERVED_STRATEGY" "1")
             ("METTACLAW_COMMAND_BATCH_LIMIT" "1") ("METTACLAW_CONTEXT_WINDOW_TOKENS" "262144")
             ("METTACLAW_TASK_CONTEXT_TOKENS" $task-budget)
             ("METTACLAW_TELEGRAM_SERVICE_SOCKET" $socket) ("METTACLAW_TELEGRAM_PRIMARY_CHAT_ID" "42")
             ("METTACLAW_TELEGRAM_ALLOWED_CHAT_IDS" "42")
             ("METTACLAW_RUNTIME_ROOT" $root)
             ("METTACLAW_PROMPT_PATH" (nq:path $world "prompt.txt"))
             ("METTACLAW_HISTORY_PATH" (nq:path $world "history.metta"))
             ("METTACLAW_WORKING_SET_PATH" (nq:path $world "working.json"))
             ("METTACLAW_TELEGRAM_LOG_PATH" (nq:path $world "telegram.jsonl"))
             ("METTACLAW_MODE_STATE_ROOT" (nq:path $world "modes"))
             ("METTACLAW_LOOP_MODE_PATH" (nq:path $world "mode.json"))
             ("METTACLAW_EFFECT_RECEIPT_PATH" (nq:path $world "effects.jsonl"))
             ("METTACLAW_JOBS_DIR" (nq:path $world "jobs")) ("CLAW_MAIL_HOME" (nq:path $world "mail"))
             ("METTACLAW_MAIL_SOCKET" (nq:path $world "no-mail.sock"))
             ("METTACLAW_MEMORY_BACKEND_CONFIG" (nq:path $world "no-memory.json"))
             ("METTACLAW_PINS_PATH" (nq:path $world "pins.txt")))))
          ($launcher (path:join $root "run.sh"))
          ($loop ("bash" $launcher "run.metta"))
          ($measurement (nq:path $world "measurement.json"))
          ($command (if $measured
            (preq:append ((nt:required-env "NATIVE_TEST_HTTP_FIXTURE") "--measure" $measurement "--") $loop) $loop))
          ($owner (proc:spawn $command ((cwd $root) (env $environment) (max-bytes 1048576) (timeout-ms 30000))))
          ($_ (nt:require cognitive-process-launched
            (not (case $owner (((proc:failed $_ $_) True) ($other False))))))
          ($working (core-turn:finish $world $owner $measured))
          ($_ (fs:write (nq:path $world "working-result.metta") (repr $working)))
          ($_ (nt:require normal-loop-settled-captured-input (not (case $working (((Error $_ $_) True) ($other False))))))
          ($_ (nt:require normal-loop-made-native-provider-call (> (nq:posts $world) 0)))
          ($_ (if (== $task-budget "") True
                (nt:require budgeted-turn-submitted-its-context-view
                  (nt:contains (fs:read-text (nq:path $world "request-1.body")) "TASK_CONTEXT "))))
          ($_ (nt:require rest-directive-was-applied
                (== (sf:get (sf:native-object (nq:path $world "working.json")) "rest_await_input" False) True)))
          ($_ (nt:require actual-command-receipt-written
                (nt:contains (fs:read-text (nq:path $world "effects.jsonl")) "RESTING budget-banked")))
          ($_ (nt:require physical-effect-was-executed-once (== (fs:read-text $effect-path) "X")))
          ($_ (nt:require normal-input-was-acknowledged (fs:is-file (path:join $cwp-root "delivery-acked"))))
          ($_ (nt:require input-processed-does-not-claim-achievement (core-turn:message-settled $world)))
          ($_ (if $measured
            (println! (CORE_FLOW_MEASUREMENT (nq:path $world "measurement.json") (fs:read-text $measurement)))
            (core-turn:restart $world $root $command $environment $effect-path)))
          ($_ (nq:close $world))
          ($_ (proc:cancel $cwp)) ($_ (proc:await $cwp)) ($_ (proc:close $cwp)))
     (progn (println! NATIVE_NORMAL_TURN_OK)
       (if $measured (json:parse (fs:read-text $measurement)) True))))
(= (core-turn:run)
   (core-turn:run-at (system:getenv-or-default "NATIVE_TEST_RUNTIME_ROOT" (system:cwd))
     (system:getenv-or-default "NATIVE_TEST_ENGINE" (nt:required-env "NATIVE_TEST_CORE"))
     (== (system:getenv-or-default "NATIVE_MEASURE" "0") "1") 0))
