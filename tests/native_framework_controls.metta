; A successful exit without any assertion, or with two answers, must fail.
!(import! &self ./provider_request_contracts.metta)
(: nf:negative (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (nf:negative $core $directory $label $condition)
   (let* (($root (system:cwd)) ($entry (nt:join $directory (str:concat $label ".metta")))
          ($support (preq:repr (nt:join $root "tests/native_test_support.metta")))
          ($source (format-args "!(import! &self {})\n!(nt:require {} {})\n" ($support $label $condition)))
          ($_ (fs:write $entry $source)) ($engine (nt:join $core "cetta"))
          ($result (proc:run ($engine "--lang" "petta" "--quiet" $entry) $root (("PATH" "/usr/bin:/bin")) 5000 65536)))
     (case $result
       (((proc:exited 1 $out $err) (nt:require assertion-refusal-observed (nt:contains $out "(FAIL")))
        ($wrong (let $_ (println! (BAD_ASSERTION_CONTROL $label $wrong)) (system:exit 1)))))))
(: nf:run (-> %Undefined% %Undefined% %Undefined%))
(= (nf:run $core $artifacts)
   (let* (($id (system:uuid4-hex)) ($name (str:concat "framework-" (str:byte-slice $id 0 10)))
          ($directory (nt:join $artifacts $name)) ($_ (fs:make-directories $directory 448))
          ($_ (nf:negative $core $directory "false" "False"))
          ($_ (nf:negative $core $directory "zero" "(superpose ())"))
          ($_ (nf:negative $core $directory "multiple" "(superpose (True True))"))
          ($_ (nf:negative $core $directory "unit" "()"))) 4))
