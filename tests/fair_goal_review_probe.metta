!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)
!(py-eval "__import__('os').environ.update(METTACLAW_FAIR_GOALS='1', METTACLAW_OBSERVED_STRATEGY='1')")
!(py-eval "__import__('sys').path.insert(0, 'tests')")
!(py-eval "__import__('fair_goal_reply').setup()")
!(py-eval "__import__('strategy_host').__dict__.__setitem__('_stimulus_free', lambda: True)")
!(py-eval "__import__('synthetic_llm').__dict__.__setitem__('chat', __import__('fair_goal_reply').reply)")
!(py-eval "(__import__('helper').__dict__.__setitem__('_working_boot_cache', {}), __import__('helper').__dict__.__setitem__('working_boot', lambda: 6))")
!(initMemory)
!(configure commchannel telegram)
!(let* (($_ (py-call (loop_modes.set_mode "godelclaw")))
         ($initial (initLoop))
         ($first (process-step $initial (turnProcess (process-periphery $initial))))
         ($second (process-step $first (turnProcess (process-periphery $first))))
         ($third (process-step $second (turnProcess (process-periphery $second)))))
   (println! FAIR_GOAL_REVIEW_TURNS_FINISHED))
!(py-eval "__import__('fair_goal_reply').check()")
