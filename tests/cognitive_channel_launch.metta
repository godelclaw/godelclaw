!(import! &self ./provider_native_qualification.metta)
(= (channel-flow:run)
   (let* (($root (system:cwd)) ($core (nt:required-env "NATIVE_TEST_CORE"))
          ($artifacts (nt:required-env "NATIVE_TEST_ARTIFACTS"))
          ($world (nq:world $root $core $core $artifacts (nt:required-env "NATIVE_TEST_HTTP_FIXTURE") "channel"))
          ($directory (nq:path $world "")) ($fixture (nt:required-env "NATIVE_CORE_PEER"))
          ($engine (path:join $core "cetta")) ($capture (nq:path $world "channel-capture"))
          ($credential (nq:path $world "unit-credential")) ($_ (fs:write $credential "unit-token\n"))
          ((NativeProviderTestWorldV1 $_ $_ $_ $_ $_ $base $_ $_ $_ $_) $world)
          ($_ (fs:write (nq:path $world "response.body") "{\"ok\":true}"))
          ($env (preq:append (nt:environment $directory)
            (("CETTA_BIN" $engine) ("CETTA_TELEGRAM_SERVICE_BIN" $fixture) ("CETTA_TELEGRAM_SERVICE_ROOT" $core)
             ("METTACLAW_AGENT_NAME" "Fixture") ("METTACLAW_TELEGRAM_OPERATOR_IDS" "7,7")
             ("METTACLAW_TELEGRAM_PRIMARY_CHAT_ID" "42") ("METTACLAW_TELEGRAM_ALLOWED_CHAT_IDS" "-21,42,43")
             ("METTACLAW_TELEGRAM_WAKE_IDS" "8,9") ("METTACLAW_TELEGRAM_ALLOW_PRIVATE" "1")
             ("METTACLAW_TELEGRAM_BARE_GROUP_COMMANDS" "0") ("METTACLAW_TELEGRAM_MENU_ORIGIN" $base)
             ("METTACLAW_TELEGRAM_POLL_LIMIT" "100") ("METTACLAW_TELEGRAM_INITIAL_OFFSET" "123")
             ("NATIVE_CHANNEL_CAPTURE" $capture))))
          ($launcher (path:join $root "scripts/start_telegram_service.sh"))
          ($command ("bash" "-c" "exec 3</dev/null; exec 4</dev/null; exec \"$@\"" "native-fixture"
                    "bash" $launcher "--repo" $root "--state" $directory "--credential" $credential))
          ($_ (nt:exit-ok (proc:run $command $root $env 15000 65536)))
          ($argv (fs:read-text $capture))
          ($_ (nt:require listener-and-control-descriptors-survive-exec
            (and (nt:contains $argv "listener-inherited=1") (nt:contains $argv "operator-inherited=1"))))
          ($_ (nt:require every-chat-flag-retained (nt:contains $argv "--chat\n-21\n--chat\n42\n--chat\n43\n")))
          ($_ (nt:require operator-deduplication (nt:contains $argv "--operator\n7\n--allow-private")))
          ($_ (nt:require offset-and-poll-limit-retained (nt:contains $argv "--initial-offset\n123\n--poll-limit\n100\n")))
          ($commands (fs:read-text (nq:path $world "commands.metta")))
          ($_ (nt:require agent-name-declared (nt:contains $commands "(tg-cmd:agent \"Fixture\")")))
          ($_ (nt:require bare-group-policy-preserved (not (nt:contains $commands "(tg-cmd:bare-in-groups)"))))
          ($_ (nt:require native-menu-posted (nt:contains (fs:read-text (nq:path $world "request-1.headers")) "/botunit-token/setMyCommands")))
          ($_ (fs:remove $capture))
          ($invalid (nq:overlay-env $env (("METTACLAW_TELEGRAM_ALLOWED_CHAT_IDS" "0"))))
          ($refused (proc:run $command $root $invalid 15000 65536))
          ($_ (nt:require invalid-admission-refuses-before-exec
            (case $refused (((proc:exited 78 $_ $_) (not (fs:is-file $capture))) ($other False)))))
          ($_ (nt:require invalid-admission-does-not-publish-menu (== (nq:posts $world) 1)))
          ($_ (nq:close $world))) NativeChannelLaunchPassedV1))
!(nt:require native-channel-launch-completed (== (collapse (channel-flow:run)) (NativeChannelLaunchPassedV1)))
!(println! NATIVE_CHANNEL_LAUNCH_PASSED)
