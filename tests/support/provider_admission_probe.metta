!(import! &self ../../src/provider_admission_cetta.metta)
!(import! &self ./provider_domain_probe.metta)

(= (provider-admission-probe:run (Create $path)) (knowledge-probe:run (Create $path)))
(= (provider-admission-probe:run (Knowledge $path $operation)) (knowledge-probe:run (At $path $operation)))
(= (provider-admission-probe:run (PurePlan $command $points)) (pa:plan $command $points))
(= (provider-admission-probe:run (Deadline $profile $now $cooldown $maximum))
  (pa:deadline $profile $now $cooldown $maximum))
(= (provider-admission-probe:run (FirstAdmission $reply))
  (if (pa:first-admission? $reply) ProviderFirstAdmissionV2 ProviderNoNewAdmissionV2))
(= (provider-admission-probe:run (Finish $path $receipt $command))
  (provider-domain-probe:run (At $path $receipt $command)))
(= (provider-admission-probe:run (At $path $receipt $command))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (pa:execute $owner $view $receipt $command 1048576))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

; Capture both application and optional broker dependencies on one view.
; The fixture supplies the identity and grant decision; it is not a broker.
(= (provider-admission-probe:first $owner $view $operation)
  (case $operation
    (((AdmissionChange $receipt $command) (pa:execute $owner $view $receipt $command 1048576))
     ($fixture (knowledge-probe:apply $owner $view $fixture)))))
(= (provider-admission-probe:race $owner $view $receipt $command $first $extra-identities)
  (case (kb:observe $view $extra-identities 1048576)
    (((KnowledgeObservedV1 $points $reads)
      (let* (($left (provider-admission-probe:first $owner $view $first))
             ($right (pa:execute-scoped $owner $view $reads $receipt $command 1048576)))
        (ProviderAdmissionRaceV2 $left $right)))
     ($error $error))))
(= (provider-admission-probe:run (Race $path $receipt $command $first $extra-identities))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (provider-admission-probe:race $owner $view $receipt $command $first $extra-identities))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
