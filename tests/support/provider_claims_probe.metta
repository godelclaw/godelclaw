!(import! &self ../../src/provider_claims_cetta.metta)
!(import! &self ../../src/provider_settlement_cetta.metta)
!(import! &self ./provider_admission_probe.metta)

(= (provider-claims-probe:run (Create $path)) (knowledge-probe:run (Create $path)))
(= (provider-claims-probe:run (Knowledge $path $operation)) (knowledge-probe:run (At $path $operation)))
(= (provider-claims-probe:run (Admit $path $receipt $command)) (provider-admission-probe:run (At $path $receipt $command)))
(= (provider-claims-probe:run (LegacyFinish $path $receipt $command))
  (provider-domain-probe:run (At $path $receipt $command)))
(= (provider-claims-probe:run (Eligible $policy $active $incoming))
  (if (pc:eligible $policy $active $incoming) ProviderClaimEligibleV3 ProviderClaimBusyV3))
(= (provider-claims-probe:run (RecoverDecision $stage $observation))
  (ps:recovery-decision $stage $observation))
(= (provider-claims-probe:transition $owner $view $receipt $command)
  (case $command
    (((ProviderBeginDispatchV3 $call $who $process $transport)
      (pc:execute $owner $view $receipt $command 1048576))
     ($settlement (ps:execute $owner $view $receipt $command 1048576)))))
(= (provider-claims-probe:run (LifecycleRace $path $first-id $first $second-id $second))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($left (provider-claims-probe:transition $owner $view $first-id $first))
                   ($right (provider-claims-probe:transition $owner $view $second-id $second))
                   ($closed (store:close $view)))
              (ProviderLifecycleRaceV3 $left $right)))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
(= (provider-claims-probe:run (Settlement $path $receipt $command))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (ps:execute $owner $view $receipt $command 1048576))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
(= (provider-claims-probe:run (At $path $receipt $command))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (pc:execute $owner $view $receipt $command 1048576))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
(= (provider-claims-probe:run (Race $path $first-id $first $second-id $second))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($left (pc:execute $owner $view $first-id $first 1048576))
                   ($right (pc:execute $owner $view $second-id $second 1048576))
                   ($closed (store:close $view)))
              (ProviderClaimRaceV3 $left $right)))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
