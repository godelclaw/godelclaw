!(import! &self ../../src/provider_domain_cetta.metta)
!(import! &self ./knowledge_store_probe.metta)

(= (provider-domain-probe:run (Create $path)) (knowledge-probe:run (Create $path)))
(= (provider-domain-probe:run (Knowledge $path $operation)) (knowledge-probe:run (At $path $operation)))
(= (provider-domain-probe:run (PurePlan $command $points)) (provider-domain:plan $command $points))
(= (provider-domain-probe:run (Normalize $usage)) (provider-domain:usage-evidence $usage))
(= (provider-domain-probe:run (FirstCompletion $reply))
  (if (provider-domain:first-completion? $reply) ProviderFirstCompletionV2 ProviderNoNewCompletionV2))
(= (provider-domain-probe:run (At $path $receipt $command))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (provider-domain:execute $owner $view $receipt $command 1048576))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))

; Plan an external change and a provider decision against the same captured
; view, then publish the change before the provider's conditional commit.
(= (provider-domain-probe:race $owner $view $receipt $command $first)
  (case (provider-domain:observe $view $command 1048576)
    (((KnowledgeObservedV1 $points $reads)
      (case (provider-domain:plan $command $points)
        (((ProviderDomainPlanV2 $answer $changes)
          (let* (($left (knowledge-probe:apply $owner $view $first))
                 ($right (kb:publish $owner $view $reads $receipt $command $answer $changes 1048576)))
            (ProviderDomainRaceV2 $left $right)))
         ($error $error))))
     ($error $error))))
(= (provider-domain-probe:run (Race $path $receipt $command $first))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (provider-domain-probe:race $owner $view $receipt $command $first))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
