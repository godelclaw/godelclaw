; Alternating complete offline turns through installed previous/candidate code.
!(import! &self ./provider_native_qualification.metta)
(: nb:double (-> %Undefined% %Undefined% %Undefined%))
(= (nb:double $text $rounds)
   (if (<= $rounds 0) $text (nb:double (str:concat $text $text) (- $rounds 1))))
(: nb:chunks (-> %Undefined% %Undefined% %Undefined%))
(= (nb:chunks $count $text)
   (if (<= $count 0) $text
     (let* (($index (preq:repr $count)) ($chunk (nb:double (str:concat "λ 🌿 " $index) 9))
            ($next (str:concat (str:concat $text "\n_cache_chunk_\n") $chunk)))
       (nb:chunks (- $count 1) $next))))
(: nb:measure (-> %Undefined% %Undefined% %Undefined%))
(= (nb:measure $world $prompt)
   (let* (($quoted (preq:repr $prompt))
          ($forms (format-args "!(let $answer (llm:command \"claude-fixture\" 42 \"low\" {}) (let $_ (nt:require benchmark-answer (nt:equal $answer \"(nop)\")) (println! NATIVE_BENCHMARK_ANSWER_OK)))" ($quoted)))
          ((NativeTestGuestResultV1 $elapsed $result) (nq:guest $world "claude-fixture" "petta" $forms ()))
          ($output (nt:exit-ok $result))
          ($_ (nt:require measured-answer (nt:contains $output "NATIVE_BENCHMARK_ANSWER_OK")))
          ($rss (nq:read-number (nq:path $world "peak-rss-kib"))))
     (NativeBenchSampleV1 $elapsed $rss)))
(: nb:time (-> %Undefined% Number))
(= (nb:time (NativeBenchSampleV1 $ns $rss)) $ns)
(: nb:rss (-> %Undefined% Number))
(= (nb:rss (NativeBenchSampleV1 $ns $rss)) $rss)
(: nb:pairs (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(: nb:even (-> Number Bool))
(= (nb:even $number)
   (let (IntegerDivmodV1 $quotient $remainder) (math:integer-divmod $number 2)
     (nt:equal $remainder 0)))
(= (nb:pairs $previous $candidate $prompt $left $old $new)
   (if (<= $left 0) (NativeBenchSamplesV1 $old $new)
     (if (nb:even $left)
       (let* (($a (nb:measure $previous $prompt)) ($b (nb:measure $candidate $prompt))
              ($old-next (preq:cons $a $old)) ($new-next (preq:cons $b $new)))
         (nb:pairs $previous $candidate $prompt (- $left 1) $old-next $new-next))
       (let* (($b (nb:measure $candidate $prompt)) ($a (nb:measure $previous $prompt))
              ($old-next (preq:cons $a $old)) ($new-next (preq:cons $b $new)))
         (nb:pairs $previous $candidate $prompt (- $left 1) $old-next $new-next)))))
(: nb:insert (-> %Undefined% %Undefined% %Undefined%))
(= (nb:insert $value $items)
   (if (nt:equal $items ()) ($value)
     (let $first (preq:head $items)
       (if (< $value $first) (preq:cons $value $items)
         (preq:cons $first (nb:insert $value (preq:tail $items)))))))
(: nb:sort-values (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(= (nb:sort-values $samples $kind $sorted)
   (if (nt:equal $samples ()) $sorted
     (let* (($sample (preq:head $samples))
            ($value (if (nt:equal $kind time) (nb:time $sample) (nb:rss $sample)))
            ($next (nb:insert $value $sorted)))
       (nb:sort-values (preq:tail $samples) $kind $next))))
(: nb:stats (-> %Undefined% %Undefined%))
(= (nb:stats $samples)
   (let* (($times (nb:sort-values $samples time ())) ($rss (nb:sort-values $samples rss ()))
          ($median (preq:nth $times 10)) ($p95 (preq:nth $times 19)) ($memory (preq:nth $rss 10)))
     (NativeBenchStatisticsV1 $median $p95 $memory)))
(: nb:report-stats (-> %Undefined% %Undefined%))
(= (nb:report-stats (NativeBenchStatisticsV1 $median $p95 $rss))
   (preq:object ((preq:pair "median_ns" (preq:number (preq:repr $median)))
                 (preq:pair "p95_ns" (preq:number (preq:repr $p95)))
                 (preq:pair "median_peak_rss_kib" (preq:number (preq:repr $rss))))))
(: nb:workload (-> %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined% %Undefined%))
(= (nb:workload $root $sdk $core $artifacts $fixture $baseline-root $baseline-sdk ($name $prompt))
   (let* (($old-name (str:concat "baseline-" $name)) ($new-name (str:concat "candidate-" $name))
          ($previous (nq:world $baseline-root $baseline-sdk $core $artifacts $fixture $old-name))
          ($candidate (nq:world $root $sdk $core $artifacts $fixture $new-name))
          ($_ (nq:reply $previous "anthropic")) ($_ (nq:reply $candidate "anthropic"))
          ((NativeBenchSamplesV1 $old $new) (nb:pairs $previous $candidate $prompt 21 () ()))
          ($_ (nt:require benchmark-previous-posts (nt:equal (nq:posts $previous) 21)))
          ($_ (nt:require benchmark-candidate-posts (nt:equal (nq:posts $candidate) 21)))
          ($_ (nt:require exact-provider-wire (nt:equal (nq:request-body $previous) (nq:request-body $candidate))))
          ($old-stats (nb:stats $old)) ($new-stats (nb:stats $new))
          ((NativeBenchStatisticsV1 $old-med $old-p95 $old-rss) $old-stats)
          ((NativeBenchStatisticsV1 $new-med $new-p95 $new-rss) $new-stats)
          ($within (and (<= (* $new-p95 100) (* $old-p95 115)) (<= (* $new-rss 100) (* $old-rss 115))))
          ($row (preq:object ((preq:pair "workload" (preq:string $name))
            (preq:pair "prompt_bytes" (preq:number (preq:repr (str:byte-length $prompt))))
            (preq:pair "pairs" (JsonNumber "21")) (preq:pair "within_initial_budget" (preq:bool $within))
            (preq:pair "baseline" (nb:report-stats $old-stats)) (preq:pair "candidate" (nb:report-stats $new-stats)))))
          ($path (nt:join $artifacts (str:concat "benchmark-" (str:concat $name ".json"))))
          ($_ (fs:write $path (preq:render $row)))
          ($_ (println! (NATIVE_BENCHMARK $row)))
          ($_ (nq:close $previous)) ($_ (nq:close $candidate)))
     $within))
