; Unit tests of src/rejection_gate_cetta.metta; no Python. The host decides a
; retained rejection; the fast path only says when that decision is needed.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/rejection_gate_cetta.metta)
; The loop's retry wait: a pure function of the record, the time and the
; host's hold, read without the host when no block is possible.
(= (gate-test:record $retry) (JsonObject ((JsonPair "schema" 2) (JsonPair "retry_at" $retry))))
(= (gate-test:retry-wait)
   (let* (($path (path:join (nt:required-env "HOME") "retry-wait.json"))
          ($_ (nt:require repair-waits-zero (nt:equal (gate:wait (gate-test:record 500) 100 repair) 0)))
          ($_ (nt:require block-polls-each-second (nt:equal (gate:wait (gate-test:record 500) 100 blocked) 1)))
          ($_ (nt:require undecided-hold-kept (nt:equal (gate:wait (JsonObject ()) 100 undecided) 1)))
          ($_ (nt:require no-backoff-no-wait (nt:equal (gate:wait (JsonObject ()) 100 none) 0)))
          ($_ (nt:require backoff-rounded-up (nt:equal (gate:wait (gate-test:record 110.25) 100 none) 11)))
          ($_ (nt:require backoff-exact (nt:equal (gate:wait (gate-test:record 110) 100 none) 10)))
          ($_ (nt:require backoff-over (nt:equal (gate:wait (gate-test:record 90.5) 100 none) 0)))
          ($_ (nt:require backoff-not-a-number (nt:equal (gate:wait (gate-test:record "110") 100 none) 0)))
          ($_ (nt:require cleared-block-backs-off (nt:equal (gate:wait (gate-test:record 103.5) 100 clear) 4)))
          ($_ (nt:require missing-record-no-wait (nt:equal (gate:retry-wait-at $path 100) 0)))
          ($_ (fs:write $path "{\"retry_at\": 107.5, \"schema\": 2}"))
          ($_ (nt:require recorded-backoff (nt:equal (gate:retry-wait-at $path 100) 8)))
          ($_ (fs:write $path "{broken"))
          ($_ (nt:require torn-record-no-wait (nt:equal (gate:retry-wait-at $path 100) 0)))
          ; A possible block needs the host. With none to ask, as on this
          ; engine without Python, the hold is kept and so is the latch.
          ($_ (fs:write $path "{\"provider_rejection\": {\"id\": \"x\"}, \"retry_at\": 0}"))
          ($_ (nt:require recorded-block-undecided (nt:equal (gate:retry-wait-at $path 100) 1)))
          ($_ (fs:write $path "{\"retry_at\": 0}"))
          ($_ (gate:latch))
          ($_ (nt:require latched-block-undecided (nt:equal (gate:retry-wait-at $path 100) 1)))
          ($_ (nt:require undecided-keeps-latch (gate:latched?)))
          ($_ (gate:release)))
     True))
!(nt:require rejection-gate-retry-wait (gate-test:retry-wait))
!(let* (($home (nt:required-env "HOME")) ($path (path:join $home "cognitive-health.json"))
        ($_ (nt:require missing-record-holds-no-block (not (gate:recorded? $path))))
        ($_ (fs:write $path "{\"schema\": 2, \"retry_at\": 0}"))
        ($_ (nt:require record-without-block (not (gate:recorded? $path))))
        ($_ (fs:write $path "{\"provider_rejection\": {\"id\": \"x\", \"status\": 400}, \"schema\": 2}"))
        ($_ (nt:require record-with-block (gate:recorded? $path)))
        ($_ (fs:write $path "{\"provider_rejection\": null}"))
        ($_ (nt:require non-object-is-no-block (not (gate:recorded? $path))))
        ($_ (fs:write $path "{\"provider_rejection\": {\"id\": \"x\"}, \"provider_rejection\": 0}"))
        ($_ (nt:require last-occurrence-wins (not (gate:recorded? $path))))
        ($_ (fs:write $path "{broken"))
        ($_ (nt:require unreadable-record-holds-no-block (not (gate:recorded? $path))))
        ($_ (nt:require deterministic-statuses
              (nt:equal (map-atom (400 401 404 405 406 408 410 413 415 422 429 500) $s (gate:invalid-request? $s))
                        (True False True True True False True True True True False False))))
        ($_ (nt:require not-latched-at-start (not (gate:latched?))))
        ($_ (gate:latch)) ($_ (gate:latch))
        ($_ (nt:require latched (gate:latched?)))
        ($_ (nt:require one-latch (nt:equal (size-atom (collapse (match &self (ProviderRejectionLatchV1) x))) 1)))
        ($_ (gate:release))
        ($_ (nt:require released (not (gate:latched?)))))
   (println! UNIT_REJECTION_GATE_OK))
