; Unit tests of src/rejection_gate_cetta.metta; no Python. The host decides a
; retained rejection; the fast path only says when that decision is needed.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/rejection_gate_cetta.metta)
!(let* (($home (nt:required-env "HOME")) ($path (path:join $home "cognitive-health.json"))
        ($_ (nt:require missing-record-holds-no-block (not (gate:recorded? $path))))
        ($_ (fs:write $path "{\"schema\": 2, \"retry_at\": 0}"))
        ($_ (nt:require record-without-block (not (gate:recorded? $path))))
        ($_ (fs:write $path "{\"provider_rejection\": {\"id\": \"x\", \"status\": 400}, \"schema\": 2}"))
        ($_ (nt:require record-with-block (gate:recorded? $path)))
        ($_ (fs:write $path "{\"provider_rejection\": null}"))
        ($_ (nt:require non-object-is-no-block (not (gate:recorded? $path))))
        ($_ (fs:write $path "{\"provider_rejection\": {\"id\": \"x\"}, \"provider_rejection\": 0}"))
        ($_ (nt:require last-occurrence-wins (not (gate:recorded? $path))))
        ($_ (fs:write $path "{broken"))
        ($_ (nt:require unreadable-record-holds-no-block (not (gate:recorded? $path))))
        ($_ (nt:require deterministic-statuses
              (nt:equal (map-atom (400 401 404 405 406 408 410 413 415 422 429 500) $s (gate:invalid-request? $s))
                        (True False True True True False True True True True False False))))
        ($_ (nt:require not-latched-at-start (not (gate:latched?))))
        ($_ (gate:latch)) ($_ (gate:latch))
        ($_ (nt:require latched (gate:latched?)))
        ($_ (nt:require one-latch (nt:equal (size-atom (collapse (match &self (ProviderRejectionLatchV1) x))) 1)))
        ($_ (gate:release))
        ($_ (nt:require released (not (gate:latched?)))))
   (println! UNIT_REJECTION_GATE_OK))
