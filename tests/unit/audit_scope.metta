; A clean native source selection cannot certify active legacy runtime roles.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/state_file_cetta.metta)
!(import! &self (library list))
!(import! &self (library re))
(= (as:run $root)
   (proc:run ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended"
                  "--import-mode" "ancestor-walk" (path:join $root "scripts/audit_native_runtime.metta"))
                  $root inherit 15000 1048576))
!(let* (($root (nt:required-env "TEST_REPOSITORY"))
         ($output (nt:exit-ok (as:run $root)))
         ($report (json:parse-python $output))
         ($inventory (sf:native-object (path:join $root "config/native-migration.json")))
         ($remaining (sf:get (sf:get $inventory "current_batch" JsonNull) "remaining_python_services" JsonNull))
         ($_ (nt:require source-selection-still-checked (== (sf:get $report "native_selection_closed" False) True)))
         ($_ (nt:require declared-runtime-roles-remain-visible (== (sf:get $report "remaining_services" JsonNull) $remaining)))
         ($_ (nt:require source-audit-does-not-claim-installed-inspection (== (sf:get $report "installed_runtime_audited" True) False)))
         ($_ (nt:require restored-python-roles-prevent-whole-runtime-closure
              (== (sf:get $report "statically_closed_runtime" True)
                  (case $remaining (((JsonArray $items) (== $items ())) ($missing False))))))
         ($fixture (path:join (nt:required-env "HOME") "selection")) ($_ (fs:make-directories $fixture 448))
         ($selection (sf:native-object (path:join $root "config/runtime-files.json")))
         ((JsonArray $files) (sf:get $selection "files" JsonNull))
         ($_ (nt:exit-ok (proc:run (list:append ("cp" "--parents" "--") (list:append $files (cons-atom $fixture ())))
                        $root inherit 15000 1048576)))
         ($canary "src/audit_unassigned_cetta.metta")
         ($_ (fs:write (path:join $fixture $canary) "!(py-call arbitrary-host-procedure)\n"))
         ($_ (fs:append-text (path:join $fixture "src/observatory_cetta.metta") "\n!(import! &self ./audit_unassigned_cetta.metta)\n"))
         ($_ (sf:replace (path:join $fixture "config/runtime-files.json")
                (json:stringify-python (sf:put $selection "files" (JsonArray (list:append $files (cons-atom $canary ()))))) 384 True))
         ($rejected (as:run $fixture))
         ($_ (nt:require foreign-call-in-selected-unassigned-import-is-rejected
               (case $rejected (((proc:exited $code $out $_)
                  (and (!= $code 0) (and (nt:contains $out "foreign-call") (nt:contains $out $canary)))) ($bad False)))))
         ($entry (path:join $fixture "scripts/audit_native_runtime.metta")) ($good (fs:read-text $entry))
         ($mutant (re:replace-literal (re:compile "map-atom [$]inspected [$]file") $good "map-atom $runtime $file"))
         ($_ (nt:require coverage-mutant-was-actually-constructed
              (and (== (get-type $mutant) String) (not (nt:contains $mutant "map-atom $inspected $file")))))
         ($_ (fs:write $entry $mutant))
         ($missed (as:run $fixture))
         ($_ (nt:require old-role-only-coverage-misses-the-foreign-module
              (case $missed (((proc:exited 0 $out $_) (nt:contains $out "native_selection_closed")) ($bad False))))))
   (println! UNIT_AUDIT_SCOPE_OK))
