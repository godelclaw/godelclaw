!(import! &self ../native_test_support.metta)
!(import! &self ../../src/memory_monitor_cetta.metta)
(= (mmtest:sample $id $at $bytes)
   (JsonObject ((JsonPair "invocation" $id) (JsonPair "at" $at) (JsonPair "total_bytes" $bytes))))
!(let* (($first (mmtest:sample "one" 0 104857600))
        ($old (JsonObject ((JsonPair "history" (JsonArray ($first))))))
        ($growth (mm:trend $old (mmtest:sample "one" 180 209715200) 180 16 32))
        ($_ (nt:require sustained-growth-is-observed (sf:get $growth "alarm" False)))
        ($restart (mm:trend $old (mmtest:sample "two" 180 209715200) 180 16 32))
        ($_ (nt:require new-invocation-resets-history (== (sf:get $restart "window_seconds" -1) 0)))
        ($_ (nt:require restart-does-not-inherit-alarm (not (sf:get $restart "alarm" True))))
        ($steady (mm:trend $old (mmtest:sample "one" 180 104857600) 180 16 32))
        ($_ (nt:require ram-to-swap-is-not-reclamation (== (sf:get $steady "growth_mib_per_minute" -1) 0)))
        ($missing (mm:observe (JsonObject ((JsonPair "LoadState" "not-found") (JsonPair "ActiveState" "active")))
                       (JsonObject ()) 200 180 16 32))
        ($_ (nt:require unavailable-counter-is-not-zero (sf:get $missing "unavailable" False)))
        ($_ (nt:require active-but-unloadable-service-is-reported (sf:get $missing "restart_unavailable" False))))
   (println! UNIT_NATIVE_MEMORY_MONITOR_OK))
