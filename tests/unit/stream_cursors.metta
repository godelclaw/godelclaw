; Unit tests of src/stream_cursors_cetta.metta and the ledger's result-put; no Python.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/stream_cursors_cetta.metta)

(= (count-cursors $id) (size-atom (collapse (match &self (StreamCursor $id $v) $v))))
(= (count-sequences $id) (size-atom (collapse (match &self (StreamSequence $id $n $t) $n))))
!(nt:require new-cursor-is-fresh (nt:equal (stream:current "a1") (sse:new)))
!(let* (($_ (stream:remember "a1" first)) ($_ (stream:remember "a1" second)))
   (nt:require one-cursor-kept (nt:equal ((count-cursors "a1") (stream:current "a1")) (1 second))))
!(nt:require first-sequence-admitted (nt:equal (stream:sequence "a1" 1 "x") 1))
!(nt:require repeat-is-zero (nt:equal (stream:sequence "a1" 1 "x") 0))
!(nt:require conflict-is-refused (nt:equal (stream:sequence "a1" 1 "y") -1))
!(nt:require newer-replaces (nt:equal ((stream:sequence "a1" 2 "z") (count-sequences "a1")) (1 1)))
!(nt:require stale-is-refused (nt:equal (stream:sequence "a1" 1 "x") -1))
!(let $_ (stream:close "a1")
   (nt:require close-removes-both (nt:equal ((count-cursors "a1") (count-sequences "a1")) (0 0))))
!(let* (($_ (stream:remember "a2" s)) ($_ (stream:sequence "a2" 5 "t")) ($_ (stream:close "a2"))
        ($_ (stream:remember "a2" s2)) ($_ (stream:sequence "a2" 6 "u")) ($_ (stream:close "a2")))
   (nt:require repeated-attempts-leave-nothing (nt:equal ((count-cursors "a2") (count-sequences "a2")) (0 0))))
!(println! UNIT_STREAM_CURSORS_OK)
