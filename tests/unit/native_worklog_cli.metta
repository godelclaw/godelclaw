!(import! &self ../native_test_support.metta)
!(import! &self ../../src/state_file_cetta.metta)
!(import! &self (library list))
(= (wl-test:run $args)
   (let* (($root (nt:required-env "TEST_REPOSITORY")) ($binary (system:executable))
          ($script (path:join $root "scripts/public_worklog_cetta.metta"))
          ($argv (list:append ($binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" $script) $args)))
     (nt:exit-ok (proc:run $argv $root (nt:environment (nt:required-env "HOME")) 5000 65536))))
!(let* (($directory (path:join (nt:required-env "HOME") "curated"))
         ($enabled (json:parse-python (wl-test:run ("--dir" $directory "on"))))
         ($_ (nt:require native-curated-cli-enabled (== (sf:get $enabled "enabled" False) True)))
         ($literal "(system:exit 91) 雪")
         ($added (json:parse-python (wl-test:run ("add" $literal "--dir" $directory))))
         ($_ (nt:require native-curated-cli-accepted (== (sf:get $added "accepted" False) True)))
         ($shown (wl-test:run ("--dir" $directory "show")))
         ($_ (nt:require curated-program-text-is-only-data (nt:contains $shown $literal)))
         ($_ (wl-test:run ("--dir" $directory "off")))
         ($_ (fs:write (path:join $directory "notes.jsonl") "not JSON; disabled history must not be read"))
         ($disabled (wl-test:run ("show" (str:concat "--dir=" $directory))))
         ($_ (nt:require disabled-history-is-not-read (not (nt:contains $disabled "not JSON")))))
   (println! UNIT_NATIVE_WORKLOG_CLI_OK))
