; Native hierarchy conformance. Each case runs its programs on the engine in
; fresh processes against a space service of its own, restarted where the
; case says; every program must finish cleanly with no FAIL or error and
; exactly its count of OK checks.
!(import! &self ../native_test_support.metta)
!(import! &self (library list))

(= (hs:serve $core $dir)
   (let* (($socket (path:join $dir "store.sock"))
          ($_ (if (fs:exists $socket) (fs:remove $socket) True))
          ($server (proc:spawn ((path:join $core "cetta-space-service") "--socket" $socket "--data" (path:join $dir "data"))
                    ((env (nt:environment $dir)) (max-bytes 65536))))
          ($_ (hs:wait $server $socket 500)))
     $server))
(= (hs:wait $server $path $left)
   (if (fs:exists $path) True
     (if (<= $left 0) (let $_ (println! (STORE_NOT_READY $path)) (system:exit 2))
       (let $_ (proc:wait $server 20) (hs:wait $server $path (- $left 1))))))
(= (hs:stop $server) (let* (($_ (proc:cancel $server)) ($_ (proc:await $server)) ($_ (proc:close $server))) True))
(= (hs:header $root $dir)
   (str:join "" ("!(import! &self " (repr (path:join $root "src/hierarchy_store.metta")) ")\n"
                 "(= (sock) " (repr (path:join $dir "store.sock")) ")\n"
                 "(= (store) \"hierarchy\")\n"
                 "(= (expect $label $actual $wanted) (if (== $actual $wanted) (println! (OK $label)) (println! (FAIL $label $actual $wanted))))\n")))
(= (hs:program $root $dir $name $body)
   (let $path (path:join $dir (str:concat $name ".metta"))
     (let $_ (fs:write $path (str:concat (hs:header $root $dir) $body)) $path)))
(= (hs:count $text $needle) (- (size-atom (str:split $needle $text)) 1))
; Run $body; it must succeed with no FAIL or error and, unless $checks is
; none, exactly $checks OK lines.
(= (hs:run $core $root $dir $name $body $checks)
   (let* (($program (hs:program $root $dir $name $body))
          ($out (nt:exit-ok (proc:run ((path:join $core "cetta") "--lang" "petta" $program) $root (nt:environment $dir) 30000 4194304)))
          ($clean (and (not (nt:contains $out "(FAIL ")) (not (nt:contains $out "(Error "))))
          ($counted (if (== $checks none) True (== (hs:count $out "(OK ") $checks)))
          ($_ (if (and $clean $counted) True (println! (HIERARCHY_RUN_FAILED $name $out)))))
     (if (and $clean $counted) $out (HierarchyRunFailed $name))))
(= (hs:ok $result) (not (== (get-metatype $result) Expression)))
(= (hs:case $core $root $name) (let $dir (path:join (nt:required-env "HOME") $name) (let $_ (fs:make-directories $dir 448) $dir)))
(= (hs:seed) "
!(hm:put (sock) (store) \"e\" episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\")))
!(hm:put (sock) (store) \"t\" task \"Task\" \"Original objective\" (\"e\") ())
!(hm:put (sock) (store) \"p\" project \"Project\" \"Overview\" (\"t\") ())
")

(= (hs:expand $core $root)
   (let* (($dir (hs:case $core $root "expand")) ($server (hs:serve $core $dir))
          ($out (hs:run $core $root $dir "expand" (str:concat (hs:seed) "
!(hm:summarize (sock) (store) \"t\" \"summary omits the detail\")
!(println! (EXPANDED (hm:expand (sock) (store) \"p\" 2)))
!(expect raw-search (hm:search (sock) (store) \"needle\" \"p\")
   ((HHit \"e\" 1 episode \"Evidence\" source (HOverview absent \"\" ()))))") 1))
          ($_ (hs:stop $server)))
     (and (hs:ok $out)
          (and (nt:contains $out "(HMemory \"p\"") (and (nt:contains $out "(HMemory \"t\"") (and (nt:contains $out "(HMemory \"e\"")
          (and (nt:contains $out "\"original needle Ω\"") (nt:contains $out "HOverview fresh \"summary omits the detail\""))))))))

(= (hs:correction $core $root)
   (let* (($dir (hs:case $core $root "correction")) ($server (hs:serve $core $dir))
          ($out (hs:run $core $root $dir "correction" (str:concat (hs:seed) "
!(hm:summarize (sock) (store) \"t\" \"First task interpretation\")
!(hm:summarize (sock) (store) \"p\" \"First project interpretation\")
!(hm:put (sock) (store) \"e\" episode \"Evidence\" \"corrected value\" () ((External \"file-v2\")))
!(case (hm:expand (sock) (store) \"p\" 0)
   (((HMemory $id $r $k $t $body (HOverview stale $text $stamp) $ss $cs) (println! (OK stale)))
    ($other (println! (FAIL stale $other)))))
!(expect original (hm:history (sock) (store) \"e\" 1)
   (HOriginal \"e\" 1 episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\"))))
!(expect corrected (hm:history (sock) (store) \"e\" 2)
   (HOriginal \"e\" 2 episode \"Evidence\" \"corrected value\" () ((External \"file-v2\"))))") 3))
          ($_ (hs:stop $server)))
     (hs:ok $out)))

(= (hs:dependencies $core $root)
   (let* (($dir (hs:case $core $root "dependencies")) ($server (hs:serve $core $dir))
          ($out (hs:run $core $root $dir "dependencies" (str:concat (hs:seed) "
!(hm:summarize (sock) (store) \"t\" \"First task summary\")
!(hm:summarize (sock) (store) \"p\" \"Project summary\")
!(hm:summarize (sock) (store) \"t\" \"Revised task interpretation\")
!(case (hm:expand (sock) (store) \"p\" 0)
   (((HMemory $id $r $k $t $b (HOverview stale $text $refs) $ss $cs) (println! (OK child-summary)))
    ($other (println! (FAIL child-summary $other)))))
!(case (hm:expand (sock) (store) \"t\" 0)
   (((HMemory $id $r $k $t $b (HOverview fresh $text $refs) $ss $cs) (println! (OK own-summary)))
    ($other (println! (FAIL own-summary $other)))))
!(hm:summarize (sock) (store) \"p\" \"Updated project summary\")
!(hm:put (sock) (store) \"extra\" episode \"Extra\" \"More evidence\" () ())
!(hm:link (sock) (store) \"t\" \"extra\")
!(case (hm:expand (sock) (store) \"p\" 0)
   (((HMemory $id $r $k $t $b (HOverview stale $text $refs) $ss $cs) (println! (OK membership)))
    ($other (println! (FAIL membership $other)))))") 3))
          ($_ (hs:stop $server)))
     (hs:ok $out)))

(= (hs:duplicates $core $root)
   (let* (($dir (hs:case $core $root "duplicates")) ($server (hs:serve $core $dir))
          ($out (hs:run $core $root $dir "duplicates" (str:concat (hs:seed) "
!(expect duplicate (hm:put (sock) (store) \"e\" episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\")))
   (HStored \"e\" 1 unchanged))
!(expect cycle (hm:link (sock) (store) \"e\" \"p\") (HFailure cycle \"e\"))
!(expect dangling (hm:link (sock) (store) \"t\" \"missing\") (HFailure missing-node \"missing\"))
!(expect preserved (hm:history (sock) (store) \"e\" 1)
   (HOriginal \"e\" 1 episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\"))))") 4))
          ($_ (hs:stop $server)))
     (hs:ok $out)))

(= (hs:restart $core $root)
   (let* (($dir (hs:case $core $root "restart")) ($server (hs:serve $core $dir))
          ($first (hs:run $core $root $dir "restart-1" (str:concat (hs:seed) "!(hm:summarize (sock) (store) \"p\" \"Remember this project\")\n") none))
          ($_ (hs:stop $server)) ($again (hs:serve $core $dir))
          ($second (hs:run $core $root $dir "restart-2" "
!(expect original (hm:history (sock) (store) \"e\" 1)
   (HOriginal \"e\" 1 episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\"))))
!(case (hm:expand (sock) (store) \"p\" 2)
   (((HMemory $id $r $k $t $body (HOverview fresh \"Remember this project\" $refs) $ss $cs) (println! (OK restart)))
    ($other (println! (FAIL restart $other)))))" 2))
          ($_ (hs:stop $again)))
     (and (hs:ok $first) (hs:ok $second))))

(= (hs:bodies $core $root)
   (let* (($dir (hs:case $core $root "bodies")) ($server (hs:serve $core $dir))
          ($text (repr (str:join "" ((str:join "" (list:repeat 4000 "α")) "\n" (str:join "" (list:repeat 1000 "x"))))))
          ($out (hs:run $core $root $dir "bodies" (str:join "" ("
!(hm:put (sock) (store) \"empty\" episode \"Empty\" \"\" () ())
!(hm:put (sock) (store) \"long\" episode \"Long\" " $text " () ())
!(hm:put (sock) (store) \"a\" task \"A\" \"\" (\"long\") ())
!(hm:put (sock) (store) \"b\" task \"B\" \"\" (\"long\") ())
!(hm:put (sock) (store) \"root\" project \"Root\" \"\" (\"a\" \"b\") ())
!(expect empty (hm:history (sock) (store) \"empty\" 1) (HOriginal \"empty\" 1 episode \"Empty\" \"\" () ()))
!(expect long (hm:history (sock) (store) \"long\" 1) (HOriginal \"long\" 1 episode \"Long\" " $text " () ()))
!(let (HView $space $nodes) (hm:snapshot (sock) (store))
   (let $stamp (hm:stamp $nodes \"root\") (expect unique (size-atom $stamp) 7)))")) 3))
          ($_ (hs:stop $server)))
     (hs:ok $out)))

(= (hs:missing $core $root)
   (let* (($dir (hs:case $core $root "missing"))
          ($out (hs:run $core $root $dir "missing" "
!(case (hm:expand \"/nonexistent/native-memory.sock\" \"test\" \"missing\" 1)
   (((space:unavailable $id $reason) (println! (OK unavailable)))
    ($other (println! (FAIL unavailable $other)))))" 1)))
     (hs:ok $out)))

(= (hs:unrelated $core $root)
   (let* (($dir (hs:case $core $root "unrelated")) ($server (hs:serve $core $dir))
          ($out (hs:run $core $root $dir "unrelated" (str:concat (hs:seed) "
!(hm:summarize (sock) (store) \"p\" \"Project interpretation\")
!(hm:put (sock) (store) \"unrelated\" episode \"Other\" \"Elsewhere\" () ())
!(case (hm:expand (sock) (store) \"p\" 0)
   (((HMemory $id $r $k $t $b (HOverview fresh $text $refs) $ss $cs) (println! (OK unrelated)))
    ($other (println! (FAIL unrelated $other)))))
!(hm:put (sock) (store) \"t\" task \"Task\" \"Original objective\" () ())
!(case (hm:expand (sock) (store) \"p\" 0)
   (((HMemory $id $r $k $t $b (HOverview stale $text $refs) $ss $cs) (println! (OK removed)))
    ($other (println! (FAIL removed $other)))))
!(expect source-retained (hm:history (sock) (store) \"e\" 1)
   (HOriginal \"e\" 1 episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\"))))") 3))
          ($_ (hs:stop $server)))
     (hs:ok $out)))

; Two engines record into one project at once; capture keeps every task.
(= (hs:records $name)
   (str:join "" (map-atom (0 1 2 3 4 5 6 7) $i
     (str:join "" ("!(hm:record (sock) (store) \"p\" \"task-" $name "\" \"" $name "-" (repr $i) "\" \"turn\" \"original " $name "\" \"parallel evidence\")\n")))))
(= (hs:actor $core $root $dir $name)
   (proc:spawn ((path:join $core "cetta") "--lang" "petta" (hs:program $root $dir (str:concat "actor-" $name) (hs:records $name)))
               ((cwd $root) (env (nt:environment $dir)) (max-bytes 4194304) (timeout-ms 60000))))
(= (hs:captured $result)
   (case $result (((proc:result (proc:exited 0) proc:normal $out $err $capture) (nt:contains $out "captured")) ($other False))))
(= (hs:concurrent $core $root)
   (let* (($dir (hs:case $core $root "concurrent")) ($server (hs:serve $core $dir))
          ($setup (hs:run $core $root $dir "concurrent-setup" "!(hm:put (sock) (store) \"p\" project \"Project\" \"\" () ())\n" none))
          ($a (hs:actor $core $root $dir "a")) ($b (hs:actor $core $root $dir "b"))
          ($_ (proc:close-input $a)) ($_ (proc:close-input $b))
          ($ra (proc:await $a)) ($rb (proc:await $b)) ($_ (proc:close $a)) ($_ (proc:close $b))
          ($check (hs:run $core $root $dir "concurrent-check" "
!(let $hits (hm:search (sock) (store) \"parallel evidence\" \"p\")
   (expect all-episodes (size-atom $hits) 16))
!(case (hm:context (sock) (store) \"p\")
   (((HContext $id $r $k $t $ov $children) (expect both-tasks (size-atom $children) 2))
    ($other (println! (FAIL both-tasks $other)))))" 2))
          ($_ (hs:stop $server)))
     (and (hs:ok $setup) (and (hs:captured $ra) (and (hs:captured $rb) (hs:ok $check))))))

(= (hs:compaction $core $root)
   (let* (($dir (hs:case $core $root "compaction")) ($server (hs:serve $core $dir))
          ($first (hs:run $core $root $dir "compaction-1" (str:concat (hs:seed) "
!(hm:put (sock) (store) \"e\" episode \"Evidence\" \"corrected\" () ())
!(let* (((space $uuid $id $name $backend $kind $rev $count) (hm:open (sock) (store)))
         ($rid (space:request-id))
         ($first (space:call (sock) (request $rid compact $uuid) 5000))
         ($again (space:call (sock) (request $rid compact $uuid) 5000)))
   (progn
     (expect compact $first (reply $rid ok compacted))
     (expect repeat-compact $again $first)))
!(expect original-before-restart (hm:history (sock) (store) \"e\" 1)
   (HOriginal \"e\" 1 episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\"))))
!(expect revised-before-restart (hm:history (sock) (store) \"e\" 2)
   (HOriginal \"e\" 2 episode \"Evidence\" \"corrected\" () ()))") 4))
          ($_ (hs:stop $server)) ($again (hs:serve $core $dir))
          ($second (hs:run $core $root $dir "compaction-2" "
!(expect original (hm:history (sock) (store) \"e\" 1)
   (HOriginal \"e\" 1 episode \"Evidence\" \"original needle Ω\" () ((External \"file-v1\"))))
!(expect revised (hm:history (sock) (store) \"e\" 2)
   (HOriginal \"e\" 2 episode \"Evidence\" \"corrected\" () ()))" 2))
          ($_ (hs:stop $again)))
     (and (hs:ok $first) (hs:ok $second))))

(= (hs:retirement $core $root)
   (let* (($dir (hs:case $core $root "retirement")) ($server (hs:serve $core $dir))
          ($first (hs:run $core $root $dir "retirement-1" (str:concat (hs:seed) "
!(hm:summarize (sock) (store) \"p\" \"Project summary\")
!(hm:retire (sock) (store) \"t\" \"obsolete interpretation\")
!(expect inactive (hm:context (sock) (store) \"t\") (HInactive \"t\" \"obsolete interpretation\"))
!(expect hidden (hm:search (sock) (store) \"Original objective\" \"\") ())
!(expect evidence (hm:history (sock) (store) \"t\" 1)
   (HOriginal \"t\" 1 task \"Task\" \"Original objective\" (\"e\") ()))
!(case (hm:context (sock) (store) \"p\")
   (((HContext \"p\" $r $k $title (HOverview stale $text $refs) ()) (println! (OK parent-stale)))
    ($other (println! (FAIL parent-stale $other)))))
!(hm:record (sock) (store) \"p\" \"t\" \"later\" \"later turn\" \"input\" \"later evidence\")
!(expect remains-inactive (hm:context (sock) (store) \"t\") (HInactive \"t\" \"obsolete interpretation\"))") 5))
          ($_ (hs:stop $server)) ($again (hs:serve $core $dir))
          ($second (hs:run $core $root $dir "retirement-2" "
!(expect restart-inactive (hm:context (sock) (store) \"t\") (HInactive \"t\" \"obsolete interpretation\"))
!(expect restart-hidden (hm:search (sock) (store) \"Original objective\" \"\") ())
!(hm:put (sock) (store) \"t\" task \"Task\" \"chosen revision\" (\"e\") ())
!(case (hm:context (sock) (store) \"t\")
   (((HContext \"t\" $r task $title $overview $children) (println! (OK reactivated)))
    ($other (println! (FAIL reactivated $other)))))" 3))
          ($_ (hs:stop $again)))
     (and (hs:ok $first) (hs:ok $second))))

!(let* (($core (nt:required-env "NATIVE_TEST_CORE")) ($root (nt:required-env "TEST_REPOSITORY"))
         ($_ (nt:require expand-and-raw-search-survive-summary-omission (hs:expand $core $root)))
         ($_ (nt:require a-correction-keeps-the-original-and-invalidates-ancestors (hs:correction $core $root)))
         ($_ (nt:require membership-and-child-summaries-are-dependencies (hs:dependencies $core $root)))
         ($_ (nt:require duplicate-delivery-is-idempotent-and-cycles-explicit (hs:duplicates $core $root)))
         ($_ (nt:require a-restart-restores-versions-and-hierarchy (hs:restart $core $root)))
         ($_ (nt:require empty-long-unicode-bodies-and-shared-children (hs:bodies $core $root)))
         ($_ (nt:require a-missing-store-is-a-failure-not-empty-recall (hs:missing $core $root)))
         ($_ (nt:require unrelated-changes-stay-fresh-and-removal-is-stale (hs:unrelated $core $root)))
         ($_ (nt:require atomic-capture-keeps-concurrent-task-membership (hs:concurrent $core $root)))
         ($_ (nt:require checkpoint-compaction-keeps-recoverable-originals (hs:compaction $core $root)))
         ($_ (nt:require retirement-excludes-recall-and-survives-capture-and-restart (hs:retirement $core $root))))
   (println! UNIT_HIERARCHY_STORE_OK))
