; Turn ownership and checkpoint scope over a real native ledger.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/strategy_broker_cetta.metta)
!(import! &self ../../src/strategy_attempts_cetta.metta)
!(import! &self ../../src/turn_health_cetta.metta)
(= (tg:get $key $default) (if (== $key reply-chat) "unit-chat" $default))
(= (tg:reply-target $chat) (if (== $chat "") "unit-chat" $chat))
(= (tf:ready $server $socket $remaining)
   (if (fs:exists $socket) True
     (if (== $remaining 0) False
       (let $_ (proc:wait $server 20) (tf:ready $server $socket (- $remaining 1))))))
!(let* (($home (nt:required-env "HOME")) ($root (system:cwd))
        ($socket (path:join $home "l.sock")) ($store (path:join $home "store"))
        ($worker (path:join (nt:required-env "NATIVE_TEST_CORE") "cetta-value-worker"))
        ($module (path:join $root "src/input_ledger_server.metta"))
        ($environment (cons-atom ("CETTA_DB_SOURCE" $store) (cons-atom ("CETTA_DB_SOCKET" $socket) (nt:environment $home))))
        ($server (proc:spawn ($worker "--value-bytes" "268435456" "--serve" "--lang" "petta" $module "db-server:configuration")
                             ((cwd $root) (env $environment) (max-bytes 65536) (lifetime owner))))
        ($_ (nt:require ledger-ready (tf:ready $server $socket 500)))
        ($_ (lifecycle-native:start))
        ($_ (nt:require begins-with-transport-ids (nt:equal (turn:begin 1 "operator-event" "do a task" "[\"tg:one\",\"mail:two\"]") 1)))
        ($focus (turn:focus))
        ($_ (input-scope:prepare ("later-delivery")))
        ($_ (nt:require checkpoint-keeps-original-capture
              (nt:equal (turn:commit-scope 1) (("mail:two" "tg:one") $focus))))
        ($_ (turn:context-presented "[]"))
        ($_ (turn:context-prepared (str:sha256 "the actual prompt") 0))
        ($_ (nt:require capture-ready (nt:equal (turn:capture "the actual prompt" 0) 1)))
        ($_ (nt:require exact-prompt-receipt-retained (nt:equal (turn:get "context-incomplete" 1) 0)))
        ($turn (turn:broker-turn 1))
        (($admitted $ticket) (turn:broker-begin $turn (quote ((nop))) 1))
        ($_ (nt:require proposal-admitted (and (nt:equal $admitted 1) (!= $ticket ""))))
        ($_ (strategy:open-batch $turn $ticket))
        ($_ (nt:require attempt-reserved (nt:equal (strategy:reserve $turn (quote (nop))) 1)))
        ($_ (nt:require result-recorded (nt:equal (turn:command-result $turn returned (nop) "done" 0) 1)))
        ($_ (turn:broker-end $turn (quote ((COMMAND_RETURN: ((nop) "done"))))))
        ($_ (nt:require recorded-phase (nt:equal (turn:get "phase" "") "reported")))
        ($_ (strategy:close-batch))
        ; A post-report hook fault propagates out of turn:broker-end after turn:report saves the receipt.
        ($_ (nt:require begin-second-turn (nt:equal (turn:begin 2 "continuation-tick" "" "[]") 1)))
        ($_ (turn:context-presented "[]"))
        ($_ (turn:context-prepared (str:sha256 "second prompt") 0))
        ($_ (nt:require capture-second (nt:equal (turn:capture "second prompt" 0) 1)))
        ($turn2 (turn:broker-turn 2))
        (($admitted2 $ticket2) (turn:broker-begin $turn2 (quote ((nop))) 1))
        ($_ (nt:require second-proposal-admitted (and (nt:equal $admitted2 1) (!= $ticket2 ""))))
        ($_ (strategy:open-batch $turn2 $ticket2))
        ($_ (nt:require second-attempt-reserved (nt:equal (strategy:reserve $turn2 (quote (nop))) 1)))
        ($_ (nt:require second-result-recorded (nt:equal (turn:command-result $turn2 returned (nop) "done-2" 0) 1)))
        ($_ (collapse (match &self (= (turn:after-broker-report $t $k) $body)
               (remove-atom &self (= (turn:after-broker-report $t $k) $body)))))
        ($_ (add-atom &self (= (turn:after-broker-report $t $k) (Error turn:broker-end forced-after-result))))
        ($faulted (turn:broker-end $turn2 (quote ((COMMAND_RETURN: ((nop) "done-2"))))))
        ($_ (nt:require broker-end-propagates-post-report-fault
              (nt:equal $faulted (Error turn:broker-end forced-after-result))))
        ($_ (nt:require post-report-fault-kept-receipt-saved
              (case (state:ledger "actions" ((ticket $ticket2)))
                ((((action $_ $_ $_ $_ $_ "returned" $_ $_ $_)) True) ($other False)))))
        ($_ (collapse (match &self (= (turn:after-broker-report $t $k) $body)
               (remove-atom &self (= (turn:after-broker-report $t $k) $body)))))
        ($_ (add-atom &self (= (turn:after-broker-report $t $k) True)))
        ($_ (strategy:close-batch))
        ($_ (turn:clear))
        ($_ (nt:require restores-native-owner (nt:equal (turn:boot) True)))
        ($_ (nt:require request-survives-restart
              (nt:contains (turn:request-read $focus 0) "do a task")))
        ($pending (JsonObject ((JsonPair "schema" 2) (JsonPair "pending_since" 1700000000)
            (JsonPair "in_flight_since" 0) (JsonPair "obligation_since" 0)
            (JsonPair "local_failure_count" 2) (JsonPair "last_outcome" "pending"))))
        ($_ (sf:replace (health:path) (sf:python-json $pending) 384 True))
        ($_ (nt:require ordinary-host-fault-reconciles-before-reporting (== (turn:fault) 1)))
        ($failed (health:read))
        ($_ (nt:require host-fault-updates-durable-health
             (and (== (sf:get $failed "local_failure_count" 0) 3)
               (and (== (sf:get $failed "last_failure_type" "") "host-transition-error")
                 (and (== (sf:get $failed "pending_since" -1) 0)
                      (== (sf:get $failed "obligation_since" 0) 1700000000))))))
        ($_ (sf:replace (health:path) (sf:python-json $pending) 384 True))
        ($flag (system:getenv-or-default "METTACLAW_RECYCLE_REQUEST_PATH" ""))
        ($_ (fs:write $flag "recycle at a captured boundary\n"))
        ($_ (nt:require requested-recycle-is-not-a-host-failure (== (turn:fault) 1)))
        ($_ (nt:require recycle-leaves-durable-health-unchanged (== (fs:read-text (health:path)) (sf:python-json $pending))))
        ($_ (fs:remove $flag))
        ($_ (fs:rename (health:path) (str:concat (health:path) ".saved")))
        ($_ (fs:make-directories (health:path) 448))
        ($_ (nt:require refused-health-publication-is-explicit
              (case (catch (turn:fault)) (((Error turn:fault health-publication-unavailable) True) ($bad False)))))
        ($_ (fs:rename (health:path) (str:concat (health:path) ".blocked-directory")))
        ($_ (fs:rename (str:concat (health:path) ".saved") (health:path)))
        ($_ (proc:cancel $server)) ($_ (proc:wait $server 5000))
        ($_ (nt:require unavailable-recovery-does-not-claim-a-completed-host-fault
              (case (catch (turn:fault)) (((Error turn:fault $_) True) ($bad False)))))
        ($_ (nt:require failed-ledger-recovery-preserves-health (== (fs:read-text (health:path)) (sf:python-json $pending)))))
   (println! UNIT_NATIVE_TURN_FRAME_OK))
