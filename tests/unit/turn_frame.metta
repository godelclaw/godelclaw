; Turn ownership and checkpoint scope over a real native ledger.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/strategy_broker_cetta.metta)
!(import! &self ../../src/strategy_attempts_cetta.metta)
(= (tg:get $key $default) (if (== $key reply-chat) "unit-chat" $default))
(= (tg:reply-target $chat) (if (== $chat "") "unit-chat" $chat))
(= (tf:ready $server $socket $remaining)
   (if (fs:exists $socket) True
     (if (== $remaining 0) False
       (let $_ (proc:wait $server 20) (tf:ready $server $socket (- $remaining 1))))))
!(let* (($home (nt:required-env "HOME")) ($root (system:cwd))
        ($socket (path:join $home "l.sock")) ($store (path:join $home "store"))
        ($worker (path:join (nt:required-env "NATIVE_TEST_CORE") "cetta-value-worker"))
        ($module (path:join $root "src/input_ledger_server.metta"))
        ($environment (cons-atom ("CETTA_DB_SOURCE" $store) (cons-atom ("CETTA_DB_SOCKET" $socket) (nt:environment $home))))
        ($server (proc:spawn ($worker "--value-bytes" "268435456" "--serve" "--lang" "petta" $module "db-server:configuration")
                             ((cwd $root) (env $environment) (max-bytes 65536))))
        ($_ (nt:require ledger-ready (tf:ready $server $socket 500)))
        ($_ (lifecycle-native:start))
        ($_ (nt:require begins-with-transport-ids (nt:equal (turn:begin 1 "operator-event" "do a task" "[\"tg:one\",\"mail:two\"]") 1)))
        ($focus (turn:focus))
        ($_ (input-scope:prepare ("later-delivery")))
        ($_ (nt:require checkpoint-keeps-original-capture
              (nt:equal (turn:commit-scope 1) (("mail:two" "tg:one") $focus))))
        ($_ (turn:context-presented "[]"))
        ($_ (turn:context-prepared (str:sha256 "the actual prompt") 0))
        ($_ (nt:require capture-ready (nt:equal (turn:capture "the actual prompt" 0) 1)))
        ($_ (nt:require exact-prompt-receipt-retained (nt:equal (turn:get "context-incomplete" 1) 0)))
        ($turn (turn:broker-turn 1))
        (($admitted $ticket) (turn:broker-begin $turn (quote ((nop))) 1))
        ($_ (nt:require proposal-admitted (and (nt:equal $admitted 1) (!= $ticket ""))))
        ($_ (strategy:open-batch $turn $ticket))
        ($_ (nt:require attempt-reserved (nt:equal (strategy:reserve $turn (quote (nop))) 1)))
        ($_ (nt:require result-recorded (nt:equal (turn:command-result $turn returned (nop) "done" 0) 1)))
        ($_ (turn:broker-end $turn (quote ((COMMAND_RETURN: ((nop) "done"))))))
        ($_ (nt:require recorded-phase (nt:equal (turn:get "phase" "") "reported")))
        ($_ (strategy:close-batch))
        ($_ (turn:clear))
        ($_ (nt:require restores-native-owner (nt:equal (turn:boot) True)))
        ($_ (nt:require request-survives-restart
              (nt:contains (turn:request-read $focus 0) "do a task")))
        ($_ (proc:cancel $server)) ($_ (proc:wait $server 5000)))
   (println! UNIT_NATIVE_TURN_FRAME_OK))
