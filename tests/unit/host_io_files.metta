!(import! &self ../native_test_support.metta)
!(import! &self (library host_io))
!(import! &self (library list))
(= (hif:failed? $v) (case $v (((HostFailure $_ $_ $_) True) ($other False))))
(= (hif:json)
   (let* (($path (path:join (nt:required-env "HOME") "json.bin"))
          ($_ (fs:write $path "{\"x\":[null,true,1.2e-3,\"雪\"],\"x\":NaN}"))
          ($_ (nt:require valid-streamed-json (case (host:json-file $path) (((HostJsonValid $bytes) (> $bytes 30)) ($bad False)))))
          ($_ (hif:reject $path ("" "[1,]" "{\"x\":}" "{\"x\":0,}" "[01]" "1 2" "[.2]" "\"a\n\"" "\"\\u0x00\"" "truex")))
          ($large (str:join "" (map-atom (list:range 0 20000) $_ "[0],")))
          ($_ (fs:write $path (str:join "" ("[" $large "[0]]"))))
          ($_ (nt:require large-stream-without-materialization (case (host:json-file $path) (((HostJsonValid $bytes) (> $bytes 60000)) ($bad False)))))) True))
(= (hif:reject $path $cases)
   (if (== $cases ()) True
     (let* (($_ (fs:write $path (car-atom $cases)))
            ($_ (nt:require malformed-json-is-refused (hif:failed? (host:json-file $path)))))
       (hif:reject $path (cdr-atom $cases)))))
(= (hif:credentials)
   (let* (($path (path:join (nt:required-env "HOME") "dummy-binding"))
          ($_ (fs:write $path " \nfixture-only-value\t\n"))
          ($options ((env (("PATH" "/usr/bin:/bin") ("FIXTURE_BINDING" "old")))
                     (credential-files (("FIXTURE_BINDING" $path))) (timeout-ms 1000) (max-bytes 1024)))
          ($result (proc:run ("/usr/bin/printenv" "FIXTURE_BINDING") $options))
          ($_ (nt:require host-only-child-binding (case $result
            (((proc:result (proc:exited 0) $_ "fixture-only-value\n" $_ $_) True) ($bad False)))))
          ($_ (nt:require binding-does-not-mutate-parent (== (system:getenv-or-default "FIXTURE_BINDING" "absent") "absent")))
          ($_ (fs:write $path (str:from-python-codepoints (0))))
          ($bad (proc:spawn ("/usr/bin/printenv" "FIXTURE_BINDING") $options))
          ($_ (nt:require invalid-binding-refuses-before-child (case $bad (((proc:failed $_ $_) True) ($other False)))))) True))
!(nt:require streamed-json-controls (hif:json))
!(nt:require child-credential-controls (hif:credentials))
!(println! UNIT_NATIVE_HOST_FILES_OK)
