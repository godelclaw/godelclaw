; Exercise the actual native JSON viewer, not just the curated-note CLI.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/state_file_cetta.metta)
(= (vs:event $epoch $session $parent $sequence $text)
   (str:concat (json:stringify-python (JsonObject
     ((JsonPair "schema" 1) (JsonPair "epoch" $epoch) (JsonPair "session" $session)
      (JsonPair "parent_session" $parent) (JsonPair "producer" "fixture")
      (JsonPair "sequence" $sequence) (JsonPair "kind" "text.delta") (JsonPair "channel" "commentary")
      (JsonPair "attempt" "attempt") (JsonPair "item" "text") (JsonPair "text" $text)))) "\n"))
(= (vs:read $directory)
   (nt:exit-ok (proc:run ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended"
         "--import-mode" "ancestor-walk" (path:join (nt:required-env "TEST_REPOSITORY") "scripts/worklog_view_cetta.metta")
         "--dir" $directory "--session" "godel" "--once" "--json" "--full")
      (system:getcwd) inherit 10000 1048576)))
!(let* (($directory (path:join (nt:required-env "HOME") "display"))
         ($made (fs:make-directories $directory 448))
         ($control (path:join $directory "control.json")) ($stream (path:join $directory "fixture.jsonl"))
         ($enabled (sf:replace $control "{\"enabled\":true,\"epoch\":\"current\"}" 384 True))
         ($saved (fs:write $stream (str:join ""
            ((vs:event "prior" "godel" "" 1 "PRIOR_PRIVATE")
             (vs:event "current" "godel" "" 2 "VISIBLE_CURRENT")
             (vs:event "current" "other" "" 3 "OTHER_SESSION")
             (vs:event "current" "child" "godel" 4 "VISIBLE_CHILD")))))
         ($current (vs:read $directory))
         ($a (nt:require current-epoch-is-visible (nt:contains $current "VISIBLE_CURRENT")))
         ($b (nt:require child-session-remains-visible (nt:contains $current "VISIBLE_CHILD")))
         ($c (nt:require prior-epoch-is-not-disclosed (not (nt:contains $current "PRIOR_PRIVATE"))))
         ($d (nt:require unrelated-session-is-not-disclosed (not (nt:contains $current "OTHER_SESSION"))))
         ($off (sf:replace $control "{\"enabled\":false,\"epoch\":\"current\"}" 384 True))
         ($disabled (vs:read $directory))
         ($e (nt:require disabled-display-produces-no-json (== $disabled "")))
         ($fresh-control (sf:replace $control "{\"enabled\":true,\"epoch\":\"fresh\"}" 384 True))
         ($fresh-record (fs:append-text $stream (vs:event "fresh" "godel" "" 5 "FRESH_ONLY")))
         ($fresh (vs:read $directory))
         ($f (nt:require reenabling-with-new-epoch-publishes-new-record (nt:contains $fresh "FRESH_ONLY")))
         ($g (nt:require reenabling-does-not-republish-previous-epoch
             (and (not (nt:contains $fresh "VISIBLE_CURRENT")) (not (nt:contains $fresh "PRIOR_PRIVATE"))))))
   (println! UNIT_VIEWER_SCOPE_OK))
