!(import! &self (library lib_prolog))
!(import! &self (library list))
!(import! &self ../native_test_support.metta)
!(let* (($root (system:getcwd)) ($directory (nt:required-env "NATIVE_COMPONENT_CASE"))
        ($_ (fs:make-directories (path:join $directory "tools") 448))
        ($_ (fs:make-directories (path:join $directory "transformations") 448))
        ($_ (map-atom ("send" "shell" "python" "nop") $name
          (fs:write (path:join (path:join $directory "tools") (str:concat $name ".metta"))
            (fs:read-text (path:join (path:join $root "modes/iter/templates") (str:concat $name ".metta"))))))
        ($engine (nt:required-env "NATIVE_CORE_BIN"))
        ($environment (list:append (nt:environment $directory)
          (("CETTA_BIN" $engine) ("METTACLAW_RUNTIME_ROOT" $root)
           ("METTACLAW_MODE_RUNTIME" $directory) ("METTACLAW_MODE_PROFILE" "standalone")
           ("METTACLAW_ACTIVE_LOOP_MODE" "iter") ("METTACLAW_TOOL_OUTPUT_DIR" (path:join $directory "artifacts")))))
        ($result (proc:run ($engine "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" "--quiet"
                    (path:join $root "tests/unit/native_components_case.metta")) $directory $environment 30000 1048576))
        ($_ (fs:write (path:join $directory "case.log") (repr $result)))
        ($output (nt:exit-ok $result))
        ($_ (nt:require native-component-case-executed (nt:contains $output "UNIT_NATIVE_COMPONENTS_OK"))))
   (println! UNIT_NATIVE_COMPONENT_DRIVER_OK))
