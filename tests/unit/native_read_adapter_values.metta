!(import! &self ../native_test_support.metta)
!(import! &self ../../src/state_file_cetta.metta)
(= (ra:run $name $input)
   (let* (($request (path:join (nt:required-env "HOME") "request.json"))
          ($saved (fs:write $request (json:stringify-python $input)))
          ($entry (path:join (nt:required-env "TEST_REPOSITORY") "scripts/gateway_read_cetta.metta")))
     (proc:run ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended"
                "--import-mode" "ancestor-walk" $entry $name $request)
               (system:getcwd) inherit 10000 1048576)))
(= (ra:value $result)
   (let $text (nt:exit-ok $result)
     (let $parsed (json:parse-python $text)
       (progn (nt:require successful-adapter-return-has-a-json-object
                (case $parsed (((JsonObject $_) True) ($bad False))))
              (sf:get $parsed "value" JsonNull)))))
(= (ra:window $path $start $count)
   (ra:value (ra:run "read-lines" (JsonObject ((JsonPair "path" $path)
                            (JsonPair "start" $start) (JsonPair "count" $count))))))
!(let* (($home (nt:required-env "HOME")) ($file (path:join $home "lines"))
         ($saved (fs:write $file "alpha\nbeta\n"))
         ($first (str:concat $file ": showing 1-1; next start 2\n    1\talpha"))
         ($second (str:concat $file ": showing 2-2; end of file\n    2\tbeta"))
         ($a (nt:require json-true-retains-python-int-behavior (== (ra:window $file True True) $first)))
         ($b (nt:require json-false-retains-zero-clamping (== (ra:window $file False False) $first)))
         ($c (nt:require numeric-string-windows-still-work (== (ra:window $file "2" "1") $second)))
         ($d (nt:require numeric-fraction-windows-still-truncate (== (ra:window $file 1.9 1.9) $first)))
         ($empty (path:join $home "empty")) ($created (fs:write $empty ""))
         ($e (nt:require empty-file-is-one-explicit-result
              (nt:contains (ra:window $empty 1 1) "READ_OK_EMPTY_FILE:")))
         ($missing (ra:window (path:join $home "missing") 1 1))
         ($f (nt:require ordinary-error-shaped-text-remains-data (nt:contains $missing "read-lines failed:")))
         ($invalid (ra:run "read-lines" (JsonObject ((JsonPair "path" $file)
                              (JsonPair "start" (JsonArray ())) (JsonPair "count" 1)))))
         ($g (nt:require unestablished-evaluation-cannot-exit-as-empty-success
              (case $invalid (((proc:exited $code $out $err) (and (!= $code 0) (!= $err ""))) ($bad False)))))
         ($tree (path:join $home "tree")) ($sub (path:join $tree "sub"))
         ($made (fs:make-directories $sub 448)) ($nested (fs:write (path:join $sub "nested") "data"))
         ($listing (ra:value (ra:run "ls-tree" (JsonObject ((JsonPair "path" $tree) (JsonPair "depth" True))))))
         ($h (nt:require boolean-tree-depth-is-also-compatible
              (and (nt:contains $listing "sub/") (not (nt:contains $listing "nested"))))))
   (println! UNIT_NATIVE_READ_ADAPTER_VALUES_OK))
