!(import! &self ../native_test_support.metta)
!(import! &self ../../src/context_registry_cetta.metta)
!(let* (($_ (nt:require missing-observation-is-unavailable (== (ctx:source-text ()) ("unavailable"))))
        ($_ (nt:require empty-present-source-is-retained (== (ctx:source-text ("")) ("value" ""))))
        ($_ (nt:require fault-is-unavailable (== (ctx:source-text ((Error reader failed))) ("unavailable"))))
        ($_ (nt:require ambiguous-observation-is-unavailable (== (ctx:source-text ("a" "b")) ("unavailable"))))
        ($_ (nt:require blank-supplied-view-demands-native-source (== (ctx:supplied (("pins-body" " ")) "pins-body") Missing)))
        ($_ (nt:require fourteen-source-contract (== (size-atom (ctx:specs)) 14)))
        ($_ (nt:require unchanged-first-observation-has-no-claim (== (mark:context "unit-source" "a") "")))
        ($_ (nt:require repeated-source-has-marker (nt:contains (mark:context "unit-source" "a") "unchanged for 1 turn")))
        ($_ (nt:require corrected-source-is-visible (== (mark:context "unit-source" "b") " (changed)")))
        ($path (pinsctx:path))
        ($_ (nt:require pin-fixture-is-owned-by-the-test (str:starts-with $path (nt:required-env "HOME"))))
        ($_ (fs:make-directories (path:dirname $path) 448)) ($_ (fs:write $path "PIN_FIXTURE\n"))
        ($first (ctx:pins ())) ($before (get-state &context-marks))
        ($_ (nt:require real-pins-body-is-visible (nt:contains $first "PIN_FIXTURE")))
        ($_ (fs:rename $path (str:concat $path ".saved"))) ($_ (fs:make-directories $path 448))
        ($failure (ctx:pins ())) ($failed-again (ctx:pins ()))
        ($_ (nt:require temporary-read-failure-remains-visible
             (and (== $failure "pins unavailable: IsADirectoryError") (== $failed-again $failure))))
        ($_ (nt:require failed-read-does-not-change-source-streak (== (get-state &context-marks) $before)))
        ($_ (fs:rename $path (str:concat $path ".blocked-directory")))
        ($_ (fs:rename (str:concat $path ".saved") $path))
        ($restored (ctx:pins ()))
        ($_ (nt:require recovered-identical-pins-keep-their-unchanged-streak
             (and (nt:contains $restored "unchanged for 1 turn") (nt:contains $restored "PIN_FIXTURE"))))
        ($ordinary (ctx:pins (("pins-body" "pins unavailable: this is actual supplied data"))))
        ($_ (nt:require diagnostic-shaped-successful-data-is-still-an-observation (nt:contains $ordinary " (changed) "))))
   (println! UNIT_NATIVE_CONTEXT_REGISTRY_OK))
