; Unit tests of src/runtime_events_cetta.metta on the core engine: the spool is
; taken oldest first, each file once, its removal the receipt; handover inputs
; are offered once per process.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/runtime_events_cetta.metta)
(= (rtt:seen $item) (let $text (json-stringify $item) (add-atom &self (RuntimeEventSeen $text))))
(= (rtt:seen-list) (collapse (match &self (RuntimeEventSeen $text) $text)))
!(let* (($home (nt:required-env "HOME"))
        ($spool (rtev:spool (path:join $home "state/telegram-health.json")))
        ($_ (nt:require spool-beside-health (nt:equal $spool (path:join $home "state/runtime-events"))))
        ($_ (nt:require missing-spool-takes-nothing (nt:equal (rtev:take $spool rtt:seen) 0)))
        ($_ (fs:make-directories $spool 448))
        ($_ (fs:write (path:join $spool "00000000000000000002-b.json") "{\"n\": 2}"))
        ($_ (fs:write (path:join $spool "00000000000000000001-a.json") "{\"n\": 1}"))
        ($_ (fs:write (path:join $spool "00000000000000000003-c.json") "{torn"))
        ($_ (fs:write (path:join $spool ".event-writing") "{\"n\": 9}"))
        ($_ (nt:require whole-files-oldest-first
              (nt:equal (rtev:names $spool)
                        ("00000000000000000001-a.json" "00000000000000000002-b.json" "00000000000000000003-c.json"))))
        ($_ (nt:require two-taken (nt:equal (rtev:take $spool rtt:seen) 2)))
        ($_ (nt:require handed-in-order (nt:equal (rtt:seen-list) ("{\"n\":1}" "{\"n\":2}"))))
        ($_ (nt:require receipts-removed (nt:equal (rtev:names $spool) ())))
        ($_ (nt:require writing-sibling-left (fs:exists (path:join $spool ".event-writing"))))
        ($_ (nt:require taken-once (nt:equal (rtev:take $spool rtt:seen) 0)))
        ($modes (path:join $home "modes"))
        ($handover (path:join $modes "channel-handover"))
        ($_ (fs:make-directories $handover 448))
        ($_ (fs:write (path:join $handover "21.json") "{\"update_id\": 21}"))
        ($_ (fs:write (path:join $handover "19.done") "{\"update_id\": 19}"))
        ($_ (nt:require no-mode-root-no-handover (nt:equal (rtev:handover "") ())))
        ($first (rtev:handover $modes))
        ($_ (nt:require handover-offered (nt:equal (size-atom $first) 1)))
        ($_ (nt:require handover-id (nt:equal (car-atom (car-atom $first)) "21")))
        ($_ (nt:require handover-offered-once (nt:equal (rtev:handover $modes) ())))
        ($_ (nt:require handover-file-kept (fs:exists (path:join $handover "21.json")))))
   (println! UNIT_RUNTIME_EVENTS_OK))
