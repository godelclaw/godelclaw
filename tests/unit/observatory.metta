!(import! &self ../native_test_support.metta)
!(import! &self ../../src/observatory_cetta.metta)
!(let* (($root (nt:required-env "HOME"))
        ($_ (change-state! &obs-options (JsonObject ((JsonPair "--data" $root) (JsonPair "--state" $root)))))
        ($receipt (path:join $root "effect-receipts.jsonl"))
        ($first "{\"recorded_at\":1.0,\"turn\":1,\"command\":[\"shell\",\"DO_NOT_RECORD_THIS_BODY\"]}\n")
        ($partial "{\"recorded_at\":2.0,\"turn\":2,\"command\":[\"shell\",\"DO_NOT_RECORD_THIS_BODY\"]}")
        ($_ (fs:write $receipt (str:concat $first $partial))) ($_ (obs:receipts))
        ($_ (nt:require partial-receipt-retains-start-coordinate (== (sf:get (get-state &obs-cursor) "receipts_offset" -1) (str:byte-length $first))))
        ($_ (fs:append-text $receipt "\n")) ($_ (obs:receipts))
        ($_ (nt:require equal-valued-effects-keep-distinct-occurrences
             (== (sf:get (get-state &obs-counts) "effects.jsonl" 0) 2)))
        ($_ (obs:receipts))
        ($_ (nt:require completed-offset-does-not-recount (== (sf:get (get-state &obs-counts) "effects.jsonl" 0) 2)))
        ($usage (json:parse-python "{\"__CURSOR\":\"one\",\"__REALTIME_TIMESTAMP\":\"1000000\",\"_COMM\":\"cetta\",\"MESSAGE\":\"[synthetic_llm] synthetic usage: in=100 cache_read=80 cache_write=10 out=20\"}"))
        ($_ (obs:journal-entry $usage))
        ($_ (nt:require native-usage-projection (== (sf:get (get-state &obs-counts) "llm.jsonl" 0) 1)))
        ($_ (nt:require exact-journal-cursor-retained (== (sf:get (get-state &obs-cursor) "journal_cursor" "") "one")))
        ($_ (nt:require telemetry-excludes-command-body (not (nt:contains (fs:read-text (obs:path "effects.jsonl")) "DO_NOT_RECORD_THIS_BODY"))))
        ($_ (nt:require telemetry-keeps-command-kind (nt:contains (fs:read-text (obs:path "effects.jsonl")) "shell")))
        ($tiny (buffer:new 8 bytes)) ($source (fs:open-read $receipt))
        ($stopped (obs:receipts-read $source $tiny 0 (fs:size $receipt)))
        ($_ (nt:require refused-buffer-keeps-source-position (== $stopped 0)))
        ($_ (nt:require refused-buffer-blocks-cursor-publication (get-state &obs-write-failed)))
        ($_ (fs:close $source)) ($_ (host:close $tiny))
        ($_ (obs:close-writers)))
   (println! UNIT_NATIVE_OBSERVATORY_OK))
