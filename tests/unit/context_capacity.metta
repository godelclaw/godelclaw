!(import! &self ../native_test_support.metta)
!(import! &self ../../src/state_io.metta)
(= (bc:one $name $catalog $window $configured $kind $expected)
   (let* (($root (path:join (nt:required-env "HOME") $name)) ($_ (fs:make-directories $root 448))
          ($at (system:wall-time)) ($observations (path:join $root "observations.json"))
          ($record (JsonObject ((JsonPair "schema" 1)
            (JsonPair "models" (JsonObject ((JsonPair "observed_at" $at) (JsonPair "attempted_at" $at)
                                           (JsonPair "value" (JsonArray $catalog)))))
            (JsonPair "model-window" (JsonObject ((JsonPair "observed_at" $at) (JsonPair "attempted_at" $at)
                                                  (JsonPair "value" $window)))))))
          ($_ (sf:replace $observations (json:stringify-python $record) 384 True))
          ($environment (list:append (("SYNTHETIC_MODEL" "hf:fixture")
                 ("METTACLAW_PROVIDER_OBSERVATION_PATH" $observations)
                 ("METTACLAW_MODEL_STATE_PATH" (path:join $root "model.json")))
             (list:append (if (== $configured JsonNull) () (("METTACLAW_CONTEXT_WINDOW_TOKENS" $configured))) (nt:environment $root))))
          ($text (nt:exit-ok (proc:run ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended"
                 "--import-mode" "ancestor-walk" (path:join (nt:required-env "TEST_REPOSITORY") "tests/fixtures/context_capacity.metta"))
                  (nt:required-env "TEST_REPOSITORY") $environment 15000 1048576)))
          ($result (json:parse-python $text)))
     (nt:require (capacity-policy $name)
       (and (== (sf:get $result "kind" "") $kind) (== (sf:get $result "capacity" BudgetMissingV1) $expected)))))
(= (bc:row $value) (JsonObject ((JsonPair "id" "hf:fixture") (JsonPair "context" $value))))
(= (bc:catalog $name $value $configured $kind $expected)
   (bc:one $name (cons-atom (bc:row $value) ()) (JsonObject ()) $configured $kind $expected))
(= (bc:ratio $literal $expected)
   (let* (($file (path:join (path:dirname (context:path)) "context-token-calibration.json"))
          ($_ (nt:require calibration-fixture-is-owned-by-the-test (str:starts-with $file (nt:required-env "HOME"))))
          ($_ (fs:make-directories (path:dirname $file) 448))
          ($_ (sf:replace $file (str:join "" ("{\"ratio-fixture\":{\"bytes_per_token\":" $literal "}}")) 384 True))
          ($actual (context:ratio "ratio-fixture")))
     (nt:require (calibration-ratio $literal) (== $actual $expected))))
(= (bc:test-absolute-archive)
   (let* (($row (JsonObject ((JsonPair "id" (JsonString "task-input:fixture"))
                            (JsonPair "result" (JsonString "one retained observation")))))
          ($view (JsonObject ((JsonPair "root" (JsonString "conversation:fixture"))
                   (JsonPair "offset" (JsonNumber "15"))
                   (JsonPair "transcript" (JsonArray ($row $row))))))
          ($fits (task:compact $view 1000 1))
          ($trimmed (task:compact $view 4 1))
          ($checkpoint (JsonObject ((JsonPair "start" (JsonNumber "15"))
                                    (JsonPair "summary" (JsonString "saved handoff fixture")))))
          ($rendered (collapse (catch (task:render-budget-view "base" $view $checkpoint 4000 1)))))
     (progn
       (nt:require saved-prefix-remains-discoverable-when-the-tail-fits
         (and (== (task:checkpoint-number (state:json-field $fits "archive") "count") 15)
              (== (task:items $fits "transcript") ($row $row))))
       (nt:require projection-with-no-room-counts-both-omitted-occurrences
         (and (== (task:checkpoint-number $trimmed "offset") 17)
           (and (== (task:checkpoint-number (state:json-field $trimmed "archive") "count") 17)
                (== (task:items $trimmed "transcript") ()))))
       (nt:require budget-render-keeps-handoff-and-archive
         (case $rendered
           ((($text)
             (and (nt:contains $text "saved handoff fixture")
                  (and (nt:contains $text "TASK_CONTEXT") (nt:contains $text "task-history"))))
            ($bad False)))))))
!(progn
   (bc:catalog "numeric" 131072 JsonNull "known" 98304)
   (bc:catalog "numeric-string" "131072" JsonNull "known" 98304)
   (bc:catalog "numeric-underscores" "131_072" JsonNull "known" 98304)
   (bc:catalog "numeric-unicode" "١٣١٠٧٢" JsonNull "known" 98304)
   (bc:catalog "lower-configured" 131072 "65536" "known" 32768)
   (bc:catalog "higher-configured" 131072 "262144" "known" 98304)
   (bc:catalog "configured-zero" 131072 "0" "known" 0)
   (bc:catalog "less-than-output" 16384 JsonNull "known" 0)
   (bc:catalog "string-zero" "0" JsonNull "known" 0)
   (bc:catalog "numeric-zero-is-unreported" 0 JsonNull "unknown" JsonNull)
   (bc:catalog "empty-object-is-unreported" (JsonObject ()) JsonNull "unknown" JsonNull)
   (bc:catalog "empty-array-is-unreported" (JsonArray ()) JsonNull "unknown" JsonNull)
   (bc:catalog "false-is-unreported" False JsonNull "unknown" JsonNull)
   (bc:catalog "true-has-integer-value" True JsonNull "known" 0)
   (bc:catalog "fractional-number-truncates" 131072.9 JsonNull "known" 98304)
   (bc:catalog "fractional-string-is-invalid" "131072.9" JsonNull "invalid" JsonNull)
   (bc:catalog "nonempty-object-is-invalid" (JsonObject ((JsonPair "unexpected" 131072))) JsonNull "invalid" JsonNull)
   (bc:catalog "invalid-configuration" 131072 "wrong" "invalid" JsonNull)
   (bc:one "window-string" () (bc:row "98304") JsonNull "known" 65536)
   (bc:one "wrong-window-model" () (JsonObject ((JsonPair "id" "other") (JsonPair "context" 131072))) JsonNull "unknown" JsonNull)
   (bc:one "missing-both" () (JsonObject ()) JsonNull "unknown" JsonNull)
   (bc:one "numeric-zero-does-not-request-window-fallback" ((bc:row 0)) (bc:row 131072) JsonNull "unknown" JsonNull)
   (bc:one "null-requests-window-fallback" ((bc:row JsonNull)) (bc:row 98304) JsonNull "known" 65536)
   (nt:require capacity-error-does-not-become-unknown
      (case (state:capacity-text ((Error budget invalid))) (((ContextPreparationFailed $_) True) ($bad False))))
   (nt:require missing-capacity-outcome-is-an-explicit-preparation-failure
      (case (state:capacity-text ()) (((ContextPreparationFailed $_) True) ($bad False))))
   (nt:require ambiguous-capacity-outcome-is-an-explicit-preparation-failure
      (case (state:capacity-text (0 1)) (((ContextPreparationFailed $_) True) ($bad False))))
   (nt:require known-zero-remains-zero (== (state:capacity-text (0)) "0"))
   (nt:require unknown-remains-unknown (== (state:capacity-text ("")) ""))
   (let* (($invalid (budget:capacity "" "wrong" 32768))
          ($failure (state:capacity-text (cons-atom $invalid ()))))
     (nt:require preparation-failure-keeps-the-conversion-cause
       (case $failure (((ContextPreparationFailed $why) (nt:contains $why "ValueError")) ($bad False)))))
   (bc:ratio "4.0" 4.0)
   (bc:ratio "\"4.0\"" 4.0)
   (bc:ratio "true" 1.0)
   (bc:ratio "0" 2.5)
   (bc:ratio "-1" 2.5)
   (bc:ratio "Infinity" 2.5)
   (bc:ratio "NaN" 2.5)
   (bc:ratio "{}" 2.5)
   (bc:ratio "\"invalid\"" 2.5)
   (nt:require invalid-ratio-configuration-is-not-admitted
      (== (context:positive-ratio "inf") ContextRatioUnknownV1))
   (nt:require zero-ratio-configuration-is-not-admitted
      (== (context:positive-ratio "0") ContextRatioUnknownV1))
   (nt:require fallback-calibration-does-not-invalidate-zero-capacity
      (case (catch (context:checked-text "nonempty content" "" 0 (context:ratio "ratio-fixture") 1))
        (((ContextPreparationFailed $_) True) ($bad False))))
   (bc:test-absolute-archive)
   (println! UNIT_CONTEXT_CAPACITY_OK))
