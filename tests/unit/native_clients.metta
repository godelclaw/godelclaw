!(import! &self (library lib_prolog))
!(import! &self (library list))
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/state_file_cetta.metta)
(= (client-test:ready $owner $path $remaining)
   (if (fs:exists $path) True
     (if (<= $remaining 0) False
       (let $_ (proc:wait $owner 20) (client-test:ready $owner $path (- $remaining 1))))))
(= (client-test:peer $mode $directory)
   (proc:spawn ((nt:required-env "NATIVE_CORE_PEER") $mode $directory)
     ((env (nt:environment $directory)) (max-bytes 65536))))
(= (client-test:case $directory $operation $extra)
   (let* (($environment (list:append (nt:environment $directory)
            (list:append (("NATIVE_CASE_DIR" $directory)
                          ("METTACLAW_TOOL_OUTPUT_DIR" (path:join $directory "tool-results"))
                          ("METTACLAW_EFFECT_RECEIPT_PATH" (path:join $directory "effects.jsonl"))
                          ("UNIT_PRIVATE_TOKEN" "dummy-private-not-for-mcp"))
                         $extra)))
          ($result (proc:run
            ((nt:required-env "NATIVE_CORE_BIN") "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" "--quiet"
             "tests/unit/native_clients_case.metta" $operation)
            (system:getcwd) $environment 20000 1048576))
          ($_ (fs:write (path:join $directory "client.log") (repr $result))))
     $result))
(= (client-test:mcp $mode)
   (let* (($directory (path:join (nt:required-env "NATIVE_CASE_ROOT") $mode))
          ($_ (fs:make-directories $directory 504))
          ($server (if (== $mode "stdio") none (client-test:peer (if (== $mode "legacy-redirect") "legacy" $mode) $directory)))
          ($_ (if (== $server none) True
                (nt:require native-peer-ready (client-test:ready $server (path:join $directory "port") 100))))
          ($spec (if (== $mode "stdio")
            (JsonObject ((JsonPair "type" "stdio") (JsonPair "command" (nt:required-env "NATIVE_CORE_PEER"))
              (JsonPair "args" (JsonArray ("stdio" $directory)))
              (JsonPair "env" (JsonObject ((JsonPair "HOME" $directory))))))
            (JsonObject ((JsonPair "type" (if (or (== $mode "legacy") (== $mode "legacy-redirect")) "sse" "streamable-http"))
              (JsonPair "url" (str:join "" ("http://127.0.0.1:" (str:trim (fs:read-text (path:join $directory "port")))
                                          (if (== $mode "legacy") "/legacy" (if (== $mode "legacy-redirect") "/redirect" "/mcp")))))
              (JsonPair "readTimeoutSeconds" 5) (JsonPair "totalTimeoutSeconds" 10)))))
          ($config (path:join $directory "mcp.json"))
          ($_ (fs:write $config (json:stringify-python
                 (JsonObject ((JsonPair "mcpServers" (JsonObject ((JsonPair "peer" $spec)))))))))
          ($result (client-test:case $directory "mcp" (("METTACLAW_MCP_CONFIG" $config))))
          ($_ (if (== $server none) True (proc:cancel $server)))
          ($_ (if (== $server none) True (proc:wait $server 2000)))
          ($output (nt:exit-ok $result))
          ($_ (nt:require native-mcp-client-marker (nt:contains $output "NATIVE_MCP_CLIENT_OK")))
          ($_ (nt:require all-json-rpc-handshakes-executed
                (== (str:trim (fs:read-text (path:join $directory "count"))) (if (== $mode "legacy") "16" (if (== $mode "legacy-redirect") "20" "12"))))))
     (println! (NATIVE_TRANSPORT_OK $mode))))
(= (client-test:gateway $incomplete)
   (let* (($directory (path:join (nt:required-env "NATIVE_CASE_ROOT") (if $incomplete "unix-eof" "unix")))
          ($_ (fs:make-directories $directory 504))
          ($wire (str:concat "{\"agent\":\"unit\",\"value\":{\"text\":\"ček\"}}" (if $incomplete "" "\n")))
          ($_ (fs:write (path:join $directory "reply") $wire))
          ($server (client-test:peer "unix" $directory))
          ($_ (nt:require unix-peer-ready (client-test:ready $server (path:join $directory "socket") 100)))
          ($result (client-test:case $directory (if $incomplete "incomplete" "gateway")
             (("METTACLAW_GATEWAY_SOCKET" (path:join $directory "socket")) ("METTACLAW_GATEWAY_AGENT" "unit"))))
          ($_ (proc:cancel $server)) ($_ (proc:wait $server 2000))
          ($output (nt:exit-ok $result)))
     (nt:require native-gateway-completed (nt:contains $output (if $incomplete "NATIVE_GATEWAY_INCOMPLETE_OK" "NATIVE_GATEWAY_CLIENT_OK")))))
(= (client-test:atlas-payloads)
   (let* (($directory (path:join (nt:required-env "NATIVE_CASE_ROOT") "atlas-payloads"))
          ($_ (fs:make-directories $directory 504))
          ($output (nt:exit-ok (client-test:case $directory "atlas-payloads" ()))))
     (nt:require atlas-payloads-completed (nt:contains $output "NATIVE_ATLAS_PAYLOADS_OK"))))
!(case (system:getenv-or-default "NATIVE_TEST_TRANSPORT" "all")
   (("all" (progn (client-test:atlas-payloads) (client-test:mcp "stdio") (client-test:mcp "http")
                  (client-test:mcp "http-sse") (client-test:mcp "legacy") (client-test:mcp "legacy-redirect")
                  (client-test:gateway False) (client-test:gateway True)))
    ("unix" (progn (client-test:gateway False) (client-test:gateway True)))
    ($transport (client-test:mcp $transport))))
!(println! UNIT_NATIVE_CLIENTS_OK)
