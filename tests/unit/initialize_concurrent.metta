; The loop and the command responder both run initialize.sh when they start.
; Started together, neither may fail; an edited soul survives; the generated
; environment is native and private; nothing temporary is left behind; and
; --force restores the template while keeping the edited soul beside it.
!(import! &self ../native_test_support.metta)
!(import! &self (library list))

(= (ic:copy $repo $root $file)
   (fs:write (path:join $root $file) (fs:read-text (path:join $repo $file))))
(= (ic:environment $home)
   (cons-atom ("CETTA_BIN" (path:join (nt:required-env "NATIVE_TEST_CORE") "cetta")) (nt:environment $home)))
(= (ic:start $root $home $args)
   (proc:spawn (list:append ("bash" (path:join $root "initialize.sh")) $args)
               ((cwd $root) (env (ic:environment $home)) (mode stream) (max-bytes 65536) (timeout-ms 120000) (lifetime owner))))
(= (ic:finish $child)
   (let* (($_ (proc:close-input $child)) ($result (proc:await $child)) ($_ (proc:close $child)))
     (case $result (((proc:result (proc:exited 0) $how $out $err $_) True)
                    ($bad (progn (println! (INITIALIZE_FAILED $bad)) False))))))
(= (ic:soul $root) (path:join $root "memory/soul.md"))
; Ten paired starts, each contesting the creation of the soul.
(= (ic:paired $root $home $left)
   (if (== $left 0) True
     (let* (($_ (if (fs:exists (ic:soul $root)) (fs:remove (ic:soul $root)) True))
            ($a (ic:start $root $home ())) ($b (ic:start $root $home ()))
            ($ok-a (ic:finish $a)) ($ok-b (ic:finish $b)))
       (if (and (and $ok-a $ok-b) (== (fs:read-text (ic:soul $root)) "prompt\n"))
         (ic:paired $root $home (- $left 1))
         False))))
(= (ic:named $dir $prefix) (filter-atom (fs:entries $dir) $name (str:starts-with $name $prefix)))

!(let* (($home (nt:required-env "HOME")) ($repo (nt:required-env "TEST_REPOSITORY"))
         ($root (path:join $home "agent"))
         ($_ (map-atom ("scripts" "config" "identity" "src") $d (fs:make-directories (path:join $root $d) 448)))
         ($_ (map-atom ("initialize.sh" "scripts/config_to_env_cetta.metta" "scripts/render_config_native.sh"
                        "src/configuration_cetta.metta" "config/default.toml" "config/secrets.env.example"
                        "config/environment_fields.metta") $file (ic:copy $repo $root $file)))
         ($_ (fs:write (path:join $root "identity/default-soul.md") "prompt\n"))
         ($_ (fs:write (path:join $root "config/local.toml") "[agent]\nllm_timeout_seconds = 300\n[channel]\nkind = \"telegram\"\n"))
         ($_ (nt:require two-initializers-at-once-both-succeed-ten-times (ic:paired $root $home 10)))
         ($_ (fs:write (ic:soul $root) "custom prompt\n"))
         ($_ (nt:require a-later-start-succeeds (ic:finish (ic:start $root $home ()))))
         ($_ (nt:require an-edited-soul-is-kept (== (fs:read-text (ic:soul $root)) "custom prompt\n")))
         ($env (fs:read-text (path:join $root ".env")))
         ($_ (nt:require the-environment-is-native-and-current
               (and (nt:contains $env "Generated by native CeTTa configuration") (nt:contains $env "export SYNTHETIC_TIMEOUT='300'"))))
         ($_ (nt:require the-environment-is-private
               (== (str:strip-python (nt:exit-ok (proc:run ("stat" "-c" "%a" (path:join $root ".env")) $root inherit 5000 64))) "600")))
         ($_ (nt:require the-channel-file-is-written (not (== (fs:read-text (path:join $root "config/channel.metta")) ""))))
         ($_ (nt:require nothing-temporary-is-left
               (and (== (ic:named $root ".env.tmp") ()) (== (ic:named (path:join $root "config") "channel.metta.tmp") ()))))
         ($_ (nt:require force-succeeds (ic:finish (ic:start $root $home ("--force")))))
         ($_ (nt:require force-restores-the-template (== (fs:read-text (ic:soul $root)) "prompt\n")))
         ($kept (ic:named (path:join $root "memory") "soul.md.before-force-"))
         ($_ (nt:require force-keeps-the-edited-soul-beside-it
               (and (== (size-atom $kept) 1)
                    (== (fs:read-text (path:join (path:join $root "memory") (car-atom $kept))) "custom prompt\n")))))
   (println! UNIT_INITIALIZE_CONCURRENT_OK))
