!(import! &self ../native_test_support.metta)
!(import! &self (library host_io))
!(import! &self (library io))
(= (host-test:failure? $value) (case $value (((HostFailure $_ $_ $_) True) ($other False))))
(= (host-test:accept $listener $left)
   (case (host:accept $listener)
     ((HostPending (if (> $left 0) (progn (host:wait (($listener read)) 20) (host-test:accept $listener (- $left 1)))
                     (Error test accept-timeout)))
      ($other $other))))
(= (host-test:buffers)
   (let* (($text (buffer:new 1000 text))
          ($_ (nt:require utf8-editor-insertion (== (buffer:insert $text "až🌿") (HostBuffered 7))))
          ($_ (nt:require scalar-movement (== (buffer:edit $text "left") (HostEditor 3 7))))
          ($_ (nt:require unicode-backspace (== (buffer:edit $text "backspace") (HostEditor 1 5))))
          ($_ (nt:require equal-owner-aliases (== (buffer:value $text) "a🌿")))
          ($forged (parse (repr (quote $text))))
          ($_ (nt:require reprinted-owner-has-no-authority (host-test:failure? (buffer:info $forged))))
          ($bad (str:byte-slice "ž" 0 1))
          ($_ (nt:require invalid-utf8-does-not-mutate-editor (host-test:failure? (buffer:insert $text $bad))))
          ($_ (nt:require refused-insertion-retains-old-value (== (buffer:value $text) "a🌿")))
          ($_ (nt:require cell-widths (== (terminal:cells "á雪🌿") 5)))
          ($raw (buffer:new 16 bytes))
          ($_ (nt:require no-frame-is-pending (== (buffer:line $raw) HostPending)))
          ($_ (buffer:append $raw "\n"))
          ($_ (nt:require one-empty-frame-is-present (== (buffer:line $raw) (HostLine ""))))
          ($_ (buffer:append $raw $bad))
          ($_ (nt:require partial-scalar-is-retained (== (buffer:line $raw) HostPending)))
          ($_ (buffer:append $raw (str:concat (str:byte-slice "ž" 1 2) "\n")))
          ($_ (nt:require split-scalar-roundtrip (== (buffer:line $raw) (HostLine "ž"))))
          ($_ (nt:require oversized-append-refuses (host-test:failure? (buffer:append $raw "01234567890123456"))))
          ($_ (host:close $text))
          ($_ (nt:require closed-alias-refuses (host-test:failure? (buffer:value $text))))
          ($_ (host:close $raw))) True))
(= (host-test:socket)
   (let* (($socket (path:join (nt:required-env "HOME") "s"))
          ($listener (host:listen $socket 16))
          ($_ (nt:require competing-listener-refuses (host-test:failure? (host:listen $socket 16))))
          ($url (str:concat "unix://" $socket))
          ((io:pending $connecting) (io:submit (tcp:connect $url 1000 4096 pieces)))
          ((io:event $connect-id (tcp:connected $client)) (io:wait $connecting 2000))
          ((HostAccepted $connection $peer) (host-test:accept $listener 100))
          ($_ (nt:require peer-is-observed-by-host (== $peer (host:identity))))
          ((io:pending $sending) (io:submit (tcp:send $client "request\n")))
          ($_ (io:wait $sending 1000))
          ((HostReady $ready) (host:wait (($connection read)) 1000))
          ($_ (nt:require connection-readiness (not (== $ready ()))))
          ((HostBytes $request) (host:read $connection 4096))
          ($_ (nt:require native-client-to-native-server (== $request "request\n")))
          ($_ (nt:require actual-write-count (== (host:write $connection "reply\n" 0) (HostWritten 6))))
          ((io:pending $receiving) (io:submit (tcp:receive $client)))
          ((io:event $receive-id (tcp:received $same $reply)) (io:wait $receiving 1000))
          ($_ (nt:require native-server-to-native-client (== $reply "reply\n")))
          ($_ (host:close $connection)) ($_ (host:close $listener))
          ($_ (nt:require endpoint-cleanup (not (fs:exists $socket))))
          ($_ (nt:require closed-listener-refuses (host-test:failure? (host:accept $listener))))
          ((io:pending $closing) (io:submit (tcp:close $client))) ($_ (io:wait $closing 1000))) True))
!(nt:require host-buffer-controls (host-test:buffers))
!(nt:require host-socket-controls (host-test:socket))
(= (host-test:connect $url)
   (let* (((io:pending $pending) (io:submit (tcp:connect $url 1000 4096 pieces)))
          ((io:event $_ (tcp:connected $client)) (io:wait $pending 2000))) $client))
(= (host-test:send $client $text)
   (let* (((io:pending $pending) (io:submit (tcp:send $client $text)))
          ((io:event $_ (tcp:sent $_)) (io:wait $pending 1000))) True))
(= (host-test:close-client $client)
   (let* (((io:pending $pending) (io:submit (tcp:close $client))) ($_ (io:wait $pending 1000))) True))
(= (host-test:static-reply)
   (let* (($socket (path:join (nt:required-env "HOME") "r")) ($url (str:concat "unix://" $socket))
          ($listener (host:listen $socket 16))
          ($mapping (HostReplyV1 "question\n" "answer 雪\n"))
          ($client (host-test:connect $url)) ($_ (host-test:send $client "question\n"))
          ($served (host:wait-reply $listener (($listener read)) $mapping 5))
          ($_ (nt:require exact-frame-was-served-natively (case $served (((HostReady $_) True) ($bad False)))))
          ((io:pending $reading) (io:submit (tcp:receive $client)))
          ((io:event $_ (tcp:received $_ $reply)) (io:wait $reading 1000))
          ($_ (nt:require static-reply-is-exact-bytes (== $reply "answer 雪\n")))
          ($_ (host-test:close-client $client))
          ($different (host-test:connect $url)) ($_ (host-test:send $different "other\n"))
          ((HostIncomingV1 $fd $peer $bytes $accepted) (host:wait-reply $listener (($listener read)) $mapping 100))
          ($_ (nt:require mismatch-retains-frame-and-peer
                (and (== $bytes "other\n") (and (== $peer (host:identity)) (> $accepted 0)))))
          ($_ (host:close $fd)) ($_ (host-test:close-client $different))
          ($split (host-test:connect $url)) ($_ (host-test:send $split "ques"))
          ((HostIncomingV1 $partial $_ $prefix $_) (host:wait-reply $listener (($listener read)) $mapping 0))
          ($_ (nt:require unfinished-request-retains-consumed-prefix (== $prefix "ques")))
          ($_ (host-test:send $split "tion\n"))
          ((HostReady $_) (host:wait (($partial read)) 1000))
          ((HostBytes $suffix) (host:read $partial 4096))
          ($_ (nt:require caller-can-resume-without-loss (== (str:concat $prefix $suffix) "question\n")))
          ($_ (host:close $partial)) ($_ (host-test:close-client $split))
          ($busy-client (host-test:connect $url))
          ((HostAccepted $busy-fd $_) (host-test:accept $listener 100))
          ($_ (host-test:send $busy-client "already ready"))
          ($new-client (host-test:connect $url)) ($_ (host-test:send $new-client "question\n"))
          ((HostReady $ready) (host:wait-reply $listener (($listener read) ($busy-fd read)) $mapping 100))
          ($_ (nt:require existing-ready-owner-yields-to-caller (not (== $ready ()))))
          ((HostBytes $busy-bytes) (host:read $busy-fd 4096))
          ($_ (nt:require other-ready-input-is-not-consumed (== $busy-bytes "already ready")))
          ($_ (host:close $busy-fd)) ($_ (host-test:close-client $busy-client))
          ($_ (host:wait-reply $listener (($listener read)) $mapping 5))
          ((io:pending $new-reading) (io:submit (tcp:receive $new-client)))
          ((io:event $_ (tcp:received $_ $new-reply)) (io:wait $new-reading 1000))
          ($_ (nt:require yielding-does-not-lose-new-connection (== $new-reply "answer 雪\n")))
          ($_ (host-test:close-client $new-client))
          ($_ (nt:require malformed-mapping-refuses-before-accept
                (host-test:failure? (host:wait-reply $listener (($listener read)) (HostReplyV1 "question" "bad") 0))))
          ($_ (nt:require missing-listener-interest-refuses
                (host-test:failure? (host:wait-reply $listener () $mapping 0))))
          ($_ (nt:require multiline-mapping-is-not-a-single-frame
                (host-test:failure? (host:wait-reply $listener (($listener read)) (HostReplyV1 "a\nb\n" "bad") 0))))
          ($_ (host:close $listener))
          ($_ (nt:require closed-owner-refuses-static-service
                (host-test:failure? (host:wait-reply $listener (($listener read)) $mapping 0))))) True))
!(nt:require host-static-reply-controls (host-test:static-reply))
!(println! UNIT_NATIVE_HOST_IO_OK)
