; Native attach-console presentation contracts: copyable commands and heredocs,
; exact tool attribution and production-shaped completions, alias reconciliation
; without global deduplication, quiet scrollback, live status/activity rows,
; and SGR-only terminal hygiene.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/console/main_cetta.metta)

(= (cp:count $text $needle)
   (- (size-atom (str:split $needle $text)) 1))
(= (cp:line-count $text $line)
   (size-atom (filter-atom (str:split "\n" $text) $row (== $row $line))))
(= (cp:has-trailing-space? $lines)
   (if (== $lines ()) False
     (let $row (car-atom $lines)
       (if (or (str:ends-with $row " ") (str:ends-with $row "\t")) True
         (cp:has-trailing-space? (cdr-atom $lines))))))
(= (cp:feed $events)
   (if (== $events ()) True
     (progn (cc:event (car-atom $events) False) (cp:feed (cdr-atom $events)))))
(= (cp:reset-case $agent $color)
   (let* (($_ (cc:projection-reset))
          ($_ (cc:initialize (JsonObject ((JsonPair "agent" $agent)))))
          ($_ (cc:set "color" $color))) True))
(= (cp:drain)
   (buffer:value (cc:get "events" ConsoleNoBufferV1)))

; Case 1: Production-shaped tool completions (finish omits command & name),
; duplicate terminal replay (same seq AND higher seq), equal commands not merged,
; failed exit, withheld outcome, and orphan completion without borrowed command.
(= (cp:case-tools)
   (let* (($_ (cp:reset-case "godel" False))
          ($heredoc "cat > /tmp/probe.metta <<'EOF'\n!(println! ok)\nEOF\ncetta /tmp/probe.metta")
          ($events (
            (JsonObject ((JsonPair "kind" "tool.dispatching") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 1) (JsonPair "time" 1001) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t1") (JsonPair "name" "exec_command")
              (JsonPair "command" "printf OUTCOME_EQUAL") (JsonPair "text" "") (JsonPair "source" "executor") (JsonPair "status" "dispatching")))
            (JsonObject ((JsonPair "kind" "tool.started") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 2) (JsonPair "time" 1002) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t1") (JsonPair "name" "exec_command")
              (JsonPair "command" "printf OUTCOME_EQUAL") (JsonPair "text" "") (JsonPair "source" "executor") (JsonPair "status" "running")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 3) (JsonPair "time" 1003) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t1") (JsonPair "text" "") (JsonPair "source" "executor")
              (JsonPair "status" "exited") (JsonPair "exit_code" 0) (JsonPair "artifact" "/srv/logs/first.log")))
            ; Replay with same sequence
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 3) (JsonPair "time" 1003) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t1") (JsonPair "text" "") (JsonPair "source" "executor")
              (JsonPair "status" "exited") (JsonPair "exit_code" 0) (JsonPair "artifact" "/srv/logs/first.log")))
            ; Replay with higher sequence on already-terminal item
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 4) (JsonPair "time" 1004) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t1") (JsonPair "text" "") (JsonPair "source" "executor")
              (JsonPair "status" "exited") (JsonPair "exit_code" 0) (JsonPair "artifact" "/srv/logs/first.log")))
            ; Distinct second equal-valued action
            (JsonObject ((JsonPair "kind" "tool.dispatching") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 5) (JsonPair "time" 1005) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t2") (JsonPair "name" "exec_command")
              (JsonPair "command" "printf OUTCOME_EQUAL") (JsonPair "text" "") (JsonPair "source" "executor") (JsonPair "status" "dispatching")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 6) (JsonPair "time" 1007) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t2") (JsonPair "text" "") (JsonPair "source" "executor")
              (JsonPair "status" "exited") (JsonPair "exit_code" 0) (JsonPair "artifact" "/srv/logs/second.log")))
            ; Multiline heredoc failing with exit 7
            (JsonObject ((JsonPair "kind" "tool.dispatching") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 7) (JsonPair "time" 1008) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t3") (JsonPair "name" "exec_command")
              (JsonPair "command" $heredoc) (JsonPair "text" "") (JsonPair "source" "executor") (JsonPair "status" "dispatching")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 8) (JsonPair "time" 1010) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t3") (JsonPair "text" "err line\n") (JsonPair "source" "executor")
              (JsonPair "status" "exited") (JsonPair "exit_code" 7) (JsonPair "artifact" "/srv/logs/third.log")))
            ; Withheld action
            (JsonObject ((JsonPair "kind" "tool.dispatching") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 9) (JsonPair "time" 1011) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t4") (JsonPair "name" "exec_command")
              (JsonPair "command" "printf OUTCOME_WITHHELD") (JsonPair "text" "") (JsonPair "source" "executor") (JsonPair "status" "dispatching")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 10) (JsonPair "time" 1013) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "t4") (JsonPair "text" "") (JsonPair "source" "executor")
              (JsonPair "status" "withheld") (JsonPair "artifact" "/srv/logs/fourth.log")))
            ; Orphan completion without prior start
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 11) (JsonPair "time" 1014) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "orphan") (JsonPair "text" "ORPHAN_RESULT_09")
              (JsonPair "source" "executor") (JsonPair "status" "exited") (JsonPair "exit_code" 9)
              (JsonPair "artifact" "/srv/logs/orphan.log")))
            ; Returned MeTTa command (rest) and returned (Error ...) command
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 12) (JsonPair "time" 1015) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "m1") (JsonPair "command" "['rest']")
              (JsonPair "text" "(RESTING budget-banked)") (JsonPair "source" "executor") (JsonPair "status" "returned")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "p")
              (JsonPair "sequence" 13) (JsonPair "time" 1016) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "m2") (JsonPair "command" "['check']")
              (JsonPair "text" "(Error bad)") (JsonPair "source" "executor") (JsonPair "status" "returned")))))
          ($_ (cp:feed $events))
          ($out (cp:drain))
          ($wrapped (str:concat "\n" $out))
          ($_ (nt:require equal-actions-not-merged (== (cp:line-count $out "printf OUTCOME_EQUAL") 2)))
          ($_ (nt:require replay-does-not-double (== (cp:count $wrapped "\n✓ shell · exit 0") 2)))
          ($_ (nt:require heredoc-preserved-verbatim (nt:contains $wrapped (str:join "" ("\n" $heredoc "\n")))))
          ($_ (nt:require failing-exit-distinct (== (cp:count $wrapped "\n✗ shell · exit 7") 1)))
          ($_ (nt:require withheld-distinct (== (cp:count $wrapped "\n? shell · withheld") 1)))
          ($_ (nt:require orphan-outcome-distinct (== (cp:count $wrapped "\n✗ tool finished · exit 9") 1)))
          ($_ (nt:require orphan-artifact-unclipped (== (cp:line-count $out "    output: /srv/logs/orphan.log") 1)))
          ($_ (nt:require orphan-text-shown (== (cp:count $out "ORPHAN_RESULT_09") 1)))
          ($_ (nt:require metta-rest-success (== (cp:count $wrapped "\n✓ (rest)") 1)))
          ($_ (nt:require metta-error-failed (== (cp:count $wrapped "\n✗ (check)") 1)))
          ($_ (nt:require no-lifecycle-noise (not (or (nt:contains $out "tool.dispatching") (nt:contains $out "tool.started")))))
          ($_ (nt:require no-trailing-spaces (not (cp:has-trailing-space? (str:split "\n" $out)))))) True))

; Case 2: Alias reconciliation across item IDs within same attempt/channel,
; separate attempts & sessions NOT deduplicated, differing final shown with note,
; and short open text without newline flushed cleanly.
(= (cp:case-reconcile)
   (let* (($_ (cp:reset-case "godel" False))
          ($events (
            ; Occurrence 1 (godel, first): alias stream -> answer extending prefix
            (JsonObject ((JsonPair "kind" "text.delta") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 1) (JsonPair "time" 1001) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "first") (JsonPair "item" "stream") (JsonPair "channel" "commentary")
              (JsonPair "text" "SAME_TEXT") (JsonPair "source" "provider")))
            (JsonObject ((JsonPair "kind" "text.reconcile") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 2) (JsonPair "time" 1002) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "first") (JsonPair "item" "answer") (JsonPair "channel" "commentary")
              (JsonPair "text" "SAME_TEXT SUFFIX") (JsonPair "source" "terminal")))
            (JsonObject ((JsonPair "kind" "attempt.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 3) (JsonPair "time" 1003) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "first") (JsonPair "status" "completed") (JsonPair "source" "terminal")))
            ; Occurrence 2 (godel, second): identical text in new attempt MUST show again
            (JsonObject ((JsonPair "kind" "text.delta") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 4) (JsonPair "time" 1004) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "second") (JsonPair "item" "stream") (JsonPair "channel" "commentary")
              (JsonPair "text" "SAME_TEXT") (JsonPair "source" "provider")))
            (JsonObject ((JsonPair "kind" "text.reconcile") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 5) (JsonPair "time" 1005) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "second") (JsonPair "item" "answer") (JsonPair "channel" "commentary")
              (JsonPair "text" "SAME_TEXT SUFFIX") (JsonPair "source" "terminal")))
            (JsonObject ((JsonPair "kind" "attempt.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 6) (JsonPair "time" 1006) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "second") (JsonPair "status" "completed") (JsonPair "source" "terminal")))
            ; Occurrence 3 (child, first): identical text in child session MUST show again under child header
            (JsonObject ((JsonPair "kind" "text.delta") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 7) (JsonPair "time" 1007) (JsonPair "session" "child") (JsonPair "parent_session" "godel")
              (JsonPair "attempt" "first") (JsonPair "item" "stream") (JsonPair "channel" "commentary")
              (JsonPair "text" "SAME_TEXT") (JsonPair "source" "provider")))
            (JsonObject ((JsonPair "kind" "text.reconcile") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 8) (JsonPair "time" 1008) (JsonPair "session" "child") (JsonPair "parent_session" "godel")
              (JsonPair "attempt" "first") (JsonPair "item" "answer") (JsonPair "channel" "commentary")
              (JsonPair "text" "SAME_TEXT SUFFIX") (JsonPair "source" "terminal")))
            (JsonObject ((JsonPair "kind" "attempt.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 9) (JsonPair "time" 1009) (JsonPair "session" "child") (JsonPair "parent_session" "godel")
              (JsonPair "attempt" "first") (JsonPair "status" "completed") (JsonPair "source" "terminal")))
            ; Occurrence 4: final with no prior stream
            (JsonObject ((JsonPair "kind" "text.reconcile") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 10) (JsonPair "time" 1010) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "no-stream") (JsonPair "item" "answer") (JsonPair "channel" "commentary")
              (JsonPair "text" "FINAL_ONLY") (JsonPair "source" "terminal")))
            ; Occurrence 5: differing final after committed paragraph
            (JsonObject ((JsonPair "kind" "text.delta") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 11) (JsonPair "time" 1011) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "diff") (JsonPair "item" "s") (JsonPair "channel" "commentary")
              (JsonPair "text" "OLD_PARA\n\nstill") (JsonPair "source" "provider")))
            (JsonObject ((JsonPair "kind" "text.reconcile") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 12) (JsonPair "time" 1012) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "diff") (JsonPair "item" "answer") (JsonPair "channel" "commentary")
              (JsonPair "text" "TOTALLY_DIFFERENT_FINAL") (JsonPair "source" "terminal")))
            ; Occurrence 6: short text without trailing newline flushed on one-shot
            (JsonObject ((JsonPair "kind" "text.delta") (JsonPair "epoch" "initial") (JsonPair "producer" "r")
              (JsonPair "sequence" 13) (JsonPair "time" 1013) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "open") (JsonPair "item" "short") (JsonPair "channel" "commentary")
              (JsonPair "text" "SHORT_NO_NEWLINE") (JsonPair "source" "provider")))))
          ($_ (cp:feed $events))
          ($_ (cc:flush-visible-items))
          ($out (cp:drain))
          ($_ (nt:require three-occurrences-not-six (== (cp:count $out "SAME_TEXT") 3)))
          ($_ (nt:require three-suffixes (== (cp:count $out "AUTHORITATIVE") 0)))
          ($_ (nt:require three-real-suffixes (== (cp:count $out "SAME_TEXT SUFFIX") 3)))
          ($_ (nt:require child-attribution (nt:contains $out "◆ child · started by godel")))
          ($_ (nt:require final-only-delivered (== (cp:count $out "FINAL_ONLY") 1)))
          ($_ (nt:require differing-final-visible (== (cp:count $out "TOTALLY_DIFFERENT_FINAL") 1)))
          ($_ (nt:require short-open-text-visible (== (cp:count $out "SHORT_NO_NEWLINE") 1)))
          ($_ (nt:require no-attempt-finished-noise (not (nt:contains $out "attempt finished"))))) True))

; Case 3: Hostile terminal sequences stripped; color mode emits SGR-only;
; live activity/status rows reflect running command & idle hint.
(= (cp:case-hygiene-and-status)
   (let* (($_ (cp:reset-case "godel" True))
          ($attack (str:from-python-codepoints (27 93 53 50 59 99 59 88 7 27 91 50 74 27 91 51 49 109 114 101 100 155 54 110 32 100 111 110 101)))
          ($events (
            (JsonObject ((JsonPair "kind" "attempt.open") (JsonPair "epoch" "initial") (JsonPair "producer" "s")
              (JsonPair "sequence" 1) (JsonPair "time" 1001) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "model" "gpt-6.2-sol") (JsonPair "status" "awaiting")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "s")
              (JsonPair "sequence" 2) (JsonPair "time" 1002) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "z") (JsonPair "command" "['shell', 'x']")
              (JsonPair "text" $attack) (JsonPair "source" "executor") (JsonPair "status" "returned")))
            (JsonObject ((JsonPair "kind" "tool.started") (JsonPair "epoch" "initial") (JsonPair "producer" "s")
              (JsonPair "sequence" 3) (JsonPair "time" 1003) (JsonPair "session" "work-20261104-225522-a6fe")
              (JsonPair "parent_session" "godel") (JsonPair "attempt" "w1") (JsonPair "item" "x3")
              (JsonPair "name" "exec_command") (JsonPair "command" "python3 -m unittest") (JsonPair "source" "executor")))))
          ($_ (cp:feed $events))
          ($out (cp:drain))
          ($no-sgr (re:replace-literal (re:compile "\u001b\\[[0-9;]*m") $out ""))
          ($esc (str:from-codepoints (27)))
          ($c1 (str:from-python-codepoints (155)))
          ($_ (nt:require color-has-sgr (nt:contains $out $esc)))
          ($_ (nt:require only-sgr-escapes (not (nt:contains $no-sgr $esc))))
          ($_ (nt:require no-c1-control (not (nt:contains $out $c1))))
          ($_ (nt:require osc-payload-stripped (not (nt:contains $out "52;c"))))
          ($_ (nt:require safe-text-retained (nt:contains $no-sgr "red done")))
          ($activity (cc:activity-text 110))
          ($_ (nt:require activity-shows-running-child (nt:contains $activity "work-20261104-225522-a6fe")))
          ($_ (nt:require activity-shows-command (nt:contains $activity "python3 -m unittest")))
          ($status (cc:status-text 140))
          ($_ (nt:require status-shows-work-running (nt:contains $status "work-20261104-225522-a6fe running")))
          ($narrow (cc:status-text 60))
          ($_ (nt:require narrow-shortens-work-id (nt:contains $narrow "work-…-a6fe")))) True))

; Case 4: Priming suppresses scrollback while populating live status; narrow width
; never folds shell commands or artifact paths; color=True stripped of SGR matches
; color=False byte-for-byte; operator input and replies render verbatim.
(= (cp:case-prime-narrow-color-and-operator)
   (let* (($_ (cp:reset-case "godel" False))
          ($prime-events (
            (JsonObject ((JsonPair "kind" "attempt.open") (JsonPair "epoch" "initial") (JsonPair "producer" "pr")
              (JsonPair "sequence" 1) (JsonPair "time" 1001) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "model" "gpt-6.2-sol")))
            (JsonObject ((JsonPair "kind" "attempt.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "pr")
              (JsonPair "sequence" 2) (JsonPair "time" 1002) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "status" "completed")))
            (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "pr")
              (JsonPair "sequence" 3) (JsonPair "time" 1003) (JsonPair "session" "godel") (JsonPair "parent_session" "")
              (JsonPair "attempt" "a1") (JsonPair "item" "r1") (JsonPair "command" "['rest']")
              (JsonPair "text" "(RESTING budget-banked)") (JsonPair "source" "executor") (JsonPair "status" "returned")))
            (JsonObject ((JsonPair "kind" "attempt.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "pr")
              (JsonPair "sequence" 4) (JsonPair "time" 1004) (JsonPair "session" "work-20261104-225522-a6fe")
              (JsonPair "parent_session" "godel") (JsonPair "attempt" "w1") (JsonPair "status" "completed")))))
          ($_ (map-atom $prime-events $ev (cc:event $ev True)))
          ($_ (nt:require prime-prints-nothing (== (cp:drain) "")))
          ($_ (nt:require prime-idle-activity (nt:contains (cc:activity-text 110) "Enter sends")))
          ($pstat (cc:status-text 140))
          ($_ (nt:require prime-status-resting (nt:contains $pstat "resting")))
          ($_ (nt:require prime-status-work-ready (nt:contains $pstat "work-20261104-225522-a6fe ready")))
          ; Narrow width must NOT fold shell commands or artifact paths
          ($_ (cp:reset-case "godel" False))
          ($_ (cc:set "display-width" 40))
          ($long-cmd "cd /srv/work/a-rather-long-directory-name && grep -rn pattern src | head -20")
          ($long-art "/a/b/cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
          ($ev-long (JsonObject ((JsonPair "kind" "tool.finished") (JsonPair "epoch" "initial") (JsonPair "producer" "nw")
            (JsonPair "sequence" 1) (JsonPair "time" 1005) (JsonPair "session" "godel") (JsonPair "parent_session" "")
            (JsonPair "attempt" "a1") (JsonPair "item" "n1") (JsonPair "name" "exec_command")
            (JsonPair "command" $long-cmd) (JsonPair "text" "") (JsonPair "source" "executor")
            (JsonPair "status" "exited") (JsonPair "exit_code" 0) (JsonPair "artifact" $long-art))))
          ($_ (cc:event $ev-long False))
          ($plain (cp:drain))
          ($_ (nt:require narrow-keeps-unfolded-command (== (cp:line-count $plain $long-cmd) 1)))
          ($_ (nt:require narrow-keeps-unfolded-artifact (== (cp:line-count $plain (str:concat "    output: " $long-art)) 1)))
          ; Color round-trip: SGR stripped equals plain byte-for-byte
          ($_ (cp:reset-case "godel" True))
          ($_ (cc:set "display-width" 40))
          ($_ (cc:event $ev-long False))
          ($colored (cp:drain))
          ($stripped (re:replace-literal (re:compile "\u001b\\[[0-9;]*m") $colored ""))
          ($_ (nt:require color-sgr-roundtrip (== $stripped $plain)))
          ; Operator input & reply formatting
          ($_ (cp:reset-case "godel" False))
          ($_ (cc:emit-user-input "first line longer than thirty cells\n  indented second"))
          ($_ (nt:require operator-input-verbatim (== (cp:drain) "› first line longer than thirty cells\n    indented second\n")))
          ($_ (cp:reset-case "godel" False))
          ($_ (cc:emit-reply "godel" "Run: cd /srv/work && make test\n\nDone." ""))
          ($rep (cp:drain))
          ($_ (nt:require reply-header (str:starts-with $rep "godel → you\n")))
          ($_ (nt:require reply-body-verbatim (nt:contains $rep "\nRun: cd /srv/work && make test\n\nDone.\n")))) True))

!(nt:require console-presentation-tools (cp:case-tools))
!(nt:require console-presentation-reconcile (cp:case-reconcile))
!(nt:require console-presentation-hygiene-and-status (cp:case-hygiene-and-status))
!(nt:require console-presentation-prime-narrow-color-and-operator (cp:case-prime-narrow-color-and-operator))
!(println! UNIT_NATIVE_CONSOLE_PRESENTATION_OK)
