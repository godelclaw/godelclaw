; Pure MeTTa numeric text conversion against the pinned SQLite rules. Doubles
; are built from their exact bits (math:binary64-from-parts). The fixed edges
; and value kinds have their known texts; every power value is the exact
; integer floor of 10^p 2^(63-b); and every binade's boundaries plus 4096
; random bit patterns render as SQLite's own CAST(x AS TEXT) does (SQLite
; 3.53 and later print 17 significant digits by default).
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/sql_value_cetta.metta)
!(import! &self (library sqlite))
!(import! &self (library math))
!(import! &self (library list))

(= (sv:text $value) (sql-value:call (FloatText $value)))
(= (sv:float $parts) (math:binary64-from-parts $parts))
(= (sv:two63) 9223372036854775808)
(= (sv:two52) 4503599627370496)
; The double whose bits are $word.
(= (sv:of-bits $word)
   (let* (($negative (>= $word (sv:two63))) ($sign (if $negative -1 1))
          ($rest (if $negative (- $word (sv:two63)) $word))
          ((IntegerDivmodV1 $field $fraction) (math:integer-divmod $rest (sv:two52))))
     (sv:float
       (if (== $field 2047)
           (if (== $fraction 0) (Binary64InfinityV1 $sign) (Binary64NaNV1 $sign $fraction))
           (if (== $field 0) (Binary64PartsV1 $sign $fraction -1074)
               (Binary64PartsV1 $sign (+ $fraction (sv:two52)) (- $field 1075)))))))
(= (sv:pow $base $n) (if (== $n 0) 1 (* $base (sv:pow $base (- $n 1)))))
(= (sv:floor-div $a $b) (let (IntegerDivmodV1 $q $r) (math:integer-divmod $a $b) $q))
(= (sv:power-high-expected $p)
   (let* (($binary (sv:floor-div (* $p 108853) 32768))
          ($a0 (if (>= $p 0) (sv:pow 10 $p) 1)) ($b0 (if (>= $p 0) 1 (sv:pow 10 (- 0 $p))))
          ($shift (- 63 $binary)))
     (if (>= $shift 0) (sv:floor-div (* $a0 (sv:pow 2 $shift)) $b0) (sv:floor-div $a0 (* $b0 (sv:pow 2 (- 0 $shift)))))))
(= (sv:powers-wrong $p $last)
   (if (> $p $last) ()
     (let $rest (sv:powers-wrong (+ $p 1) $last)
       (if (== (sql-value:call (PowerHigh $p)) (sv:power-high-expected $p)) $rest (cons-atom $p $rest)))))
; Bits of 2^e and of its two neighbours, for every binade.
(= (sv:binade-words $e)
   (let $center (if (>= $e -1022) (* (+ $e 1023) (sv:two52)) (sv:pow 2 (+ $e 1074)))
     ($center (+ $center (sv:two63)) (- $center 1) (+ $center 1))))
(= (sv:all-binades $e $last) (if (> $e $last) () (list:append (sv:binade-words $e) (sv:all-binades (+ $e 1) $last))))
(= (sv:next $s) (let (IntegerDivmodV1 $q $r) (math:integer-divmod (+ (* 6364136223846793005 $s) 1442695040888963407) 18446744073709551616) $r))
(= (sv:randoms $s $n) (if (== $n 0) () (let $t (sv:next $s) (cons-atom $t (sv:randoms $t (- $n 1))))))
; SQLite's text for each value, a statement of at most $width columns at a time.
(= (sv:columns $n $at) (if (== $n 0) () (cons-atom (format-args "CAST(?{} AS TEXT)" ($at)) (sv:columns (- $n 1) (+ $at 1)))))
(= (sv:take $xs $n) (if (or (== $n 0) (== $xs ())) () (cons-atom (car-atom $xs) (sv:take (cdr-atom $xs) (- $n 1)))))
(= (sv:drop $xs $n) (if (or (== $n 0) (== $xs ())) $xs (sv:drop (cdr-atom $xs) (- $n 1))))
(= (sv:sqlite-texts $values $width)
   (if (== $values ()) ()
     (let* (($chunk (sv:take $values $width))
            ($sql (str:concat "SELECT " (str:join ", " (sv:columns (size-atom $chunk) 1))))
            ((sqlite:result $names ($row) $changes $last) (sqlite:query ":memory:" $sql $chunk 5000)))
       (list:append $row (sv:sqlite-texts (sv:drop $values $width) $width)))))
(= (sv:expected $sqlite) (if (== $sqlite sqlite:null) JsonNull $sqlite))
(= (sv:mismatches $values $texts)
   (if (== $values ()) ()
     (let* (($v (car-atom $values)) ($want (sv:expected (car-atom $texts)))
            ($rest (sv:mismatches (cdr-atom $values) (cdr-atom $texts))))
       (if (== (sv:text $v) $want) $rest (cons-atom ($v (sv:text $v) $want) $rest)))))

!(let* (($version (sqlite:query ":memory:" "SELECT sqlite_version()" () 5000))
         ((sqlite:result $names (($v)) $c $l) $version)
         ($_ (nt:require sqlite-is-new-enough-for-the-oracle
               (let ($major $minor) (map-atom (sv:take (str:split "." $v) 2) $part (parse $part))
                 (or (> $major 3) (and (== $major 3) (>= $minor 53))))))
         ($_ (nt:require fixed-edges-and-value-kinds
               (and (== (sv:text 0.0) "0.0")
               (and (== (sv:text (sv:float (Binary64PartsV1 -1 0 -1074))) "0.0")
               (and (== (sv:text 1.0) "1.0")
               (and (== (sv:text -1.0) "-1.0")
               (and (== (sv:text 7.75) "7.75")
               (and (== (sv:text 1.0e-07) "1.0e-07")
               (and (== (sv:text 1.0e-05) "1.0e-05")
               (and (== (sv:text 1.0e16) "10000000000000000.0")
               (and (== (sv:text 1.0e30) "1.0e+30")
               (and (== (sv:text 1.2345678901234567) "1.2345678901234567")
               (and (== (sv:text (sv:float (Binary64PartsV1 1 1 -1074))) "4.9406564584124654e-324")
               (and (== (sv:text (sv:float (Binary64PartsV1 1 9007199254740991 971))) "1.7976931348623157e+308")
               (and (== (sv:text (sv:float (Binary64InfinityV1 1))) "Inf")
               (and (== (sv:text (sv:float (Binary64InfinityV1 -1))) "-Inf")
               (and (== (sv:text (sv:float (Binary64NaNV1 1 2251799813685248))) JsonNull)
                    (== (sv:text 1) (Binary64RefusedV1 expected-float)))))))))))))))))))
         ($wrong-powers (sv:powers-wrong -348 347))
         ($_ (if (== $wrong-powers ()) True (println! (POWERS_WRONG $wrong-powers))))
         ($_ (nt:require every-power-value-uses-exact-integer-arithmetic (== $wrong-powers ())))
         ($words (list:append (sv:all-binades -1074 1023) (sv:randoms 2710532 4096)))
         ($values (map-atom $words $w (sv:of-bits $w)))
         ($texts (sv:sqlite-texts $values 500))
         ($_ (nt:require every-value-was-rendered-by-sqlite (== (size-atom $texts) (size-atom $values))))
         ($misses (sv:mismatches $values $texts))
         ($_ (if (== $misses ()) True (println! (SQL_TEXT_MISMATCHES (size-atom $misses) (sv:take $misses 5)))))
         ($_ (nt:require binade-boundaries-and-random-values-match-sqlite (== $misses ()))))
   (println! UNIT_SQL_VALUE_OK))
