!(import! &self ../native_test_support.metta)
!(import! &self ../../src/mcp_client_cetta.metta)
!(let* (($state (new-space))
        ($_ (mcp:set $state "expected-id" 7)) ($_ (mcp:set $state "reply-deadline" (+ (system:monotonic-ns) 10000000000)))
        ($_ (mcp:accept-message $state "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\"}"))
        ($_ (nt:require notification-is-not-completion (not (mcp:reply-ready? $state))))
        ($_ (mcp:accept-message $state "{\"jsonrpc\":\"2.0\",\"id\":8,\"result\":\"wrong\"}"))
        ($_ (nt:require wrong-request-is-not-completion (not (mcp:reply-ready? $state))))
        ($_ (mcp:accept-message $state "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":\"first\"}"))
        ($_ (mcp:accept-message $state "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":\"second\"}"))
        ($_ (nt:require duplicate-cannot-replace-first (== (mcp:wait-reply $state 7) "first")))
        ($_ (nt:require consumed-reply-is-released (not (mcp:reply-ready? $state))))
        ($_ (mcp:accept-message $state "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":\"late\"}"))
        ($_ (nt:require late-reply-does-not-reopen-completed-call (not (mcp:reply-ready? $state))))
        ($_ (mcp:set $state "expected-id" 8))
        ($_ (mcp:accept-message $state "{\"jsonrpc\":\"2.0\",\"id\":8,\"result\":[]}"))
        ($_ (nt:require present-empty-container-is-one-result (== (collapse (mcp:wait-reply $state 8)) ((JsonArray ())))))
        ($_ (mcp:set $state "expected-id" 9))
        ($_ (mcp:stdio-lines $state ("{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":\"\xE2")))
        ($_ (nt:require incomplete-frame-is-not-completion (not (mcp:reply-ready? $state))))
        ($_ (mcp:stdio-lines $state ("\x82\xAC\"}" "")))
        ($_ (nt:require fragmented-line-keeps-its-value (== (mcp:wait-reply $state 9) "€")))
        ($_ (nt:require malformed-unicode-is-a-protocol-failure
          (mcp:failed? (mcp:stdio-lines $state ("{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":\"\xFF\"}" "")))))
        ($_ (mcp:set $state "fragment-bytes" 16777216))
        ($_ (nt:require materialization-limit-is-not-an-empty-reply
          (mcp:failed? (mcp:stdio-lines $state ("x"))))))
   (println! UNIT_MCP_REPLY_SLOT_OK))
