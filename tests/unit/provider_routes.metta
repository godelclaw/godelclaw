!(import! &self ../native_test_support.metta)
!(import! &self (library fs))
!(import! &self (library re))
!(import! &self (library str))
!(import! &self ../../src/provider_host_cetta.metta)
; A provider request is sent only when its URL lies inside the credential's
; URL scope (scripts/native_runtime_env.sh). Each route's default base must be
; the descriptor's default base, or its requests are refused before sending.
(= (routes:descriptor-base $env $text)
   (case (re:captures (re:compile (str:concat (str:concat "\\$\\{" $env) ":-([^}]*)\\}")) $text)
     (((re:match $from $to (LCons $whole (LCons (re:capture-span 1 $start $end) $more)))
       (str:byte-slice $text $start $end))
      ($none ""))))
(= (routes:check $model $env $path)
   (let* (($text (fs:read-text "scripts/native_runtime_env.sh"))
          ((ProviderRouteV1 $provider $protocol $wire $base-env $default $credential) (host-native:route $model))
          ($scope (routes:descriptor-base $env $text)))
     (nt:require (str:concat "route-default-in-credential-scope:" $provider)
       (and (== $base-env $env)
            (and (!= $scope "")
                 (str:starts-with (str:concat $default $path) (str:concat $scope "/")))))))
!(let* (($_ (routes:check "claude-sonnet-5-5" "ANTHROPIC_BASE_URL" "/messages"))
        ($_ (routes:check "openai:gpt-x" "OPENAI_BASE_URL" "/responses"))
        ($_ (routes:check "kimi:k3" "KIMI_BASE_URL" "/responses"))
        ($_ (routes:check "hf:some/model" "SYNTHETIC_BASE_URL" "/chat/completions")))
   (println! UNIT_PROVIDER_ROUTES_OK))
