; Unit tests of src/native_call_cetta.metta; no Python. The host handle is an
; inert symbol: no decision may consult it.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/native_call_cetta.metta)

(= (facts) (json:parse "{\"epoch\":\"e1\",\"correlation\":\"c1\",\"protocol\":\"chat-completions\",\"provider\":\"synthetic\",\"maximum\":42,\"purpose\":\"turn\",\"activity\":\"\",\"lane\":\"\",\"guard\":\"sequential-tools-v1\",\"origin\":{\"trigger\":\"heartbeat-event\",\"turn_id\":\"7\"},\"cap\":1048576,\"soft\":0,\"wire_model\":\"fixture-model\",\"fingerprint\":\"f00d\",\"prepared_stream\":false,\"cache_layout\":null}"))
!(let $owner (call:owner inert-host (facts) "seal-a")
   (let* (($_ (nt:require native-owner (call:native? $owner)))
          ($_ (nt:require host-handle-kept (nt:equal (call:host $owner) inert-host)))
          ($_ (nt:require seal-matches (call:seal-matches? $owner "seal-a")))
          ($_ (nt:require other-seal-refused (not (call:seal-matches? $owner "seal-b"))))
          ($_ (nt:require ready-before-claim (call:ready? $owner)))
          ($_ (nt:require first-claim (call:begin-claim $owner)))
          ($_ (nt:require replayed-claim-refused (not (call:begin-claim $owner))))
          ($_ (nt:require claimed-still-ready (call:ready? $owner)))
          ($unsent (call:policy-metadata $owner))
          ($_ (nt:require metadata-unsent (nt:equal (lp:field $unsent "sent" true) false)))
          ($_ (nt:require metadata-identity (nt:equal ((lp:field $unsent "id" "") (lp:field $unsent "epoch" "") (lp:field $unsent "model" ""))
                                                      ("c1" "e1" "fixture-model"))))
          ($_ (nt:require metadata-guard-origin (nt:equal ((lp:field $unsent "guard" "") (lp:field (lp:field $unsent "origin" ()) "trigger" ""))
                                                          ("sequential-tools-v1" "heartbeat-event"))))
          ($_ (call:submitted $owner 17))
          ($_ (nt:require owns-own-transport (call:owns? $owner "e1" "c1" 17)))
          ($_ (nt:require foreign-transport-refused (not (call:owns? $owner "e1" "c1" 18))))
          ($_ (nt:require foreign-epoch-refused (not (call:owns? $owner "e2" "c1" 17))))
          ($sent (call:policy-metadata $owner))
          ($_ (nt:require metadata-sent (nt:equal (lp:field $sent "sent" false) true)))
          ($_ (nt:require soft-elapsed-at-zero-soft (nt:equal (lp:field $sent "soft_elapsed" 0) 1)))
          ($_ (nt:require first-progress-due (nt:equal (call:progress-due $owner) (True 1))))
          ($_ (nt:require paced-progress-not-due (nt:equal (call:progress-due $owner) (False 1))))
          ($_ (nt:require progress-soft-recorded (nt:equal (lp:field (call:policy-metadata $owner) "progress_soft" 0) 1)))
          ($_ (call:retry-after $owner 2.5))
          ($_ (nt:require retry-after-recorded (nt:equal (lp:field (call:policy-metadata $owner) "retry_after" 0) 2.5)))
          ($_ (nt:require publication-once (nt:equal ((call:publication-ready $owner) (call:publication-ready $owner)) (True False))))
          ($_ (nt:require no-cache-layout-without-anthropic
                (nt:equal (lp:field (call:request-metadata $owner) "origin" ()) (lp:field $sent "origin" ())))))
     (println! UNIT_NATIVE_CALL_PHASE_OK)))
(= (other-facts) (json:parse "{\"epoch\":\"e1\",\"correlation\":\"c2\",\"cap\":1}"))
!(let $refused (call:owner inert-host (other-facts) "seal-a")
   (let* (($_ (call:refused $refused))
          ($_ (nt:require refused-not-ready (not (call:ready? $refused))))
          ($_ (nt:require refused-never-claims (not (call:begin-claim $refused))))
          ($_ (call:release $refused))
          ($_ (nt:require released-phase-removed
                (nt:equal (collapse (match &self (NativeCallPhaseV1 "c2" $phase) $phase)) ())))
          ($_ (nt:require spent-never-claims (not (call:begin-claim $refused))))
          ($_ (nt:require spent-owns-nothing (not (call:owns? $refused "e1" "c2" ())))))
     (println! UNIT_NATIVE_CALL_OK)))
; Kinds: a command answers with a program, a structured call or a compaction
; with its reply, built from the decoded result without the host.
(= (kind-facts $id $kind $purpose)
   (json:parse (format-args "{\"epoch\":\"e1\",\"correlation\":\"{}\",\"kind\":\"{}\",\"purpose\":\"{}\",\"cap\":1}" ($id $kind $purpose))))
!(let* (($command (call:owner inert-host (kind-facts "k1" "command" "turn") "s"))
        ($compaction (call:owner inert-host (kind-facts "k2" "command" "compaction") "s"))
        ($structured (call:owner inert-host (kind-facts "k3" "structured" "coding") "s"))
        ($_ (nt:require command-kind (and (call:command? $command) (not (call:replies? $command)))))
        ($_ (nt:require compaction-replies (and (call:command? $compaction) (call:replies? $compaction))))
        ($_ (nt:require structured-replies (and (not (call:command? $structured)) (call:replies? $structured))))
        ($_ (nt:require legacy-plan-is-a-command (and (call:command? legacy-plan) (not (call:replies? legacy-plan)))))
        ($legacy "{\"id\":\"x\",\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hé\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":3}}")
        ((ProviderReplyV1 $reply) (call:reply $structured $legacy))
        ($_ (nt:require reply-message (nt:equal (call:member (call:member $reply "message") "content") (JsonString "hé"))))
        ($_ (nt:require reply-finish (nt:equal (call:member $reply "finish") (JsonString "stop"))))
        ($_ (nt:require reply-usage (nt:equal (call:member (call:member $reply "usage") "prompt_tokens") (JsonNumber "3"))))
        ($_ (nt:require reply-call-id (nt:equal (call:member $reply "call_id") (JsonString "k3"))))
        ((ProviderReplyV1 $bare) (call:reply $structured "{\"choices\":[{\"message\":{},\"finish_reason\":\"length\"}],\"usage\":null}"))
        ($_ (nt:require missing-usage-is-empty (nt:equal (call:member $bare "usage") (JsonObject ()))))
        ($path (str:concat (nt:required-env "HOME") "/reply.json"))
        ($_ (call:write-reply $reply $path))
        ($_ (nt:require reply-written-utf8
              (nt:equal (fs:read-text $path)
                "{\"message\": {\"role\": \"assistant\", \"content\": \"hé\"}, \"finish\": \"stop\", \"usage\": {\"prompt_tokens\": 3}, \"call_id\": \"k3\"}")))
        ($_ (nt:require no-temporary-left (not (fs:exists (str:concat $path ".tmp")))))
        ($_ (map-atom ($command $compaction $structured) $o (call:release $o))))
   (println! UNIT_NATIVE_CALL_KINDS_OK))
