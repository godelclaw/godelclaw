!(import! &self ../native_test_support.metta)
!(import! &self ../../src/request_context.metta)
!(import! &self ../../src/provider_request_cetta.metta)
!(import! &self (library json))
; Anthropic reuses a cached prefix only at marked blocks, looking back at most
; 20 blocks, so the marks must end the shared prefix: the request index (whose
; last chunk alone a new request rewrites), the immutable transcript and the
; trusted instructions. A mark on the per-call observations or data is written
; at the cache-write price on every call and never read back.
(= (acp:context $index $data)
   (RoleContext (coding-message-list (coding-message system "S")
                  (coding-message-list (coding-message user "U") coding-messages-empty))
                "ADV" "OBS" ("H1" "H2") $index $data ""))
(= (acp:points $index)
   (json-object-get (json-parse (request:render (acp:context $index "DATA"))) "cache_points"))
(= (acp:numbers $values)
   (JsonArray (map-atom $values $v (JsonNumber (repr $v)))))
(= (acp:body $prompt)
   (case (preq:prepare-command "anthropic" "fixture" 42 "low" $prompt JsonNull "1h")
     (((PreparedProviderCommandV1 $request $encoding $cache $profile)
       (case (preq:encode "anthropic" $encoding $request)
         (((llm:v1:ok (llm:v1:wire $path $body))
           (case (preq:wire $body "anthropic" "anthropic" "command" False False $cache)
             (((PreparedProviderWireV1 $wire $active $model $layout) (preq:parse $wire)) ($bad $bad))))
          ($bad $bad)))) ($bad $bad))))
(= (acp:marked $blocks)
   (if (== $blocks ()) ()
     (let $tail (acp:marked (preq:tail $blocks))
       (if (preq:has (preq:head $blocks) "cache_control")
         (preq:cons (preq:field (preq:head $blocks) "text") $tail) $tail))))
(= (acp:marked-messages $messages)
   (if (== $messages ()) ()
     (let* (($here (acp:marked (preq:items (preq:head $messages) "content")))
            ($later (acp:marked-messages (preq:tail $messages))))
       (request:append-list $here $later))))
(= (acp:wire-marks $index $data)
   (let* (($body (acp:body (request:render (acp:context $index $data))))
          ($system (acp:marked (preq:items $body "system")))
          ($messages (acp:marked-messages (preq:items $body "messages"))))
     (request:append-list $system $messages)))
!(let* (($_ (nt:require index-chunks-marked (== (acp:points ("I1" "" "I2" "I3")) (acp:numbers (6 5 3 1)))))
        ($_ (nt:require one-chunk-index (== (acp:points ("I1")) (acp:numbers (4 3 1)))))
        ($_ (nt:require no-index (== (acp:points ()) (acp:numbers (3 1)))))
        ($marks (acp:wire-marks ("I1" "" "I2" "I3") "DATA"))
        ($_ (nt:require wire-marks-end-shared-prefix
              (== $marks ((JsonString "S") (JsonString "H2") (JsonString "I2") (JsonString "I3")))))
        ($_ (nt:require marks-ignore-per-call-data (== (acp:wire-marks ("I1" "" "I2" "I3") "DATA-2") $marks))))
   (println! UNIT_ANTHROPIC_CACHE_POINTS_OK))
