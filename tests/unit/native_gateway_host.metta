!(import! &self ../gateway_native_support.metta)
!(import! &self ../../src/execution_gateway/host_cetta.metta)
(= (gtest:state $id $state)
   (let $record (gn:await $id 300)
     (nt:require (job-terminal $id $state) (== (sf:get $record "state" "") $state))))
(= (gtest:await-running $id $left)
   (let $state (sf:get (gn:status $id) "state" "")
     (if (== $state "running") True
       (if (<= $left 0) (nt:require (job-running $id) False)
         (progn (host:wait () 10) (gtest:await-running $id (- $left 1)))))))
(= (gtest:hot-submit-config-control)
   (let* (($dir (path:join (nt:required-env "HOME") "hot-cfg-control"))
          ($_ (fs:make-directories $dir 448))
          ($tool-v1 (JsonObject ((JsonPair "command" (JsonArray ("/bin/echo" "v1")))
                      (JsonPair "effect" "read") (JsonPair "result_format" "text"))))
          ($tool-v2 (JsonObject ((JsonPair "command" (JsonArray ("/bin/echo" "v2")))
                      (JsonPair "effect" "read") (JsonPair "result_format" "text"))))
          ($cfg-v1 (JsonObject ((JsonPair "agent" "cfg-agent") (JsonPair "state_directory" $dir)
                     (JsonPair "tools" (JsonObject ((JsonPair "echo" $tool-v1)))))))
          ($cfg-v2 (JsonObject ((JsonPair "agent" "cfg-agent") (JsonPair "state_directory" $dir)
                     (JsonPair "tools" (JsonObject ((JsonPair "echo" $tool-v2)))))))
          ($_ (change-state! &ng-config $cfg-v1))
          ($_ (change-state! &ng-root-cached $dir))
          ($_ (change-state! &ng-agent-cached "cfg-agent"))
          ($_ (nt:require hot-cfg-queue-open (== (ngq:open (path:join $dir "queue.db") "cfg-agent") GatewayReadyV1)))
          ($req (JsonObject ((JsonPair "id" "cfg-job") (JsonPair "tool" "echo")
                  (JsonPair "arguments" (JsonArray ())) (JsonPair "input" (JsonObject ()))
                  (JsonPair "deadline" (+ (system:wall-time) 30)))))
          ($submit-msg (JsonObject ((JsonPair "agent" "cfg-agent") (JsonPair "version" 1)
                         (JsonPair "operation" "submit") (JsonPair "request" $req))))
          ($queued (ng:dispatch $submit-msg $cfg-v1))
          ($_ (nt:require hot-cfg-submitted-queued (== (sf:get $queued "state" "") "queued")))
          ($_ (nt:require hot-hint-populated (case (get-state &ngq-hot-submit)
                (((HotSubmittedJobV1 "cfg-job" $_ $_ $_ $_ $_ $_ $_) True) ($miss False)))))
          ($_ (change-state! &ng-config $cfg-v2))
          ($_ (ng:active-step False))
          ($after (ngq:get "cfg-job"))
          ($_ (nt:require hot-hint-refuses-changed-tool
                (and (== (sf:get $after "state" "") "failed")
                     (== (sf:get $after "error" "") "tool-configuration-changed"))))
          ($_ (ngq:close)))
     True))
(= (gtest:run)
   (let* (($config (gn:config)) ($server (gn:start $config))
          ($tools (sf:get (gn:call "tools" ()) "value" JsonNull))
          ($_ (nt:require advertised-native-and-external-tools
                (case $tools (((JsonObject $pairs) (== (size-atom $pairs) 10)) ($bad False)))))
          ($echo (JsonObject ((JsonPair "text" "(system:exit 93) 雪") (JsonPair "nested" (JsonArray ((JsonArray ())))) )))
          ($first (sf:get (gn:submit "same-id" "echo" $echo) "value" JsonNull))
          ($_ (gtest:state "same-id" "succeeded"))
          ($settled (gn:status "same-id"))
          ($again (sf:get (gn:submit "same-id" "echo" $echo) "value" JsonNull))
          ($_ (nt:require repeat-keeps-exact-receipts (== $again $settled)))
          ($_ (nt:require error-shaped-and-command-text-stay-data
                (== (sf:get (sf:get $settled "result" JsonNull) "input" JsonNull) $echo)))
          ($conflict (gn:submit "same-id" "echo" (JsonObject ())))
          ($_ (nt:require conflicting-identity-refused (== (sf:get (sf:get $conflict "error" JsonNull) "code" "") "conflict")))
          ($_ (gn:submit "project" "project-status" (JsonObject ()))) ($_ (gtest:state "project" "succeeded"))
          ($_ (gn:submit "vitals" "vitals" (JsonObject ()))) ($_ (gtest:state "vitals" "succeeded"))
          ($file (path:join (nt:required-env "HOME") "read.txt")) ($_ (fs:write $file "ALPHA\n雪\n"))
          ($_ (gn:submit "lines" "read-lines" (JsonObject ((JsonPair "path" $file) (JsonPair "count" 1)))))
          ($_ (gtest:state "lines" "succeeded"))
          ($lines (sf:get (sf:get (gn:status "lines") "result" JsonNull) "value" ""))
          ($_ (nt:require native-line-window (nt:contains $lines "ALPHA")))
          ($_ (gn:submit "tree" "ls-tree" (JsonObject ((JsonPair "path" (nt:required-env "HOME")) (JsonPair "depth" 1)))))
          ($_ (gtest:state "tree" "succeeded"))
          ($_ (gn:submit "grep" "grep-files" (JsonObject ((JsonPair "path" $file) (JsonPair "pattern" "ALPHA")))))
          ($_ (gtest:state "grep" "succeeded"))
          ($fifo (path:join (nt:required-env "HOME") "blocked-read.fifo"))
          ($_ (nt:exit-ok (proc:run ("mkfifo" "-m" "600" $fifo) (system:getcwd) inherit 2000 1024)))
          ($fifo-holder (proc:spawn ("sleep" "30") ((mode stream) (max-bytes 1024))))
          ($_ (gn:submit "blocked-fifo" "read-lines" (JsonObject ((JsonPair "path" $fifo) (JsonPair "count" 1)))))
          ($_ (gtest:await-running "blocked-fifo" 200))
          ($t-rpc0 (system:monotonic-ns))
          ($during-blocked (gn:call "tools" ()))
          ($rpc-elapsed (- (system:monotonic-ns) $t-rpc0))
          ($_ (nt:require gateway-responsive-during-blocked-read
                (and (ng-fixture:object? (sf:get $during-blocked "value" JsonNull))
                     (< $rpc-elapsed 100000000))))
          ($bad-cancel (gn:call "cancel" ((JsonPair "id" "invalid id!"))))
          ($_ (nt:require invalid-cancel-is-not-authority
                (and (== (sf:get (sf:get $bad-cancel "error" JsonNull) "code" "") "invalid-request")
                     (== (sf:get (gn:status "blocked-fifo") "state" "") "running"))))
          ($_ (gn:call "cancel" ((JsonPair "id" "blocked-fifo"))))
          ($_ (gtest:state "blocked-fifo" "cancelled"))
          ($_ (proc:cancel $fifo-holder)) ($_ (proc:await $fifo-holder)) ($_ (proc:close $fifo-holder))
          ($_ (gn:submit "large" "large-json" (JsonObject ((JsonPair "bytes" 200000)))))
          ($_ (gtest:state "large" "succeeded"))
          ($large (sf:get (gn:status "large") "result" JsonNull))
          ($_ (nt:require large-json-retained-as-artifact (and (== (sf:get $large "result_format" "") "json")
                   (> (sf:get (sf:get $large "stored_json" JsonNull) "bytes" 0) 200000))))
          ($_ (gn:submit "bad-json" "invalid-json" (JsonObject ()))) ($_ (gtest:state "bad-json" "uncertain"))
          ($_ (gn:submit "slow" "delay" (JsonObject ((JsonPair "seconds" 10)))))
          ($_ (host:wait () 100))
          ($cancel (gn:call "cancel" ((JsonPair "id" "slow"))))
          ($_ (gtest:state "slow" "cancelled"))
          ($effect (path:join (nt:required-env "HOME") "counted-effect.txt"))
          ($_ (gn:submit "owned-write" "write" (JsonObject ((JsonPair "path" $effect) (JsonPair "delay" 20)))))
          ($_ (gtest:effect-ready $effect 100))
          ($ready (sf:native-object (path:join (gn:root) "gateway-native-ready.json")))
          ($pid (sf:get $ready "pid" 0))
          ($_ (nt:require signal-only-the-owned-gateway
                (and (> $pid 1) (and (== (sf:get $ready "agent" "") "test-agent")
                                    (== (sf:get $ready "engine" "") (system:executable))))))
          ($server-pid (repr $pid))
          ($_ (nt:exit-ok (proc:run ("kill" "-TERM" $server-pid) (system:getcwd) inherit 1000 1024)))
          ($stopped (proc:await $server)) ($_ (proc:close $server))
          ($_ (nt:require requested-gateway-stop-is-clean (case $stopped
               (((proc:result (proc:exited 0) $_ $_ $_ $_) True) ($bad False)))))
          ($restarted (gn:start $config))
          ($_ (gtest:state "owned-write" "uncertain"))
          ($_ (nt:require interrupted-effect-occurs-once (== (fs:read-text $effect) "effect\n")))
          ($_ (gn:submit "owned-write" "write" (JsonObject ((JsonPair "path" $effect) (JsonPair "delay" 20)))))
          ($_ (host:wait () 100))
          ($_ (nt:require retained-write-is-never-replayed (== (fs:read-text $effect) "effect\n")))
          ($_ (nt:require forward-store-preserves-prior-results (== (sf:get (gn:status "same-id") "state" "") "succeeded")))
          ($_ (proc:cancel $restarted)) ($_ (proc:await $restarted)) ($_ (proc:close $restarted))) True))
(= (gtest:effect-ready $path $left)
   (if (fs:is-file $path) True
     (if (<= $left 0) (nt:require physical-effect-visible False)
       (progn (host:wait () 10) (gtest:effect-ready $path (- $left 1))))))
!(nt:require native-gateway-hot-config-control (gtest:hot-submit-config-control))
!(nt:require native-gateway-host-controls (gtest:run))
!(println! UNIT_NATIVE_GATEWAY_HOST_OK)
