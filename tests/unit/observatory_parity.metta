; Parity of the native observatory collector with the retained Python collector
; (lila_observatory.py), on synthetic journal entries and receipts. Python output
; for the same journal fixture was byte-identical for llm, lifecycle and turns
; (scratch run godel-obs-parity3-iq7snA). The one known divergence is the effect
; kind of MeTTa-form commands: Python records other, native records the verb.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/observatory_cetta.metta)
(= (op:e $cursor $time $message $comm)
   (json:parse-python (str:join "" ("{\"__CURSOR\":\"" $cursor "\",\"__REALTIME_TIMESTAMP\":\"" $time "\",\"MESSAGE\":" $message ",\"_COMM\":\"" $comm "\"}"))))
(= (op:sys $cursor $time $message)
   (json:parse-python (str:join "" ("{\"__CURSOR\":\"" $cursor "\",\"__REALTIME_TIMESTAMP\":\"" $time "\",\"MESSAGE\":" $message ",\"SYSLOG_IDENTIFIER\":\"systemd\",\"_COMM\":\"systemd\"}"))))
!(let* (($root (nt:required-env "HOME"))
        ($_ (change-state! &obs-options (JsonObject ((JsonPair "--data" $root) (JsonPair "--state" $root)))))
        ($receipt (path:join $root "effect-receipts.jsonl"))
        ($_ (fs:write $receipt ""))
        ($_ (obs:receipts))
        ($_ (obs:journal-entry (op:e "c1" "1795300000000000" "\"[synthetic_llm] kimi usage: in=100 cache_read=50 cache_write=10 out=20\"" "cetta")))
        ($_ (obs:journal-entry (op:e "c2" "1795300001500000" "\"[synthetic_llm] transient failure, retrying\"" "cetta")))
        ($_ (obs:journal-entry (op:e "c3" "1795300002000000" "\"engine 'cetta' failed (exit 139 segmentation fault)\"" "python3")))
        ($_ (obs:journal-entry (op:e "c4" "1795300003000000" "\"restoring stable engine petta\"" "python3")))
        ($_ (obs:journal-entry (op:e "c5" "1795300004000000" "\"(RESULTS: ((shell x)))\"" "cetta")))
        ($_ (obs:journal-entry (op:sys "c6" "1795300005000000" "\"Started pettaclaw-lila.service - Lila\"")))
        ($_ (obs:journal-entry (op:sys "c7" "1795300006000000" "\"Reached target something\"")))
        ($_ (obs:journal-entry (op:e "c8" "1795300007000000" "[97,98]" "cetta")))
        ($_ (obs:journal-entry (op:e "c9" "1795300008000000" "\"[synthetic_llm] anthropic usage: in=1234567 cache_read=2 cache_write=3 out=4\"" "cetta")))
        ($_ (obs:journal-entry (op:e "c10" "1795300009000000" "\"engine 'swipl' failed (a very long reason text that keeps going and going well past eighty characters to test truncation of the why field here)\"" "python3")))
        ($_ (obs:journal-entry (op:sys "c11" "1795300010000000" "\"Stopping pettaclaw-lila.service - Lila caf\\u00e9\"")))
        ($_ (obs:journal-entry (op:e "c12" "1795300011000000" "\"plain unrelated line\"" "cetta")))
        ($llm (fs:read-text (obs:path "llm.jsonl")))
        ($life (fs:read-text (obs:path "lifecycle.jsonl")))
        ($turns (fs:read-text (obs:path "turns.jsonl")))
        ($_ (nt:require llm-usage-row-exact (nt:contains $llm "{\"t\":1795300000.0,\"engine\":\"cetta\",\"provider\":\"kimi\",\"in\":100,\"cache_read\":50,\"cache_write\":10,\"out\":20}")))
        ($_ (nt:require llm-transient-row (nt:contains $llm "\"t\":1795300001.5,\"engine\":\"cetta\",\"transient\":true")))
        ($_ (nt:require llm-seven-digit-input (nt:contains $llm "\"in\":1234567")))
        ($_ (nt:require llm-three-rows (== (size-atom (str:split "\n" (str:trim $llm))) 3)))
        ($_ (nt:require lifecycle-engine-failed-reason (nt:contains $life "\"why\":\"exit 139 segmentation fault\"")))
        ($_ (nt:require lifecycle-restored (nt:contains $life "engine_restored_petta")))
        ($_ (nt:require lifecycle-systemd-started (nt:contains $life "Started pettaclaw-lila.service - Lila")))
        ($_ (nt:require lifecycle-systemd-noise-excluded (not (nt:contains $life "Reached target"))))
        ($_ (nt:require lifecycle-why-truncated-at-eighty (and (nt:contains $life "eighty characters t") (not (nt:contains $life "truncation"))) ))
        ($_ (nt:require turns-one-row (nt:contains $turns "\"t\":1795300004.0,\"engine\":\"cetta\"")))
        ($_ (nt:require unrelated-line-not-recorded (and (not (nt:contains $llm "unrelated")) (not (nt:contains $life "unrelated")))))
        ($metta-remember (json:parse-python "{\"recorded_at\":10.0,\"turn\":9,\"command\":\"(remember \\\"BODY_A\\\")\"}"))
        ($metta-rest (json:parse-python "{\"recorded_at\":11.0,\"turn\":9,\"command\":\"(rest 45000 \\\"BODY_B\\\")\"}"))
        ($legacy (json:parse-python "{\"recorded_at\":12.0,\"turn\":9,\"command\":\"['pin', 'BODY_C']\"}"))
        ($batch (json:parse-python "{\"recorded_at\":13.0,\"turn\":9,\"commands\":[[\"nop\"]]}"))
        ($plain (json:parse-python "{\"recorded_at\":14.0,\"turn\":9,\"command\":\"plain words\"}"))
        ($_ (obs:effect $metta-remember)) ($_ (obs:effect $metta-rest)) ($_ (obs:effect $legacy)) ($_ (obs:effect $batch)) ($_ (obs:effect $plain))
        ($eff (fs:read-text (obs:path "effects.jsonl")))
        ($_ (nt:require effect-metta-remember-kind (nt:contains $eff "\"kind\":\"remember\"")))
        ($_ (nt:require effect-metta-rest-kind (nt:contains $eff "\"kind\":\"rest\"")))
        ($_ (nt:require effect-legacy-pin-kind (nt:contains $eff "\"kind\":\"pin\"")))
        ($_ (nt:require effect-batch-kind (nt:contains $eff "\"kind\":\"batch\"")))
        ($_ (nt:require effect-plain-text-other (nt:contains $eff "\"kind\":\"other\"")))
        ($_ (nt:require effect-bodies-excluded (and (not (nt:contains $eff "BODY_A")) (and (not (nt:contains $eff "BODY_B")) (not (nt:contains $eff "BODY_C"))))))
        ($_ (obs:close-writers)))
   (println! UNIT_OBSERVATORY_PARITY_OK))
