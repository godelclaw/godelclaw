!(import! &self ../native_test_support.metta)
!(import! &self ../../modes/iter/host_cetta.metta)
; Iter's catch-up marks its cursor at the end it read, never past an append
; that is not whole: once that append is repaired and settled, the next
; catch-up brings it, and the prefix is not shown again. A torn append that
; Iter completes itself is read up to its end and not shown twice.
(= (cursor:intent $offset $payload $status)
   (let (ModeFileV1 $_ $device $inode) (mode-host:file-info (mode-history:path))
     (sf:replace (path:join (path:join (path:dirname (mode-host:root)) "omega") "native-checkpoint-v1.json")
       (turn:json (JsonObject ((JsonPair "schema" 1) (JsonPair "operation" "append") (JsonPair "status" $status)
                               (JsonPair "path" (mode-history:path)) (JsonPair "offset" $offset)
                               (JsonPair "device" $device) (JsonPair "inode" $inode)
                               (JsonPair "payload" $payload) (JsonPair "sha256" (str:sha256 $payload)))))
       384 True)))
(= (cursor:count $text $needle) (- (size-atom (str:split $needle $text)) 1))
!(let* (($history (mode-history:path))
        ($_ (fs:make-directories (mode-host:root) 448))
        ($_ (fs:make-directories (path:join (path:dirname (mode-host:root)) "omega") 448))
        ($base "SETTLED_PREFIX\n") ($bad "WRONG_TAIL\n") ($good "FIXED_TAIL\n")
        ($offset (str:byte-length $base))
        ($_ (fs:write $history (str:concat $base $bad)))
        ($_ (nt:require foreign-tail-pending (== (cursor:intent $offset $good "pending") True)))
        ($experience (ih:list))
        ($_ (ih:catch-up $experience))
        ($first (turn:json (ih:json $experience)))
        ($_ (nt:require prefix-only (and (nt:contains $first "SETTLED_PREFIX") (not (nt:contains $first "WRONG_TAIL")))))
        ($_ (nt:require cursor-at-settled-end (== (mode-history:cursor) $offset)))
        ; Repaired in place, the same identity and length, its owner settled.
        ($owner (fs:open-write $history ("truncate") 384))
        ($_ (fs:write-all $owner (str:concat $base $good))) ($_ (fs:close $owner))
        ($_ (nt:require repaired-settled (== (cursor:intent $offset $good "settled") True)))
        ($_ (ih:catch-up $experience))
        ($second (turn:json (ih:json $experience)))
        ($_ (nt:require repaired-record-arrives (nt:contains $second "FIXED_TAIL")))
        ($_ (nt:require prefix-not-repeated (== (cursor:count $second "SETTLED_PREFIX") 1)))
        ($_ (nt:require cursor-at-new-end (== (mode-history:cursor) (mode-history:size $history))))
        ; A torn append Iter can complete: completed, read once, cursor at its end.
        ($size (mode-history:size $history))
        ($torn "TORN_THEN_COMPLETED_RECORD\n")
        ($_ (cursor:intent $size $torn "pending"))
        ($writer (fs:open-write $history ("append") 384))
        ($_ (fs:write-all $writer (str:byte-slice $torn 0 7))) ($_ (fs:close $writer))
        ($_ (ih:catch-up $experience))
        ($third (turn:json (ih:json $experience)))
        ($_ (nt:require completed-read-once (== (cursor:count $third "TORN_THEN_COMPLETED_RECORD") 1)))
        ($_ (nt:require cursor-after-completed (== (mode-history:cursor) (mode-history:size $history))))
        ($_ (ih:catch-up $experience))
        ($_ (nt:require nothing-repeats (== (cursor:count (turn:json (ih:json $experience)) "TORN_THEN_COMPLETED_RECORD") 1))))
   (println! UNIT_ITER_CATCH_UP_CURSOR_OK))
