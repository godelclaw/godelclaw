; A callable name is data while formatted, not a second tool invocation.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/turn_frame_cetta.metta)
!(import! &self ../../src/text_cetta.metta)
!(import! &self ../../src/call_failure_cetta.metta)
!(import! &self ../../src/command_dispatch_hooks.metta)
!(bind! &format-effect-count (new-state 0))
(= (format-test:command)
   (progn (change-state! &format-effect-count (+ (get-state &format-effect-count) 1)) "executed"))
(= (format-test:old $value) (format-args "{}" ($value)))
(= (format-test:one $value)
   (progn (change-state! &format-effect-count (+ (get-state &format-effect-count) 1))
          ("substituted" "wrong")))
(= (format-test:old-two $name $value) (format-args "{}: {}" ($name $value)))
!(let* (($old (collapse (catch (format-test:old format-test:command))))
         ($negative (nt:require old-formatter-actually-executes-command (== (get-state &format-effect-count) 1)))
         ($reset (change-state! &format-effect-count 0))
         ($old-pair (collapse (catch (format-test:old-two format-test:one "payload"))))
         ($pair-negative (nt:require old-error-formatter-also-executes-a-command
                            (== (get-state &format-effect-count) 1)))
         ($pair-reset (change-state! &format-effect-count 0))
         ($name (turn:text format-test:command))
         ($preserved (nt:require callable-name-is-rendered-as-text (== $name "format-test:command")))
         ($decoded (nt:require shared-text-helper-does-not-execute (== (claw-text:decode-safe format-test:command) "format-test:command")))
         ($failure (nt:require failure-text-does-not-execute (== (failure:text format-test:command) "format-test:command")))
         ($health (nt:require health-text-does-not-execute (== (health:text format-test:command) "format-test:command")))
         ($error-text (dispatch:normalize (Error (python_error format-test:one "payload") diagnostic)))
         ($error-data (nt:require error-shaped-data-does-not-invoke-its-class
                         (== $error-text "format-test:one: payload")))
         ($none (nt:require metadata-formatting-has-no-command-effects (== (get-state &format-effect-count) 0)))
         ($plain (nt:require ordinary-text-stays-identical (== (turn:text "literal 雪") "literal 雪")))
         ($number (nt:require ordinary-number-stays-identical (== (turn:text 42) "42")))
         ($context (turn:put "context-incomplete" 0))
         ($result (turn:close-answered (format-test:command) "ordinary tool result"))
         ($close (nt:require non-send-receipt-remains-an-observation (== $result 0)))
         ($still-none (nt:require receipt-inspection-does-not-reexecute-command (== (get-state &format-effect-count) 0)))
         ($direct (format-test:command))
         ($witness (nt:require actual-command-call-still-executes-once
                     (and (== $direct "executed") (== (get-state &format-effect-count) 1)))))
   (println! UNIT_INERT_VALUE_FORMATTING_OK))
