!(import! &self ../native_test_support.metta)
!(import! &self (library host_io))
(= (nj:finish $owner $steps $left)
   (let $result (host:json-step $owner $steps)
     (case $result
       (((HostJsonMore $_) (if (<= $left 0) (Error json-test no-progress) (nj:finish $owner $steps (- $left 1))))
        ($terminal $terminal)))))
(= (nj:failed? $value) (case $value (((HostFailure $_ $_ $_) True) ($other False))))
(= (nj:digits $size $text)
   (if (>= (str:byte-length $text) $size) (str:byte-slice $text 0 $size)
     (nj:digits $size (str:concat $text $text))))
(= (nj:run)
   (let* (($path (path:join (nt:required-env "HOME") "cursor.json"))
          ($text "{\"a\":[0,1.2e-3,null,true,false,NaN,Infinity,-Infinity],\"a\":\"雪\\uD800\"}")
          ($_ (fs:write $path $text)) ($owner (host:json-open $path))
          ($_ (nt:require unfinished-validation-is-not-complete (case (host:json-step $owner 1) (((HostJsonMore $_) True) ($bad False)))))
          ($_ (nt:require zero-budget-refuses (nj:failed? (host:json-step $owner 0))))
          ($_ (nt:require text-requires-completed-validation (nj:failed? (host:json-text $owner 6000))))
          ($_ (nt:require one-step-resumption-covers-file (case (nj:finish $owner 1 500) (((HostJsonValid $bytes) (== $bytes (str:byte-length $text))) ($bad False)))))
          ($_ (nt:require captured-text-roundtrip (== (host:json-text $owner 6000) (HostJsonText $text))))
          ($forged (parse (repr (quote $owner))))
          ($_ (nt:require serialized-cursor-has-no-authority (nj:failed? (host:json-step $forged 10))))
          ($_ (fs:write $path "null"))
          ($_ (nt:require changed-source-revokes-completion (nj:failed? (host:json-step $owner 1))))
          ($_ (host:close $owner))
          ($_ (nt:require closed-cursor-refuses (nj:failed? (host:json-step $owner 1))))
          ($_ (fs:write $path (str:from-python-codepoints (48 0))))
          ($utf16 (host:json-open $path))
          ($_ (nt:require two-byte-utf16-json (case (nj:finish $utf16 1 20) (((HostJsonValid 2) True) ($bad False)))))
          ($_ (nt:require utf16-decoded-from-same-owned-file (== (host:json-text $utf16 8) (HostJsonText "0"))))
          ($_ (host:close $utf16))
          ($_ (fs:write $path (str:join "" ("\"\\" (str:from-python-codepoints (0)) "\""))))
          ($_ (nt:require escaped-nul-is-not-a-valid-escape (nj:failed? (host:json-file $path))))
          ($_ (fs:write $path (nj:digits 4301 "7")))
          ($_ (nt:require integer-digit-refusal-matches-native-json-policy (nj:failed? (host:json-file $path))))) True))
!(nt:require native-json-cursor-controls (nj:run))
!(println! UNIT_NATIVE_JSON_CURSOR_OK)
