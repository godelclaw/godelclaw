!(import! &self ../native_test_support.metta)
!(import! &self (library host_io))
!(import! &self ../../src/state_file_cetta.metta)
(= (ed:run)
   (let* (($b (buffer:new 100000 text)) ($_ (buffer:insert $b "ab雪c\ndef"))
          ($_ (nt:require cells-and-soft-wrap (== (buffer:viewport $b 4 3) (HostViewport ("ab雪" "c" "def") 2 3 0 3))))
          ($_ (buffer:edit $b "start")) ($_ (buffer:edit $b "right")) ($_ (buffer:insert $b "🌿"))
          ($cached (buffer:viewport $b 4 3)) ($fresh (buffer:new 100000 text))
          ($_ (buffer:insert $fresh (buffer:value $b))) ($_ (buffer:edit $fresh "start"))
          ($_ (buffer:edit $fresh "right")) ($_ (buffer:edit $fresh "right"))
          ($_ (nt:require edited-layout-cache-matches-fresh (== $cached (buffer:viewport $fresh 4 3))))
          ($_ (buffer:edit $b "end")) ($_ (buffer:edit $b "backspace"))
          ($_ (nt:require deletion-preserves-scalar-boundaries (== (buffer:value $b) "a🌿b雪c\nde")))
          ($_ (nt:require resize-reflows (case (buffer:viewport $b 2 4) (((HostViewport $rows $_ $_ $_ $total) (> $total 3)) ($bad False)))))
          ($raw (buffer:new 100000 bytes))
          ($_ (buffer:append $raw "\u001b[20"))
          ($_ (nt:require split-key-prefix-is-pending (== (buffer:input-event $raw wait) HostPending)))
          ($_ (buffer:append $raw "0~"))
          ($_ (nt:require bracketed-paste-start (== (buffer:input-event $raw wait) (HostInput "paste-start" ""))))
          ($_ (buffer:append $raw "(system:exit 91)\n雪\u001b[201"))
          ($_ (nt:require pasted-newline-is-data (== (buffer:input-event $raw wait) (HostInput "paste" "(system:exit 91)\n雪"))))
          ($_ (nt:require split-paste-terminator-is-pending (== (buffer:input-event $raw wait) HostPending)))
          ($_ (buffer:append $raw "~"))
          ($_ (nt:require bracketed-paste-end (== (buffer:input-event $raw wait) (HostInput "paste-end" ""))))
          ($_ (buffer:append $raw "\u001b[A\r"))
          ($_ (nt:require named-arrow-event (== (buffer:input-event $raw wait) (HostInput "up" ""))))
          ($_ (nt:require separate-enter-event (== (buffer:input-event $raw wait) (HostInput "enter" ""))))
          ($_ (buffer:edit $b "clear")) ($_ (buffer:insert $b "one two  "))
          ($_ (buffer:edit $b "word-left"))
          ($_ (nt:require word-left-skips-trailing-whitespace (case (buffer:info $b) (((HostBufferInfo $_ 4) True) ($bad False)))))
          ($_ (buffer:edit $b "end")) ($_ (buffer:edit $b "kill-word"))
          ($_ (nt:require backward-word-kill-retains-prefix (== (buffer:value $b) "one ")))
          ($attack (str:from-python-codepoints (65 27 91 51 49 109 66 27 93 48 59 88 7 67 8238 68)))
          ($_ (nt:require terminal-controls-and-bidi-are-inert (== (terminal:clean $attack) "ABCD")))
          ($_ (nt:require progress-cr-replaces-its-own-line (== (terminal:clean "old\rnew\r\nnext") "new\nnext")))
          ($_ (nt:require cell-truncation-keeps-width-bound (<= (terminal:cells (terminal:clip "a雪🌿bc" 5)) 5)))
          ($root (nt:required-env "HOME")) ($watch (host:watch $root))
          ($_ (fs:write (path:join $root "noticed.jsonl") "{}\n"))
          ($_ (host:wait (($watch read)) 1000))
          ($_ (nt:require changed-directory-names (case (host:changes $watch)
             (((HostChanges $names $_) (ed:member "noticed.jsonl" $names)) ($bad False)))))
          ($_ (host:close $watch)) ($_ (host:close $raw)) ($_ (host:close $b)) ($_ (host:close $fresh))) True))
(= (ed:member $name $items)
   (if (== $items ()) False (if (== $name (car-atom $items)) True (ed:member $name (cdr-atom $items)))))
!(nt:require native-editor-controls (ed:run))
!(import! &self ../../src/console/config_cetta.metta)
!(nt:require incompatible-console-actions-refused
   (case (cc:option-args ("--status" "--submit" "must not send"))
     (((CliFailureV1 $_) True) ($bad False))))
!(nt:require equal-sign-keeps-literal-argument
   (== (sf:get (cc:option-args ("--submit=(system:exit 91)=data")) "--submit" "") "(system:exit 91)=data"))
!(nt:require missing-console-value-refused
   (case (cc:option-args ("--root")) (((CliFailureV1 $_) True) ($bad False))))
!(println! UNIT_NATIVE_EDITOR_OK)
