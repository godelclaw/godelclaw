!(import! &self ../native_test_support.metta)
!(import! &self ../../src/coding_delivery.metta)
(= (report-mail:wait $owner $socket $left)
   (if (fs:exists $socket) True
     (if (<= $left 0) (system:exit 2)
       (progn (proc:wait $owner 20) (report-mail:wait $owner $socket (- $left 1))))))
(= (report-mail:envelope $id $body)
   (JsonObject ((JsonPair "id" (JsonString $id)) (JsonPair "from" (JsonString "work-native"))
     (JsonPair "to" (JsonString "receiver")) (JsonPair "space" (JsonString "unit-report"))
     (JsonPair "text" (JsonString $body)))))
!(let* (($root (nt:required-env "HOME")) ($socket (nt:required-env "METTACLAW_MAIL_SOCKET"))
        ($data (path:join $root "store")) ($core (nt:required-env "NATIVE_TEST_CORE"))
        ($service (path:join $core "cetta-space-service"))
        ($server (proc:spawn ($service "--socket" $socket "--data" $data) ((env (nt:environment $root)) (max-bytes 65536))))
        ($_ (report-mail:wait $server $socket 100))
        ($id "1234567890abcdef1234567890abcdef") ($path (path:join $root "ending.json"))
        ($_ (fs:write $path (json-stringify (report-mail:envelope $id "original report"))))
        ($_ (nt:require native-report-delivered (== (delivery:attempt $root $path) "delivered")))
        ($_ (nt:require matching-native-acceptance (delivery:accepted? (fs:read-text (str:concat $path ".accepted")) $id)))
        ($_ (fs:remove (str:concat $path ".accepted")))
        ($_ (nt:require lost-local-receipt-retries-same-id (== (delivery:attempt $root $path) "delivered")))
        ($_ (nt:require retry-was-a-native-duplicate
          (== (delivery:field (delivery:json (str:concat $path ".accepted")) "status") (JsonString "duplicate"))))
        ($view (mailbox:open $socket "unit-report"))
        ($found (mailbox:one $socket $view (MailboxMessage 1 $id $to $q $sender $body) ($to $sender $body)))
        ($_ (nt:require one-report-with-original-sender-and-body
          (case $found (((mailbox:found $revision (("receiver" "work-native" "original report"))) True) ($bad False)))))
        ($_ (fs:remove (str:concat $path ".accepted")))
        ($_ (fs:write $path (json-stringify (report-mail:envelope $id "changed report"))))
        ($_ (nt:require identity-conflict-is-still-pending (== (delivery:attempt $root $path) "pending")))
        ($_ (nt:require conflict-never-creates-acceptance (not (fs:is-file (str:concat $path ".accepted")))))
        ($_ (proc:cancel $server)) ($_ (proc:await $server)) ($_ (proc:close $server))
        ($_ (fs:write $path (json-stringify (report-mail:envelope "abcdef1234567890abcdef1234567890" "later report"))))
        ($_ (nt:require unavailable-mail-keeps-pending-occurrence (== (delivery:attempt $root $path) "pending")))
        ($_ (nt:require unavailable-mail-is-not-acceptance (not (fs:is-file (str:concat $path ".accepted"))))))
   (println! UNIT_NATIVE_CODING_REPORT_MAIL_OK))
