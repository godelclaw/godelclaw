; A refused reservation must stop both that command and the untouched suffix.
!(import! &self ../native_test_support.metta)
!(import! &self ../../src/command_dispatch_core.metta)
!(bind! &probe-effects (new-state 0))
!(bind! &probe-admit (new-state False))
(= (dispatch:env $name $default)
   (if (== $name "METTACLAW_OBSERVED_STRATEGY") "1" $default))
(= (dispatch:length $text) (str:byte-length $text))
(= (dispatch:compare $left $right) (str:compare $left $right))
(= (dispatch:stopped) 0)
(= (dispatch:reserve $turn $command)
   (if (get-state &probe-admit) 1 (Error reservation (Incomplete receipt-unavailable))))
(= (dispatch:argument-error $command) "")
(= (dispatch:normalize $result) (repr $result))
(= (dispatch:record $turn $status $command $result) 1)
(= (dispatch:capture $turn) 1)
(= (probe-effect)
   (let $next (+ (get-state &probe-effects) 1)
     (let $_ (change-state! &probe-effects $next) "executed")))
!(let* (($refused (run-command-batch-once 1 2 (quote ((probe-effect) (probe-effect)))))
        ($_ (nt:require refused-command-and-suffix-have-no-effect (== (get-state &probe-effects) 0)))
        ($_ (nt:require refusal-is-an-observable-record (nt:contains (repr (quote $refused)) "COMMAND_NOT_RUN")))
        ($_ (change-state! &probe-admit True))
        ($accepted (run-command-batch-once 2 2 (quote ((probe-effect) (probe-effect)))))
        ($_ (nt:require admitted-occurrences-each-run-once (== (get-state &probe-effects) 2)))
        ($_ (nt:require distinct-equal-commands-have-two-records (== (size-atom (quote $accepted)) 2)))
        ($_ (nt:require inspecting-records-has-no-effect (== (get-state &probe-effects) 2)))
        ($again (run-command-batch-once 2 2 (quote ((probe-effect) (probe-effect)))))
        ($_ (nt:require cached-batch-does-not-replay-effects (== (get-state &probe-effects) 2)))
        ($_ (nt:require cached-records-are-identical (== (quote $accepted) (quote $again)))))
   (println! UNIT_DISPATCH_ADMISSION_OK))
