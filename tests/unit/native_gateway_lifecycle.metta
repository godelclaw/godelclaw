!(import! &self ../gateway_native_support.metta)
(= (eof:tool $binary $effect $path)
   (JsonObject ((JsonPair "command" (JsonArray ($binary "5000" $path)))
                (JsonPair "effect" $effect) (JsonPair "result_format" "text"))))
(= (eof:submit $id $tool $seconds)
   (let $marker (path:join (nt:required-env "HOME") (str:concat $id ".eof"))
   (gn:call "submit" ((JsonPair "request" (JsonObject ((JsonPair "id" $id) (JsonPair "tool" $tool)
       (JsonPair "arguments" (JsonArray ($marker)))
       (JsonPair "input" (JsonObject ()))
       (JsonPair "deadline" (+ (system:wall-time) $seconds)))))))))
(= (eof:responsive $id)
   (let* (($started (system:monotonic-ns)) ($value (gn:status $id))
          ($elapsed (- (system:monotonic-ns) $started))
          ($ok (nt:require (responsive-after-stream-eof $id)
            (and (ng-fixture:object? $value) (< $elapsed 800000000))))) $value))
(= (eof:terminal $id $state $reason)
   (let* (($value (gn:await $id 350))
          ($checked (nt:require (preserves-deadline-or-cancellation $id)
            (and (== (sf:get $value "state" "") $state) (== (sf:get $value "error" "") $reason))))
          ($outputs (sf:get $value "outputs" JsonNull))
          ($incomplete (nt:require (interrupted-artifacts-remain-incomplete $id)
             (and (== (sf:get (sf:get $outputs "stdout" JsonNull) "complete" True) False)
                  (== (sf:get (sf:get $outputs "stderr" JsonNull) "complete" True) False))))) $value))
(= (eof:wait-started $id $path $left)
   (if (and (fs:is-file (path:join (nt:required-env "HOME") (str:concat $id ".eof")))
            (or (== $path "-") (fs:is-file $path))) True
     (if (<= $left 0) (nt:require real-child-started False)
       (progn (host:wait () 10) (eof:wait-started $id $path (- $left 1))))))
(= (eof:run)
   (let* (($home (nt:required-env "HOME")) ($binary (path:join $home "early-eof"))
          ($root (nt:required-env "TEST_REPOSITORY"))
          ($compiled (nt:exit-ok (proc:run ("cc" "-std=c11" "-O2" "-Wall" "-Wextra" "-Werror"
                     (path:join $root "tests/fixtures/gateway_early_eof.c") "-o" $binary) $root inherit 30000 65536)))
          ($effect (path:join $home "effect-count"))
          ($short (JsonObject ((JsonPair "command" (JsonArray ($binary "150" "-")))
                              (JsonPair "effect" "read") (JsonPair "result_format" "text"))))
          ($config (JsonObject ((JsonPair "agent" "test-agent") (JsonPair "state_directory" (gn:root))
            (JsonPair "tools" (JsonObject ((JsonPair "read" (eof:tool $binary "read" "-"))
                                         (JsonPair "write" (eof:tool $binary "write" $effect))
                                         (JsonPair "short" $short)))))))
          ($server (gn:start $config))
          ($success-submit (eof:submit "early-eof-success" "short" 5))
          ($success (gn:await "early-eof-success" 200))
          ($success-check (nt:require observed-termination-can-settle-success
             (and (== (sf:get $success "state" "") "succeeded")
                  (== (sf:get (sf:get (sf:get $success "outputs" JsonNull) "stdout" JsonNull) "complete" False) True))))
          ($read (eof:submit "read-deadline" "read" 1.2))
          ($started (eof:wait-started "read-deadline" "-" 100)) ($pause (host:wait () 100))
          ($pending (eof:responsive "read-deadline"))
          ($still-running (nt:require eof-does-not-claim-success (== (sf:get $pending "state" "") "running")))
          ($deadline (eof:terminal "read-deadline" "failed" "deadline"))
          ($read-cancel-submit (eof:submit "read-cancel" "read" 10))
          ($read-cancel-start (eof:wait-started "read-cancel" "-" 100))
          ($read-cancel-pause (host:wait () 100))
          ($read-responsive (eof:responsive "read-cancel"))
          ($read-cancel (gn:call "cancel" ((JsonPair "id" "read-cancel"))))
          ($read-cancelled (eof:terminal "read-cancel" "cancelled" "cancelled"))
          ($write (eof:submit "write-cancel" "write" 10))
          ($write-start (eof:wait-started "write-cancel" $effect 100)) ($write-pause (host:wait () 100))
          ($write-pending (eof:responsive "write-cancel"))
          ($cancel (gn:call "cancel" ((JsonPair "id" "write-cancel"))))
          ($cancelled (eof:terminal "write-cancel" "uncertain" "cancelled"))
          ($once (nt:require interrupted-write-occurs-once (== (fs:read-text $effect) "effect\n")))
          ($write-deadline-submit (eof:submit "write-deadline" "write" 1.2))
          ($write-deadline-start (eof:wait-started "write-deadline" "-" 100))
          ($write-deadline-pause (host:wait () 100))
          ($write-deadline-responsive (eof:responsive "write-deadline"))
          ($write-deadline (eof:terminal "write-deadline" "uncertain" "deadline"))
          ($two (nt:require independent-writes-keep-separate-occurrences
                   (== (fs:read-text $effect) "effect\neffect\n")))
          ($stop-submit (eof:submit "read-stop" "read" 10))
          ($stop-start (eof:wait-started "read-stop" "-" 100)) ($stop-pause (host:wait () 100))
          ($ready (sf:native-object (path:join (gn:root) "gateway-native-ready.json")))
          ($pid (sf:get $ready "pid" 0))
          ($verified (nt:require signal-only-owned-test-server (> $pid 1)))
          ($signalled (nt:exit-ok (proc:run ("kill" "-TERM" (repr $pid)) $root inherit 1000 1024)))
          ($ended (proc:await $server)) ($closed (proc:close $server))
          ($exit (nt:require eof-does-not-block-clean-stop
             (case $ended (((proc:result (proc:exited 0) $_ $_ $_ $_) True) ($bad False)))))
          ($restarted (gn:start $config))
          ($stopped (eof:terminal "read-stop" "failed" "gateway-stopped"))
          ($retained (nt:require interrupted-writes-are-not-replayed (== (fs:read-text $effect) "effect\neffect\n")))
          ($cancel-server (proc:cancel $restarted)) ($server-end (proc:await $restarted))
          ($server-close (proc:close $restarted))) True))
!(nt:require native-gateway-early-eof-lifecycle (eof:run))
!(println! UNIT_NATIVE_GATEWAY_LIFECYCLE_OK)
