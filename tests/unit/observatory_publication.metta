!(import! &self ../native_test_support.metta)
!(import! &self ../../src/observatory_cetta.metta)
(= (ot:root $tag)
   (let* (($root (path:join (nt:required-env "HOME") $tag)) ($_ (fs:make-directories $root 448))
          ($_ (sf:replace (path:join $root "cursor.json") "{\"journal_cursor\":\"before\"}\n" 384 True))) $root))
(= (ot:command $root $at)
   ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk"
     (path:join (nt:required-env "TEST_REPOSITORY") "tests/fixtures/observatory_publication.metta") $root $at))
(= (ot:wait $root $left)
   (if (fs:is-file (path:join $root "at-boundary.json")) True
     (if (<= $left 0) (nt:require crash-fixture-reached-physical-boundary False)
       (progn (host:wait () 10) (ot:wait $root (- $left 1))))))
(= (ot:recovery $root)
   (nt:exit-ok (proc:run (ot:command $root "recover") (system:getcwd) inherit 10000 65536)))
(= (ot:crash $at)
   (let* (($root (ot:root $at))
          ($process (proc:spawn (ot:command $root $at) ((mode stream) (max-bytes 65536) (timeout-ms 15000) (lifetime owner))))
          ($_ (proc:close-input $process))
          ($_ (host:wait () 200))
          ($_ (ot:wait $root 500))
          ($marker (sf:native-object (path:join $root "at-boundary.json"))) ($pid (sf:get $marker "pid" 0))
          ($_ (nt:require kill-only-the-owned-fixture (and (> $pid 1) (== (sf:get $marker "at" "") $at))))
          ($_ (nt:exit-ok (proc:run ("kill" "-KILL" (repr $pid)) (system:getcwd) inherit 1000 1024)))
          ($ended (proc:await $process)) ($_ (proc:close $process))
          ($_ (nt:require actual-process-termination
                (case $ended (((proc:result (proc:signaled 9) $_ $_ $_ $_) True) ($bad False)))))
          ($_ (ot:recovery $root)) ($_ (ot:recovery $root))
          ($turns (op:read (path:join $root "turns.jsonl")))
          ($cursor (sf:native-object (path:join $root "cursor.json"))))
     (if (== $at "collecting")
       (nt:require incomplete-collection-never-publishes
         (and (== $turns JsonNull) (== (sf:get $cursor "journal_cursor" "") "before")))
       (progn
         (nt:require (recovery-keeps-exact-occurrences $at)
           (== $turns "{\"t\":1,\"engine\":\"cetta\"}\n{\"t\":1,\"engine\":\"cetta\"}\n"))
         (nt:require (recovery-commits-exact-cursor $at) (== (sf:get $cursor "journal_cursor" "") "after"))
         (nt:require (recovery-retains-other-projection $at)
           (== (op:read (path:join $root "effects.jsonl")) "{\"kind\":\"shell\"}\n"))))))
(= (ot:prefix-failure $root)
   (let* (($_ (change-state! &obs-options (JsonObject ((JsonPair "--data" $root)))))
          ($_ (change-state! &obs-cursor (sf:native-object (path:join $root "cursor.json"))))
          ($_ (change-state! &obs-write-failed False)) ($_ (change-state! &obs-counts (JsonObject ())))
          ($_ (op:recover $root)) ($_ (op:begin $root))
          ($_ (obs:append "turns.jsonl" (JsonObject ((JsonPair "t" 1) (JsonPair "engine" "cetta")))))
          ($_ (obs:set-cursor "journal_cursor" "prefix"))
          ($result (obs:finish-collection True True (ObservatoryFailureV1 "unfinished record"))))
     (nt:require failed-source-keeps-publication-empty
       (and (== $result 1) (and (not (fs:is-file (path:join $root "turns.jsonl")))
         (== (sf:get (sf:native-object (path:join $root "cursor.json")) "journal_cursor" "") "before"))))))
(= (ot:prepared $root)
   (let* (($_ (fs:write (path:join $root "turns.jsonl") "{}\n"))
          ($_ (change-state! &obs-options (JsonObject ((JsonPair "--data" $root)))))
          ($_ (change-state! &obs-cursor (JsonObject ((JsonPair "journal_cursor" "after")))))
          ($_ (op:begin $root))
          ($_ (obs:append "turns.jsonl" (JsonObject ((JsonPair "t" 1) (JsonPair "engine" "cetta")))))
          ($_ (obs:close-writers)) ($prepared (op:prepare $root (get-state &obs-cursor))))
     (progn (nt:require fault-control-prepared-an-actual-receipt (== $prepared True)) (get-state &op-batch))))
(= (ot:conflict $kind)
   (let* (($root (ot:root $kind)) ($receipt (ot:prepared $root)) ($target (path:join $root "turns.jsonl"))
          ($stage (op:stage $root (sf:get $receipt "id" "") "turns.jsonl"))
          ($_ (case $kind
            (("replaced" (progn (fs:rename $target (path:join $root "old-turns")) (fs:write $target "{}\n")))
             ("truncated" (fs:write $target ""))
             ("mismatch" (fs:append-text $target "!"))
             ("extended" (fs:append-text $target (str:concat (fs:read-text $stage) "!")))
             ("stage-changed" (fs:append-text $stage "!"))
             ("cursor-changed" (fs:write (path:join $root "cursor.json") "{\"journal_cursor\":\"other\"}\n"))
             ("write-refused" (fs:set-mode $target 256)))))
          ($before (fs:read-text $target)) ($cursor-before (op:read (path:join $root "cursor.json")))
          ($one (op:recover $root)) ($two (op:recover $root))
          ($_ (nt:require (conflicting-recovery-is-explicit $kind)
               (and (case $one (((ObservatoryFailureV1 $_) True) ($bad False)))
                    (case $two (((ObservatoryFailureV1 $_) True) ($bad False))))))
          ($_ (nt:require (conflicting-recovery-preserves-evidence $kind)
               (and (== (fs:read-text $target) $before)
                    (and (== (op:read (path:join $root "cursor.json")) $cursor-before)
                         (fs:is-file (op:receipt $root))))))) True))
!(let* (($root (ot:root "retry")) ($_ (ot:prefix-failure $root)) ($_ (ot:prefix-failure $root))
         ($_ (map-atom ("collecting" "prepared" "mid-line" "between-files" "outputs-synced" "cursor-committed") $at (ot:crash $at)))
         ($_ (map-atom ("replaced" "truncated" "mismatch" "extended" "stage-changed" "cursor-changed" "write-refused") $kind (ot:conflict $kind))))
   (println! UNIT_OBSERVATORY_PUBLICATION_OK))
