!(import! &self ../native_test_support.metta)
!(import! &self ../../src/execution_gateway/native_queue_cetta.metta)
(= (queue-test:request $id $deadline)
   (JsonObject ((JsonPair "id" $id) (JsonPair "tool" "fixture") (JsonPair "arguments" (JsonArray ()))
                (JsonPair "input" (JsonObject ())) (JsonPair "deadline" $deadline))))
(= (queue-test:run)
   (let* (($path (path:join (nt:required-env "HOME") "queue.db"))
          ($opened (ngq:open $path "unit-agent"))
          ($_ (nt:require direct-native-queue-opened (== $opened GatewayReadyV1)))
          ($deadline (+ (system:wall-time) 60)) ($request (queue-test:request "first" $deadline))
          ($submitted (ngq:submit $request "fp-first" (quote write)))
          ($_ (nt:require native-submission-queued (== (sf:get $submitted "state" "") "queued")))
          ($again (ngq:submit $request "fp-first" (quote write)))
          ($_ (nt:require same-intent-keeps-original-receipt (== $again $submitted)))
          ($conflict (ngq:submit $request "fp-changed" (quote write)))
          ($_ (nt:require changed-intent-conflicts (case $conflict (((GatewayHostConflictV1 $why) True) ($bad False)))))
          ($now (system:wall-time)) ($command (GatewayClaimV1 $now))
          ($claimed (ngq:apply "fixed-claim-receipt" $command False))
          ($_ (nt:require claim-grants-one-dispatch (== $claimed (GatewayAppliedV1 (GatewayClaimedV1 "first") False))))
          ($_ (nt:require replayed-claim-grants-no-dispatch (ngq:failed? (ngq:apply "fixed-claim-receipt" $command False))))
          ($_ (ngq:finish "first" (quote succeeded) "ok" JsonNull (JsonObject ())))
          ($finished (ngq:get "first"))
          ($_ (nt:require finished-result-crosses-native-codec
            (and (== (sf:get $finished "state" "") "succeeded") (== (sf:get $finished "result" "") "ok"))))
          ($_ (ngq:submit (queue-test:request "interrupted" $deadline) "fp-second" (quote write)))
          ($next (ngq:claim))
          ($_ (nt:require next-write-was-claimed (case $next (((GatewayDispatchJobV1 $row) True) ($bad False)))))
          ($_ (ngq:recover))
          ($_ (nt:require interrupted-write-remains-uncertain (== (sf:get (ngq:get "interrupted") "state" "") "uncertain")))
          ($_ (nt:require uncertain-write-is-not-replayed (== (ngq:claim) GatewayNoJobV1)))
          ($_ (ngq:close)) ($_ (nt:require compatible-store-reopens (== (ngq:open $path "unit-agent") GatewayReadyV1)))
          ($_ (nt:require reopened-result-is-preserved (== (sf:get (ngq:get "first") "result" "") "ok")))
          ($_ (ngq:close))) True))
!(nt:require native-queue-controls-completed (queue-test:run))
!(println! UNIT_NATIVE_GATEWAY_QUEUE_OK)
