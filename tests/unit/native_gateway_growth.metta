!(import! &self ../gateway_native_support.metta)
!(import! &self ../../src/cli_values_cetta.metta)
(= (growth:read $count)
   (if (<= $count 0) True
     (let $reply (gn:call "tools" ())
       (if (ng-fixture:object? (sf:get $reply "value" JsonNull)) (growth:read (- $count 1))
         (nt:require repeated-native-gateway-read False)))))
(= (growth:counter $text $name)
   (let* (($pattern (re:compile (str:concat $name "=([0-9]+)")))
          ($match (re:captures $pattern $text)) ($digits (re:group-text $match $text 1))
          ($_ (re:close $pattern)))
     (cli:number $digits -1)))
(= (growth:sample $count)
   (let* (($root (nt:required-env "TEST_REPOSITORY")) ($path (path:join (nt:required-env "HOME") "gateway.json"))
          ($_ (sf:replace $path (json:stringify-python (gn:config)) 384 True))
          ($binary (system:executable)) ($entry (path:join $root "scripts/execution_gateway_cetta.metta"))
          ($job (proc:spawn ($binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk"
                   $entry "--config" $path)
                 ((lifetime owner) (env (inherit (("CETTA_PETTA_MACHINE_STATS" "1")))) (max-bytes 262144) (timeout-ms 60000))))
          ($_ (nt:require growth-host-is-ready (ng-fixture:object? (sf:get (gn:ready 200) "value" JsonNull))))
          ($_ (growth:read $count))
          ($ready (sf:native-object (path:join (gn:root) "gateway-native-ready.json"))) ($pid (sf:get $ready "pid" 0))
          ($_ (nt:require stop-only-the-owned-growth-host
                (and (> $pid 1) (and (== (sf:get $ready "agent" "") "test-agent") (== (sf:get $ready "engine" "") $binary)))))
          ($_ (nt:exit-ok (proc:run ("kill" "-TERM" (repr $pid)) $root inherit 2000 1024)))
          ($result (proc:await $job)) ($_ (proc:close $job)))
     (case $result
       (((proc:result (proc:exited 0) $_ $_ $err $_)
         (let* (($peak (growth:counter $err "max_binding_entries"))
                ($scans (growth:counter $err "binding_apply_environment_entries"))
                ($_ (nt:require real-binding-counters-present (and (> $peak 0) (> $scans 0)))))
           (GatewayGrowthV1 $count $peak $scans)))
        ($failed (progn (println! (GROWTH_HOST_FAILED $failed)) (system:exit 1)))))))
!(let* (((GatewayGrowthV1 $_ $peak-a $scans-a) (growth:sample 100))
         ((GatewayGrowthV1 $_ $peak-b $scans-b) (growth:sample 400))
         ((GatewayGrowthV1 $_ $peak-c $scans-c) (growth:sample 1600))
         ($_ (nt:require live-bindings-do-not-follow-request-history (<= $peak-c (* 2 (max $peak-a $peak-b)))))
         ($_ (nt:require repeated-read-work-remains-linear (<= $scans-c (* 6 $scans-b))))
         ($_ (println! (GATEWAY_GROWTH_RECEIPT $peak-a $peak-b $peak-c $scans-a $scans-b $scans-c))))
   (println! UNIT_NATIVE_GATEWAY_GROWTH_OK))
