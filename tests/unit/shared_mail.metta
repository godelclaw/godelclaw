; Round trips of the native claw-mail client against the real space service,
; with a staged member account. Each case gets a fresh service, set up as the
; owner grants it (the shared agent bus, then the account's inbox) and then
; run as seen by a member. The client is scripts/claw_mail_cetta.metta.
!(import! &self ../native_test_support.metta)
!(import! &self (library json))
!(import! &self (library list))

(= (sm:sh $script $args) (nt:exit-ok (proc:run (list:append ("sh" "-c" $script "mail") $args) "/" inherit 10000 65536)))
(= (sm:uid) (str:strip-python (sm:sh "id -u" ())))
(= (sm:login) (str:strip-python (sm:sh "id -un" ())))
(= (sm:other-uid) (if (== (sm:uid) "65534") "65533" "65534"))
(= (sm:core) (nt:required-env "NATIVE_TEST_CORE"))
(= (sm:engine) (path:join (sm:core) "cetta"))
(= (sm:root) (nt:required-env "TEST_REPOSITORY"))
(= (sm:socket $dir) (path:join $dir "service.sock"))
(= (sm:env $dir $extra)
   (list:append (("PATH" "/usr/bin:/bin") ("HOME" $dir) ("LANG" "C.UTF-8")) $extra))
(= (sm:wait-for $owner $path $left)
   (if (fs:exists $path) True
     (if (<= $left 0) (let $_ (println! (MAIL_SERVICE_NOT_READY $path)) (system:exit 2))
       (let $_ (proc:wait $owner 10) (sm:wait-for $owner $path (- $left 1))))))
(= (sm:start $dir $member)
   (let* (($socket (sm:socket $dir))
          ($argv (list:append ((path:join (sm:core) "cetta-space-service") "--socket" $socket "--data" (path:join $dir "store"))
                              (if $member ("--owner-uid" (sm:other-uid)) ())))
          ($service (proc:spawn $argv ((env (sm:env $dir ())) (max-bytes 65536))))
          ($_ (sm:wait-for $service $socket 500)))
     $service))
(= (sm:stop $service $dir)
   (let* (($_ (proc:cancel $service)) ($_ (proc:await $service)) ($_ (proc:close $service))
          ($socket (sm:socket $dir)) ($_ (if (fs:exists $socket) (fs:remove $socket) True)))
     True))
(= (sm:sleep $seconds) (proc:run ("sleep" $seconds) "/" inherit 10000 64))
; A fixture program with SOCKET, INBOX and UID filled in.
(= (sm:raw $dir $code)
   (let* (($text (str:join (repr (sm:socket $dir)) (str:split "SOCKET" $code)))
          ($text2 (str:join (repr (str:concat "mail@" (sm:login))) (str:split "INBOX" $text)))
          ($text3 (str:join (sm:uid) (str:split "UID" $text2)))
          ($path (path:join $dir "fixture.metta"))
          ($_ (fs:write $path (str:concat "!(import! &self mailbox)\n!(import! &self str)\n" $text3))))
     (nt:exit-ok (proc:run ((sm:engine) "--lang" "petta" "--quiet" $path) $dir (sm:env $dir ()) 10000 1048576))))
(= (sm:argv $dir $args)
   (list:append ((sm:engine) "--no-results" "--lang" "petta" (path:join (sm:root) "scripts/claw_mail_cetta.metta")
                 "--config" (path:join $dir "no-config.toml") "--json" "--socket" (sm:socket $dir)) $args))
; Run the client; the exit code must be $expected. Answers (code stdout stderr).
(= (sm:run $dir $args $extra)
   (case (proc:run (sm:argv $dir $args) $dir (sm:env $dir $extra) 20000 1048576)
     (((proc:exited $code $out $err) ($code $out $err)) ($other (-1 "" (repr $other))))))
(= (sm:cli $dir $args $extra $expected)
   (let ($code $out $err) (sm:run $dir $args $extra)
     (if (== $code $expected) (json:parse-python $out)
       (let $_ (println! (MAIL_CLI_EXIT $args $code $out $err)) (MailCliExit $code)))))
; One equation: in PeTTa every matching equation applies.
(= (sm:get $object $key) (case $object (((JsonObject $pairs) (sm:find $pairs $key)) ($other (Missing $key)))))
(= (sm:find $pairs $key)
   (if (== $pairs ()) (Missing $key) (let (JsonPair $k $v) (car-atom $pairs) (if (== $k $key) $v (sm:find (cdr-atom $pairs) $key)))))
(= (sm:status $answer) (sm:get $answer "status"))
(= (sm:idle? $answer) (== $answer (JsonObject ((JsonPair "status" "idle")))))
(= (sm:reply $dir $message $ident $agent)
   (sm:raw $dir (str:join "" ("!(mailbox:send SOCKET INBOX " (repr $ident) " " (repr $agent) " \"fixture-agent\" " (repr $message) ")\n"))))
(= (sm:spawn-cli $dir $args $extra)
   (proc:spawn (sm:argv $dir $args) ((cwd $dir) (env (sm:env $dir $extra)) (max-bytes 1048576) (timeout-ms 30000))))
(= (sm:finish $owner)
   (let* (($_ (proc:close-input $owner)) ($result (proc:await $owner)) ($_ (proc:close $owner)))
     (case $result
       (((proc:result (proc:exited $code) $how $out $err $capture) ($code $out $err))
        ($other (-1 "" (repr $other)))))))
; A fresh case directory with the owner's grants in place, served to a member.
(= (sm:case $name)
   (let* (($dir (path:join (nt:required-env "HOME") $name)) ($_ (fs:make-directories $dir 448))
          ($owner (sm:start $dir False))
          ($_ (sm:raw $dir "!(let $space (mailbox:open SOCKET \"agent-mail\")
 (space:grant SOCKET $space (account UID) (rights append)
  (bundle (MailboxMessage 1 $id $to \"\" (from (caller) $agent) $body)
          (MailboxPending 1 $to \"\" (from (caller) $agent) $id))
  (MailboxMessage 1 $id $c $q (from (caller) $a) $b)))
!(let $space (mailbox:open SOCKET INBOX)
 (space:grant SOCKET $space (account UID) (rights write) none none))
"))
          ($_ (sm:stop $owner $dir)))
     (MailCase $dir (sm:start $dir True))))

(= (sm:identity)
   (let* (((MailCase $dir $service) (sm:case "identity"))
          ($env (("LOGNAME" "someone-else") ("USER" "someone-else") ("USERNAME" "someone-else")))
          ($who (sm:cli $dir ("whoami") $env 0))
          ($_ (sm:reply $dir "reply" "reply-1" "reviewer"))
          ($next (sm:cli $dir ("next" "reviewer") $env 0))
          ($_ (sm:stop $service $dir)))
     (and (== (sm:get $who "uid") (parse (sm:uid)))
     (and (== (sm:get $who "account") (sm:login))
     (and (== (sm:get $who "role") "member")
     (and (== (sm:get $who "inbox") (str:concat "mail@" (sm:login)))
          (== (sm:status $next) "delivery")))))))

(= (sm:fixed-id)
   (let* (((MailCase $dir $service) (sm:case "fixed-id"))
          ($args ("send" "reviewer" "fixture-agent" "hello" "--id" "one"))
          ($first (sm:cli $dir $args () 0)) ($second (sm:cli $dir $args () 0))
          ($refused (sm:cli $dir ("send" "reviewer" "fixture-agent" "changed" "--id" "one") () 1))
          ($_ (sm:stop $service $dir)))
     (and (== $first (JsonObject ((JsonPair "status" "accepted") (JsonPair "id" "one"))))
     (and (== $second (JsonObject ((JsonPair "status" "duplicate") (JsonPair "id" "one"))))
          (nt:contains (sm:get $refused "reason") "id-conflict")))))

(= (sm:ungranted)
   (let* (((MailCase $dir $service) (sm:case "ungranted"))
          ($result (sm:cli $dir ("--space" "missing" "send" "reviewer" "receiver" "hello") () 1))
          ($_ (sm:stop $service $dir)))
     (and (== (sm:status $result) "error")
     (and (nt:contains (sm:get $result "reason") "missing-space") (not (== (sm:get $result "id") ""))))))

(= (sm:owner-retry)
   (let* (((MailCase $dir $member) (sm:case "owner-retry")) ($_ (sm:stop $member $dir)) ($service (sm:start $dir False))
          ($text "λ \"quoted\"\\text\nsecond line")
          ($args ("send" "reviewer" (str:concat (sm:login) "/fixture-agent") $text "--id" "owned-one"))
          ($accepted (sm:cli $dir $args () 0))
          ($inbox (sm:cli $dir ("inbox" "fixture-agent") () 0))
          ($delivery (sm:cli $dir ("next" "fixture-agent") () 0))
          ($again (sm:cli $dir $args () 0))
          ($ack (sm:cli $dir ("ack" "fixture-agent" "owned-one") () 0))
          ($after (sm:cli $dir $args () 0))
          ($idle (sm:cli $dir ("next" "fixture-agent") () 0))
          ($_ (sm:stop $service $dir)))
     (and (== (sm:status $accepted) "accepted")
     (and (== (sm:get $inbox "count") 1)
     (and (== (sm:get $delivery "id") "owned-one")
     (and (== (sm:get $delivery "text") $text)
     (and (== (sm:status $again) "duplicate")
     (and (== (sm:status $ack) "settled")
     (and (== (sm:status $after) "duplicate") (sm:idle? $idle))))))))))

(= (sm:legacy-space)
   (let* (((MailCase $dir $member) (sm:case "legacy-space")) ($_ (sm:stop $member $dir)) ($service (sm:start $dir False))
          ($_ (sm:cli $dir ("--space" "agent-mail" "send" "reviewer" "fixture-agent" "legacy") () 0))
          ($raw (sm:raw $dir "!(println! (mailbox:next SOCKET \"agent-mail\" \"fixture-agent\"))"))
          ($inbox (sm:cli $dir ("inbox" "fixture-agent") () 0))
          ($_ (sm:stop $service $dir)))
     (and (nt:contains $raw "mailbox:delivery") (== (sm:get $inbox "count") 0))))

(= (sm:bare-recipient)
   (let* (((MailCase $dir $member) (sm:case "bare-recipient")) ($_ (sm:stop $member $dir)) ($service (sm:start $dir False))
          ($_ (sm:cli $dir ("send" "reviewer" "fixture-agent" "native peer") () 0))
          ($raw (sm:raw $dir "!(println! (mailbox:next SOCKET \"agent-mail\" \"fixture-agent\"))"))
          ($inbox (sm:cli $dir ("inbox" "fixture-agent") () 0))
          ($_ (sm:stop $service $dir)))
     (and (nt:contains $raw "mailbox:delivery") (== (sm:get $inbox "count") 0))))

(= (sm:survives-restart)
   (let* (((MailCase $dir $service) (sm:case "survives-restart"))
          ($text "λ \"quotes\"\n{\"status\":\"accepted\"}\n!(println! injected)")
          ($_ (sm:reply $dir $text "reply-1" "reviewer"))
          ($first (sm:cli $dir ("next" "reviewer") () 0))
          ($again (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:stop $service $dir)) ($back (sm:start $dir True))
          ($after (sm:cli $dir ("next" "reviewer") () 0))
          ($ack (sm:cli $dir ("ack" "reviewer" (sm:get $first "id")) () 0))
          ($ack2 (sm:cli $dir ("ack" "reviewer" (sm:get $first "id")) () 0))
          ($idle (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:stop $back $dir)))
     (and (== (sm:get $first "text") $text)
     (and (== (sm:get $first "from") "fixture-agent")
     (and (== $again $first) (and (== $after $first)
     (and (== (sm:status $ack) "settled") (and (== (sm:status $ack2) "duplicate") (sm:idle? $idle)))))))))

(= (sm:bounded-wait)
   (let* (((MailCase $dir $service) (sm:case "bounded-wait"))
          ($start (system:monotonic-ns))
          ($quiet (sm:cli $dir ("wait" "reviewer" "--timeout" ".05") () 3))
          ($elapsed (- (system:monotonic-ns) $start))
          ($waiting (sm:spawn-cli $dir ("wait" "reviewer" "--timeout" "3") ()))
          ($_ (sm:sleep "0.1"))
          ($_ (sm:reply $dir "reply" "reply-1" "reviewer"))
          (($code $out $err) (sm:finish $waiting))
          ($result (json:parse-python $out))
          ($again (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:stop $service $dir)))
     (and (sm:idle? $quiet) (and (< $elapsed 3000000000)
     (and (== $code 0) (and (== (sm:status $result) "delivery") (== $again $result)))))))

(= (sm:rechecks)
   (let* (((MailCase $dir $service) (sm:case "rechecks"))
          ($waiting (sm:spawn-cli $dir ("wait" "reviewer" "--timeout" "3") ()))
          ($_ (sm:sleep "0.1"))
          ($_ (sm:reply $dir "someone else" "other" "other-agent"))
          ($_ (sm:sleep "0.1"))
          ($_ (sm:reply $dir "mine" "reply-1" "reviewer"))
          (($code $out $err) (sm:finish $waiting))
          ($_ (sm:stop $service $dir)))
     (and (== $code 0) (== (sm:get (json:parse-python $out) "text") "mine"))))

(= (sm:disconnected)
   (let* (((MailCase $dir $service) (sm:case "disconnected")) ($_ (sm:stop $service $dir))
          ($result (sm:cli $dir ("next" "reviewer") () 1)))
     (== (sm:status $result) "error")))

(= (sm:default-agent)
   (let* (((MailCase $dir $service) (sm:case "default-agent"))
          ($env (("CLAW_MAIL_AGENT" "default-reviewer")))
          ($sent (sm:cli $dir ("send" "fixture-agent" "hello") $env 0))
          ($_ (sm:reply $dir "reply" "reply-1" "default-reviewer"))
          ($next (sm:cli $dir ("next") $env 0))
          ($other (sm:cli $dir ("inbox" "someone-else") $env 0))
          ($ack (sm:cli $dir ("ack" "reply-1") $env 0))
          ($inbox (sm:cli $dir ("inbox") $env 0))
          ($_ (sm:stop $service $dir)))
     (and (== (sm:status $sent) "accepted") (and (== (sm:status $next) "delivery")
     (and (== (sm:get $other "count") 0) (and (== (sm:status $ack) "settled") (== (sm:get $inbox "count") 0)))))))

(= (sm:states $items) (map-atom $items $item (sm:get $item "state")))
(= (sm:preview)
   (let* (((MailCase $dir $service) (sm:case "preview"))
          ($_ (sm:reply $dir "first" "r1" "reviewer")) ($_ (sm:reply $dir "second" "r2" "reviewer"))
          ($preview (sm:cli $dir ("inbox" "reviewer" "--limit" "1") () 0))
          ($again (sm:cli $dir ("inbox" "reviewer" "--limit" "1") () 0))
          ($count (sm:run $dir ("inbox" "reviewer" "--count") ()))
          ($notice (sm:run $dir ("inbox" "reviewer" "--notice") ()))
          ($first (sm:cli $dir ("next" "reviewer") () 0))
          ($later (sm:cli $dir ("inbox" "reviewer") () 0))
          ($same (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:cli $dir ("ack" "reviewer" (sm:get $first "id")) () 0))
          ($second (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:cli $dir ("ack" "reviewer" (sm:get $second "id")) () 0))
          ($quiet (sm:run $dir ("inbox" "reviewer" "--notice") ()))
          ($_ (sm:stop $service $dir))
          ((JsonArray $items) (sm:get $preview "items"))
          ((JsonArray $later-items) (sm:get $later "items")))
     (and (== (sm:get $preview "count") 2)
     (and (== (sm:get $preview "truncated") True)
     (and (== (sm:states $items) ("pending"))
     (and (== $again $preview)
     (and (== $count (0 "2\n" ""))
     (and (== (index-atom $notice 0) 0) (and (nt:contains (index-atom $notice 1) "2 unacknowledged")
     (and (== (sm:get $later "count") 2) (and (== (sm:states $later-items) ("ready" "pending"))
     (and (== $same $first) (and (== (index-atom $quiet 0) 0) (== (index-atom $quiet 1) ""))))))))))))))

(= (sm:forever-restart)
   (let* (((MailCase $dir $service) (sm:case "forever-restart"))
          ($waiting (sm:spawn-cli $dir ("wait" "reviewer" "--forever") ()))
          ($_ (sm:sleep "0.12")) ($_ (sm:stop $service $dir)) ($_ (sm:sleep "0.12"))
          ($back (sm:start $dir True))
          ($_ (sm:reply $dir "after restart" "reply-1" "reviewer"))
          (($code $out $err) (sm:finish $waiting))
          ($inbox (sm:cli $dir ("inbox" "reviewer") () 0))
          ($_ (sm:stop $back $dir)))
     (and (== $code 0) (and (== (sm:get (json:parse-python $out) "text") "after restart") (== (sm:get $inbox "count") 1)))))

(= (sm:classify $dir $reason)
   (let* (($path (path:join $dir "classify.metta"))
          ($_ (fs:write $path (str:join "" ("!(import! &self " (repr (path:join (sm:root) "scripts/shared_mail.metta")) ")\n"
                                            "!(shared-mail:print (space:unavailable \"test\" " $reason "))\n"))))
          ($out (nt:exit-ok (proc:run ((sm:engine) "--no-results" "--lang" "petta" $path) $dir (sm:env $dir ()) 10000 65536)))
          ($last (car-atom (filter-atom (sm:reverse (str:split "\n" $out) ()) $l (not (== $l "")))))
          ($value (json:parse-python $last))
          ($result (if (== (get-metatype $value) Grounded) (json:parse-python $value) $value)))
     ((sm:status $result) (sm:get $result "retryable"))))
(= (sm:reverse $xs $acc) (if (== $xs ()) $acc (sm:reverse (cdr-atom $xs) (cons-atom (car-atom $xs) $acc))))
(= (sm:retry-classes)
   (let $dir (path:join (nt:required-env "HOME") "classes")
     (let $_ (fs:make-directories $dir 448)
       (and (== (sm:classify $dir "disconnect") ("error" True))
       (and (== (sm:classify $dir "connect") ("error" True))
       (and (== (sm:classify $dir "timeout-or-disconnect") ("error" True))
       (and (== (sm:classify $dir "permission-denied") ("error" False))
            (== (sm:classify $dir "malformed-reply") ("error" False)))))))))

(= (sm:lost-reply)
   (let* (((MailCase $dir $service) (sm:case "lost-reply"))
          ($_ (sm:reply $dir "recover this delivery" "reply-1" "reviewer"))
          ($first (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:stop $service $dir))
          ($waiting (sm:spawn-cli $dir ("wait" "reviewer" "--timeout" "6") ()))
          ($_ (sm:sleep "0.3"))
          ($back (sm:start $dir True))
          (($code $out $err) (sm:finish $waiting))
          ($inbox (sm:cli $dir ("inbox" "reviewer") () 0))
          ($_ (sm:stop $back $dir)))
     (and (== (sm:status $first) "delivery")
     (and (== $code 0)
     (and (nt:contains $err "mail temporarily unavailable; retry 1/8")
     (and (== (json:parse-python $out) $first) (== (sm:get $inbox "count") 1)))))))

(= (sm:zero-timeout)
   (let* (((MailCase $dir $service) (sm:case "zero-timeout"))
          ($waiting (sm:spawn-cli $dir ("wait" "reviewer" "--timeout" "0") ()))
          ($_ (sm:sleep "0.1"))
          ($still (case (proc:poll $waiting) (((proc:running $x) True) (proc:pending True) ($other (Finished $other)))))
          ($_ (sm:reply $dir "reply" "reply-1" "reviewer"))
          (($code $out $err) (sm:finish $waiting))
          ($_ (sm:stop $service $dir)))
     (and (== $still True) (and (== $code 0) (== (sm:status (json:parse-python $out)) "delivery")))))

(= (sm:bounded-failure)
   (let* (((MailCase $dir $service) (sm:case "bounded-failure")) ($_ (sm:stop $service $dir))
          ($result (sm:cli $dir ("wait" "reviewer" "--forever" "--retry-limit" "0") () 1)))
     (== (sm:get $result "retryable") True)))

(= (sm:summary)
   (let* (((MailCase $dir $service) (sm:case "summary"))
          ($text "hello\x1b[31m λ\nsecond line")
          ($_ (sm:reply $dir $text "reply-1" "reviewer"))
          ($argv (filter-atom (sm:argv $dir ("next" "reviewer")) $part (not (== $part "--json"))))
          ($out (nt:exit-ok (proc:run $argv $dir (sm:env $dir ()) 5000 65536)))
          ($lines (filter-atom (str:split "\n" $out) $l (not (== $l ""))))
          ($first-line (car-atom $lines))
          ($value (json:parse-python (car-atom (sm:reverse $lines ()))))
          ($_ (sm:stop $service $dir)))
     (and (nt:contains $first-line (str:concat "id=" (sm:get $value "id")))
     (and (nt:contains $first-line (str:concat "from=" (sm:get $value "from")))
     (and (nt:contains $first-line "hello")
     (and (not (nt:contains $first-line "\x1b"))
     (and (not (nt:contains $first-line "second line")) (== (sm:get $value "text") $text))))))))

(= (sm:roundtrip)
   (let* (((MailCase $dir $service) (sm:case "roundtrip"))
          ($text "λ \"quoted\"\\text\n\t\b\f\x1b[31m")
          ($_ (sm:cli $dir ("--space" (str:concat "mail@" (sm:login)) "send" "reviewer" "reviewer" $text) () 0))
          ($next (sm:cli $dir ("next" "reviewer") () 0))
          ($_ (sm:stop $service $dir)))
     (== (sm:get $next "text") $text)))

(= (sm:member-pickup)
   (let* (((MailCase $dir $member) (sm:case "member-pickup"))
          ($args ("send" "reviewer" "fixture-agent" "hello" "--id" "member-one"))
          ($accepted (sm:cli $dir $args () 0))
          ($_ (sm:stop $member $dir)) ($owner (sm:start $dir False))
          ($raw (sm:raw $dir "!(println! (mailbox:next SOCKET \"agent-mail\" \"fixture-agent\"))"))
          ($_ (sm:stop $owner $dir)) ($back (sm:start $dir True))
          ($again (sm:cli $dir $args () 0))
          ($refused (sm:cli $dir ("send" "reviewer" "fixture-agent" "changed" "--id" "member-one") () 1))
          ($_ (sm:stop $back $dir)))
     (and (== (sm:status $accepted) "accepted") (and (nt:contains $raw "mailbox:delivery")
     (and (== (sm:status $again) "duplicate") (nt:contains (sm:get $refused "reason") "id-conflict"))))))

(= (sm:own-inbox)
   (let* (((MailCase $dir $service) (sm:case "own-inbox"))
          ($args ("send" "observer" (str:concat (sm:login) "/fixture-agent") "alert" "--id" "own-one"))
          ($accepted (sm:cli $dir $args () 0)) ($dup (sm:cli $dir $args () 0))
          ($inbox (sm:cli $dir ("inbox" "fixture-agent") () 0))
          ($delivery (sm:cli $dir ("next" "fixture-agent") () 0))
          ($dup2 (sm:cli $dir $args () 0))
          ($ack (sm:cli $dir ("ack" "fixture-agent" "own-one") () 0))
          ($_ (sm:stop $service $dir)) ($back (sm:start $dir True))
          ($dup3 (sm:cli $dir $args () 0))
          ($idle (sm:cli $dir ("next" "fixture-agent") () 0))
          ($refused (sm:cli $dir ("send" "observer" (str:concat (sm:login) "/fixture-agent") "changed" "--id" "own-one") () 1))
          ($_ (sm:stop $back $dir)))
     (and (== (sm:status $accepted) "accepted") (and (== (sm:status $dup) "duplicate")
     (and (== (sm:get $inbox "count") 1)
     (and (== (sm:get $delivery "id") "own-one") (and (== (sm:get $delivery "text") "alert")
     (and (== (sm:status $dup2) "duplicate") (and (== (sm:status $ack) "settled")
     (and (== (sm:status $dup3) "duplicate") (and (sm:idle? $idle) (nt:contains (sm:get $refused "reason") "conflict"))))))))))))

; Six concurrent senders of one id store one message.
(= (sm:race $dir $to $ident)
   (let* (($runs (map-atom (1 2 3 4 5 6) $i (sm:spawn-cli $dir ("send" "observer" $to "alert" "--id" $ident) ())))
          ($results (map-atom $runs $run (sm:finish $run)))
          ($statuses (map-atom $results $r (sm:status (json:parse-python (index-atom $r 1))))))
     (and (== (size-atom (filter-atom $statuses $s (== $s "accepted"))) 1)
          (== (size-atom (filter-atom $statuses $s (== $s "duplicate"))) 5))))
(= (sm:concurrent)
   (let* (((MailCase $dir $service) (sm:case "concurrent"))
          ($own (sm:race $dir (str:concat (sm:login) "/fixture-agent") "own-race"))
          ($bus (sm:race $dir "fixture-agent" "bus-race"))
          ($inbox (sm:cli $dir ("inbox" "fixture-agent") () 0))
          ($_ (sm:stop $service $dir)))
     (and $own (and $bus (== (sm:get $inbox "count") 1)))))

(= (sm:install $destination $extra)
   (case (proc:run (list:append ("sh" (path:join (sm:root) "scripts/install_claw_mail.sh") "--engine" (sm:engine)
                                 "--bin-dir" (path:join $destination "bin") "--skill-dir" (path:join $destination "skills")) $extra)
                   (sm:root) (sm:env $destination ()) 10000 65536)
     (((proc:exited $code $out $err) $code) ($other -1))))
(= (sm:relative-config)
   (let* (((MailCase $dir $service) (sm:case "relative-config"))
          ($installed (sm:install (path:join $dir "installed") ()))
          ($_ (fs:write (path:join $dir "mail.toml") "socket = \"service.sock\"\ncetta = \"./engine\"\nagent = \"reviewer\"\n"))
          ($_ (sm:sh "ln -s \"$1/installed/bin/claw-mail\" \"$1/claw-mail\"; ln -s \"$2\" \"$1/engine\"" ($dir (sm:engine))))
          ($result (proc:run ((path:join $dir "claw-mail") "--config" (path:join $dir "mail.toml") "inbox" "--count")
                             (sm:root) (sm:env $dir ()) 5000 65536))
          ($_ (sm:stop $service $dir)))
     (and (== $installed 0) (case $result (((proc:exited 0 "0\n" $err) True) ($other (let $_ (println! (RELATIVE_CONFIG $other)) False)))))))

(= (sm:installation)
   (let* (((MailCase $dir $service) (sm:case "installation"))
          ($destination (path:join $dir "installed")) ($config (path:join $destination "mail.toml"))
          ($extra ("--config" $config "--socket" (sm:socket $dir) "--agent" "reviewer"))
          ($installed (sm:install $destination $extra))
          ($mode (str:strip-python (sm:sh "stat -c %a \"$1\"" ($config))))
          ($launcher (str:strip-python (sm:sh "readlink -f \"$1/bin/claw-mail\"" ($destination))))
          ($share (str:strip-python (sm:sh "readlink -f \"$1/share/claw-mail\"" ($destination))))
          ($same (sm:sh "d=$(dirname \"$1\"); cmp -s \"$d/claw_mail_cetta.metta\" \"$2/scripts/claw_mail_cetta.metta\" && cmp -s \"$d/shared_mail.metta\" \"$2/scripts/shared_mail.metta\" && echo same" ($launcher (sm:root))))
          ($result (proc:run ((path:join $destination "bin/claw-mail") "--config" $config "inbox" "--count") $destination (sm:env $dir ()) 5000 65536))
          ($before (fs:read-text $config))
          ($again (sm:install $destination $extra))
          ($_ (sm:stop $service $dir)))
     (and (== $installed 0) (and (== $mode "600")
     (and (str:starts-with $launcher (str:concat $share "/"))
     (and (nt:contains (fs:read-text $launcher) (sm:engine))
     (and (nt:contains $same "same")
     (and (fs:exists (path:join $destination "skills/claw-mail/SKILL.md"))
     (and (case $result (((proc:exited 0 "0\n" $err) True) ($other False)))
     (and (== $again 2) (== (fs:read-text $config) $before)))))))))))

(= (sm:invalid-arguments)
   (let* (((MailCase $dir $service) (sm:case "invalid-arguments"))
          ($codes (map-atom (("send" "account/agent" "receiver" "text") ("wait" "reviewer" "--timeout" "-1") ("wait" "reviewer" "--timeout" "nan"))
                            $args (index-atom (sm:run $dir $args ()) 0)))
          ($_ (sm:stop $service $dir)))
     (== $codes (2 2 2))))

(= (sm:deadline)
   (let* (($dir (path:join (nt:required-env "HOME") "deadline")) ($_ (fs:make-directories $dir 448))
          ($start (system:monotonic-ns))
          (($code $out $err) (case (proc:run (list:append ((sm:engine) "--no-results" "--lang" "petta" (path:join (sm:root) "scripts/claw_mail_cetta.metta")
                                                          "--config" (path:join $dir "no-config.toml") "--socket" (path:join $dir "absent.sock") "--json")
                                                         ("wait" "reviewer" "--timeout" "0.7"))
                                             $dir (sm:env $dir ()) 10000 65536)
                               (((proc:exited $c $o $e) ($c $o $e)) ($other (-1 "" "")))))
          ($elapsed (- (system:monotonic-ns) $start))
          ($retries (filter-atom (str:split "\n" $err) $l (nt:contains $l "temporarily unavailable")))
          ($second-wait (parse (let $tail (car-atom (sm:reverse (str:split " in " (index-atom $retries 1)) ())) (str:byte-slice $tail 0 (- (str:byte-length $tail) 1))))))
     (and (== $code 1) (and (== (sm:get (json:parse-python $out) "retryable") True)
     (and (== (size-atom $retries) 2)
     (and (str:ends-with (index-atom $retries 0) "retry 1/8 in 0.5s")
     (and (< $second-wait 0.5)
     (and (>= $elapsed 650000000) (< $elapsed 5000000000)))))))))

(= (sm:terminal-refusal)
   (let* (($dir (path:join (nt:required-env "HOME") "terminal")) ($_ (fs:make-directories $dir 448))
          ($service (sm:start $dir True))
          (($code $out $err) (case (proc:run (list:append ((sm:engine) "--no-results" "--lang" "petta" (path:join (sm:root) "scripts/claw_mail_cetta.metta")
                                                          "--config" (path:join $dir "no-config.toml") "--socket" (sm:socket $dir) "--json")
                                                         ("wait" "reviewer" "--forever"))
                                             $dir (sm:env $dir ()) 10000 65536)
                               (((proc:exited $c $o $e) ($c $o $e)) ($other (-1 "" "")))))
          ($_ (sm:stop $service $dir)))
     (and (== $code 1) (and (nt:contains (sm:get (json:parse-python $out) "reason") "missing-space")
                            (not (nt:contains $err "temporarily unavailable"))))))

!(let* (($_ (nt:require identity-and-inbox-ignore-the-environment-login (sm:identity)))
         ($_ (nt:require a-fixed-send-id-is-duplicate-and-a-conflicting-body-refused (sm:fixed-id)))
         ($_ (nt:require an-ungranted-space-is-a-failure-exit (sm:ungranted)))
         ($_ (nt:require an-owner-retry-after-pickup-does-not-requeue (sm:owner-retry)))
         ($_ (nt:require an-explicit-legacy-space-is-kept (sm:legacy-space)))
         ($_ (nt:require a-bare-recipient-uses-the-native-agent-bus (sm:bare-recipient)))
         ($_ (nt:require a-delivery-survives-restart-and-needs-its-ack (sm:survives-restart)))
         ($_ (nt:require a-wait-is-bounded-and-does-not-ack (sm:bounded-wait)))
         ($_ (nt:require a-wait-rechecks-after-another-channel-wakes-it (sm:rechecks)))
         ($_ (nt:require a-disconnected-service-is-an-error (sm:disconnected)))
         ($_ (nt:require the-default-agent-and-an-explicit-override (sm:default-agent)))
         ($_ (nt:require preview-count-and-notice-neither-take-nor-ack (sm:preview)))
         ($_ (nt:require a-forever-wait-recovers-from-a-restart (sm:forever-restart)))
         ($_ (nt:require transport-failures-retry-and-protocol-refusals-do-not (sm:retry-classes)))
         ($_ (nt:require a-lost-wait-reply-recovers-the-same-delivery (sm:lost-reply)))
         ($_ (nt:require a-zero-timeout-waits-until-mail (sm:zero-timeout)))
         ($_ (nt:require a-persistent-wait-failure-is-bounded (sm:bounded-failure)))
         ($_ (nt:require the-summary-matches-json-and-injects-no-terminal-controls (sm:summary)))
         ($_ (nt:require sent-text-roundtrips-controls-and-unicode (sm:roundtrip)))
         ($_ (nt:require a-member-retry-after-pickup-is-duplicate (sm:member-pickup)))
         ($_ (nt:require an-own-inbox-retry-is-one-message (sm:own-inbox)))
         ($_ (nt:require concurrent-retries-store-one-message (sm:concurrent)))
         ($_ (nt:require relative-config-paths-work-elsewhere-and-through-a-link (sm:relative-config)))
         ($_ (nt:require installation-links-and-a-private-account-config (sm:installation)))
         ($_ (nt:require bad-routes-and-wait-budgets-are-refused (sm:invalid-arguments)))
         ($_ (nt:require transient-failures-keep-a-finite-deadline (sm:deadline)))
         ($_ (nt:require a-terminal-refusal-does-not-retry (sm:terminal-refusal))))
   (println! UNIT_SHARED_MAIL_OK))
