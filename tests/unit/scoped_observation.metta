; Scoped Empty reports through real native storage, in both extended dialects.
; Each case seeds a fresh knowledge store in-process, then runs its program on
; the engine in a guest per dialect (PeTTa and HE), which saves its result as
; CAV1 bytes; the result is decoded here and checked. Binary evidence keeps
; dialect-dependent printing out of the checks. "Empty" is compared by its
; text: the bare symbol means no result in PeTTa source.
!(import! &self ../native_test_support.metta)
!(import! &self ../support/knowledge_store_probe.metta)
!(import! &self (library list))

(= (so:root) (nt:required-env "TEST_REPOSITORY"))
(= (so:engine) (path:join (nt:required-env "NATIVE_TEST_CORE") "cetta"))
(= (so:at $x $i) (index-atom $x $i))
(= (so:at2 $x $i $j) (index-atom (index-atom $x $i) $j))
(= (so:empty-head? $x) (and (== (get-metatype $x) Expression) (== (repr (car-atom $x)) "Empty")))
(= (so:vals $x) (if (and (== (get-metatype $x) Expression) (== (car-atom $x) ObservationValuesV1)) (index-atom $x 3) (NotValues $x)))
(= (so:range $i $n) (if (>= $i $n) () (cons-atom $i (so:range (+ $i 1) $n))))
(= (so:all $results $ok) (== (filter-atom $results $r (not (so:check $ok $r))) ()))

; A fresh store with $seeds applied, one application each: (Store path epoch).
(= (so:store $name $seeds)
   (let* (($dir (path:join (nt:required-env "HOME") $name)) ($path (path:join $dir "store"))
          ($_ (fs:make-directories $path 448))
          ((KnowledgeReadyV1 $epoch $revision) (knowledge-probe:run (Create $path)))
          ($_ (so:seed $path $seeds 1)))
     (Store $dir $path $epoch)))
(= (so:seed $path $seeds $n)
   (if (== $seeds ()) True
     (let* (($changes ((car-atom $seeds)))
            ($answer (knowledge-probe:run (At $path (KnowledgeApplyV1 () (Receipt $n) (Edit $changes) (Accepted $n) $changes 1048576))))
            ($_ (if (== (car-atom $answer) KnowledgeCommittedV1) True (println! (SEED_REFUSED $answer)))))
       (so:seed $path (cdr-atom $seeds) (+ $n 1)))))
; parse reads data unevaluated: seed values stay as written.
(= (so:data $text) (parse $text))

(= (so:read-bytes $file)
   (let* (($h (fs:open-read $file)) ($chunk (fs:read-chunk $h 16777216)) ($_ (fs:close $h)))
     (case $chunk (((fs:chunk $bytes $more) $bytes) ($other (Unread $other))))))
; Run $body in the guest of dialect $lang; answers the decoded result.
(= (so:guest $store $tag $body $lang)
   (let* (((Store $dir $path $epoch) $store)
          ($source (path:join $dir (str:join "" ("observe-" $tag "-" $lang ".metta"))))
          ($result (path:join $dir (str:join "" ("result-" $tag "-" $lang ".cav1"))))
          ($_ (fs:write $source (str:join "" (
                "!(import! &self " (repr (path:join (so:root) "tests/support/scoped_observation_probe.metta")) ")\n"
                "(= (observation-probe:body $owner $view $epoch $revision) " $body ")\n"
                "!(let (StoreOpened $owner) (store:open " (repr $path) " \"existing\")\n"
                " (let (StoreSnapshot $view $epoch $revision) (store:snapshot $owner)\n"
                "  (let* (($out (observation-probe:body $owner $view $epoch $revision))\n"
                "         ($discarded1 (observation-probe:save " (repr $result) " $out))\n"
                "         ($discarded2 (collapse (store:close $view)))\n"
                "         ($discarded3 (collapse (store:close $owner))))\n"
                "    (println! \"SCOPED_OBSERVATION_OK\"))))\n"))))
          ($run (proc:run ((so:engine) "--lang" $lang "--profile" "extended" "--import-mode" "relative" $source)
                          (so:root) (nt:environment $dir) 45000 4194304))
          ($out (case $run (((proc:exited 0 $o $e) $o) ($other (let $_ (println! (GUEST_FAILED $tag $lang $other)) "")))))
          ($_ (if (and (nt:contains $out "SCOPED_OBSERVATION_OK") (fs:exists $result)) True (println! (GUEST_UNFINISHED $tag $lang $out)))))
     (if (fs:exists $result)
         (case (store:decode (so:read-bytes $result)) (((StoreDecoded $value) $value) ($bad (Undecoded $bad))))
         (NoResult $tag $lang))))
(= (so:both $store $tag $body) ((so:guest $store $tag $body "petta") (so:guest $store $tag $body "he")))
; Check each result; report the first one that fails.
(= (so:each $tag $results $check)
   (let $bad (filter-atom $results $r (not (so:ok $check $r)))
     (if (== $bad ()) True (let $_ (println! (SCOPED_CHECK_FAILED $tag (car-atom $bad))) False))))

; --- the checks, one per case: (so:ok CHECK RESULT) ---
(= (so:ok (Missing $epoch) $r)
   (and (so:empty-head? (so:at $r 1)) (and (== (so:at2 $r 1 1) (so:at $r 3))
   (and (== (so:vals (so:at $r 2)) ()) (and (== (so:at2 $r 3 0) ObservationIndexV1) (== (so:at2 $r 3 2) $epoch))))))
(= (so:ok (ValueKept $value) $r)
   (and (== (store:encode (so:vals (so:at $r 1))) (store:encode ($value)))
        (and (== (so:at $r 2) ()) (== (so:at $r 3) ObservationClosedV1))))
(= (so:ok Materialization $r) (and (== (so:at2 $r 1 0) Incomplete) (== (so:at2 $r 1 2) materialization-limit)))
(= (so:ok ByteCapIsNotSearch $r) (so:empty-head? $r))
(= (so:ok Fault $r)
   (and (== (so:at2 $r 1 0) Faulted) (and (== (car-atom (so:at2 $r 2 0)) ObservationDiagnosticV1) (== (index-atom (so:at2 $r 2 0) 2) permission))))
(= (so:ok Choice $r)
   (and (== (so:vals (so:at $r 1)) ("x" "x" "y"))
   (and (== (get-metatype (so:at2 $r 1 2)) Expression) (and (== (car-atom (so:at2 $r 1 2)) ObservationOpenV1)
   (and (== (so:at2 $r 2 0) Incomplete) (== (so:at $r 3) (a)))))))
(= (so:ok Reconcile $r)
   (and (== (so:vals (so:at $r 1)) ("x" "x")) (and (== (so:at2 $r 2 0) ObservationRefusedV1) (== (so:at2 $r 2 1) scope-mismatch))))
(= (so:ok BoundScopes $r)
   (and (== (so:at2 $r 1 0) KnowledgeReadScopesV2)
   (and (== (so:at2 $r 2 0) KnowledgeRefusedV1) (and (== (so:at2 $r 3 0) KnowledgeRefusedV1) (== (so:at2 $r 4 0) KnowledgeRefusedV1)))))
(= (so:ok Refused $r) (== (car-atom $r) ObservationRefusedV1))
(= (so:ok MalformedChoice $r)
   (and (== (so:vals (so:at $r 1)) ("x"))
   (and (== (size-atom (so:at $r 2)) 2)
   (and (not (== (index-atom (so:at2 $r 3 0) 1) (index-atom (so:at2 $r 3 1) 1)))
        (== (index-atom (so:at2 $r 4 2) 2) (ObservationOpenV1 invalidated no-resume))))))
(= (so:ok FaultOne $r) (and (== (so:at2 $r 1 0) Faulted) (== (size-atom (so:at $r 2)) 1)))
(= (so:ok TwoFaults $r) (and (== (so:at2 $r 1 0) Faulted) (== (so:at2 $r 2 0) Faulted)))
(= (so:ok Descriptor $r) (and (== (so:at2 $r 1 0) ObservationRefusedV1) (nt:contains (so:at $r 2) "unavailable descriptor")))
(= (so:ok Insertion $r)
   (and (so:empty-head? (so:at $r 1)) (and (== (so:at2 $r 2 0) KnowledgeCommittedV1) (== (so:at $r 3) (StoreRefused conflict)))))
(= (so:ok Distinct $r)
   (and (== (so:at $r 1) ())
   (and (== (size-atom (so:at $r 2)) 1) (and (so:empty-head? (so:at2 $r 2 0))
   (and (== (repr (so:at $r 3)) "(())")
   (and (case (store:decode (so:at2 $r 4 1)) (((StoreDecoded $syntax) (== (repr $syntax) "(+ 1 2)")) ($bad False)))
   (and (== (so:at2 $r 5 0) NotObserved)
   (and (== (size-atom (so:at2 $r 6 1)) 2) (== (index-atom (so:at2 $r 6 1) 0) (index-atom (so:at2 $r 6 1) 1))))))))))
(= (so:ok Epsilon $r)
   (and (== (so:at2 $r 1 0) Observed)
   (and (let $values (so:vals (so:at $r 2))
          (and (== (size-atom $values) 1)
               (let $first (car-atom $values)
                 (and (== (index-atom $first 0) RegexOccurrenceV1) (and (== (index-atom $first 1) 0) (== (index-atom $first 2) 0))))))
   (and (so:empty-head? (so:at $r 3)) (and (== (so:at2 $r 4 0) Faulted) (== (so:at2 $r 5 0) ObservationRefusedV1))))))
(= (so:ok RangeZero $r)
   (and (== (so:at2 $r 1 0) Incomplete) (and (== (so:at2 $r 2 0) Incomplete)
   (and (== (so:vals (so:at $r 3)) ("A" "A")) (and (== (so:vals (so:at $r 4)) ("A" "A" "B"))
   (and (== (so:at2 $r 4 2) ObservationClosedV1) (and (== (so:at2 $r 5 0) ObservationReportV1)
   (and (== (so:at $r 6) NoObservationContinuationV1) (== (so:at2 $r 7 0) Faulted)))))))))
(= (so:ok RangeBytes $r)
   (and (== (so:at2 $r 1 2) materialization-limit)
   (and (== (so:vals (so:at $r 2)) ("long payload")) (and (== (so:vals (so:at $r 3)) ("long payload"))
   (and (== (so:at2 $r 4 1) cancelled) (and (== (so:at2 $r 5 0) Faulted)
        (== (index-atom (so:at2 $r 6 2) 3) (RequiredBytesV1 12))))))))
(= (so:ok RangeCapacity $r)
   (and (== (so:at2 $r 1 0) ObservationRefusedV1) (and (== (so:at2 $r 1 1) cursor-capacity)
   (and (== (so:at2 $r 2 0) ObservationRefusedV1) (and (== (so:at2 $r 2 1) cursor-capacity)
   (and (== (so:at2 $r 3 0) Faulted) (and (== (so:at2 $r 4 0) taken)
   (and (== (size-atom (so:at2 $r 4 1)) 1) (so:empty-head? (so:at $r 5))))))))))
(= (so:ok NegativePremises $r)
   (and (== (so:at2 $r 1 1) negative-dependency-conflict)
   (and (== (so:at2 $r 2 1) progress-regressed) (== (so:at2 $r 3 1) not-started-with-occurrences))))
(= (so:ok ManyValues $r) (== (so:vals $r) (list:repeat 129 "v")))
(= (so:ok Boundaries $r)
   (and (== (so:vals (so:at $r 1)) ("old")) (and (== (so:at2 $r 1 2) ObservationClosedV1)
   (and (== (so:at $r 2) (so:at $r 3)) (== (so:at2 $r 4 0) Compacted)))))
(= (so:ok Budgets $r)
   (and (== (filter-atom (1 2 3 4) $i (not (== (so:at2 $r $i 0) ObservationRefusedV1))) ()) (so:empty-head? (so:at $r 5))))
(= (so:ok Inert $r)
   (and (or (== (so:at $r 1) True) (or (== (repr (so:at $r 1)) "true") (== (repr (so:at $r 1)) "True")))
        (== (so:at2 $r 2 1) scope-mismatch)))
(= (so:ok Overlap $r)
   (and (== (so:vals (so:at $r 1)) ("equal" "equal" "last")) (and (== (so:at $r 2) (a b)) (== (so:at2 $r 3 0) Incomplete))))
(= (so:ok OverlapRefused $r)
   (and (== (filter-atom (1 2 3) $i (not (== (so:at2 $r $i 0) ObservationRefusedV1))) ())
   (and (== (so:at2 $r 1 1) occurrence-conflict)
   (and (== (so:at2 $r 2 1) occurrence-order-conflict) (== (so:at2 $r 3 1) closed-observation-changed)))))
(= (so:ok Explanation $r) (and (nt:contains $r "witnesses=2") (nt:contains $r "faults=1")))
(= (so:ok RegexPolicy $r)
   (and (== (so:at2 $r 1 0) Faulted) (and (== (index-atom (so:at2 $r 2 0) 2) descriptor-codec)
        (== (so:at2 $r 3 3) (NativeRegexFindV1 (UnicodeBaseV1 (so:at $r 4)))))))

; --- the cases ---
(= (so:case-missing)
   (let* (($s (so:store "missing" ((so:data "(KnowledgePutV1 \"other\" \"present\")")))) ((Store $d $p $epoch) $s))
     (so:each missing (so:both $s "missing" "(let $r (kb:read-report $view \"missing\" 1048576) (Results (obs:status $r) (obs:values $r) (obs:scope $r)))") (Missing $epoch))))

(= (so:value-texts) ("()" "(Container)" "(Error \"source\" \"ordinary\")" "(+ 1 2)" "(Empty \"nested\")"))
(= (so:case-values)
   (let* (($values (map-atom (so:value-texts) $t (so:data $t)))
          ($seeds (map-atom (so:range 0 5) $i (so:data (str:join "" ("(KnowledgePutV1 \"" (repr $i) "\" " (index-atom (so:value-texts) $i) ")")))))
          ($s (so:store "values" $seeds)))
     (== (filter-atom (so:range 0 5) $i
           (not (so:each values (so:both $s (str:concat "values-" (repr $i))
                                  (str:join "" ("(let $r (kb:read-report $view \"" (repr $i) "\" 1048576) (Results (obs:values $r) (obs:diagnostics $r) (obs:coverage $r)))")))
                         (ValueKept (index-atom $values $i)))))
         ())))

(= (so:case-materialization)
   (let $s (so:store "materialization" ((so:data "(KnowledgePutV1 \"present\" \"payload\")")))
     (and (so:each materialization (so:both $s "limit" "(let $r (kb:read-report $view \"present\" 0) (Results (obs:status $r) (obs:coverage $r)))") Materialization)
          (so:each byte-cap (so:both $s "absent" "(obs:status (kb:read-report $view \"absent\" 0))") ByteCapIsNotSearch))))

(= (so:case $name $body $check) (let $s (so:store $name ()) (so:each $name (so:both $s $name $body) $check)))

(= (so:many-events) (str:join " " (map-atom (so:range 0 129) $i (format-args "(ObservationWitnessV1 (id {}) (ObservationBytesV1 \"v\"))" ($i)))))

(= (so:case-declared-empty)
   (let* (($s (so:store "declared-empty" ()))
          ($petta (so:guest $s "declared" "(Results (collapse Empty) (collapse (Empty index)))" "petta"))
          ($he (so:guest $s "declared" "(Results (collapse Empty) (collapse (Empty index)))" "he")))
     (and (== (repr (so:at $petta 1)) "(Empty)")
     (and (== (so:at $he 1) ())
     (and (== (repr (so:at $petta 2)) "((Empty index))") (== (repr (so:at $he 2)) "((Empty index))"))))))

!(let* (($_ (nt:require a-missing-key-in-a-nonempty-store-is-scoped-empty (so:case-missing)))
         ($_ (nt:require unit-empty-error-shaped-and-active-looking-data-are-values (so:case-values)))
         ($_ (nt:require a-materialization-limit-is-incomplete-even-with-no-allowance (so:case-materialization)))
         ($_ (nt:require a-fault-is-structured-and-never-empty
               (so:case "fault" "(let $r (obs:point-result scope \"x\" (StoreRefused permission)) (Results (obs:status $r) (obs:diagnostics $r)))" Fault)))
         ($_ (nt:require choice-keeps-three-witnesses-and-pending-coverage
               (so:case "choice" "(let* (($left (ObservationReportV1 a () ObservationClosedV1 (a)))
          ($right (ObservationReportV1 b
           ((ObservationWitnessV1 one (ObservationBytesV1 \"x\"))
            (ObservationWitnessV1 two (ObservationBytesV1 \"x\"))
            (ObservationWitnessV1 three (ObservationBytesV1 \"y\")))
           (ObservationOpenV1 budget token) ()))
          ($r (obs:choice $left $right))) (Results (obs:values $r) (obs:status $r) (obs:dependencies $r)))" Choice)))
         ($_ (nt:require reconciliation-is-not-choice-and-another-scope-is-refused
               (so:case "reconcile" "(let* (($a (ObservationReportV1 scope
          ((ObservationWitnessV1 one (ObservationBytesV1 \"x\"))) (ObservationOpenV1 budget token) ()))
          ($b (ObservationReportV1 scope
          ((ObservationWitnessV1 one (ObservationBytesV1 \"x\"))
           (ObservationWitnessV1 two (ObservationBytesV1 \"x\"))) ObservationClosedV1 ()))
          ($other (ObservationReportV1 other () ObservationClosedV1 (other))))
          (Results (obs:values (obs:reconcile $a $b)) (obs:reconcile $a $other)))" Reconcile)))
         ($_ (nt:require bound-revalidation-rejects-forgery-wrong-view-and-wire-data
               (so:case "bound" "(let* (($bound (kb:observe-report $view \"missing\" 1048576))
          ($report (kb:observation-report $bound))
          ($valid (kb:report-scopes-on $view $bound))
          ($wire (kb:report-scopes-on $view $report))
          ((KnowledgeObservationOnV1 $held $identity $budget $old) $bound)
          ($fake (KnowledgeObservationOnV1 $held $identity $budget
             (ObservationReportV1 (obs:scope $old)
               ((ObservationWitnessV1 fake (ObservationBytesV1 \"invented\"))) ObservationClosedV1 ())))
          ($forged (kb:report-scopes-on $view $fake))
          ((StoreSnapshot $other $other-epoch $other-revision) (store:snapshot $owner))
          ($wrong (kb:report-scopes-on $other $bound))
          ($discarded4 (collapse (store:close $other)))) (Results $valid $wire $forged $wrong))" BoundScopes)))
         ($_ (nt:require bad-events-and-value-codecs-are-refusals
               (and (so:case "bad-junk" "(obs:values (ObservationReportV1 scope ((ObservationWitnessV1 good (ObservationBytesV1 \"x\")) (Junk 1)) ObservationClosedV1 ()))" Refused)
               (and (so:case "bad-cav1" "(obs:values (ObservationReportV1 scope ((ObservationWitnessV1 good (ObservationBytesV1 \"x\")) (ObservationWitnessV1 bad (ObservationCav1V1 \"bad\"))) ObservationClosedV1 ()))" Refused)
                    (so:case "bad-tag" "(obs:values (ObservationReportV1 scope ((ObservationWitnessV1 good (ObservationBytesV1 \"x\")) (ObservationWitnessV1 bad (ObservationCav1V1 \"CAV1?\"))) ObservationClosedV1 ()))" Refused)))))
         ($_ (nt:require choice-keeps-malformed-events-as-distinct-faults
               (so:case "malformed" "(let* (($a (ObservationReportV1 a ((Junk 1) (Junk 2)) ObservationClosedV1 ()))
          ($b (ObservationReportV1 b ((ObservationWitnessV1 id (ObservationBytesV1 \"x\")))
                 (ObservationOpenV1 invalidated no-resume) ())) ($r (obs:choice $a $b)))
          (Results (obs:values $r) (obs:diagnostics $r) (obs:events $r) (obs:coverage $r)))" MalformedChoice)))
         ($_ (nt:require no-or-ambiguous-native-reply-is-a-fault
               (and (so:case "no-reply" "(let $r (obs:point-answers scope \"x\" ()) (Results (obs:status $r) (obs:diagnostics $r)))" FaultOne)
                    (so:case "two-replies" "(let $r (obs:point-answers scope \"x\" (StoreAbsent StoreAbsent)) (Results (obs:status $r) (obs:diagnostics $r)))" FaultOne))))
         ($_ (nt:require an-owner-handle-and-a-closed-snapshot-make-no-absence
               (so:case "handles" "(let* (($wrong (obs:lookup $owner \"missing\" 1024))
          ($discarded5 (collapse (store:close $view))) ($closed (obs:lookup $view \"missing\" 1024)))
          (Results (obs:status $wrong) (obs:status $closed)))" TwoFaults)))
         ($_ (nt:require failed-descriptor-coding-stays-explicit
               (so:case "descriptor" "(Results (obs:index $view query region $view \"id\")
          (obs:describe-index (ObservationIndexV1 domain epoch 0 \"bad\" \"bad\" \"bad\" run)))" Descriptor)))
         ($_ (nt:require an-insertion-invalidates-absence-dependent-publication
               (so:case "insertion" "(let* (($id (system:uuid4-hex))
          ($bound (kb:observe-report $view $id 1048576))
          ($before (obs:status (kb:observation-report $bound)))
          ((KnowledgeReadScopesV2 $reads) (kb:report-scopes-on $view $bound))
          ($first (kb:publish $owner $view (reads) (WriterReceipt $id) write done
                    ((KnowledgePutV1 $id \"present\")) 1048576))
          ($late (kb:publish $owner $view $reads (LateReceipt $id) derive done
                    ((KnowledgePutV1 (Derived $id) \"must not land\")) 1048576)))
          (Results $before $first $late))" Insertion)))
         ($_ (nt:require zero-empty-unit-syntax-and-not-observed-stay-distinct
               (so:case "distinct" "(let* (($report (kb:read-report $view \"missing\" 1024))
          ($index (obs:scope $report)) ($syntax (obs:syntax (+ 1 2))))
          (Results (collapse (superpose ())) (collapse (obs:status $report))
           (collapse (function (return ()))) $syntax
           (obs:status (obs:undemanded $index))
           (obs:negative-grade ($report $report))))" Distinct)))
         ($_ (nt:require epsilon-is-one-success-and-no-match-is-scoped-empty
               (so:case "epsilon" "(let* (($yes (obs:regex-find (re:pattern \"\") \"\"))
          ($no (obs:regex-find (re:pattern \"x\") \"\"))
          ($fault (obs:regex-find (re:pattern \"[\") \"\")))
          (Results (obs:status $yes) (obs:values $yes) (obs:status $no)
            (obs:status $fault) (obs:negative-grade ($yes))))" Epsilon)))
         ($_ (nt:require a-range-keeps-duplicates-through-zero-work-and-resumption
               (so:case "range-zero" "(let* (((StoreSnapshot $updated $e $r)
          (store:commit $owner $view (ops (put \"a\" \"A\") (put \"b\" \"A\") (put \"c\" \"B\"))))
          ((ObservationStepV1 $initial $c0) (obs:open-range $updated NoBound NoBound 4))
          ($discarded6 (collapse (store:close $updated)))
          ((ObservationStepV1 $zero $c1) (obs:step $c0 0 100))
          ((ObservationStepV1 $first $c2) (obs:step $c1 2 100))
          ((ObservationStepV1 $finished $none) (obs:step $c2 8 100))
          ((ObservationStepV1 $reused $nothing) (obs:step $c1 8 100)))
          (Results (obs:status $initial) (obs:status $zero) (obs:values $first)
            (obs:values $finished) (obs:reconcile $first $finished)
            $none (obs:status $reused)))" RangeZero)))
         ($_ (nt:require a-range-byte-limit-retry-and-cancel-keep-the-prefix
               (so:case "range-bytes" "(let* (((StoreSnapshot $updated $e $r)
          (store:commit $owner $view (ops (put \"a\" \"long payload\") (put \"b\" \"B\"))))
          ((ObservationStepV1 $initial $c0) (obs:open-range $updated NoBound NoBound 2))
          ((ObservationStepV1 $limited $c1) (obs:step $c0 1 0))
          ((ObservationStepV1 $partial $c2) (obs:step $c1 1 100))
          ((ObservationStepV1 $cancelled $none) (obs:cancel $c2))
          ((ObservationStepV1 $late $no) (obs:step $c2 5 100))
          ($discarded7 (collapse (store:close $updated))))
          (Results (obs:status $limited) (obs:values $partial)
            (obs:values $cancelled) (obs:coverage $cancelled) (obs:status $late) (obs:coverage $limited)))" RangeBytes)))
         ($_ (nt:require range-resource-limits-and-unissued-work-refuse
               (so:case "range-capacity" "(let* (((ObservationStepV1 $initial $c0) (obs:open-range $view NoBound NoBound 1))
          ($refused (obs:open-range $view NoBound NoBound 1))
          ($zero (obs:open-range $view NoBound NoBound 0))
          ($fake (work-new (FabricatedState would-execute-if-forced)))
          ((ObservationStepV1 $bad $none) (obs:step (ObservationCursorV2 $fake) 1 100))
          ($untouched (work-take $fake 1)) ($discarded8 (collapse (work-cancel $fake)))
          ($discarded9 (obs:cancel $c0))
          ((ObservationStepV1 $after $c1) (obs:open-range $view NoBound NoBound 1))
          ((ObservationStepV1 $empty $end) (obs:step $c1 1 100)))
          (Results $refused $zero (obs:status $bad) $untouched (obs:status $empty)))" RangeCapacity)))
         ($_ (nt:require reconciliation-keeps-negative-premises-and-refuses-regression
               (so:case "premises" "(let* (($a (ObservationReportV1 scope () (ObservationOpenV1 budget residual) (first)))
          ($lost (ObservationReportV1 scope () (ObservationOpenV1 budget residual) ()))
          ($regressed (ObservationReportV1 scope () ObservationNotStartedV1 (first)))
          ($bad (ObservationReportV1 scope ((ObservationWitnessV1 id (ObservationBytesV1 \"x\")))
                 ObservationNotStartedV1 ())))
          (Results (obs:reconcile $a $lost) (obs:reconcile $a $regressed) (obs:status $bad)))" NegativePremises)))
         ($_ (nt:require many-ordered-values-roundtrip-without-truncation
               (so:case "many" (str:join "" ("(obs:values (ObservationReportV1 scope (" (so:many-events) ") ObservationClosedV1 ()))")) ManyValues)))
         ($_ (nt:require range-boundaries-and-captured-values-survive-writes-and-compaction
               (so:case "boundaries" "(let* (((StoreSnapshot $before $e1 $r1)
          (store:commit $owner $view (ops (put \"a\" \"outside\") (put \"b\" \"old\") (put \"c\" \"upper\"))))
          ((ObservationStepV1 $initial $cursor) (obs:open-range $before \"b\" \"c\" 2))
          ((StoreSnapshot $after $e2 $r2) (store:commit $owner $before (ops (put \"b\" \"new\"))))
          ($closed1 (collapse (store:close $before))) ($closed2 (collapse (store:close $after)))
          ((StoreSnapshot $compacted $compact-epoch $compact-revision) (store:compact $owner))
          ($compact-closed (collapse (store:close $compacted)))
          ((ObservationStepV1 $finished $none) (obs:step $cursor 4 100)))
          (Results (obs:values $finished) (obs:scope $initial) (obs:scope $finished) (Compacted $compact-epoch $compact-revision)))" Boundaries)))
         ($_ (nt:require invalid-budgets-do-not-consume-the-residual
               (so:case "budgets" "(let* (((ObservationStepV1 $initial $cursor) (obs:open-range $view NoBound NoBound 1))
          ($negative (obs:step $cursor -1 100)) ($fraction (obs:step $cursor 0.5 100))
          ($text (obs:step $cursor \"zero\" 100))
          ($bad-limit (obs:open-range $view NoBound NoBound \"one\"))
          ((ObservationStepV1 $finished $none) (obs:step $cursor 1 100)))
          (Results $negative $fraction $text $bad-limit (obs:status $finished)))" Budgets)))
         ($_ (nt:require inert-indices-roundtrip-without-query-execution
               (so:case "inert" "(let* (($a (obs:lookup-at $view \"(NotAnExecutedQuery 1)\" 1024 \"fixed\"))
          ($b (obs:lookup-at $view \"different\" 1024 \"fixed\"))
          ($wire (obs:encode (Envelope (obs:status $a) $a)))
          ((StoreDecoded $copy) (store:decode $wire)) ($parsed (parse (repr $copy))))
          (Results (obs:same $copy $parsed) (obs:reconcile $a $b)))" Inert)))
         ($_ (nt:require overlapping-fragments-replay-and-keep-equal-values-distinct
               (so:case "overlap" "(let* (($one (ObservationWitnessV1 one (ObservationBytesV1 \"equal\")))
          ($two (ObservationWitnessV1 two (ObservationBytesV1 \"equal\")))
          ($three (ObservationWitnessV1 three (ObservationBytesV1 \"last\")))
          ($a (ObservationReportV1 scope ($one $two) (ObservationOpenV1 budget a-residual) (a)))
          ($b (ObservationReportV1 scope ($two $three) (ObservationOpenV1 budget b-residual) (b)))
          ($merged (obs:reconcile-overlap $a $b)))
          (Results (obs:values $merged) (obs:dependencies $merged) (obs:status $merged)))" Overlap)))
         ($_ (nt:require overlapping-fragments-refuse-conflicts-order-and-closed-changes
               (so:case "overlap-refused" "(let* (($one (ObservationWitnessV1 one (ObservationBytesV1 \"one\")))
          ($two (ObservationWitnessV1 two (ObservationBytesV1 \"two\")))
          ($changed (ObservationWitnessV1 one (ObservationBytesV1 \"changed\")))
          ($a (ObservationReportV1 scope ($one $two) (ObservationOpenV1 budget residual) ()))
          ($b (ObservationReportV1 scope ($changed) (ObservationOpenV1 budget residual) ()))
          ($order (ObservationReportV1 scope ($two $one) (ObservationOpenV1 budget residual) ()))
          ($closed (ObservationReportV1 scope ($one) ObservationClosedV1 ())))
          (Results (obs:reconcile-overlap $a $b) (obs:reconcile-overlap $a $order)
           (obs:reconcile-overlap $a $closed)))" OverlapRefused)))
         ($_ (nt:require a-declared-empty-report-keeps-each-dialects-bare-empty (so:case-declared-empty)))
         ($_ (nt:require an-explanation-counts-without-materializing
               (so:case "explanation" "(obs:explain (ObservationReportV1 scope
          ((ObservationWitnessV1 one (ObservationCav1V1 \"not-decoded-for-counting\"))
           (ObservationWitnessV1 two (ObservationBytesV1 \"large-value-placeholder\"))
           (ObservationFaultV1 fail (obs:diagnostic search io \"unavailable\")))
          (ObservationOpenV1 fault NoObservationContinuationV1) ()))" Explanation)))
         ($_ (nt:require regex-refuses-unencodable-owners-and-records-unicode-policy
               (so:case "regex" "(let* (($prepared (re:prepare (re:pattern \"x\")))
          ($unbound (obs:regex-find $prepared \"\"))
          ($closed (collapse (re:close $prepared)))
          ($complete (obs:regex-find (re:pattern \"x\") \"\"))
          ($version (str:unicode-version)))
          (Results (obs:status $unbound) (obs:diagnostics $unbound)
            (obs:scope $complete) $version))" RegexPolicy))))
   (println! UNIT_SCOPED_OBSERVATION_OK))
