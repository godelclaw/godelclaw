!(import! &self ../native_line_child.metta)
!(import! &self ../../src/console/config_cetta.metta)
!(import! &self ../../scripts/shared_mail.metta)
(= (ct:read $pty $framer)
   (nline:request $pty $framer "R 50\n" 1000))
(= (ct:until $pty $framer $path $needle $left)
   (let $receipt (ct:read $pty $framer)
     (if (or (nt:contains (fs:read-text $path) $needle) (<= $left 0)) $receipt
       (ct:until $pty $framer $path $needle (- $left 1)))))
(= (ct:write $pty $framer $text)
   (nline:request $pty $framer (str:join "" ("W " (repr (str:byte-length $text)) "\n" $text)) 2000))
(= (ct:wait-file $pty $framer $path $left)
   (if (or (fs:is-file $path) (<= $left 0)) (fs:is-file $path)
     (progn (ct:read $pty $framer) (ct:wait-file $pty $framer $path (- $left 1)))))
(= (ct:wait-socket $server $socket $left)
   (if (fs:exists $socket) True
     (if (<= $left 0) False (progn (proc:wait $server 20) (ct:wait-socket $server $socket (- $left 1))))))
(= (ct:ended $pty $framer $left)
   (let $record (ct:read $pty $framer)
     (if (or (sf:get $record "ended" False) (<= $left 0)) $record (ct:ended $pty $framer (- $left 1)))))
(= (ct:run)
   (let* (($home (nt:required-env "HOME")) ($root (nt:required-env "TEST_REPOSITORY"))
          ($binary (system:executable)) ($core (nt:required-env "NATIVE_TEST_CORE"))
          ($socket (nt:required-env "CETTA_SHARED_MAIL_SOCKET"))
          ($service (path:join $core "cetta-space-service")) ($data (path:join $home "mail-store"))
          ($server (proc:spawn ($service "--socket" $socket "--data" $data) ((lifetime owner) (max-bytes 65536))))
          ($_ (nt:require native-mail-fixture-ready (ct:wait-socket $server $socket 100)))
          ($capture (path:join $home "screen.bin")) ($fixture (nt:required-env "TEST_PTY_FIXTURE"))
          ($entry (path:join $root "scripts/agent_console_cetta.metta"))
          ($state (path:join $home "state")) ($client (path:join $home "client")) ($display (path:join $home "display"))
          ($argv ($fixture $capture $binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk"
             $entry "--agent" "test-agent" "--root" $root "--state" $state "--client-state" $client "--dir" $display))
          ($pty (proc:spawn $argv ((mode stream) (max-bytes 65536) (lifetime owner) (timeout-ms 20000))))
          ($framer (buffer:new 65536 bytes))
          ($ready (ct:until $pty $framer $capture "Attached to test-agent" 80))
          ($_ (nt:require native-console-attaches (and (not (sf:get $ready "ended" True)) (not (sf:get $ready "restored" True)))))
          ($draft "hello\n(system:exit 91) 雪")
          ($_ (ct:write $pty $framer (str:join "" ("\u001b[200~" $draft "\u001b[201~"))))
          ($_ (nline:request $pty $framer "S 101 31\n" 1000))
          ($_ (ct:until $pty $framer $capture "hello" 40))
          ($draft-path (path:join $client "draft.json"))
          ($_ (ct:wait-file $pty $framer $draft-path 40))
          ($_ (ct:until $pty $framer $capture "雪" 40))
          ($event-file (path:join $display "fixture.jsonl"))
          ($event (JsonObject ((JsonPair "producer" "fixture-producer") (JsonPair "sequence" 1)
             (JsonPair "session" "test-agent") (JsonPair "attempt" "one") (JsonPair "item" "message")
             (JsonPair "kind" "text.delta") (JsonPair "channel" "analysis")
             (JsonPair "text" "STREAM_OUTPUT_MARKER\n(system:exit 92)\u001b[31m safe\n"))))
          ($_ (fs:write $event-file (str:concat (json:stringify-python $event) "\n")))
          ($_ (ct:until $pty $framer $capture "STREAM_OUTPUT_MARKER" 40))
          ($_ (nt:require real-stream-arrives-while-draft-is-open (nt:contains (fs:read-text $capture) "STREAM_OUTPUT_MARKER")))
          ($_ (fs:append-text $event-file (str:concat (json:stringify-python $event) "\n")))
          ($_ (ct:read $pty $framer))
          ($_ (nt:require replayed-event-is-not-rendered-twice (== (size-atom (str:split "STREAM_OUTPUT_MARKER" (fs:read-text $capture))) 2)))
          ($stored (sf:native-object $draft-path))
          ($_ (nt:require pasted-draft-survives-output-and-resize (== (sf:get $stored "text" "") $draft)))
          ($_ (ct:write $pty $framer "\r"))
          ($_ (ct:until $pty $framer $capture "accepted" 80))
          ($accepted-root (path:join $client "accepted"))
          ($accepted (sf:native-object (path:join $accepted-root (car-atom (fs:entries $accepted-root)))))
          ($_ (nt:require native-mail-keeps-literal-program-text
             (== (sf:get (sf:get $accepted "record" JsonNull) "text" "") $draft)))
          ($_ (ct:write $pty $framer "/models\r"))
          ($_ (ct:until $pty $framer $capture "2. Two" 80))
          ($_ (nt:require native-menu-rendered (nt:contains (fs:read-text $capture) "2. Two")))
          ($_ (ct:write $pty $framer "2\r"))
          ($_ (ct:until $pty $framer $capture "choice recorded" 80))
          ($_ (nt:require one-menu-effect (== (fs:read-text (path:join $home "control-effects.txt")) "model-two\n")))
          ($sender (str:concat "console-" (str:byte-slice (str:sha256 (fs:canonical-path $client)) 0 24)))
          ((shared-mail:account $_ $account $_) (shared-mail:identity $socket))
          ($reply-id "1234567890abcdef1234567890abcdef")
          ($_ (mailbox:send $socket (str:concat "mail@" $account) $reply-id $sender "test-agent" "NATIVE_REPLY_MARKER"))
          ($_ (ct:until $pty $framer $capture "NATIVE_REPLY_MARKER" 60))
          ($archive (path:join (path:join $client "received") (str:concat (str:sha256 $reply-id) ".json")))
          ($_ (nt:require native-reply-archived-before-acknowledgement (fs:is-file $archive)))
          ($_ (nt:require native-reply-is-visible (nt:contains (fs:read-text $capture) "NATIVE_REPLY_MARKER")))
          ($_ (ct:write $pty $framer "keep this"))
          ($_ (ct:until $pty $framer $capture "keep this" 40))
          ($_ (ct:write $pty $framer " dropme"))
          ($_ (ct:until $pty $framer $capture "keep this dropme" 40))
          ($_ (ct:write $pty $framer (str:from-python-codepoints (31))))
          ($_ (ct:write $pty $framer " draft"))
          ($_ (ct:until $pty $framer $capture "keep this draft" 40))
          ($_ (ct:write $pty $framer (str:concat (str:from-python-codepoints (18)) "models")))
          ($_ (ct:until $pty $framer $capture "(reverse-i-search)" 40))
          ($_ (nt:require pty-incremental-search-rendered (nt:contains (fs:read-text $capture) "(reverse-i-search)`models':")))
          ($_ (ct:write $pty $framer (str:from-python-codepoints (7))))
          ($_ (ct:read $pty $framer))
          ($_ (nline:request $pty $framer "K 15\n" 1000))
          ($stopped (ct:ended $pty $framer 100))
          ($_ (nt:require native-console-termination-restores-terminal (and (sf:get $stopped "ended" False) (sf:get $stopped "restored" False))))
          ($_ (nt:require native-console-exits-successfully (== (sf:get $stopped "status" -1) 0)))
          ($_ (nt:require unsent-draft-is-durable (== (sf:get (sf:native-object $draft-path) "text" "") "keep this draft")))
          ($_ (proc:close-input $pty)) ($_ (proc:await $pty)) ($_ (proc:close $pty))
          ($_ (proc:cancel $server)) ($_ (proc:await $server)) ($_ (proc:close $server)) ($_ (host:close $framer))) True))
!(nt:require native-console-controls (ct:run))
!(println! UNIT_NATIVE_CONSOLE_OK)
