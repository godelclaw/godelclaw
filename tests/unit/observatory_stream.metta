!(import! &self ../native_test_support.metta)
!(import! &self ../../src/observatory_cetta.metta)
(= (os:record $id $message)
   (json:stringify-python (JsonObject ((JsonPair "__CURSOR" $id)
     (JsonPair "__REALTIME_TIMESTAMP" "1000000") (JsonPair "_COMM" "cetta") (JsonPair "MESSAGE" $message)))))
(= (os:pad $n $value)
   (if (>= (str:byte-length $value) $n) (str:byte-slice $value 0 $n)
     (os:pad $n (str:concat $value $value))))
(= (os:stream $tag $bytes $capacity)
   (let* (($home (path:join (nt:required-env "HOME") $tag)) ($made (fs:make-directories $home 448))
          ($configured (change-state! &obs-options (JsonObject ((JsonPair "--data" $home)))))
          ($cursor (JsonObject ((JsonPair "journal_cursor" "before"))))
          ($started (change-state! &obs-cursor $cursor)) ($counts (change-state! &obs-counts (JsonObject ())))
          ($writes (change-state! &obs-write-failed False))
          ($cursor-file (sf:replace (obs:path "cursor.json") (json:stringify-python $cursor) 384 True))
          ($recovered (op:recover $home)) ($begun (op:begin $home))
          ($input-path (path:join $home "stream")) ($saved (fs:write $input-path $bytes))
          ($entry (path:join (nt:required-env "TEST_REPOSITORY") "tests/fixtures/journal_stream_native.metta"))
          ($process (proc:spawn ((system:executable) "--no-results" "--lang" "petta" "--profile" "extended"
                     "--import-mode" "ancestor-walk" $entry $input-path)
                       ((mode stream) (max-bytes 65536) (timeout-ms 5000) (lifetime owner))))
          ($input (buffer:new $capacity bytes))
          ($result (obs:journal-owned $process $input "before"))) $result))
!(let* (($rounding (nt:require observation-rounding-keeps-half-even-ties
             (and (== (obs:round1 2.25) 2.2) (== (obs:round1 -2.25) -2.2))))
         ($negative-zero (nt:require observation-rounding-preserves-negative-zero
             (== (json:stringify-python (obs:round1 -0.0)) "-0.0")))
         ($one (os:record "cursor-0" "(RESULTS: one)"))
         ($two (os:record "cursor-1" "(RESULTS: two)"))
         ($three (os:record "cursor-2" "(RESULTS: three)"))
         ($body (str:join "\n" ($one $two $three "")))
         ($normal (os:stream "normal" $body 4096))
         ($a (nt:require ordinary-journal-stream-completes (== $normal True)))
         ($b (nt:require every-ordinary-record-is-projected (== (sf:get (get-state &obs-counts) "turns.jsonl" 0) 3)))
         ($c (nt:require completed-stream-retains-last-cursor (== (sf:get (get-state &obs-cursor) "journal_cursor" "") "cursor-2")))
         ($normal-published (obs:finish-collection True True $normal))
         ($d (nt:require complete-sources-can-publish-cursor (== $normal-published 0)))
         ($without-lf (os:stream "no-final-newline" (str:join "\n" ($one $two $three)) 4096))
         ($e (nt:require complete-final-json-without-newline-is-preserved
             (and (== $without-lf True) (== (sf:get (get-state &obs-counts) "turns.jsonl" 0) 3))))
         ($closed (obs:close-writers))
         ($large (os:record "cursor-big" (str:concat "(RESULTS: " (os:pad 2048 "payload"))))
         ($refused (os:stream "bounded" (str:join "\n" ($large $two $three "")) 512))
         ($f (nt:require oversize-frame-is-an-explicit-incomplete-result
              (case $refused (((ObservatoryFailureV1 $_) True) ($bad False)))))
         ($g (nt:require refused-stream-does-not-advance-cursor
              (== (sf:get (get-state &obs-cursor) "journal_cursor" "") "before")))
         ($failed-publish (obs:finish-collection True True $refused))
         ($h (nt:require incomplete-source-cannot-report-success (== $failed-publish 1)))
         ($i (nt:require incomplete-source-cannot-publish-a-new-cursor
              (== (sf:get (sf:native-object (obs:path "cursor.json")) "journal_cursor" "") "before")))
         ($partial (os:stream "partial" "{\"MESSAGE\":\"unfinished" 4096))
         ($j (nt:require incomplete-final-record-is-not-completed-absence
              (case $partial (((ObservatoryFailureV1 $_) True) ($bad False)))))
         ($closed-partial (obs:close-writers)))
   (println! UNIT_OBSERVATORY_STREAM_OK))
