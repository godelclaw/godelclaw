!(import! &self ../native_test_support.metta)
!(import! &self ../../src/runtime_housekeeping_cetta.metta)
!(let* (($root (nt:required-env "HOME")) ($jobs (path:join $root "jobs"))
        ($_ (nt:require missing-job-domain-is-empty (== (housekeeping:blocked $jobs) 0)))
        ($_ (fs:make-directories $jobs 448))
        ($_ (fs:write (path:join $jobs "uncertain.json") "{\"state\":\"uncertain\",\"pid\":0}"))
        ($_ (fs:write (path:join $jobs "running.json") "{\"state\":\"running\",\"pid\":0}"))
        ($_ (fs:write (path:join $jobs "done.json") "{\"state\":\"completed\"}"))
        ($_ (nt:require uncertainty-defers-recycling (== (housekeeping:blocked $jobs) 2)))
        ($bad (path:join $root "not-a-job-directory")) ($_ (fs:write $bad "data"))
        ($_ (nt:require unavailable-job-domain-is-not-empty (== (housekeeping:blocked $bad) 1)))
        (($id $body $receipt) (housekeeping:review-intent "daily" 1700000000))
        (($again $same $same-file) (housekeeping:review-intent "daily" 1700000001))
        ($_ (nt:require repeated-daily-firing-keeps-occurrence-id (== $id $again)))
        ($_ (nt:require daily-body-keeps-coalescing-rule (nt:contains $body "Missed firings coalesce into one review")))
        ($_ (nt:require daily-receipt-format (== $receipt "daily-last-mail.json"))))
   (println! UNIT_NATIVE_HOUSEKEEPING_OK))
