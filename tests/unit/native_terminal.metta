!(import! &self ../native_line_child.metta)
!(import! &self ../../src/state_file_cetta.metta)
(= (term-test:ended $job $buffer $left)
   (let $record (nline:request $job $buffer "R 50\n" 2000)
     (if (or (sf:get $record "ended" False) (<= $left 0)) $record
       (term-test:ended $job $buffer (- $left 1)))))
(= (term-test:until $job $buffer $capture $needle $left)
   (if (nt:contains (fs:read-text $capture) $needle) True
     (if (<= $left 0) False
       (progn (nline:request $job $buffer "R 50\n" 2000)
              (term-test:until $job $buffer $capture $needle (- $left 1))))))
(= (term-test:run)
   (let* (($root (nt:required-env "TEST_REPOSITORY")) ($binary (system:executable))
          ($capture (path:join (nt:required-env "HOME") "terminal.bin"))
          ($fixture (nt:required-env "TEST_PTY_FIXTURE"))
          ($program (path:join $root "tests/fixtures/terminal_native.metta"))
          ($argv ($fixture $capture $binary "--no-results" "--lang" "petta" "--profile" "extended" "--import-mode" "ancestor-walk" $program))
          ($job (proc:spawn $argv ((mode stream) (max-bytes 65536) (lifetime owner) (timeout-ms 10000))))
          ($buffer (buffer:new 65536 bytes))
          ($ready (nline:request $job $buffer "R 3000\n" 4000))
          ($_ (nt:require native-terminal-entered-raw (not (sf:get $ready "restored" True))))
          ($_ (nt:require actual-terminal-output (nt:contains (fs:read-text $capture) "TERMINAL_NATIVE_READY")))
          ($_ (nline:request $job $buffer "W 7\naž🌿" 2000))
          ($_ (nline:request $job $buffer "S 101 31\n" 2000))
          ($_ (term-test:until $job $buffer $capture "HostSize 101 31" 80))
          ($text (fs:read-text $capture))
          ($_ (nt:require utf8-passes-real-terminal (nt:contains $text "INPUT=až🌿")))
          ($_ (nt:require resize-observed (nt:contains $text "HostSize 101 31")))
          ($_ (nline:request $job $buffer "K 15\n" 2000))
          ($stopped (term-test:ended $job $buffer 40))
          ($_ (nt:require cooperative-termination-settles (sf:get $stopped "ended" False)))
          ($_ (nt:require actual-termios-restoration (sf:get $stopped "restored" False)))
          ($_ (proc:close-input $job)) ($_ (proc:await $job)) ($_ (proc:close $job)) ($_ (host:close $buffer))) True))
!(nt:require native-terminal-prototype-controls (term-test:run))
!(println! UNIT_NATIVE_TERMINAL_OK)
