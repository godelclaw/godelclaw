!(import! &self ../native_test_support.metta)
!(import! &self ../../src/provider_request_cetta.metta)
(= (mode-config:test $mode $settings $expected)
   (let* (($root (system:cwd)) ($directory (path:join (nt:required-env "HOME") (system:uuid4-hex)))
          ($_ (fs:make-directories $directory 448)) ($capture (path:join $directory "capture"))
          ($peer (nt:required-env "NATIVE_CORE_PEER"))
          ($base (preq:append (nt:environment $directory)
            (("CETTA_BIN" $peer)
             ("NATIVE_LAUNCH_CAPTURE" $capture) ("SYNTHETIC_MODEL" "stale-instance-model"))))
          ($environment (preq:append $base $settings))
          ($launcher (path:join $root "modes/launch_native.sh"))
          ($command ("bash" $launcher "--mode" $mode "--profile" "standalone" "--state-dir" $directory))
          ($_ (nt:exit-ok (proc:run $command
                         $root $environment 10000 65536)))
          ($actual (fs:read-text $capture)))
     (map-atom $expected $line (nt:require ($mode $line) (nt:contains $actual $line)))))
!(mode-config:test "iter" (("LLM_MODEL" "fixture-iter") ("BASE_URL" "http://127.0.0.1:9/iter"))
   ("model=openai:fixture-iter\n" "openai_base=http://127.0.0.1:9/iter\n"))
!(mode-config:test "omega" (("OMEGA_provider" "OpenAIAPI") ("OMEGA_model" "fixture-omega")
    ("OMEGA_openaiapi_url" "http://127.0.0.1:9/omega") ("OMEGA_api_token_var" "UNIT_OMEGA_KEY") ("UNIT_OMEGA_KEY" "fixture-omega"))
   ("model=fixture-omega\n" "synthetic_base=http://127.0.0.1:9/omega\n" "key_alias=1\n"))
!(mode-config:test "omega" (("OMEGA_provider" "ASICloud") ("ASI_API_KEY" "fixture-omega"))
   ("model=minimax/minimax-m3\n" "synthetic_base=https://inference.asicloud.cudos.org/v1\n" "key_alias=1\n"))
!(mode-config:test "omega" () ("model=claude-opus-4-8\n"))
!(mode-config:test "omega" (("OMEGA_provider" "OpenAI") ("OMEGA_model" "fixture-openai"))
   ("model=openai:fixture-openai\n"))
!(println! UNIT_STANDALONE_MODE_CONFIG_OK)
