!(import! &self ../native_test_support.metta)
!(import! &self ../../src/coding_io_cetta.metta)
!(let* (($home (nt:required-env "HOME")) ($dir (path:join $home "session"))
        ($_ (fs:make-directories $dir 448))
        ($legacy (path:join $home "legacy/cetta")) ($_ (fs:make-directories (path:dirname $legacy) 448))
        ($_ (fs:write $legacy "legacy fixture: must never execute"))
        ($_ (fs:write (path:join (path:dirname $legacy) "build-manifest.json")
          "{\"runtime_profile\":\"python\",\"python_enabled\":true,\"files\":{}}"))
        ($record (path:join $dir "runtime.json"))
        ($old (JsonObject ((JsonPair "root" (JsonString (system:getcwd))) (JsonPair "binary" (JsonString $legacy))
                          (JsonPair "phase" (JsonString "ended")) (JsonPair "run" (JsonString "old")))))
        ($text (json:stringify-python $old)) ($_ (fs:write $record $text))
        ($answer (cio:reserve-pinned $dir $record $old NoNote))
        ($_ (nt:require legacy-engine-pin-is-refused
           (case $answer (((CodingLaunch failed $_ $_ $_ $why) (nt:contains $why "work-repin")) ($bad False)))))
        ($_ (nt:require refused-pin-is-unchanged (== (fs:read-text $record) $text)))
        ($native (path:join (nt:required-env "NATIVE_TEST_CORE") "cetta"))
        ($_ (nt:require current-artifact-is-native (cio:native-core-binary? $native)))
        ($_ (nt:require compatible-native-pin-is-admitted
              (== (cio:native-pin-admission $dir (system:getcwd) $native) (CheckpointPassed)))))
   (println! UNIT_NATIVE_PIN_ADMISSION_OK))
