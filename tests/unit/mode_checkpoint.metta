!(import! &self ../native_test_support.metta)
!(import! &self ../../modes/runtime_host_cetta.metta)
(= (mode-test:append-intent $path $data $offset)
   (case (mode-host:file-info $path)
     (((ModeFileV1 $_ $device $inode)
       (JsonObject ((JsonPair "schema" 1) (JsonPair "mode" (mode-host:name))
         (JsonPair "operation" "append") (JsonPair "status" "pending")
         (JsonPair "path" $path) (JsonPair "payload" $data) (JsonPair "sha256" (str:sha256 $data))
         (JsonPair "offset" $offset) (JsonPair "device" $device) (JsonPair "inode" $inode)
         (JsonPair "ids" (JsonArray ())) (JsonPair "tasks" (JsonArray ())) (JsonPair "recorded_at" 1)))))))
!(let* (($root (nt:required-env "METTACLAW_MODE_RUNTIME"))
        ($_ (fs:make-directories $root 448)) ($path (path:join $root "history"))
        ($_ (fs:write $path "A\xE2\x82"))
        ($record (mode-test:append-intent $path "€" 1))
        ($_ (nt:require partial-byte-prefix-completes (== (mode-host:resume-append $record) True)))
        ($_ (nt:require no-unicode-replacement (== (fs:read-text $path) "A€")))
        ($_ (nt:require completed-append-does-not-replay (== (mode-host:resume-append $record) True)))
        ($_ (nt:require replay-preserves-length (== (fs:read-text $path) "A€")))
        ($owner (fs:open-read $path))
        ($_ (nt:require positioned-read-keeps-raw-bytes
              (case (fs:read-chunk $owner 2 1) (((fs:chunk $bytes $_) (== $bytes "\xE2\x82")) ($bad False)))))
        ($_ (nt:require positioned-read-does-not-seek
              (case (fs:read-chunk $owner 1) (((fs:chunk $bytes $_) (== $bytes "A")) ($bad False)))))
        ($_ (nt:require zero-size-is-a-chunk
              (case (fs:read-chunk $owner 0 100) (((fs:chunk "" 100) True) ($bad False)))))
        ($_ (fs:close $owner))
        ($_ (nt:require closed-owner-refused (sf:failed? (fs:read-chunk $owner 1 0))))
        ($foreign-path (path:join $root "foreign")) ($_ (fs:write $foreign-path "Axx"))
        ($foreign (mode-test:append-intent $foreign-path "€" 1))
        ($_ (nt:require foreign-prefix-refused (turn:failed? (mode-host:resume-append $foreign))))
        ($_ (nt:require foreign-prefix-unchanged (== (fs:read-text $foreign-path) "Axx")))
        ($_ (nt:require atomic-intent-and-projection (== (mode-host:checkpoint (path:join $root "experience.json") "[]") True)))
        ($_ (nt:require restart-recovers-same-checkpoint (== (mode-host:recover) True)))
        ($_ (nt:require append-checkpoint-uses-current-offset
              (== (mode-host:append-checkpoint $path "!") True)))
        ($_ (nt:require append-checkpoint-keeps-prefix (== (fs:read-text $path) "A€!")))
        ($_ (nt:require settled-recovery-does-not-reapply-append (== (mode-host:recover) True)))
        ($_ (nt:require settled-recovery-has-no-extra-bytes (== (fs:read-text $path) "A€!"))))
   (println! UNIT_NATIVE_MODE_CHECKPOINT_OK))
