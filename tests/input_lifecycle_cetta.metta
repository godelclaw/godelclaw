; Real native ledger transitions and the conversation projection, without an LLM.
!(import! &self ./provider_native_qualification.metta)

(= (il:call (NativeProviderTestWorldV1 $root $sdk $core $directory $socket $base $peer $server $env $io_fixture) $verb $arguments)
   (ledger-client:call $socket $verb $arguments))
(= (il:accept $world $id $kind $checker)
   (let $receipt (space:request-id)
     (il:call $world "request-accept" ($id "same notice" $checker $kind "notice" "digest" $receipt))))
(= (il:link $world $request $ids)
   (let $receipt (space:request-id) (il:call $world "link-inputs" ($request $ids $receipt))))
(= (il:dispose $world $id $disposition $receipt)
   (il:call $world "request-disposition" ($id $disposition "explicit decision" $receipt)))
(= (il:record $world $id) (il:call $world "request-record" ($id 0)))
(= (il:processed (record $id $kind $checker $status $processed $note $text $length $digest)) $processed)
(= (il:status (record $id $kind $checker $status $processed $note $text $length $digest)) $status)
(= (il:committed $world $ids) (il:call $world "committed" ($ids)))
(= (il:requests $world $focus)
   (let (conversation-rows $requests $notes $entries) (il:call $world "conversation-rows" ($focus 0 8)) $requests))
(= (il:has-id $rows $id)
   (if (== $rows ()) False
     (let $row (car-atom $rows)
       (if (== (car-atom $row) $id) True (il:has-id (cdr-atom $rows) $id)))))
(= (il:operator-input $world)
   (let* (($_ (nt:require notification-created (nt:equal (il:accept $world "input:a" "notification" "operator") created)))
          ($_ (nt:require two-deliveries-linked (nt:equal (il:link $world "input:a" ("mail:a" "job:a")) ok)))
          ($_ (nt:require no-prior-checkpoint (nt:equal (il:call $world "working-set" ()) none)))
          ($_ (nt:require defer-committed (nt:equal (il:dispose $world "input:a" "defer" "defer:a") ok)))
          ($_ (nt:require defer-processes-without-checkpoint (nt:equal (il:processed (il:record $world "input:a")) 1)))
          ($_ (nt:require defer-keeps-open-work (il:has-id (il:requests $world "") "input:a")))
          ($_ (nt:require defer-settles-every-linked-delivery (il:committed $world ("mail:a" "job:a"))))
          ($_ (nt:require unrelated-delivery-unsettled (not (il:committed $world ("mail:unrelated")))))
          ($_ (nt:require addressed-after-defer (nt:equal (il:dispose $world "input:a" "addressed" "address:a") ok)))
          ($_ (nt:require addressed-leaves-open-projection (not (il:has-id (il:requests $world "") "input:a"))))
          ($_ (nt:require closed-focus-remains-readable (il:has-id (il:requests $world "input:a") "input:a")))
          ($before (il:record $world "input:a"))
          ($_ (nt:require same-write-replays (nt:equal (il:dispose $world "input:a" "addressed" "address:a") ok)))
          ($_ (nt:require replay-preserves-record (nt:equal (il:record $world "input:a") $before)))
          ($_ (nt:require no-checkpoint-manufactured (nt:equal (il:call $world "working-set" ()) none)))) 14))
(= (il:guards $world)
   (let* (($_ (il:accept $world "goal:a" "goal" "operator"))
          ($_ (nt:require goal-refusal-retained (nt:equal (il:dispose $world "goal:a" "addressed" "goal:dispose")
             (refused "goal cycles are not disposed; retire the goal with goal-drop"))))
          ($_ (il:accept $world "auto:a" "autonomous" "operator"))
          ($_ (nt:require autonomous-refusal-retained (nt:equal (il:dispose $world "auto:a" "defer" "auto:dispose")
             (refused "autonomous work has no disposition"))))
          ($_ (il:accept $world "input:checked" "notification" "custom-checker"))
          ($_ (il:link $world "input:checked" ("mail:checked")))
          ($_ (nt:require checker-refusal-retained (nt:equal (il:dispose $world "input:checked" "addressed" "checked:dispose")
             (refused "this request has its own checker and completes when the check passes"))))
          ($_ (nt:require refused-input-not-processed (nt:equal (il:processed (il:record $world "input:checked")) 0)))
          ($_ (nt:require refused-delivery-not-settled (not (il:committed $world ("mail:checked")))))
          ($_ (il:accept $world "input:terminal" "message" "operator"))
          ($_ (il:link $world "input:terminal" ("mail:terminal")))
          ($_ (il:call $world "request-cancel" ("input:terminal" "cancel:a")))
          ($_ (nt:require terminal-refusal-retained (nt:equal (il:dispose $world "input:terminal" "addressed" "terminal:dispose")
             (refused "the request is already cancelled"))))
          ($_ (nt:require terminal-refusal-not-settlement (not (il:committed $world ("mail:terminal")))))) 7))
(= (il:distinct-occurrences $world)
   (let* (($_ (il:accept $world "input:b" "message" "operator")) ($_ (il:link $world "input:b" ("mail:b")))
          ($_ (il:accept $world "input:c" "message" "operator")) ($_ (il:link $world "input:c" ("mail:c")))
          ($_ (nt:require equal-text-distinct-requests-open
             (and (il:has-id (il:requests $world "") "input:b") (il:has-id (il:requests $world "") "input:c"))))
          ($_ (il:dispose $world "input:b" "addressed" "address:b"))
          ($_ (nt:require one-occurrence-closed (not (il:has-id (il:requests $world "") "input:b"))))
          ($_ (nt:require other-occurrence-remains (il:has-id (il:requests $world "") "input:c")))
          ($_ (nt:require other-occurrence-not-settled (not (il:committed $world ("mail:c")))))
          ($_ (nt:require legacy-answer-move (il:call $world "request-answered" ("input:c" "answered:c"))))
          ($_ (nt:require legacy-answer-settles-input (il:committed $world ("mail:c"))))
          ($_ (nt:require legacy-answer-processes-request (nt:equal (il:processed (il:record $world "input:c")) 1)))) 7))
(= (il:covered $world)
   (let* (($_ (il:accept $world "input:old-batch" "message" "operator"))
          ($_ (il:link $world "input:old-batch" ("telegram:old")))
          ($_ (il:call $world "task-begin" ("input:old-batch" "operator-event" none "private" none "begin:old")))
          ($_ (il:accept $world "input:new-batch" "message" "operator"))
          ($_ (il:link $world "input:new-batch" ("telegram:old" "telegram:new")))
          ($_ (il:call $world "task-begin" ("input:new-batch" "operator-event" "input:old-batch" "private" none "begin:new")))
          ($_ (nt:require actual-overlap-covers-old-batch (nt:equal (il:status (il:record $world "input:old-batch")) "covered")))
          ($_ (nt:require covered-batch-not-open (not (il:has-id (il:requests $world "") "input:old-batch"))))
          ($_ (nt:require covering-batch-still-open (il:has-id (il:requests $world "") "input:new-batch")))
          ($_ (nt:require covered-addressed-refusal-retained
             (nt:equal (il:dispose $world "input:old-batch" "addressed" "covered:refuse")
               (refused "input batch is covered; reopen it to create independent work"))))
          ($_ (nt:require refused-covered-does-not-settle (not (il:committed $world ("telegram:old")))))
          ($_ (il:dispose $world "input:new-batch" "addressed" "covering:address"))
          ($_ (nt:require covering-disposition-settles-both-occurrences (il:committed $world ("telegram:old" "telegram:new"))))
          ($_ (nt:require closed-covering-leaves-open-work (not (il:has-id (il:requests $world "") "input:new-batch"))))) 7))
