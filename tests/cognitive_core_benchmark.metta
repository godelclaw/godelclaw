; Complete boot, input, context, provider, physical effect, checkpoint and rest.
; The native C fixture measures each actual child; the driver is CeTTa.
!(import! &self ./cognitive_core_support.metta)
!(import! &self ./provider_native_benchmark.metta)
(= (core-bench:sample $root $engine $bytes)
   (let* (($measurement (core-turn:run-at $root $engine True $bytes))
          ($_ (nt:require finite-turn-exited (== (sf:get $measurement "exit" -1) 0))))
     (NativeBenchSampleV1 (sf:get $measurement "elapsed_ns" 0) (sf:get $measurement "peak_rss_kib" 0))))
(= (core-bench:pairs $old-root $old-engine $new-root $new-engine $bytes $left $old $new)
   (if (<= $left 0) (NativeBenchSamplesV1 $old $new)
     (let* ((($a $b)
              (if (nb:even $left)
                (let* (($a (core-bench:sample $old-root $old-engine $bytes))
                       ($b (core-bench:sample $new-root $new-engine $bytes))) ($a $b))
                (let* (($b (core-bench:sample $new-root $new-engine $bytes))
                       ($a (core-bench:sample $old-root $old-engine $bytes))) ($a $b))))
            ($_ (println! (COMPLETE_FLOW_PAIR $bytes $left $a $b))))
       (core-bench:pairs $old-root $old-engine $new-root $new-engine $bytes (- $left 1)
         (cons-atom $a $old) (cons-atom $b $new)))))
(= (core-bench:stats $samples $count)
   (let* (($times (nb:sort-values $samples time ())) ($rss (nb:sort-values $samples rss ()))
          ($median (preq:nth $times (math:floor (/ $count 2))))
          ($p95 (preq:nth $times (math:floor (* $count 0.95))))
          ($maximum (preq:nth $rss (- $count 1))))
     (JsonObject ((JsonPair "median_ns" $median) (JsonPair "p95_ns" $p95)
       (JsonPair "max_peak_rss_kib" $maximum)))))
(= (core-bench:workload $bytes $count)
   (let* (($old-root (nt:required-env "NATIVE_BASELINE_ROOT"))
          ($old-engine (nt:required-env "NATIVE_BASELINE_ENGINE"))
          ($new-root (nt:required-env "NATIVE_TEST_RUNTIME_ROOT"))
          ($new-engine (nt:required-env "NATIVE_TEST_CORE"))
          ((NativeBenchSamplesV1 $old $new)
            (core-bench:pairs $old-root $old-engine $new-root $new-engine $bytes $count () ())))
     (core-bench:report $bytes $count $old $new)))
(= (core-bench:report $bytes $count $old $new)
   (let* (($a (core-bench:stats $old $count)) ($b (core-bench:stats $new $count))
          ($latency (/ (sf:get $b "p95_ns" 0) (sf:get $a "p95_ns" 1)))
          ($memory (/ (sf:get $b "max_peak_rss_kib" 0) (sf:get $a "max_peak_rss_kib" 1)))
          ($row (JsonObject ((JsonPair "prompt_padding_bytes" $bytes) (JsonPair "pairs" $count)
            (JsonPair "baseline" $a) (JsonPair "candidate" $b)
            (JsonPair "p95_ratio" $latency) (JsonPair "max_rss_ratio" $memory)
            (JsonPair "within_budget" (and (<= $latency 1.15) (<= $memory 1.15))))))
          ($report (path:join (nt:required-env "NATIVE_TEST_ARTIFACTS")
                      (str:join "" ("core-benchmark-" (repr $bytes) ".json"))))
          ($_ (fs:write $report (json:stringify-python $row)))
          ($_ (println! (COMPLETE_FLOW_BENCHMARK $report $row))))
     (and (<= $latency 1.15) (<= $memory 1.15))))
