!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)
!(import! &self ./tests/scripted_provider.metta)

(= (assertEqual $A $B) (assert (== $A $B)))
(= (probe-stimulus)
   (tg:activity-add "" "probe" "new stimulus" False "full" "811" False))
!(scripted:default "((probe-stimulus) (pin _quote_pin-after-new-input-lands_quote_) (send-telegram-chat _quote_probe_quote_ _quote_stale-reply-must-not-be-sent_quote_) (pin _quote_pin-after-withheld-send-must-not-land_quote_))")
!(initMemory)
!(configure commchannel telegram)

!(let* (($_ (loop-mode:set "godelclaw"))
         ($initial (initLoop))
         ($after (process-step $initial
                   (turnProcess (process-periphery $initial))))
         ($_ (cut))
         ($feedback (loop-last-results (process-periphery $after)))
         ($_ (assertEqual (loop-host:nonempty? $feedback) True))
         ($_ (assertEqual (scripted:calls) 1)))
     (println! INTERRUPTED_COGNITIVE_TURN_OK))
