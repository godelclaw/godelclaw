!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)
!(import! &self ./tests/scripted_provider.metta)
(= (assertEqual $a $b) (assert (== $a $b)))

;; New input arrives while the first scripted provider call is outstanding.
;; It queues for the next step without discarding the emitted command.
!(scripted:answer 1 "((shell \"printf EMITTED_COMMAND\"))")
!(scripted:answer 2 "((help shell))")

(= (obs-probe:action-serials $rows)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((action $t $r $serial $tool $cmd $st $obs $rc $pay)
         (cons-atom $serial (obs-probe:action-serials (cdr-atom $rows))))
        ($other (obs-probe:action-serials (cdr-atom $rows)))))))

(= (obs-probe:action-statuses $rows)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((action $t $r $serial $tool $cmd $status $obs $rc $pay)
         (cons-atom $status (obs-probe:action-statuses (cdr-atom $rows))))
        ($other (obs-probe:action-statuses (cdr-atom $rows)))))))

;; A real Telegram stimulus arrives as the first provider call returns, before
;; the effect broker executes the emitted command.
(= (obs-probe:after-model-call $response)
   (let $injected (if (== (scripted:calls) 1)
                    (tg:activity-add "" "probe" "MID_CALL_STIMULUS" False "full" "901" False)
                    True)
     $response))

!(initMemory)
!(configure commchannel telegram)
!(let* (($rm (collapse (match &self (= (turn:after-model-call $r) $body)
               (remove-atom &self (= (turn:after-model-call $r) $body)))))
        ($add (add-atom &self (= (turn:after-model-call $r) (obs-probe:after-model-call $r))))
        ($mode (loop-mode:set "godelclaw"))
        ($initial (initLoop))
        ($first (process-step $initial (turnProcess (process-periphery $initial))))
        ($actions1 (state:ledger "actions" ("all")))
        ($c1 (assertEqual (obs-probe:action-serials $actions1) (0)))
        ($c2 (assertEqual (obs-probe:action-statuses $actions1) ("returned")))
        ($c3 (assertEqual (scripted:calls) 1))
        ($c4 (assertEqual (tg:pending-count) 1))
        ($c5 (assertEqual (strategy:batch) none))
        ($second (process-step $first (turnProcess (process-periphery $first))))
        ($actions2 (state:ledger "actions" ("all")))
        ($c6 (assertEqual (obs-probe:action-serials $actions2) (0 1)))
        ($c7 (assertEqual (obs-probe:action-statuses $actions2) ("returned" "returned")))
        ($c8 (assertEqual (> (size-atom (state:ledger "request-rows" (active))) 0) True))
        ($c9 (assertEqual (scripted:calls) 2))
        ($c10 (assertEqual (scripted:prompt-has 1 "TASK_CONTEXT") 1))
        ($c11 (assertEqual (scripted:prompt-has 2 "TASK_CONTEXT") 1))
        ($c12 (assertEqual (scripted:prompt-has 2 "EMITTED_COMMAND") 1))
        ($c13 (assertEqual (scripted:prompt-has 2 "MID_CALL_STIMULUS") 1))
        ($c14 (assertEqual (strategy:batch) none)))
   (println! OBSERVED_STRATEGY_OK))
