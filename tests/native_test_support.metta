; Native test operations. A check must produce exactly one true observation.
!(import! &self (library system))
!(import! &self (library proc))
!(import! &self (library fs))
!(import! &self (library str))
!(import! &self (library json))
!(import! &self (library math))
!(import! &self (library path))

(: nt:equal (-> %Undefined% %Undefined% Bool))
(= (nt:equal $actual $expected) (== $actual $expected))

(: nt:require (-> Atom Atom %Undefined%))
(= (nt:require $name $condition)
   (let $answers (collapse (eval $condition))
     (case $answers
       (((True) (let $_ (println! (PASS $name)) 1))
        ((true) (let $_ (println! (PASS $name)) 1))
        ($other (let $_ (println! (FAIL $name $other)) (system:exit 1)))))))
(: nt:exit-ok (-> %Undefined% %Undefined%))
(= (nt:exit-ok $result)
   (case $result
     (((proc:exited 0 $stdout $stderr) $stdout)
      ((proc:result (proc:exited 0) proc:normal $stdout $stderr $capture) $stdout)
      ($other (let $_ (println! (FAILED_PROCESS $other)) (system:exit 2))))))
(: nt:contains (-> %Undefined% %Undefined% %Undefined%))
(= (nt:contains $text $needle)
   (case (str:find $text $needle) (((TextNotFound $missing) False) ($found True))))
(: nt:join (-> %Undefined% %Undefined% %Undefined%))
(= (nt:join $base $name) (str:concat (str:concat $base "/") $name))
(: nt:required-env (-> %Undefined% %Undefined%))
(= (nt:required-env $name)
   (let $value (system:getenv-or-default $name "")
     (if (== $value "") (let $_ (println! (MISSING_TEST_SETTING $name)) (system:exit 2)) $value)))
(: nt:environment (-> %Undefined% %Undefined%))
(= (nt:environment $home)
   (let $path (system:getenv-or-default "PATH" "/usr/bin:/bin")
     (("PATH" $path) ("HOME" $home) ("LANG" "C.UTF-8") ("LC_ALL" "C.UTF-8"))))
