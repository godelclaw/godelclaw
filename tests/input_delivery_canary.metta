; Offline crash canary: the model is replaced only by explicit kernel actions.
!(import! &self ./input_lifecycle_cetta.metta)
!(import! &self (library mailbox))
(= (ic:mail-server $world)
   (let* (((NativeProviderTestWorldV1 $root $sdk $core $directory $socket $base $peer $ledger $env $io_fixture) $world)
          ($mail-socket (nt:join $directory "mail.sock")) ($data (nt:join $directory "mail-store"))
          ($service (nt:join $core "cetta-space-service"))
          ($server (proc:spawn ($service "--socket" $mail-socket "--data" $data)
                               ((cwd $directory) (env $env) (max-bytes 65536))))
          ($_ (nq:wait-file $server $mail-socket 500)))
     (OfflineMailboxV1 $world $server $mail-socket)))
(= (ic:send (OfflineMailboxV1 $world $server $socket) $id)
   (case (mailbox:send $socket "canary-mail" $id "kernel" "operator-fixture" "same notice")
     (((mailbox:sent $sent $status) (nt:require canary-mail-accepted (nt:equal $sent $id)))
      ($bad (let $_ (println! (CANARY_SEND_FAILED $bad)) (system:exit 2))))))
(= (ic:run (OfflineMailboxV1 $world $server $mail-socket) $mode)
   (ic:run-with (OfflineMailboxV1 $world $server $mail-socket) $mode ()))
(= (ic:run-with (OfflineMailboxV1 $world $server $mail-socket) $mode $overrides)
   (let* (((NativeProviderTestWorldV1 $root $sdk $core $directory $socket $base $peer $ledger $env $io_fixture) $world)
          ($fixture (preq:repr (nt:join $root "tests/fixtures/input_scope_kernel.metta")))
          ($quoted (preq:repr $mode))
          ($forms (format-args "!(import! &self {})\n!(input-kernel:run {})\n" ($fixture $quoted)))
          ($extra (("METTACLAW_OBSERVED_STRATEGY" "1") ("METTACLAW_MAIL_SOCKET" $mail-socket)
             ("METTACLAW_MAIL_SPACE" "canary-mail") ("METTACLAW_MAIL_NAME" "kernel")
             ("METTACLAW_HISTORY_PATH" (nt:join $directory "history.metta"))
             ("METTACLAW_STRATEGY_PATH" (nt:join $directory "strategy"))
             ("METTACLAW_WORKING_SET_PATH" (nt:join $directory "working.json"))
             ("METTACLAW_LOOP_MODE_PATH" (nt:join $directory "loop-mode.json"))
             ("METTACLAW_JOBS_DIR" (nt:join $directory "jobs"))
             ("METTACLAW_CHAT_SPOOL_ROOT" (nt:join $directory "chat")))))
     (nq:guest-at $world "fixture-model" "petta" $forms (nq:overlay-env $extra $overrides) $directory)))
(= (ic:expect-crash (NativeTestGuestResultV1 $elapsed $result))
   (nt:require kernel-was-killed-after-operation
     (case $result (((proc:exited 137 $out $err) True)
       ($wrong (let $_ (println! (EXPECTED_KERNEL_KILL $wrong)) False))))))
(= (ic:job $world $id $started)
   (let* (($directory (nq:path $world "jobs")) ($_ (fs:make-directories $directory 448))
          ($path (nt:join $directory (str:concat $id ".json")))
          ($log (nt:join $directory (str:concat $id ".log")))
          ($_ (fs:write $log "same result"))
          ($text (preq:render (preq:object
             ((preq:pair "id" (preq:string $id)) (preq:pair "command" (preq:string "fixture task"))
              (preq:pair "state" (preq:string "exited")) (preq:pair "exit" (preq:number "0"))
              (preq:pair "started" (preq:number (preq:repr $started)))
              (preq:pair "notified" (preq:bool False)) (preq:pair "log" (preq:string $log)))))))
     (fs:write $path $text)))
(= (ic:close (OfflineMailboxV1 $world $server $socket))
   (let* (($_ (proc:cancel $server)) ($_ (proc:await $server)) ($_ (proc:close $server))) (nq:close $world)))
