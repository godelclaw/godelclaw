!(import! &self ../growth_support.metta)
!(let $module (system:getenv-or-default "NATIVE_QUEUE_VARIANT" "")
   (if (== $module "") (import! &self ../../src/mcp_client_cetta.metta) (import! &self $module)))
(= (queue-growth:fill $state $index $end)
   (if (>= $index $end) True
     (let* (($parameters (JsonObject ((JsonPair "progress" $index))))
            ($message (JsonObject ((JsonPair "jsonrpc" "2.0") (JsonPair "method" "notifications/progress")
                                  (JsonPair "params" $parameters))))
            ($wire (json:stringify-python $message))
            ($accepted (if (== (system:getenv-or-default "NATIVE_QUEUE_VARIANT" "") "")
                         (mcp:accept-message $state $wire) (mcp:queue-message $state $wire))))
       (if (mcp:failed? $accepted) (system:exit 1) (queue-growth:fill $state (+ $index 1) $end)))))
!(let* (($state (new-space)) ($_ (mcp:set $state "expected-id" 42)))
   (growth:measure (queue-growth:fill $state 0 (growth:size))))
