; Growth workload: one structured request of n messages through native
; preparation (transform, synthetic check, fingerprint) for each protocol, its
; chat-completions encoding and wire, and one reply of n parts built and
; written. Coding transcripts grow with a session, so each step must stay
; linear. The library's Responses and Anthropic encoders are measured
; separately: they are superlinear in the message count (an engine need).
!(import! &self ../growth_support.metta)
!(import! &self ../../src/provider_request_cetta.metta)
!(import! &self ../../src/native_call_cetta.metta)
(= (sg:messages $n $out)
   (if (== $n 0) $out
     (sg:messages (- $n 1)
       (cons-atom (JsonObject ((JsonPair "role" (JsonString (if (== (% $n 3) 0) "assistant" "user")))
                               (JsonPair "content" (JsonString (format-args "message {} with some ordinary transcript text, Δ ✓" ($n))))))
                  $out))))
(= (sg:request $n)
   (JsonObject ((JsonPair "model" (JsonString "session")) (JsonPair "max_tokens" (JsonNumber "32768"))
                (JsonPair "messages" (JsonArray (cons-atom (JsonObject ((JsonPair "role" (JsonString "system")) (JsonPair "content" (JsonString "S"))))
                                                           (sg:messages $n ()))))
                (JsonPair "cache_messages" (JsonBool True))
                (JsonPair "extra_body" (JsonObject ((JsonPair "enable_thinking" (JsonBool True))))))))
(= (sg:prepare $protocol $provider $request)
   (case (preq:prepare-structured $protocol "growth-model" $request)
     (((PreparedProviderStructuredV1 $valid $tokens)
       (let* (($checked (if (== $provider "synthetic") (preq:structured-synthetic $valid) $valid))
              ($fingerprint (str:sha256 (preq:canonical $valid))))
         (if (== $protocol "chat-completions")
           (let* (((llm:v1:ok (llm:v1:encoded $path $body)) (llm:v1:encode $protocol (preq:render $valid)))
                  ((PreparedProviderWireV1 $wire $active $model $layout)
                    (preq:wire (preq:parse $body) $provider $protocol "structured" False False ProviderCacheNoneV1)))
             (str:byte-length $wire))
           (str:byte-length $fingerprint)))))))
(= (sg:reply $n)
   (let* (($owner (call:owner host (JsonObject ((JsonPair "correlation" "growth") (JsonPair "kind" "structured"))) "seal"))
          ($content (str:join "" (sg:parts $n ())))
          ($message (JsonObject ((JsonPair "content" (JsonString $content)))))
          ($choice (JsonObject ((JsonPair "message" $message) (JsonPair "finish_reason" (JsonString "stop")))))
          ($legacy (preq:render (JsonObject ((JsonPair "choices" (JsonArray ($choice)))))))
          ((ProviderReplyV1 $reply) (call:reply $owner $legacy))
          ($_ (call:write-reply $reply (str:concat (growth:directory) "/reply.json")))
          ($_ (call:release $owner)))
     (str:byte-length $legacy)))
(= (sg:parts $n $out) (if (== $n 0) $out (sg:parts (- $n 1) (cons-atom "a reply part of ordinary length. " $out))))
(= (sg:run $n)
   (let* (($request (sg:request $n))
          ($a (sg:prepare "chat-completions" "synthetic" $request))
          ($b (sg:prepare "responses" "kimi" $request))
          ($c (sg:prepare "anthropic" "anthropic" $request))
          ($d (sg:reply $n)))
     (+ (+ $a $b) (+ $c $d))))
!(growth:measure (sg:run (growth:size)))
