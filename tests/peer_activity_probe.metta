!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)
!(py-eval "__import__('sys').path.insert(0, str(__import__('pathlib').Path(__import__('helper').__file__).resolve().parents[1] / 'tests'))")
!(import! &self ./tests/peer_activity_fixture.py)
!(py-call (peer_activity_fixture.setup))
!(initMemory)
!(configure commchannel telegram)
!(let* (($initial (initLoop))
         ($idle (coordinate-set loops 0 (process-periphery $initial)))
         ($next (process-step (rooted weak-process-core-v1 $idle) (turnProcess $idle)))
         ($_ (assert (not (eval (lastMessageIsHuman)))))
         ($_ (assert (== (py-call (peer_activity_fixture.check)) 1)))
         ($_ (py-call (peer_activity_fixture.clear))))
   (println! PEER_ACTIVITY_OK))
