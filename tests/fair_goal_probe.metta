!(import! &self (library lib_import))
!(import! &self ./lib_mettaclaw)

;; Exercise actual host preparation, budget admission and action receipts.
;; No provider or channel traffic is made by this fixture.
!(py-eval "__import__('os').environ.update(METTACLAW_FAIR_GOALS='1', METTACLAW_OBSERVED_STRATEGY='1')")
!(py-eval "__import__('pathlib').Path(__import__('goals')._goals_path()).write_text('(goal research Work sti:0.5 lti:0.5 vibes:() blocked-by:none last-verified:never note:Check evidence)\\n(goal review Work sti:0.5 lti:0.5 vibes:() blocked-by:none last-verified:never note:Review constraints)\\n(goal-policy research share:2 every:once urgency:1000 checker:operator)\\n(goal-policy review share:1 every:once urgency:0 checker:operator)\\n')")
!(py-eval "__import__('strategy_host').__dict__.__setitem__('_stimulus_free', lambda: True)")
!(py-eval "__import__('helper').__dict__.update(_fair_prompts=[])")
!(py-eval "__import__('synthetic_llm').__dict__.__setitem__('chat', lambda *args: (__import__('helper')._fair_prompts.append(str(args[-1])), __import__('llm_policy').complete(__import__('llm_policy').admit('fixture', 8), {'choices':[{'finish_reason':'stop'}], 'usage':{'completion_tokens':1}}), __import__('cognitive_health').turn_started('fixture'), __import__('cognitive_health').turn_completed(8), '((help shell))')[-1])")
!(py-eval "(__import__('helper').__dict__.__setitem__('_working_boot_cache', {}), __import__('helper').__dict__.__setitem__('working_boot', lambda: 6))")
!(initMemory)
!(configure commchannel telegram)
!(let* (($_ (py-call (loop_modes.set_mode "godelclaw")))
         ($initial (initLoop))
         ($first (process-step $initial (turnProcess (process-periphery $initial))))
         ($second (process-step $first (turnProcess (process-periphery $first))))
         ($third (process-step $second (turnProcess (process-periphery $second)))))
   (println! FAIR_GOAL_TURNS_FINISHED))
!(py-eval "(__import__('builtins').exec(\"assert [g['service'] for g in __import__('strategy_host').goal_snapshot()['queue']] == [2, 1]\\nassert len(__import__('strategy_host').ledger().projection()['actions']) == 3\\nassert all('FAIR_GOALS' in p for p in __import__('helper')._fair_prompts)\"), print('FAIR_GOAL_RUNTIME_OK'))[-1]")
