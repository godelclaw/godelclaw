; SPDX-License-Identifier: MIT
!(import! &self ./src/ecan_bank.metta)
!(import! &self ./src/ecan_decay.metta)
!(import! &self (library system))
(= (check $actual $expected)
   (let* (($a $actual) ($e $expected))
     (if (== $a $e) True
       (let $_ (println! (TestFailure $a $e)) (system:exit 1)))))
(= (check-error $operation $field $result)
   (let $actual $result
     (case $actual
       (((ECANError $operation $field $reason $value) True)
        ($other (let $_ (println! (ExpectedError $operation $field $other)) (system:exit 1)))))))
!(let* (($bank (ecan:new 100 200 300))
        ($_ (ecan:set $bank "x" 8 4 2))
        ($before (ecan:snapshot $bank))
        ($_ (check-error half-life-for fraction (ecan:half-life-for 60 0)))
        ($_ (check-error half-life-for fraction (ecan:half-life-for 60 -0.1)))
        ($_ (check-error half-life-for fraction (ecan:half-life-for 60 1.5)))
        ($_ (check-error half-life-for fraction (ecan:half-life-for 60 "oops")))
        ($_ (check-error half-life-for elapsed-seconds (ecan:half-life-for 0 0.5)))
        ($_ (check-error half-life-for elapsed-seconds (ecan:half-life-for -60 0.5)))
        ($_ (check-error configure sti-half-life (ecan:configure $bank sti-half-life -5)))
        ($_ (check-error configure mti-half-life (ecan:configure $bank mti-half-life "slow")))
        ($_ (check-error configure lti-half-life (ecan:configure $bank lti-half-life -1)))
        ($_ (check-error configure sti-mti-rate (ecan:configure $bank sti-mti-rate 1.1)))
        ($_ (check-error configure mti-lti-rate (ecan:configure $bank mti-lti-rate -0.1)))
        ($_ (check-error configure sti-halflife (ecan:configure $bank sti-halflife 5)))
        ($_ (check-error setting sti-halflife (ecan:setting $bank sti-halflife)))
        ($_ (check-error retention half-life (ecan:retention 60 -5)))
        ($_ (check-error retention elapsed-seconds (ecan:advance $bank -1)))
        ($_ (check-error retention elapsed-seconds (ecan:preview $bank "x" "tomorrow")))
        ($_ (check-error decay mti-retain (ecan:decay $bank 0.5 1.1 0.5)))
        ($_ (check-error consolidate sti-lti-rate (ecan:consolidate $bank "x" 2)))
        ($_ (check-error consolidate mti-lti-rate (ecan:consolidate $bank "x" 0.5 -1)))
        ($_ (check (ecan:snapshot $bank) $before))
        ($_ (check-error configure mti-half-life
             (ecan:restore (ECANSnapshot 2 (ECANFunds 0 0 0)
               ((ECANSetting sti-half-life 5) (ECANSetting mti-half-life -1)) ()))))
        ($_ (check (ecan:configure $bank sti-half-life 1000000000) 1000000000))
        ($_ (check (ecan:configure $bank sti-mti-rate 0) 0))
        ($_ (check (ecan:configure $bank mti-lti-rate 1) 1))
        ($_ (check (ecan:configure $bank lti-half-life 0) 0))
        ($_ (check (ecan:half-life-for 60 0.5) 60))
        ($_ (ecan:stimulate $bank "x" 1))
        ($_ (check (ecan:get $bank "x") (ECANValue "x" 9 4 2))))
   (println! ECAN_ARGUMENT_TESTS_OK))
