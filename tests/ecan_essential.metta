; SPDX-License-Identifier: MIT
!(import! &self ./src/ecan_bank.metta)
!(import! &self ./src/ecan_decay.metta)
!(import! &self (library system))
(= (check $actual $expected)
   (let* (($a $actual) ($e $expected))
     (if (== $a $e) True
       (let $_ (println! (TestFailure $a $e)) (system:exit 1)))))
!(let* (($bank (ecan:new 100 50))
        ($_ (check (ecan:get $bank "missing") (ECANMissing "missing")))
        ($_ (ecan:set $bank "a" 10 4))
        ($_ (ecan:set $bank "b" 20 8))
        ($_ (ecan:set $bank "c" 5 2))
        ($_ (check (ecan:total $bank) (ECANTotal 100 0 50)))
        ($_ (ecan:stimulate $bank "a" 30 6))
        ($_ (check (ecan:get $bank "a") (ECANValue "a" 40 0 10)))
        ($_ (check (ecan:get $bank "b") (ECANValue "b" 20 0 8)))
        ($_ (check (ecan:focus $bank 1) ((40 (ECANValue "a" 40 0 10)))))
        ($_ (ecan:decay $bank 0.5 0.5))
        ($_ (check (ecan:get $bank "a") (ECANValue "a" 20 0 5)))
        ($_ (ecan:spread $bank "a" ("b" "c") 0.5))
        ($_ (check (ecan:get $bank "a") (ECANValue "a" 10 0 5)))
        ($_ (check (ecan:get $bank "b") (ECANValue "b" 15 0 4)))
        ($_ (check (ecan:get $bank "c") (ECANValue "c" 7.5 0 1)))
        ($_ (ecan:consolidate $bank "b" 0.5))
        ($_ (check (ecan:get $bank "b") (ECANValue "b" 15 0 9.5)))
        ($_ (check (ecan:total $bank) (ECANTotal 100 0 50)))
        ($restored (ecan:restore (ecan:snapshot $bank)))
        ($_ (check (ecan:get $restored "b") (ecan:get $bank "b")))
        ($_ (check (ecan:total $restored) (ECANTotal 100 0 50)))
        ($_ (ecan:stimulate $bank "large" 1000))
        ($_ (check (ecan:get $bank "large") (ECANValue "large" 1000 0 0)))
        ($_ (check (ecan:total $bank) (ECANTotal 100 0 50)))
        ($_ (check (size-atom (ecan:focus $bank 0)) 4))
        ($_ (check (ecan:focus-above $bank 0 100)
                   ((1000 (ECANValue "large" 1000 0 0)))))
        ($_ (check (ecan:focus-above $bank 10 1001) ()))
        ($_ (check (size-atom (ecan:values $bank)) 4)))
   (println! ECAN_NATIVE_TESTS_OK))

!(let* (($bank (ecan:new)) ($_ (ecan:stimulate $bank "source" 10))
        ($_ (ecan:spread $bank "source" ("b" "b" "c") 0.5))
        ($_ (check (ecan:get $bank "b") (ECANValue "b" 2.5 0 0)))
        ($_ (check (ecan:get $bank "c") (ECANValue "c" 2.5 0 0)))
        ($_ (check (ecan:total $bank) (ECANTotal 0 0 0))))
   (println! ECAN_DUPLICATE_TARGETS_OK))
