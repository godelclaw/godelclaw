!(import! &self ./provider_native_qualification.metta)
(= (client-flow:run)
   (let* (($root (system:getcwd)) ($core (nt:required-env "NATIVE_TEST_CORE"))
          ($world (nq:world $root $core $core (nt:required-env "NATIVE_TEST_ARTIFACTS")
                          (nt:required-env "NATIVE_TEST_HTTP_FIXTURE") "search"))
          ((NativeProviderTestWorldV1 $_ $_ $_ $directory $_ $base $_ $_ $_ $_) $world)
          ($module (repr (path:join $root "src/websearch_cetta.metta")))
          ($_ (fs:write (nq:path $world "response.body")
             "{\"answer\":\"summary\",\"results\":[{\"title\":\"Ček title\",\"url\":\"https://example.invalid/a\",\"content\":\"A snippet\"}]}"))
          ($environment (("TAVILY_API_KEY" "fixture-search-key") ("TAVILY_BASE_URL" $base)
            ("CETTA_IO_AUTH_SEARCH_TAVILY_URL_PREFIX" (str:concat $base "/"))
            ("CETTA_IO_AUTH_SEARCH_TAVILY_ENV" "TAVILY_API_KEY") ("CETTA_IO_AUTH_SEARCH_TAVILY_HEADER" "Authorization")
            ("CETTA_IO_AUTH_SEARCH_TAVILY_PREFIX" "Bearer ")
            ("METTACLAW_TOOL_OUTPUT_DIR" (nq:path $world "outputs"))
            ("METTACLAW_XMLLINT_BIN" (nt:required-env "NATIVE_XMLLINT_BIN"))
            ("METTACLAW_DDG_ENDPOINTS" (str:concat $base "/?q="))))
          ($first (str:join "" ("!(import! &self " $module ")\n"
            "!(let $result (search:auto \"tavily:unit query\") (nt:require tavily-native-result (nt:contains $result \"Ček title\")))\n!(println! NATIVE_TAVILY_CLIENT_OK)")))
          ($first-output (nq:output (nq:guest $world "fixture-model" "petta" $first $environment)))
          ($_ (nt:require tavily-client-finished (nt:contains $first-output "NATIVE_TAVILY_CLIENT_OK")))
          ($_ (fs:write (nq:path $world "response.body")
             "<html><body><a class=\"result__a\" href=\"https://example.invalid/?x=1&amp;y=2\">Ček &amp; title</a><a class=\"result__snippet\">Tiny&nbsp;snippet</a></body></html>"))
          ($second (str:join "" ("!(import! &self " $module ")\n"
            "!(let $result (search:auto \"auto:unit query\") (progn (nt:require automatic-fallback-is-explicit (nt:contains $result \"SEARCH_FALLBACK:\")) (nt:require html-anchor-snippet-is-preserved (nt:contains $result \"Tiny snippet\")) (nt:require html-entities-and-unicode (nt:contains $result \"Ček & title\"))))\n!(println! NATIVE_HTML_CLIENT_OK)")))
          ($second-output (nq:output (nq:guest $world "fixture-model" "petta" $second $environment)))
          ($_ (nt:require html-client-finished (nt:contains $second-output "NATIVE_HTML_CLIENT_OK")))
          ($_ (nt:require both-search-clients-used-native-http (== (nq:posts $world) 3)))
          ($_ (nq:close $world)))
     (println! NATIVE_SEARCH_CLIENTS_OK)))
!(client-flow:run)
